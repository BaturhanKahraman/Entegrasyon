@page "/settings"

<PageTitle>Ayarlar</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Ayarlar</MudText>

<MudGrid>
    <!-- Server Settings -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Sunucu Baglantisi</MudText>

                <MudTextField @bind-Value="_settings.ServerUrl"
                              Label="Sunucu URL"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              Placeholder="https://example.com" />

                <MudTextField @bind-Value="_settings.ApiKey"
                              Label="API Key"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Class="mb-3" />

                <MudTextField @bind-Value="_settings.BranchOfficeId"
                              Label="Sube ID"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              HelperText="Stok senkronizasyonu icin sube kimlik bilgisi" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Application Settings -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Uygulama Ayarlari</MudText>

                <MudTextField @bind-Value="_settings.StoreName"
                              Label="Magaza Adi"
                              Variant="Variant.Outlined"
                              Class="mb-3" />

                <MudNumericField @bind-Value="_settings.SyncIntervalSeconds"
                                 Label="Sync Araligi (saniye)"
                                 Variant="Variant.Outlined"
                                 Min="10"
                                 Max="3600"
                                 Class="mb-3" />

                <MudNumericField @bind-Value="_settings.PrintAgentPort"
                                 Label="PrintAgent Portu"
                                 Variant="Variant.Outlined"
                                 Min="1024"
                                 Max="65535"
                                 Class="mb-3" />

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">Otomatik Güncelleme</MudText>

                <MudTextField @bind-Value="_settings.UpdateUrl"
                              Label="Güncelleme Kaynağı URL"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              HelperText="GitHub: https://github.com/owner/repo veya özel sunucu URL"
                              Placeholder="https://github.com/owner/repo" />

                <MudSwitch @bind-Value="_settings.AutoUpdateEnabled"
                           Label="Otomatik güncelleme kontrolü"
                           Color="Color.Primary" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Save Button -->
    <MudItem xs="12">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveSettings"
                   Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Kaydediliyor...</span>
            }
            else
            {
                <span>Ayarlari Kaydet</span>
            }
        </MudButton>
    </MudItem>

    <!-- PrintAgent Status -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Yazdırma Agent'ı</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Yazdırma istekleri tarayıcıdan <code>entegrasyon-print://</code> deep-link'i ile bu uygulamaya yönlendirilir.
                    Ayrı bir agent kurulumu gerekmez.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Database Info -->
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Local Veritabani</MudText>

                <div class="d-flex justify-space-between my-2">
                    <MudText>Urun Sayisi:</MudText>
                    <MudText>@_productCount</MudText>
                </div>

                <div class="d-flex justify-space-between my-2">
                    <MudText>Bekleyen Sync:</MudText>
                    <MudText>@_pendingCount</MudText>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
