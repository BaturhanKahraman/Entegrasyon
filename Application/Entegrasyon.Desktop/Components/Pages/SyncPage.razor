@page "/sync"

<PageTitle>Senkronizasyon</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Senkronizasyon</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Sync Durumu</MudText>
                <MudDivider Class="my-3" />

                <MudList T="string" Dense="true">
                    <MudListItem T="string">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText>Baglanti:</MudText>
                            @if (_syncService.IsOnline)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Online</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Offline</MudChip>
                            }
                        </div>
                    </MudListItem>
                    <MudListItem T="string">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText>Son Sync:</MudText>
                            <MudText>@(_syncService.LastSyncTime?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</MudText>
                        </div>
                    </MudListItem>
                    <MudListItem T="string">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText>Bekleyen Islem:</MudText>
                            <MudChip T="string" Color="@(_pendingCount > 0 ? Color.Warning : Color.Default)" Size="Size.Small">
                                @_pendingCount
                            </MudChip>
                        </div>
                    </MudListItem>
                    @if (_syncService.LastError is not null)
                    {
                        <MudListItem T="string">
                            <MudAlert Severity="Severity.Error" Dense="true">@_syncService.LastError</MudAlert>
                        </MudListItem>
                    }
                </MudList>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sync"
                           Disabled="@(!_syncService.IsOnline || _syncing)"
                           OnClick="RunFullSync">
                    @if (_syncing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Senkronize Ediliyor...</span>
                    }
                    else
                    {
                        <span>Tam Senkronizasyon</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Islem Secenekleri</MudText>
                <MudDivider Class="my-3" />

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           FullWidth="true"
                           Class="mb-2"
                           StartIcon="@Icons.Material.Filled.CloudDownload"
                           Disabled="@(!_syncService.IsOnline || _syncing)"
                           OnClick="PullProducts">
                    Urunleri Indir (Pull)
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           FullWidth="true"
                           Class="mb-2"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Disabled="@(!_syncService.IsOnline || _syncing)"
                           OnClick="PushSales">
                    Satislari Gonder (Push)
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Sync Log -->
    @if (_syncLogs.Any())
    {
        <MudItem xs="12">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-3">Sync Gecmisi</MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var log in _syncLogs.TakeLast(10).Reverse())
                        {
                            <MudListItem T="string">
                                <div class="d-flex gap-2">
                                    <MudIcon Icon="@(log.Success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                                             Color="@(log.Success ? Color.Success : Color.Error)"
                                             Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@log.Timestamp.ToString("HH:mm:ss") — @log.Message</MudText>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>
