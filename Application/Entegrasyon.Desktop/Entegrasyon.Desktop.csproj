<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Entegrasyon.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- PrintAgentHostedService uses WebApplication.CreateBuilder() -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="3.*" />
    <PackageReference Include="Velopack" Version="0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="MudBlazor" Version="7.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared Entity/DTO project -->
    <ProjectReference Include="..\Entegrasyon.Entity\Entegrasyon.Entity.csproj" />

    <!-- PrintAgent Contracts (printer DTOs) -->
    <ProjectReference Include="..\..\Agent\Entegrasyon.PrintAgent.Contracts\Entegrasyon.PrintAgent.Contracts.csproj" />

    <!-- Full PrintAgent project (PrintService, transports, configuration) -->
    <ProjectReference Include="..\..\Agent\Entegrasyon.PrintAgent\Entegrasyon.PrintAgent.csproj" />
  </ItemGroup>

</Project>
