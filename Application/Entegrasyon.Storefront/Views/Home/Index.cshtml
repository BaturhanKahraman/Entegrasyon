@* ============ HERO ============ *@
<section class="bg-gradient-to-b from-cream to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
            <div class="order-2 lg:order-1 text-center lg:text-left">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-6">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Yeni İlkbahar Koleksiyonu
                </span>
                <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl leading-[1.05] text-charcoal">
                    Çocukluğun büyüsünü <span class="italic text-primary">giydir</span>
                </h1>
                <p class="mt-5 text-base lg:text-lg text-muted max-w-md mx-auto lg:mx-0 leading-relaxed">
                    0–14 yaş minikler için yumuşak kumaşlar, neşeli renkler. Minik dolaplara büyük ilham.
                </p>
                <div class="mt-8 flex flex-wrap gap-3 justify-center lg:justify-start">
                    <a href="#yeni" class="px-7 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">Yeni Gelenler</a>
                    <a href="/kategori/outlet" class="px-7 py-3.5 rounded-full border border-cream-300 text-charcoal font-semibold hover:border-primary hover:text-primary transition">Outlet'i Keşfet</a>
                </div>
                <div class="mt-8 flex items-center gap-6 justify-center lg:justify-start text-sm text-muted">
                    <span class="flex items-center gap-2"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> %100 pamuk</span>
                    <span class="flex items-center gap-2"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> 30 gün iade</span>
                </div>
            </div>

            <div class="order-1 lg:order-2 relative">
                <div class="rounded-3xl p-2.5 bg-gradient-to-br from-primary/30 via-accent/25 to-secondary/30">
                    <div class="ph aspect-[4/5] sm:aspect-[16/13] rounded-[1.25rem] bg-secondary/30" data-ph="mutlu çocuk · oyun anı">
                        <img class="photo" loading="lazy" alt="Neşeli çocuk" src="https://images.unsplash.com/photo-1518831959646-742c3a14ebf7?auto=format&fit=crop&w=900&q=80" />
                    </div>
                </div>
                <div class="sticker absolute -top-4 -right-2 sm:-right-4 bg-accent text-charcoal font-heading font-semibold text-sm sm:text-base px-4 py-3 rounded-2xl rotate-[-8deg]">
                    %30'a varan<br/><span class="text-lg">indirim</span>
                </div>
                <div class="absolute -bottom-4 -left-2 sm:-left-4 bg-white rounded-2xl shadow-md px-4 py-3 flex items-center gap-3">
                    <div class="ph w-10 h-10 rounded-xl bg-primary/20" data-ph="">
                        <img class="photo" loading="lazy" alt="" src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=120&q=80" />
                    </div>
                    <div class="text-xs leading-tight">
                        <p class="font-semibold text-charcoal">12.400+ mutlu aile</p>
                        <p class="text-muted">★★★★★ 4.9 puan</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ============ YAŞA GÖRE ============ *@
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="flex items-end justify-between mb-8">
        <div>
            <h2 class="font-heading text-2xl lg:text-3xl text-charcoal">Yaşa göre seçin</h2>
            <p class="text-muted mt-1.5 text-sm lg:text-base">Doğru beden, doğru yaş için özenle ayrıldı.</p>
        </div>
        <a href="/kategoriler" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:gap-2.5 transition-all whitespace-nowrap">Tümü <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <div class="flex sm:grid sm:grid-cols-5 lg:grid-cols-10 gap-4 sm:gap-5 overflow-x-auto no-scrollbar snap-x pb-2 -mx-4 px-4 sm:mx-0 sm:px-0">
        @foreach (var age in ages)
        {
            <a href="/kategori/yas/@age.Label.Replace(" ", "-").ToLower()" class="group shrink-0 w-28 sm:w-auto snap-start text-center">
                <div class="ph aspect-square rounded-3xl overflow-hidden @age.Tint group-hover:scale-105 group-hover:shadow-md transition duration-300" data-ph="">
                    <img class="photo" loading="lazy" alt="@age.Label" src="@age.Img" />
                </div>
                <p class="mt-2.5 text-sm font-medium text-charcoal">@age.Label</p>
            </a>
        }
    </div>
</section>

