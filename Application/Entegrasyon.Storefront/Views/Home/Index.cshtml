                <img class="photo" loading="lazy" alt="Erkek çocuk modeli" src="https://images.unsplash.com/photo-1502451885777-16c98b07834a?auto=format&fit=crop&w=700&q=80" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/45 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                <h3 class="font-heading text-2xl mb-1">Erkek</h3>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold group-hover:gap-2.5 transition-all">Keşfet <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </div>
        </a>
        <a href="/kategori/unisex" class="group relative rounded-3xl overflow-hidden aspect-[4/5] sm:aspect-[3/4]">
            <div class="ph absolute inset-0 bg-accent/35" data-ph="unisex · model">
                <img class="photo" loading="lazy" alt="Çocuklar" src="https://images.unsplash.com/photo-1634188157846-c6e3bdf99420?auto=format&fit=crop&w=700&q=80" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/45 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                <h3 class="font-heading text-2xl mb-1">Unisex</h3>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold group-hover:gap-2.5 transition-all">Keşfet <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
