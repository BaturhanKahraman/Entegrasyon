@* ============ YENİ GELENLER ============ *@
<section id="yeni" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="flex items-end justify-between mb-8">
        <div>
            <h2 class="font-heading text-2xl lg:text-3xl text-charcoal">Bu Hafta Eklediklerimiz</h2>
            <p class="text-muted mt-1.5 text-sm lg:text-base">Yeni sezonun ilk minik parçaları.</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" data-carousel-scroll="prev" data-carousel-target="newScroll" aria-label="Önceki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button type="button" data-carousel-scroll="next" data-carousel-target="newScroll" aria-label="Sonraki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            <a href="/kategori/yeni-gelenler" class="ml-1 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:gap-2.5 transition-all whitespace-nowrap">Tümü <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
    </div>
    <div id="newScroll" class="grid grid-flow-col auto-cols-[68%] sm:auto-cols-[40%] md:auto-cols-[30%] lg:grid-cols-4 lg:grid-flow-row gap-4 sm:gap-6 overflow-x-auto lg:overflow-visible no-scrollbar snap-x scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0">
        @if (newProducts.Count > 0)
        {
            foreach (var product in newProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        }
        else
        {
            foreach (var p in sampleProducts)
            {
                <div class="group snap-start">
                    <a href="#" class="block" aria-label="@p.Title, @p.Price">
                        <div class="ph relative aspect-[4/5] rounded-2xl @p.Tint overflow-hidden" data-ph="ürün görseli">
                            <img class="photo" loading="lazy" alt="@p.Title" src="@p.Img" />
                            <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start">
                                @if (p.Badge == "new")  { <span class="px-2.5 py-1 rounded-full bg-primary text-white text-[11px] font-semibold">Yeni</span> }
                                @if (p.Badge == "best") { <span class="px-2.5 py-1 rounded-full bg-accent text-charcoal text-[11px] font-semibold">Çok Satan</span> }
                                @if (p.Badge == "sale") { <span class="px-2.5 py-1 rounded-full bg-success text-white text-[11px] font-semibold">İndirim</span> }
                            </div>
                            <button type="button" data-wishlist-toggle data-on="0" aria-label="Favorilere ekle" class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur flex items-center justify-center text-charcoal hover:text-primary transition shadow-sm">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A4.5 4.5 0 0 0 12 5.5 4.5 4.5 0 0 0 2 8.5C2 10.8 3.5 12.5 5 14l7 7Z"/></svg>
                            </button>
                            <div class="absolute inset-x-3 bottom-3 translate-y-[130%] group-hover:translate-y-0 transition duration-300">
                                <span class="block w-full text-center bg-white text-charcoal text-sm font-semibold py-2.5 rounded-full shadow-sm">Hızlı Bakış</span>
                            </div>
                        </div>
                    </a>
                    <div class="mt-3">
                        <p class="text-xs text-muted">@p.Brand</p>
                        <a href="#" class="block font-medium text-charcoal line-clamp-2 leading-snug mt-0.5 hover:text-primary transition">@p.Title</a>
                        <span class="inline-block mt-2 px-2 py-0.5 rounded-md bg-cream text-[11px] text-muted">@p.Sizes</span>
                        <div class="mt-2 flex items-baseline gap-2">
                            @if (!string.IsNullOrEmpty(p.Old)) { <span class="text-sm text-muted line-through">@p.Old</span> }
                            <span class="text-lg font-semibold text-primary">@p.Price</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>

