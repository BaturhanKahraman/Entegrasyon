                <div class="p-6">
                    <h3 class="font-heading text-xl text-charcoal">Pijama Geceleri</h3>
                    <p class="text-sm text-muted mt-2 leading-relaxed">Tatlı rüyalar için yumuşacık pamuklu pijama takımları.</p>
                    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary group-hover:gap-2.5 transition-all">Koleksiyonu Gör <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </div>
            </a>
        </div>
    </div>
</section>

@* ============ TRUST BAND ============ *@
<section class="bg-white border-y border-cream-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shrink-0">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.3a2 2 0 0 0-.6-1.4L18 9h-4v8h2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                </div>
                <div>
                    <p class="font-semibold text-sm text-charcoal">Kargo Bedava</p>
                    <p class="text-xs text-muted mt-0.5">500₺ üzeri siparişte</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-secondary/15 flex items-center justify-center text-secondary shrink-0">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                </div>
                <div>
                    <p class="font-semibold text-sm text-charcoal">30 Gün İade</p>
                    <p class="text-xs text-muted mt-0.5">Koşulsuz, ücretsiz</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-success/15 flex items-center justify-center text-success shrink-0">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div>
                    <p class="font-semibold text-sm text-charcoal">Güvenli Ödeme</p>
                    <p class="text-xs text-muted mt-0.5">256-bit SSL koruma</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-accent/25 flex items-center justify-center text-warning shrink-0">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg>
                </div>
                <div>
                    <p class="font-semibold text-sm text-charcoal">WhatsApp Destek</p>
                    <p class="text-xs text-muted mt-0.5">Hafta içi 09:00–18:00</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ============ YORUMLAR ============ *@
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <h2 class="font-heading text-2xl lg:text-3xl text-charcoal text-center mb-3">Annelerin &amp; babaların sözü</h2>
    <p class="text-muted text-center mb-10 text-sm lg:text-base">12.000'den fazla aileye dokunduk.</p>
    <div class="grid md:grid-cols-3 gap-6">
        @foreach (var t in testimonials)
        {
            <div class="bg-cream rounded-3xl p-7">
                <div class="flex gap-0.5 text-accent mb-4" aria-label="5 yıldız">
                    @for (var i = 0; i < 5; i++)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8L9 8.3Z"/></svg>
                    }
                </div>
                <p class="text-charcoal/85 leading-relaxed">"@t.Text"</p>
                <div class="mt-5 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-primary/15 flex items-center justify-center font-semibold text-primary text-sm">@t.Name.Substring(0, 1)</div>
                    <div class="text-sm">
                        <p class="font-semibold text-charcoal">@t.Name</p>
                        <p class="text-muted text-xs">Sipariş #@(t.Order)'ten</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@* ============ INSTAGRAM ============ *@
<section class="bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
        <div class="text-center mb-8">
            <h2 class="font-heading text-2xl lg:text-3xl text-charcoal">@@zekidsbebe</h2>
            <p class="text-muted mt-1.5 text-sm lg:text-base">#zekidsbebe ile siz de aramıza katılın.</p>
        </div>
        <div class="grid grid-cols-3 lg:grid-cols-6 gap-3">
            @foreach (var img in instaImages)
            {
                <a href="#" class="ph group relative aspect-square rounded-2xl overflow-hidden bg-cream" data-ph="#zekidsbebe">
                    <img class="photo" loading="lazy" alt="#zekidsbebe" src="@img" />
                    <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/20 transition flex items-center justify-center">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="#fff" stroke="none"/></svg>
                    </div>
                </a>
            }
        </div>
        <div class="text-center mt-8">
            <a href="https://instagram.com/zekidsbebe" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border border-cream-300 font-semibold text-charcoal hover:border-primary hover:text-primary transition">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                Bizi Instagram'da takip edin
            </a>
        </div>
    </div>
</section>

@* ============ NEWSLETTER ============ *@
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="bg-primary/10 rounded-3xl max-w-4xl mx-auto px-6 sm:px-12 py-12 text-center">
        <h2 class="font-heading text-2xl lg:text-3xl text-charcoal">Yenilikler kutunuza gelsin</h2>
        <p class="text-muted mt-3 max-w-md mx-auto">Hemen abone olun, ilk alışverişinizde <span class="font-semibold text-primary">%10 indirim</span> hediyemiz olsun.</p>
        <form id="newsletterForm" action="/bulten/abone-ol" method="post" class="mt-7 flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
            @Html.AntiForgeryToken()
            <input type="email" name="email" required placeholder="E-posta adresiniz" class="flex-1 px-5 py-3.5 rounded-full border border-cream-300 bg-white outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
            <button type="submit" class="px-7 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm whitespace-nowrap">Abone Ol</button>
        </form>
        <p id="subMsg" class="hidden mt-4 text-sm text-success font-medium">Teşekkürler! İndirim kodunuz e-postanıza gönderildi.</p>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
