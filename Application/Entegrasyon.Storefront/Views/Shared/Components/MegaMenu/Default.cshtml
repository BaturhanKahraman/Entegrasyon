@model List<Entegrasyon.Entity.Dtos.Storefront.CategoryTreeDto>
@*
    Çocuk giyim mega menu — 4 sabit ana grup (Kız/Erkek/Bebek/Outlet) + öne çıkan koleksiyon kartı.
    Tenant'a özel kategori ağacı eklenince Model üzerinden dinamikleştirilebilir.
*@
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-5 gap-8">
    <div>
        <h3 class="font-heading text-lg text-primary mb-4">Kız</h3>
        <ul class="space-y-2.5 text-sm text-charcoal/80">
            <li><a href="/kategori/kiz/elbise" class="hover:text-primary transition">Elbise</a></li>
            <li><a href="/kategori/kiz/tisort-body" class="hover:text-primary transition">Tişört &amp; Body</a></li>
            <li><a href="/kategori/kiz/tunik-salopet" class="hover:text-primary transition">Tunik &amp; Salopet</a></li>
            <li><a href="/kategori/kiz/etek-sort" class="hover:text-primary transition">Etek &amp; Şort</a></li>
            <li><a href="/kategori/kiz/tayt-pantolon" class="hover:text-primary transition">Tayt &amp; Pantolon</a></li>
            <li><a href="/kategori/kiz/mont-yelek" class="hover:text-primary transition">Mont &amp; Yelek</a></li>
        </ul>
    </div>
    <div>
        <h3 class="font-heading text-lg text-secondary mb-4">Erkek</h3>
        <ul class="space-y-2.5 text-sm text-charcoal/80">
            <li><a href="/kategori/erkek/tisort-body" class="hover:text-primary transition">Tişört &amp; Body</a></li>
            <li><a href="/kategori/erkek/sweat-hirka" class="hover:text-primary transition">Sweat &amp; Hırka</a></li>
            <li><a href="/kategori/erkek/gomlek" class="hover:text-primary transition">Gömlek</a></li>
            <li><a href="/kategori/erkek/sort-bermuda" class="hover:text-primary transition">Şort &amp; Bermuda</a></li>
            <li><a href="/kategori/erkek/esofman-pantolon" class="hover:text-primary transition">Eşofman &amp; Pantolon</a></li>
            <li><a href="/kategori/erkek/mont-kaban" class="hover:text-primary transition">Mont &amp; Kaban</a></li>
        </ul>
    </div>
    <div>
        <h3 class="font-heading text-lg text-charcoal mb-4">Bebek</h3>
        <ul class="space-y-2.5 text-sm text-charcoal/80">
            <li><a href="/kategori/bebek/zibin-body" class="hover:text-primary transition">Zıbın &amp; Body</a></li>
            <li><a href="/kategori/bebek/tulum" class="hover:text-primary transition">Tulum</a></li>
            <li><a href="/kategori/bebek/hastane-cikisi" class="hover:text-primary transition">Hastane Çıkışı</a></li>
            <li><a href="/kategori/bebek/battaniye-uyku" class="hover:text-primary transition">Battaniye &amp; Uyku</a></li>
            <li><a href="/kategori/bebek/sapka-corap" class="hover:text-primary transition">Şapka &amp; Çorap</a></li>
            <li><a href="/kategori/bebek/yeni-dogan-setleri" class="hover:text-primary transition">Yeni Doğan Setleri</a></li>
        </ul>
    </div>
    <div>
        <h3 class="font-heading text-lg text-danger mb-4">Outlet</h3>
        <ul class="space-y-2.5 text-sm text-charcoal/80">
            <li><a href="/kategori/outlet/buyuk-indirim" class="hover:text-primary transition">%50'ye Varan İndirim</a></li>
            <li><a href="/kategori/outlet/sezon-sonu" class="hover:text-primary transition">Sezon Sonu</a></li>
            <li><a href="/kategori/outlet/coklu-paketler" class="hover:text-primary transition">Çoklu Paketler</a></li>
            <li><a href="/kategori/outlet/son-bedenler" class="hover:text-primary transition">Son Bedenler</a></li>
        </ul>
    </div>
    <a href="/koleksiyon/ilkbahar" class="group relative rounded-3xl overflow-hidden bg-primary/15 p-6 flex flex-col justify-end min-h-[220px]">
        <div class="ph absolute inset-0 bg-primary/25" data-ph="koleksiyon görseli">
            <img class="photo" loading="lazy" alt="Yeni koleksiyon" src="https://images.unsplash.com/photo-1560506840-ec148e82a604?auto=format&amp;fit=crop&amp;w=600&amp;q=80" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-white/95 via-white/60 to-transparent"></div>
        <div class="relative">
            <p class="text-xs uppercase tracking-wide text-charcoal/60 mb-1">Yeni Sezon</p>
            <h4 class="font-heading text-xl text-charcoal mb-3 leading-tight">İlkbahar<br/>Koleksiyonu</h4>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary group-hover:gap-2.5 transition-all">
                Keşfet
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
        </div>
    </a>
</div>
