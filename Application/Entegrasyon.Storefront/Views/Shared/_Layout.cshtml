@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.FaviconUrl))
    {
        <link rel="icon" href="@Tenant.Settings.FaviconUrl" />
    }
    <style>
        :root {
            --color-primary: @Tenant.Settings.PrimaryColor;
            --color-secondary: @(Tenant.Settings.SecondaryColor ?? "#64748B");
            --color-accent: @(Tenant.Settings.AccentColor ?? "#F59E0B");
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" />
    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.CustomCss))
    {
        <style>@Html.Raw(Tenant.Settings.CustomCss)</style>
    }
    @await RenderSectionAsync("Head", required: false)
    @if (ViewData["JsonLd"] is string jsonLd)
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }
    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.GoogleAnalyticsId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@Tenant.Settings.GoogleAnalyticsId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@Tenant.Settings.GoogleAnalyticsId');
        </script>
    }
</head>
<body class="flex flex-col min-h-screen">
    @* Announcement Bar *@
    @if (Tenant.Settings.AnnouncementBarActive && !string.IsNullOrWhiteSpace(Tenant.Settings.AnnouncementBarText))
    {
        <div id="announcement-bar" class="text-white text-center text-sm py-2 px-4 relative"
             style="background-color: @(Tenant.Settings.AnnouncementBarColor ?? Tenant.Settings.PrimaryColor)">
            <span>@Tenant.Settings.AnnouncementBarText</span>
            <button id="close-announcement" class="absolute right-4 top-1/2 -translate-y-1/2 text-white hover:opacity-70" aria-label="Kapat">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    }

    @* Header *@
    <header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center space-x-2">
                    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.LogoUrl))
                    {
                        <img src="@Tenant.Settings.LogoUrl" alt="@Tenant.Settings.StoreName" class="h-10 w-auto" />
                    }
                    else
                    {
                        <span class="text-xl font-bold text-primary">@Tenant.Settings.StoreName</span>
                    }
                </a>
                <div class="hidden md:flex flex-1 max-w-lg mx-8">
                    <div class="relative w-full">
                        <input type="text" placeholder="Urun ara..." class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/hesabim" class="text-gray-600 hover:text-primary transition-colors text-sm font-medium">Hesabim</a>
                    <a href="/sepet" class="relative text-gray-600 hover:text-primary transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                        </svg>
                        <span class="absolute -top-2 -right-2 bg-primary text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">0</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    @* Mega Menu *@
    @await Component.InvokeAsync("MegaMenu")

    @* Main Content *@
    <main class="flex-1">
        @RenderBody()
    </main>

    @* Footer *@
    <footer class="bg-gray-900 text-gray-300 pt-12 pb-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
                @* Kurumsal *@
                <div>
                    <h3 class="text-white font-semibold text-lg mb-4">Kurumsal</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="/hakkimizda" class="hover:text-white transition-colors">Hakkimizda</a></li>
                        <li><a href="/iletisim" class="hover:text-white transition-colors">Iletisim</a></li>
                    </ul>
                </div>
                @* Musteri Hizmetleri *@
                <div>
                    <h3 class="text-white font-semibold text-lg mb-4">Musteri Hizmetleri</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="/iade-politikasi" class="hover:text-white transition-colors">Iade Politikasi</a></li>
                        <li><a href="/teslimat-kosullari" class="hover:text-white transition-colors">Teslimat Kosullari</a></li>
                        <li><a href="/sss" class="hover:text-white transition-colors">Sikca Sorulan Sorular</a></li>
                    </ul>
                </div>
                @* Iletisim *@
                <div>
                    <h3 class="text-white font-semibold text-lg mb-4">Iletisim</h3>
                    <ul class="space-y-2 text-sm">
                        @if (!string.IsNullOrWhiteSpace(Tenant.Settings.ContactPhone))
                        {
                            <li>Tel: @Tenant.Settings.ContactPhone</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Tenant.Settings.ContactEmail))
                        {
                            <li>E-posta: @Tenant.Settings.ContactEmail</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Tenant.Settings.Address))
                        {
                            <li>@Tenant.Settings.Address, @Tenant.Settings.City</li>
                        }
                    </ul>
                </div>
                @* Yasal *@
                <div>
                    <h3 class="text-white font-semibold text-lg mb-4">Yasal</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a href="/gizlilik-politikasi" class="hover:text-white transition-colors">Gizlilik Politikasi</a></li>
                        <li><a href="/kullanim-kosullari" class="hover:text-white transition-colors">Kullanim Kosullari</a></li>
                        <li><a href="/kvkk" class="hover:text-white transition-colors">KVKK</a></li>
                        <li><a href="/cerez-politikasi" class="hover:text-white transition-colors">Cerez Politikasi</a></li>
                        <li><a href="/mesafeli-satis-sozlesmesi" class="hover:text-white transition-colors">Mesafeli Satis Sozlesmesi</a></li>
                    </ul>
                </div>
            </div>
            @* Bottom Bar *@
            <div class="border-t border-gray-700 pt-6 flex flex-col md:flex-row items-center justify-between">
                <p class="text-sm">&copy; @DateTime.Now.Year @Tenant.Settings.CompanyName. Tum haklari saklidir.</p>
                <div class="flex items-center space-x-4 mt-4 md:mt-0">
                    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.InstagramUrl))
                    {
                        <a href="@Tenant.Settings.InstagramUrl" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Instagram">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.FacebookUrl))
                    {
                        <a href="@Tenant.Settings.FacebookUrl" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Facebook">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.TwitterUrl))
                    {
                        <a href="@Tenant.Settings.TwitterUrl" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Twitter">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.YouTubeUrl))
                    {
                        <a href="@Tenant.Settings.YouTubeUrl" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="YouTube">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.TikTokUrl))
                    {
                        <a href="@Tenant.Settings.TikTokUrl" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="TikTok">
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                        </a>
                    }
                </div>
            </div>
        </div>
    </footer>

    @* WhatsApp FAB *@
    @if (Tenant.Settings.IsWhatsAppWidgetActive && !string.IsNullOrWhiteSpace(Tenant.Settings.WhatsAppNumber))
    {
        <a href="https://wa.me/@Tenant.Settings.WhatsAppNumber" target="_blank" rel="noopener noreferrer"
           class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 rounded-full flex items-center justify-center shadow-lg hover:bg-green-600 transition-colors"
           aria-label="WhatsApp">
            <svg class="h-7 w-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
    }

    @* Cookie Consent Banner *@
    @if (Tenant.Settings.CookieConsentActive)
    {
        <div id="cookie-consent" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 shadow-lg p-4">
            <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
                <p class="text-sm text-gray-600">
                    Bu web sitesi deneyiminizi gelistirmek icin cerezleri kullanmaktadir.
                    <a href="/cerez-politikasi" class="text-primary hover:underline">Cerez Politikasi</a>
                </p>
                <div class="flex items-center space-x-3">
                    <button id="cookie-reject" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">Reddet</button>
                    <button id="cookie-accept" class="px-4 py-2 text-sm bg-primary text-white rounded-lg hover:opacity-90 transition-opacity">Kabul Et</button>
                </div>
            </div>
        </div>
    }

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
