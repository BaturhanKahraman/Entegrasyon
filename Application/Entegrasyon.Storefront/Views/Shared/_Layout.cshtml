@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@functions {
    // Hex (#RRGGBB) → "R G B" RGB triplet (Tailwind alpha-value uyumlu, "rgb(255 143 177 / 0.1)" gibi).
    static string HexToRgbTriplet(string? hex, string fallback)
    {
        var h = string.IsNullOrWhiteSpace(hex) ? fallback : hex.Trim();
        if (h.StartsWith("#")) h = h[1..];
        if (h.Length == 3) h = string.Concat(h.Select(c => $"{c}{c}"));
        if (h.Length != 6) h = fallback.TrimStart('#');
        var r = Convert.ToInt32(h[..2], 16);
        var g = Convert.ToInt32(h[2..4], 16);
        var b = Convert.ToInt32(h[4..6], 16);
        return $"{r} {g} {b}";
    }
}
@{
    var settings = Tenant.Settings;
    var storeName = string.IsNullOrWhiteSpace(settings.StoreName) ? "Zekids Bebe" : settings.StoreName;
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? storeName : $"{pageTitle} · {storeName}";
    var wishlistCount = (int)(ViewData["WishlistCount"] ?? 0);
    var cartCount = (int)(ViewData["CartCount"] ?? 0);
    var cartTotal = (decimal)(ViewData["CartTotal"] ?? 0m);

    var primaryHex   = string.IsNullOrWhiteSpace(settings.PrimaryColor) ? "#FF8FB1" : settings.PrimaryColor;
    var secondaryHex = string.IsNullOrWhiteSpace(settings.SecondaryColor) ? "#8FCBE8" : settings.SecondaryColor;
    var accentHex    = string.IsNullOrWhiteSpace(settings.AccentColor) ? "#FFD56B" : settings.AccentColor;
    var primaryRgb   = HexToRgbTriplet(primaryHex, "#FF8FB1");
    var secondaryRgb = HexToRgbTriplet(secondaryHex, "#8FCBE8");
    var accentRgb    = HexToRgbTriplet(accentHex, "#FFD56B");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    @if (!string.IsNullOrWhiteSpace(settings.FaviconUrl))
    {
        <link rel="icon" href="@settings.FaviconUrl" />
    }
    <style>
        :root {
            --color-primary: @primaryHex;
            --color-secondary: @secondaryHex;
            --color-accent: @accentHex;
            /* Tailwind alpha varyantı (bg-primary/10, text-primary/60 vs.) için RGB triplet form. */
            --color-primary-rgb: @primaryRgb;
            --color-secondary-rgb: @secondaryRgb;
            --color-accent-rgb: @accentRgb;
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(settings.CustomCss))
    {
        <style>@Html.Raw(settings.CustomCss)</style>
    }
    @await RenderSectionAsync("Head", required: false)
    @if (ViewData["JsonLd"] is string jsonLd)
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }
    @if (!string.IsNullOrWhiteSpace(settings.GoogleAnalyticsId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@settings.GoogleAnalyticsId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@settings.GoogleAnalyticsId');
        </script>
    }
</head>
<body class="antialiased">

    @* ============ ANNOUNCEMENT BAR ============ *@
    @if (settings.AnnouncementBarActive && !string.IsNullOrWhiteSpace(settings.AnnouncementBarText))
    {
        <div id="announce" class="bg-charcoal text-white text-xs sm:text-sm" style="@(string.IsNullOrWhiteSpace(settings.AnnouncementBarColor) ? "" : $"background-color: {settings.AnnouncementBarColor}")">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-center gap-2 relative">
                <span class="text-center">@Html.Raw(settings.AnnouncementBarText)</span>
                <button type="button" data-announce-close aria-label="Duyuruyu kapat" class="absolute right-3 sm:right-6 text-white/70 hover:text-white transition">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
        </div>
    }

    @* ============ HEADER ============ *@
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-cream-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="h-16 lg:h-20 flex items-center justify-between gap-4">

                @* left: mobile menu + logo *@
                <div class="flex items-center gap-3">
                    <button type="button" data-drawer-open aria-label="Menüyü aç" class="lg:hidden p-2 -ml-2 text-charcoal hover:text-primary transition">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
                    </button>
                    <a href="/" class="leading-none flex items-center">
                        <img src="@(string.IsNullOrWhiteSpace(settings.LogoUrl) ? "/img/zekids-logo.png" : settings.LogoUrl)" alt="@storeName" class="h-8 lg:h-10 w-auto" />
                    </a>
                </div>

                @* center: desktop nav *@
                <nav class="hidden lg:flex items-center gap-1 text-sm font-medium">
                    <button type="button" data-mega-toggle id="megaTrigger" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-charcoal hover:bg-cream transition">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
                        Tüm Kategoriler
                    </button>
                    <a href="/kategori/yeni-gelenler" class="px-3 py-2 rounded-xl hover:bg-cream transition">Yeni Gelenler</a>
                    <a href="/kategori/kiz" class="px-3 py-2 rounded-xl hover:bg-cream transition">Kız</a>
                    <a href="/kategori/erkek" class="px-3 py-2 rounded-xl hover:bg-cream transition">Erkek</a>
                    <a href="/kategori/bebek" class="px-3 py-2 rounded-xl hover:bg-cream transition">Bebek</a>
                    <a href="/kategori/outlet" class="px-3 py-2 rounded-xl text-danger hover:bg-danger/10 transition">Outlet</a>
                </nav>

                @* right: actions *@
                <div class="flex items-center gap-1 sm:gap-2">
                    <button type="button" data-search-open aria-label="Ara" class="p-2.5 rounded-full text-charcoal hover:bg-cream transition">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    </button>
                    <a href="/hesabim" class="hidden sm:flex p-2.5 rounded-full text-charcoal hover:bg-cream transition items-center" aria-label="Hesabım">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                    </a>
                    <a href="/favorilerim" class="relative p-2.5 rounded-full text-charcoal hover:bg-cream transition" aria-label="Favorilerim">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A4.5 4.5 0 0 0 12 5.5 4.5 4.5 0 0 0 2 8.5C2 10.8 3.5 12.5 5 14l7 7Z"/></svg>
                        <span id="wishCount" class="absolute -top-0.5 -right-0.5 bg-primary text-white text-[10px] font-semibold min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center @(wishlistCount == 0 ? "hidden" : "")">@wishlistCount</span>
                    </a>
                    <a href="/sepetim" class="flex items-center gap-2 pl-2.5 pr-3 sm:pr-4 py-2 rounded-full bg-primary text-white hover:bg-primary/90 transition" aria-label="Sepetim">
                        <span class="relative">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                            <span class="absolute -top-2 -right-2 bg-white text-primary text-[10px] font-semibold min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center @(cartCount == 0 ? "hidden" : "")">@cartCount</span>
                        </span>
                        <span class="hidden sm:inline text-sm font-semibold">@cartTotal.ToString("N0")₺</span>
                    </a>
                </div>
            </div>
        </div>

        @* ===== MEGA MENU ===== *@
        <div id="mega" class="hidden absolute inset-x-0 top-full bg-cream border-b border-cream-300 shadow-md">
            @await Component.InvokeAsync("MegaMenu")
        </div>
    </header>

    @* ============ MOBILE DRAWER ============ *@
    <div id="drawerWrap" class="hidden fixed inset-0 z-50 lg:hidden">
        <div data-drawer-close class="absolute inset-0 bg-charcoal/40"></div>
        <div class="absolute left-0 top-0 h-full w-[82%] max-w-xs bg-white shadow-md flex flex-col">
            <div class="flex items-center justify-between px-5 h-16 border-b border-cream-300">
                <img src="@(string.IsNullOrWhiteSpace(settings.LogoUrl) ? "/img/zekids-logo.png" : settings.LogoUrl)" alt="@storeName" class="h-7 w-auto" />
                <button type="button" data-drawer-close aria-label="Menüyü kapat" class="p-2 text-charcoal/60 hover:text-charcoal">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <nav class="flex-1 overflow-y-auto p-4 text-charcoal">
                <a href="/kategori/yeni-gelenler" class="block px-4 py-3 rounded-xl hover:bg-cream font-medium">Yeni Gelenler</a>
                <a href="/kategori/kiz" class="block px-4 py-3 rounded-xl hover:bg-cream font-medium">Kız</a>
                <a href="/kategori/erkek" class="block px-4 py-3 rounded-xl hover:bg-cream font-medium">Erkek</a>
                <a href="/kategori/bebek" class="block px-4 py-3 rounded-xl hover:bg-cream font-medium">Bebek</a>
                <a href="/kategori/outlet" class="block px-4 py-3 rounded-xl hover:bg-danger/10 text-danger font-medium">Outlet</a>
                <div class="my-3 border-t border-cream-300"></div>
                <a href="/hesabim" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-cream">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                    Hesabım
                </a>
                <a href="/favorilerim" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-cream">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A4.5 4.5 0 0 0 12 5.5 4.5 4.5 0 0 0 2 8.5C2 10.8 3.5 12.5 5 14l7 7Z"/></svg>
                    Favorilerim
                </a>
            </nav>
            @if (!string.IsNullOrWhiteSpace(settings.WhatsAppNumber))
            {
                <div class="p-5 border-t border-cream-300 text-sm text-muted">
                    <a href="https://wa.me/@settings.WhatsAppNumber" class="flex items-center gap-2 text-success font-medium">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg>
                        WhatsApp Destek
                    </a>
                </div>
            }
        </div>
    </div>

    @* ============ SEARCH OVERLAY ============ *@
    <div id="searchWrap" class="hidden fixed inset-0 z-50">
        <div data-search-close class="absolute inset-0 bg-charcoal/40"></div>
        <div class="absolute inset-x-0 top-0 bg-white shadow-md">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 py-6">
                <form action="/arama" method="get" class="flex items-center gap-3">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <input id="searchInput" type="text" name="q" placeholder="Ürün, kategori veya marka arayın…" class="flex-1 text-lg outline-none placeholder:text-muted bg-transparent" />
                    <button type="button" data-search-close aria-label="Aramayı kapat" class="p-2 text-charcoal/50 hover:text-charcoal">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </form>
                <div class="mt-5">
                    <p class="text-xs uppercase tracking-wide text-muted mb-2.5">Popüler aramalar</p>
                    <div class="flex flex-wrap gap-2">
                        <a href="/arama?q=tulum" class="px-3.5 py-1.5 rounded-full bg-cream text-sm hover:bg-cream-300 transition">Tulum</a>
                        <a href="/arama?q=yazlik+elbise" class="px-3.5 py-1.5 rounded-full bg-cream text-sm hover:bg-cream-300 transition">Yazlık elbise</a>
                        <a href="/arama?q=body+seti" class="px-3.5 py-1.5 rounded-full bg-cream text-sm hover:bg-cream-300 transition">Body seti</a>
                        <a href="/arama?q=pijama+takimi" class="px-3.5 py-1.5 rounded-full bg-cream text-sm hover:bg-cream-300 transition">Pijama takımı</a>
                        <a href="/arama?q=hastane+cikisi" class="px-3.5 py-1.5 rounded-full bg-cream text-sm hover:bg-cream-300 transition">Hastane çıkışı</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <main>
        @RenderBody()
    </main>

    @* ============ FOOTER ============ *@
    <footer class="bg-charcoal text-white/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
                <div>
                    <img src="@(string.IsNullOrWhiteSpace(settings.LogoUrl) ? "/img/zekids-logo.png" : settings.LogoUrl)" alt="@storeName" class="h-8 w-auto bg-white/95 rounded-lg p-1.5 inline-block" />
                    @if (!string.IsNullOrWhiteSpace(settings.StoreSlogan))
                    {
                        <p class="text-sm mt-4 leading-relaxed text-white/60 max-w-xs">@settings.StoreSlogan</p>
                    }
                    else
                    {
                        <p class="text-sm mt-4 leading-relaxed text-white/60 max-w-xs">Minik dolaplara büyük ilham. 0–14 yaş çocuk giyiminde sevgiyle seçilmiş parçalar.</p>
                    }
                    <div class="flex items-center gap-3 mt-5">
                        @if (!string.IsNullOrWhiteSpace(settings.InstagramUrl))
                        {
                            <a href="@settings.InstagramUrl" aria-label="Instagram" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary transition">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings.FacebookUrl))
                        {
                            <a href="@settings.FacebookUrl" aria-label="Facebook" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary transition">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/></svg>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings.YouTubeUrl))
                        {
                            <a href="@settings.YouTubeUrl" aria-label="YouTube" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary transition">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 8s-.2-1.5-.8-2.1c-.8-.8-1.6-.8-2-.9C16.4 4.7 12 4.7 12 4.7s-4.4 0-7.2.3c-.4 0-1.2 0-2 .9C2.2 6.5 2 8 2 8s-.2 1.7-.2 3.5v1c0 1.8.2 3.5.2 3.5s.2 1.5.8 2.1c.8.8 1.8.8 2.3.9 1.7.2 7 .3 7 .3s4.4 0 7.2-.3c.4 0 1.2 0 2-.9.6-.6.8-2.1.8-2.1s.2-1.7.2-3.5v-1C22.2 9.7 22 8 22 8Z"/><path d="m10 15 5-3-5-3Z"/></svg>
                            </a>
                        }
                    </div>
                </div>
                <div>
                    <h4 class="font-semibold text-white mb-4 text-sm">Hakkımızda</h4>
                    <ul class="space-y-2.5 text-sm text-white/60">
                        <li><a href="/sayfa/biz-kimiz" class="hover:text-white transition">Biz Kimiz</a></li>
                        <li><a href="/sayfa/Mağazalarimiz" class="hover:text-white transition">Mağazalarımız</a></li>
                        <li><a href="/sayfa/kariyer" class="hover:text-white transition">Kariyer</a></li>
                        <li><a href="/sayfa/blog" class="hover:text-white transition">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold text-white mb-4 text-sm">Yardım & İletişim</h4>
                    <ul class="space-y-2.5 text-sm text-white/60">
                        <li><a href="/sayfa/sss" class="hover:text-white transition">Sıkça Sorulan Sorular</a></li>
                        <li><a href="/sayfa/kargo" class="hover:text-white transition">Kargo & Teslimat</a></li>
                        <li><a href="/sayfa/iade" class="hover:text-white transition">İade & Değişim</a></li>
                        <li><a href="/sayfa/kvkk" class="hover:text-white transition">KVKK Aydınlatma</a></li>
                        <li><a href="/İletişim" class="hover:text-white transition">İletişim</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold text-white mb-4 text-sm">Bize Ulaşın</h4>
                    <ul class="space-y-3 text-sm text-white/60">
                        @if (!string.IsNullOrWhiteSpace(settings.ContactPhone))
                        {
                            <li class="flex items-start gap-2.5"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z"/></svg> @settings.ContactPhone</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings.ContactEmail))
                        {
                            <li class="flex items-start gap-2.5"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 shrink-0" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg> <a href="mailto:@settings.ContactEmail" class="hover:text-white transition">@settings.ContactEmail</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings.City))
                        {
                            <li class="flex items-start gap-2.5"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> @(string.IsNullOrWhiteSpace(settings.District) ? settings.City : $"{settings.District}, {settings.City}")</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(settings.WhatsAppNumber))
                        {
                            <li class="flex items-start gap-2.5 text-success"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg> <a href="https://wa.me/@settings.WhatsAppNumber" class="hover:text-success/80 transition">WhatsApp Destek</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="border-t border-white/10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50">
                <p>© @DateTime.UtcNow.Year @storeName. Tüm hakları saklıdır.</p>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded-md bg-white/10 font-medium tracking-wide">VISA</span>
                    <span class="px-2.5 py-1 rounded-md bg-white/10 font-medium tracking-wide">Mastercard</span>
                    <span class="px-2.5 py-1 rounded-md bg-white/10 font-medium tracking-wide">TROY</span>
                </div>
            </div>
        </div>
    </footer>

    @* ============ TOAST ============ *@
    <div id="toast" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-[60] bg-charcoal text-white text-sm px-5 py-3 rounded-full shadow-md"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
