@model Entegrasyon.Entity.Dtos.Storefront.StorefrontProductCardDto
@{
    var slug = string.IsNullOrWhiteSpace(Model.SeoSlug) ? Model.Id.ToString() : Model.SeoSlug;
    var hasDiscount = Model.OldPrice.HasValue && Model.OldPrice.Value > Model.MinPrice;
    var discountPct = hasDiscount ? (int)Math.Round((1 - (double)(Model.MinPrice / Model.OldPrice!.Value)) * 100) : 0;
    var isOutOfStock = Model.TotalStock <= 0;
    var ariaLabel = $"{Model.Title}, {Model.MinPrice:N0}₺";
}
<div class="group snap-start">
    <a href="/urun/@slug" class="block" aria-label="@ariaLabel">
        <div class="ph relative aspect-[4/5] rounded-2xl bg-cream overflow-hidden" data-ph="ürün görseli">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img class="photo" loading="lazy" alt="@Model.Title" src="@Model.ImageUrl" />
            }

            <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start">
                @if (Model.IsNew)
                {
                    <span class="px-2.5 py-1 rounded-full bg-primary text-white text-[11px] font-semibold">Yeni</span>
                }
                @if (hasDiscount)
                {
                    <span class="px-2.5 py-1 rounded-full bg-success text-white text-[11px] font-semibold">%@discountPct</span>
                }
            </div>

            <button type="button" data-wishlist-toggle data-product-id="@Model.Id" data-on="0" aria-label="Favorilere ekle"
                    class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur flex items-center justify-center text-charcoal hover:text-primary transition shadow-sm">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A4.5 4.5 0 0 0 12 5.5 4.5 4.5 0 0 0 2 8.5C2 10.8 3.5 12.5 5 14l7 7Z"/></svg>
            </button>

            @if (isOutOfStock)
            {
                <div class="absolute inset-0 bg-white/60 flex items-center justify-center">
                    <span class="px-4 py-1.5 rounded-full bg-charcoal text-white text-sm font-semibold">Stokta Yok</span>
                </div>
            }
            else
            {
                <div class="absolute inset-x-3 bottom-3 translate-y-[130%] group-hover:translate-y-0 transition duration-300">
                    <span class="block w-full text-center bg-white text-charcoal text-sm font-semibold py-2.5 rounded-full shadow-sm">Hızlı Bakış</span>
                </div>
            }
        </div>
    </a>
    <div class="mt-3">
        @if (!string.IsNullOrWhiteSpace(Model.BrandName))
        {
            <p class="text-xs text-muted">@Model.BrandName</p>
        }
        <a href="/urun/@slug" class="block font-medium text-charcoal line-clamp-2 leading-snug mt-0.5 hover:text-primary transition">@Model.Title</a>
        @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
        {
            <span class="inline-block mt-2 px-2 py-0.5 rounded-md bg-cream text-[11px] text-muted">@Model.CategoryName</span>
        }
        <div class="mt-2 flex items-baseline gap-2">
            @if (hasDiscount)
            {
                <span class="text-sm text-muted line-through">@Model.OldPrice!.Value.ToString("N0")₺</span>
            }
            <span class="text-lg font-semibold text-primary">@Model.MinPrice.ToString("N0")₺</span>
        </div>
    </div>
</div>
