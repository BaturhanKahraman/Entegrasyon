@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    Layout = "_Layout";
    var statusCode = (int)(ViewBag.StatusCode ?? 500);
    var message = (string)(ViewBag.Message ?? "Beklenmeyen bir hata olustu.");
    var categories = ViewBag.TopCategories as List<Entegrasyon.Entity.Dtos.Storefront.CategoryTreeDto>;
}

<section class="flex-1 flex items-center justify-center py-16 px-4">
    <div class="text-center max-w-lg">
        @if (statusCode == 404)
        {
            <p class="text-9xl font-bold text-gray-200 select-none">404</p>
            <h1 class="text-2xl font-semibold text-gray-800 mt-4">Aradiginiz sayfa bulunamadi</h1>
            <p class="text-gray-500 mt-2">Sayfa kaldirilmis, adi degistirilmis veya gecici olarak kullanilamaz durumda olabilir.</p>

            @* Search Box *@
            <div class="mt-8 max-w-sm mx-auto">
                <form action="/arama" method="get" class="flex gap-2">
                    <input type="text" name="q" placeholder="Ne aramistiniz?"
                           class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:opacity-90 transition-opacity">Ara</button>
                </form>
            </div>

            @* Popular Categories *@
            @if (categories is { Count: > 0 })
            {
                <div class="mt-8">
                    <p class="text-sm font-medium text-gray-600 mb-3">Populer Kategoriler</p>
                    <div class="flex flex-wrap justify-center gap-2">
                        @foreach (var cat in categories)
                        {
                            <a href="/kategori/@cat.SeoSlug"
                               class="px-3 py-1.5 bg-gray-100 text-gray-700 text-sm rounded-full hover:bg-gray-200 transition-colors no-underline">
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="mt-8">
                <a href="/" class="btn-primary inline-block px-6 py-2.5 no-underline">Ana Sayfaya Don</a>
            </div>
        }
        else if (statusCode == 500)
        {
            <div class="mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-gray-800">Bir hata olustu</h1>
            <p class="text-gray-500 mt-2">Kisa surede duzelecektir. Lutfen daha sonra tekrar deneyin.</p>

            @if (!string.IsNullOrWhiteSpace(Tenant.Settings.ContactEmail))
            {
                <p class="text-sm text-gray-400 mt-4">
                    Sorun devam ederse:
                    <a href="mailto:@Tenant.Settings.ContactEmail" class="text-primary hover:underline">@Tenant.Settings.ContactEmail</a>
                </p>
            }

            <div class="mt-8">
                <a href="/" class="btn-primary inline-block px-6 py-2.5 no-underline">Ana Sayfaya Don</a>
            </div>
        }
        else if (statusCode == 503)
        {
            <div class="mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <h1 class="text-2xl font-semibold text-gray-800">Bakim Calismasi</h1>
            <p class="text-gray-500 mt-2">@message</p>
            <p class="text-sm text-gray-400 mt-4">Lutfen daha sonra tekrar deneyin.</p>
        }
        else
        {
            <p class="text-9xl font-bold text-gray-200 select-none">@statusCode</p>
            <h1 class="text-2xl font-semibold text-gray-800 mt-4">@message</h1>
            <div class="mt-8">
                <a href="/" class="btn-primary inline-block px-6 py-2.5 no-underline">Ana Sayfaya Don</a>
            </div>
        }
    </div>
</section>
