@using System.Globalization
@{
    ViewData["Title"] = "Hediye Çeki Bakiyem";
    var code = ViewBag.Code as string;
    var result = ViewBag.BalanceResult as Entegrasyon.Entity.Results.IDataResult<decimal>;
    var tr = new CultureInfo("tr-TR");
}

<main class="max-w-md mx-auto px-4 sm:px-6 py-12 lg:py-16">

    <nav aria-label="breadcrumb" class="text-sm text-muted mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-primary transition">Anasayfa</a>
        <span class="text-cream-300">›</span>
        <a href="/hediye-karti" class="hover:text-primary transition">Hediye Çeki</a>
        <span class="text-cream-300">›</span>
        <span class="text-charcoal font-medium">Bakiye</span>
    </nav>

    <div class="bg-white border border-cream-300 rounded-2xl p-7 sm:p-8 shadow-sm">
        <div class="w-14 h-14 rounded-2xl bg-primary/15 text-primary flex items-center justify-center mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
        </div>
        <h1 class="font-heading text-3xl text-charcoal">Hediye Çeki Bakiyem</h1>
        <p class="text-muted mt-2 leading-relaxed">Çek kodunuzu girin, kalan bakiyenizi anında görün.</p>

        <form asp-controller="GiftCard" asp-action="Balance" method="post" class="mt-6">
            <label class="block text-sm font-semibold text-charcoal mb-2" for="code">Çek Kodu</label>
            <input id="code" name="code" type="text" required value="@code" data-gc-balance-code placeholder="ZBGC-XXXX-XXXX" autocomplete="off" class="w-full px-4 py-3 rounded-xl border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition font-mono tracking-wider uppercase" />
            <button type="submit" class="mt-4 w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition">Sorgula</button>
        </form>

        @if (result is not null)
        {
            if (result.Success)
            {
                <div class="mt-6">
                    <div class="bg-success/10 border border-success/25 rounded-2xl p-6 text-center">
                        <p class="text-xs uppercase tracking-wide text-success font-semibold">Mevcut Bakiye</p>
                        <p class="font-heading text-4xl text-primary mt-1.5">@result.Data.ToString("N2", tr)₺</p>
                    </div>
                    <a href="/kategoriler" class="mt-4 w-full inline-flex items-center justify-center py-3 rounded-full border border-cream-300 text-charcoal font-medium hover:border-primary transition">Alışverişe Başla</a>
                </div>
            }
            else
            {
                <div class="mt-6 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3 text-center" role="alert">
                    @(result.Message ?? "Kart bulunamadı. Kodu kontrol edip tekrar deneyin.")
                </div>
            }
        }

        <p class="text-xs text-muted mt-6 flex items-start gap-2 leading-relaxed">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            Çek kodunuzu satın aldığınız e-postada bulabilirsiniz.
        </p>
    </div>

</main>

@section Scripts {
    <script src="~/js/gift-card.js" asp-append-version="true"></script>
}
