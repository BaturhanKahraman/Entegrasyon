@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@using Entegrasyon.Entity.Results
@{
    var code = ViewBag.Code as string;
    var balanceResult = ViewBag.BalanceResult as IDataResult<decimal>;
}

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" />
}

<div class="max-w-lg mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Hediye Karti Sorgula</h1>
    <p class="text-gray-600 mb-8">Hediye karti kodunuzu girerek bakiyenizi ogrenin.</p>

    <form method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Hediye Karti Kodu</label>
            <input type="text" name="code" value="@code" required placeholder="XXXX XXXX XXXX XXXX"
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-center font-mono text-lg tracking-wider uppercase" />
        </div>

        <button type="submit" class="btn-primary w-full py-3">Sorgula</button>
    </form>

    @if (balanceResult is not null)
    {
        <div class="mt-6">
            @if (balanceResult.Success)
            {
                <div class="bg-green-50 border border-green-200 rounded-lg p-6 text-center">
                    <p class="text-sm text-green-700 mb-1">Mevcut Bakiye</p>
                    <p class="text-3xl font-bold text-green-800">@balanceResult.Data.ToString("N2") TL</p>
                </div>
            }
            else
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
                    @balanceResult.Message
                </div>
            }
        </div>
    }

    <div class="mt-8 text-center">
        <a href="/hediye-karti" class="text-primary hover:underline text-sm no-underline">Hediye karti satin al</a>
    </div>
</div>
