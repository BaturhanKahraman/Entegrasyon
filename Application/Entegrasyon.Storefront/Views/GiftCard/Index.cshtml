@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var error = ViewBag.Error as string;
}

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" />
}

<div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Hediye Karti</h1>
    <p class="text-gray-600 mb-8">Sevdiklerinize alisveris hediyesi gonderin.</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
            @error
        </div>
    }

    <form method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Tutar Secin</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                <label class="cursor-pointer">
                    <input type="radio" name="amount" value="50" class="peer sr-only" checked />
                    <div class="text-center py-3 border-2 border-gray-200 rounded-lg peer-checked:border-primary peer-checked:bg-blue-50 transition-colors font-semibold text-gray-700">
                        50 TL
                    </div>
                </label>
                <label class="cursor-pointer">
                    <input type="radio" name="amount" value="100" class="peer sr-only" />
                    <div class="text-center py-3 border-2 border-gray-200 rounded-lg peer-checked:border-primary peer-checked:bg-blue-50 transition-colors font-semibold text-gray-700">
                        100 TL
                    </div>
                </label>
                <label class="cursor-pointer">
                    <input type="radio" name="amount" value="200" class="peer sr-only" />
                    <div class="text-center py-3 border-2 border-gray-200 rounded-lg peer-checked:border-primary peer-checked:bg-blue-50 transition-colors font-semibold text-gray-700">
                        200 TL
                    </div>
                </label>
                <label class="cursor-pointer">
                    <input type="radio" name="amount" value="500" class="peer sr-only" />
                    <div class="text-center py-3 border-2 border-gray-200 rounded-lg peer-checked:border-primary peer-checked:bg-blue-50 transition-colors font-semibold text-gray-700">
                        500 TL
                    </div>
                </label>
            </div>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Alici Bilgileri (Opsiyonel)</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Alici Adi</label>
                    <input type="text" name="recipientName" placeholder="Alicinin adi"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Alici E-posta</label>
                    <input type="email" name="recipientEmail" placeholder="Alicinin e-posta adresi"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mesajiniz</label>
                    <textarea name="message" rows="3" placeholder="Iyi ki varsin!"
                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"></textarea>
                </div>
            </div>
        </div>

        <button type="submit" class="btn-primary w-full py-3">Hediye Karti Olustur</button>
    </form>

    <div class="mt-8 text-center">
        <a href="/hediye-karti-sorgula" class="text-primary hover:underline text-sm no-underline">Hediye karti bakiyesi sorgula</a>
    </div>
</div>
