@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@model Entegrasyon.Entity.Orders.Order

@section Head {
    <title>Sipariş Detay | @Tenant.Settings.StoreName</title>
}

@{
    var seller = ViewBag.Seller as Entegrasyon.Entity.Storefront.Seller;
    var order = Model;
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Sipariş Detay</h1>
            <p class="text-gray-500 text-sm">@order.OrderNumber</p>
        </div>
        <a href="/satici/Siparişlerim" class="text-primary hover:underline text-sm">Siparişlere Don</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm text-gray-500">Sipariş Tarihi</p>
            <p class="text-lg font-semibold">@order.OrderDate?.ToString("dd.MM.yyyy HH:mm")</p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm text-gray-500">Toplam Tutar</p>
            <p class="text-lg font-semibold">@order.GrossAmount?.ToString("C2")</p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm text-gray-500">Durum</p>
            <p class="text-lg font-semibold">@(order.StorefrontOrderStatus?.ToString() ?? "Bilinmiyor")</p>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Musteri Bilgileri</h2>
        <p class="text-gray-700">@order.CustomerFirstName @order.CustomerLastName</p>
        @if (order.ShippingAddress is not null)
        {
            <p class="text-gray-500 text-sm mt-1">@order.ShippingAddress.FullAddress, @order.ShippingAddress.City</p>
        }
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <h2 class="text-lg font-semibold p-6 pb-4">Urunler</h2>
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Barkod</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Adet</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Birim Fiyat</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Komisyon</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Toplam</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var item in order.OrderItems.Where(oi => oi.SellerId == seller?.Id))
                {
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">@(item.Barcode ?? "-")</td>
                        <td class="px-6 py-4 text-sm text-gray-500">@item.Quantity</td>
                        <td class="px-6 py-4 text-sm text-gray-500">@item.UnitPrice.ToString("C2")</td>
                        <td class="px-6 py-4 text-sm text-gray-500">
                            @if (item.CommissionRate.HasValue)
                            {
                                <span>%@item.CommissionRate (@item.CommissionAmount?.ToString("C2"))</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-900 text-right">@((item.UnitPrice * item.Quantity).ToString("C2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
