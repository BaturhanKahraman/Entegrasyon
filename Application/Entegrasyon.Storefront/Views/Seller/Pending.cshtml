@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Basvuru Durumu | @Tenant.Settings.StoreName" />
}

@{
    var seller = ViewBag.Seller as Entegrasyon.Entity.Storefront.Seller;
}

<div class="max-w-lg mx-auto px-4 py-16 text-center">
    <div class="bg-white rounded-lg shadow-lg p-8">
        @if (seller?.Status == Entegrasyon.Entity.Storefront.SellerStatus.Pending)
        {
            <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mb-4">Basvurunuz Inceleniyor</h1>
            <p class="text-gray-600 mb-6">
                Satici basvurunuz basariyla alindi. Ekibimiz en kisa surede basvurunuzu inceleyecektir.
                Onay sonrasi satis yapmaya baslayabilirsiniz.
            </p>
        }
        else if (seller?.Status == Entegrasyon.Entity.Storefront.SellerStatus.Rejected)
        {
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mb-4">Basvurunuz Reddedildi</h1>
            <p class="text-gray-600 mb-2">Neden: @(seller.RejectionReason ?? "Belirtilmedi")</p>
        }
        else if (seller?.Status == Entegrasyon.Entity.Storefront.SellerStatus.Suspended)
        {
            <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mb-4">Hesabiniz Askiya Alindi</h1>
            <p class="text-gray-600 mb-2">Neden: @(seller.RejectionReason ?? "Belirtilmedi")</p>
        }

        <a href="/hesabim" class="inline-block mt-4 text-primary hover:underline">Hesabima Don</a>
    </div>
</div>
