@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@using Entegrasyon.Entity.Orders

@section Head {
    <title>Siparislerim | @Tenant.Settings.StoreName</title>
}

@{
    var seller = ViewBag.Seller as Entegrasyon.Entity.Storefront.Seller;
    var orders = ViewBag.Orders as List<Order> ?? new List<Order>();
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Siparislerim</h1>
        <a href="/satici/panel" class="text-primary hover:underline text-sm">Panele Don</a>
    </div>

    @if (!orders.Any())
    {
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
            Henuz siparisiniz bulunmuyor.
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Siparis No</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tarih</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Musteri</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tutar</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Durum</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Detay</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var order in orders)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 text-sm font-medium text-gray-900">@order.OrderNumber</td>
                            <td class="px-6 py-4 text-sm text-gray-500">@order.OrderDate?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="px-6 py-4 text-sm text-gray-500">@order.CustomerFirstName @order.CustomerLastName</td>
                            <td class="px-6 py-4 text-sm text-gray-900">@order.GrossAmount?.ToString("C2")</td>
                            <td class="px-6 py-4 text-sm">
                                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                                    @(order.StorefrontOrderStatus switch {
                                        Entegrasyon.Entity.Storefront.OrderStatus.Received => "bg-blue-100 text-blue-800",
                                        Entegrasyon.Entity.Storefront.OrderStatus.Preparing => "bg-yellow-100 text-yellow-800",
                                        Entegrasyon.Entity.Storefront.OrderStatus.Shipped => "bg-purple-100 text-purple-800",
                                        Entegrasyon.Entity.Storefront.OrderStatus.Delivered => "bg-green-100 text-green-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    })">
                                    @(order.StorefrontOrderStatus?.ToString() ?? "Bilinmiyor")
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/satici/siparis/@order.Id" class="text-primary hover:underline text-sm">Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
