@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@using Entegrasyon.Entity.Storefront

@section Head {
    <title>Bakiye | @Tenant.Settings.StoreName</title>
}

@{
    var seller = ViewBag.Seller as Seller;
    var balance = ViewBag.Balance as SellerBalance;
    var transactions = ViewBag.Transactions as List<SellerTransaction> ?? new List<SellerTransaction>();
    var payouts = ViewBag.Payouts as List<PayoutRequest> ?? new List<PayoutRequest>();
    var payoutMessage = TempData["PayoutMessage"] as string;
    var payoutSuccess = TempData["PayoutSuccess"] as bool?;
    var available = balance is not null ? balance.CurrentBalance - balance.PendingAmount : 0m;
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Bakiye</h1>
        <a href="/satici/panel" class="text-primary hover:underline text-sm">Panele Don</a>
    </div>

    @if (payoutMessage is not null)
    {
        <div class="mb-6 p-4 rounded-lg @(payoutSuccess == true ? "bg-green-50 text-green-800 border border-green-200" : "bg-red-50 text-red-800 border border-red-200")">
            @payoutMessage
        </div>
    }

    @if (balance is not null)
    {
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Mevcut Bakiye</p>
                <p class="text-3xl font-bold text-green-600">@balance.CurrentBalance.ToString("C2")</p>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Toplam Kazanc</p>
                <p class="text-2xl font-bold text-gray-900">@balance.TotalEarned.ToString("C2")</p>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Bekleyen Odeme</p>
                <p class="text-2xl font-bold text-yellow-600">@balance.PendingAmount.ToString("C2")</p>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-sm text-gray-500">Toplam Odenen</p>
                <p class="text-2xl font-bold text-gray-900">@balance.TotalPaidOut.ToString("C2")</p>
            </div>
        </div>

        @if (available > 0)
        {
            <div class="bg-white rounded-lg shadow p-6 mb-8">
                <h2 class="text-lg font-semibold mb-4">Odeme Talebi Olustur</h2>
                <form method="post" action="/satici/odeme-talebi" class="flex items-end gap-4">
                    @Html.AntiForgeryToken()
                    <div class="flex-1">
                        <label class="block text-sm text-gray-600 mb-1">Tutar (Maks: @available.ToString("C2"))</label>
                        <input type="number" name="amount" step="0.01" min="1" max="@available"
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
                               required />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-600 mb-1">IBAN</label>
                        <input type="text" value="@seller?.Iban" disabled
                               class="w-full px-4 py-2 border rounded-lg bg-gray-50 text-gray-500" />
                    </div>
                    <button type="submit" class="btn-primary !py-2 !px-6">Talep Olustur</button>
                </form>
            </div>
        }
    }

    @* Payout History *@
    @if (payouts.Any())
    {
        <div class="bg-white rounded-lg shadow overflow-hidden mb-8">
            <h2 class="text-lg font-semibold p-6 pb-4">Odeme Talepleri</h2>
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tarih</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tutar</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IBAN</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Durum</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Not</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var p in payouts)
                    {
                        <tr>
                            <td class="px-6 py-4 text-sm text-gray-500">@p.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td class="px-6 py-4 text-sm font-medium text-gray-900">@p.Amount.ToString("C2")</td>
                            <td class="px-6 py-4 text-sm text-gray-500">@p.Iban</td>
                            <td class="px-6 py-4 text-sm">
                                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                                    @(p.Status switch {
                                        PayoutStatus.Pending => "bg-yellow-100 text-yellow-800",
                                        PayoutStatus.Processing => "bg-blue-100 text-blue-800",
                                        PayoutStatus.Completed => "bg-green-100 text-green-800",
                                        PayoutStatus.Rejected => "bg-red-100 text-red-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    })">
                                    @p.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">@(p.Note ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Transaction History *@
    @if (transactions.Any())
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <h2 class="text-lg font-semibold p-6 pb-4">Islem Gecmisi</h2>
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tarih</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tur</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tutar</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Bakiye</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Aciklama</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var tx in transactions)
                    {
                        <tr>
                            <td class="px-6 py-4 text-sm text-gray-500">@tx.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="px-6 py-4 text-sm">
                                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                                    @(tx.TransactionType switch {
                                        "Sale" => "bg-green-100 text-green-800",
                                        "Commission" => "bg-red-100 text-red-800",
                                        "Payout" => "bg-blue-100 text-blue-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    })">
                                    @tx.TransactionType
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm font-medium @(tx.Amount >= 0 ? "text-green-600" : "text-red-600")">
                                @tx.Amount.ToString("C2")
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-900">@tx.BalanceAfter.ToString("C2")</td>
                            <td class="px-6 py-4 text-sm text-gray-500">@(tx.Description ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
