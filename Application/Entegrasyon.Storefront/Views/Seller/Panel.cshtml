@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <title>Satici Paneli | @Tenant.Settings.StoreName</title>
}

@{
    var seller = ViewBag.Seller as Entegrasyon.Entity.Storefront.Seller;
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Satici Paneli</h1>
            <p class="text-gray-600">Hosgeldiniz, @seller?.StoreName</p>
        </div>
        <a href="/magaza/@seller?.StoreSlug" class="text-primary hover:underline text-sm" target="_blank">
            Magazami Gor
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm text-gray-500">Toplam Satis</p>
            <p class="text-3xl font-bold text-gray-900">@(seller?.TotalSales ?? 0)</p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm text-gray-500">Ortalama Puan</p>
            <p class="text-3xl font-bold text-gray-900">@(seller?.AverageRating.ToString("F1") ?? "0.0")</p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm text-gray-500">Komisyon Orani</p>
            <p class="text-3xl font-bold text-gray-900">%@(seller?.DefaultCommissionRate ?? 0)</p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm text-gray-500">Durum</p>
            <p class="text-3xl font-bold text-green-600">Aktif</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/satici/urunlerim" class="bg-white rounded-lg shadow p-6 hover:shadow-md transition block no-underline">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Urunlerim</h2>
            </div>
            <p class="text-gray-600 text-sm">Sattginiz urunleri yonetin, fiyat ve stok guncelleyin.</p>
        </a>
        <a href="/satici/Siparişlerim" class="bg-white rounded-lg shadow p-6 hover:shadow-md transition block no-underline">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Siparişlerim</h2>
            </div>
            <p class="text-gray-600 text-sm">Gelen Siparişleri takip edin ve durumlarini guncelleyin.</p>
        </a>
        <a href="/satici/bakiye" class="bg-white rounded-lg shadow p-6 hover:shadow-md transition block no-underline">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Bakiye</h2>
            </div>
            <p class="text-gray-600 text-sm">Bakiyenizi goruntuleyun ve odeme talebi olusturun.</p>
        </a>
        <a href="/satici/urun-ekle" class="bg-white rounded-lg shadow p-6 hover:shadow-md transition block no-underline">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Urun Ekle</h2>
            </div>
            <p class="text-gray-600 text-sm">Katalogdan yeni urun secin ve fiyatlandirin.</p>
        </a>
        <a href="/satici/Profile" class="bg-white rounded-lg shadow p-6 hover:shadow-md transition block no-underline">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Profilim</h2>
            </div>
            <p class="text-gray-600 text-sm">Magaza bilgilerinizi ve iletisim detaylarinizi guncelleyin.</p>
        </a>
        <a href="/hesabim" class="bg-white rounded-lg shadow p-6 hover:shadow-md transition block no-underline">
            <div class="flex items-center mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <h2 class="text-lg font-semibold text-gray-900">Hesabim</h2>
            </div>
            <p class="text-gray-600 text-sm">Kisisel hesap ayarlariniza donun.</p>
        </a>
    </div>
</div>
