@using Entegrasyon.Entity
@using Entegrasyon.Entity.Dtos.Storefront
@{
    var q = ViewBag.SearchQuery as string;
    var products = ViewBag.Products as Pageable<StorefrontProductCardDto> ?? new Pageable<StorefrontProductCardDto>(Array.Empty<StorefrontProductCardDto>(), 1, 24, 0);

    ViewData["Title"] = string.IsNullOrWhiteSpace(q) ? "Arama" : $"\"{q}\" için arama sonuçları";

    var currentPage = products.CurrentPageIndex < 1 ? 1 : products.CurrentPageIndex;
    var totalPages = products.TotalPageCount;
    var rangeStart = products.TotalItemCount == 0 ? 0 : (currentPage - 1) * products.PageSize + 1;
    var rangeEnd = Math.Min(currentPage * products.PageSize, products.TotalItemCount);

    string PageUrl(int p) => $"/arama?q={Uri.EscapeDataString(q ?? "")}&Page={p}";
}

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">

    <nav aria-label="breadcrumb" class="text-sm text-muted mb-6 flex items-center gap-2 overflow-x-auto whitespace-nowrap no-scrollbar">
        <a href="/" class="hover:text-primary transition">Anasayfa</a>
        <span class="text-cream-300">›</span>
        <span class="text-charcoal font-medium">Arama</span>
    </nav>

    @* SEARCH BAND *@
    <div class="bg-cream rounded-3xl mb-8">
        <div class="px-6 sm:px-8 py-7 sm:py-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
            <div>
                <p class="text-xs uppercase tracking-wide text-muted">Arama sonuçları</p>
                <h1 class="font-heading text-2xl sm:text-3xl text-charcoal mt-1 leading-tight">
                    @if (!string.IsNullOrWhiteSpace(q))
                    {
                        <span class="text-primary italic">“@q”</span> <text>için</text> <span>@products.TotalItemCount</span> <text>sonuç bulundu</text>
                    }
                    else
                    {
                        <text>Ne aramıştınız?</text>
                    }
                </h1>
            </div>
            <form action="/arama" method="get" class="w-full lg:w-96 shrink-0">
                <div class="flex items-center gap-2 bg-white border border-cream-300 rounded-full pl-5 pr-2 py-2 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" class="shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <input name="q" type="text" value="@q" placeholder="Sonuçları daraltın…" autocomplete="off" class="flex-1 min-w-0 text-sm outline-none placeholder:text-muted bg-transparent" />
                    <button type="submit" class="shrink-0 rounded-full bg-primary text-white px-4 py-2 text-sm font-semibold hover:bg-primary/90 transition">Ara</button>
                </div>
            </form>
        </div>
    </div>

    @if (products.HasItem)
    {
        <div class="flex items-center justify-between gap-4 mb-6">
            <div>
                <p class="font-semibold text-charcoal">@products.TotalItemCount ürün</p>
                <p class="text-xs text-muted mt-0.5">@rangeStart–@rangeEnd arası gösteriliyor</p>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            @foreach (var p in products.Items)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-12 flex items-center justify-center gap-2 flex-wrap" aria-label="Sayfalama">
                @if (currentPage > 1)
                {
                    <a href="@PageUrl(currentPage - 1)" class="px-4 h-10 rounded-full border border-cream-300 text-sm text-charcoal hover:bg-cream transition flex items-center gap-1">‹ Önceki</a>
                }
                else
                {
                    <span class="px-4 h-10 rounded-full border border-cream-300 text-sm text-charcoal opacity-50 cursor-not-allowed flex items-center gap-1">‹ Önceki</span>
                }
                @for (var p = 1; p <= totalPages; p++)
                {
                    if (p == currentPage)
                    {
                        <span class="w-10 h-10 rounded-full bg-primary text-white font-semibold flex items-center justify-center" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a href="@PageUrl(p)" class="w-10 h-10 rounded-full border border-cream-300 hover:bg-cream transition flex items-center justify-center">@p</a>
                    }
                }
                @if (currentPage < totalPages)
                {
                    <a href="@PageUrl(currentPage + 1)" class="px-4 h-10 rounded-full border border-cream-300 text-sm text-charcoal hover:bg-cream transition flex items-center gap-1">Sonraki ›</a>
                }
                else
                {
                    <span class="px-4 h-10 rounded-full border border-cream-300 text-sm text-charcoal opacity-50 cursor-not-allowed flex items-center gap-1">Sonraki ›</span>
                }
            </nav>
        }
    }
    else if (!string.IsNullOrWhiteSpace(q))
    {
        <div class="bg-cream rounded-3xl py-14 px-6 sm:px-10 text-center">
            <svg viewBox="0 0 64 64" width="72" height="72" class="mx-auto mb-4" fill="none" stroke="#FF8FB1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="28" cy="28" r="18"/><path d="m41 41 12 12"/></svg>
            <h3 class="font-heading text-2xl sm:text-3xl text-charcoal">“@q” bulunamadı</h3>
            <p class="text-muted mt-2 max-w-md mx-auto">Farklı bir kelimeyle aramayı ya da kategorilere göz atmayı deneyin.</p>
            <a href="/kategoriler" class="mt-6 inline-flex px-6 py-3 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition">Kategorilere göz at</a>
        </div>
    }
    else
    {
        <div class="bg-cream rounded-3xl py-14 px-6 sm:px-10 text-center">
            <svg viewBox="0 0 64 64" width="72" height="72" class="mx-auto mb-4" fill="none" stroke="#FF8FB1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="28" cy="28" r="18"/><path d="m41 41 12 12"/></svg>
            <h3 class="font-heading text-2xl text-charcoal">Aramaya başlayın</h3>
            <p class="text-muted mt-2">Yukarıdaki kutuya ürün, kategori veya marka adı yazın.</p>
        </div>
    }

</main>
