@using Entegrasyon.Entity.Dtos.Storefront
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@{
    var searchQuery = ViewBag.SearchQuery as string;
    var products = ViewBag.Products as Entegrasyon.Entity.Pageable<StorefrontProductCardDto>;
    var hasQuery = !string.IsNullOrWhiteSpace(searchQuery);
}

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" description="@ViewBag.SeoDescription" />
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    @await Html.PartialAsync("_Breadcrumb")

    @if (!hasQuery)
    {
        @* No query — search prompt *@
        <div class="text-center py-16">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <h1 class="text-2xl font-bold text-gray-900 mb-4">Urun Ara</h1>
            <p class="text-gray-500 mb-8">Aradiginiz urunu bulmak icin yukardaki arama kutusunu kullanin.</p>

            <div class="max-w-md mx-auto">
                <form action="/arama" method="get" class="flex gap-2">
                    <input type="text" name="q" placeholder="Urun adi, marka veya kategori..."
                           class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                    <button type="submit" class="btn-primary">Ara</button>
                </form>
            </div>

            <div class="mt-12">
                <h2 class="text-lg font-semibold text-gray-700 mb-4">Populer Kategoriler</h2>
                <div class="flex flex-wrap justify-center gap-3">
                    <a href="/kategoriler" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-gray-200 transition-colors">
                        Tum Kategoriler
                    </a>
                    <a href="/yeni-urunler" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-gray-200 transition-colors">
                        Yeni Urunler
                    </a>
                    <a href="/cok-satanlar" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-gray-200 transition-colors">
                        Cok Satanlar
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Search results *@
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">
            "@searchQuery" icin arama sonuclari
        </h1>
        <p class="text-sm text-gray-500 mb-6">
            @(products?.TotalItemCount ?? 0) sonuc bulundu
        </p>

        <div class="flex flex-col lg:flex-row gap-6">
            @* Filter Sidebar *@
            <aside class="w-full lg:w-1/4 flex-shrink-0">
                @await Html.PartialAsync("_FilterSidebar")
            </aside>

            @* Product Grid *@
            <div class="w-full lg:w-3/4">
                @if (products != null && products.HasItem)
                {
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4">
                        @foreach (var product in products.Items)
                        {
                            @await Html.PartialAsync("_ProductCard", product)
                        }
                    </div>

                    @await Html.PartialAsync("_Pagination")
                }
                else
                {
                    <div class="text-center py-16">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="text-gray-500 text-lg mb-4">
                            "@searchQuery" icin sonuc bulunamadi.
                        </p>
                        <p class="text-gray-400 text-sm mb-6">
                            Farkli kelimeler deneyebilir veya filtreleri temizleyebilirsiniz.
                        </p>
                        <a href="/arama" class="text-primary hover:underline font-medium">
                            Yeni arama yap
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>
