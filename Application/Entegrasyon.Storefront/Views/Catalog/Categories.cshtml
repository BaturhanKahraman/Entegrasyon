@model List<Entegrasyon.Entity.Dtos.Storefront.CategoryTreeDto>
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" description="@ViewBag.SeoDescription" />
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    @await Html.PartialAsync("_Breadcrumb")

    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Kategoriler</h1>

    @if (Model.Count == 0)
    {
        <div class="text-center py-16">
            <p class="text-gray-500 text-lg">Henuz kategori bulunmamaktadir.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var category in Model)
            {
                <div class="bg-white border border-gray-200 rounded-lg p-5 hover:shadow-md transition-shadow">
                    <a href="/kategori/@category.SeoSlug" class="block">
                        <h2 class="text-lg font-semibold text-gray-900 mb-1 hover:text-primary transition-colors">
                            @category.Name
                        </h2>
                        <p class="text-sm text-gray-500 mb-3">@category.ProductCount urun</p>
                    </a>

                    @if (category.Children.Count > 0)
                    {
                        <div class="border-t border-gray-100 pt-3">
                            <ul class="space-y-1">
                                @foreach (var child in category.Children.Take(6))
                                {
                                    <li>
                                        <a href="/kategori/@category.SeoSlug/@child.SeoSlug"
                                           class="text-sm text-gray-600 hover:text-primary transition-colors">
                                            @child.Name
                                            <span class="text-gray-400 text-xs">(@child.ProductCount)</span>
                                        </a>
                                    </li>
                                }
                                @if (category.Children.Count > 6)
                                {
                                    <li>
                                        <a href="/kategori/@category.SeoSlug"
                                           class="text-sm text-primary font-medium hover:underline">
                                            +@(category.Children.Count - 6) daha...
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
