@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var cart = ViewBag.Cart as Entegrasyon.Entity.Dtos.Storefront.CartDto;
    var freeShippingThreshold = (decimal)ViewBag.FreeShippingThreshold;
}

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" />
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Sepetim</h1>

    @if (cart == null || cart.ItemCount == 0)
    {
        <div class="text-center py-16">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
            </svg>
            <p class="text-gray-500 text-lg mb-6">Sepetiniz bos</p>
            <a href="/urunler" class="btn-primary inline-block px-8 py-3 no-underline">Alisverise Basla</a>
        </div>
    }
    else
    {
        <div class="flex flex-col lg:flex-row gap-8">
            @* Cart Items *@
            <div class="flex-1">
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                    @* Header *@
                    <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 bg-gray-50 text-sm font-medium text-gray-500 border-b">
                        <div class="col-span-6">Urun</div>
                        <div class="col-span-2 text-center">Birim Fiyat</div>
                        <div class="col-span-2 text-center">Adet</div>
                        <div class="col-span-2 text-right">Toplam</div>
                    </div>

                    @* Items *@
                    <div id="cart-items">
                        @foreach (var item in cart.Items)
                        {
                            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-6 py-4 border-b border-gray-100 items-center cart-item" data-variant-id="@item.ProductVariantId">
                                @* Product Info *@
                                <div class="col-span-6 flex items-center gap-4">
                                    <div class="w-16 h-16 bg-gray-100 rounded-md overflow-hidden flex-shrink-0">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductTitle" class="w-full h-full object-cover" />
                                        }
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900 text-sm">@item.ProductTitle</p>
                                        @if (!string.IsNullOrWhiteSpace(item.VariantInfo))
                                        {
                                            <p class="text-xs text-gray-500 mt-1">@item.VariantInfo</p>
                                        }
                                    </div>
                                </div>

                                @* Unit Price *@
                                <div class="col-span-2 text-center text-sm text-gray-600">
                                    <span class="md:hidden text-gray-400">Birim: </span>
                                    <span class="item-unit-price">@item.UnitPrice.ToString("N2")</span> TL
                                </div>

                                @* Quantity *@
                                <div class="col-span-2 flex items-center justify-center">
                                    <div class="flex items-center border border-gray-300 rounded-lg">
                                        <button onclick="updateQuantity('@item.ProductVariantId', @(item.Quantity - 1))"
                                                class="px-2 py-1 text-gray-600 hover:text-gray-900 text-sm" @(item.Quantity <= 1 ? "disabled" : "")>-</button>
                                        <span class="w-10 text-center text-sm item-quantity">@item.Quantity</span>
                                        <button onclick="updateQuantity('@item.ProductVariantId', @(item.Quantity + 1))"
                                                class="px-2 py-1 text-gray-600 hover:text-gray-900 text-sm" @(item.Quantity >= item.AvailableStock ? "disabled" : "")>+</button>
                                    </div>
                                </div>

                                @* Line Total + Actions *@
                                <div class="col-span-2 flex items-center justify-end gap-2">
                                    <span class="font-semibold text-gray-900 text-sm item-line-total">@item.LineTotal.ToString("N2") TL</span>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <button onclick="saveForLater('@item.ProductVariantId')" class="text-gray-400 hover:text-blue-500 transition-colors" title="Sonra Al">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                                            </svg>
                                        </button>
                                    }
                                    <button onclick="removeItem('@item.ProductVariantId')" class="text-gray-400 hover:text-red-500 transition-colors" title="Kaldir">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* Saved Items Section *@
                @{
                    var savedItems = ViewBag.SavedItems as List<Entegrasyon.Entity.Dtos.Storefront.SavedCartItemDto> ?? new();
                }
                @if (savedItems.Count > 0)
                {
                    <div class="mt-4 bg-white rounded-lg border border-gray-200 p-4">
                        <h3 class="text-sm font-semibold text-gray-700 mb-3">Sonra Almak Istedikleriniz</h3>
                        <div class="space-y-3">
                            @foreach (var saved in savedItems)
                            {
                                <div class="flex items-center gap-4 py-2 border-b border-gray-100 last:border-0">
                                    <div class="w-12 h-12 bg-gray-100 rounded overflow-hidden flex-shrink-0">
                                        @if (!string.IsNullOrWhiteSpace(saved.ImageUrl))
                                        {
                                            <img src="@saved.ImageUrl" alt="@saved.ProductTitle" class="w-full h-full object-cover" />
                                        }
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-gray-900 truncate">@saved.ProductTitle</p>
                                        <div class="flex items-center gap-2 text-sm">
                                            @if (saved.CurrentPrice != saved.OriginalPrice)
                                            {
                                                <span class="text-gray-400 line-through">@saved.OriginalPrice.ToString("N2") TL</span>
                                            }
                                            <span class="font-semibold text-gray-900">@saved.CurrentPrice.ToString("N2") TL</span>
                                        </div>
                                    </div>
                                    <button onclick="moveToCart('@saved.ProductVariantId')"
                                            class="px-3 py-1.5 text-xs font-medium text-white bg-primary rounded-lg hover:opacity-90 transition-opacity whitespace-nowrap">
                                        Sepete Tasi
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* Coupon Code Section *@
                <div class="mt-4 bg-white rounded-lg border border-gray-200 p-4">
                    <div id="coupon-section">
                        @if (!string.IsNullOrWhiteSpace(cart.CouponCode))
                        {
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="text-sm font-medium text-green-700">Kupon uygulandi: <strong>@cart.CouponCode</strong></span>
                                </div>
                                <button onclick="removeCoupon()" class="text-sm text-red-500 hover:text-red-700 font-medium">Kaldır</button>
                            </div>
                        }
                        else
                        {
                            <div class="flex gap-2">
                                <input type="text" id="coupon-input" placeholder="Kupon kodunuz" maxlength="20"
                                       class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                                <button onclick="applyCoupon()" id="coupon-btn"
                                        class="px-4 py-2 bg-gray-800 text-white text-sm font-medium rounded-lg hover:bg-gray-700 transition-colors">
                                    Uygula
                                </button>
                            </div>
                            <p id="coupon-error" class="text-xs text-red-500 mt-1 hidden"></p>
                        }
                    </div>
                </div>
            </div>

            @* Order Summary Sidebar *@
            <div class="w-full lg:w-80">
                <div class="bg-white rounded-lg border border-gray-200 p-6 sticky top-24">
                    <h2 class="text-lg font-bold text-gray-900 mb-4">Siparis Ozeti</h2>

                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between text-gray-600">
                            <span>Ara Toplam</span>
                            <span id="summary-subtotal">@cart.SubTotal.ToString("N2") TL</span>
                        </div>
                        @if (cart.DiscountAmount > 0)
                        {
                            <div class="flex justify-between text-green-600">
                                <span>Kupon Indirimi</span>
                                <span id="summary-discount">-@cart.DiscountAmount.ToString("N2") TL</span>
                            </div>
                        }
                        <div class="flex justify-between text-gray-600">
                            <span>Kargo</span>
                            <span id="summary-shipping">
                                @if (cart.ShippingCost == 0)
                                {
                                    <span class="text-green-600 font-medium">Ucretsiz</span>
                                }
                                else
                                {
                                    @cart.ShippingCost.ToString("N2") <text>TL</text>
                                }
                            </span>
                        </div>
                        <hr />
                        <div class="flex justify-between font-bold text-gray-900 text-base">
                            <span>Genel Toplam</span>
                            <span id="summary-total">@cart.GrandTotal.ToString("N2") TL</span>
                        </div>
                    </div>

                    @if (freeShippingThreshold > 0 && cart.SubTotal < freeShippingThreshold)
                    {
                        <div id="free-shipping-info" class="mt-4 p-3 bg-blue-50 rounded-lg text-sm text-blue-700">
                            @((freeShippingThreshold - cart.SubTotal).ToString("N2")) TL daha ekleyin, <strong>ucretsiz kargo</strong> firsatindan yararlanin!
                        </div>
                    }

                    <div class="mt-6">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="/odeme" class="btn-primary block text-center py-3 no-underline">Odemeye Gec</a>
                        }
                        else
                        {
                            <a href="/giris?returnUrl=/sepet" class="btn-primary block text-center py-3 no-underline">Odemeye Gec</a>
                            <p class="text-xs text-gray-500 text-center mt-2">Odeme icin giris yapmaniz gerekiyor</p>
                        }
                    </div>

                    <a href="/urunler" class="block text-center text-sm text-primary hover:underline mt-4 no-underline">Alisverise Devam Et</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function updateQuantity(variantId, quantity) {
        if (quantity < 1) return;
        fetch('/api/sepet/Guncelle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productVariantId: variantId, quantity: quantity })
        }).then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) { location.reload(); }
            else { alert(d.message || 'Bir hata olustu'); }
        }).catch(function() { alert('Bir hata olustu'); });
    }

    function removeItem(variantId) {
        fetch('/api/sepet/Sil', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productVariantId: variantId, quantity: 0 })
        }).then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) { location.reload(); }
        }).catch(function() { alert('Bir hata olustu'); });
    }

    function applyCoupon() {
        var input = document.getElementById('coupon-input');
        var errorEl = document.getElementById('coupon-error');
        var btn = document.getElementById('coupon-btn');
        var code = input.value.trim();

        if (!code) {
            errorEl.textContent = 'Lutfen bir kupon kodu girin.';
            errorEl.classList.remove('hidden');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Kontrol ediliyor...';
        errorEl.classList.add('hidden');

        fetch('/api/sepet/KuponUygula', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code })
        }).then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) {
                location.reload();
            } else {
                errorEl.textContent = d.message || 'Gecersiz kupon kodu.';
                errorEl.classList.remove('hidden');
                btn.disabled = false;
                btn.textContent = 'Uygula';
            }
        }).catch(function() {
            errorEl.textContent = 'Bir hata olustu. Lutfen tekrar deneyin.';
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Uygula';
        });
    }

    function removeCoupon() {
        fetch('/api/sepet/KuponKaldir', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        }).then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) { location.reload(); }
        }).catch(function() { alert('Bir hata olustu'); });
    }

    function saveForLater(variantId) {
        fetch('/api/sepet/SonraAl', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productVariantId: variantId, quantity: 0 })
        }).then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) { location.reload(); }
            else { alert(d.message || 'Bir hata olustu'); }
        }).catch(function() { alert('Bir hata olustu'); });
    }

    function moveToCart(variantId) {
        fetch('/api/sepet/SepeteTasi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productVariantId: variantId, quantity: 0 })
        }).then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) { location.reload(); }
            else { alert(d.message || 'Bir hata olustu'); }
        }).catch(function() { alert('Bir hata olustu'); });
    }

    // Allow pressing Enter in coupon input
    var couponInput = document.getElementById('coupon-input');
    if (couponInput) {
        couponInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') { applyCoupon(); }
        });
    }
</script>
}
