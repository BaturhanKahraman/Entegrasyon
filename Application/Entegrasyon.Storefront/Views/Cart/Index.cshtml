@{
    ViewData["Title"] = "Sepetim";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">

    @* ============ BREADCRUMB ============ *@
    <nav aria-label="breadcrumb" class="text-sm text-muted mb-5 flex items-center gap-2">
        <a href="/" class="hover:text-primary transition">Anasayfa</a>
        <span class="text-cream-300">›</span>
        <span class="text-charcoal font-medium">Sepetim</span>
    </nav>

    <h1 class="font-heading text-3xl lg:text-4xl text-charcoal mb-7">Sepetim <span class="text-muted text-2xl">(<span id="cartCount">3</span> ürün)</span></h1>

    @* ============ CART AREA ============ *@
    <div id="cartArea" class="grid lg:grid-cols-3 gap-8">

        @* Sol *@
        <div class="lg:col-span-2">

            @* Free shipping progress *@
            <div id="freeShip" class="rounded-2xl p-4 mb-6"></div>

            @* Items *@
            <div class="bg-white border border-cream-300 rounded-2xl overflow-hidden">
                <div id="cartItems"></div>
                <div class="flex items-center justify-between px-6 py-4 bg-cream/50 text-sm">
                    <button type="button" data-clear-cart class="text-muted hover:text-danger transition flex items-center gap-1.5">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        Tümünü kaldır
                    </button>
                    <a href="/kategori/yeni-gelenler" class="text-primary font-medium hover:underline flex items-center gap-1.5">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7M5 12h14"/></svg>
                        Alışverişe devam et
                    </a>
                </div>
            </div>
        </div>

        @* Sağ özet *@
        <div class="lg:col-span-1">
            <div class="bg-cream rounded-2xl p-6 lg:sticky lg:top-24">
                <h2 class="font-heading text-xl text-charcoal mb-5">Sipariş Özeti</h2>

                <div class="space-y-3 text-sm">
                    <div class="flex justify-between"><span class="text-muted">Ara toplam</span><span id="subTotal" class="text-charcoal font-medium">996₺</span></div>
                    <div class="flex justify-between"><span class="text-muted">Kargo</span><span id="shipVal" class="text-success font-medium">Bedava</span></div>
                    <div class="flex justify-between"><span class="text-muted">Sadakat indirimi</span><span class="text-success font-medium">−50₺</span></div>
                    <div id="couponRow" class="hidden flex justify-between"><span class="text-muted">Kupon (<span id="couponName"></span>)</span><span id="couponAmt" class="text-success font-medium">−50₺</span></div>
                    <div id="giftRow" class="hidden flex justify-between"><span class="text-muted">Hediye kartı</span><span id="giftAmt" class="text-success font-medium">−100₺</span></div>
                </div>

                <div class="border-t border-cream-300 my-4"></div>

                <div class="flex items-baseline justify-between mb-5">
                    <span class="font-bold text-lg text-charcoal">Toplam</span>
                    <span id="totalVal" class="text-2xl font-semibold text-primary">946₺</span>
                </div>

                @* Kupon *@
                <details class="mb-2 border border-cream-300 rounded-xl bg-white px-4 py-3">
                    <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-charcoal">Kupon kodunuz var mı?
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-muted" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="mt-3">
                        <div class="flex gap-2">
                            <input id="couponInput" type="text" placeholder="Örn. BAHAR50" class="flex-1 px-3 py-2 rounded-lg border border-cream-300 text-sm outline-none focus:border-primary uppercase placeholder:normal-case" />
                            <button type="button" data-apply-coupon class="px-4 py-2 rounded-lg bg-charcoal text-white text-sm font-medium hover:bg-charcoal/90 transition">Uygula</button>
                        </div>
                        <div id="couponChip" class="hidden mt-2"></div>
                    </div>
                </details>

                @* Hediye kartı *@
                <details class="mb-5 border border-cream-300 rounded-xl bg-white px-4 py-3">
                    <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-charcoal">Hediye kartı kullan
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-muted" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="mt-3">
                        <div class="flex gap-2">
                            <input id="giftInput" type="text" placeholder="Hediye kartı kodu" class="flex-1 px-3 py-2 rounded-lg border border-cream-300 text-sm outline-none focus:border-primary uppercase placeholder:normal-case" />
                            <button type="button" data-apply-gift class="px-4 py-2 rounded-lg bg-charcoal text-white text-sm font-medium hover:bg-charcoal/90 transition">Uygula</button>
                        </div>
                        <div id="giftChip" class="hidden mt-2"></div>
                    </div>
                </details>

                <a href="/odeme" class="w-full py-4 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-[0_10px_24px_-6px_rgba(255,143,177,.6)] flex items-center justify-center gap-2">
                    Ödemeye Geç
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>

                <div class="flex items-center justify-center gap-2 mt-4">
                    <span class="inline-flex items-center gap-1 text-[11px] text-muted"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>SSL</span>
                    <span class="px-2 py-0.5 rounded bg-white border border-cream-300 text-[10px] font-semibold text-charcoal tracking-wide">VISA</span>
                    <span class="px-2 py-0.5 rounded bg-white border border-cream-300 text-[10px] font-semibold text-charcoal tracking-wide">Mastercard</span>
                    <span class="px-2 py-0.5 rounded bg-white border border-cream-300 text-[10px] font-semibold text-charcoal tracking-wide">TROY</span>
                </div>

                <p class="text-[11px] text-muted text-center mt-3 leading-relaxed">KDV dahildir. Aynı gün kargoda ise yarın elinizde.</p>
            </div>
        </div>
    </div>

    @* ============ BOŞ SEPET ============ *@
    <div id="emptyCart" class="hidden bg-cream rounded-3xl py-16 px-6 text-center max-w-xl mx-auto">
        <svg viewBox="0 0 64 64" width="84" height="84" class="mx-auto mb-5" fill="none" stroke="#FF8FB1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20h32l-3 30a4 4 0 0 1-4 3.5H23a4 4 0 0 1-4-3.5Z"/><path d="M24 20a8 8 0 0 1 16 0"/><circle cx="26" cy="38" r="1.5" fill="#FF8FB1"/><circle cx="38" cy="38" r="1.5" fill="#FF8FB1"/><path d="M27 45c1.5 1.5 3.2 2 5 2s3.5-.5 5-2"/></svg>
        <h2 class="font-heading text-2xl text-charcoal">Sepetiniz henüz boş</h2>
        <p class="text-muted mt-2">Birbirinden tatlı ürünler sizi bekliyor.</p>
        <a href="/kategori/yeni-gelenler" class="inline-block mt-6 px-7 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition">Alışverişe Başla</a>
        <div class="mt-3"><a href="/favorilerim" class="text-sm text-primary hover:underline">Favorilerimi gör</a></div>
    </div>

    @* ============ ÖNERİLER ============ *@
    <section class="mt-16 lg:mt-20">
        <div class="flex items-end justify-between mb-6">
            <h2 class="font-heading text-2xl lg:text-3xl text-charcoal">Birlikte iyi gider</h2>
            <div class="flex items-center gap-2">
                <button type="button" data-carousel-scroll="prev" data-carousel-target="recScroll" aria-label="Önceki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                <button type="button" data-carousel-scroll="next" data-carousel-target="recScroll" aria-label="Sonraki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
            </div>
        </div>
        <div id="recScroll" class="grid grid-flow-col auto-cols-[68%] sm:auto-cols-[40%] md:auto-cols-[30%] lg:auto-cols-[23.5%] gap-4 sm:gap-6 overflow-x-auto no-scrollbar snap-x scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0"></div>
    </section>
</div>

@* ============ UNDO BAR ============ *@
<div id="undoBar" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-[60] bg-charcoal text-white text-sm px-5 py-3 rounded-full shadow-md flex items-center gap-4">
    <span id="undoMsg">Üründen kaldırıldı</span>
    <button type="button" data-undo-remove class="font-semibold text-accent hover:underline">Geri Al</button>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
