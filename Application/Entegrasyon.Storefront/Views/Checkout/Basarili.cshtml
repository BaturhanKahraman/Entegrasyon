@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var orderId = (Guid)ViewBag.OrderId;
    var estimatedDays = (int)ViewBag.EstimatedDeliveryDays;
}

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" />
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <div class="bg-white rounded-lg border border-gray-200 p-10">
        <div class="mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-gray-900 mb-2">Siparişiz basariyla alindi!</h1>
        <p class="text-gray-500 mb-6">Siparişizi en kisa surede hazirlayip kargoya teslim edecegiz.</p>

        <div class="bg-gray-50 rounded-lg p-4 mb-6 text-sm text-gray-600 space-y-2">
            <p>Sipariş No: <span class="font-semibold text-gray-900">@orderId.ToString("N")[..12].ToUpper()</span></p>
            <p>Tahmini teslimat: <span class="font-semibold text-gray-900">@estimatedDays is gunu icinde</span></p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/" class="btn-primary px-8 py-3 no-underline">Alisverise Devam Et</a>
            <a href="/hesabim/Orders" class="px-8 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors no-underline">Siparişlerim</a>
        </div>
    </div>
</div>
