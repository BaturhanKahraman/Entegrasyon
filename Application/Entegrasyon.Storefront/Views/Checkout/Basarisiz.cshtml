@{
    ViewData["Title"] = "Ödeme Tamamlanamadı";
    var errorMessage = ViewBag.ErrorMessage as string ?? "Bankanız 3D Secure doğrulamasını reddetti.";
    var errorCode = ViewBag.ErrorCode as string ?? "PAYMENT_3D_FAILED";
    var settings = (Context.RequestServices.GetService(typeof(Entegrasyon.Business.Abstract.IStorefrontTenantContext)) as Entegrasyon.Business.Abstract.IStorefrontTenantContext)?.Settings;
    var contactPhone = settings?.ContactPhone ?? "0850 000 00 00";
    var whatsAppNumber = settings?.WhatsAppNumber;
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">

    <div class="text-center">
        <div class="w-20 h-20 rounded-full bg-warning/15 text-warning flex items-center justify-center mx-auto mb-6">
            <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
        </div>
        <h1 class="font-heading text-3xl sm:text-4xl text-charcoal">Ödemenizi tamamlayamadık</h1>
        <p class="text-muted mt-3 max-w-lg mx-auto leading-relaxed">
            Ödemeniz şu sebeple alınamadı: <span class="font-medium text-charcoal">@errorMessage</span> Endişelenmeyin, hesabınızdan herhangi bir kesinti olmadı.
        </p>
    </div>

    @* what to do *@
    <div class="bg-cream rounded-2xl p-6 sm:p-7 mt-8">
        <h2 class="font-semibold text-charcoal mb-4">Ne yapabiliriz?</h2>
        <ul class="space-y-3.5">
            <li class="flex items-center gap-3.5">
                <span class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
                <span class="text-sm text-charcoal">Kart bilgilerinizi (numara, son kullanma, CVV) kontrol edin.</span>
            </li>
            <li class="flex items-center gap-3.5">
                <span class="w-9 h-9 rounded-xl bg-secondary/15 text-secondary flex items-center justify-center shrink-0"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 3 4 4-4 4"/><path d="M20 7H8a4 4 0 0 0-4 4v1"/><path d="m8 21-4-4 4-4"/><path d="M4 17h12a4 4 0 0 0 4-4v-1"/></svg></span>
                <span class="text-sm text-charcoal">Farklı bir kart veya banka deneyin.</span>
            </li>
            <li class="flex items-center gap-3.5">
                <span class="w-9 h-9 rounded-xl bg-accent/25 text-warning flex items-center justify-center shrink-0"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z"/></svg></span>
                <span class="text-sm text-charcoal">Bankanızı arayarak limit / online işlem onayını kontrol edin.</span>
            </li>
            <li class="flex items-center gap-3.5">
                <span class="w-9 h-9 rounded-xl bg-success/15 text-success flex items-center justify-center shrink-0"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4"/></svg></span>
                <span class="text-sm text-charcoal">Havale, EFT veya kapıda ödeme seçeneğini kullanın.</span>
            </li>
        </ul>
    </div>

    @* CTAs *@
    <div class="mt-8 flex flex-col sm:flex-row sm:justify-center gap-3 sm:gap-4">
        <a href="/odeme" class="text-center px-7 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">Tekrar Dene</a>
        <a href="/sepetim" class="text-center px-7 py-3.5 rounded-full border border-cream-300 text-charcoal font-semibold hover:border-primary hover:text-primary transition">Sepete Dön</a>
    </div>

    <p class="text-center text-sm text-muted mt-6">
        Yardım gerekirse: <span class="text-charcoal font-medium">@contactPhone</span>
        @if (!string.IsNullOrWhiteSpace(whatsAppNumber))
        {
            <text> · <a href="https://wa.me/@whatsAppNumber" class="text-success font-medium hover:underline">WhatsApp</a></text>
        }
        · <a href="/iletisim" class="text-primary hover:underline">İletişim formu</a>
    </p>

    <p class="text-center text-[11px] text-muted/70 mt-4">Hata kodu: @errorCode</p>
</div>
