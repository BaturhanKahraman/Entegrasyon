@model Entegrasyon.Entity.Dtos.Storefront.StorefrontProductDetailDto
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@{
    var relatedProducts = ViewBag.RelatedProducts as List<Entegrasyon.Entity.Dtos.Storefront.StorefrontProductCardDto>
        ?? new List<Entegrasyon.Entity.Dtos.Storefront.StorefrontProductCardDto>();
    var reviews = ViewBag.Reviews as List<Entegrasyon.Entity.Storefront.StorefrontReview>
        ?? new List<Entegrasyon.Entity.Storefront.StorefrontReview>();
    var averageRating = (double)(ViewBag.AverageRating ?? 0.0);
    var reviewCount = (int)(ViewBag.ReviewCount ?? 0);
    var firstVariant = Model.Variants.FirstOrDefault();
    var allImages = Model.Variants.SelectMany(v => v.ImageUrls).Distinct().ToList();
    var mainImage = allImages.FirstOrDefault();
    var hasDiscount = firstVariant != null && firstVariant.ListPrice > firstVariant.SalePrice;
    var totalStock = Model.Variants.Sum(v => v.Stock);
}

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" description="@ViewBag.SeoDescription"
              image="@mainImage" og-type="product" />
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    @await Html.PartialAsync("_Breadcrumb")

    @* Product Main Section *@
    <div class="flex flex-col md:flex-row gap-8 mb-12">
        @* Image Gallery *@
        <div class="w-full md:w-1/2">
            <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden mb-3">
                @if (!string.IsNullOrWhiteSpace(mainImage))
                {
                    <img id="main-product-image" src="@mainImage" alt="@Model.Title"
                         class="w-full h-full object-contain" />
                }
                else
                {
                    <div class="w-full h-full flex items-center justify-center text-gray-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                }
            </div>

            @if (allImages.Count > 1)
            {
                <div class="flex gap-2 overflow-x-auto pb-2">
                    @foreach (var img in allImages)
                    {
                        <button onclick="document.getElementById('main-product-image').src='@img'"
                                class="flex-shrink-0 w-16 h-16 border border-gray-200 rounded-md overflow-hidden hover:border-primary transition-colors">
                            <img src="@img" alt="@Model.Title" loading="lazy"
                                 class="w-full h-full object-cover" />
                        </button>
                    }
                </div>
            }
        </div>

        @* Product Info *@
        <div class="w-full md:w-1/2">
            @if (!string.IsNullOrWhiteSpace(Model.BrandName))
            {
                <a href="/marka/@Model.BrandSlug" class="text-sm text-primary hover:underline font-medium">
                    @Model.BrandName
                </a>
            }

            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-1 mb-2">@Model.Title</h1>

            @if (reviewCount > 0)
            {
                <div class="flex items-center gap-2 mb-4">
                    <div class="flex items-center text-yellow-400">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= (int)Math.Round(averageRating))
                            {
                                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            }
                            else
                            {
                                <svg class="h-4 w-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            }
                        }
                    </div>
                    <span class="text-sm text-gray-500">@averageRating.ToString("0.0") (@reviewCount degerlendirme)</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.StockCode))
            {
                <p class="text-xs text-gray-400 mb-4">Stok Kodu: @Model.StockCode</p>
            }

            @* Price *@
            <div class="mb-6">
                @if (hasDiscount)
                {
                    <div class="flex items-center gap-3">
                        <span class="text-lg text-gray-400 line-through">@firstVariant!.ListPrice.ToString("N2") TL</span>
                        <span class="text-2xl font-bold text-primary">@firstVariant.SalePrice.ToString("N2") TL</span>
                        @{
                            var discountPct = (int)Math.Round((1 - firstVariant.SalePrice / firstVariant.ListPrice) * 100);
                        }
                        <span class="bg-red-100 text-red-600 text-sm font-semibold px-2 py-0.5 rounded">%@discountPct</span>
                    </div>
                }
                else if (Model.MinPrice != Model.MaxPrice)
                {
                    <span class="text-2xl font-bold text-gray-900">@Model.MinPrice.ToString("N2") - @Model.MaxPrice.ToString("N2") TL</span>
                }
                else
                {
                    <span class="text-2xl font-bold text-gray-900">@Model.MinPrice.ToString("N2") TL</span>
                }
            </div>

            @* Stock Status *@
            <div class="mb-6">
                @if (totalStock > 5)
                {
                    <span class="inline-flex items-center gap-1 text-sm text-green-600">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        Stokta var
                    </span>
                }
                else if (totalStock > 0)
                {
                    <span class="inline-flex items-center gap-1 text-sm text-orange-600">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        Son @totalStock adet kaldi!
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1 text-sm text-red-500">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                        Stokta yok
                    </span>
                }
            </div>

            @* Variant Attributes *@
            @if (Model.Variants.Count > 1)
            {
                var variantAttributeKeys = Model.Variants
                    .SelectMany(v => v.Attributes)
                    .Select(a => a.AttributeKey)
                    .Distinct()
                    .ToList();

                @foreach (var key in variantAttributeKeys)
                {
                    var values = Model.Variants
                        .SelectMany(v => v.Attributes)
                        .Where(a => a.AttributeKey == key)
                        .Select(a => a.AttributeValue)
                        .Distinct()
                        .ToList();

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">@key</label>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var val in values)
                            {
                                <span class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm text-gray-700 cursor-pointer hover:border-primary transition-colors">
                                    @val
                                </span>
                            }
                        </div>
                    </div>
                }
            }

            @* Quantity + Add to Cart *@
            @if (totalStock > 0)
            {
                <div class="flex items-center gap-4 mt-6">
                    <div class="flex items-center border border-gray-300 rounded-lg">
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900"
                                onclick="var i=document.getElementById('quantity-input');if(parseInt(i.value)>1)i.value=parseInt(i.value)-1;">-</button>
                        <input type="number" id="quantity-input" value="1" min="1" max="@totalStock"
                               class="w-14 text-center border-x border-gray-300 py-2 text-sm" />
                        <button type="button" class="px-3 py-2 text-gray-600 hover:text-gray-900"
                                onclick="var i=document.getElementById('quantity-input');if(parseInt(i.value)<parseInt(i.max))i.value=parseInt(i.value)+1;">+</button>
                    </div>
                    <button id="add-to-cart-btn"
                            data-variant-id="@(firstVariant?.Id)"
                            class="btn-primary flex-1 py-3">
                        Sepete Ekle
                    </button>
                    <button id="wishlist-btn" data-product-id="@Model.Id"
                            class="p-3 border border-gray-300 rounded-lg hover:bg-red-50 hover:border-red-300 transition-colors"
                            title="Favorilere ekle">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400" id="wishlist-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                    </button>
                </div>
            }
            else
            {
                @* Stock Notification Form *@
                <div class="mt-6 p-4 bg-gray-50 border border-gray-200 rounded-lg">
                    <p class="text-sm text-gray-700 mb-3">Bu urun su anda stokta yok. Stoga gelince haber almak ister misiniz?</p>
                    <div class="flex items-center gap-2" id="stock-notify-form">
                        <input type="email" id="stock-notify-email" placeholder="E-posta adresiniz"
                               class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                        <button id="stock-notify-btn" data-variant-id="@(firstVariant?.Id)"
                                class="btn-primary px-4 py-2 text-sm whitespace-nowrap">
                            Haber Ver
                        </button>
                    </div>
                    <p id="stock-notify-msg" class="text-xs mt-2 hidden"></p>
                </div>
                <div class="flex items-center gap-4 mt-4">
                    <button id="wishlist-btn" data-product-id="@Model.Id"
                            class="p-3 border border-gray-300 rounded-lg hover:bg-red-50 hover:border-red-300 transition-colors"
                            title="Favorilere ekle">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400" id="wishlist-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                    </button>
                </div>
            }

            @* Size Guide Link *@
            @if (ViewBag.SizeGuide is Entegrasyon.Entity.Storefront.StorefrontSizeGuide sizeGuide)
            {
                <div class="mt-4">
                    <button type="button" onclick="document.getElementById('size-guide-modal').classList.remove('hidden')"
                            class="inline-flex items-center gap-1 text-sm text-primary hover:underline">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        Beden Rehberi
                    </button>
                </div>
            }

            @* Shipping Info *@
            <div class="mt-6 pt-6 border-t border-gray-200 space-y-2 text-sm text-gray-600">
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    <span>Tahmini teslimat: @Tenant.Settings.EstimatedDeliveryDays is gunu</span>
                </div>
                @if (Tenant.Settings.FreeShippingThreshold > 0)
                {
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8" />
                        </svg>
                        <span>@Tenant.Settings.FreeShippingThreshold.ToString("N2") TL ustu ucretsiz kargo</span>
                    </div>
                }
                else if (Tenant.Settings.FlatShippingRate > 0)
                {
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8" />
                        </svg>
                        <span>Kargo ucreti: @Tenant.Settings.FlatShippingRate.ToString("N2") TL</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Tabs Section *@
    <div class="mb-12">
        <div class="border-b border-gray-200">
            <nav class="flex gap-6 -mb-px" id="product-tabs">
                <button onclick="showTab('tab-description')" class="tab-btn active-tab py-3 text-sm font-medium border-b-2 border-primary text-primary" data-tab="tab-description">
                    Aciklama
                </button>
                @if (Model.Attributes.Count > 0)
                {
                    <button onclick="showTab('tab-attributes')" class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="tab-attributes">
                        Ozellikler
                    </button>
                }
                <button onclick="showTab('tab-delivery')" class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="tab-delivery">
                    Teslimat Bilgisi
                </button>
                <button onclick="showTab('tab-return')" class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="tab-return">
                    Iade Bilgisi
                </button>
                <button onclick="showTab('tab-reviews')" class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="tab-reviews">
                    Degerlendirmeler (@reviewCount)
                </button>
            </nav>
        </div>

        <div class="py-6">
            @* Description *@
            <div id="tab-description" class="tab-content">
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="prose max-w-none text-gray-700">
                        @Html.Raw(Model.Description)
                    </div>
                }
                else
                {
                    <p class="text-gray-500">Bu urun icin aciklama bulunmamaktadir.</p>
                }
            </div>

            @* Attributes *@
            <div id="tab-attributes" class="tab-content hidden">
                @if (Model.Attributes.Count > 0)
                {
                    <table class="w-full text-sm">
                        <tbody>
                            @foreach (var attr in Model.Attributes)
                            {
                                <tr class="border-b border-gray-100">
                                    <td class="py-3 pr-4 font-medium text-gray-600 w-1/3">@attr.HumanizedKey</td>
                                    <td class="py-3 text-gray-900">@attr.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @* Delivery Info *@
            <div id="tab-delivery" class="tab-content hidden">
                @if (!string.IsNullOrWhiteSpace(Tenant.Settings.DeliveryTermsHtml))
                {
                    <div class="prose max-w-none text-gray-700">
                        @Html.Raw(Tenant.Settings.DeliveryTermsHtml)
                    </div>
                }
                else
                {
                    <div class="text-gray-700 space-y-2">
                        <p>Siparisleriniz en gec @Tenant.Settings.EstimatedDeliveryDays is gununde kargoya teslim edilir.</p>
                        @if (Tenant.Settings.FreeShippingThreshold > 0)
                        {
                            <p>@Tenant.Settings.FreeShippingThreshold.ToString("N2") TL ve uzerindeki siparislerde kargo ucretsuizdir.</p>
                        }
                        @if (Tenant.Settings.FlatShippingRate > 0)
                        {
                            <p>Standart kargo ucreti @Tenant.Settings.FlatShippingRate.ToString("N2") TL'dir.</p>
                        }
                    </div>
                }
            </div>

            @* Return Info *@
            <div id="tab-return" class="tab-content hidden">
                @if (!string.IsNullOrWhiteSpace(Tenant.Settings.ReturnPolicyHtml))
                {
                    <div class="prose max-w-none text-gray-700">
                        @Html.Raw(Tenant.Settings.ReturnPolicyHtml)
                    </div>
                }
                else
                {
                    <p class="text-gray-500">Iade politikasi hakkinda detayli bilgi icin <a href="/iade-politikasi" class="text-primary hover:underline">tiklayiniz</a>.</p>
                }
            </div>

            @* Reviews *@
            <div id="tab-reviews" class="tab-content hidden">
                <div id="reviews">
                    @if (TempData["ReviewSuccess"] is string successMsg)
                    {
                        <div class="bg-green-50 border border-green-200 text-green-700 p-4 rounded-lg mb-6">@successMsg</div>
                    }
                    @if (TempData["ReviewError"] is string errorMsg)
                    {
                        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg mb-6">@errorMsg</div>
                    }

                    @* Rating Summary *@
                    @if (reviewCount > 0)
                    {
                        <div class="flex items-center gap-4 mb-8 p-4 bg-gray-50 rounded-lg">
                            <div class="text-center">
                                <div class="text-4xl font-bold text-gray-900">@averageRating.ToString("0.0")</div>
                                <div class="flex items-center text-yellow-400 mt-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= (int)Math.Round(averageRating))
                                        {
                                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                        }
                                        else
                                        {
                                            <svg class="h-4 w-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                        }
                                    }
                                </div>
                                <div class="text-sm text-gray-500 mt-1">@reviewCount degerlendirme</div>
                            </div>
                            <div class="flex-1">
                                @for (int star = 5; star >= 1; star--)
                                {
                                    var starCount = reviews.Count(r => r.Rating == star);
                                    var pct = reviewCount > 0 ? (int)Math.Round(starCount * 100.0 / reviewCount) : 0;
                                    <div class="flex items-center gap-2 text-sm">
                                        <span class="w-8 text-gray-500">@star</span>
                                        <div class="flex-1 bg-gray-200 rounded-full h-2">
                                            <div class="bg-yellow-400 rounded-full h-2" style="width: @(pct)%"></div>
                                        </div>
                                        <span class="w-8 text-gray-500 text-right">@starCount</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Review List *@
                    @if (reviews.Count > 0)
                    {
                        <div class="space-y-6 mb-8">
                            @foreach (var review in reviews)
                            {
                                <div class="border-b border-gray-100 pb-6">
                                    <div class="flex items-center gap-2 mb-2">
                                        <div class="flex items-center text-yellow-400">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                                }
                                                else
                                                {
                                                    <svg class="h-4 w-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                                }
                                            }
                                        </div>
                                        @if (review.IsVerifiedPurchase)
                                        {
                                            <span class="inline-flex items-center gap-1 text-xs text-green-600 bg-green-50 px-2 py-0.5 rounded">
                                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                                                Dogrulanmis alisveris
                                            </span>
                                        }
                                        <span class="text-xs text-gray-400">@review.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.Title))
                                    {
                                        <h4 class="font-medium text-gray-900 mb-1">@review.Title</h4>
                                    }
                                    <p class="text-sm text-gray-700">@review.Comment</p>
                                    @if (!string.IsNullOrWhiteSpace(review.ReplyText))
                                    {
                                        <div class="mt-3 ml-4 pl-4 border-l-2 border-primary bg-gray-50 p-3 rounded">
                                            <p class="text-xs font-medium text-primary mb-1">Magaza Yaniti</p>
                                            <p class="text-sm text-gray-700">@review.ReplyText</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500 mb-8">Bu urun icin henuz degerlendirme yapilmamistir.</p>
                    }

                    @* Add Review Form *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="bg-gray-50 rounded-lg p-6">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Yorum Yaz</h3>
                            <form method="post" action="/urun/@Model.SeoSlug/yorum">
                                @Html.AntiForgeryToken()
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Puaniniz *</label>
                                    <div class="flex gap-1" id="star-rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <button type="button" onclick="setRating(@i)" class="star-btn text-gray-300 hover:text-yellow-400 transition-colors">
                                                <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                            </button>
                                        }
                                    </div>
                                    <input type="hidden" name="rating" id="rating-input" value="0" />
                                </div>
                                <div class="mb-4">
                                    <label for="review-title" class="block text-sm font-medium text-gray-700 mb-1">Baslik</label>
                                    <input type="text" id="review-title" name="title" maxlength="200"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                                </div>
                                <div class="mb-4">
                                    <label for="review-comment" class="block text-sm font-medium text-gray-700 mb-1">Yorumunuz *</label>
                                    <textarea id="review-comment" name="comment" rows="4" required maxlength="2000"
                                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"></textarea>
                                </div>
                                <button type="submit" class="btn-primary px-6 py-2">Yorum Gonder</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <p class="text-gray-500">Yorum yapabilmek icin <a href="/giris" class="text-primary hover:underline">giris yapin</a>.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Related Products *@
    @if (relatedProducts.Count > 0)
    {
        <div class="mb-12">
            <h2 class="text-xl font-bold text-gray-900 mb-6">Ilgili Urunler</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                @foreach (var product in relatedProducts)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        </div>
    }

    @* Recently Viewed Products *@
    <section id="recently-viewed" style="display:none;" class="mb-12">
        <h3 class="text-lg font-bold mb-4">Son Goruntulenenler</h3>
        <div data-recently-grid class="flex gap-4 overflow-x-auto pb-2"></div>
    </section>
</div>

@section Scripts {
    <script>
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-primary', 'text-primary');
                btn.classList.add('border-transparent', 'text-gray-500');
            });
            document.getElementById(tabId).classList.remove('hidden');
            const activeBtn = document.querySelector(`[data-tab="${tabId}"]`);
            activeBtn.classList.remove('border-transparent', 'text-gray-500');
            activeBtn.classList.add('border-primary', 'text-primary');
        }

        // Star rating
        function setRating(val) {
            document.getElementById('rating-input').value = val;
            var btns = document.querySelectorAll('.star-btn');
            btns.forEach(function(b, idx) {
                b.classList.toggle('text-yellow-400', idx < val);
                b.classList.toggle('text-gray-300', idx >= val);
            });
        }

        // Wishlist
        var wishBtn = document.getElementById('wishlist-btn');
        var wishIcon = document.getElementById('wishlist-icon');
        if (wishBtn) {
            var pid = wishBtn.getAttribute('data-product-id');
            fetch('/api/favori/Kontrol?productId=' + pid)
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d.inWishlist) {
                        wishIcon.setAttribute('fill', 'currentColor');
                        wishIcon.classList.remove('text-gray-400');
                        wishIcon.classList.add('text-red-500');
                        wishBtn.setAttribute('data-in-wishlist', 'true');
                    }
                }).catch(function(){});

            wishBtn.addEventListener('click', function() {
                var inWl = wishBtn.getAttribute('data-in-wishlist') === 'true';
                var url = inWl ? '/api/favori/Sil' : '/api/favori/Ekle';
                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: pid })
                }).then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d.success) {
                        if (inWl) {
                            wishIcon.setAttribute('fill', 'none');
                            wishIcon.classList.remove('text-red-500');
                            wishIcon.classList.add('text-gray-400');
                            wishBtn.setAttribute('data-in-wishlist', 'false');
                        } else {
                            wishIcon.setAttribute('fill', 'currentColor');
                            wishIcon.classList.remove('text-gray-400');
                            wishIcon.classList.add('text-red-500');
                            wishBtn.setAttribute('data-in-wishlist', 'true');
                        }
                    }
                });
            });
        }

        // Hash navigation for reviews tab
        if (window.location.hash === '#reviews') {
            showTab('tab-reviews');
        }

        // Recently viewed
        RecentlyViewed.add({
            id: '@Model.Id',
            title: '@Html.Raw(Model.Title.Replace("'", "\\'"))',
            slug: '@Model.SeoSlug',
            image: '@(Model.Variants.FirstOrDefault()?.ImageUrls.FirstOrDefault())',
            price: '@Model.MinPrice.ToString("N2")'
        });
        RecentlyViewed.render('recently-viewed');

        var addBtn = document.getElementById('add-to-cart-btn');
        if (addBtn && !addBtn.disabled) {
            addBtn.addEventListener('click', function() {
                var variantId = addBtn.getAttribute('data-variant-id');
                var qty = parseInt(document.getElementById('quantity-input').value || '1');
                addBtn.disabled = true;
                addBtn.textContent = 'Ekleniyor...';
                fetch('/api/sepet/Ekle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productVariantId: variantId, quantity: qty })
                }).then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d.success) {
                        addBtn.textContent = 'Sepete Eklendi!';
                        var badge = document.getElementById('cart-badge');
                        if (badge) { badge.textContent = d.itemCount; badge.style.display = 'flex'; }
                        setTimeout(function() { addBtn.textContent = 'Sepete Ekle'; addBtn.disabled = false; }, 2000);
                    } else {
                        addBtn.textContent = d.message || 'Hata olustu';
                        setTimeout(function() { addBtn.textContent = 'Sepete Ekle'; addBtn.disabled = false; }, 2000);
                    }
                }).catch(function() {
                    addBtn.textContent = 'Sepete Ekle';
                    addBtn.disabled = false;
                });
            });
        }
        // Stock notification
        var notifyBtn = document.getElementById('stock-notify-btn');
        if (notifyBtn) {
            notifyBtn.addEventListener('click', function() {
                var emailInput = document.getElementById('stock-notify-email');
                var msgEl = document.getElementById('stock-notify-msg');
                var email = emailInput.value.trim();
                if (!email) { msgEl.textContent = 'Lutfen e-posta adresinizi girin.'; msgEl.className = 'text-xs mt-2 text-red-500'; return; }
                var variantId = notifyBtn.getAttribute('data-variant-id');
                notifyBtn.disabled = true;
                notifyBtn.textContent = 'Kaydediliyor...';
                fetch('/api/stok-bildirim', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productVariantId: variantId, email: email })
                }).then(function(r) { return r.json(); })
                .then(function(d) {
                    msgEl.classList.remove('hidden');
                    if (d.success) {
                        msgEl.textContent = d.message;
                        msgEl.className = 'text-xs mt-2 text-green-600';
                        notifyBtn.textContent = 'Kaydedildi';
                    } else {
                        msgEl.textContent = d.message;
                        msgEl.className = 'text-xs mt-2 text-red-500';
                        notifyBtn.textContent = 'Haber Ver';
                        notifyBtn.disabled = false;
                    }
                }).catch(function() {
                    msgEl.textContent = 'Bir hata olustu. Lutfen tekrar deneyin.';
                    msgEl.className = 'text-xs mt-2 text-red-500';
                    notifyBtn.textContent = 'Haber Ver';
                    notifyBtn.disabled = false;
                });
            });
        }
    </script>
}

@* Size Guide Modal *@
@if (ViewBag.SizeGuide is Entegrasyon.Entity.Storefront.StorefrontSizeGuide sizeGuideModal)
{
    <div id="size-guide-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg max-w-2xl w-full max-h-[80vh] overflow-y-auto p-6 relative">
            <button onclick="document.getElementById('size-guide-modal').classList.add('hidden')"
                    class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <h2 class="text-xl font-bold text-gray-900 mb-4">@sizeGuideModal.Name</h2>
            @if (!string.IsNullOrWhiteSpace(sizeGuideModal.MeasurementInstructions))
            {
                <p class="text-sm text-gray-600 mb-4">@sizeGuideModal.MeasurementInstructions</p>
            }
            @if (!string.IsNullOrWhiteSpace(sizeGuideModal.MeasurementImageUrl))
            {
                <img src="@sizeGuideModal.MeasurementImageUrl" alt="Olcu rehberi" class="w-full rounded mb-4" />
            }
            @{
                try
                {
                    var sizeMatrix = System.Text.Json.JsonSerializer.Deserialize<List<List<string>>>(sizeGuideModal.SizeData);
                    if (sizeMatrix != null && sizeMatrix.Count > 0)
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm border-collapse">
                                <thead>
                                    <tr>
                                        @foreach (var header in sizeMatrix[0])
                                        {
                                            <th class="px-3 py-2 bg-gray-100 border border-gray-200 text-left font-medium text-gray-700">@header</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int rowIdx = 1; rowIdx < sizeMatrix.Count; rowIdx++)
                                    {
                                        <tr>
                                            @foreach (var cell in sizeMatrix[rowIdx])
                                            {
                                                <td class="px-3 py-2 border border-gray-200 text-gray-700">@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                catch { }
            }
        </div>
    </div>
}
