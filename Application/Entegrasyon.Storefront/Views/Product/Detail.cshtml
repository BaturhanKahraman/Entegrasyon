@model Entegrasyon.Entity.Dtos.Storefront.StorefrontProductDetailDto
@{
    ViewData["Title"] = Model?.Title ?? "Ürün Detayı";
    var productName = Model?.Title ?? "Çiçekli Yazlık Elbise";
    var brandName = Model?.BrandName ?? "Mavi Kids";
    var brandSlug = Model?.BrandSlug ?? "mavi-kids";
    var price = Model?.MinPrice ?? 349m;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10 pb-28 lg:pb-12">

    @* ============ BREADCRUMB ============ *@
    <nav aria-label="breadcrumb" class="text-sm text-muted mb-6 flex items-center gap-2 overflow-x-auto whitespace-nowrap no-scrollbar">
        <a href="/" class="hover:text-primary transition">Anasayfa</a>
        <span class="text-cream-300">›</span>
        @if (Model?.Breadcrumbs != null && Model.Breadcrumbs.Count > 0)
        {
            foreach (var crumb in Model.Breadcrumbs)
            {
                <a href="@crumb.Url" class="hover:text-primary transition">@crumb.Name</a>
                <span class="text-cream-300">›</span>
            }
        }
        else
        {
            <a href="/kategori/kiz" class="hover:text-primary transition">Kız</a>
            <span class="text-cream-300">›</span>
            <a href="/kategori/kiz/elbise" class="hover:text-primary transition">Elbise</a>
            <span class="text-cream-300">›</span>
        }
        <span class="text-charcoal font-medium">@productName</span>
    </nav>

    @* ============ TOP GRID ============ *@
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">

        @* gallery *@
        <div>
            <div class="relative">
                <div class="ph relative aspect-[4/5] rounded-2xl overflow-hidden bg-cream">
                    <img id="mainImg" class="photo cursor-zoom-in" alt="@productName" src="" data-lightbox-open />
                </div>
                <div class="sticker absolute top-4 left-4 bg-accent text-charcoal font-heading font-semibold text-sm px-3.5 py-2 rounded-xl rotate-[-8deg]">%30 İndirim</div>
                <button id="galleryHeart" type="button" data-wishlist-toggle data-on="0" aria-label="Favorilere ekle" class="absolute top-4 right-4 w-11 h-11 rounded-full bg-white/90 backdrop-blur flex items-center justify-center text-charcoal hover:text-primary transition shadow-sm">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A4.5 4.5 0 0 0 12 5.5 4.5 4.5 0 0 0 2 8.5C2 10.8 3.5 12.5 5 14l7 7Z"/></svg>
                </button>
            </div>
            <div id="thumbs" class="mt-3 grid grid-cols-5 gap-2.5 sm:gap-3"></div>
        </div>

        @* info panel *@
        <div class="lg:sticky lg:top-24 lg:self-start">
            <a href="/marka/@brandSlug" class="text-sm text-muted hover:text-primary transition">@brandName</a>
            <h1 class="font-heading text-3xl lg:text-4xl text-charcoal mt-1 leading-tight">@productName</h1>

            <div class="flex items-center gap-2 mt-3">
                <div class="flex items-center gap-0.5 text-accent" aria-label="4.8 / 5 yıldız">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8L9 8.3Z"/></svg>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8L9 8.3Z"/></svg>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8L9 8.3Z"/></svg>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8L9 8.3Z"/></svg>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><defs><linearGradient id="half"><stop offset="80%" stop-color="#FFD56B"/><stop offset="80%" stop-color="#E8DFD2"/></linearGradient></defs><path fill="url(#half)" d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8L9 8.3Z"/></svg>
                </div>
                <span class="text-sm font-semibold text-charcoal">4.8</span>
                <a href="#yorumlar" data-tab-switch="reviews" class="text-sm text-muted hover:text-primary transition">(156 değerlendirme)</a>
            </div>

            <div class="flex items-baseline gap-3 mt-4">
                <span class="text-lg text-muted line-through">499₺</span>
                <span class="text-4xl font-semibold text-primary">@price.ToString("N0")₺</span>
                <span class="text-sm font-semibold text-success bg-success/10 px-2 py-0.5 rounded-full">%30 indirim</span>
            </div>

            <div class="flex flex-wrap items-center gap-2 mt-4">
                <span id="stockBadge" class="inline-flex items-center gap-1.5 text-sm font-medium text-success bg-success/10 px-3 py-1 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-success"></span><span id="stockMsg">Stokta · 12 adet</span>
                </span>
                <span class="text-sm text-charcoal bg-cream px-3 py-1 rounded-full">2-7 yaş</span>
                <span class="text-sm text-charcoal bg-cream px-3 py-1 rounded-full">İlkbahar / Yaz</span>
            </div>

            @* size selector *@
            <div class="mt-7">
                <div class="flex items-center justify-between mb-3">
                    <span class="font-semibold text-charcoal text-sm">Beden seçin</span>
                    <button type="button" data-size-modal-open class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h18v18H3zM3 9h18M9 21V9"/></svg>
                        Beden Tablosu
                    </button>
                </div>
                <div id="sizeChips" class="flex flex-wrap gap-2.5"></div>
            </div>

            @* color selector *@
            <div class="mt-6">
                <p class="font-semibold text-charcoal text-sm mb-3">Renk: <span id="colorLabel" class="font-normal text-muted">Pudra Pembe</span></p>
                <div id="colorSwatches" class="flex items-center gap-3"></div>
            </div>

            @* qty + CTA *@
            <div class="mt-7 flex items-center gap-4">
                <div class="flex items-center border border-cream-300 rounded-full">
                    <button type="button" data-qty-change="-1" aria-label="Azalt" class="w-11 h-11 flex items-center justify-center text-charcoal hover:text-primary text-xl">−</button>
                    <span id="qty" class="w-8 text-center font-semibold">1</span>
                    <button type="button" data-qty-change="1" aria-label="Artır" class="w-11 h-11 flex items-center justify-center text-charcoal hover:text-primary text-xl">+</button>
                </div>
                <span class="text-sm text-muted">Adet</span>
            </div>

            <div class="mt-5 flex flex-col gap-3">
                <button type="button" data-add-to-cart class="w-full py-4 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-[0_10px_24px_-6px_rgba(255,143,177,.6)]">Sepete Ekle</button>
                <button type="button" data-add-to-cart data-buy-now class="w-full py-4 rounded-full border-2 border-primary text-primary font-semibold hover:bg-primary/5 transition">Hemen Al</button>
            </div>

            @* quick info *@
            <div class="mt-7 border-t border-cream-300 pt-6 space-y-3.5 text-sm">
                <div class="flex items-center gap-3 text-charcoal">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#FF8FB1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.3a2 2 0 0 0-.6-1.4L18 9h-4v8h2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                    <span><span class="font-semibold">Yarın elinizde</span> — bugün 16:00'dan önce sipariş verin</span>
                </div>
                <div class="flex items-center gap-3 text-charcoal">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#8FCBE8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    <span>500₺ üzeri siparişlerde <span class="font-semibold">kargo bedava</span></span>
                </div>
                <div class="flex items-center gap-3 text-charcoal">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                    <span>30 gün <span class="font-semibold">ücretsiz iade</span></span>
                </div>
                <div class="flex items-center gap-3">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg>
                    <a href="#" class="text-success font-semibold hover:underline">WhatsApp ile sor</a>
                </div>
            </div>

            @* share *@
            <div class="mt-6 flex items-center gap-3 text-sm text-muted">
                <span>Paylaş:</span>
                <button type="button" data-share="whatsapp" aria-label="WhatsApp'ta paylaş" class="w-9 h-9 rounded-full border border-cream-300 flex items-center justify-center hover:border-success hover:text-success transition"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg></button>
                <button type="button" data-share="facebook" aria-label="Facebook'ta paylaş" class="w-9 h-9 rounded-full border border-cream-300 flex items-center justify-center hover:border-secondary hover:text-secondary transition"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/></svg></button>
                <button type="button" data-share="copy" aria-label="Bağlantıyı kopyala" class="w-9 h-9 rounded-full border border-cream-300 flex items-center justify-center hover:border-primary hover:text-primary transition"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg></button>
            </div>
        </div>
    </div>

    @* ============ TABS ============ *@
    <div id="yorumlar" class="mt-14 lg:mt-20">
        <div class="flex gap-6 border-b border-cream-300 overflow-x-auto no-scrollbar">
            <button type="button" class="tabBtn whitespace-nowrap pb-3 text-sm font-semibold border-b-2 border-primary text-charcoal" data-tab="detail">Ürün Detayı</button>
            <button type="button" class="tabBtn whitespace-nowrap pb-3 text-sm font-semibold border-b-2 border-transparent text-muted hover:text-charcoal" data-tab="size">Beden Rehberi</button>
            <button type="button" class="tabBtn whitespace-nowrap pb-3 text-sm font-semibold border-b-2 border-transparent text-muted hover:text-charcoal" data-tab="shipping">İade &amp; Kargo</button>
            <button type="button" class="tabBtn whitespace-nowrap pb-3 text-sm font-semibold border-b-2 border-transparent text-muted hover:text-charcoal" data-tab="reviews">Yorumlar (156)</button>
        </div>

        @* detail panel *@
        <div class="tabPanel py-8" data-panel="detail">
            <div class="max-w-3xl space-y-4 text-charcoal/85 leading-relaxed">
                @if (!string.IsNullOrWhiteSpace(Model?.Description))
                {
                    @Html.Raw(Model.Description)
                }
                else
                {
                    <p>Yumuşacık %100 pamuklu kumaşıyla yazın sıcak günlerinde miniğinizin teninde nefes alan Çiçekli Yazlık Elbise, neşeli çiçek deseni ve fırfır detaylarıyla hem rahat hem şık. Geniş kesimi gün boyu özgürce hareket etmesini sağlar.</p>
                    <p>Arkadan gizli düğmeli kapanışı sayesinde giydirmesi kolay; cilt dostu boyalar ve OEKO-TEX sertifikalı kumaş ile hassas ciltlere uygundur. Solmayan renkler, kolay ütülenebilir doku.</p>
                }
            </div>
            <div class="mt-8 max-w-2xl">
                <h3 class="font-heading text-lg text-charcoal mb-3">Ürün Özellikleri</h3>
                <dl class="divide-y divide-cream-300 border-y border-cream-300 text-sm">
                    <div class="flex py-3"><dt class="w-40 text-muted">Kumaş</dt><dd class="text-charcoal">%100 Pamuk (penye)</dd></div>
                    <div class="flex py-3"><dt class="w-40 text-muted">Yıkama</dt><dd class="text-charcoal">30°C hassas yıkama</dd></div>
                    <div class="flex py-3"><dt class="w-40 text-muted">Menşei</dt><dd class="text-charcoal">Türkiye</dd></div>
                    <div class="flex py-3"><dt class="w-40 text-muted">Desen</dt><dd class="text-charcoal">Çiçekli</dd></div>
                    <div class="flex py-3"><dt class="w-40 text-muted">Model ölçüsü</dt><dd class="text-charcoal">Model 110 cm boyunda, 4 yaş — 104 beden giyiyor</dd></div>
                </dl>
            </div>
        </div>

        @* size panel *@
        <div class="tabPanel py-8 hidden" data-panel="size">
            <p class="max-w-2xl text-charcoal/85 leading-relaxed mb-6">Çocuk bedenleri yaşa ve boya göre değişir. En doğru beden için çocuğunuzun boy ve kilosunu ölçün; iki beden arasında kaldıysanız büyük olanı tercih edin.</p>
            <div id="sizeTableTab" class="max-w-2xl"></div>
        </div>

        @* shipping panel *@
        <div class="tabPanel py-8 hidden" data-panel="shipping">
            <div class="max-w-2xl grid sm:grid-cols-2 gap-8 text-sm">
                <div>
                    <h3 class="font-heading text-lg text-charcoal mb-3">Kargo</h3>
                    <ul class="space-y-2.5 text-charcoal/85">
                        <li class="flex gap-2"><span class="text-primary">•</span> 500₺ ve üzeri siparişlerde kargo ücretsiz.</li>
                        <li class="flex gap-2"><span class="text-primary">•</span> 16:00'dan önceki siparişler aynı gün kargoda.</li>
                        <li class="flex gap-2"><span class="text-primary">•</span> Standart teslimat 1-3 iş günü, Express ertesi gün.</li>
                        <li class="flex gap-2"><span class="text-primary">•</span> Tüm siparişler kapıda hasar kontrollü teslim edilir.</li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-heading text-lg text-charcoal mb-3">İade &amp; Değişim</h3>
                    <ul class="space-y-2.5 text-charcoal/85">
                        <li class="flex gap-2"><span class="text-primary">•</span> 30 gün içinde koşulsuz iade hakkı.</li>
                        <li class="flex gap-2"><span class="text-primary">•</span> İade kargo ücreti tarafımızca karşılanır.</li>
                        <li class="flex gap-2"><span class="text-primary">•</span> Etiketli ve yıkanmamış ürünler kabul edilir.</li>
                        <li class="flex gap-2"><span class="text-primary">•</span> Beden değişimi 48 saat içinde gönderilir.</li>
                    </ul>
                </div>
            </div>
        </div>

        @* reviews panel *@
        <div class="tabPanel py-8 hidden" data-panel="reviews">
            <div class="grid lg:grid-cols-3 gap-10">
                <div class="lg:col-span-1">
                    <div class="bg-cream rounded-3xl p-7 text-center">
                        <p class="font-heading text-5xl text-charcoal">4.8</p>
                        <div class="flex justify-center gap-0.5 text-accent my-2" aria-hidden="true">
                            @for (var i = 0; i < 5; i++)
                            {
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.8 5.9 20.8 7.1 14l-5-4.8L9 8.3Z"/></svg>
                            }
                        </div>
                        <p class="text-sm text-muted">156 değerlendirme</p>
                        <div id="ratingBars" class="mt-5 space-y-1.5 text-left"></div>
                        <button type="button" data-review-write class="mt-6 w-full py-3 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition">Yorum Yaz</button>
                    </div>
                </div>
                <div id="reviewList" class="lg:col-span-2 space-y-6"></div>
            </div>
        </div>
    </div>

    @* ============ SIMILAR ============ *@
    <section class="mt-16 lg:mt-20">
        <div class="flex items-end justify-between mb-6">
            <h2 class="font-heading text-2xl lg:text-3xl text-charcoal">Benzer Ürünler</h2>
            <div class="flex items-center gap-2">
                <button type="button" data-carousel-scroll="prev" data-carousel-target="simScroll" aria-label="Önceki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                <button type="button" data-carousel-scroll="next" data-carousel-target="simScroll" aria-label="Sonraki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
            </div>
        </div>
        <div id="simScroll" class="grid grid-flow-col auto-cols-[68%] sm:auto-cols-[40%] md:auto-cols-[30%] lg:auto-cols-[23.5%] gap-4 sm:gap-6 overflow-x-auto no-scrollbar snap-x scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0"></div>
    </section>

    @* ============ BOUGHT TOGETHER ============ *@
    <section class="mt-16 lg:mt-20">
        <h2 class="font-heading text-2xl lg:text-3xl text-charcoal mb-6">Birlikte sık alınıyor</h2>
        <div class="bg-cream rounded-3xl p-6 lg:p-8 flex flex-col lg:flex-row lg:items-center gap-6">
            <div id="bundle" class="flex items-center gap-3 flex-wrap justify-center lg:justify-start flex-1"></div>
            <div class="lg:border-l lg:border-cream-300 lg:pl-8 text-center lg:text-left">
                <p class="text-sm text-muted">3 ürün toplamı</p>
                <p class="mt-1"><span class="text-base text-muted line-through">833₺</span> <span class="text-2xl font-semibold text-primary ml-1">750₺</span></p>
                <p class="text-xs text-success font-medium mt-0.5">Pakete özel %10 indirim</p>
                <button type="button" data-add-bundle class="mt-3 w-full lg:w-auto px-6 py-3 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition whitespace-nowrap">Sepete Ekle (3 ürün)</button>
            </div>
        </div>
    </section>

    @* ============ RECENTLY VIEWED ============ *@
    <section class="mt-16 lg:mt-20">
        <div class="flex items-end justify-between mb-6">
            <h2 class="font-heading text-2xl lg:text-3xl text-charcoal">Son Gezdikleriniz</h2>
            <div class="flex items-center gap-2">
                <button type="button" data-carousel-scroll="prev" data-carousel-target="recentScroll" aria-label="Önceki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
                <button type="button" data-carousel-scroll="next" data-carousel-target="recentScroll" aria-label="Sonraki" class="hidden sm:flex w-10 h-10 rounded-full border border-cream-300 items-center justify-center text-charcoal hover:border-primary hover:text-primary transition"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
            </div>
        </div>
        <div id="recentScroll" class="grid grid-flow-col auto-cols-[44%] sm:auto-cols-[28%] md:auto-cols-[22%] lg:auto-cols-[15.66%] gap-4 sm:gap-5 overflow-x-auto no-scrollbar snap-x scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0"></div>
    </section>
</div>

@* ============ SIZE MODAL ============ *@
<div id="sizeModal" class="hidden fixed inset-0 z-[55] flex items-center justify-center p-4">
    <div data-size-modal-close class="absolute inset-0 bg-charcoal/40"></div>
    <div class="relative bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-7 sm:p-8 shadow-md">
        <div class="flex items-start justify-between mb-2">
            <h2 class="font-heading text-2xl text-charcoal">Beden Tablosu</h2>
            <button type="button" data-size-modal-close aria-label="Kapat" class="p-2 -mr-2 text-charcoal/50 hover:text-charcoal"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <p class="text-sm text-muted leading-relaxed mb-5">Çocuk bedenleri yaşa ve boya göre değişir. En doğru beden için çocuğunuzun boy ve kilosunu ölçün.</p>
        <div id="sizeTableModal"></div>
        <div class="mt-6 bg-cream rounded-2xl p-5">
            <h3 class="font-semibold text-charcoal text-sm mb-3">Nasıl ölçülür?</h3>
            <div class="flex items-center gap-5">
                <svg viewBox="0 0 120 80" width="120" height="80" class="shrink-0" aria-hidden="true">
                    <rect x="1" y="1" width="118" height="78" rx="8" fill="#FAF6F0" stroke="#E8DFD2"/>
                    <path d="M30 16 V64" stroke="#FF8FB1" stroke-width="2" stroke-linecap="round"/>
                    <path d="M26 20 L30 14 L34 20 M26 60 L30 66 L34 60" fill="none" stroke="#FF8FB1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <text x="38" y="42" font-family="ui-monospace, monospace" font-size="9" fill="#7B8794">boy</text>
                    <path d="M64 34 H104" stroke="#8FCBE8" stroke-width="2" stroke-linecap="round"/>
                    <path d="M68 30 L62 34 L68 38 M100 30 L106 34 L100 38" fill="none" stroke="#8FCBE8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <text x="70" y="52" font-family="ui-monospace, monospace" font-size="9" fill="#7B8794">göğüs</text>
                </svg>
                <p class="text-sm text-charcoal/80 leading-relaxed">Boy: baştan ayak tabanına kadar düz ölçün. Göğüs: kolların altından en geniş yerden çevreleyin.</p>
            </div>
        </div>
    </div>
</div>

@* ============ LIGHTBOX ============ *@
<div id="lightbox" class="hidden fixed inset-0 z-[70] bg-charcoal/90 flex items-center justify-center p-4">
    <button type="button" data-lightbox-close aria-label="Kapat" class="absolute top-5 right-5 w-11 h-11 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    <button type="button" data-lightbox-nav="-1" aria-label="Önceki" class="absolute left-4 sm:left-8 w-12 h-12 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
    <img id="lightboxImg" class="max-w-[88vw] max-h-[85vh] rounded-2xl object-contain" alt="" src="" />
    <button type="button" data-lightbox-nav="1" aria-label="Sonraki" class="absolute right-4 sm:right-8 w-12 h-12 rounded-full bg-white/10 text-white flex items-center justify-center hover:bg-white/20 transition"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
</div>

@* ============ STICKY MOBILE CTA ============ *@
<div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-cream-300 px-4 py-3 flex items-center gap-3">
    <div class="ph w-12 h-14 rounded-xl overflow-hidden bg-cream shrink-0"><img id="mobileThumb" class="photo" alt="" src="" /></div>
    <div class="flex-1 leading-tight">
        <p class="text-xs text-muted line-through">499₺</p>
        <p class="text-lg font-semibold text-primary">@price.ToString("N0")₺</p>
    </div>
    <button type="button" data-add-to-cart class="flex-1 max-w-[55%] py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition">Sepete Ekle</button>
</div>

@section Scripts {
    <script src="~/js/product-detail.js" asp-append-version="true"></script>
}
