@using Entegrasyon.Entity.Dtos.Storefront
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Siparis Detayi | @Tenant.Settings.StoreName" />
}

@{
    var order = ViewBag.Order as StorefrontOrderDetailDto;
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        <nav class="bg-white rounded-lg shadow p-4 space-y-1">
            <a href="/hesabim" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Hesap Ozeti</a>
            <a href="/hesabim/Profile" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Profilim</a>
            <a href="/hesabim/Orders" class="block px-3 py-2 rounded bg-gray-50 font-medium text-primary no-underline">Siparislerim</a>
            <a href="/hesabim/iadelerim" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Iadelerim</a>
            <a href="/hesabim/Addresses" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Adreslerim</a>
            <a href="/hesabim/ChangePassword" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Sifre Degistir</a>
            <a href="/cikis" class="block px-3 py-2 rounded text-red-600 hover:bg-red-50 no-underline">Cikis Yap</a>
        </nav>
    </aside>
    <div class="flex-1 space-y-6">
        @if (TempData["Success"] is string success)
        {
            <div class="bg-green-50 text-green-700 p-3 rounded">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="bg-red-50 text-red-700 p-3 rounded">@error</div>
        }

        @if (order is null)
        {
            <div class="bg-white rounded-lg shadow p-6">
                <p class="text-gray-500">Siparis bilgisi bulunamadi.</p>
            </div>
        }
        else
        {
            <!-- Header -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
                    <div>
                        <a href="/hesabim/Orders" class="text-sm text-gray-500 hover:text-gray-700 no-underline">&larr; Siparislere Don</a>
                        <h1 class="text-xl font-bold text-gray-900 mt-1">Siparis #@order.OrderNumber</h1>
                        <p class="text-sm text-gray-500">@order.OrderDate.ToString("dd MMMM yyyy, HH:mm")</p>
                    </div>
                    <div class="flex items-center gap-3">
                        @{
                            var statusBadge = order.Status switch
                            {
                                "Alindi" => "bg-blue-100 text-blue-700",
                                "Hazirlaniyor" => "bg-yellow-100 text-yellow-700",
                                "Kargoda" => "bg-orange-100 text-orange-700",
                                "Teslim Edildi" => "bg-green-100 text-green-700",
                                "Iptal Edildi" => "bg-red-100 text-red-700",
                                "Iade Edildi" => "bg-purple-100 text-purple-700",
                                _ => "bg-gray-100 text-gray-700"
                            };
                        }
                        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium @statusBadge">@order.Status</span>
                    </div>
                </div>

                <!-- Status Timeline -->
                <div class="flex items-center gap-1 overflow-x-auto pb-2">
                    @{
                        var steps = new[] { "Alindi", "Hazirlaniyor", "Kargoda", "Teslim Edildi" };
                        var currentIdx = Array.IndexOf(steps, order.Status);
                        var isCancelled = order.Status == "Iptal Edildi" || order.Status == "Iade Edildi";
                    }
                    @for (var i = 0; i < steps.Length; i++)
                    {
                        var isActive = !isCancelled && i <= currentIdx;
                        var dotClass = isActive ? "bg-primary" : "bg-gray-300";
                        var lineClass = isActive ? "bg-primary" : "bg-gray-200";
                        var textClass = isActive ? "text-primary font-medium" : "text-gray-400";

                        <div class="flex items-center">
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 rounded-full @dotClass"></div>
                                <span class="text-xs mt-1 whitespace-nowrap @textClass">@steps[i]</span>
                            </div>
                            @if (i < steps.Length - 1)
                            {
                                <div class="w-12 h-0.5 @lineClass mx-1 mt-[-12px]"></div>
                            }
                        </div>
                    }
                    @if (isCancelled)
                    {
                        <div class="flex items-center">
                            <div class="w-12 h-0.5 bg-red-300 mx-1 mt-[-12px]"></div>
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                <span class="text-xs mt-1 whitespace-nowrap text-red-600 font-medium">@order.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Items -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Urunler</h2>
                <div class="divide-y divide-gray-100">
                    @foreach (var item in order.Items)
                    {
                        <div class="flex items-center gap-4 py-3">
                            <div class="w-12 h-12 bg-gray-100 rounded flex items-center justify-center text-gray-400 shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-medium text-gray-900 truncate">@item.ProductTitle</p>
                                @if (!string.IsNullOrEmpty(item.VariantInfo))
                                {
                                    <p class="text-xs text-gray-500">@item.VariantInfo</p>
                                }
                                <p class="text-xs text-gray-500">@item.Quantity adet x @item.UnitPrice.ToString("N2") TL</p>
                            </div>
                            <div class="text-right font-medium text-gray-900 shrink-0">
                                @item.LineTotal.ToString("N2") TL
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Summary + Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Order Summary -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Siparis Ozeti</h2>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Ara Toplam</span>
                            <span>@order.SubTotal.ToString("N2") TL</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Kargo</span>
                            <span>@(order.ShippingCost == 0 ? "Ucretsiz" : $"{order.ShippingCost:N2} TL")</span>
                        </div>
                        @if (order.DiscountAmount > 0)
                        {
                            <div class="flex justify-between text-green-600">
                                <span>Indirim</span>
                                <span>-@order.DiscountAmount.ToString("N2") TL</span>
                            </div>
                        }
                        <div class="flex justify-between font-bold text-base border-t border-gray-200 pt-2 mt-2">
                            <span>Toplam</span>
                            <span>@order.Total.ToString("N2") TL</span>
                        </div>
                        <div class="flex justify-between text-gray-500 text-xs">
                            <span>Odeme Durumu</span>
                            <span>@order.PaymentStatus</span>
                        </div>
                    </div>
                </div>

                <!-- Shipping & Info -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Teslimat Bilgileri</h2>
                    <div class="space-y-3 text-sm">
                        @if (!string.IsNullOrEmpty(order.CustomerName))
                        {
                            <div>
                                <span class="text-gray-500">Alici:</span>
                                <p class="text-gray-900">@order.CustomerName</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(order.ShippingAddress))
                        {
                            <div>
                                <span class="text-gray-500">Adres:</span>
                                <p class="text-gray-900">@order.ShippingAddress</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(order.CargoProvider))
                        {
                            <div>
                                <span class="text-gray-500">Kargo Firmasi:</span>
                                <p class="text-gray-900">@order.CargoProvider</p>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(order.TrackingNumber))
                        {
                            <div>
                                <span class="text-gray-500">Takip No:</span>
                                <p class="text-gray-900 font-mono">@order.TrackingNumber</p>
                                @if (!string.IsNullOrEmpty(order.TrackingLink))
                                {
                                    <a href="@order.TrackingLink" target="_blank" rel="noopener" class="text-primary text-xs hover:underline no-underline">Kargo Takip Sayfasi &rarr;</a>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(order.OrderNote))
                        {
                            <div>
                                <span class="text-gray-500">Siparis Notu:</span>
                                <p class="text-gray-900">@order.OrderNote</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="bg-white rounded-lg shadow p-6 flex flex-wrap gap-3">
                <a href="/hesabim/siparis/@order.Id/fatura" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 no-underline text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Fatura Indir
                </a>
                @if (order.Status == "Alindi")
                {
                    <form method="post" action="/hesabim/siparis/@order.Id/iptal" class="inline" onsubmit="return confirm('Siparisi iptal etmek istediginize emin misiniz?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 rounded hover:bg-red-100 text-sm cursor-pointer border-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            Siparisi Iptal Et
                        </button>
                    </form>
                }
                @if (order.Status == "Teslim Edildi")
                {
                    <a href="/hesabim/iade-talebi/@order.Id" class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 text-purple-600 rounded hover:bg-purple-100 no-underline text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                        </svg>
                        Iade Talebi
                    </a>
                }
            </div>
        }
    </div>
</div>
