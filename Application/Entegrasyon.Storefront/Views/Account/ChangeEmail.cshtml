@{
    ViewData["Title"] = "E-posta Değiştir";
    var currentEmail = ViewBag.Email as string ?? "";
    var error = ViewBag.Error as string ?? TempData["ProfileError"] as string;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">
    <div class="lg:grid lg:grid-cols-[18rem_1fr] lg:gap-8">

        @* ---- SIDEBAR ---- *@
        <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
            <partial name="_AccountSidebar" />
        </aside>
        <details class="lg:hidden mb-5 bg-white border border-cream-300 rounded-2xl">
            <summary class="flex items-center justify-between px-5 py-3.5 cursor-pointer list-none">
                <span class="font-medium text-charcoal">Hesabım Menüsü</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-3 pb-3">
                <partial name="_AccountSidebar" />
            </div>
        </details>

        @* ---- MAIN ---- *@
        <div>
            <div class="max-w-lg mx-auto">
                <div class="mb-7">
                    <h1 class="font-heading text-3xl text-charcoal">E-posta Değiştir</h1>
                    <p class="text-muted mt-1.5 text-sm">Yeni adresinize bir doğrulama bağlantısı göndereceğiz. Bağlantıya tıklayana kadar adresiniz doğrulanmamış kalır.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="mb-5 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3" role="alert">
                        @error
                    </div>
                }

                <form asp-controller="Account" asp-action="ChangeEmail" method="post" class="rounded-2xl border border-cream-300 p-6 space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-charcoal mb-1.5">Mevcut e-posta</label>
                        <input type="email" value="@currentEmail" readonly class="w-full px-3 py-2.5 rounded-xl border border-cream-300 bg-cream/60 text-sm text-muted outline-none" />
                    </div>

                    <div>
                        <label for="newEmail" class="block text-sm font-medium text-charcoal mb-1.5">Yeni e-posta</label>
                        <input id="newEmail" name="newEmail" type="email" required autocomplete="email" placeholder="yeni@eposta.com" class="w-full px-3 py-2.5 rounded-xl border border-cream-300 text-sm outline-none focus:border-primary" />
                    </div>

                    <div>
                        <label for="currentPassword" class="block text-sm font-medium text-charcoal mb-1.5">Mevcut şifre</label>
                        <div class="relative">
                            <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password" placeholder="••••••••" class="w-full px-3 py-2.5 pr-11 rounded-xl border border-cream-300 text-sm outline-none focus:border-primary" />
                            <button type="button" data-toggle-pw="currentPassword" aria-label="Şifreyi göster" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                        </div>
                        <p class="text-xs text-muted mt-1.5">Güvenliğiniz için mevcut şifrenizi doğrulamanız gerekir.</p>
                    </div>

                    <div class="flex flex-wrap gap-3 pt-1">
                        <button type="submit" class="px-7 py-3 rounded-full bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition">Doğrulama Bağlantısı Gönder</button>
                        <a asp-controller="Account" asp-action="Profile" class="px-7 py-3 rounded-full border border-cream-300 text-sm font-semibold text-charcoal hover:bg-cream transition">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
