@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var referralCode = ViewBag.ReferralCode as string ?? "";
    var referrals = ViewBag.Referrals as List<Entegrasyon.Entity.Storefront.StorefrontReferral> ?? new();
    var domain = ViewBag.Domain as string ?? "";
    var settings = ViewBag.Settings as Entegrasyon.Entity.Storefront.StorefrontSettings;
    var referralLink = $"https://{domain}/kayit?ref={referralCode}";
}

@section Head {
    <seo-meta title="Arkadasini Getir | @Tenant.Settings.StoreName" />
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        @await Html.PartialAsync("_AccountSidebar", "Referral")
    </aside>
    <div class="flex-1">
        <div class="bg-white rounded-lg shadow p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-2">Arkadasini Getir</h1>
            <p class="text-gray-600 mb-6">Arkadaslarinizi davet edin, birlikte kazanin!</p>

            @* Referral Link *@
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-8">
                <p class="text-sm font-medium text-blue-700 mb-2">Davet Linkiniz</p>
                <div class="flex items-center gap-2">
                    <input type="text" id="referral-link" value="@referralLink" readonly
                           class="flex-1 px-3 py-2 bg-white border border-blue-300 rounded-lg text-sm text-gray-900 font-mono" />
                    <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('referral-link').value); this.textContent='Kopyalandi!'; setTimeout(() => this.textContent='Kopyala', 2000)"
                            class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors whitespace-nowrap">
                        Kopyala
                    </button>
                </div>

                <div class="flex items-center gap-2 mt-3">
                    <p class="text-sm text-blue-600">Referans Kodu: <strong class="font-mono">@referralCode</strong></p>
                </div>

                @* Share Buttons *@
                <div class="flex items-center gap-3 mt-4">
                    <a href="https://wa.me/?text=@Uri.EscapeDataString($"{settings?.StoreName} - {referralLink}")"
                       target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1 px-3 py-1.5 bg-green-500 text-white text-sm rounded-lg hover:bg-green-600 transition-colors no-underline">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                        </svg>
                        WhatsApp
                    </a>
                </div>
            </div>

            @* Reward Info *@
            @if (settings is not null)
            {
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-8">
                    <h2 class="text-sm font-semibold text-gray-700 mb-2">Nasil Calisir?</h2>
                    <ul class="text-sm text-gray-600 space-y-1">
                        <li>1. Davet linkinizi arkadaslarinizla paylasin.</li>
                        <li>2. Arkadasiniz bu link ile kayit olsun.</li>
                        <li>3. Her basarili davet icin <strong>@settings.LoyaltyReferralBonus puan</strong> kazanin!</li>
                    </ul>
                </div>
            }

            @* Referral History *@
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Davetleriniz</h2>

            @if (referrals.Count == 0)
            {
                <p class="text-gray-500 text-sm">Henuz davetiniz bulunmuyor. Arkadaslarinizi davet etmeye baslayin!</p>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var r in referrals)
                    {
                        <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg">
                            <div class="text-sm">
                                <span class="text-gray-600">Davet #@r.Id</span>
                                <span class="text-gray-400 mx-2">|</span>
                                <span class="text-gray-500">@r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>
                            <span class="text-xs font-medium px-2 py-1 rounded-full @MapStatusColor(r.Status)">
                                @MapStatus(r.Status)
                            </span>
                        </div>
                    }
                </div>

                <p class="text-sm text-gray-500 mt-4">Toplam <strong>@referrals.Count</strong> basarili davet.</p>
            }
        </div>
    </div>
</div>

@functions {
    static string MapStatus(Entegrasyon.Entity.Storefront.ReferralStatus status) => status switch
    {
        Entegrasyon.Entity.Storefront.ReferralStatus.Registered => "Kayit Oldu",
        Entegrasyon.Entity.Storefront.ReferralStatus.Completed => "Tamamlandi",
        Entegrasyon.Entity.Storefront.ReferralStatus.Rewarded => "Odullendirildi",
        _ => "Bekliyor"
    };

    static string MapStatusColor(Entegrasyon.Entity.Storefront.ReferralStatus status) => status switch
    {
        Entegrasyon.Entity.Storefront.ReferralStatus.Registered => "bg-blue-100 text-blue-700",
        Entegrasyon.Entity.Storefront.ReferralStatus.Completed => "bg-green-100 text-green-700",
        Entegrasyon.Entity.Storefront.ReferralStatus.Rewarded => "bg-yellow-100 text-yellow-700",
        _ => "bg-gray-100 text-gray-600"
    };
}
