@using Entegrasyon.Entity.Storefront
@using System.Globalization
@{
    ViewData["Title"] = "Davet Et";

    var code = ViewBag.ReferralCode as string ?? "";
    var referrals = ViewBag.Referrals as List<StorefrontReferral> ?? new List<StorefrontReferral>();
    var settings = ViewBag.Settings as StorefrontSettings;
    var domain = ViewBag.Domain as string;

    var referralBonus = settings?.LoyaltyReferralBonus ?? 200;

    // Davet linki — domain yoksa relatif /kayit?ref= kullan (JS tarafı location.origin ile tamamlar).
    var referralLink = !string.IsNullOrWhiteSpace(domain)
        ? $"https://{domain}/kayit?ref={code}"
        : $"/kayit?ref={code}";

    var completedCount = referrals.Count(r => r.Status is ReferralStatus.Completed or ReferralStatus.Rewarded);
    var pendingCount = referrals.Count(r => r.Status is ReferralStatus.Pending or ReferralStatus.Registered);

    var tr = new CultureInfo("tr-TR");

    (string Label, string Css) StatusBadge(ReferralStatus s) => s switch
    {
        ReferralStatus.Rewarded => ("Ödüllendirildi", "bg-primary/10 text-primary"),
        ReferralStatus.Completed => ("Tamamlandı", "bg-success/10 text-success"),
        ReferralStatus.Registered => ("Kayıt oldu", "bg-secondary/15 text-secondary"),
        _ => ("Davet bekliyor", "bg-cream text-muted"),
    };
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">

    @* mobil hesap trigger *@
    <button type="button" data-acc-open class="lg:hidden w-full mb-5 flex items-center justify-between bg-white border border-cream-300 rounded-2xl px-5 py-3.5">
        <span class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-primary/15 text-primary flex items-center justify-center">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13M3 12h18M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8"/></svg>
            </span>
            <span class="font-medium text-charcoal">Davet Et</span>
        </span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>

    <div class="lg:grid lg:grid-cols-[18rem_1fr] lg:gap-8">
        <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
            <partial name="_AccountSidebar" />
        </aside>

        <div>
            @* heading *@
            <div class="mb-7">
                <h1 class="font-heading text-3xl text-charcoal">Arkadaşını Getir</h1>
                <p class="text-muted mt-1.5">Davet et, arkadaşın da sen de <span class="font-medium text-charcoal">@referralBonus.ToString("N0", tr) puan</span> kazanın.</p>
            </div>

            @* davet kodu kartı (gradient) *@
            <div class="relative overflow-hidden rounded-3xl p-7 lg:p-8 mb-8 text-white shadow-[0_18px_40px_-12px_rgba(255,143,177,.55)]"
                 style="background-image:linear-gradient(135deg,#FF8FB1 0%,#FFB098 45%,#FFD56B 100%);">
                <div class="pointer-events-none absolute -top-16 -right-10 w-64 h-64 rounded-full bg-white/20 blur-2xl"></div>
                <div class="relative">
                    <p class="text-sm font-medium text-white/85">Davet Kodun</p>
                    <p class="font-heading text-4xl lg:text-5xl leading-none mt-1.5 tracking-wider" data-referral-code>@(string.IsNullOrWhiteSpace(code) ? "—" : code)</p>

                    <div class="mt-6 flex flex-col sm:flex-row gap-3">
                        <div class="flex-1 flex items-center gap-2 bg-white/15 backdrop-blur rounded-full pl-5 pr-2 py-2 ring-1 ring-white/25">
                            <span class="flex-1 truncate text-sm text-white/95" data-referral-link>@referralLink</span>
                            <button type="button" data-copy-link aria-label="Linki kopyala" class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-white text-primary px-4 py-2 text-sm font-semibold hover:bg-white/90 transition">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                Kopyala
                            </button>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-wrap gap-2.5">
                        <button type="button" data-share-whatsapp class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-4 py-2.5 text-sm font-semibold ring-1 ring-white/25 hover:bg-white/25 transition">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg>
                            WhatsApp
                        </button>
                        <button type="button" data-share-native class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-4 py-2.5 text-sm font-semibold ring-1 ring-white/25 hover:bg-white/25 transition">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
                            Paylaş
                        </button>
                        <button type="button" data-copy-code class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-4 py-2.5 text-sm font-semibold ring-1 ring-white/25 hover:bg-white/25 transition">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            Kodu kopyala
                        </button>
                    </div>
                </div>
            </div>

            @* nasıl çalışır *@
            <section class="mb-8">
                <h2 class="font-heading text-xl text-charcoal mb-4">Nasıl Çalışır?</h2>
                <div class="grid sm:grid-cols-3 gap-4">
                    <div class="rounded-2xl p-5 bg-primary/10">
                        <span class="w-11 h-11 rounded-xl bg-white/70 text-primary flex items-center justify-center mb-3 font-heading text-lg">1</span>
                        <p class="font-medium text-charcoal">Kodunu paylaş</p>
                        <p class="text-sm text-charcoal/65 mt-0.5">Davet linkini arkadaşlarına gönder.</p>
                    </div>
                    <div class="rounded-2xl p-5 bg-secondary/15">
                        <span class="w-11 h-11 rounded-xl bg-white/70 text-secondary flex items-center justify-center mb-3 font-heading text-lg">2</span>
                        <p class="font-medium text-charcoal">Arkadaşın üye olsun</p>
                        <p class="text-sm text-charcoal/65 mt-0.5">Linkten kayıt olup ilk siparişini versin.</p>
                    </div>
                    <div class="rounded-2xl p-5 bg-success/10">
                        <span class="w-11 h-11 rounded-xl bg-white/70 text-success flex items-center justify-center mb-3 font-heading text-lg">3</span>
                        <p class="font-medium text-charcoal">İkiniz de kazanın</p>
                        <p class="text-sm text-charcoal/65 mt-0.5">Hesabına @referralBonus.ToString("N0", tr) puan eklenir.</p>
                    </div>
                </div>
            </section>

            @* davetli listesi *@
            <div class="bg-white border border-cream-300 rounded-2xl mb-8">
                <div class="flex items-center justify-between px-6 py-4 border-b border-cream-300">
                    <h2 class="font-heading text-lg text-charcoal">Davet Ettiklerin</h2>
                    @if (referrals.Count > 0)
                    {
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center gap-1 rounded-full bg-success/10 text-success px-2.5 py-1 font-medium">@completedCount tamamlandı</span>
                            <span class="inline-flex items-center gap-1 rounded-full bg-cream text-muted px-2.5 py-1 font-medium">@pendingCount bekliyor</span>
                        </div>
                    }
                </div>

                @if (referrals.Count == 0)
                {
                    <div class="px-6 py-16 text-center">
                        <div class="w-14 h-14 rounded-2xl bg-cream flex items-center justify-center mx-auto mb-4 text-muted">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M3 21a6 6 0 0 1 12 0"/><path d="M19 8v6M22 11h-6"/></svg>
                        </div>
                        <p class="font-medium text-charcoal">Henüz kimseyi davet etmedin</p>
                        <p class="text-sm text-muted mt-1">Kodunu paylaş, ilk arkadaşın katıldığında burada görünecek.</p>
                    </div>
                }
                else
                {
                    <div class="divide-y divide-cream-300">
                        @foreach (var (r, idx) in referrals.Select((r, idx) => (r, idx + 1)))
                        {
                            var badge = StatusBadge(r.Status);
                            var dateLabel = (r.CompletedAt ?? r.CreatedAt).ToString("d MMMM yyyy", tr);
                            <div class="flex items-center gap-4 px-6 py-4">
                                <span class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 font-semibold text-sm">@idx</span>
                                <div class="flex-1 min-w-0">
                                    <p class="font-medium text-charcoal text-sm truncate">Davetli #@idx</p>
                                    <p class="text-xs text-muted">@dateLabel</p>
                                </div>
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium whitespace-nowrap @badge.Css">@badge.Label</span>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@* mobil hesap sheet *@
<div id="accSheet" class="hidden fixed inset-0 z-[55] lg:hidden">
    <div data-acc-close class="absolute inset-0 bg-charcoal/40"></div>
    <div class="absolute bottom-0 inset-x-0 max-h-[85vh] overflow-y-auto bg-white rounded-t-3xl p-5">
        <div class="flex items-center justify-between mb-3">
            <span class="font-semibold text-charcoal">Hesabım</span>
            <button type="button" data-acc-close aria-label="Kapat" class="p-2 -mr-2 text-charcoal/50 hover:text-charcoal"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <partial name="_AccountSidebar" />
    </div>
</div>

@section Scripts {
    <script src="~/js/referral.js" asp-append-version="true"></script>
}
