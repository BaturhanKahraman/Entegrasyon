@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Hesabim | @Tenant.Settings.StoreName" />
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        @await Html.PartialAsync("_AccountSidebar", "Index")
    </aside>
    <div class="flex-1">
        <div class="bg-white rounded-lg shadow p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Hos geldin, @ViewBag.CustomerName!</h1>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a href="/hesabim/Orders" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Siparislerim</h3>
                    <p class="text-sm text-gray-600">Siparislerinizi goruntuleyin ve takip edin.</p>
                </a>
                <a href="/hesabim/Profile" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Profilim</h3>
                    <p class="text-sm text-gray-600">Kisisel bilgilerinizi duzenleyin.</p>
                </a>
                <a href="/hesabim/iadelerim" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Iadelerim</h3>
                    <p class="text-sm text-gray-600">Iade taleplerinizi goruntuleyin.</p>
                </a>
                <a href="/hesabim/Addresses" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Adreslerim</h3>
                    <p class="text-sm text-gray-600">Teslimat adreslerinizi yonetin.</p>
                </a>
                <a href="/hesabim/tekrar-satin-al" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Tekrar Satin Al</h3>
                    <p class="text-sm text-gray-600">Daha once aldiginiz urunleri tekrar siparis verin.</p>
                </a>
                <a href="/hesabim/guvenlik" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Guvenlik</h3>
                    <p class="text-sm text-gray-600">Oturum gecmisi ve veri indirme.</p>
                </a>
                <a href="/hesabim/puan-programi" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Puan Programi</h3>
                    <p class="text-sm text-gray-600">Puanlarinizi gorun ve kullanin.</p>
                </a>
                <a href="/hesabim/arkadasini-getir" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Arkadasini Getir</h3>
                    <p class="text-sm text-gray-600">Arkadaslarinizi davet edin, puan kazanin.</p>
                </a>
                <a href="/hesabim/ChangePassword" class="block p-4 border border-gray-200 rounded-lg hover:bg-gray-50 no-underline">
                    <h3 class="font-semibold text-gray-900 mb-1">Sifre Degistir</h3>
                    <p class="text-sm text-gray-600">Hesap sifrenizi guncelleyin.</p>
                </a>
            </div>
        </div>
    </div>
</div>
