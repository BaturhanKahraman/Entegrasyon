@using Entegrasyon.Entity.Dtos.Storefront
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Profilim | @Tenant.Settings.StoreName" />
}

@{
    var profile = ViewBag.Profile as StorefrontProfileDto;
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        <nav class="bg-white rounded-lg shadow p-4 space-y-1">
            <a href="/hesabim" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Hesap Ozeti</a>
            <a href="/hesabim/Profile" class="block px-3 py-2 rounded bg-gray-50 font-medium text-primary no-underline">Profilim</a>
            <a href="/hesabim/Orders" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Siparişlerim</a>
            <a href="/hesabim/iadelerim" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Iadelerim</a>
            <a href="/hesabim/Addresses" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Adreslerim</a>
            <a href="/hesabim/ChangePassword" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Sifre Degistir</a>
            <a href="/cikis" class="block px-3 py-2 rounded text-red-600 hover:bg-red-50 no-underline">Cikis Yap</a>
        </nav>
    </aside>
    <div class="flex-1">
        <div class="bg-white rounded-lg shadow p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Profilim</h1>

            @if (ViewBag.Success == true)
            {
                <div class="bg-green-50 text-green-700 text-sm rounded-lg p-3 mb-4">
                    Profiliniz basariyla guncellendi.
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="bg-red-50 text-red-700 text-sm rounded-lg p-3 mb-4">
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-antiforgery="true" class="space-y-4 max-w-lg">
                <div>
                    <label for="Name" class="block text-sm font-medium text-gray-700 mb-1">Ad</label>
                    <input type="text" id="Name" name="Name" required value="@profile?.Name"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>

                <div>
                    <label for="Surname" class="block text-sm font-medium text-gray-700 mb-1">Soyad</label>
                    <input type="text" id="Surname" name="Surname" required value="@profile?.Surname"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>

                <div>
                    <label for="Phone" class="block text-sm font-medium text-gray-700 mb-1">Telefon</label>
                    <input type="tel" id="Phone" name="Phone" value="@profile?.Phone"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">E-posta</label>
                    <input type="email" value="@ViewBag.Email" disabled
                           class="w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 text-gray-500 text-sm" />
                </div>

                <button type="submit" class="btn-primary">Kaydet</button>
            </form>
        </div>
    </div>
</div>
