@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var balance = ViewBag.Balance as Entegrasyon.Entity.Storefront.StorefrontLoyaltyPoints;
    var transactions = ViewBag.Transactions as List<Entegrasyon.Entity.Storefront.StorefrontLoyaltyTransaction> ?? new();
    var settings = ViewBag.Settings as Entegrasyon.Entity.Storefront.StorefrontSettings;
}

@section Head {
    <seo-meta title="Puan Programi | @Tenant.Settings.StoreName" />
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        @await Html.PartialAsync("_AccountSidebar", "LoyaltyPoints")
    </aside>
    <div class="flex-1">
        <div class="bg-white rounded-lg shadow p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Puan Programi</h1>

            @* Balance Card *@
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-lg p-6 mb-8">
                <p class="text-sm opacity-90 mb-1">Mevcut Puaniniz</p>
                <p class="text-4xl font-bold mb-4">@(balance?.CurrentBalance ?? 0) Puan</p>
                <div class="flex gap-6 text-sm opacity-80">
                    <div>
                        <span class="block">Toplam Kazanilan</span>
                        <span class="font-semibold">@(balance?.TotalEarned ?? 0)</span>
                    </div>
                    <div>
                        <span class="block">Toplam Kullanilan</span>
                        <span class="font-semibold">@(balance?.TotalSpent ?? 0)</span>
                    </div>
                </div>
            </div>

            @* Redemption Info *@
            @if (settings is not null)
            {
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-8">
                    <h2 class="text-sm font-semibold text-gray-700 mb-2">Puan Kullanim Bilgisi</h2>
                    <ul class="text-sm text-gray-600 space-y-1">
                        <li>Her @settings.LoyaltyPointsPerLira TL alisveriste <strong>1 puan</strong> kazanirsiniz.</li>
                        <li><strong>@settings.LoyaltyPointsRedemptionRate puan = 1 TL</strong> degerindedir.</li>
                        <li>Minimum <strong>@settings.LoyaltyMinRedemption puan</strong> ile kullanabilirsiniz.</li>
                        <li>Kayit olunca <strong>@settings.LoyaltyWelcomeBonus puan</strong> hos geldin hediyesi.</li>
                        <li>Her urun yorumunda <strong>@settings.LoyaltyReviewBonus puan</strong> kazanirsiniz.</li>
                        <li>Arkadasinizi getirince <strong>@settings.LoyaltyReferralBonus puan</strong> kazanirsiniz.</li>
                    </ul>
                </div>
            }

            @* Transaction History *@
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Puan Gecmisi</h2>

            @if (transactions.Count == 0)
            {
                <p class="text-gray-500 text-sm">Henuz puan hareketiniz bulunmuyor.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-200 text-left text-gray-500">
                                <th class="pb-3 pr-4 font-medium">Tarih</th>
                                <th class="pb-3 pr-4 font-medium">Islem</th>
                                <th class="pb-3 pr-4 font-medium">Aciklama</th>
                                <th class="pb-3 font-medium text-right">Puan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in transactions)
                            {
                                <tr class="border-b border-gray-100">
                                    <td class="py-3 pr-4 text-gray-600">@tx.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                    <td class="py-3 pr-4 text-gray-900">@MapTransactionType(tx.TransactionType)</td>
                                    <td class="py-3 pr-4 text-gray-600">@(tx.Description ?? "-")</td>
                                    <td class="py-3 text-right font-semibold @(tx.Points > 0 ? "text-green-600" : "text-red-500")">
                                        @(tx.Points > 0 ? $"+{tx.Points}" : tx.Points.ToString())
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    static string MapTransactionType(string type) => type switch
    {
        "Purchase" => "Alisveris",
        "Welcome" => "Hos Geldin",
        "Review" => "Yorum",
        "Referral" => "Referans",
        "Redemption" => "Kullanim",
        _ => type
    };
}
