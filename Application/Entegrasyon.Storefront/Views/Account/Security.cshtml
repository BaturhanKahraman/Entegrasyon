@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var loginHistory = ViewBag.LoginHistory as List<Entegrasyon.Entity.Storefront.StorefrontLoginHistory> ?? new();
}

@section Head {
    <seo-meta title="Guvenlik | @Tenant.Settings.StoreName" />
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        @await Html.PartialAsync("_AccountSidebar", "Security")
    </aside>
    <div class="flex-1">
        <div class="bg-white rounded-lg shadow p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Guvenlik</h1>

            @* KVKK Data Export *@
            <div class="mb-8 p-4 border border-gray-200 rounded-lg">
                <h2 class="text-lg font-semibold text-gray-900 mb-2">KVKK Veri Indirme</h2>
                <p class="text-sm text-gray-600 mb-3">
                    KVKK kapsaminda kisisel verilerinizin bir kopyasini JSON formatinda indirebilirsiniz.
                </p>
                <a href="/hesabim/veri-indir" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-800 text-white text-sm font-medium rounded-lg hover:bg-gray-700 transition-colors no-underline">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                    Verilerimi Indir
                </a>
            </div>

            @* Login History *@
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Oturum Gecmisi</h2>

            @if (loginHistory.Count == 0)
            {
                <p class="text-gray-500 text-sm">Henuz oturum gecmisi bulunmuyor.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-200 text-left text-gray-500">
                                <th class="pb-3 pr-4 font-medium">Tarih</th>
                                <th class="pb-3 pr-4 font-medium">IP Adresi</th>
                                <th class="pb-3 pr-4 font-medium">Cihaz</th>
                                <th class="pb-3 font-medium">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in loginHistory)
                            {
                                <tr class="border-b border-gray-100">
                                    <td class="py-3 pr-4 text-gray-900">@entry.LoginAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="py-3 pr-4 text-gray-600">@MaskIpAddress(entry.IpAddress)</td>
                                    <td class="py-3 pr-4 text-gray-600">@(entry.DeviceType ?? "Bilinmiyor")</td>
                                    <td class="py-3">
                                        @if (entry.IsSuccessful)
                                        {
                                            <span class="inline-flex items-center gap-1 text-green-600">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                </svg>
                                                Basarili
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 text-red-500">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                                </svg>
                                                Basarisiz
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    static string MaskIpAddress(string? ip)
    {
        if (string.IsNullOrEmpty(ip)) return "Bilinmiyor";
        var parts = ip.Split('.');
        if (parts.Length == 4)
            return $"{parts[0]}.{parts[1]}.x.x";
        // IPv6 or other — mask last segments
        if (ip.Contains(':'))
        {
            var segments = ip.Split(':');
            if (segments.Length >= 4)
                return string.Join(":", segments.Take(2)) + ":x:x";
        }
        return ip;
    }
}
