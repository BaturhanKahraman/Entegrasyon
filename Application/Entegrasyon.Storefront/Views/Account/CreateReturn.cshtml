@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Iade Talebi | @Tenant.Settings.StoreName" />
}

@{
    var orderId = ViewBag.OrderId as Guid?;
    var orderNumber = ViewBag.OrderNumber as string;
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        <nav class="bg-white rounded-lg shadow p-4 space-y-1">
            <a href="/hesabim" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Hesap Ozeti</a>
            <a href="/hesabim/Profile" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Profilim</a>
            <a href="/hesabim/Orders" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Siparislerim</a>
            <a href="/hesabim/iadelerim" class="block px-3 py-2 rounded bg-gray-50 font-medium text-primary no-underline">Iadelerim</a>
            <a href="/hesabim/Addresses" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Adreslerim</a>
            <a href="/hesabim/ChangePassword" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Sifre Degistir</a>
            <a href="/cikis" class="block px-3 py-2 rounded text-red-600 hover:bg-red-50 no-underline">Cikis Yap</a>
        </nav>
    </aside>
    <div class="flex-1 space-y-6">
        @if (TempData["Error"] is string error)
        {
            <div class="bg-red-50 text-red-700 p-3 rounded">@error</div>
        }

        <div class="bg-white rounded-lg shadow p-6">
            <a href="/hesabim/Orders" class="text-sm text-gray-500 hover:text-gray-700 no-underline">&larr; Siparislere Don</a>
            <h1 class="text-xl font-bold text-gray-900 mt-2 mb-6">Iade Talebi Olustur</h1>

            @if (!string.IsNullOrWhiteSpace(orderNumber))
            {
                <p class="text-sm text-gray-600 mb-4">Siparis No: <strong>@orderNumber</strong></p>
            }

            <form method="post" action="/hesabim/iade-talebi/@orderId" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label for="reason" class="block text-sm font-medium text-gray-700 mb-1">Iade Nedeni *</label>
                    <select name="reason" id="reason" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                        <option value="">Seciniz...</option>
                        <option value="Urun kusurlu">Urun kusurlu</option>
                        <option value="Yanlis urun">Yanlis urun</option>
                        <option value="Beden uymuyor">Beden uymuyor</option>
                        <option value="Begenmedim">Begenmedim</option>
                        <option value="Diger">Diger</option>
                    </select>
                </div>

                <div>
                    <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Aciklama</label>
                    <textarea name="description" id="description" rows="4" maxlength="2000"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                              placeholder="Iade nedeninizi detayli aciklayabilirsiniz..."></textarea>
                </div>

                <button type="submit" class="btn-primary px-6 py-2">Iade Talebi Gonder</button>
            </form>
        </div>
    </div>
</div>
