@{
    ViewData["Title"] = "Siparişlerim";

    var customerName = ViewBag.CustomerName as string ?? "Ayşe Yılmaz";
    var initials = string.Concat(customerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">

    <!-- mobile account trigger -->
    <button type="button" data-acc-open class="lg:hidden w-full mb-5 flex items-center justify-between bg-white border border-cream-300 rounded-2xl px-5 py-3.5">
        <span class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-primary/15 text-primary flex items-center justify-center font-semibold text-sm">@initials</span>
            <span class="font-medium text-charcoal">Hesabım</span>
        </span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>

    <div class="lg:grid lg:grid-cols-[18rem_1fr] lg:gap-8">
        <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
            <partial name="_AccountSidebar" model='@("orders")' />
        </aside>

        <div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <h1 class="font-heading text-3xl text-charcoal">Siparişlerim</h1>
                <div class="relative sm:w-64">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" class="absolute left-4 top-1/2 -translate-y-1/2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" data-order-search placeholder="Sipariş no ara…" class="w-full pl-11 pr-4 py-2.5 rounded-full border border-cream-300 text-sm outline-none focus:border-primary" />
                </div>
            </div>

            <div id="orderFilters" class="flex gap-2 overflow-x-auto no-scrollbar pb-1 mb-6"></div>

            <div id="orderList" class="space-y-4"></div>

            <div id="ordersEmpty" class="hidden bg-cream rounded-3xl py-16 px-6 text-center">
                <svg viewBox="0 0 64 64" width="72" height="72" class="mx-auto mb-4" fill="none" stroke="#FF8FB1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20h32l-3 30a4 4 0 0 1-4 3.5H23a4 4 0 0 1-4-3.5Z"/><path d="M24 20a8 8 0 0 1 16 0"/><circle cx="26" cy="34" r="1.5" fill="#FF8FB1"/><circle cx="38" cy="34" r="1.5" fill="#FF8FB1"/><path d="M27 42c1.5 1.2 3.2 1.8 5 1.8s3.5-.6 5-1.8"/></svg>
                <h3 class="font-heading text-2xl text-charcoal">Bu durumda sipariş yok</h3>
                <p class="text-muted mt-2">Farklı bir filtre seçmeyi deneyin.</p>
                <a href="/kategori" class="inline-block mt-5 px-6 py-3 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition">Alışverişe Başla</a>
            </div>

            <nav id="ordersPager" class="mt-8 flex items-center justify-center gap-2">
                <button type="button" disabled class="px-4 h-10 rounded-full border border-cream-300 text-sm text-charcoal opacity-50 cursor-not-allowed">‹ Önceki</button>
                <button type="button" class="w-10 h-10 rounded-full bg-primary text-white font-semibold" aria-current="page">1</button>
                <button type="button" data-toast="Sayfa 2" class="w-10 h-10 rounded-full border border-cream-300 hover:bg-cream transition">2</button>
                <button type="button" data-toast="Sayfa 2" class="px-4 h-10 rounded-full border border-cream-300 text-sm text-charcoal hover:bg-cream transition">Sonraki ›</button>
            </nav>
        </div>
    </div>
</div>

<!-- mobile account sheet -->
<div id="accSheet" class="hidden fixed inset-0 z-[55] lg:hidden">
    <div data-acc-close class="absolute inset-0 bg-charcoal/40"></div>
    <div class="absolute bottom-0 inset-x-0 max-h-[85vh] overflow-y-auto bg-white rounded-t-3xl p-5">
        <div class="flex items-center justify-between mb-3">
            <span class="font-semibold text-charcoal">Hesabım</span>
            <button type="button" data-acc-close aria-label="Kapat" class="p-2 -mr-2 text-charcoal/50 hover:text-charcoal"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <partial name="_AccountSidebar" model='@("orders")' />
    </div>
</div>

@section Scripts {
    <script src="~/js/siparislerim.js" asp-append-version="true"></script>
}
