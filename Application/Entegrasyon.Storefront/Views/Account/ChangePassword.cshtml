@{
    ViewData["Title"] = "Şifre Değiştir";
    var error = ViewBag.Error as string ?? TempData["PasswordError"] as string;
    var success = (ViewBag.Success is bool ok && ok) || TempData["PasswordSuccess"] is not null;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">
    <div class="lg:grid lg:grid-cols-[18rem_1fr] lg:gap-8">

        @* ---- SIDEBAR ---- *@
        <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
            <partial name="_AccountSidebar" />
        </aside>
        <details class="lg:hidden mb-5 bg-white border border-cream-300 rounded-2xl">
            <summary class="flex items-center justify-between px-5 py-3.5 cursor-pointer list-none">
                <span class="font-medium text-charcoal">Hesabım Menüsü</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="px-3 pb-3">
                <partial name="_AccountSidebar" />
            </div>
        </details>

        @* ---- MAIN ---- *@
        <div>
            <div class="max-w-lg mx-auto">
                <div class="mb-7">
                    <h1 class="font-heading text-3xl text-charcoal">Şifre Değiştir</h1>
                    <p class="text-muted mt-1.5 text-sm">Güvenliğiniz için güçlü ve benzersiz bir şifre seçin.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="mb-5 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3" role="alert">
                        @error
                    </div>
                }
                @if (success)
                {
                    <div class="mb-5 rounded-2xl bg-success/10 border border-success/30 text-success text-sm px-4 py-3" role="status">
                        Şifreniz başarıyla güncellendi.
                    </div>
                }

                <form asp-controller="Account" asp-action="ChangePassword" method="post" class="rounded-2xl border border-cream-300 p-6 space-y-5" data-pw-form>
                    <div>
                        <label for="CurrentPassword" class="block text-sm font-medium text-charcoal mb-1.5">Mevcut şifre</label>
                        <div class="relative">
                            <input id="CurrentPassword" name="CurrentPassword" type="password" required autocomplete="current-password" placeholder="••••••••" class="w-full px-3 py-2.5 pr-11 rounded-xl border border-cream-300 text-sm outline-none focus:border-primary" />
                            <button type="button" data-toggle-pw="CurrentPassword" aria-label="Şifreyi göster" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                        </div>
                    </div>

                    <div>
                        <label for="NewPassword" class="block text-sm font-medium text-charcoal mb-1.5">Yeni şifre</label>
                        <div class="relative">
                            <input id="NewPassword" name="NewPassword" type="password" required autocomplete="new-password" placeholder="••••••••" data-pw-strength class="w-full px-3 py-2.5 pr-11 rounded-xl border border-cream-300 text-sm outline-none focus:border-primary" />
                            <button type="button" data-toggle-pw="NewPassword" aria-label="Şifreyi göster" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                        </div>
                        <div class="flex gap-1.5 mt-2.5" aria-hidden="true">
                            <span class="strbar flex-1 h-1.5 rounded-full bg-cream-300"></span>
                            <span class="strbar flex-1 h-1.5 rounded-full bg-cream-300"></span>
                            <span class="strbar flex-1 h-1.5 rounded-full bg-cream-300"></span>
                        </div>
                        <ul class="mt-3 space-y-1.5 text-sm">
                            <li id="r-len" class="flex items-center gap-2 text-muted"><span class="rdot w-4 h-4 rounded-full border-[1.5px] border-current inline-flex items-center justify-center text-[11px] leading-none font-bold shrink-0"></span> En az 8 karakter</li>
                            <li id="r-upper" class="flex items-center gap-2 text-muted"><span class="rdot w-4 h-4 rounded-full border-[1.5px] border-current inline-flex items-center justify-center text-[11px] leading-none font-bold shrink-0"></span> Bir büyük harf</li>
                            <li id="r-num" class="flex items-center gap-2 text-muted"><span class="rdot w-4 h-4 rounded-full border-[1.5px] border-current inline-flex items-center justify-center text-[11px] leading-none font-bold shrink-0"></span> Bir rakam</li>
                            <li id="r-special" class="flex items-center gap-2 text-muted"><span class="rdot w-4 h-4 rounded-full border-[1.5px] border-current inline-flex items-center justify-center text-[11px] leading-none font-bold shrink-0"></span> Bir özel karakter (!?@@#)</li>
                        </ul>
                    </div>

                    <div>
                        <label for="ConfirmPassword" class="block text-sm font-medium text-charcoal mb-1.5">Yeni şifre (tekrar)</label>
                        <div class="relative">
                            <input id="ConfirmPassword" name="ConfirmPassword" type="password" required autocomplete="new-password" placeholder="••••••••" data-pw-match class="w-full px-3 py-2.5 pr-11 rounded-xl border border-cream-300 text-sm outline-none focus:border-primary" />
                            <button type="button" data-toggle-pw="ConfirmPassword" aria-label="Şifreyi göster" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                        </div>
                        <p id="matchMsg" class="hidden text-xs mt-1.5"></p>
                    </div>

                    <div class="flex flex-wrap gap-3 pt-1">
                        <button type="submit" class="px-7 py-3 rounded-full bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition">Şifreyi Güncelle</button>
                        <a href="/hesabim/guvenlik" class="px-7 py-3 rounded-full border border-cream-300 text-sm font-semibold text-charcoal hover:bg-cream transition">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Şifre-Değiştir.js" asp-append-version="true"></script>
}
