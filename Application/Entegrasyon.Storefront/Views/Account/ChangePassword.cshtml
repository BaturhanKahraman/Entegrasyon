@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Sifre Degistir | @Tenant.Settings.StoreName" />
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        <nav class="bg-white rounded-lg shadow p-4 space-y-1">
            <a href="/hesabim" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Hesap Ozeti</a>
            <a href="/hesabim/Profile" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Profilim</a>
            <a href="/hesabim/Orders" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Siparislerim</a>
            <a href="/hesabim/Addresses" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Adreslerim</a>
            <a href="/hesabim/ChangePassword" class="block px-3 py-2 rounded bg-gray-50 font-medium text-primary no-underline">Sifre Degistir</a>
            <a href="/cikis" class="block px-3 py-2 rounded text-red-600 hover:bg-red-50 no-underline">Cikis Yap</a>
        </nav>
    </aside>
    <div class="flex-1">
        <div class="bg-white rounded-lg shadow p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Sifre Degistir</h1>

            @if (ViewBag.Success == true)
            {
                <div class="bg-green-50 text-green-700 text-sm rounded-lg p-3 mb-4">
                    Sifreniz basariyla degistirildi.
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="bg-red-50 text-red-700 text-sm rounded-lg p-3 mb-4">
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-antiforgery="true" class="space-y-4 max-w-lg">
                <div>
                    <label for="currentPassword" class="block text-sm font-medium text-gray-700 mb-1">Mevcut Sifre</label>
                    <input type="password" id="currentPassword" name="currentPassword" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>

                <div>
                    <label for="newPassword" class="block text-sm font-medium text-gray-700 mb-1">Yeni Sifre</label>
                    <input type="password" id="newPassword" name="newPassword" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                           placeholder="En az 6 karakter" />
                </div>

                <div>
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Yeni Sifre Tekrar</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                           placeholder="Yeni sifrenizi tekrar girin" />
                </div>

                <button type="submit" class="btn-primary">Sifreyi Degistir</button>
            </form>
        </div>
    </div>
</div>
