@{
    ViewData["Title"] = "İadelerim";

    var customerName = ViewBag.CustomerName as string ?? "Ayşe Yılmaz";
    var initials = string.Concat(customerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10">

    <!-- mobile account trigger -->
    <button type="button" data-acc-open class="lg:hidden w-full mb-5 flex items-center justify-between bg-white border border-cream-300 rounded-2xl px-5 py-3.5">
        <span class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-primary/15 text-primary flex items-center justify-center font-semibold text-sm">@initials</span>
            <span class="font-medium text-charcoal">Hesabım</span>
        </span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>

    <div class="lg:grid lg:grid-cols-[18rem_1fr] lg:gap-8">
        <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
            <partial name="_AccountSidebar" model='@("returns")' />
        </aside>

        <div>
            <!-- header row -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <div>
                    <h1 class="font-heading text-3xl text-charcoal">İadelerim</h1>
                    <p class="text-muted mt-1.5 text-sm">İade taleplerinizi takip edin ve durumlarını görün.</p>
                </div>
                <a href="/hesabim/iade-olustur" class="shrink-0 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border border-primary text-primary text-sm font-semibold hover:bg-primary/5 transition">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    Yeni İade
                </a>
            </div>

            <!-- filters -->
            <div data-return-filters class="flex gap-2 overflow-x-auto no-scrollbar pb-1 mb-6"></div>

            <!-- list -->
            <div data-return-list class="space-y-4"></div>

            <!-- empty -->
            <div data-returns-empty class="hidden grid md:grid-cols-[1.4fr_1fr] gap-5 items-stretch">
                <div class="bg-cream rounded-3xl py-14 px-6 text-center flex flex-col items-center justify-center">
                    <svg viewBox="0 0 24 24" width="64" height="64" class="mb-4" fill="none" stroke="#FF8FB1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                    <h3 class="font-heading text-2xl text-charcoal">Henüz iade talebiniz yok</h3>
                    <p class="text-muted mt-2 max-w-xs">Teslim aldığınız ürünleri 30 gün içinde ücretsiz iade edebilirsiniz.</p>
                    <a href="/hesabim/siparislerim" class="inline-block mt-5 px-6 py-3 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition">Siparişlerime Git</a>
                </div>
                <div class="bg-white border border-cream-300 rounded-3xl p-6">
                    <h4 class="font-heading text-xl text-charcoal mb-4">İade nasıl çalışır?</h4>
                    <ol class="space-y-4">
                        <li class="flex gap-3">
                            <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold shrink-0">1</span>
                            <p class="text-sm text-charcoal leading-relaxed"><span class="font-medium">Talep oluşturun.</span> Ürün ve sebebi seçin.</p>
                        </li>
                        <li class="flex gap-3">
                            <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold shrink-0">2</span>
                            <p class="text-sm text-charcoal leading-relaxed"><span class="font-medium">Kargoya verin.</span> Ücretsiz kargo kodu e-postanıza gelir.</p>
                        </li>
                        <li class="flex gap-3">
                            <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold shrink-0">3</span>
                            <p class="text-sm text-charcoal leading-relaxed"><span class="font-medium">İadenizi alın.</span> Onaydan sonra 3–5 iş günü içinde ücret iadesi yapılır.</p>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- mobile account sheet -->
<div id="accSheet" class="hidden fixed inset-0 z-[55] lg:hidden">
    <div data-acc-close class="absolute inset-0 bg-charcoal/40"></div>
    <div class="absolute bottom-0 inset-x-0 max-h-[85vh] overflow-y-auto bg-white rounded-t-3xl p-5">
        <div class="flex items-center justify-between mb-3">
            <span class="font-semibold text-charcoal">Hesabım</span>
            <button type="button" data-acc-close aria-label="Kapat" class="p-2 -mr-2 text-charcoal/50 hover:text-charcoal"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <partial name="_AccountSidebar" model='@("returns")' />
    </div>
</div>

@section Scripts {
    <script src="~/js/iadelerim.js" asp-append-version="true"></script>
}
