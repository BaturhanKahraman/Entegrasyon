@using Entegrasyon.Entity.Storefront
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Iadelerim | @Tenant.Settings.StoreName" />
}

@{
    var returns = ViewBag.Returns as List<StorefrontReturnRequest> ?? new List<StorefrontReturnRequest>();
}

<div class="flex flex-col md:flex-row gap-8 max-w-6xl mx-auto px-4 py-8">
    <aside class="w-full md:w-64 shrink-0">
        <nav class="bg-white rounded-lg shadow p-4 space-y-1">
            <a href="/hesabim" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Hesap Ozeti</a>
            <a href="/hesabim/Profile" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Profilim</a>
            <a href="/hesabim/Orders" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Siparişlerim</a>
            <a href="/hesabim/iadelerim" class="block px-3 py-2 rounded bg-gray-50 font-medium text-primary no-underline">Iadelerim</a>
            <a href="/hesabim/Addresses" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Adreslerim</a>
            <a href="/hesabim/ChangePassword" class="block px-3 py-2 rounded hover:bg-gray-50 text-gray-700 no-underline">Sifre Degistir</a>
            <a href="/cikis" class="block px-3 py-2 rounded text-red-600 hover:bg-red-50 no-underline">Cikis Yap</a>
        </nav>
    </aside>
    <div class="flex-1 space-y-6">
        @if (TempData["Success"] is string success)
        {
            <div class="bg-green-50 text-green-700 p-3 rounded">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="bg-red-50 text-red-700 p-3 rounded">@error</div>
        }

        <div class="bg-white rounded-lg shadow p-6">
            <h1 class="text-xl font-bold text-gray-900 mb-6">Iade Taleplerim</h1>

            @if (returns.Count == 0)
            {
                <p class="text-gray-500">Henuz bir iade talebiniz bulunmamaktadir.</p>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var ret in returns)
                    {
                        var statusBadge = ret.Status switch
                        {
                            ReturnStatus.Pending => "bg-yellow-100 text-yellow-700",
                            ReturnStatus.Approved => "bg-green-100 text-green-700",
                            ReturnStatus.Rejected => "bg-red-100 text-red-700",
                            ReturnStatus.Completed => "bg-blue-100 text-blue-700",
                            _ => "bg-gray-100 text-gray-700"
                        };
                        var statusText = ret.Status switch
                        {
                            ReturnStatus.Pending => "Beklemede",
                            ReturnStatus.Approved => "Onaylandi",
                            ReturnStatus.Rejected => "Reddedildi",
                            ReturnStatus.Completed => "Tamamlandi",
                            _ => "Bilinmiyor"
                        };
                        <div class="border border-gray-200 rounded-lg p-4">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
                                <div>
                                    <p class="text-sm text-gray-500">Sipariş: <a href="/hesabim/Sipariş/@ret.OrderId" class="text-primary hover:underline no-underline">@ret.OrderId.ToString()[..8]...</a></p>
                                    <p class="text-sm text-gray-500">Tarih: @ret.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                </div>
                                <span class="inline-block px-3 py-1 rounded-full text-sm font-medium @statusBadge">@statusText</span>
                            </div>
                            <p class="text-sm"><span class="font-medium">Neden:</span> @ret.Reason</p>
                            @if (!string.IsNullOrWhiteSpace(ret.Description))
                            {
                                <p class="text-sm text-gray-600 mt-1">@ret.Description</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(ret.ReviewNote))
                            {
                                <div class="mt-2 pl-3 border-l-2 border-primary">
                                    <p class="text-sm text-gray-600"><span class="font-medium">Yanit:</span> @ret.ReviewNote</p>
                                </div>
                            }
                            @if (ret.RefundAmount.HasValue)
                            {
                                <p class="text-sm font-medium text-green-600 mt-1">Iade Tutari: @ret.RefundAmount.Value.ToString("N2") TL</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
