@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var twoFactorEnabled = (bool)(ViewBag.TwoFactorEnabled ?? false);
    var qrCodeUri = ViewBag.QrCodeUri as string;
    var showVerification = (bool)(ViewBag.ShowVerification ?? false);
    var recoveryCodes = ViewBag.RecoveryCodes as List<string>;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-64 flex-shrink-0">
            @await Html.PartialAsync("_AccountSidebar", "TwoFactorSetup")
        </div>

        <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900 mb-6">Iki Faktorlu Dogrulama (2FA)</h1>

            @if (TempData["Success"] is string successMsg)
            {
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4">@successMsg</div>
            }
            @if (TempData["Error"] is string errorMsg)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4">@errorMsg</div>
            }

            @if (recoveryCodes is not null && recoveryCodes.Count > 0)
            {
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-6">
                    <h3 class="text-lg font-bold text-yellow-800 mb-2">Kurtarma Kodlari</h3>
                    <p class="text-sm text-yellow-700 mb-4">Bu kodlari guvenli bir yerde saklayin. Her kod yalnizca bir kez kullanilabilir.</p>
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var code in recoveryCodes)
                        {
                            <code class="bg-white px-3 py-2 rounded border text-center font-mono text-sm">@code</code>
                        }
                    </div>
                </div>
            }

            <div class="bg-white rounded-lg border border-gray-200 p-6">
                @if (twoFactorEnabled)
                {
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">2FA Aktif</h3>
                            <p class="text-sm text-gray-500">Hesabiniz iki faktorlu dogrulama ile korunuyor.</p>
                        </div>
                    </div>

                    <form method="post" action="/hesabim/guvenlik/2fa/devre-disi" class="mt-4">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Devre disi birakmak icin dogrulama kodu</label>
                            <input type="text" name="code" maxlength="6" pattern="[0-9]{6}" inputmode="numeric"
                                   class="w-full max-w-xs px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                        </div>
                        <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg text-sm hover:bg-red-700">Devre Disi Birak</button>
                    </form>
                }
                else if (showVerification && !string.IsNullOrEmpty(qrCodeUri))
                {
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">QR Kodu Tarayin</h3>
                    <p class="text-sm text-gray-500 mb-4">Google Authenticator veya benzeri bir uygulama ile asagidaki QR kodu tarayin, ardindan dogrulama kodunu girin.</p>

                    <div class="flex flex-col items-center gap-4 mb-6">
                        <div class="bg-white p-4 border rounded-lg" id="qrcode"></div>
                        <p class="text-xs text-gray-400 break-all max-w-sm text-center">@qrCodeUri</p>
                    </div>

                    <form method="post" action="/hesabim/guvenlik/2fa/dogrula">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-1">6 Haneli Dogrulama Kodu</label>
                            <input type="text" name="code" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autofocus
                                   class="w-full max-w-xs px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                        </div>
                        <button type="submit" class="btn-primary px-6 py-2">Etkinlestir</button>
                    </form>

                    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
                    <script>
                        new QRCode(document.getElementById("qrcode"), {
                            text: "@Html.Raw(qrCodeUri)",
                            width: 200,
                            height: 200
                        });
                    </script>
                }
                else
                {
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">2FA Pasif</h3>
                            <p class="text-sm text-gray-500">Hesabinizi daha guvenli hale getirmek icin iki faktorlu dogrulamayi etkinlestirin.</p>
                        </div>
                    </div>

                    <form method="post" action="/hesabim/guvenlik/2fa/etkinlestir" class="mt-4">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary px-6 py-2">2FA Etkinlestir</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
