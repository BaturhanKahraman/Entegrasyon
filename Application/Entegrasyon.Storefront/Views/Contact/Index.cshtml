@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    ViewData["Title"] = "Bize Ulaşın";
    var settings = Tenant.Settings;
    var success = ViewBag.Success is true;
    var message = ViewBag.Message as string;
    var wa = settings.WhatsAppNumber?.Replace(" ", string.Empty).TrimStart('+');
    var addressLine = string.IsNullOrWhiteSpace(settings.District) ? settings.City : $"{settings.District}, {settings.City}";
    var mapQuery = Uri.EscapeDataString(string.IsNullOrWhiteSpace(addressLine) ? "İstanbul" : addressLine);
}

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

    <nav aria-label="breadcrumb" class="text-sm text-muted mb-5 flex items-center gap-2">
        <a href="/" class="hover:text-primary transition">Anasayfa</a>
        <span class="text-cream-300">›</span>
        <span class="text-charcoal font-medium">İletişim</span>
    </nav>

    <header class="mb-9 max-w-2xl">
        <h1 class="font-heading text-4xl sm:text-5xl text-charcoal">Bize Ulaşın</h1>
        <p class="text-muted mt-3 leading-relaxed">Sorularınız, önerileriniz ya da siparişinizle ilgili her konuda buradayız. Formu doldurun ya da aşağıdaki kanallardan dilediğinizle yazın — hafta içi en geç bir iş günü içinde dönüyoruz.</p>
    </header>

    @if (success)
    {
        <div class="mb-8 flex items-start gap-3 bg-success/10 border border-success/30 rounded-2xl px-5 py-4">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#4CAF89" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
            <div>
                <p class="font-semibold text-charcoal">Mesajınız bize ulaştı!</p>
                <p class="text-sm text-muted mt-0.5">@(message ?? "En kısa sürede e-posta adresinize dönüş yapacağız. Teşekkürler.")</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mb-8 rounded-2xl bg-danger/10 border border-danger/30 text-danger px-5 py-4" role="alert">@message</div>
    }

    <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-start">

        @* LEFT: form *@
        <div class="bg-white border border-cream-300 rounded-2xl p-6 sm:p-8 shadow-sm">
            <h2 class="font-heading text-2xl text-charcoal mb-1">Mesaj Gönderin</h2>
            <p class="text-sm text-muted mb-6">Tüm alanları doldurmanız bize daha hızlı yardımcı olmamızı sağlar.</p>

            <form asp-controller="Contact" asp-action="Index" method="post">
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-charcoal mb-1.5" for="cName">Ad Soyad</label>
                        <input id="cName" name="name" type="text" required placeholder="Adınız Soyadınız" class="w-full px-3.5 py-2.5 rounded-xl border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-charcoal mb-1.5" for="cEmail">E-posta</label>
                        <input id="cEmail" name="email" type="email" required placeholder="ornek@@eposta.com" class="w-full px-3.5 py-2.5 rounded-xl border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4 mt-4">
                    <div>
                        <label class="block text-sm font-semibold text-charcoal mb-1.5" for="cPhone">Telefon <span class="text-muted font-normal">(opsiyonel)</span></label>
                        <input id="cPhone" name="phone" type="tel" data-mask-phone inputmode="numeric" placeholder="0 (5__) ___ __ __" class="w-full px-3.5 py-2.5 rounded-xl border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-charcoal mb-1.5" for="cSubject">Konu</label>
                        <div class="relative">
                            <select id="cSubject" name="subject" required class="w-full appearance-none px-3.5 pr-10 py-2.5 rounded-xl border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition cursor-pointer bg-white">
                                <option value="" disabled selected>Bir konu seçin…</option>
                                <option>Sipariş Sorusu</option>
                                <option>İade</option>
                                <option>Ürün Önerisi</option>
                                <option>Kurumsal</option>
                                <option>Diğer</option>
                            </select>
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#7B8794" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="block text-sm font-semibold text-charcoal mb-1.5" for="cMessage">Mesajınız</label>
                    <textarea id="cMessage" name="message" rows="5" maxlength="1000" required placeholder="Size nasıl yardımcı olabiliriz?" class="w-full px-3.5 py-2.5 rounded-xl border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition resize-none" data-char-count="msgCount"></textarea>
                    <p class="text-right text-xs text-muted mt-1.5"><span id="msgCount">0</span> / 1000</p>
                </div>

                <label class="flex items-start gap-3 mt-3 cursor-pointer">
                    <input type="checkbox" required class="w-4 h-4 mt-0.5 rounded border-cream-300 accent-[#FF8FB1] shrink-0" />
                    <span class="text-sm text-muted leading-relaxed"><a href="/sayfa/kvkk" class="text-primary hover:underline font-medium">KVKK Aydınlatma Metni</a>'ni okudum, kişisel verilerimin iletişim amacıyla işlenmesini onaylıyorum.</span>
                </label>

                <button type="submit" class="mt-6 w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition flex items-center justify-center gap-2">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
                    Gönder
                </button>
            </form>
        </div>

        @* RIGHT: info cards *@
        <div class="space-y-4">
            @if (!string.IsNullOrWhiteSpace(settings.ContactPhone))
            {
                <div class="bg-white border border-cream-300 rounded-2xl p-6 flex items-start gap-4">
                    <span class="w-12 h-12 rounded-2xl bg-primary/15 text-primary flex items-center justify-center shrink-0" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z"/></svg></span>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-muted">Telefon</p>
                        <a href="tel:@settings.ContactPhone.Replace(" ", string.Empty)" class="block font-heading text-xl text-charcoal mt-0.5 hover:text-primary transition">@settings.ContactPhone</a>
                        <p class="text-sm text-muted mt-0.5">Hafta içi 09:00 – 18:00</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(wa))
            {
                <div class="bg-success/10 border border-success/20 rounded-2xl p-6 flex items-start gap-4">
                    <span class="w-12 h-12 rounded-2xl bg-success/20 text-success flex items-center justify-center shrink-0" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg></span>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-success">WhatsApp</p>
                        <p class="font-heading text-xl text-charcoal mt-0.5">Anlık destek</p>
                        <a href="https://wa.me/@wa" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-semibold text-success mt-2 hover:gap-2.5 transition-all">
                            WhatsApp'ta yaz
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        </a>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(settings.ContactEmail))
            {
                <div class="bg-white border border-cream-300 rounded-2xl p-6 flex items-start gap-4">
                    <span class="w-12 h-12 rounded-2xl bg-secondary/20 text-secondary flex items-center justify-center shrink-0" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></span>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-muted">E-posta</p>
                        <a href="mailto:@settings.ContactEmail" class="block font-heading text-xl text-charcoal mt-0.5 hover:text-primary transition break-all">@settings.ContactEmail</a>
                        <p class="text-sm text-muted mt-0.5">24 saat içinde yanıt</p>
                    </div>
                </div>
            }

            <div class="bg-white border border-cream-300 rounded-2xl p-6">
                <div class="flex items-start gap-4">
                    <span class="w-12 h-12 rounded-2xl bg-accent/25 text-warning flex items-center justify-center shrink-0" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></span>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-muted">Adres</p>
                        <p class="font-medium text-charcoal mt-0.5 leading-relaxed">@(string.IsNullOrWhiteSpace(addressLine) ? "Mağaza adresi yakında." : addressLine)</p>
                    </div>
                </div>
                <div class="mt-5 aspect-[16/9] rounded-2xl overflow-hidden border border-cream-300">
                    <iframe title="Konum" src="https://www.google.com/maps?q=@mapQuery&output=embed" width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/contact.js" asp-append-version="true"></script>
}
