@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="@ViewBag.SeoTitle" />
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Iletisim</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        @* Contact Form *@
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow p-6">
                @if (ViewBag.Success == true)
                {
                    <div class="bg-green-50 border border-green-200 text-green-700 p-4 rounded-lg mb-6">
                        @ViewBag.Message
                    </div>
                }
                else if (ViewBag.Success == false)
                {
                    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg mb-6">
                        @ViewBag.Message
                    </div>
                }

                <form method="post" action="/iletisim">
                    @Html.AntiForgeryToken()
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Ad Soyad *</label>
                            <input type="text" id="name" name="name" required
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">E-posta *</label>
                            <input type="email" id="email" name="email" required
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Telefon</label>
                            <input type="tel" id="phone" name="phone"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                        </div>
                        <div>
                            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Konu</label>
                            <input type="text" id="subject" name="subject"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Mesajiniz *</label>
                        <textarea id="message" name="message" rows="5" required
                                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"></textarea>
                    </div>
                    <button type="submit" class="btn-primary px-6 py-3">Mesaj Gonder</button>
                </form>
            </div>
        </div>

        @* Store Info Sidebar *@
        <div>
            <div class="bg-white rounded-lg shadow p-6 space-y-6">
                <div>
                    <h3 class="font-semibold text-gray-900 mb-2">Adres</h3>
                    @if (!string.IsNullOrWhiteSpace(Tenant.Settings.Address))
                    {
                        <p class="text-sm text-gray-600">@Tenant.Settings.Address, @Tenant.Settings.City</p>
                    }
                    else
                    {
                        <p class="text-sm text-gray-400">Adres bilgisi girilmemis.</p>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Tenant.Settings.ContactPhone))
                {
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-2">Telefon</h3>
                        <p class="text-sm text-gray-600">
                            <a href="tel:@Tenant.Settings.ContactPhone" class="text-primary hover:underline">@Tenant.Settings.ContactPhone</a>
                        </p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Tenant.Settings.ContactEmail))
                {
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-2">E-posta</h3>
                        <p class="text-sm text-gray-600">
                            <a href="mailto:@Tenant.Settings.ContactEmail" class="text-primary hover:underline">@Tenant.Settings.ContactEmail</a>
                        </p>
                    </div>
                }

                <div>
                    <h3 class="font-semibold text-gray-900 mb-2">Harita</h3>
                    <div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center text-gray-400 text-sm">
                        Harita yaklasimda
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
