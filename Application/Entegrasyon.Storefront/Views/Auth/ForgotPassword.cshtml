@{
    ViewData["Title"] = "Şifremi Unuttum";
    var success = ViewBag.Success is true;
}

<div class="card-bg min-h-[70vh] flex items-center justify-center px-5 py-12 sm:py-16">
    <div class="w-full max-w-md">

        @if (!success)
        {
            @* ===== REQUEST STATE ===== *@
            <div class="bg-white border border-cream-300 rounded-3xl shadow-sm py-12 px-8">
                <div class="flex flex-col items-center text-center">
                    <div class="bg-primary/10 rounded-full p-3">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 8.3-8.3"/><path d="m16 5 3 3"/><path d="m18.5 7.5 2-2"/></svg>
                    </div>
                    <h1 class="font-heading text-3xl text-charcoal mt-5">Şifremi Unuttum</h1>
                    <p class="text-muted mt-2 leading-relaxed">E-posta adresinizi girin, size sıfırlama bağlantısı gönderelim.</p>
                </div>

                <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="mt-8 space-y-4">
                    <div>
                        <label for="email" class="block text-sm font-medium text-charcoal mb-1.5">E-posta</label>
                        <input id="email" name="email" type="email" required autocomplete="email" placeholder="ornek@@eposta.com" class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                    </div>
                    <button type="submit" class="w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">Bağlantı Gönder</button>
                </form>

                <a asp-controller="Auth" asp-action="Login" class="mt-6 flex items-center justify-center gap-1.5 text-sm font-medium text-primary hover:underline">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                    Giriş ekranına dön
                </a>
            </div>
        }
        else
        {
            @* ===== SUCCESS STATE (e-posta numaralandırmayı önlemek için her zaman gösterilir) ===== *@
            <div class="bg-white border border-cream-300 rounded-3xl shadow-sm py-12 px-8">
                <div class="flex flex-col items-center text-center">
                    <div class="bg-success/10 rounded-full p-3">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 6 12 13 2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
                    </div>
                    <h1 class="font-heading text-3xl text-charcoal mt-5">Bağlantı Gönderildi</h1>
                    <p class="text-muted mt-2 leading-relaxed">Girdiğiniz e-posta adresi kayıtlıysa, sıfırlama bağlantısını gönderdik. Gelen kutunuzu kontrol edin.</p>
                    <p class="text-xs text-muted mt-3">E-posta birkaç dakika içinde ulaşmazsa spam klasörünü kontrol edin.</p>
                </div>

                <div class="mt-8 space-y-3">
                    <a asp-controller="Auth" asp-action="ForgotPassword" class="w-full py-3.5 rounded-full bg-white border border-cream-300 text-charcoal font-semibold hover:bg-cream transition flex items-center justify-center">Tekrar gönder</a>
                    <a asp-controller="Auth" asp-action="Login" class="w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm flex items-center justify-center">Giriş ekranına dön</a>
                </div>
            </div>
        }

    </div>
</div>
