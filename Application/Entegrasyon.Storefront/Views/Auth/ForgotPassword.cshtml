@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Sifremi Unuttum | @Tenant.Settings.StoreName" />
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-2xl font-bold text-gray-900 text-center mb-6">Sifremi Unuttum</h1>

        @if (ViewBag.Success == true)
        {
            <div class="bg-green-50 text-green-700 text-sm rounded-lg p-4 mb-4">
                Sifre sifirlama linki email adresinize gonderildi.
            </div>
        }
        else
        {
            <p class="text-sm text-gray-600 text-center mb-6">
                E-posta adresinizi girin, sifre sifirlama linki gonderelim.
            </p>

            <form method="post" asp-antiforgery="true" class="space-y-4">
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">E-posta</label>
                    <input type="email" id="email" name="email" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                           placeholder="ornek@email.com" />
                </div>

                <button type="submit" class="btn-primary w-full">Gonder</button>
            </form>
        }

        <p class="text-center text-sm text-gray-600 mt-6">
            <a href="/giris" class="text-primary hover:underline no-underline">Giris sayfasina don</a>
        </p>
    </div>
</div>
