@{
    ViewData["Title"] = "E-posta Onayı";
    var state = ViewBag.State as string ?? "invalid";
    var message = ViewBag.Message as string;
}

<main class="flex-1 flex items-center justify-center px-5 sm:px-8 py-12 lg:py-16 bg-cream/40">
    <div class="w-full max-w-md mx-auto">

        @if (state == "success")
        {
            <section class="rounded-3xl bg-white border border-cream-300 shadow-sm p-8 sm:p-10 text-center">
                <div class="pop relative w-20 h-20 rounded-full bg-success/15 text-success flex items-center justify-center mx-auto mb-6">
                    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                </div>
                <h1 class="font-heading text-2xl sm:text-3xl text-charcoal">E-posta adresiniz doğrulandı</h1>
                <p class="text-muted mt-3 leading-relaxed">@(message ?? "Hoş geldiniz! Artık hesabınızı kullanabilirsiniz.")</p>
                <a href="/hesabim" class="mt-7 inline-flex w-full items-center justify-center gap-2 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">
                    Hesabıma Git
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
                <p class="mt-5 text-sm text-muted">Hesabınızı kullanmaya hemen başlayabilirsiniz.</p>
            </section>
        }
        else if (state == "expired")
        {
            <section class="rounded-3xl bg-white border border-cream-300 shadow-sm p-8 sm:p-10 text-center">
                <div class="pop relative w-20 h-20 rounded-full bg-warning/15 text-warning flex items-center justify-center mx-auto mb-6">
                    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5"/><path d="M12 16.5h.01"/><circle cx="12" cy="12" r="9"/></svg>
                </div>
                <h1 class="font-heading text-2xl sm:text-3xl text-charcoal">Bu doğrulama bağlantısının süresi doldu</h1>
                <p class="text-muted mt-3 leading-relaxed">@(message ?? "Güvenliğiniz için doğrulama bağlantıları sınırlı bir süre geçerlidir. Aşağıdan yeni bir bağlantı isteyebilirsiniz.")</p>

                @* Yeni doğrulama bağlantısı iste. Token süresi dolduğu için e-posta token'dan
                   çıkarılamaz → kullanıcıdan e-posta alınır. *@
                <form asp-controller="Auth" asp-action="ResendConfirmation" method="post" class="mt-7 space-y-3 text-left">
                    <label for="resend-email" class="block text-sm font-medium text-charcoal">E-posta adresiniz</label>
                    <input id="resend-email" name="email" type="email" required placeholder="ornek@eposta.com" autocomplete="email"
                           class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                        Yeni bağlantı gönder
                    </button>
                </form>
                <p class="mt-5 text-sm text-muted"><a href="/giris" class="text-primary font-medium hover:underline">Giriş ekranına dön</a></p>
            </section>
        }
        else
        {
            <section class="rounded-3xl bg-white border border-cream-300 shadow-sm p-8 sm:p-10 text-center">
                <div class="pop relative w-20 h-20 rounded-full bg-danger/15 text-danger flex items-center justify-center mx-auto mb-6">
                    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 9-6 6M9 9l6 6"/><circle cx="12" cy="12" r="9"/></svg>
                </div>
                <h1 class="font-heading text-2xl sm:text-3xl text-charcoal">Bağlantı geçersiz</h1>
                <p class="text-muted mt-3 leading-relaxed">@(message ?? "Bu doğrulama bağlantısı tanınmadı. Bağlantıyı eksiksiz kopyaladığınızdan emin olun veya yeniden deneyin.")</p>
                <a href="/giris" class="mt-7 inline-flex w-full items-center justify-center gap-2 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
                    Giriş ekranına dön
                </a>
                <p class="mt-5 text-sm text-muted">Sorun devam ederse <a href="/iletisim" class="text-primary font-medium hover:underline">destek ekibimize</a> yazın.</p>
            </section>
        }

        <p class="mt-6 text-center text-sm text-muted">
            Yardıma mı ihtiyacınız var? <a href="/iletisim" class="text-primary font-medium hover:underline">SSS</a> sayfasına göz atın.
        </p>
    </div>
</main>
