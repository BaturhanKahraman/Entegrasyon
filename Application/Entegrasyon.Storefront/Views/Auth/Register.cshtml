@{
    ViewData["Title"] = "Kayıt Ol";
    var returnUrl = ViewBag.ReturnUrl as string ?? Context.Request.Query["returnUrl"].ToString();
    var referralCode = Context.Request.Query["ref"].ToString();
    var registerError = TempData["RegisterError"] as string;
}

<div class="grid lg:grid-cols-2 min-h-[70vh]">

    @* LEFT — illustration *@
    <div class="hidden lg:flex bg-primary/15 p-10 xl:p-14 flex-col">
        <div class="flex-1 flex items-center justify-center">
            <div class="w-full max-w-md">
                <div class="ph aspect-square rounded-3xl overflow-hidden bg-accent/25 shadow-sm">
                    <img class="photo" loading="lazy" alt="Çocuk ve ebeveyn" src="https://images.unsplash.com/photo-1634188157846-c6e3bdf99420?auto=format&fit=crop&w=800&q=80" />
                </div>
                <p class="font-heading italic text-2xl text-charcoal mt-6 text-center">"Aile gibi bir markaya hoş geldiniz."</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2.5 justify-center">
            <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3.5 py-1.5 text-xs font-medium text-charcoal shadow-sm"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#FF8FB1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.3a2 2 0 0 0-.6-1.4L18 9h-4v8h2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>Kargo Bedava</span>
            <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3.5 py-1.5 text-xs font-medium text-charcoal shadow-sm"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#8FCBE8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>30 Gün İade</span>
            <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3.5 py-1.5 text-xs font-medium text-charcoal shadow-sm"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>Güvenli Ödeme</span>
        </div>
    </div>

    @* RIGHT — form *@
    <div class="flex justify-center items-center px-5 sm:px-8 py-10 lg:py-12">
        <div class="w-full max-w-md mx-auto">
            <div class="lg:hidden ph aspect-[16/9] rounded-2xl overflow-hidden bg-accent/25 mb-8">
                <img class="photo" loading="lazy" alt="Çocuk ve ebeveyn" src="https://images.unsplash.com/photo-1634188157846-c6e3bdf99420?auto=format&fit=crop&w=700&q=80" />
            </div>

            <img src="~/img/zekids-logo.png" alt="Zekids" class="h-8 w-auto" />
            <h1 class="font-heading text-3xl text-charcoal mt-6">Aramıza Hoş Geldiniz</h1>
            <p class="text-muted mt-1.5">Hesap oluşturarak hızlı sipariş ve kişisel önerilere erişin.</p>

            @if (!string.IsNullOrWhiteSpace(registerError))
            {
                <div class="mt-5 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3" role="alert">
                    @registerError
                </div>
            }

            <form asp-controller="Auth" asp-action="Register" method="post" class="mt-6 space-y-4" data-register-form>
                @if (!string.IsNullOrWhiteSpace(referralCode))
                {
                    <input type="hidden" name="referralCode" value="@referralCode" />
                }
                <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                        <label for="Name" class="block text-sm font-medium text-charcoal mb-1.5">Ad</label>
                        <input id="Name" name="Name" type="text" required placeholder="Ayşe" autocomplete="given-name" class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                    </div>
                    <div>
                        <label for="Surname" class="block text-sm font-medium text-charcoal mb-1.5">Soyad</label>
                        <input id="Surname" name="Surname" type="text" required placeholder="Yılmaz" autocomplete="family-name" class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                    </div>
                </div>

                <div>
                    <label for="Email" class="block text-sm font-medium text-charcoal mb-1.5">E-posta</label>
                    <input id="Email" name="Email" type="email" required placeholder="ornek@eposta.com" autocomplete="email" class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                </div>

                <div>
                    <label for="Phone" class="block text-sm font-medium text-charcoal mb-1.5">Telefon <span class="text-muted font-normal">(opsiyonel)</span></label>
                    <input id="Phone" name="Phone" type="tel" inputmode="numeric" placeholder="0(5XX) XXX XX XX" autocomplete="tel" data-mask-phone class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                </div>

                <div>
                    <label for="Password" class="block text-sm font-medium text-charcoal mb-1.5">Şifre</label>
                    <div class="relative">
                        <input id="Password" name="Password" type="password" required placeholder="••••••••" autocomplete="new-password" data-pw-strength class="w-full px-5 py-3 pr-12 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                        <button type="button" data-toggle-pw="Password" aria-label="Şifreyi göster" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                    </div>
                    <div class="flex gap-1.5 mt-2" aria-hidden="true">
                        <span class="strbar flex-1 h-1.5 rounded-full bg-cream-300"></span>
                        <span class="strbar flex-1 h-1.5 rounded-full bg-cream-300"></span>
                        <span class="strbar flex-1 h-1.5 rounded-full bg-cream-300"></span>
                    </div>
                    <p id="strLabel" class="text-xs text-muted mt-1">En az 8 karakter, bir büyük harf ve rakam önerilir.</p>
                </div>

                <div>
                    <label for="ConfirmPassword" class="block text-sm font-medium text-charcoal mb-1.5">Şifre Tekrar</label>
                    <div class="relative">
                        <input id="ConfirmPassword" name="ConfirmPassword" type="password" required placeholder="••••••••" autocomplete="new-password" data-pw-match class="w-full px-5 py-3 pr-12 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                        <button type="button" data-toggle-pw="ConfirmPassword" aria-label="Şifreyi göster" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                    </div>
                    <p id="matchMsg" class="hidden text-xs mt-1"></p>
                </div>

                <div>
                    <label for="BirthDate" class="block text-sm font-medium text-charcoal mb-1.5">Doğum Tarihi <span class="text-muted font-normal">(opsiyonel)</span></label>
                    <input id="BirthDate" name="BirthDate" type="date" class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition text-charcoal" />
                    <p class="text-xs text-muted mt-1">Doğum gününüzde sürpriz bizden.</p>
                </div>

                <label class="flex items-start gap-2.5 text-sm text-charcoal cursor-pointer">
                    <input type="checkbox" name="MarketingConsent" value="true" class="w-4 h-4 mt-0.5 rounded accent-[#FF8FB1]" /> Pazarlama e-postaları almak istiyorum.
                </label>
                <label class="flex items-start gap-2.5 text-sm text-charcoal cursor-pointer">
                    <input id="KvkkConsent" name="KvkkConsent" value="true" type="checkbox" required class="w-4 h-4 mt-0.5 rounded accent-[#FF8FB1]" /> <span><button type="button" data-open-legal="kosul" class="text-primary hover:underline">Kullanım Koşulları</button> ve <button type="button" data-open-legal="kvkk" class="text-primary hover:underline">KVKK Aydınlatma Metni</button>'ni kabul ediyorum.</span>
                </label>

                <button type="submit" class="w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">Hesap Oluştur</button>
            </form>

            <div class="flex items-center gap-4 my-6">
                <span class="flex-1 h-px bg-cream-300"></span>
                <span class="text-sm text-muted">veya</span>
                <span class="flex-1 h-px bg-cream-300"></span>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@returnUrl" class="flex items-center justify-center gap-2 py-3 rounded-full bg-white border border-cream-300 text-charcoal text-sm font-medium hover:bg-cream transition">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.6-5.2 3.6-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.5-.4-2.4s.2-1.7.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg>
                    Google
                </a>
                <a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Apple" asp-route-returnUrl="@returnUrl" class="flex items-center justify-center gap-2 py-3 rounded-full bg-charcoal text-white text-sm font-medium hover:bg-charcoal/90 transition">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.4 12.8c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.8-3.5.8s-1.8-.8-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .7 1.1 1.6 2.3 2.7 2.3 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7 1.9-1.1 2.6-2.2c.8-1.2 1.2-2.4 1.2-2.5-.1 0-2.3-.9-2.3-3.6zM14.3 5.5c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.6-1.1 1.6-.9 2.6 1 .1 2-.5 2.6-1.2z"/></svg>
                    Apple
                </a>
            </div>

            <p class="mt-8 text-center text-sm text-charcoal">Zaten üye misiniz? <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl" class="font-semibold text-primary hover:underline">Giriş yapın</a></p>
        </div>
    </div>
</div>

@* LEGAL MODAL *@
<div id="legalModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
    <div data-close-legal class="absolute inset-0 bg-charcoal/40"></div>
    <div class="relative bg-white rounded-3xl max-w-lg w-full max-h-[80vh] overflow-y-auto p-7 shadow-md">
        <div class="flex items-start justify-between mb-3">
            <h2 id="legalTitle" class="font-heading text-xl text-charcoal"></h2>
            <button type="button" data-close-legal aria-label="Kapat" class="p-2 -mr-2 text-charcoal/50 hover:text-charcoal"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <div id="legalBody" class="text-sm text-charcoal/80 leading-relaxed space-y-3"></div>
        <button type="button" data-close-legal class="mt-5 w-full py-3 rounded-full bg-primary text-white font-semibold">Okudum, kapat</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
