@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Kayit Ol | @Tenant.Settings.StoreName" />
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-2xl font-bold text-gray-900 text-center mb-6">Kayit Ol</h1>

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-50 text-red-700 text-sm rounded-lg p-3 mb-4">
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-antiforgery="true" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="Name" class="block text-sm font-medium text-gray-700 mb-1">Ad</label>
                    <input type="text" id="Name" name="Name" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>
                <div>
                    <label for="Surname" class="block text-sm font-medium text-gray-700 mb-1">Soyad</label>
                    <input type="text" id="Surname" name="Surname" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm" />
                </div>
            </div>

            <div>
                <label for="Email" class="block text-sm font-medium text-gray-700 mb-1">E-posta</label>
                <input type="email" id="Email" name="Email" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                       placeholder="ornek@email.com" />
            </div>

            <div>
                <label for="Phone" class="block text-sm font-medium text-gray-700 mb-1">Telefon <span class="text-gray-400">(istege bagli)</span></label>
                <input type="tel" id="Phone" name="Phone"
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                       placeholder="05XX XXX XX XX" />
            </div>

            <div>
                <label for="Password" class="block text-sm font-medium text-gray-700 mb-1">Sifre</label>
                <input type="password" id="Password" name="Password" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                       placeholder="En az 6 karakter" />
            </div>

            <div>
                <label for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Sifre Tekrar</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                       placeholder="Sifrenizi tekrar girin" />
            </div>

            <div class="space-y-2">
                <label class="flex items-start space-x-2 text-sm text-gray-600">
                    <input type="checkbox" name="KvkkConsent" value="true" required class="mt-1 rounded border-gray-300" />
                    <span>
                        <a href="/kvkk" target="_blank" class="text-primary hover:underline no-underline">KVKK Aydinlatma Metni</a>'ni
                        okudum ve kabul ediyorum.
                    </span>
                </label>
                <label class="flex items-start space-x-2 text-sm text-gray-600">
                    <input type="checkbox" name="MarketingConsent" value="true" class="mt-1 rounded border-gray-300" />
                    <span>Kampanya ve firsatlardan haberdar olmak istiyorum.</span>
                </label>
            </div>

            <button type="submit" class="btn-primary w-full">Kayit Ol</button>
        </form>

        <p class="text-center text-sm text-gray-600 mt-6">
            Zaten hesabiniz var mi?
            <a href="/giris" class="text-primary font-medium hover:underline no-underline">Giris yap</a>
        </p>
    </div>
</div>
