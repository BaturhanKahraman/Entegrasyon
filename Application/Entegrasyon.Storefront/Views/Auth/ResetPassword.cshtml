@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Sifre Sifirla | @Tenant.Settings.StoreName" />
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-2xl font-bold text-gray-900 text-center mb-6">Sifre Sifirla</h1>

        @if (ViewBag.Success == true)
        {
            <div class="bg-green-50 text-green-700 text-sm rounded-lg p-4 mb-4">
                Sifreniz basariyla degistirildi.
            </div>
            <p class="text-center text-sm text-gray-600 mt-4">
                <a href="/giris" class="text-primary font-medium hover:underline no-underline">Giris yapin</a>
            </p>
        }
        else
        {
            @if (ViewBag.Error != null)
            {
                <div class="bg-red-50 text-red-700 text-sm rounded-lg p-3 mb-4">
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-antiforgery="true" class="space-y-4">
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Yeni Sifre</label>
                    <input type="password" id="password" name="password" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                           placeholder="En az 6 karakter" />
                </div>

                <div>
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Yeni Sifre Tekrar</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                           placeholder="Sifrenizi tekrar girin" />
                </div>

                <button type="submit" class="btn-primary w-full">Sifreyi Degistir</button>
            </form>
        }
    </div>
</div>
