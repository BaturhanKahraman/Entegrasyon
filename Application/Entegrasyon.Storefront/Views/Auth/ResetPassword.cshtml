@{
    ViewData["Title"] = "Şifre Sıfırla";
    var success = ViewBag.Success is true;
    var token = ViewBag.Token as string;
    var error = ViewBag.Error as string;
}

<div class="card-bg min-h-[70vh] flex items-center justify-center px-5 py-12 sm:py-16">
    <div class="w-full max-w-md">

        @if (!success)
        {
            @* ===== RESET FORM STATE ===== *@
            <div class="bg-white border border-cream-300 rounded-3xl shadow-sm py-12 px-8">
                <div class="flex flex-col items-center text-center">
                    <div class="bg-primary/10 rounded-full p-3">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </div>
                    <h1 class="font-heading text-3xl text-charcoal mt-5">Yeni Şifre Belirle</h1>
                    <p class="text-muted mt-2 leading-relaxed">Hesabınız için yeni bir şifre oluşturun.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="mt-6 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3" role="alert">
                        @error
                    </div>
                }

                <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="mt-8 space-y-4">
                    <input type="hidden" name="token" value="@token" />

                    <div>
                        <label for="Password" class="block text-sm font-medium text-charcoal mb-1.5">Yeni Şifre</label>
                        <div class="relative">
                            <input id="Password" name="password" type="password" required minlength="8" data-pw-strength autocomplete="new-password" placeholder="••••••••" class="w-full px-5 py-3 pr-12 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                            <button type="button" data-toggle-pw="Password" aria-label="Şifreyi göster" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                        </div>
                        <div class="flex items-center gap-1.5 mt-2">
                            <span class="strbar h-1 flex-1 rounded-full bg-cream-300"></span>
                            <span class="strbar h-1 flex-1 rounded-full bg-cream-300"></span>
                            <span class="strbar h-1 flex-1 rounded-full bg-cream-300"></span>
                        </div>
                        <p id="strLabel" class="text-xs text-muted mt-1">En az 8 karakter, bir büyük harf ve rakam önerilir.</p>
                    </div>

                    <div>
                        <label for="confirmPassword" class="block text-sm font-medium text-charcoal mb-1.5">Şifre Tekrar</label>
                        <div class="relative">
                            <input id="confirmPassword" name="confirmPassword" type="password" required minlength="8" data-pw-match autocomplete="new-password" placeholder="••••••••" class="w-full px-5 py-3 pr-12 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                            <button type="button" data-toggle-pw="confirmPassword" aria-label="Şifreyi göster" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                        </div>
                        <p id="matchMsg" class="text-xs mt-1 hidden"></p>
                    </div>

                    <button type="submit" class="w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">Şifreyi Güncelle</button>
                </form>

                <a asp-controller="Auth" asp-action="Login" class="mt-6 flex items-center justify-center gap-1.5 text-sm font-medium text-primary hover:underline">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                    Giriş ekranına dön
                </a>
            </div>
        }
        else
        {
            @* ===== SUCCESS STATE ===== *@
            <div class="bg-white border border-cream-300 rounded-3xl shadow-sm py-12 px-8">
                <div class="flex flex-col items-center text-center">
                    <div class="pop bg-success/15 text-success rounded-full p-4">
                        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    </div>
                    <h1 class="font-heading text-3xl text-charcoal mt-5">Şifreniz Güncellendi</h1>
                    <p class="text-muted mt-2 leading-relaxed">Artık yeni şifrenizle giriş yapabilirsiniz.</p>
                </div>

                <a asp-controller="Auth" asp-action="Login" class="mt-8 w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm flex items-center justify-center gap-2">
                    Giriş Yap
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
