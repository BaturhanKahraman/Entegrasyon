@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant

@section Head {
    <seo-meta title="Giris Yap | @Tenant.Settings.StoreName" />
}

<div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-2xl font-bold text-gray-900 text-center mb-6">Giris Yap</h1>

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-50 text-red-700 text-sm rounded-lg p-3 mb-4">
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-antiforgery="true" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div>
                <label for="Email" class="block text-sm font-medium text-gray-700 mb-1">E-posta</label>
                <input type="email" id="Email" name="Email" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                       placeholder="ornek@email.com" />
            </div>

            <div>
                <label for="Password" class="block text-sm font-medium text-gray-700 mb-1">Sifre</label>
                <input type="password" id="Password" name="Password" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                       placeholder="Sifreniz" />
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center space-x-2 text-sm text-gray-600">
                    <input type="checkbox" name="RememberMe" value="true" class="rounded border-gray-300" />
                    <span>Beni hatirla</span>
                </label>
                <a href="/sifremi-unuttum" class="text-sm text-primary hover:underline no-underline">Sifremi unuttum</a>
            </div>

            <button type="submit" class="btn-primary w-full">Giris Yap</button>
        </form>

        <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-300"></div>
            </div>
            <div class="relative flex justify-center text-sm">
                <span class="bg-white px-2 text-gray-500">veya</span>
            </div>
        </div>

        <div class="flex flex-col gap-2">
            <a href="/auth/external-login?provider=Google&returnUrl=@ViewBag.ReturnUrl"
               class="flex items-center justify-center gap-2 w-full px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors no-underline">
                <svg class="h-5 w-5" viewBox="0 0 24 24">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Google ile Giris Yap
            </a>
            <a href="/auth/external-login?provider=Facebook&returnUrl=@ViewBag.ReturnUrl"
               class="flex items-center justify-center gap-2 w-full px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors no-underline">
                <svg class="h-5 w-5" fill="#1877F2" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook ile Giris Yap
            </a>
        </div>

        <p class="text-center text-sm text-gray-600 mt-6">
            Hesabiniz yok mu?
            <a href="/kayit" class="text-primary font-medium hover:underline no-underline">Kayit ol</a>
        </p>
    </div>
</div>
