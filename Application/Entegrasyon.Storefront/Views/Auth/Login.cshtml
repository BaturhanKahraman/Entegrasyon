@{
    ViewData["Title"] = "Giriş Yap";
    var returnUrl = ViewBag.ReturnUrl as string ?? Context.Request.Query["returnUrl"].ToString();
    var loginError = TempData["LoginError"] as string;
    var loginInfo = TempData["LoginInfo"] as string;
}

<div class="grid lg:grid-cols-2 min-h-[70vh]">

    @* LEFT — illustration (desktop only) *@
    <div class="hidden lg:flex bg-primary/15 p-10 xl:p-14 flex-col">
        <div class="flex-1 flex items-center justify-center">
            <div class="w-full max-w-md">
                <div class="ph aspect-square rounded-3xl overflow-hidden bg-secondary/25 shadow-sm">
                    <img class="photo" loading="lazy" alt="Mutlu anne ve çocuk" src="https://images.unsplash.com/photo-1611428813653-aa606c998586?auto=format&fit=crop&w=800&q=80" />
                </div>
                <p class="font-heading italic text-2xl text-charcoal mt-6 text-center">"Minik dolaplara büyük ilham."</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2.5 justify-center">
            <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3.5 py-1.5 text-xs font-medium text-charcoal shadow-sm"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#FF8FB1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.3a2 2 0 0 0-.6-1.4L18 9h-4v8h2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>Kargo Bedava</span>
            <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3.5 py-1.5 text-xs font-medium text-charcoal shadow-sm"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#8FCBE8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>30 Gün İade</span>
            <span class="inline-flex items-center gap-1.5 bg-white rounded-full px-3.5 py-1.5 text-xs font-medium text-charcoal shadow-sm"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#4CAF89" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>Güvenli Ödeme</span>
        </div>
    </div>

    @* RIGHT — form *@
    <div class="flex justify-center items-center px-5 sm:px-8 py-10 lg:py-12">
        <div class="w-full max-w-md mx-auto">
            @* mobile banner *@
            <div class="lg:hidden ph aspect-[16/9] rounded-2xl overflow-hidden bg-secondary/25 mb-8">
                <img class="photo" loading="lazy" alt="Mutlu anne ve çocuk" src="https://images.unsplash.com/photo-1611428813653-aa606c998586?auto=format&fit=crop&w=700&q=80" />
            </div>

            <img src="~/img/zekids-logo.png" alt="Zekids" class="h-8 w-auto" />
            <h1 class="font-heading text-3xl text-charcoal mt-6">Tekrar Hoş Geldiniz</h1>
            <p class="text-muted mt-1.5">Hesabınıza giriş yapın.</p>

            @if (!string.IsNullOrWhiteSpace(loginError))
            {
                <div class="mt-5 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3" role="alert">
                    @loginError
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(loginInfo))
            {
                <div class="mt-5 rounded-2xl bg-success/10 border border-success/30 text-success text-sm px-4 py-3" role="status">
                    @loginInfo
                </div>
            }

            <form asp-controller="Auth" asp-action="Login" method="post" class="mt-8 space-y-4">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div>
                    <label for="email" class="block text-sm font-medium text-charcoal mb-1.5">E-posta</label>
                    <input id="email" name="Email" type="email" required placeholder="ornek@eposta.com" autocomplete="email" class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-charcoal mb-1.5">Şifre</label>
                    <div class="relative">
                        <input id="password" name="Password" type="password" required placeholder="••••••••" autocomplete="current-password" class="w-full px-5 py-3 pr-12 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition" />
                        <button type="button" data-toggle-pw="password" aria-label="Şifreyi göster" class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-charcoal"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                    </div>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <label class="flex items-center gap-2 cursor-pointer text-charcoal"><input type="checkbox" name="RememberMe" value="true" class="w-4 h-4 rounded accent-[#FF8FB1]" /> Beni hatırla</label>
                    <a asp-controller="Auth" asp-action="ForgotPassword" class="text-primary font-medium hover:underline">Şifremi unuttum</a>
                </div>
                <button type="submit" class="w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">Giriş Yap</button>
            </form>

            <div class="flex items-center gap-4 my-6">
                <span class="flex-1 h-px bg-cream-300"></span>
                <span class="text-sm text-muted">veya</span>
                <span class="flex-1 h-px bg-cream-300"></span>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@returnUrl" class="flex items-center justify-center gap-2 py-3 rounded-full bg-white border border-cream-300 text-charcoal text-sm font-medium hover:bg-cream transition">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.6-5.2 3.6-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.5-.4-2.4s.2-1.7.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg>
                    Google
                </a>
                <a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Apple" asp-route-returnUrl="@returnUrl" class="flex items-center justify-center gap-2 py-3 rounded-full bg-charcoal text-white text-sm font-medium hover:bg-charcoal/90 transition">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.4 12.8c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.8-3.5.8s-1.8-.8-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .7 1.1 1.6 2.3 2.7 2.3 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7 1.9-1.1 2.6-2.2c.8-1.2 1.2-2.4 1.2-2.5-.1 0-2.3-.9-2.3-3.6zM14.3 5.5c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.6-1.1 1.6-.9 2.6 1 .1 2-.5 2.6-1.2z"/></svg>
                    Apple
                </a>
            </div>

            <p class="mt-8 text-center text-sm text-charcoal">Hesabınız yok mu? <a asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@returnUrl" class="font-semibold text-primary hover:underline">Hemen kayıt olun</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
