@{
    ViewData["Title"] = "İki Aşamalı Doğrulama";
    var error = ViewBag.Error as string;
}

<div class="card-bg min-h-[70vh] flex items-center justify-center px-5 py-12 sm:py-16">
    <div class="w-full max-w-md">
        <div class="bg-white border border-cream-300 rounded-3xl shadow-sm py-12 px-8">
            <div class="flex flex-col items-center text-center">
                <div class="bg-primary/10 rounded-full p-3">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
                </div>
                <h1 class="font-heading text-3xl text-charcoal mt-5">İki Aşamalı Doğrulama</h1>
                <p class="text-muted mt-2 leading-relaxed" data-tfa-hint>Doğrulama uygulamanızda görünen 6 haneli kodu girin.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="mt-6 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3" role="alert">
                    @error
                </div>
            }

            <form asp-controller="Auth" asp-action="TwoFactor" method="post" class="mt-8" data-tfa-form>
                <input type="hidden" name="useRecovery" id="useRecovery" value="false" />

                @* ===== OTP mode ===== *@
                <div data-tfa-otp-mode>
                    <input type="hidden" name="code" id="tfaCode" />
                    <div class="flex items-center justify-center gap-2 sm:gap-3" data-tfa-otp>
                        @for (var i = 0; i < 6; i++)
                        {
                            <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code"
                                   class="tfa-box w-11 h-14 sm:w-12 sm:h-14 text-center text-xl font-semibold rounded-xl border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-charcoal transition" />
                        }
                    </div>
                </div>

                @* ===== Recovery code mode (JS ile görünür olur) ===== *@
                <div data-tfa-recovery-mode class="hidden">
                    <label for="recoveryCode" class="block text-sm font-medium text-charcoal mb-1.5">Kurtarma Kodu</label>
                    <input type="text" id="recoveryCode" disabled autocomplete="off" placeholder="XXXX-XXXX"
                           class="w-full px-5 py-3 rounded-full border border-cream-300 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition font-mono tracking-wider" />
                </div>

                <button type="submit" class="mt-6 w-full py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition shadow-sm">Doğrula</button>
            </form>

            <div class="mt-6 text-center text-sm">
                <button type="button" data-tfa-toggle-recovery class="font-medium text-primary hover:underline">Kurtarma kodu kullan</button>
            </div>

            <a asp-controller="Auth" asp-action="Login" class="mt-4 flex items-center justify-center gap-1.5 text-sm font-medium text-muted hover:text-charcoal transition">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                Giriş ekranına dön
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/two-factor.js" asp-append-version="true"></script>
}
