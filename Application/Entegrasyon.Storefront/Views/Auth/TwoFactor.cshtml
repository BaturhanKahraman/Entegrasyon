@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@{
    var error = ViewBag.Error as string;
}

@section Head {
    <seo-meta title="Iki Faktorlu Dogrulama | @Tenant.Settings.StoreName" />
}

<div class="min-h-[60vh] flex items-center justify-center py-12">
    <div class="bg-white rounded-lg shadow-lg border border-gray-200 p-8 w-full max-w-md">
        <div class="text-center mb-6">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">Dogrulama Kodu</h1>
            <p class="text-gray-500 text-sm mt-2">Authenticator uygulamanizdan 6 haneli kodu girin</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">
                @error
            </div>
        }

        <form method="post" asp-action="TwoFactor" asp-controller="Auth" id="totp-form">
            @Html.AntiForgeryToken()

            <div class="mb-6">
                <label for="code" class="block text-sm font-medium text-gray-700 mb-1">Dogrulama Kodu</label>
                <input type="text" name="code" id="code" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autofocus
                       class="w-full px-4 py-3 text-center text-2xl tracking-[0.5em] border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="000000" />
            </div>

            <button type="submit" class="btn-primary w-full py-3 mb-3">Dogrula</button>
        </form>

        <div class="border-t border-gray-200 pt-4 mt-4">
            <p class="text-sm text-gray-500 text-center mb-3">Kodunuza ulasemiyor musunuz?</p>
            <form method="post" asp-action="TwoFactor" asp-controller="Auth">
                @Html.AntiForgeryToken()
                <input type="hidden" name="useRecovery" value="true" />
                <div class="mb-3">
                    <label for="recovery-code" class="block text-sm font-medium text-gray-700 mb-1">Kurtarma Kodu</label>
                    <input type="text" name="code" id="recovery-code"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm"
                           placeholder="123456-789012" />
                </div>
                <button type="submit" class="w-full py-2 px-4 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50">
                    Kurtarma Kodu ile Giris
                </button>
            </form>
        </div>
    </div>
</div>
