@using Entegrasyon.Entity.Products
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@model List<Product>

@section Head {
    <seo-meta title="Urun Ekle | @Tenant.Settings.StoreName" />
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Urun Ekle</h1>

    <div class="bg-white rounded-lg shadow p-4 mb-6">
        <form method="get" class="flex gap-4">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Urun adi ile arayın..."
                   class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary text-sm" />
            <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg text-sm hover:bg-opacity-90 transition">
                Ara
            </button>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-lg shadow p-8 text-center">
            <p class="text-gray-500">Eklenecek urun bulunamadi.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var product in Model)
            {
                <div class="bg-white rounded-lg shadow p-4">
                    <h3 class="font-medium text-gray-900 mb-2 text-sm">@product.Title</h3>
                    <p class="text-gray-500 text-xs mb-4">Stok Kodu: @(product.StockCode ?? "-")</p>

                    <form method="post" asp-antiforgery="true" class="space-y-3">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">Fiyat (TL)</label>
                                <input type="number" name="price" step="0.01" min="0" required
                                       class="w-full px-2 py-1 border rounded text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs text-gray-500 mb-1">Stok</label>
                                <input type="number" name="stock" min="0" required value="1"
                                       class="w-full px-2 py-1 border rounded text-sm" />
                            </div>
                        </div>
                        <button type="submit" class="w-full bg-primary text-white py-2 rounded-lg text-sm hover:bg-opacity-90 transition">
                            Ekle
                        </button>
                    </form>
                </div>
            }
        </div>
    }

    <div class="mt-6">
        <a href="/satici/urunlerim" class="text-gray-500 hover:text-gray-700 text-sm">Urunlerime Don</a>
    </div>
</div>
