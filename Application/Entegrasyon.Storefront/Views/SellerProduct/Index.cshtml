@using Entegrasyon.Entity.Storefront
@inject Entegrasyon.Business.Abstract.IStorefrontTenantContext Tenant
@model List<SellerProduct>

@section Head {
    <seo-meta title="Urunlerim | @Tenant.Settings.StoreName" />
}

@{
    var seller = ViewBag.Seller as Seller;
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Urunlerim</h1>
        <a href="/satici/urun-ekle" class="bg-primary text-white px-4 py-2 rounded-lg text-sm hover:bg-opacity-90 transition no-underline">
            Urun Ekle
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white rounded-lg shadow p-8 text-center">
            <p class="text-gray-500 mb-4">Henuz urun eklemediniz.</p>
            <a href="/satici/urun-ekle" class="text-primary hover:underline">Ilk urununu ekle</a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Urun</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fiyat</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Stok</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Durum</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Aktif</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Islemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 py-3 text-sm text-gray-900">@item.Product?.Title</td>
                            <td class="px-4 py-3 text-sm text-gray-900">@item.Price.ToString("N2") TL</td>
                            <td class="px-4 py-3 text-sm text-gray-900">@item.Stock</td>
                            <td class="px-4 py-3">
                                @switch (item.Status)
                                {
                                    case SellerProductStatus.Pending:
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Bekliyor</span>
                                        break;
                                    case SellerProductStatus.Approved:
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">Onayli</span>
                                        break;
                                    case SellerProductStatus.Rejected:
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">Reddedildi</span>
                                        break;
                                }
                            </td>
                            <td class="px-4 py-3 text-sm">
                                @if (item.IsActive)
                                {
                                    <span class="text-green-600">Aktif</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">Pasif</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right">
                                <form method="post" action="/satici/urun-guncelle" asp-antiforgery="true" class="inline-flex gap-2 items-center">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="number" name="price" value="@item.Price" step="0.01" min="0"
                                           class="w-24 px-2 py-1 border rounded text-sm" />
                                    <input type="number" name="stock" value="@item.Stock" min="0"
                                           class="w-16 px-2 py-1 border rounded text-sm" />
                                    <input type="hidden" name="isActive" value="@item.IsActive.ToString().ToLower()" />
                                    <button type="submit" class="text-primary text-sm hover:underline">Guncelle</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-6">
        <a href="/satici/panel" class="text-gray-500 hover:text-gray-700 text-sm">Panele Don</a>
    </div>
</div>
