@{
    ViewData["Title"] = "Kargo Takip";
    var error = ViewBag.Error as string;
    var searched = ViewBag.SearchedNumber as string;
}

<main class="max-w-lg mx-auto px-4 sm:px-6 py-12 lg:py-16">

    <nav aria-label="breadcrumb" class="text-sm text-muted mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-primary transition">Anasayfa</a>
        <span class="text-cream-300">›</span>
        <span class="text-charcoal font-medium">Kargo Takip</span>
    </nav>

    <div class="bg-white border border-cream-300 rounded-2xl p-7 sm:p-9 shadow-sm text-center">
        <div class="w-16 h-16 rounded-2xl bg-secondary/20 text-secondary flex items-center justify-center mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M21 3 9 15"/><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"/></svg>
        </div>
        <h1 class="font-heading text-3xl text-charcoal">Kargonuzu Takip Edin</h1>
        <p class="text-muted mt-2.5 leading-relaxed max-w-sm mx-auto">Sipariş numaranızla anlık kargo durumunu öğrenin.</p>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="mt-5 rounded-2xl bg-danger/10 border border-danger/30 text-danger text-sm px-4 py-3 text-left" role="alert">@error</div>
        }

        <form asp-controller="Tracking" asp-action="Index" method="get" class="mt-7">
            <div class="flex flex-col sm:flex-row items-stretch gap-3">
                <input id="orderNumber" name="orderNumber" type="text" required value="@searched" placeholder="Sipariş numarası" autocomplete="off" class="flex-1 rounded-full border border-cream-300 px-5 py-3.5 text-base outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition placeholder:text-muted" />
                <button type="submit" class="px-7 py-3.5 rounded-full bg-primary text-white font-semibold hover:bg-primary/90 transition whitespace-nowrap">Sorgula</button>
            </div>
        </form>

        <p class="text-xs text-muted mt-5 flex items-center justify-center gap-2">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            Sipariş numaranız satın alma e-postanızda yer alır.
        </p>
    </div>

    <p class="text-center text-sm text-muted mt-6">Hesabınızdan da takip edebilirsiniz: <a href="/hesabim/siparislerim" class="text-primary font-medium hover:underline">Siparişlerim</a></p>

</main>
