@page "/"
@using Entegrasyon.Business.Concrete
@using Entegrasyon.Blazor.Services.Channels
@using Entegrasyon.Blazor.Services.Channels.Events
@implements IAsyncDisposable

<PageTitle>Ana Sayfa - Dashboard</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Dashboard</MudText>
<MudText Class="mb-4" Color="Color.Secondary">E-Commerce Entegrasyon Platformuna Hoş Geldiniz</MudText>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

<MudGrid>
    <!-- Stats Cards -->
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Ürün</MudText>
                        <MudText Typo="Typo.h4">@stats.TotalProducts</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Primary" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bugünkü Satışlar</MudText>
                        <MudText Typo="Typo.h4">@stats.TodaySales</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Success">₺@stats.TodayRevenue.ToString("N2")</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Success" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bekleyen Sipariş</MudText>
                        <MudText Typo="Typo.h4">@stats.PendingOrders</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Large" Color="Color.Warning" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Düşük Stok</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Error">@stats.LowStockProducts</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Error" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Sales Chart -->
    <MudItem xs="12" md="8">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Haftalık Satış Grafiği</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@salesChartData"
                          XAxisLabels="@xAxisLabels"
                          Width="100%"
                          Height="300px"
                          ChartOptions="@chartOptions" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Quick Actions -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Hızlı İşlemler</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudList T="string">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Add" IconColor="Color.Primary" Href="/products">
                        Yeni Ürün Ekle
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PointOfSale" IconColor="Color.Success" Href="/sales">
                        Satış Yap
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Sync" IconColor="Color.Info" OnClick="@SyncMarketplaces">
                        Pazaryeri Senkronize
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Assessment" IconColor="Color.Secondary" Href="/reports">
                        Raporları Görüntüle
                    </MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Marketplace Sync Status -->
    <MudItem xs="12" md="6">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Pazaryeri Durumu</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudList T="string" Dense="true">
                    @foreach (var marketplace in marketplaceStatuses)
                    {
                        <MudListItem T="string">
                            <div class="d-flex justify-space-between align-center" style="width: 100%">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Color="@marketplace.Color" Size="Size.Small">
                                        <MudIcon Icon="@marketplace.Icon" Size="Size.Small" />
                                    </MudAvatar>
                                    <MudText>@marketplace.Name</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@marketplace.StatusColor">
                                    @marketplace.Status
                                </MudChip>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Recent Activity -->
    <MudItem xs="12" md="6">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Son Aktiviteler</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTimeline TimelineOrientation="TimelineOrientation.Vertical">
                    @foreach (var activity in recentActivities)
                    {
                        <MudTimelineItem Color="@activity.Color" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.body2">@activity.Message</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@activity.Time</MudText>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
