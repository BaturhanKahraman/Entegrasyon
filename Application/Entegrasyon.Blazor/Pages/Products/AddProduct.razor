@page "/products/add"
@using Entegrasyon.Entity.Dtos.Product
@using Entegrasyon.Entity.Dtos.Product.ProductVariant
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Yeni Ürün Ekle</PageTitle>

<MudPaper Class="pa-3 mb-3" Outlined="true">
    <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Large" Color="Color.Primary" />
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Yeni Ürün Ekle</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ürün bilgilerini adım adım tamamlayın.</MudText>
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4">
    <MudStepper @bind-ActiveIndex="stepIndex" Elevation="0" Linear="true">

        @* ── Step 0: Genel Bilgiler ── *@
        <MudStep Label="Genel">
            <StepContent>
                <MudForm @ref="formStep1">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Ürün Başlığı" @bind-Value="title" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Stok Kodu" @bind-Value="stockCode" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int" Label="Marka" @bind-Value="brandId">
                                @foreach (var b in brands)
                                {
                                    <MudSelectItem Value="@b.Id">@b.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int" Label="Kategori" Value="categoryId" ValueChanged="OnCategoryChanged">
                                @foreach (var c in categories)
                                {
                                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Label="Açıklama" Lines="4" @bind-Value="description" />
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </StepContent>
        </MudStep>

        @* ── Step 1: Varyant Seçimi ── *@
        <MudStep Label="Varyant Seçimi">
            <StepContent>
                @if (varianterAttributes is null || !varianterAttributes.Any())
                {
                    <MudText>Bu kategori için varyant belirleyici attribute bulunamadı. Manuel varyant ekleyebilirsiniz.</MudText>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="AddVariant">Manuel Varyant Ekle</MudButton>
                }
                else
                {
                    <div class="varianter-list">
                        @foreach (var attr in varianterAttributes)
                        {
                            <MudPaper Class="pa-3 mb-3">
                                <MudText Typo="Typo.subtitle1">@attr.AttributeName</MudText>
                                <MudSelect T="int" MultiSelection="true" Label="Değerleri seçin"
                                           SelectedValues="@attr.SelectedValueIds" SelectedValuesChanged="@(vals => OnSelectedValuesChanged(attr, vals))">
                                    @foreach (var val in attr.Values)
                                    {
                                        <MudSelectItem Value="@val.Id">@val.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudPaper>
                        }
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GenerateVariants">Seçilenlerden Varyant Oluştur</MudButton>
                    </div>
                }
            </StepContent>
        </MudStep>

        @* ── Step 2: Varyant Detayları & Görseller ── *@
        <MudStep Label="Varyantlar & Görseller">
            <StepContent>
                <div class="variants-section">
                    @if (!variants.Any())
                    {
                        <MudText>Henüz varyant yok. Lütfen önce varyant oluşturun veya manuel ekleyin.</MudText>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddVariant">Manuel Varyant Ekle</MudButton>
                    }
                    @foreach (var (variant, idx) in variants.Select((v, i) => (v, i)))
                    {
                        <MudPaper Class="pa-3 mt-3 variant-card">
                            <MudGrid>
                                <MudItem xs="12" md="3">
                                    <MudTextField Label="Barkod" @bind-Value="variant.Barcode" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField Label="Liste Fiyatı" @bind-Value="variant.ListPrice" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField Label="Satış Fiyatı" @bind-Value="variant.SalePrice" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField Label="Maliyet" @bind-Value="variant.CostPrice" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField Label="Hacim Ağırlığı" @bind-Value="variant.DimensionalWeight" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="1" Class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => RemoveVariant(idx))" />
                                </MudItem>

                                @* Image upload for this variant *@
                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">Görseller</MudText>
                                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                                   FilesChanged="@(files => OnVariantImagesChanged(idx, files))"
                                                   Accept=".jpg,.jpeg,.png,.webp"
                                                   Multiple="true">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.Image"
                                                       Size="Size.Small">
                                                Görsel Seç
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                    @if (_variantImages.TryGetValue(idx, out var imgs) && imgs.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success">@imgs.Count görsel seçildi</MudText>
                                    }
                                </MudItem>
                            </MudGrid>

                            @if (variant.ProductVariantAttributes?.Any() == true)
                            {
                                <div class="mt-2">
                                    <MudText Typo="Typo.subtitle2">Özellikler:</MudText>
                                    <ul>
                                        @foreach (var pva in variant.ProductVariantAttributes)
                                        {
                                            <li>@(pva.CategoryAttributeValue ?? pva.CustomValue)</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </MudPaper>
                    }
                </div>
            </StepContent>
        </MudStep>

        @* ── Step 3: Pazaryeri Seçimi ── *@
        <MudStep Label="Pazaryeri">
            <StepContent>
                <MudText Typo="Typo.subtitle1" Class="mb-3">Ürünü hangi pazaryerlerine eklemek istiyorsunuz?</MudText>

                <MudPaper Class="pa-3 mb-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox @bind-Value="_trendyolSelected" Color="Color.Primary" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1"><b>Trendyol</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Ürün Trendyol'a gönderilecek</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-3 mb-2" Style="opacity:0.5">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox Value="false" Disabled="true" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1"><b>Hepsiburada</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Yakında</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-3 mb-2" Style="opacity:0.5">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox Value="false" Disabled="true" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1"><b>Amazon.com.tr</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Yakında</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudDivider Class="my-4" />

                @* Summary *@
                <MudText Typo="Typo.h6" Class="mb-2">Özet</MudText>
                <MudPaper Class="pa-3">
                    <div><b>Başlık:</b> @title</div>
                    <div><b>Stok Kodu:</b> @stockCode</div>
                    <div><b>Marka:</b> @brands.FirstOrDefault(b => b.Id == brandId)?.Name</div>
                    <div><b>Kategori:</b> @categories.FirstOrDefault(c => c.Id == categoryId)?.Name</div>
                    <div class="mt-2"><b>Varyant Sayısı:</b> @variants.Count</div>
                    <div><b>Toplam Görsel:</b> @_variantImages.Values.Sum(f => f.Count)</div>
                </MudPaper>
            </StepContent>
        </MudStep>

    </MudStepper>

    <div class="actions mt-4 d-flex justify-between">
        <MudButton Variant="Variant.Outlined" OnClick="PreviousStep" Disabled="@(stepIndex == 0 || _isSaving)">Geri</MudButton>
        @if (stepIndex < 3)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextStep" Disabled="_isSaving">İleri</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Submit" Disabled="_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>Kaydet ve Yayınla</span>
                }
            </MudButton>
        }
    </div>
</MudPaper>
