@using Shared.Extensions.Constants
@attribute [Authorize(Policy = AppPermissions.Roles.View)]
@using Entegrasyon.Entity.User
@using Entegrasyon.Entity.Dtos.Users
@using Entegrasyon.Business.Abstract
@using Entegrasyon.Business.Concrete.Auth // For IRoleService namespace check
@using Entegrasyon.DataAccess.Concrete.EntityFrameworkCore.Contexts
@using Microsoft.EntityFrameworkCore
@using Entegrasyon.Blazor.Pages.Admin
@using Entegrasyon.Blazor.Models

@inject IRoleService RoleService
@inject IntegrationDbContext DbContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Rol Yönetimi</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Rol Yönetimi</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="12" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenAddRoleDialog">
                Yeni Rol
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@_roles" Hover="true" Loading="@_loading">
    <HeaderContent>
        <MudTh>Rol Adı</MudTh>
        <MudTh>Yetkiler</MudTh>
        <MudTh Style="text-align:right">İşlemler</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Rol Adı">@context.Name</MudTd>
        <MudTd DataLabel="Yetkiler">
            <!-- Display count of permissions assigned to this role -->
            @if (context.RoleClaims != null && context.RoleClaims.Count > 0)
            {
                <MudChip T="string" Size="Size.Small">@context.RoleClaims.Count yetki</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small">Yetki yok</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="İşlemler" Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                OnClick="@(() => EditRole(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                OnClick="@(() => DeleteRole(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Role> _roles = new();
    private List<PermissionModel> _allPermissions = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // Fetch Roles with their role claims (permissions)
            _roles = await DbContext.Roles.Include(r => r.RoleClaims).ToListAsync();

            // Convert static permissions to PermissionModel list for display
            var allPermissions = AppPermissions.GetAllPermissions();
            _allPermissions = allPermissions
                .Select(p => new PermissionModel(p, FormatPermissionName(p)))
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Veri yüklenirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatPermissionName(string permission)
    {
        // Convert "Permissions.Users.View" to "Kullanıcılar - Görüntüle"
        var parts = permission.Split('.');
        if (parts.Length >= 3)
        {
            var action = parts[2];
            var actionName = action switch
            {
                "View" => "Görüntüle",
                "Create" => "Oluştur",
                "Edit" => "Düzenle",
                "Delete" => "Sil",
                _ => action
            };

            // Assuming format is Permissions.{Category}.{Action}
            return $"{parts[1]} - {actionName}";
        }
        return permission;
    }

    private async Task OpenAddRoleDialog()
    {
        var parameters = new DialogParameters();
        parameters.Add("IsEdit", false);
        parameters.Add("AllPermissions", _allPermissions);

        var dialog = await DialogService.ShowAsync<RoleDialog>("Yeni Rol", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is RoleDialog.RoleDto dto)
        {
            var roleDto = new AddRoleDto(dto.Name, dto.PermissionNames);

            var serviceResult = await RoleService.AddRole(roleDto);
            if (serviceResult.Success)
            {
                Snackbar.Add(serviceResult.Message, Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(serviceResult.Message, Severity.Error);
            }
        }
    }

    private async Task EditRole(Role role)
    {
        var parameters = new DialogParameters();
        parameters.Add("IsEdit", true);
        parameters.Add("AllPermissions", _allPermissions);
        parameters.Add("Model", new RoleDialog.RoleDto
            {
                Id = role.Id,
                Name = role.Name,
                PermissionNames = role.RoleClaims?.Select(c => c.Permission).ToList() ?? new List<string>()
            });

        var dialog = await DialogService.ShowAsync<RoleDialog>("Rol Düzenle", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is RoleDialog.RoleDto dto)
        {
            var editDto = new EditRoleDto(dto.Id, dto.Name, dto.PermissionNames);

            var serviceResult = await RoleService.UpdateRole(editDto);
            if (serviceResult.Success)
            {
                Snackbar.Add(serviceResult.Message, Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(serviceResult.Message, Severity.Error);
            }
        }
    }

    private async Task DeleteRole(Role role)
    {
        var result = await DialogService.ShowMessageBox(
        "Rol Sil",
        $"{role.Name} rolünü silmek istediğinizden emin misiniz?",
        yesText: "Sil",
        cancelText: "İptal");

        if (result == true)
        {
            var serviceResult = await RoleService.DeleteRole(role.Id);
            if (serviceResult.Success)
            {
                Snackbar.Add(serviceResult.Message, Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(serviceResult.Message, Severity.Error);
            }
        }
    }
}
