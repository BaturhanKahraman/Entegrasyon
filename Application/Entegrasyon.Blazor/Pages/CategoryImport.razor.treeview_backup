@page "/categories/import"
@using Entegrasyon.Business.Abstract
@using Entegrasyon.Business.Concrete.Import
@using Entegrasyon.Entity.Categories
@using Entegrasyon.Blazor.Services.Channels
@using Entegrasyon.Blazor.Services.Channels.Events
@inject TrendyolCategoryImporter TrendyolImporter
@inject EventChannel<CategoryUpdatedEvent> CategoryEventChannel
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Kategori İçe Aktar</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Kategori İçe Aktar</MudText>
<MudText Class="mb-4" Color="Color.Secondary">
    Pazaryerlerinden kategorileri içe aktararak ürün kategorilerinizi oluşturun
</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
    <MudTabPanel Text="Trendyol" Icon="@Icons.Material.Filled.Store">
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Trendyol Kategorileri</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadTrendyolCategoriesAsync"
                               Disabled="@_loading">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kategorileri Yükle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ImportSelectedCategoriesAsync"
                               Disabled="@(_importing || _selectedCategoryNodes == null || !_selectedCategoryNodes.Any())">
                        @if (_importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Seçilenleri İçe Aktar (@(_selectedCategoryNodes?.Count ?? 0))
                    </MudButton>
                </div>
            </div>

            @if (_loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudText Align="Align.Center" Color="Color.Secondary">Kategoriler yükleniyor...</MudText>
            }
            else if (!_trendyolCategories.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Kategorileri görüntülemek için "Kategorileri Yükle" butonuna tıklayın.
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="height: 500px; overflow-y: auto;">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">Trendyol Kategori Ağacı</MudText>
                            <MudTextField @bind-Value="_searchQuery"
                                          Placeholder="Kategori ara..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          OnDebounceIntervalElapsed="@(() => UpdateFilteredCategories())"
                                          Class="mb-2" />

                            @if (_filteredCategories.Any())
                            {
                                <MudTreeView T="CategoryTreeNode"
                                             Items="@_filteredCategories"
                                             SelectionMode="SelectionMode.MultiSelection"
                                             @bind-SelectedValues="_selectedCategoryNodes"
                                             Hover="true"
                                             CheckBoxColor="Color.Primary"
                                             ExpandOnClick="true">
                                    <ItemTemplate Context="item">
                                        <MudTreeViewItem Items="@item.Children"
                                                         Value="@item.Value"
                                                         Icon="@(item.HasChildren ? Icons.Material.Filled.Folder : Icons.Material.Filled.Category)"
                                                         Text="@item.Value?.Name">
                                            <BodyContent>
                                                <div class="d-flex align-center justify-space-between" style="width: 100%">
                                                    <MudText>@item.Value?.Name</MudText>
                                                    @if (item.Value?.HasChildren == true)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                                            @item.Value.Children.Count
                                                        </MudChip>
                                                    }
                                                </div>
                                            </BodyContent>
                                        </MudTreeViewItem>
                                    </ItemTemplate>
                                </MudTreeView>
                            }
                            else
                            {
                                <MudText Align="Align.Center" Color="Color.Secondary" Class="mt-4">
                                    @(string.IsNullOrWhiteSpace(_searchQuery) ? "Kategori bulunamadı" : "Arama sonucu bulunamadı")
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="height: 500px; overflow-y: auto;">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">Seçilen Kategoriler</MudText>

                            @if (_selectedCategoryNodes == null || !_selectedCategoryNodes.Any())
                            {
                                <MudAlert Severity="Severity.Info">
                                    İçe aktarmak istediğiniz kategorileri sol taraftan seçin.
                                </MudAlert>
                            }
                            else
                            {
                                <MudList T="string" Dense="true">
                                    @foreach (var category in _selectedCategoryNodes)
                                    {
                                        <MudListItem T="string" Icon="@Icons.Material.Filled.Category">
                                            <div class="d-flex justify-space-between align-center" style="width: 100%">
                                                <MudText>@category.Name</MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               Color="Color.Error"
                                                               OnClick="@(() => RemoveSelectedCategory(category))" />
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>

                                <MudDivider Class="my-4" />

                                <div class="d-flex justify-space-between">
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               OnClick="@(() => _selectedCategoryNodes = null)">
                                        Seçimi Temizle
                                    </MudButton>
                                    <MudText Color="Color.Primary">
                                        Toplam: @_selectedCategoryNodes.Count kategori
                                    </MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Hepsiburada" Icon="@Icons.Material.Filled.ShoppingCart" Disabled="true">
        <MudPaper Class="pa-4">
            <MudAlert Severity="Severity.Info">
                Hepsiburada entegrasyonu yakında eklenecek.
            </MudAlert>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="N11" Icon="@Icons.Material.Filled.Storefront" Disabled="true">
        <MudPaper Class="pa-4">
            <MudAlert Severity="Severity.Info">
                N11 entegrasyonu yakında eklenecek.
            </MudAlert>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@if (_importing)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999">
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
                <MudText Typo="Typo.h6" Align="Align.Center">Kategoriler içe aktarılıyor...</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Bu işlem birkaç dakika sürebilir.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudOverlay>
}

@code {
    private List<CategoryTreeNode> _trendyolCategories = new();
    private IReadOnlyCollection<TreeItemData<CategoryTreeNode>> _filteredCategories = new List<TreeItemData<CategoryTreeNode>>();
    private IReadOnlyCollection<CategoryTreeNode>? _selectedCategoryNodes;
    private bool _loading;
    private bool _importing;
    private string _searchQuery = string.Empty;
    // Performance: Cache TreeItemData to avoid rebuilding on every render
    private Dictionary<string, TreeItemData<CategoryTreeNode>> _treeItemCache = new();
    private async Task LoadTrendyolCategoriesAsync()
    {
        _loading = true;

        try
        {
            var result = await TrendyolImporter.GetExternalCategoriesAsync();

            if (result.Success && result.Data != null)
            {
                _trendyolCategories = result.Data.Select(MapToTreeNode).ToList();
                _treeItemCache.Clear(); // Clear cache when new data loaded
                UpdateFilteredCategories();
                Snackbar.Add($"{CountAllCategories(_trendyolCategories)} kategori yüklendi.", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Kategoriler yüklenemedi.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ImportSelectedCategoriesAsync()
    {
        if (_selectedCategoryNodes == null || !_selectedCategoryNodes.Any())
        {
            Snackbar.Add("Lütfen en az bir kategori seçin.", Severity.Warning);
            return;
        }

        _importing = true;

        try
        {
            var importRequests = _selectedCategoryNodes.Select(MapToImportRequest).ToList();
            var result = await TrendyolImporter.ImportCategoriesAsync(importRequests);

            if (result.Success)
            {
                Snackbar.Add($"{_selectedCategoryNodes.Count} kategori başarıyla içe aktarıldı.", Severity.Success);
                await CategoryEventChannel.PublishAsync(new CategoryUpdatedEvent(0, "Imported"));
                _selectedCategoryNodes = null;
            }
            else
            {
                Snackbar.Add(result.Message ?? "İçe aktarma başarısız.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private void RemoveSelectedCategory(CategoryTreeNode node)
    {
        if (_selectedCategoryNodes != null)
        {
            var list = _selectedCategoryNodes.ToList();
            list.Remove(node);
            _selectedCategoryNodes = list;
        }
    }

    private void UpdateFilteredCategories()
    {
        IEnumerable<CategoryTreeNode> filtered;

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            filtered = _trendyolCategories;
        }
        else
        {
            filtered = _trendyolCategories.Where(c => ContainsSearchQuery(c, _searchQuery));
        }

        _filteredCategories = filtered.Select(ConvertToTreeItemData).ToList();
    }

    private bool ContainsSearchQuery(CategoryTreeNode node, string query)
    {
        if (node.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
            return true;

        return node.Children.Any(c => ContainsSearchQuery(c, query));
    }

    private int CountAllCategories(IEnumerable<CategoryTreeNode> nodes)
    {
        return nodes.Sum(n => 1 + CountAllCategories(n.Children));
    }

    private CategoryTreeNode MapToTreeNode(ExternalCategoryDto dto)
    {
        return new CategoryTreeNode
        {
            ExternalId = dto.ExternalId,
            Name = dto.Name,
            ParentExternalId = dto.ParentExternalId,
            Children = dto.Children.Select(MapToTreeNode).ToHashSet()
        };
    }

    private ExternalCategoryImportRequest MapToImportRequest(CategoryTreeNode node)
    {
        return new ExternalCategoryImportRequest
        {
            ExternalId = node.ExternalId,
            Name = node.Name,
            ParentExternalId = node.ParentExternalId,
            Children = node.Children
                .Where(c => _selectedCategoryNodes?.Contains(c) == true)
                .Select(MapToImportRequest)
                .ToList()
        };
    }

    private TreeItemData<CategoryTreeNode> ConvertToTreeItemData(CategoryTreeNode node)
    {
        // Performance: Return cached TreeItemData if already created
        if (_treeItemCache.TryGetValue(node.ExternalId, out var cached))
        {
            return cached;
        }

        var treeItem = new TreeItemData<CategoryTreeNode>
        {
            Value = node,
            Children = node.Children.Select(ConvertToTreeItemData).ToList(),
            Expandable = node.HasChildren,
            Expanded = node.IsExpanded
        };

        _treeItemCache[node.ExternalId] = treeItem;
        return treeItem;
    }

    private class CategoryTreeNode
    {
        public string ExternalId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? ParentExternalId { get; set; }
        public bool HasChildren => Children.Any();
        public HashSet<CategoryTreeNode> Children { get; set; } = new();
        public bool IsExpanded { get; set; }

        public override bool Equals(object? obj)
        {
            return obj is CategoryTreeNode node && ExternalId == node.ExternalId;
        }

        public override int GetHashCode()
        {
            return ExternalId.GetHashCode();
        }
    }
}
