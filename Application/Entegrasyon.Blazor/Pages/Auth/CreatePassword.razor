@page "/auth/create-password"
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Class="pa-8" Elevation="4" Style="width: 100%; max-width: 500px;">
        <MudGrid Justify="Justify.Center" Class="mb-6">
            <MudItem xs="12" Class="d-flex justify-center">
                <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Large" Color="Color.Success" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
                    Şifre Oluştur
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    İlk girişiniz için yeni bir şifre oluşturun
                </MudText>
            </MudItem>
        </MudGrid>

        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Email" 
                                  Label="E-posta" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="E-posta gerekli"
                                  Validation="@(new EmailAddressAttribute() { ErrorMessage = "Geçerli bir e-posta adresi girin" })"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ActivationCode" 
                                  Label="Aktivasyon Kodu" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Aktivasyon kodu gerekli"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Pin" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.NewPassword" 
                                  Label="Yeni Şifre" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Şifre gerekli"
                                  InputType="@_passwordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  HelperText="En az 8 karakter, büyük/küçük harf ve rakam içermeli" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ConfirmPassword" 
                                  Label="Şifre Tekrar" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Şifre tekrarı gerekli"
                                  InputType="@_passwordInput"
                                  Validation="@(new Func<string, string?>(ValidateConfirmPassword))" />
                </MudItem>

                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="HandleCreatePassword"
                               Disabled="@(!_isValid || _processing)">
                        @if (_processing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ml-2">Oluşturuluyor...</span>
                        }
                        else
                        {
                            <span>Şifre Oluştur</span>
                        }
                    </MudButton>
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-center">
                    <MudLink Href="/auth/login" Typo="Typo.body2">
                        Giriş sayfasına dön
                    </MudLink>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;
    private CreatePasswordModel _model = new();
    private InputType _passwordInput = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (_passwordInput == InputType.Password)
        {
            _passwordInput = InputType.Text;
            _passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _passwordInput = InputType.Password;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (confirmPassword != _model.NewPassword)
            return "Şifreler eşleşmiyor";
        return null;
    }

    private async Task HandleCreatePassword()
    {
        await _form.Validate();
        if (!_isValid) return;

        _processing = true;
        try
        {
            // TODO: Implement actual password creation
            // var result = await UserManager.CreatePasswordAsync(_model);
            // if (result.Success)
            // {
            //     Snackbar.Add("Şifre oluşturuldu. Giriş yapabilirsiniz.", Severity.Success);
            //     NavigationManager.NavigateTo("/auth/login");
            // }

            await Task.Delay(1000);
            Snackbar.Add("Şifre başarıyla oluşturuldu! Giriş sayfasına yönlendiriliyorsunuz...", Severity.Success);
            await Task.Delay(500);
            NavigationManager.NavigateTo("/auth/login");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private class CreatePasswordModel
    {
        public string Email { get; set; } = string.Empty;
        public string ActivationCode { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
