@page "/auth/reset-password"
@layout EmptyLayout
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Class="pa-8" Elevation="4" Style="width: 100%; max-width: 500px;">
        <MudGrid Justify="Justify.Center" Class="mb-6">
            <MudItem xs="12" Class="d-flex justify-center">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Color="Color.Warning" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
                    Şifre Sıfırlama
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    E-posta adresinize şifre sıfırlama linki gönderilecek
                </MudText>
            </MudItem>
        </MudGrid>

        @if (!_emailSent)
        {
            <MudForm @ref="_form" @bind-IsValid="@_isValid">
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_email" 
                                      Label="E-posta" 
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="E-posta gerekli"
                                      Validation="@(new EmailAddressAttribute() { ErrorMessage = "Geçerli bir e-posta adresi girin" })"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   FullWidth="true"
                                   Size="Size.Large"
                                   OnClick="HandleResetPassword"
                                   Disabled="@(!_isValid || _processing)">
                            @if (_processing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Gönderiliyor...</span>
                            }
                            else
                            {
                                <span>Şifre Sıfırlama Linki Gönder</span>
                            }
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-center">
                        <MudLink Href="/auth/login" Typo="Typo.body2">
                            Giriş sayfasına dön
                        </MudLink>
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Şifre sıfırlama linki <strong>@_email</strong> adresine gönderildi.
                Lütfen e-posta kutunuzu kontrol edin.
            </MudAlert>
            
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       FullWidth="true"
                       Href="/auth/login">
                Giriş Sayfasına Dön
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;
    private bool _emailSent;
    private string _email = string.Empty;

    private async Task HandleResetPassword()
    {
        await _form.Validate();
        if (!_isValid) return;

        _processing = true;
        try
        {
            // TODO: Implement actual password reset
            // var result = await UserManager.SendPasswordResetEmail(_email);
            // if (result.Success)
            // {
            //     _emailSent = true;
            // }

            await Task.Delay(1000);
            _emailSent = true;
            Snackbar.Add("Şifre sıfırlama linki gönderildi", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}
