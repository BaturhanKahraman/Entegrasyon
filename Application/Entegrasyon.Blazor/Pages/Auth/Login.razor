@page "/auth/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Entegrasyon.Business.Concrete.Auth
@using Entegrasyon.Blazor.ViewModels.Auth
@inject ApplicationUserManager UserManager
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Class="pa-8" Elevation="4" Style="width: 100%; max-width: 500px;">
        <MudGrid Justify="Justify.Center" Class="mb-6">
            <MudItem xs="12" Class="d-flex justify-center">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Large" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
                    Entegrasyon Platform
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    E-Commerce yönetim paneline hoş geldiniz
                </MudText>
            </MudItem>
        </MudGrid>

        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.UserName" 
                                  Label="Kullanıcı Adı" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Kullanıcı adı gerekli"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Password" 
                                  Label="Şifre" 
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Şifre gerekli"
                                  InputType="@_passwordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  AdornmentAriaLabel="Şifreyi göster/gizle" />
                </MudItem>



                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="HandleLogin"
                               Disabled="@(!_isValid || _processing)">
                        @if (_processing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span class="ml-2">Giriş yapılıyor...</span>
                        }
                        else
                        {
                            <span>Giriş Yap</span>
                        }
                    </MudButton>
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-space-between">
                    <MudLink Href="/auth/reset-password" Typo="Typo.body2">
                        Şifrenizi mi unuttunuz?
                    </MudLink>
                    <MudLink Href="/auth/create-password" Typo="Typo.body2">
                        İlk giriş?
                    </MudLink>
                </MudItem>
            </MudGrid>
        </MudForm>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
            © 2026 Entegrasyon Platform. Tüm hakları saklıdır.
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _processing;
    private LoginViewModel _model = new();
    private InputType _passwordInput = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (_passwordInput == InputType.Password)
        {
            _passwordInput = InputType.Text;
            _passwordIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _passwordInput = InputType.Password;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private async Task HandleLogin()
    {
        await _form.Validate();
        if (!_isValid) return;

        _processing = true;
        try
        {
            // TODO: Implement actual login with UserManager
            // var result = await UserManager.LoginAsync(_model);
            // if (result.Success)
            // {
            //     NavigationManager.NavigateTo("/", forceLoad: true);
            // }
            // else
            // {
            //     Snackbar.Add(result.Message, Severity.Error);
            // }

            // Mock login for now
            await Task.Delay(1000);
            
            if (_model.UserName == "admin" && _model.Password == "123456")
            {
                Snackbar.Add("Giriş başarılı! Yönlendiriliyorsunuz...", Severity.Success);
                await Task.Delay(500);
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                Snackbar.Add("Kullanıcı adı veya şifre hatalı", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Giriş hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}
