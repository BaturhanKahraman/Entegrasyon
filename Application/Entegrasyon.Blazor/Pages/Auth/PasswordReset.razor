@page "/auth/reset-password"
@layout Layouts.AuthLayout
@attribute [AllowAnonymous]
@using Entegrasyon.Business.Abstract
@using Entegrasyon.Entity.Results

@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Yeni Şifre Belirle</MudText>

<MudForm @bind-IsValid="@_isValid">

    @if (!string.IsNullOrEmpty(UserId))
    {
        <MudTextField @bind-Value="@_password" Label="Yeni Şifre" Variant="Variant.Outlined" InputType="InputType.Password"
            Class="mb-3" Required="true" RequiredError="Şifre gereklidir." />
        <MudTextField @bind-Value="@_confirmPassword" Label="Yeni Şifre (Tekrar)" Variant="Variant.Outlined"
            InputType="InputType.Password" Class="mb-3" Required="true" RequiredError="Şifre tekrarı gereklidir."
            Validation="@(new Func<string, IEnumerable<string>>(PasswordMatch))" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="SubmitAsync"
            Disabled="@(!_isValid || _isLoading)">
            @if (_isLoading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">İşleniyor...</MudText>
            }
            else
            {
                <MudText>Şifreyi Güncelle</MudText>
            }
        </MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Error">Geçersiz İstek</MudAlert>
    }

</MudForm>

@code {
    [SupplyParameterFromQuery]
    public string UserId { get; set; }

    private string _password;
    private string _confirmPassword;
    private bool _isValid;
    private bool _isLoading;

    private IEnumerable<string> PasswordMatch(string arg)
    {
        if (_password != arg)
            yield return "Şifreler eşleşmiyor.";
    }

    private async Task SubmitAsync()
    {
        if (!_isValid) return;

        if (Guid.TryParse(UserId, out var guidId))
        {
            _isLoading = true;
            try
            {
                var result = await AuthService.CreatePassword(_password, guidId);
                if (result.Success)
                {
                    Snackbar.Add(result.Message, Severity.Success);
                    NavigationManager.NavigateTo("/auth/login");
                }
                else
                {
                    Snackbar.Add(result.Message, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Bir hata oluştu: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isLoading = false;
            }
        }
        else
        {
            Snackbar.Add("Geçersiz Kullanıcı ID", Severity.Error);
        }
    }
}
