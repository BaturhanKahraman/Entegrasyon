@page "/sales"
@using Entegrasyon.Business.Concrete
@using Entegrasyon.Entity.Products
@using Entegrasyon.Entity.Dtos.Product

<PageTitle>Satış - POS</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Satış Noktası (POS)</MudText>

<MudGrid>
    <!-- Left Panel: Product Search & Cart -->
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" md="9">
                    <MudTextField @bind-Value="_barcodeSearch"
                                  Label="Barkod Okut veya Ürün Ara"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                                  OnKeyDown="HandleBarcodeSearch"
                                  Immediate="true"
                                  Placeholder="Barkod okutun veya ürün adı girin..." />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.PersonSearch"
                               FullWidth="true"
                               OnClick="OpenCustomerSearch">
                        Müşteri Seç
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_selectedCustomer != null)
            {
                <MudChip T="string" Color="Color.Success"
                         Size="Size.Small"
                         OnClose="ClearCustomer"
                         Class="mt-2">
                    Müşteri: @_selectedCustomer.Name
                </MudChip>
            }
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Sepet</MudText>

            @if (_cartItems.Any())
            {
                <MudTable Items="@_cartItems" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Ürün</MudTh>
                        <MudTh>Beden</MudTh>
                        <MudTh>Adet</MudTh>
                        <MudTh>Birim Fiyat</MudTh>
                        <MudTh>İndirim</MudTh>
                        <MudTh>Toplam</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ürün">@context.ProductName</MudTd>
                        <MudTd DataLabel="Beden">@context.Size</MudTd>
                        <MudTd DataLabel="Adet">
                            <MudNumericField @bind-Value="context.Quantity"
                                           Min="1"
                                           Step="1"
                                           Immediate="true"
                                           OnBlur="RecalculateTotal"
                                           Style="width: 80px;" />
                        </MudTd>
                        <MudTd DataLabel="Birim Fiyat">₺@context.UnitPrice.ToString("F2")</MudTd>
                        <MudTd DataLabel="İndirim">
                            <MudNumericField @bind-Value="context.DiscountPercent"
                                           Min="0"
                                           Max="100"
                                           Step="5"
                                           Immediate="true"
                                           Adornment="Adornment.End"
                                           AdornmentText="%"
                                           OnBlur="RecalculateTotal"
                                           Style="width: 90px;" />
                        </MudTd>
                        <MudTd DataLabel="Toplam">₺@context.TotalPrice.ToString("F2")</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                         Size="Size.Small"
                                         Color="Color.Error"
                                         OnClick="@(() => RemoveFromCart(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Align="Align.Center" Color="Color.Secondary" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Class="mb-2" />
                    <br />
                    Sepet boş. Ürün eklemek için barkod okutun.
                </MudText>
            }
        </MudPaper>
    </MudItem>

    <!-- Right Panel: Summary & Payment -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-4">Ödeme Özeti</MudText>

            <MudList T="string" Dense="true">
                <MudListItem T="string">
                    <div class="d-flex justify-space-between" style="width: 100%">
                        <MudText>Ara Toplam:</MudText>
                        <MudText Typo="Typo.h6">₺@_subtotal.ToString("F2")</MudText>
                    </div>
                </MudListItem>

                @if (_totalDiscount > 0)
                {
                    <MudListItem T="string">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Color="Color.Success">İndirim:</MudText>
                            <MudText Color="Color.Success">-₺@_totalDiscount.ToString("F2")</MudText>
                        </div>
                    </MudListItem>
                }

                <MudDivider />

                <MudListItem T="string">
                    <div class="d-flex justify-space-between" style="width: 100%">
                        <MudText>KDV (%20):</MudText>
                        <MudText Typo="Typo.body1">₺@_tax.ToString("F2")</MudText>
                    </div>
                </MudListItem>

                <MudDivider />

                <MudListItem T="string">
                    <div class="d-flex justify-space-between" style="width: 100%">
                        <MudText Typo="Typo.h5">Toplam:</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">₺@_total.ToString("F2")</MudText>
                    </div>
                </MudListItem>
            </MudList>

            <MudDivider Class="my-4" />

            <MudSelect T="string"
                       @bind-Value="_paymentMethod"
                       Label="Ödeme Yöntemi"
                       Variant="Variant.Outlined"
                       Class="mb-4">
                <MudSelectItem Value="@("Nakit")">💵 Nakit</MudSelectItem>
                <MudSelectItem Value="@("Kredi Kartı")">💳 Kredi Kartı</MudSelectItem>
                <MudSelectItem Value="@("Banka Kartı")">🏦 Banka Kartı</MudSelectItem>
                <MudSelectItem Value="@("Havale/EFT")">🔄 Havale/EFT</MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@(!_cartItems.Any() || _processing)"
                       OnClick="CompleteSale"
                       StartIcon="@Icons.Material.Filled.ShoppingCart">
                @if (_processing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <span class="ml-2">İşleniyor...</span>
                }
                else
                {
                    <span>Satışı Tamamla (₺@_total.ToString("F2"))</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       FullWidth="true"
                       Class="mt-2"
                       Disabled="@(!_cartItems.Any())"
                       OnClick="ClearCart">
                Sepeti Temizle
            </MudButton>
        </MudPaper>

        <!-- Recent Sales -->
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Bugünkü Satışlar</MudText>
            <MudDivider Class="mb-3" />
            <MudList T="string" Dense="true">
                <MudListItem T="string">
                    <div class="d-flex justify-space-between" style="width: 100%">
                        <MudText Typo="Typo.body2">Toplam Satış:</MudText>
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">0 adet</MudChip>
                    </div>
                </MudListItem>
                <MudListItem T="string">
                    <div class="d-flex justify-space-between" style="width: 100%">
                        <MudText Typo="Typo.body2">Toplam Gelir:</MudText>
                        <MudText Typo="Typo.h6">₺0.00</MudText>
                    </div>
                </MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>
