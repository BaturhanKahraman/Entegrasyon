@page "/categories"
@using Entegrasyon.Business.Concrete
@using Entegrasyon.Entity.Categories
@using Entegrasyon.Blazor.Services.Channels
@using Entegrasyon.Blazor.Services.Channels.Events
@using Entegrasyon.Blazor.Components.Dialogs
@inject CategoryManager CategoryManager
@inject EventChannel<CategoryUpdatedEvent> CategoryEventChannel
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Kategoriler</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Kategori Yönetimi</MudText>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Style="height: 700px; overflow-y: auto;">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Kategori Ağacı</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Download"
                               Size="Size.Small"
                               OnClick="@(() => NavigationManager.NavigateTo("/categories/import"))">
                        İçe Aktar
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Size="Size.Small"
                               OnClick="OpenAddCategoryDialog">
                        Yeni
                    </MudButton>
                </div>
            </div>

            <MudTextField @bind-Value="_searchString"
                          Placeholder="Kategori ara..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="mb-4" />

            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_treeItems.Any())
            {
                <MudTreeView T="CategoryTreeItem"
                             Items="@GetTreeItemsForView()"
                             Hover="true"
                             SelectedValueChanged="OnCategorySelected">
                    <ItemTemplate Context="item">
                        <div class="d-flex align-center justify-space-between" style="width: 100%">
                            <MudText>@item.Value?.Category.Name</MudText>
                            <div class="d-flex gap-1">
                                @if (item.Value?.Category.IsFavorite == true)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star"
                                             Color="Color.Warning"
                                             Size="Size.Small" />
                                }
                                @if (item.Value?.Category.IsImported == true)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CloudDownload"
                                             Color="Color.Info"
                                             Size="Size.Small" />
                                }
                                @if (item.Value?.Children.Any() == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                        @item.Value.Children.Count
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </ItemTemplate>
                </MudTreeView>
            }
            else
            {
                <MudText Align="Align.Center" Color="Color.Secondary">Kategori bulunamadı</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Style="min-height: 700px;">
            @if (_selectedCategory != null)
            {
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6">Kategori Detayları</MudText>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   OnClick="EditSelectedCategory">
                            Düzenle
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   OnClick="DeleteSelectedCategory">
                            Sil
                        </MudButton>
                    </div>
                </div>

                <MudGrid>
                    <MudItem xs="12">
                        <MudCard Elevation="0" Outlined="true">
                            <MudCardContent>
                                <MudText Typo="Typo.h5" Class="mb-2">@_selectedCategory.Name</MudText>
                                <div class="d-flex gap-2 mb-4">
                                    @if (_selectedCategory.IsFavorite)
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                                            Favori
                                        </MudChip>
                                    }
                                    @if (_selectedCategory.IsImported)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.CloudDownload">
                                            İçe Aktarıldı
                                        </MudChip>
                                    }
                                </div>

                                <MudDivider Class="my-3" />

                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Kategori ID</MudText>
                                <MudText Typo="Typo.body1" Class="mb-3">@_selectedCategory.Id</MudText>

                                @if (_selectedCategory.SuperCategoryId.HasValue)
                                {
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Üst Kategori</MudText>
                                    <MudText Typo="Typo.body1" Class="mb-3">
                                        @GetParentCategoryName(_selectedCategory.SuperCategoryId.Value)
                                    </MudText>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudCard Elevation="0" Outlined="true">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Kategori Özellikleri</MudText>
                                </CardHeaderContent>
                                <CardHeaderActions>
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                        @(_selectedCategory.CategoryAttributes?.Count ?? 0) özellik
                                    </MudChip>
                                </CardHeaderActions>
                            </MudCardHeader>
                            <MudCardContent>
                                @if (_selectedCategory.CategoryAttributes?.Any() == true)
                                {
                                    <MudList T="string" Dense="true">
                                        @foreach (var attr in _selectedCategory.CategoryAttributes)
                                        {
                                            <MudListItem T="string" Icon="@Icons.Material.Filled.Label">
                                                <div class="d-flex justify-space-between">
                                                    <MudText>@(attr.CategoryAttribute?.CategoryAttributeHumanized ?? "N/A")</MudText>
                                                    <MudChip T="string" Size="Size.Small">
                                                        @(attr.IsRequired ? "Zorunlu" : "Opsiyonel")
                                                    </MudChip>
                                                </div>
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                                else
                                {
                                    <MudText Align="Align.Center" Color="Color.Secondary">
                                        Bu kategoriye özellik eklenmemiş
                                    </MudText>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudCard Elevation="0" Outlined="true">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Pazaryeri Eşleşmeleri</MudText>
                                </CardHeaderContent>
                                <CardHeaderActions>
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                        @(_selectedCategory.MarketplaceLinks?.Count ?? 0) eşleşme
                                    </MudChip>
                                </CardHeaderActions>
                            </MudCardHeader>
                            <MudCardContent>
                                @if (_selectedCategory.MarketplaceLinks?.Any() == true)
                                {
                                    <MudList T="string" Dense="true">
                                        @foreach (var link in _selectedCategory.MarketplaceLinks)
                                        {
                                            <MudListItem T="string" Icon="@Icons.Material.Filled.Link">
                                                <div class="d-flex justify-space-between align-center" style="width: 100%">
                                                    <div>
                                                        <MudText>@(link.MarketPlace?.Name ?? "N/A")</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @link.MarketPlaceCategoryName (ID: @link.ExternalCategoryId)
                                                        </MudText>
                                                    </div>
                                                    <MudChip T="string" Size="Size.Small" Color="@(link.IsActive ? Color.Success : Color.Default)">
                                                        @(link.IsActive ? "Aktif" : "Pasif")
                                                    </MudChip>
                                                </div>
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                                else
                                {
                                    <MudText Align="Align.Center" Color="Color.Secondary">
                                        Pazaryeri eşleşmesi yok
                                    </MudText>
                                    <div class="d-flex justify-center mt-2">
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   Href="/categories/import">
                                            Kategorileri İçe Aktar
                                        </MudButton>
                                    </div>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" Class="mt-4">
                        <MudCard Elevation="0" Outlined="true">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">İstatistikler</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudGrid>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Ürün</MudText>
                                        <MudText Typo="Typo.h5">0</MudText>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Alt Kategoriler</MudText>
                                        <MudText Typo="Typo.h5">@GetSubcategoryCount(_selectedCategory.Id)</MudText>
                                    </MudItem>
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudText Align="Align.Center" Color="Color.Secondary" Class="py-8">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Class="mb-4" />
                    <br />
                    Detayları görmek için bir kategori seçin
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    #nullable enable
    private List<Category> _categories = new();
    private List<CategoryTreeItem> _treeItems = new();
    private Category? _selectedCategory;
    private bool _loading = true;
    private string _searchString = string.Empty;
    #nullable disable

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        _loading = true;
        try
        {
            var result = await CategoryManager.GetCategoryDetailList();
            if (result.Success && result.Data != null)
            {
                // CategoryDetailDto'dan Category'ye dönüştürme işlemi için
                // Ayrı bir query kullanıyoruz
                _categories = await CategoryManager.GetAllCategoriesWithHierarchyAsync();
                BuildCategoryTree();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Kategoriler yüklenemedi", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kategoriler yüklenirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildCategoryTree()
    {
        var rootCategories = _categories.Where(c => !c.SuperCategoryId.HasValue).ToList();
        _treeItems = rootCategories.Select(c => BuildTreeItem(c)).ToList();
    }

    private CategoryTreeItem BuildTreeItem(Category category)
    {
        var item = new CategoryTreeItem
        {
            Category = category,
            IsExpanded = false
        };

        var children = _categories.Where(c => c.SuperCategoryId == category.Id).ToList();
        item.Children = children.Select(c => BuildTreeItem(c)).ToList();

        return item;
    }

    private void OnCategorySelected(CategoryTreeItem item)
    {
        _selectedCategory = item.Category;
    }

    private void SelectCategory(Category category)
    {
        _selectedCategory = category;
    }

    private async Task OpenAddCategoryDialog()
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.IsEditMode, false }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<CategoryDialog>("Yeni Kategori Ekle", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCategories();
        }
    }

    private async Task EditSelectedCategory()
    {
        if (_selectedCategory == null) return;

        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.Category, _selectedCategory },
            { x => x.IsEditMode, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<CategoryDialog>($"Kategori Düzenle: {_selectedCategory.Name}", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCategories();
        }
    }

    private async Task DeleteSelectedCategory()
    {
        if (_selectedCategory == null) return;

        // Alt kategori kontrolü
        var hasSubCategories = _categories.Any(c => c.SuperCategoryId == _selectedCategory.Id);
        if (hasSubCategories)
        {
            Snackbar.Add("Bu kategorinin alt kategorileri var. Önce alt kategorileri silmeniz gerekir.", Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Uyarı",
            $"'{_selectedCategory.Name}' kategorisini silmek istediğinize emin misiniz? Bu işlem geri alınamaz.",
            yesText: "Sil", cancelText: "İptal");

        if (confirm == true)
        {
            try
            {
                var result = await CategoryManager.SoftDelete(_selectedCategory.Id);
                if (result.Success)
                {
                    Snackbar.Add(result.Message, Severity.Success);
                    await CategoryEventChannel.PublishAsync(new CategoryUpdatedEvent(_selectedCategory.Id, "Deleted"));
                    _selectedCategory = null;
                    await LoadCategories();
                }
                else
                {
                    Snackbar.Add(result.Message, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Kategori silinirken hata: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetCategoryIcon(CategoryTreeItem item)
    {
        if (item.Children.Any())
            return item.IsExpanded ? Icons.Material.Filled.Folder : Icons.Material.Filled.Folder;
        return Icons.Material.Filled.Category;
    }

    private Color GetCategoryIconColor(CategoryTreeItem item)
    {
        if (item.Category.IsFavorite)
            return Color.Warning;
        if (item.Category.IsImported)
            return Color.Info;
        return item.Children.Any() ? Color.Primary : Color.Default;
    }

    private string GetParentCategoryName(int parentId)
    {
        return _categories.FirstOrDefault(c => c.Id == parentId)?.Name ?? "N/A";
    }

    private int GetSubcategoryCount(int categoryId)
    {
        return _categories.Count(c => c.SuperCategoryId == categoryId);
    }

    private IReadOnlyCollection<TreeItemData<CategoryTreeItem>> GetTreeItemsForView()
    {
        return _treeItems.Select(ConvertToTreeItemData).ToList();
    }

    private TreeItemData<CategoryTreeItem> ConvertToTreeItemData(CategoryTreeItem item)
    {
        return new TreeItemData<CategoryTreeItem>
        {
            Value = item,
            Children = item.Children.Select(ConvertToTreeItemData).ToList(),
            Expandable = item.Children.Any(),
            Expanded = item.IsExpanded
        };
    }

    private class CategoryTreeItem
    {
        public Category Category { get; set; } = null!;
        public List<CategoryTreeItem> Children { get; set; } = new();
        public bool IsExpanded { get; set; }
    }
}
