@page "/categories"
@using Entegrasyon.Business.Concrete
@using Entegrasyon.Entity.Categories
@using Entegrasyon.Blazor.Services.Channels
@using Entegrasyon.Blazor.Services.Channels.Events
@using Entegrasyon.Blazor.Components.Dialogs
@using Entegrasyon.Blazor.Components.Shared
@inject CategoryManager CategoryManager
@inject EventChannel<CategoryUpdatedEvent> CategoryEventChannel
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Kategoriler</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Kategori Yönetimi</MudText>

<MudGrid>
    <MudItem xs="12" md="5">
        <CategoryTreePanel TreeItems="@GetTreeItemsForView()"
                          Loading="@_loading"
                          SearchString="@_searchString"
                          CategorySelected="@(EventCallback.Factory.Create<Category>(this, OnCategorySelected))"
                          OnAddClicked="@OpenAddCategoryDialog"
                          OnImportClicked="@(() => NavigationManager.NavigateTo("/categories/import"))"
                          FilterChanged="@((searchString) => _searchString = searchString)" />
    </MudItem>

    <MudItem xs="12" md="7">
        <CategoryDetailsPanel SelectedCategory="@_selectedCategory"
                             SubcategoryCount="@(_selectedCategory != null ? GetSubcategoryCount(_selectedCategory.Id) : 0)"
                             OnEditClicked="@EditSelectedCategory"
                             OnDeleteClicked="@DeleteSelectedCategory"
                             GetParentCategoryNameFunc="@GetParentCategoryName" />
    </MudItem>
</MudGrid>

@code {
    #nullable enable
    private List<Category> _categories = new();
    private List<CategoryTreeItem> _treeItems = new();
    private Category? _selectedCategory;
    private bool _loading = true;
    private string _searchString = string.Empty;
    #nullable disable

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        _loading = true;
        try
        {
            var result = await CategoryManager.GetCategoryDetailList();
            if (result.Success && result.Data != null)
            {
                // CategoryDetailDto'dan Category'ye dönüştürme işlemi için
                // Ayrı bir query kullanıyoruz
                _categories = await CategoryManager.GetAllCategoriesWithHierarchyAsync();
                BuildCategoryTree();
            }
            else
            {
                Snackbar.Add(result.Message ?? "Kategoriler yüklenemedi", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kategoriler yüklenirken hata oluştu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildCategoryTree()
    {
        var rootCategories = _categories.Where(c => !c.SuperCategoryId.HasValue).ToList();
        _treeItems = rootCategories.Select(c => BuildTreeItem(c)).ToList();
    }

    private CategoryTreeItem BuildTreeItem(Category category)
    {
        var item = new CategoryTreeItem
        {
            Category = category,
            IsExpanded = false
        };

        var children = _categories.Where(c => c.SuperCategoryId == category.Id).ToList();
        item.Children = children.Select(c => BuildTreeItem(c)).ToList();

        return item;
    }

    private void OnCategorySelected(Category item)
    {
        _selectedCategory = item;
    }

    private void SelectCategory(Category category)
    {
        _selectedCategory = category;
    }

    private async Task OpenAddCategoryDialog()
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.IsEditMode, false }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<CategoryDialog>("Yeni Kategori Ekle", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCategories();
        }
    }

    private async Task EditSelectedCategory()
    {
        if (_selectedCategory == null) return;

        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.Category, _selectedCategory },
            { x => x.IsEditMode, true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<CategoryDialog>($"Kategori Düzenle: {_selectedCategory.Name}", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCategories();
        }
    }

    private async Task DeleteSelectedCategory()
    {
        if (_selectedCategory == null) return;

        // Alt kategori kontrolü
        var hasSubCategories = _categories.Any(c => c.SuperCategoryId == _selectedCategory.Id);
        if (hasSubCategories)
        {
            Snackbar.Add("Bu kategorinin alt kategorileri var. Önce alt kategorileri silmeniz gerekir.", Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Uyarı",
            $"'{_selectedCategory.Name}' kategorisini silmek istediğinize emin misiniz? Bu işlem geri alınamaz.",
            yesText: "Sil", cancelText: "İptal");

        if (confirm == true)
        {
            try
            {
                var result = await CategoryManager.SoftDelete(_selectedCategory.Id);
                if (result.Success)
                {
                    Snackbar.Add(result.Message, Severity.Success);
                    await CategoryEventChannel.PublishAsync(new CategoryUpdatedEvent(_selectedCategory.Id, "Deleted"));
                    _selectedCategory = null;
                    await LoadCategories();
                }
                else
                {
                    Snackbar.Add(result.Message, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Kategori silinirken hata: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetCategoryIcon(CategoryTreeItem item)
    {
        if (item.Children.Any())
            return item.IsExpanded ? Icons.Material.Filled.Folder : Icons.Material.Filled.Folder;
        return Icons.Material.Filled.Category;
    }

    private Color GetCategoryIconColor(CategoryTreeItem item)
    {
        if (item.Category.IsFavorite)
            return Color.Warning;
        if (item.Category.IsImported)
            return Color.Info;
        return item.Children.Any() ? Color.Primary : Color.Default;
    }

    private string GetParentCategoryName(int parentId)
    {
        return _categories.FirstOrDefault(c => c.Id == parentId)?.Name ?? "N/A";
    }

    private int GetSubcategoryCount(int categoryId)
    {
        return _categories.Count(c => c.SuperCategoryId == categoryId);
    }

    private List<Category> GetTreeItemsForView()
    {
        return _categories.Where(c => c.SuperCategoryId == null).ToList();
    }

    private class CategoryTreeItem
    {
        public Category Category { get; set; } = null!;
        public List<CategoryTreeItem> Children { get; set; } = new();
        public bool IsExpanded { get; set; }
    }
}
