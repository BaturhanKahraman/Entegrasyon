@page "/settings/general"
@using Entegrasyon.ApplicationBootstrap.Security
@using Entegrasyon.Entity.Dtos.Settings
@using Entegrasyon.Entity.Settings
@attribute [Authorize(Policy = AppPermissions.Settings.View)]

<PageTitle>Genel Ayarlar</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Genel Ayarlar</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    @foreach (var group in _settingsByGroup)
    {
        <MudPaper @key="group.Key" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">@group.Key</MudText>
            <MudGrid>
                @foreach (var setting in group.Value)
                {
                    <MudItem @key="setting.Key" xs="12" md="6">
                        @if (setting.Key == "ThemeMode")
                        {
                            <MudSelect T="string"
                                       Label="@setting.Description"
                                       Value="@setting.Value"
                                       ValueChanged="@(v => setting.Value = v)"
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="@("system")">Sisteme Göre</MudSelectItem>
                                <MudSelectItem Value="@("light")">Aydınlık</MudSelectItem>
                                <MudSelectItem Value="@("dark")">Karanlık</MudSelectItem>
                            </MudSelect>
                        }
                        else
                        {
                            @switch (setting.ValueType)
                            {
                                case SettingValueType.Boolean:
                                    <MudSwitch T="bool"
                                               Label="@setting.Description"
                                               Value="@(bool.TryParse(setting.Value, out var b) && b)"
                                               ValueChanged="@(v => setting.Value = v.ToString().ToLower())"
                                               Color="Color.Primary" />
                                    break;
                                case SettingValueType.Integer:
                                    <MudNumericField T="int"
                                                     Label="@setting.Description"
                                                     Value="@(int.TryParse(setting.Value, out var i) ? i : 0)"
                                                     ValueChanged="@(v => setting.Value = v.ToString())"
                                                     Variant="Variant.Outlined" />
                                    break;
                                case SettingValueType.Decimal:
                                    <MudNumericField T="decimal"
                                                     Label="@setting.Description"
                                                     Value="@(decimal.TryParse(setting.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0)"
                                                     ValueChanged="@(v => setting.Value = v.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                     Variant="Variant.Outlined" />
                                    break;
                                case SettingValueType.Password:
                                    <MudTextField T="string"
                                                  Label="@setting.Description"
                                                  @bind-Value="setting.Value"
                                                  Variant="Variant.Outlined"
                                                  InputType="@(_showPasswords.GetValueOrDefault(setting.Key) ? InputType.Text : InputType.Password)"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@(_showPasswords.GetValueOrDefault(setting.Key) ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                  OnAdornmentClick="@(() => TogglePasswordVisibility(setting.Key))"
                                                  AdornmentAriaLabel="Şifreyi göster/gizle" />
                                    break;
                                default:
                                    <MudTextField T="string"
                                                  Label="@setting.Description"
                                                  @bind-Value="setting.Value"
                                                  Variant="Variant.Outlined" />
                                    break;
                            }
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="SaveSettingsAsync"
               Disabled="_saving">
        @if (_saving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Kaydet
    </MudButton>

    @if (_settingsByGroup.ContainsKey("E-posta Ayarları"))
    {
        <MudDivider Class="my-4" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Mail"
                       OnClick="TestSmtpConnectionAsync"
                       Disabled="_testingSmtp">
                @if (_testingSmtp)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                SMTP Bağlantısını Test Et
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="SendTestEmailAsync"
                       Disabled="_sendingTestEmail">
                @if (_sendingTestEmail)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Test E-postası Gönder
            </MudButton>
        </MudStack>
    }
}
