@page "/settings/general"
@using Entegrasyon.ApplicationBootstrap.Security
@using Entegrasyon.Entity.Dtos.Settings
@using Entegrasyon.Entity.Settings
@attribute [Authorize(Policy = AppPermissions.Settings.View)]

<PageTitle>Genel Ayarlar</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Genel Ayarlar</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    @foreach (var group in _settingsByGroup)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">@group.Key</MudText>
            <MudGrid>
                @foreach (var setting in group.Value)
                {
                    <MudItem xs="12" md="6">
                        @switch (setting.ValueType)
                        {
                            case SettingValueType.Boolean:
                                <MudSwitch T="bool"
                                           Label="@setting.Description"
                                           Value="@(bool.TryParse(setting.Value, out var b) && b)"
                                           ValueChanged="@(v => setting.Value = v.ToString().ToLower())"
                                           Color="Color.Primary" />
                                break;
                            case SettingValueType.Integer:
                                <MudNumericField T="int"
                                                 Label="@setting.Description"
                                                 Value="@(int.TryParse(setting.Value, out var i) ? i : 0)"
                                                 ValueChanged="@(v => setting.Value = v.ToString())"
                                                 Variant="Variant.Outlined" />
                                break;
                            case SettingValueType.Decimal:
                                <MudNumericField T="decimal"
                                                 Label="@setting.Description"
                                                 Value="@(decimal.TryParse(setting.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0)"
                                                 ValueChanged="@(v => setting.Value = v.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                 Variant="Variant.Outlined" />
                                break;
                            default:
                                <MudTextField T="string"
                                              Label="@setting.Description"
                                              @bind-Value="setting.Value"
                                              Variant="Variant.Outlined" />
                                break;
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="SaveSettingsAsync"
               Disabled="_saving">
        @if (_saving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Kaydet
    </MudButton>
}
