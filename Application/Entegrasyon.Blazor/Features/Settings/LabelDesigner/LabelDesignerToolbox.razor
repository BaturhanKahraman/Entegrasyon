<MudPaper Elevation="0" Class="pa-3">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Elemanlar</MudText>
    <MudStack Spacing="1">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Title"
                   OnClick="@(() => OnAddElement.InvokeAsync("Title"))">
            Başlık
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Info"
                   OnClick="@(() => OnAddElement.InvokeAsync("VariantInfo"))">
            Varyant Bilgisi
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.QrCode"
                   OnClick="@(() => OnAddElement.InvokeAsync("Barcode"))">
            Barkod
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Sell"
                   OnClick="@(() => OnAddElement.InvokeAsync("SalePrice"))">
            Satış Fiyatı
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.PriceChange"
                   OnClick="@(() => OnAddElement.InvokeAsync("ListPrice"))">
            Liste Fiyatı
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.TextFields"
                   OnClick="@(() => OnAddElement.InvokeAsync("CustomText"))">
            Özel Yazı
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.HorizontalRule"
                   OnClick="@(() => OnAddElement.InvokeAsync("Line"))">
            Çizgi
        </MudButton>
    </MudStack>
</MudPaper>
