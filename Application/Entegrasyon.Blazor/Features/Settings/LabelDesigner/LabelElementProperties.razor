@if (Element is not null)
{
    <MudPaper Elevation="0" Class="pa-3">
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            Eleman Özellikleri
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="ml-2">
                @GetElementTypeLabel(Element.ElementType)
            </MudChip>
        </MudText>

        <MudGrid Spacing="1">
            <MudItem xs="6">
                <MudNumericField T="double" Label="X" Value="Element.X" Step="1"
                                 ValueChanged="x => UpdateProperty(e => e.X = x)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="double" Label="Y" Value="Element.Y" Step="1"
                                 ValueChanged="y => UpdateProperty(e => e.Y = y)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="double" Label="Genişlik" Value="Element.Width" Step="1" Min="20"
                                 ValueChanged="w => UpdateProperty(e => e.Width = w)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="double" Label="Yükseklik" Value="Element.Height" Step="1" Min="10"
                                 ValueChanged="h => UpdateProperty(e => e.Height = h)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        @if (Element.ElementType != "Line" && Element.ElementType != "Barcode")
        {
            <MudNumericField T="int" Label="Font Boyutu" Value="Element.FontSize" Min="10" Max="80" Step="2"
                             ValueChanged="fs => UpdateProperty(e => e.FontSize = fs)"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />

            <MudSwitch T="bool" Label="Kalın" Value="Element.Bold" Color="Color.Primary"
                       ValueChanged="b => UpdateProperty(e => e.Bold = b)" Class="mt-1" />
        }

        @if (Element.ElementType == "ListPrice")
        {
            <MudSwitch T="bool" Label="Üstü Çizili" Value="Element.Strikethrough" Color="Color.Primary"
                       ValueChanged="s => UpdateProperty(e => e.Strikethrough = s)" Class="mt-1" />
        }

        @if (Element.ElementType == "CustomText")
        {
            <MudTextField T="string" Label="Özel Metin" Value="Element.CustomText"
                          ValueChanged="t => UpdateProperty(e => e.CustomText = t)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Delete" FullWidth="true"
                   OnClick="() => OnDeleted.InvokeAsync()" Class="mt-3">
            Elemanı Sil
        </MudButton>
    </MudPaper>
}
else
{
    <MudPaper Elevation="0" Class="pa-3">
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            Düzenlemek için bir eleman seçin
        </MudText>
    </MudPaper>
}
