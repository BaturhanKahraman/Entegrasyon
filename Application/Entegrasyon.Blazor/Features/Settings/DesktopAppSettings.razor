@page "/settings/desktop"
@using Entegrasyon.ApplicationBootstrap.Security
@attribute [Authorize(Policy = AppPermissions.Settings.View)]

<PageTitle>Masaustu Uygulamasi</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Masaustu Uygulamasi</MudText>

<MudGrid>
    @* Uygulama Hakkinda *@
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-6 mb-4">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Color="Color.Primary" Size="Size.Large" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5">Entegrasyon Desktop</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Cevrimdisi POS, barkod yazici ve otomatik guncelleme destegi
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudDivider />

                <MudText Typo="Typo.body1">
                    Entegrasyon Desktop uygulamasi, internet baglantisi olmadan satis yapmanizi,
                    barkod yazicilariniza dogrudan yazdirmanizi ve verilerinizi otomatik senkronize etmenizi saglar.
                    Uygulama icerisinde gomulu Print Agent sayesinde ayri bir yazici servisi kurmaya gerek yoktur.
                </MudText>

                <MudStack Row="true" Spacing="4">
                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.WifiOff" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2"><strong>Cevrimdisi Satis</strong></MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Internet kesildiginde bile satis yapabilir, baglanti geldiginde otomatik senkronize eder
                        </MudText>
                    </MudStack>

                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2"><strong>Gomulu Print Agent</strong></MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Barkod ve fis yazicilarina dogrudan yazdirma — ayri kurulum gerektirmez
                        </MudText>
                    </MudStack>

                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2"><strong>Otomatik Guncelleme</strong></MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Velopack ile otomatik guncelleme — yeni surumler otomatik indirilir
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* Versiyon Bilgisi *@
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Surum Bilgisi</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <tbody>
                        <tr>
                            <td><strong>Surum</strong></td>
                            <td>@AppVersion</td>
                        </tr>
                        <tr>
                            <td><strong>Framework</strong></td>
                            <td>.NET 8</td>
                        </tr>
                        <tr>
                            <td><strong>UI</strong></td>
                            <td>Photino.Blazor + MudBlazor</td>
                        </tr>
                        <tr>
                            <td><strong>Print Agent</strong></td>
                            <td>Gomulu (port 19100)</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    </MudItem>

    @* Platform Bazli Indirme Linkleri *@
    <MudItem xs="12">
        <MudText Typo="Typo.h5" Class="mb-3">Indirme</MudText>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@WindowsIcon" Color="Color.Info" />
                        <MudText Typo="Typo.h6">Windows</MudText>
                    </MudStack>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">x64</MudChip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Windows 10/11 (64-bit) icin kurulum dosyasi. Velopack installer ile otomatik guncelleme destegi.
                </MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Gereksinimler: Windows 10 veya uzeri, .NET 8 Runtime (installer otomatik kurar)
                </MudAlert>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           Href="@WindowsDownloadUrl" Target="_blank"
                           Disabled="@(!IsDownloadAvailable)">
                    Windows Installer Indir
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@LinuxIcon" Color="Color.Success" />
                        <MudText Typo="Typo.h6">Linux</MudText>
                    </MudStack>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">x64</MudChip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Ubuntu 20.04+, Fedora 38+, Debian 11+ destekli AppImage veya tar.gz paketi.
                </MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Gereksinimler: GTK3 veya WebKit2GTK, .NET 8 Runtime
                </MudAlert>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           Href="@LinuxDownloadUrl" Target="_blank"
                           Disabled="@(!IsDownloadAvailable)">
                    Linux Paketi Indir
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    @if (!IsDownloadAvailable)
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Indirme linkleri henuz yapilandirilmamistir. Sistem yoneticisiyle iletisime gecin
                veya Entegrasyonlar ayarlarindan guncelleme URL'sini tanimlayiniz.
            </MudAlert>
        </MudItem>
    }

    @* Kurulum Talimatlari *@
    <MudItem xs="12">
        <MudText Typo="Typo.h5" Class="mb-3 mt-2">Kurulum Talimatlari</MudText>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6" Color="Color.Info">
                    <MudIcon Icon="@WindowsIcon" Class="mr-1" Size="Size.Small" /> Windows Kurulumu
                </MudText>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@Icons.Material.Filled.LooksOne" IconColor="Color.Primary">
                        Yukardaki indirme butonuyla <strong>Setup.exe</strong> dosyasini indirin
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.LooksTwo" IconColor="Color.Primary">
                        Indirilen dosyayi cift tiklayarak calistirin
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Looks3" IconColor="Color.Primary">
                        Gelen guvenlik uyarisinda <strong>"Yine de Calistir"</strong> secin
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Looks4" IconColor="Color.Primary">
                        Kurulum tamamlandiginda uygulama otomatik olarak acilir
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Looks5" IconColor="Color.Primary">
                        Sunucu URL'si ve API anahtarini girin, <strong>"Baglan"</strong> butonuna basin
                    </MudListItem>
                </MudList>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6" Color="Color.Success">
                    <MudIcon Icon="@LinuxIcon" Class="mr-1" Size="Size.Small" /> Linux Kurulumu
                </MudText>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@Icons.Material.Filled.LooksOne" IconColor="Color.Primary">
                        <code>tar -xzf EntegrasyonDesktop-linux-x64.tar.gz</code> ile arsivi acin
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.LooksTwo" IconColor="Color.Primary">
                        <code>chmod +x EntegrasyonDesktop</code> ile calistirilabilir yapin
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Looks3" IconColor="Color.Primary">
                        <code>./EntegrasyonDesktop</code> ile uygulamayi baslatiniz
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Looks4" IconColor="Color.Primary">
                        Sunucu URL'si ve API anahtarini girin, <strong>"Baglan"</strong> butonuna basin
                    </MudListItem>
                </MudList>
                <MudAlert Severity="Severity.Info" Dense="true">
                    GTK3 veya WebKit2GTK paketinin yuklenmis olmasi gerekmektedir.
                    <br/>Ubuntu: <code>sudo apt install libwebkit2gtk-4.0</code>
                </MudAlert>
            </MudStack>
        </MudPaper>
    </MudItem>

    @* Gomulu Print Agent Bilgisi *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Print" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Gomulu Print Agent</MudText>
                </MudStack>
                <MudText Typo="Typo.body1">
                    Desktop uygulamasi, Print Agent'i gomulu olarak icerir. Uygulama baslatildiginda
                    Print Agent otomatik olarak <code>https://localhost:@PrintAgentPort</code> adresinde baslar.
                    Bu sayede ayri bir Print Agent kurulumu veya yapilandirmasi gerekmez.
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Gomulu agent; ZPL/ESC-POS destegi, ag yazicilari (TCP/IP 9100), USB yazicilari (Windows)
                    ve CUPS yazicilari (Linux) ile calisir. Yazici ayarlarini
                    <MudLink Href="/settings/printing">Yazici & Barkod</MudLink> sayfasindan yonetebilirsiniz.
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>
