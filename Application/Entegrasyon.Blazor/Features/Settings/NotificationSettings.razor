@page "/settings/notifications"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Settings.View)]

<PageTitle>Bildirim Ayarları</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Bildirim Ayarları</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Bildirim Tercihleri</MudText>
        <MudStack Spacing="3">
            <MudSwitch T="bool" @bind-Value="_enableOrderNotifications"
                       Label="Sipariş bildirimleri" Color="Color.Primary" />
            <MudSwitch T="bool" @bind-Value="_enableStockAlerts"
                       Label="Stok uyarıları" Color="Color.Primary" />
            <MudSwitch T="bool" @bind-Value="_enableMarketplaceSyncNotifications"
                       Label="Pazaryeri senkronizasyon bildirimleri" Color="Color.Primary" />
            <MudSwitch T="bool" @bind-Value="_enableEmailNotifications"
                       Label="E-posta bildirimleri" Color="Color.Primary" />
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Snackbar Ayarları</MudText>
        <MudStack Spacing="3">
            <MudSwitch T="bool" @bind-Value="_showSnackbar"
                       Label="Yeni bildirim geldiğinde snackbar göster" Color="Color.Primary" />
            <MudNumericField T="int" @bind-Value="_snackbarDurationSeconds"
                             Label="Snackbar gösterim süresi (saniye)"
                             Min="1" Max="30"
                             Variant="Variant.Outlined"
                             Style="max-width: 300px" />
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Test</MudText>
        <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
            Bildirim sisteminin düzgün çalıştığını doğrulamak için kendinize bir deneme bildirimi gönderin.
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="SendTestNotificationAsync"
                   Disabled="_sendingTest">
            @if (_sendingTest)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Deneme Bildirimi Gönder
        </MudButton>
    </MudPaper>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="SaveSettingsAsync"
               Disabled="_saving">
        @if (_saving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Kaydet
    </MudButton>
}
