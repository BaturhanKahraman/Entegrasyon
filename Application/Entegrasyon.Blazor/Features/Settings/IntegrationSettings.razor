@page "/settings/integrations"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Integrations.View)]

<PageTitle>Entegrasyon Ayarları</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Entegrasyon Ayarları</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid>
        @* Trendyol API Ayarları *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MarketplaceLogo Name="Trendyol" Size="Size.Large" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Trendyol</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">API Bağlantı Ayarları</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        @if (_connectionTested.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(_connectionTested.Value ? Color.Success : Color.Error)">
                                @(_connectionTested.Value ? "Bağlı" : "Bağlantı Hatası")
                            </MudChip>
                        }
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value="_sellerId" Label="Satıcı ID (Seller ID)"
                                  Variant="Variant.Outlined" Class="mb-3"
                                  HelperText="Trendyol satıcı panelinden alınır" />
                    <MudTextField @bind-Value="_apiKey" Label="API Key"
                                  Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_apiSecret" Label="API Secret"
                                  Variant="Variant.Outlined" Class="mb-3"
                                  InputType="@(_showSecret ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showSecret ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="() => _showSecret = !_showSecret" />
                    <MudSelect T="string" @bind-Value="_baseUrl" Label="API Ortamı"
                               Variant="Variant.Outlined" Class="mb-3">
                        <MudSelectItem Value="@("https://apigw.trendyol.com")">
                            Production (apigw.trendyol.com)
                        </MudSelectItem>
                        <MudSelectItem Value="@("https://stageapigw.trendyol.com")">
                            Stage (stageapigw.trendyol.com)
                        </MudSelectItem>
                    </MudSelect>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveCredentialsAsync" Disabled="@_saving">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kaydet
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Cable"
                               OnClick="TestConnectionAsync" Disabled="@_testing">
                        @if (_testing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Bağlantıyı Test Et
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* Depo Seçimi *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Warehouse" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">Stok Depo Ayarları</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Trendyol'a gönderilecek stok miktarı hangi depolardan hesaplanacak
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_branches.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning">Henüz depo tanımlanmamış.</MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Seçili depoların stokları toplanarak Trendyol'a gönderilir.
                        </MudText>
                        @foreach (var branch in _branches)
                        {
                            <MudCheckBox @key="branch.Id" T="bool" Label="@branch.Name"
                                         Value="@_selectedBranchIds.Contains(branch.Id)"
                                         ValueChanged="@(v => ToggleBranch(branch.Id, v))"
                                         Color="Color.Primary" Class="mb-1" />
                        }
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveWarehousesAsync" Disabled="@_savingWarehouses">
                        @if (_savingWarehouses)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Depo Ayarlarını Kaydet
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* Ortam Bilgisi *@
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Info" />
                    <MudText Typo="Typo.body2">
                        <strong>Mock Modu:</strong> @(_isMockMode ? "Aktif — API çağrısı yapılmaz, simülasyon verisi kullanılır" : "Pasif — Gerçek API çağrıları yapılır")
                    </MudText>
                </MudStack>
            </MudAlert>
        </MudItem>
    </MudGrid>
}
