@page "/users"
@using Entegrasyon.ApplicationBootstrap.Security
@attribute [Authorize(Policy = AppPermissions.Users.View)]
@using Entegrasyon.Entity.Dtos.Users
@using Entegrasyon.Blazor.Features.Users

<PageTitle>Kullanıcılar</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Kullanıcılar</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudTextField @bind-Value="_searchString" Placeholder="Kullanıcı ara..." Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                OnClick="OpenAddUserDialog">
                Yeni Kullanıcı
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudDataGrid T="UserDetailListDto" Items="@_users" Filterable="true" SortMode="SortMode.Multiple" Hover="true"
    Loading="@_loading" Virtualize="true" FixedHeader="true" Height="600px">
    <Columns>
        <PropertyColumn Property="x => x.UserName" Title="Kullanıcı Adı" />
        <PropertyColumn Property="x => x.Name" Title="Ad" />
        <PropertyColumn Property="x => x.Surname" Title="Soyad" />
        <TemplateColumn Title="Durum">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudChip Color="Color.Success" Size="Size.Small">Aktif</MudChip>
                }
                else
                {
                    <MudChip Color="Color.Default" Size="Size.Small">Pasif</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Şifre Değişimi">
            <CellTemplate>
                @if (context.Item.NeedsTakeNewPassword)
                {
                    <MudChip Color="Color.Warning" Size="Size.Small">Gerekli</MudChip>
                }
                else
                {
                    <MudChip Color="Color.Success" Size="Size.Small">Güncel</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellClass="d-flex justify-end" Title="İşlemler">
            <CellTemplate>
                <MudTooltip Text="Düzenle">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                        OnClick="@(() => EditUser(context.Item))" />
                </MudTooltip>
                <MudTooltip Text="Şifre Sıfırla">
                    <MudIconButton Icon="@Icons.Material.Filled.Lock"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   OnClick="@(() => ResetPassword(context.Item))" />
                </MudTooltip>
                <MudTooltip Text="Sil">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                        OnClick="@(() => DeleteUser(context.Item))" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="UserDetailListDto" />
    </PagerContent>
</MudDataGrid>
