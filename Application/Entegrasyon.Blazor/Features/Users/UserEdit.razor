@page "/users/edit/{Id:guid}"
@rendermode InteractiveServer
@using Entegrasyon.Entity.User
@attribute [Authorize(Policy = AppPermissions.Users.View)]

<PageTitle>Kullanici Duzenle</PageTitle>

@if (_loading)
{
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudSkeleton Width="40%" Height="32px" Class="mb-4" />
                    @for (var i = 0; i < 6; i++)
                    {
                        <MudSkeleton Width="100%" Height="56px" Class="mb-3" />
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
else if (_user is null)
{
    <MudAlert Severity="Severity.Error">Kullanici bulunamadi.</MudAlert>
    <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => NavigationManager.NavigateTo("/users"))">
        Listeye Don
    </MudButton>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/users"))" />
        <MudText Typo="Typo.h4">@_user.Name @_user.Surname</MudText>
        @if (_user.IsActive)
        {
            <MudChip T="string" Color="Color.Success" Size="Size.Small">Aktif</MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Default" Size="Size.Small">Pasif</MudChip>
        }
        @if (_user.NeedsTakeNewPassword)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Sifre Degisimi Gerekli</MudChip>
        }
    </MudStack>

    <MudGrid>
        @* ── Sol: Kullanici Bilgileri ── *@
        <MudItem xs="12" md="7">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Kullanici Bilgileri</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudForm @ref="_editForm">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField Label="Kullanici Adi" @bind-Value="_editUserName"
                                              Required="true" RequiredError="Kullanici adi zorunludur"
                                              MaxLength="30" Counter="30"
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AlternateEmail" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Label="E-posta" @bind-Value="_editEmail"
                                              InputType="InputType.Email"
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Label="Ad" @bind-Value="_editName"
                                              Required="true" RequiredError="Ad zorunludur"
                                              MaxLength="60" Counter="60"
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Label="Soyad" @bind-Value="_editSurname"
                                              Required="true" RequiredError="Soyad zorunludur"
                                              MaxLength="60" Counter="60"
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="int" Label="Roller" @bind-SelectedValues="_selectedRoleIds"
                                           MultiSelection="true" Required="true"
                                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Security"
                                           AnchorOrigin="Origin.BottomCenter">
                                    @foreach (var role in _roles)
                                    {
                                        <MudSelectItem @key="role.Id" Value="@role.Id">@role.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="int?" Label="Varsayilan Sube" @bind-Value="_selectedBranchOfficeId"
                                           Clearable="true"
                                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Store">
                                    @foreach (var branch in _branchOffices)
                                    {
                                        <MudSelectItem @key="branch.Id" Value="@((int?)branch.Id)">@branch.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool" @bind-Value="_editIsActive" Color="Color.Success"
                                           Label="@(_editIsActive ? "Aktif" : "Pasif")" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Kayit Tarihi</MudText>
                                <MudText Typo="Typo.body1">@_user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveUser" Disabled="_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Kaydediliyor...</span>
                        }
                        else
                        {
                            <span>Kaydet</span>
                        }
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* ── Sag: Sifre Yonetimi ── *@
        <MudItem xs="12" md="5">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Sifre Yonetimi</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Kullaniciya gecici bir sifre atanir. Kullanici bir sonraki girisinde yeni sifre olusturmak zorunda kalir.
                    </MudText>

                    @if (!string.IsNullOrEmpty(_generatedPassword))
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3">
                            <MudText Typo="Typo.body2">Gecici sifre basariyla atandi:</MudText>
                            <MudText Typo="Typo.h6" Class="mt-1"><b>@_generatedPassword</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Bu sifreyi kullaniciya iletin.</MudText>
                        </MudAlert>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.LockReset"
                               OnClick="ResetPassword" Disabled="_isResettingPassword">
                        @if (_isResettingPassword)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Sifirlaniyor...</span>
                        }
                        else
                        {
                            <span>Sifre Sifirla</span>
                        }
                    </MudButton>
                </MudCardActions>
            </MudCard>

            @* ── Tehlikeli Islemler ── *@
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Tehlikeli Islemler</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="DeleteUser" FullWidth="true">
                        Kullaniciyi Sil
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
