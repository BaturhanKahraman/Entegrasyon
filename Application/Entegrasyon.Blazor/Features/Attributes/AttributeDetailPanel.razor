@using Entegrasyon.Entity.Categories

@if (SelectedAttribute == null)
{
    <MudPaper Elevation="1" Class="pa-6 d-flex align-center justify-center" Style="min-height:400px">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.body1" Color="Color.Default">Detayları görmek için listeden bir özellik seçin</MudText>
        </MudStack>
    </MudPaper>
}
else if (_isEditing)
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6">Özelliği Düzenle</MudText>
        </MudStack>

        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editHumanized"
                              Label="Görünen Ad"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Value="_editKey"
                              Label="Anahtar (değiştirilemez)"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Disabled="true" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_editAllowCustom"
                           Label="Özel değere izin ver"
                           Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Tanımlı Değerler</MudText>
                <MudChipSet T="string" Class="mb-2">
                    @for (int i = 0; i < _editValues.Count; i++)
                    {
                        var idx = i;
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                 OnClose="@(() => RemoveValue(idx))" CloseIcon="@Icons.Material.Filled.Close">
                            @_editValues[idx].Name
                        </MudChip>
                    }
                </MudChipSet>
                <MudStack Row="true" Spacing="1">
                    <MudTextField @bind-Value="_newValueName"
                                  Label="Yeni değer"
                                  Variant="Variant.Outlined"
                                  Dense="true"
                                  Style="max-width:220px" />
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Primary"
                                   OnClick="AddValue"
                                   Disabled="@string.IsNullOrWhiteSpace(_newValueName)" />
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-4">
            <MudButton Variant="Variant.Text" OnClick="CancelEdit" Disabled="_saving">İptal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEdit" Disabled="_saving">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                else { <span>Kaydet</span> }
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6">@SelectedAttribute.CategoryAttributeHumanized</MudText>
            <MudStack Row="true" Spacing="0">
                <MudChip T="string" Size="Size.Small" Color="@(SelectedAttribute.AllowCustom ? Color.Info : Color.Default)" Class="mr-2">
                    @(SelectedAttribute.AllowCustom ? "Özel değere izin var" : "Yalnızca liste değerleri")
                </MudChip>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="StartEdit" Disabled="@(_saving || _deleting)" Title="Düzenle" />
                @if (_deleting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Error" Class="ml-1" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="DeleteAttribute" Disabled="@_saving" Title="Sil" />
                }
            </MudStack>
        </MudStack>

        <MudTabs Elevation="0" Rounded="false" Color="Color.Default" Class="mt-2">
            <MudTabPanel Text="Genel">
                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudField Label="Anahtar" Variant="Variant.Outlined">
                            @SelectedAttribute.CategoryAttributeKey
                        </MudField>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudField Label="Görünen Ad" Variant="Variant.Outlined">
                            @SelectedAttribute.CategoryAttributeHumanized
                        </MudField>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Tanımlı Değerler (@SelectedAttribute.CategoryAttributeValues.Count)
                        </MudText>
                        @if (SelectedAttribute.CategoryAttributeValues.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Tanımlı değer yok</MudText>
                        }
                        else
                        {
                            <MudChipSet T="string">
                                @foreach (var val in SelectedAttribute.CategoryAttributeValues)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@val.Name</MudChip>
                                }
                            </MudChipSet>
                        }
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

        </MudTabs>
    </MudPaper>
}
