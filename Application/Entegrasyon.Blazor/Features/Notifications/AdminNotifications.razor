@page "/admin/notifications"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permissions.Notifications.Manage")]
@using Entegrasyon.Entity.Notifications

<PageTitle>Bildirim Yonetimi</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudGrid>
        <MudItem xs="12">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h5">Bildirim Yonetimi</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                           OnClick="OpenSendDialog">Yeni Bildirim</MudButton>
            </MudStack>
        </MudItem>
        <MudItem xs="12">
            <MudDataGrid T="Notification" Items="_notifications.AsEnumerable()"
                         Loading="_loading" Dense Hover Striped
                         QuickFilter="@(n => string.IsNullOrWhiteSpace(_searchText) || (n.Header ?? "").Contains(_searchText, StringComparison.OrdinalIgnoreCase))">
                <ToolBarContent>
                    <MudTextField @bind-Value="_searchText" Placeholder="Ara..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                                  Immediate DebounceInterval="300" />
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Header" Title="Baslik" />
                    <TemplateColumn Title="Onem">
                        <CellTemplate>
                            @switch (context.Item.Severity)
                            {
                                case NotificationSeverity.Info:
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">Bilgi</MudChip>
                                    break;
                                case NotificationSeverity.Warning:
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Uyari</MudChip>
                                    break;
                                case NotificationSeverity.Error:
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Hata</MudChip>
                                    break;
                                case NotificationSeverity.Success:
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Basari</MudChip>
                                    break;
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Category" Title="Kategori" />
                    <PropertyColumn Property="x => x.CreatedAt" Title="Tarih" Format="dd.MM.yyyy HH:mm" />
                    <TemplateColumn Title="Alicilar">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Item.NotificationsUsers.Count kisi</MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudItem>
    </MudGrid>
</MudContainer>
