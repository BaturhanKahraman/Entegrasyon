@using Entegrasyon.Entity.Notifications

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />Bildirim Gonder</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_header" Label="Baslik" Required RequiredError="Baslik gerekli"
                          MaxLength="200" Counter="200" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_content" Label="Icerik" Required RequiredError="Icerik gerekli"
                          MaxLength="1000" Counter="1000" Lines="4" Variant="Variant.Outlined" />
            <MudSelect @bind-Value="_severity" Label="Onem Derecesi" Variant="Variant.Outlined">
                <MudSelectItem Value="NotificationSeverity.Info">Bilgi</MudSelectItem>
                <MudSelectItem Value="NotificationSeverity.Warning">Uyari</MudSelectItem>
                <MudSelectItem Value="NotificationSeverity.Error">Hata</MudSelectItem>
                <MudSelectItem Value="NotificationSeverity.Success">Basari</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="_category" Label="Kategori" Variant="Variant.Outlined">
                @foreach (var c in Enum.GetValues<NotificationCategory>())
                {
                    <MudSelectItem Value="c">@c</MudSelectItem>
                }
            </MudSelect>
            <MudRadioGroup @bind-Value="_recipientType">
                <MudRadio Value="@("users")" Color="Color.Primary">Belirli Kullanicilar</MudRadio>
                <MudRadio Value="@("role")" Color="Color.Primary">Role Gore</MudRadio>
                <MudRadio Value="@("branch")" Color="Color.Primary">Subeye Gore</MudRadio>
                <MudRadio Value="@("all")" Color="Color.Primary">Tum Kullanicilar</MudRadio>
            </MudRadioGroup>

            @if (_recipientType == "users")
            {
                <MudSelect T="Guid" Label="Kullanicilar" MultiSelection @bind-SelectedValues="_selectedUserIds"
                           Variant="Variant.Outlined">
                    @foreach (var user in _users.Where(u => u.IsActive))
                    {
                        <MudSelectItem T="Guid" Value="user.Id">@user.Name @user.Surname</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_recipientType == "role")
            {
                <MudSelect @bind-Value="_selectedRoleId" Label="Rol" Variant="Variant.Outlined">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem Value="role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_recipientType == "branch")
            {
                <MudSelect @bind-Value="_selectedBranchId" Label="Sube" Variant="Variant.Outlined">
                    @foreach (var branch in _branches)
                    {
                        <MudSelectItem Value="branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Iptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Send" Disabled="_sending">
            @if (_sending)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
            }
            Gonder
        </MudButton>
    </DialogActions>
</MudDialog>
