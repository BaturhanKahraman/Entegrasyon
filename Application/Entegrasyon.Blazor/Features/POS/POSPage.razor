@page "/pos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Sales.Create)]

<PageTitle>POS Terminal</PageTitle>

@if (!_hasActiveSession)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 60vh;">
        <MudPaper Class="pa-8 mx-auto" Style="width: 100%;" Elevation="4">
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">Kasa Acilis</MudText>
            <MudSelect T="int" @bind-Value="_selectedBranchOfficeId"
                       Label="Sube" Variant="Variant.Outlined" Class="mb-4">
                @foreach (var branch in _branchOffices)
                {
                    <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="decimal" @bind-Value="_openingCash"
                             Label="Acilis Kasasi (TL)" Variant="Variant.Outlined"
                             Min="0m" Class="mb-4" Adornment="Adornment.Start" AdornmentText="TL" />
            <MudTextField @bind-Value="_terminalId" Label="Terminal ID (Opsiyonel)"
                          Variant="Variant.Outlined" Class="mb-4" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Size="Size.Large" OnClick="OpenSession" Disabled="@_processing">
                Kasayi Ac
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <!-- Top Bar -->
    <MudPaper Class="pa-3 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="8">
                <MudText Typo="Typo.h5">POS Terminal</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Kasiyer: @_currentUserName | Sube: @_currentBranchName | Terminal: @(_activeSession?.TerminalId ?? "-")
                </MudText>
            </MudItem>
            <MudItem xs="4" Class="d-flex justify-end align-center gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Summarize"
                           OnClick="ShowSummary">Ozet</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.PowerSettingsNew"
                           OnClick="CloseSessionDialog">Kasayi Kapat</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid>
        <!-- Left Panel: Barcode + Cart -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 mb-4">
                <MudTextField @ref="_barcodeField"
                              @bind-Value="_barcodeSearch"
                              Label="Barkod Okut veya Urun Ara"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                              OnKeyDown="HandleBarcodeSearch"
                              Immediate="true"
                              Placeholder="Barkod okutun..."
                              Style="font-size: 1.2rem;" />
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Sepet (@_cartItems.Count urun)</MudText>
                @if (_cartItems.Any())
                {
                    <MudTable Items="@_cartItems" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Urun</MudTh>
                            <MudTh>Barkod</MudTh>
                            <MudTh Style="width: 100px;">Adet</MudTh>
                            <MudTh>Birim Fiyat</MudTh>
                            <MudTh Style="width: 100px;">Indirim %</MudTh>
                            <MudTh>KDV %</MudTh>
                            <MudTh>Toplam</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Urun">@context.ProductName</MudTd>
                            <MudTd DataLabel="Barkod">@context.Barcode</MudTd>
                            <MudTd DataLabel="Adet">
                                <MudNumericField @bind-Value="context.Quantity"
                                                 Min="1" Step="1" Immediate="true"
                                                 Style="width: 80px;" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd DataLabel="Birim Fiyat">@context.UnitPrice.ToString("C2", _trCulture)</MudTd>
                            <MudTd DataLabel="Indirim">
                                <MudNumericField @bind-Value="context.DiscountPercent"
                                                 Min="0" Max="100" Step="5" Immediate="true"
                                                 Style="width: 80px;" Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="%" />
                            </MudTd>
                            <MudTd DataLabel="KDV">%@context.VatRate</MudTd>
                            <MudTd DataLabel="Toplam">@context.LineTotal.ToString("C2", _trCulture)</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => RemoveFromCart(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Align="Align.Center" Color="Color.Secondary" Class="py-8">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Class="mb-2" />
                        <br />Sepet bos. Urun eklemek icin barkod okutun.
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        <!-- Right Panel: Payment Summary -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Odeme Ozeti</MudText>

                <div class="d-flex justify-space-between mb-2">
                    <MudText>Ara Toplam:</MudText>
                    <MudText Typo="Typo.h6">@Subtotal.ToString("C2", _trCulture)</MudText>
                </div>

                @if (TotalDiscount > 0)
                {
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Color="Color.Success">Indirim:</MudText>
                        <MudText Color="Color.Success">-@TotalDiscount.ToString("C2", _trCulture)</MudText>
                    </div>
                }

                <div class="d-flex justify-space-between mb-2">
                    <MudText>KDV:</MudText>
                    <MudText>@TotalTax.ToString("C2", _trCulture)</MudText>
                </div>

                <MudDivider Class="my-3" />

                <div class="d-flex justify-space-between mb-4">
                    <MudText Typo="Typo.h4">TOPLAM:</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Primary">@GrandTotal.ToString("C2", _trCulture)</MudText>
                </div>

                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           FullWidth="true" Size="Size.Large"
                           Disabled="@(!_cartItems.Any() || _processing)"
                           OnClick="OpenPaymentDialog"
                           StartIcon="@Icons.Material.Filled.Payment"
                           Style="font-size: 1.2rem; height: 56px;">
                    Odeme Al
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           FullWidth="true" Class="mt-3"
                           Disabled="@(!_cartItems.Any())"
                           OnClick="ClearCart"
                           StartIcon="@Icons.Material.Filled.RemoveShoppingCart">
                    Sepeti Temizle
                </MudButton>
            </MudPaper>

            <!-- Session Stats -->
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" Class="mb-2">Oturum Bilgisi</MudText>
                <MudDivider Class="mb-3" />
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">Islem Sayisi:</MudText>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">@_sessionTransactionCount</MudChip>
                </div>
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">Acilis Kasasi:</MudText>
                    <MudText Typo="Typo.body1">@(_activeSession?.OpeningCash.ToString("C2", _trCulture) ?? "-")</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
