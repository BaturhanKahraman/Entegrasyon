@using Entegrasyon.Entity.POS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">Odeme - @GrandTotal.ToString("C2", _trCulture)</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Odeme Yontemi</MudText>
        <MudToggleGroup T="PaymentMethod" @bind-Value="_selectedPaymentMethod"
                        Color="Color.Primary" CheckMark="true" Outlined="true"
                        Class="mb-4" Style="width: 100%;">
            <MudToggleItem Value="PaymentMethod.Cash" Text="Nakit" />
            <MudToggleItem Value="PaymentMethod.CreditCard" Text="Kredi Karti" />
            <MudToggleItem Value="PaymentMethod.DebitCard" Text="Banka Karti" />
            <MudToggleItem Value="PaymentMethod.MealCard" Text="Yemek Karti" />
            <MudToggleItem Value="PaymentMethod.Mixed" Text="Karisik" />
        </MudToggleGroup>

        @if (_selectedPaymentMethod == PaymentMethod.Cash)
        {
            <MudNumericField T="decimal" @bind-Value="_cashReceived"
                             Label="Alinan Tutar (TL)" Variant="Variant.Outlined"
                             Adornment="Adornment.Start" AdornmentText="TL"
                             Style="font-size: 1.5rem;" Class="mb-3" />

            @if (_cashReceived >= GrandTotal)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">
                    Para Ustu: @((_cashReceived - GrandTotal).ToString("C2", _trCulture))
                </MudAlert>
            }
        }
        else if (_selectedPaymentMethod is PaymentMethod.CreditCard or PaymentMethod.DebitCard)
        {
            <MudTextField @bind-Value="_cardAuthCode"
                          Label="Onay Kodu (Opsiyonel)" Variant="Variant.Outlined" Class="mb-3" />
        }
        else if (_selectedPaymentMethod == PaymentMethod.Mixed)
        {
            <MudNumericField T="decimal" @bind-Value="_cashPortion"
                             Label="Nakit Kismi (TL)" Variant="Variant.Outlined"
                             Adornment="Adornment.Start" AdornmentText="TL" Class="mb-3" />
            <MudText Typo="Typo.body1" Class="mb-3">
                Kart Kismi: @((GrandTotal - _cashPortion).ToString("C2", _trCulture))
            </MudText>
            <MudTextField @bind-Value="_cardAuthCode"
                          Label="Kart Onay Kodu (Opsiyonel)" Variant="Variant.Outlined" Class="mb-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Iptal</MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Success"
                   Disabled="@(!CanConfirm || _processing)" Size="Size.Large">
            @if (_processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Onayla
        </MudButton>
    </DialogActions>
</MudDialog>
