<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">Kasayi Kapat</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }
        else if (_summary != null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Kasayi kapatmadan once kasadaki nakit tutari sayiniz.
            </MudAlert>

            <MudSimpleTable Dense="true" Striped="true" Class="mb-4">
                <tbody>
                    <tr>
                        <td>Acilis Kasasi</td>
                        <td class="text-right">@_summary.OpeningCash.ToString("C2", _trCulture)</td>
                    </tr>
                    <tr>
                        <td>Nakit Satislar</td>
                        <td class="text-right">@_summary.TotalCash.ToString("C2", _trCulture)</td>
                    </tr>
                    <tr>
                        <td>Toplam Islem</td>
                        <td class="text-right">@_summary.TransactionCount</td>
                    </tr>
                    <tr>
                        <td><strong>Beklenen Kasa</strong></td>
                        <td class="text-right"><strong>@_summary.ExpectedCash.ToString("C2", _trCulture)</strong></td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudNumericField T="decimal" @bind-Value="_closingCash"
                             Label="Sayilan Nakit Tutar (TL)"
                             Variant="Variant.Outlined"
                             Adornment="Adornment.Start" AdornmentText="TL"
                             Style="font-size: 1.3rem;" Class="mb-3" />

            <MudAlert Severity="@(CashDifference >= 0 ? Severity.Success : Severity.Warning)" Class="mb-3">
                Fark: @CashDifference.ToString("C2", _trCulture)
                @if (CashDifference > 0)
                {
                    <span> (Fazla)</span>
                }
                else if (CashDifference < 0)
                {
                    <span> (Eksik)</span>
                }
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined">Iptal</MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Error"
                   Disabled="@(_loading || _processing)">
            @if (_processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Kasayi Kapat
        </MudButton>
    </DialogActions>
</MudDialog>
