@using Entegrasyon.Entity.Invoicing

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_detail is not null)
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Fatura No</MudText>
                    <MudText>@_detail.InvoiceNumber</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Durum</MudText>
                    <MudChip T="string" Color="@GetStatusColor(_detail.Status)">@GetStatusText(_detail.Status)</MudChip>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">Musteri</MudText>
                    <MudText>@_detail.CustomerTitle</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">VKN / TCKN</MudText>
                    <MudText>@_detail.CustomerTaxId</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Ara Toplam</MudText>
                    <MudText>@_detail.TotalAmount.ToString("N2") TL</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">KDV</MudText>
                    <MudText>@_detail.TaxAmount.ToString("N2") TL</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2">Genel Toplam</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_detail.GrandTotal.ToString("N2") TL</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" GutterBottom="true">Kalemler</MudText>
            <MudTable Items="_detail.Lines.AsEnumerable()" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Urun</MudTh>
                    <MudTh>Miktar</MudTh>
                    <MudTh>Birim Fiyat</MudTh>
                    <MudTh>KDV %</MudTh>
                    <MudTh>KDV Tutar</MudTh>
                    <MudTh>Toplam</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.Quantity</MudTd>
                    <MudTd>@context.UnitPrice.ToString("N2")</MudTd>
                    <MudTd>%@context.TaxRate</MudTd>
                    <MudTd>@context.TaxAmount.ToString("N2")</MudTd>
                    <MudTd>@context.LineTotal.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            @if (!string.IsNullOrEmpty(_detail.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_detail.ErrorMessage</MudAlert>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Warning">Fatura bulunamadi.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (_detail is not null)
        {
            @if (_detail.Status == EInvoiceStatus.Draft)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SendToGib" StartIcon="@Icons.Material.Filled.Send">
                    GIB'e Gonder
                </MudButton>
            }
            @if (_detail.Status != EInvoiceStatus.Cancelled)
            {
                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="CancelInvoice" StartIcon="@Icons.Material.Filled.Cancel">
                    Iptal Et
                </MudButton>
            }
        }
        <MudButton OnClick="Close">Kapat</MudButton>
    </DialogActions>
</MudDialog>
