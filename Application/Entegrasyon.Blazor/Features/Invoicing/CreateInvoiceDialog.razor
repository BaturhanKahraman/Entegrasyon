@using Entegrasyon.Entity.Invoicing

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="EInvoiceType" Label="Fatura Tipi" @bind-Value="_invoiceType">
                        <MudSelectItem T="EInvoiceType" Value="EInvoiceType.EFatura">E-Fatura</MudSelectItem>
                        <MudSelectItem T="EInvoiceType" Value="EInvoiceType.EArsiv">E-Arsiv</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="IntegratorProvider" Label="Entegrator" @bind-Value="_integratorProvider">
                        <MudSelectItem T="IntegratorProvider" Value="IntegratorProvider.Custom">Ozel</MudSelectItem>
                        <MudSelectItem T="IntegratorProvider" Value="IntegratorProvider.Parasut">Parasut</MudSelectItem>
                        <MudSelectItem T="IntegratorProvider" Value="IntegratorProvider.ForIba">ForIBA</MudSelectItem>
                        <MudSelectItem T="IntegratorProvider" Value="IntegratorProvider.Logo">Logo</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="VKN / TCKN" @bind-Value="_customerTaxId" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Musteri Unvani" @bind-Value="_customerTitle" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Fatura Tarihi" @bind-Date="_issueDate" Required="true" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" GutterBottom="true">Fatura Kalemleri</MudText>

            @foreach (var (line, index) in _lines.Select((l, i) => (l, i)))
            {
                <MudGrid Class="mb-2">
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" Label="Urun Adi" @bind-Value="line.ProductName" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudNumericField T="int" Label="Miktar" @bind-Value="line.Quantity" Min="1" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudNumericField T="decimal" Label="Birim Fiyat" @bind-Value="line.UnitPrice" Min="0.01m" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudNumericField T="int" Label="KDV %" @bind-Value="line.TaxRate" Min="0" />
                    </MudItem>
                    <MudItem xs="6" sm="2" Class="d-flex align-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => RemoveLine(index)" />
                    </MudItem>
                </MudGrid>
            }

            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                Kalem Ekle
            </MudButton>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Vazgec</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Olustur</MudButton>
    </DialogActions>
</MudDialog>
