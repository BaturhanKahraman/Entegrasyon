@page "/chat"
@page "/chat/{ConversationId:long}"
@rendermode InteractiveServer

@using Entegrasyon.Blazor.Features.Chat

<PageTitle>Mesajlar</PageTitle>

<MudGrid Style="height: calc(100vh - 120px);">
    <MudItem xs="4" Style="height:100%;overflow-y:auto;border-right:1px solid var(--mud-palette-divider);">
        <ConversationList @ref="_conversationListRef"
                         OnConversationSelected="OnConversationSelected"
                         SelectedConversationId="_selectedConversationId" />
    </MudItem>
    <MudItem xs="8" Style="height:100%;display:flex;flex-direction:column;">
        @if (_selectedConversationId > 0)
        {
            <MessageArea ConversationId="_selectedConversationId" CurrentUserId="_userId" />
        }
        else
        {
            <div class="d-flex align-center justify-center" style="height:100%">
                <MudText Typo="Typo.h6" Color="Color.Secondary">Bir sohbet secin veya yeni bir sohbet baslatin</MudText>
            </div>
        }
    </MudItem>
</MudGrid>
