@using Entegrasyon.Entity.Dtos.Chat

<div class="d-flex flex-column" style="height:100%">
    <div class="pa-3 d-flex align-center gap-2">
        <MudText Typo="Typo.h6" Class="flex-grow-1">Sohbetler</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       OnClick="OpenNewChatDialog"
                       aria-label="Yeni Sohbet" />
    </div>

    <div class="px-3 pb-2">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Ara..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      DebounceInterval="300" />
    </div>

    <MudDivider />

    <div style="overflow-y:auto;flex:1">
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            </div>
        }
        else if (!FilteredConversations.Any())
        {
            <div class="pa-4 d-flex justify-center">
                <MudText Color="Color.Secondary" Typo="Typo.body2">Henuz sohbet yok</MudText>
            </div>
        }
        else
        {
            <MudList T="ChatConversationListItemDto" Dense="true" @bind-SelectedValue="_selectedItem">
                @foreach (var conversation in FilteredConversations)
                {
                    <MudListItem @key="conversation.Id"
                                 T="ChatConversationListItemDto"
                                 Value="conversation"
                                 Class="@GetItemClass(conversation.Id)"
                                 OnClick="@(() => SelectConversation(conversation.Id))">
                        <div class="d-flex align-center gap-3 py-1">
                            <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                @GetInitials(conversation.DisplayName)
                            </MudAvatar>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.subtitle2" Class="text-truncate">@conversation.DisplayName</MudText>
                                    @if (conversation.LastMessageAt.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @FormatTime(conversation.LastMessageAt.Value)
                                        </MudText>
                                    }
                                </div>
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary"
                                             Class="text-truncate" Style="max-width:180px">
                                        @(conversation.LastMessage ?? "...")
                                    </MudText>
                                    @if (conversation.UnreadCount > 0)
                                    {
                                        <MudBadge Content="@conversation.UnreadCount"
                                                  Color="Color.Primary"
                                                  Overlap="false" />
                                    }
                                </div>
                            </div>
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
    </div>
</div>
