         Variant="Variant.Outlined"
         Icon="@(_isOnline ? Icons.Material.Filled.Print : Icons.Material.Filled.PrintDisabled)">
    @(_isOnline ? "Yazıcı Hazır" : "Yazıcı Bağlı Değil")
</MudChip>
