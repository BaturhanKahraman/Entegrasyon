@page "/customers"
@rendermode InteractiveServer
@using Entegrasyon.Entity.Dtos.Customers
@attribute [Authorize(Policy = AppPermissions.Customers.View)]

<MudDataGrid @ref="dataGrid" T="CustomerDetailDto" ServerData="ServerData" Filterable="false">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Müşteriler</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Ara..." Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" DebounceInterval="500">
        </MudTextField>
        <AuthorizeView Policy="@AppPermissions.Customers.Create">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                    OnClick="@(() => OpenDialogAsync(null))" Class="ml-4">Yeni Müşteri</MudButton>
            </Authorized>
        </AuthorizeView>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="#" />
        <TemplateColumn Title="Müşteri Adı/Ünvanı">
            <CellTemplate>
                @if (context.Item.CustomerType == "Corporate")
                {
                    <MudText>@context.Item.CorporateName</MudText>
                    <MudText Typo="Typo.caption">@context.Item.NameSurname (Yetkili)</MudText>
                }
                else
                {
                    <MudText>@context.Item.NameSurname</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CustomerType" Title="Tip">
            <CellTemplate>
                @if (context.Item.CustomerType == "Corporate")
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">Kurumsal</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Bireysel</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.PhoneNumber" Title="Telefon" />
        <PropertyColumn Property="x => x.Address" Title="Adres" />
        <TemplateColumn Title="İşlemler">
            <CellTemplate>
                <AuthorizeView Policy="@AppPermissions.Customers.Edit" Context="authContext">
                    <Authorized>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                            OnClick="@(() => OpenDialogAsync(context.Item))" />
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@AppPermissions.Customers.Delete" Context="authContext">
                    <Authorized>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                            OnClick="@(() => DeleteCustomerAsync(context.Item.Id))" />
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="CustomerDetailDto" />
    </PagerContent>
</MudDataGrid>
