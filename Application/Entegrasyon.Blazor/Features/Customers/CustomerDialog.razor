<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
            <MudRadioGroup @bind-Value="Model.CustomerType" Class="mb-4">
                <MudRadio Value="@("Retail")" Color="Color.Primary">Bireysel</MudRadio>
                <MudRadio Value="@("Corporate")" Color="Color.Secondary">Kurumsal</MudRadio>
            </MudRadioGroup>

            @if (Model.CustomerType == "Retail")
            {
                <MudTextField @bind-Value="Model.Name" Label="Ad" Required="true" RequiredError="Ad zorunludur" />
                <MudTextField @bind-Value="Model.Surname" Label="Soyad" Required="true" RequiredError="Soyad zorunludur" />
                <MudTextField @bind-Value="Model.NationalIdentity" Label="TCKN" Required="true"
                    RequiredError="TCKN zorunludur" Counter="11" MaxLength="11" />
            }
            else if (Model.CustomerType == "Corporate")
            {
                <MudTextField @bind-Value="Model.CorporateName" Label="Şirket Ünvanı" Required="true"
                    RequiredError="Şirket ünvanı zorunludur" />
                <MudTextField @bind-Value="Model.TaxNumber" Label="Vergi Numarası" Required="true"
                    RequiredError="Vergi numarası zorunludur" />
                <MudTextField @bind-Value="Model.Name" Label="Yetkili Ad" />
                <MudTextField @bind-Value="Model.Surname" Label="Yetkili Soyad" />
            }

            <MudTextField @bind-Value="Model.PhoneNumber" Label="Telefon" Required="true"
                RequiredError="Telefon zorunludur" />
            <MudTextField @bind-Value="Model.FullAddress" Label="Adres" Lines="3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_saving">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                @(IsEdit ? "Güncelle" : "Kaydet")
            }
        </MudButton>
    </DialogActions>
</MudDialog>
