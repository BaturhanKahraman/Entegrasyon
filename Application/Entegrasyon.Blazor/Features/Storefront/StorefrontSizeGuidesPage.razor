@page "/storefront/size-guides"
@rendermode InteractiveServer
@using Entegrasyon.Entity.Storefront

<PageTitle>Beden Rehberleri</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Beden Rehberleri</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
           OnClick="OpenCreateDialog">
    Yeni Beden Rehberi
</MudButton>

<MudDataGrid Items="@_guides.AsEnumerable()" Hover="true" Loading="@_loading" Dense="true">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <PropertyColumn Property="x => x.Name" Title="Ad" />
        <TemplateColumn Title="Kategoriler">
            <CellTemplate>
                <MudText Typo="Typo.body2">@(context.Item.CategoryIds ?? "-")</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Durum">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Aktif</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Pasif</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Olusturulma">
            <CellTemplate>
                @context.Item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Islemler">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="() => OpenEditDialog(context.Item)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="() => DeleteGuide(context.Item.Id)" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<MudDialog @bind-Visible="_dialogVisible" Options="@_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingGuide.Id > 0 ? "Beden Rehberi Duzenle" : "Yeni Beden Rehberi")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editingGuide.Name" Label="Ad" Required="true" Class="mb-4" />
        <MudTextField @bind-Value="_editingGuide.CategoryIds" Label="Kategori ID'leri (JSON: [1,2,3])" Class="mb-4" />
        <MudTextField @bind-Value="_editingGuide.MeasurementImageUrl" Label="Olcu Gorseli URL" Class="mb-4" />
        <MudTextField @bind-Value="_editingGuide.MeasurementInstructions" Label="Olcu Talimatlari" Lines="3" Class="mb-4" />
        <MudTextField @bind-Value="_editingGuide.SizeData" Label="Beden Verileri (JSON matris)" Lines="8" Required="true" Class="mb-4"
                      HelperText="Ornek: [[&quot;Beden&quot;,&quot;Gogus&quot;,&quot;Bel&quot;],[&quot;S&quot;,&quot;90&quot;,&quot;76&quot;]]" />
        <MudSwitch @bind-Value="_editingGuide.IsActive" Label="Aktif" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Iptal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveGuide">Kaydet</MudButton>
    </DialogActions>
</MudDialog>
