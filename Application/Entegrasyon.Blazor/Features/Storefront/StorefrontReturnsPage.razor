@page "/storefront/returns"
@rendermode InteractiveServer
@using Entegrasyon.Entity.Storefront

<PageTitle>Iade Talepleri</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Iade Talepleri</MudText>

<MudDataGrid Items="@_returns.AsEnumerable()" Hover="true" Loading="@_loading" Dense="true" Filterable="true">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <TemplateColumn Title="Siparis">
            <CellTemplate>
                @context.Item.OrderId.ToString()[..8]...
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CustomerId" Title="Musteri ID" />
        <PropertyColumn Property="x => x.Reason" Title="Neden" />
        <TemplateColumn Title="Durum">
            <CellTemplate>
                @{
                    var (color, text) = context.Item.Status switch
                    {
                        ReturnStatus.Pending => (Color.Warning, "Beklemede"),
                        ReturnStatus.Approved => (Color.Success, "Onaylandi"),
                        ReturnStatus.Rejected => (Color.Error, "Reddedildi"),
                        ReturnStatus.Completed => (Color.Info, "Tamamlandi"),
                        _ => (Color.Default, "Bilinmiyor")
                    };
                }
                <MudChip T="string" Color="@color" Size="Size.Small">@text</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Tarih">
            <CellTemplate>
                @context.Item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Islemler" CellStyle="text-align:right">
            <CellTemplate>
                @if (context.Item.Status == ReturnStatus.Pending)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"
                        OnClick="@(() => OpenApproveDialog(context.Item))" title="Onayla" />
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"
                        OnClick="@(() => OpenRejectDialog(context.Item))" title="Reddet" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
