@page "/storefront/email-campaigns"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Settings.View)]
@using Entegrasyon.Entity.Storefront

<PageTitle>E-posta Kampanyalari</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">E-posta Kampanyalari</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreateDialog" Class="mb-4">
    Yeni Kampanya
</MudButton>

<MudDataGrid Items="@_campaigns.AsEnumerable()" Hover="true" Loading="@_loading" Dense="true" Filterable="true">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <PropertyColumn Property="x => x.Subject" Title="Konu" />
        <TemplateColumn Title="Hedef">
            <CellTemplate>
                @GetTargetLabel(context.Item.Target)
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Durum">
            <CellTemplate>
                <MudChip T="string" Color="@GetStatusColor(context.Item.Status)" Size="Size.Small">
                    @GetStatusLabel(context.Item.Status)
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Gonderim">
            <CellTemplate>
                @context.Item.SentCount / @context.Item.TotalRecipients
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Tarih">
            <CellTemplate>
                @if (context.Item.SentAt.HasValue)
                {
                    @context.Item.SentAt.Value.ToString("dd.MM.yyyy HH:mm")
                }
                else if (context.Item.ScheduledAt.HasValue)
                {
                    <span class="mud-text-secondary">@context.Item.ScheduledAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                }
                else
                {
                    <span class="mud-text-disabled">-</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Islemler">
            <CellTemplate>
                @if (context.Item.Status == CampaignStatus.Draft)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="() => OpenEditDialog(context.Item)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Info"
                                   OnClick="() => OpenScheduleDialog(context.Item)" />
                }
                @if (context.Item.Status is CampaignStatus.Draft or CampaignStatus.Scheduled)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Warning"
                                   OnClick="() => CancelCampaignAsync(context.Item.Id)" />
                }
                @if (context.Item.Status != CampaignStatus.Sending)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeleteCampaignAsync(context.Item.Id)" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@* Create / Edit Dialog *@
<MudDialog @bind-Visible="_dialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingCampaign is not null ? "Kampanya Duzenle" : "Yeni Kampanya")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_dialogSubject" Label="Konu" Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="CampaignTarget" @bind-Value="_dialogTarget" Label="Hedef Kitle" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="CampaignTarget.AllSubscribers">Tum Aboneler</MudSelectItem>
            <MudSelectItem Value="CampaignTarget.AllCustomers">Tum Musteriler</MudSelectItem>
            <MudSelectItem Value="CampaignTarget.ActiveCustomers">Aktif Musteriler</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_dialogHtml" Label="HTML Icerik" Variant="Variant.Outlined" Lines="10" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Iptal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDialogAsync" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Kaydet
        </MudButton>
    </DialogActions>
</MudDialog>

@* Schedule Dialog *@
<MudDialog @bind-Visible="_scheduleDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small })">
    <TitleContent>
        <MudText Typo="Typo.h6">Kampanya Zamanla</MudText>
    </TitleContent>
    <DialogContent>
        <MudDatePicker @bind-Date="_scheduleDate" Label="Tarih" Variant="Variant.Outlined" Class="mb-3" />
        <MudTimePicker @bind-Time="_scheduleTime" Label="Saat" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _scheduleDialogVisible = false">Iptal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ScheduleAsync" Disabled="_saving">
            Zamanla
        </MudButton>
    </DialogActions>
</MudDialog>
