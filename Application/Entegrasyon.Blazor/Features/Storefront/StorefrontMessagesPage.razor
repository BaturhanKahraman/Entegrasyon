@page "/storefront/messages"
@rendermode InteractiveServer
@using Entegrasyon.Entity.Storefront

<PageTitle>Iletisim Mesajlari</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Iletisim Mesajlari</MudText>

<MudDataGrid Items="@_messages.AsEnumerable()" Hover="true" Loading="@_loading" Dense="true" Filterable="true">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <PropertyColumn Property="x => x.Name" Title="Ad Soyad" />
        <PropertyColumn Property="x => x.Email" Title="E-posta" />
        <PropertyColumn Property="x => x.Subject" Title="Konu" />
        <PropertyColumn Property="x => x.Message" Title="Mesaj" />
        <TemplateColumn Title="Durum">
            <CellTemplate>
                @if (context.Item.IsRead)
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Okundu</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">Okunmadi</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Tarih">
            <CellTemplate>
                @context.Item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Islemler" CellStyle="text-align:right">
            <CellTemplate>
                @if (!context.Item.IsRead)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Primary"
                        OnClick="@(() => MarkAsReadAsync(context.Item))" title="Okundu isaretle" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
