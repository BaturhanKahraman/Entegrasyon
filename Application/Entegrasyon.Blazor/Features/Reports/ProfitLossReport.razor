@page "/reports/profit-loss"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using Entegrasyon.Entity.Dtos.Reports

<PageTitle>Kar/Zarar Raporu</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Kar/Zarar Raporu</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="Baslangic Tarihi" @bind-Date="_startDate"
                           Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker Label="Bitis Tarihi" @bind-Date="_endDate"
                           Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="int?" Label="Pazaryeri" @bind-Value="_selectedMarketPlaceId"
                       Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)1)">Trendyol</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)2)">N11</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)3)">Hepsiburada</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)5)">Pazarama</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="GenerateReportAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Assessment">
                Rapor Olustur
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_report is not null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4" md="2">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.Revenue.ToString("N2") TL</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Ciro</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Percent" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.MarketplaceCommission.ToString("N2") TL</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Komisyon</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.TaxAmount.ToString("N2") TL</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Vergi</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.CargoExpense.ToString("N2") TL</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Kargo</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@(_report.NetProfit >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)"
                         Color="@(_report.NetProfit >= 0 ? Color.Success : Color.Error)" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2"
                         Color="@(_report.NetProfit >= 0 ? Color.Success : Color.Error)">
                    @_report.NetProfit.ToString("N2") TL
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Net Kar</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">%@_report.ProfitMargin.ToString("N1")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Kar Marji</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_report.ByMarketplace.Any())
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Pazaryeri Bazli Dagılım</MudText>
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="@_chartSeries"
                      XAxisLabels="@_xAxisLabels"
                      Width="100%"
                      Height="300px"
                      ChartOptions="_chartOptions" />
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudDataGrid T="ProfitLossByMarketplaceDto" Items="@_report.ByMarketplace.AsEnumerable()"
                         Hover="true" Striped="true" Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.MarketPlaceName" Title="Pazaryeri" />
                    <PropertyColumn Property="x => x.Revenue" Title="Ciro (TL)" Format="N2" />
                    <PropertyColumn Property="x => x.Commission" Title="Komisyon (TL)" Format="N2" />
                    <PropertyColumn Property="x => x.NetProfit" Title="Net Kar (TL)" Format="N2" />
                </Columns>
            </MudDataGrid>
        </MudPaper>
    }
}
else if (!_loading)
{
    <MudPaper Class="pa-4" Style="min-height: 200px;">
        <MudText Typo="Typo.h6" Color="Color.Dark" Align="Align.Center" Class="mt-8">
            Rapor olusturmak icin tarih araligi secin.
        </MudText>
    </MudPaper>
}
