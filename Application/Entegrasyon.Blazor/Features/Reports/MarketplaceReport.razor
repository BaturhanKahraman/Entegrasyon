@page "/reports/marketplace"

<PageTitle>Pazaryeri Raporları</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Pazaryeri Raporları</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4">Bu sayfa yapım aşamasındadır.</MudAlert>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="Pazaryeri" Variant="Variant.Outlined" Disabled="true">
                <MudSelectItem Value="@("trendyol")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MarketplaceLogo Name="Trendyol" Size="Size.Small" />
                        <MudText>Trendyol</MudText>
                    </MudStack>
                </MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Tarih Aralığı" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">Rapor Oluştur</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4" Style="min-height: 300px;">
    <MudText Typo="Typo.h6" Color="Color.Dark" Align="Align.Center" Class="mt-8">
        Pazaryeri performans raporu oluşturmak için filtreleri seçin.
    </MudText>
</MudPaper>
