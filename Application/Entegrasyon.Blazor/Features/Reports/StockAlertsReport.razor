@page "/reports/stock-alerts"
@using Entegrasyon.Entity.Dtos.Reports

<PageTitle>Stok Uyarilari</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Stok Uyarilari</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="Minimum Stok Esigi" @bind-Value="_threshold"
                             Variant="Variant.Outlined" Min="1" Max="100" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="LoadAlertsAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Warning">
                Uyarilari Getir
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_alerts.Any())
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex flex-column align-center" Style="border-left: 4px solid var(--mud-palette-error);">
                <MudText Typo="Typo.h4" Color="Color.Error">@_criticalCount</MudText>
                <MudText Typo="Typo.body2">Kritik (0-3 adet)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex flex-column align-center" Style="border-left: 4px solid var(--mud-palette-warning);">
                <MudText Typo="Typo.h4" Color="Color.Warning">@_lowCount</MudText>
                <MudText Typo="Typo.body2">Dusuk (4-@_threshold adet)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex flex-column align-center" Style="border-left: 4px solid var(--mud-palette-info);">
                <MudText Typo="Typo.h4" Color="Color.Info">@_alerts.Count</MudText>
                <MudText Typo="Typo.body2">Toplam Uyari</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4">
        <MudDataGrid T="StockAlertDto" Items="@_alerts.AsEnumerable()"
                     Hover="true" Striped="true" Dense="true"
                     SortMode="SortMode.Multiple" Filterable="true"
                     RowStyleFunc="@RowStyleFunc">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Stok Uyari Detayi</MudText>
                <MudSpacer />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.ProductName" Title="Urun" Sortable="true" />
                <PropertyColumn Property="x => x.Barcode" Title="Barkod" />
                <PropertyColumn Property="x => x.CurrentStock" Title="Mevcut Stok" Sortable="true" />
                <PropertyColumn Property="x => x.MinimumStock" Title="Minimum Stok" />
                <PropertyColumn Property="x => x.DaysUntilStockout" Title="Tukeniyor (Gun)" Sortable="true" />
                <PropertyColumn Property="x => x.SuggestedOrderQuantity" Title="Onerilen Siparis" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="StockAlertDto" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
}
else if (!_loading)
{
    <MudPaper Class="pa-4" Style="min-height: 200px;">
        <MudText Typo="Typo.h6" Color="Color.Dark" Align="Align.Center" Class="mt-8">
            Stok uyarisi icin esik degeri girin.
        </MudText>
    </MudPaper>
}
