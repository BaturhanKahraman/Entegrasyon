@page "/reports/sales"

<PageTitle>Satış Raporları</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Satış Raporları</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4">Bu sayfa yapım aşamasındadır.</MudAlert>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Başlangıç Tarihi" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Bitiş Tarihi" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true">Rapor Oluştur</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4" Style="min-height: 300px;">
    <MudText Typo="Typo.h6" Color="Color.Dark" Align="Align.Center" Class="mt-8">
        Rapor oluşturmak için tarih aralığı seçin.
    </MudText>
</MudPaper>
