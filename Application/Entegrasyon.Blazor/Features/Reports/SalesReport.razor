@page "/reports/sales"
@using Entegrasyon.Entity.Dtos.Reports

<PageTitle>Satış Raporları</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Satış Raporları</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Başlangıç Tarihi" @bind-Date="_startDate"
                           Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Bitiş Tarihi" @bind-Date="_endDate"
                           Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="GenerateReportAsync" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.Assessment">
                Rapor Oluştur
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_report is not null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.Summary.TotalSales</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Satış</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.Summary.TotalRevenue.ToString("N2") ₺</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Ciro</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.Summary.AverageOrderValue.ToString("N2") ₺</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ortalama Sepet</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="pa-4 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-2">@_report.Summary.TotalItemsSold</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Satılan Ürün Adedi</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Satış Trendi</MudText>
        <MudChart ChartType="ChartType.Line"
                  ChartSeries="@_chartSeries"
                  XAxisLabels="@_xAxisLabels"
                  Width="100%"
                  Height="300px"
                  ChartOptions="_chartOptions" />
    </MudPaper>

    @if (_report.TopProducts.Any())
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">En Çok Satan 10 Ürün</MudText>
            <MudDataGrid T="TopSellingProductDto" Items="@_report.TopProducts.AsEnumerable()"
                         Hover="true" Striped="true" Dense="true">
                <Columns>
                    <PropertyColumn Property="x => x.ProductTitle" Title="Ürün" />
                    <PropertyColumn Property="x => x.VariantTitle" Title="Varyant" />
                    <PropertyColumn Property="x => x.QuantitySold" Title="Adet" />
                    <PropertyColumn Property="x => x.Revenue" Title="Ciro" Format="N2" />
                </Columns>
            </MudDataGrid>
        </MudPaper>
    }
}
else if (!_loading)
{
    <MudPaper Class="pa-4" Style="min-height: 200px;">
        <MudText Typo="Typo.h6" Color="Color.Dark" Align="Align.Center" Class="mt-8">
            Rapor oluşturmak için tarih aralığı seçin.
        </MudText>
    </MudPaper>
}
