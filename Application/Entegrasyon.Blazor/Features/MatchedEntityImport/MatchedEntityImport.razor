@page "/matched-entities"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Marketplace.View)]

<PageTitle>Hazır Şablonlar</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Hazır Şablonlar</MudText>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_searchTerm"
                                  Label="Ara" Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  OnDebounceIntervalElapsed="OnSearchChanged" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" Value="_typeFilter" Label="Tür" Variant="Variant.Outlined"
                               Clearable="true" ValueChanged="OnTypeFilterChanged">
                        <MudSelectItem T="int?" Value="0">Kategori</MudSelectItem>
                        <MudSelectItem T="int?" Value="1">Marka</MudSelectItem>
                        <MudSelectItem T="int?" Value="2">Kargo Şirketi</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-4" />
}
else if (_packages.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        Henüz yayınlanmış şablon paketi bulunmuyor.
    </MudAlert>
}
else
{
    <MudGrid Class="mt-4">
        @foreach (var pkg in _packages)
        {
            <MudItem xs="12" sm="6" md="4">
                <MatchedEntityPackageCard Package="pkg"
                                          OnViewDetail="ShowDetailDialog"
                                          OnImport="StartImport" />
            </MudItem>
        }
    </MudGrid>
}
