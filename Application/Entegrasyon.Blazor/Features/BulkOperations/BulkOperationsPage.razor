@page "/bulk-operations"
@using Entegrasyon.Entity.BulkOperations

<PageTitle>Toplu İşlemler</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Toplu İşlemler</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="İçe Aktar" Icon="@Icons.Material.Filled.Upload">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Ürün İçe Aktarma</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                           Color="Color.Primary"
                                           OnClick="@(() => DownloadTemplateAsync(BulkOperationType.ProductImport))"
                                           Title="Şablon İndir" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Excel dosyasından toplu ürün bilgisi içe aktarın. Mevcut barkodlar güncellenir.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Upload"
                                   OnClick="@(() => OpenImportDialogAsync(BulkOperationType.ProductImport))">
                            Ürün İçe Aktar
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Fiyat İçe Aktarma</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                           Color="Color.Primary"
                                           OnClick="@(() => DownloadTemplateAsync(BulkOperationType.PriceImport))"
                                           Title="Şablon İndir" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Barkod bazlı toplu fiyat güncellemesi yapın.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Upload"
                                   OnClick="@(() => OpenImportDialogAsync(BulkOperationType.PriceImport))">
                            Fiyat İçe Aktar
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Stok İçe Aktarma</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                           Color="Color.Primary"
                                           OnClick="@(() => DownloadTemplateAsync(BulkOperationType.StockImport))"
                                           Title="Şablon İndir" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Barkod ve şube bazlı toplu stok güncellemesi yapın.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Tertiary"
                                   StartIcon="@Icons.Material.Filled.Upload"
                                   OnClick="@(() => OpenImportDialogAsync(BulkOperationType.StockImport))">
                            Stok İçe Aktar
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Dışa Aktar" Icon="@Icons.Material.Filled.Download">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="_isExporting"
                           OnClick="@(() => ExportAsync(BulkOperationType.ProductExport))">
                    @if (_isExporting && _currentExportType == BulkOperationType.ProductExport)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Ürünleri Dışa Aktar
                </MudButton>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="_isExporting"
                           OnClick="@(() => ExportAsync(BulkOperationType.PriceExport))">
                    @if (_isExporting && _currentExportType == BulkOperationType.PriceExport)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Fiyatları Dışa Aktar
                </MudButton>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Tertiary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="_isExporting"
                           OnClick="@(() => ExportAsync(BulkOperationType.StockExport))">
                    @if (_isExporting && _currentExportType == BulkOperationType.StockExport)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Stokları Dışa Aktar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Geçmiş İşlemler" Icon="@Icons.Material.Filled.History">
        @if (_recentOperations is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudDataGrid Items="@_recentOperations.AsEnumerable()" Dense="true" Hover="true" Striped="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.OperationType" Title="İşlem Tipi" />
                    <PropertyColumn Property="x => x.FileName" Title="Dosya Adı" />
                    <PropertyColumn Property="x => x.TotalRows" Title="Toplam Satır" />
                    <PropertyColumn Property="x => x.SuccessCount" Title="Başarılı" />
                    <PropertyColumn Property="x => x.ErrorCount" Title="Hatalı" />
                    <TemplateColumn Title="Durum">
                        <CellTemplate>
                            <MudChip T="string"
                                     Color="@GetStatusColor(context.Item.Status)"
                                     Size="Size.Small">
                                @GetStatusText(context.Item.Status)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.StartedAt" Title="Başlangıç" Format="dd.MM.yyyy HH:mm" />
                </Columns>
            </MudDataGrid>
        }
    </MudTabPanel>
</MudTabs>
