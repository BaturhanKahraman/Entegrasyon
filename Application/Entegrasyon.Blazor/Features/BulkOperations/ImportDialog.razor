@using Entegrasyon.Entity.BulkOperations
@using Entegrasyon.Entity.Dtos.BulkOperations

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" />
            @GetTitle()
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudFileUpload T="IBrowserFile"
                       Accept=".xlsx,.xls,.csv"
                       FilesChanged="OnFileSelected"
                       MaximumFileCount="1">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           FullWidth="true">
                    Dosya Sec (.xlsx, .csv)
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (_selectedFile is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                <MudText Typo="Typo.body2">
                    <strong>Secilen dosya:</strong> @_selectedFile.Name (@FormatFileSize(_selectedFile.Size))
                </MudText>
            </MudAlert>
        }

        @if (_isValidating)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-3" />
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Dogrulanıyor...</MudText>
        }

        @if (_isImporting)
        {
            @if (_currentProgress is not null && _currentProgress.Total > 0)
            {
                <MudProgressLinear Value="@((double)_currentProgress.Current / _currentProgress.Total * 100)"
                                   Color="Color.Primary"
                                   Class="mt-3"
                                   Rounded="true"
                                   Size="Size.Large">
                    <MudText Typo="Typo.body2">@($"{(int)((double)_currentProgress.Current / _currentProgress.Total * 100)}%")</MudText>
                </MudProgressLinear>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">@_currentProgress.Message</MudText>
            }
            else
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-2">
                <MudText Typo="Typo.body2">Ice aktarilıyor...</MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="CancelImport">
                    Iptal Et
                </MudButton>
            </MudStack>
        }

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }

        <ValidationPreviewPanel Preview="_validationPreview" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@(_isValidating || _isImporting)">Iptal</MudButton>

        @if (_validationPreview is null)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       OnClick="ValidateAsync"
                       Disabled="@(_selectedFile is null || _isValidating)">
                Dogrula
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="ResetValidation"
                       Disabled="_isImporting">
                Yeni Dosya
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ImportAsync"
                       Disabled="@(_validationPreview.ValidRows == 0 || _isImporting)">
                Ice Aktar (@_validationPreview.ValidRows satir)
            </MudButton>
        }
    </DialogActions>
</MudDialog>
