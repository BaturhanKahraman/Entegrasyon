<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
            İçe Aktarma Sonucu
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="4">
                <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true">
                    <MudText Typo="Typo.body2">Toplam: <strong>@ImportResult.TotalRows</strong></MudText>
                </MudAlert>
            </MudItem>
            <MudItem xs="4">
                <MudAlert Severity="Severity.Success" Dense="true" NoIcon="true">
                    <MudText Typo="Typo.body2">Başarılı: <strong>@ImportResult.SuccessCount</strong></MudText>
                </MudAlert>
            </MudItem>
            <MudItem xs="4">
                <MudAlert Severity="@(ImportResult.ErrorCount > 0 ? Severity.Error : Severity.Success)" Dense="true" NoIcon="true">
                    <MudText Typo="Typo.body2">Hatalı: <strong>@ImportResult.ErrorCount</strong></MudText>
                </MudAlert>
            </MudItem>
        </MudGrid>

        @if (ImportResult.Errors.Count > 0)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Hatalar</MudText>
            <MudDataGrid Items="@ImportResult.Errors.AsEnumerable()" Dense="true" Hover="true" Striped="true"
                         Style="max-height: 400px; overflow-y: auto;">
                <Columns>
                    <PropertyColumn Property="x => x.RowNumber" Title="Satır" />
                    <PropertyColumn Property="x => x.Barcode" Title="Barkod" />
                    <PropertyColumn Property="x => x.ErrorMessage" Title="Hata Mesajı" />
                </Columns>
            </MudDataGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Kapat</MudButton>
    </DialogActions>
</MudDialog>
