@page "/roles"
@using Entegrasyon.ApplicationBootstrap.Security
@attribute [Authorize(Policy = AppPermissions.Roles.View)]
@using Entegrasyon.Entity.User
@using Entegrasyon.Blazor.Features.Admin
@using Entegrasyon.Blazor.Models

<PageTitle>Rol Yönetimi</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Rol Yönetimi</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="12" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenAddRoleDialog">
                Yeni Rol
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@_roles" Hover="true" Loading="@_loading">
    <HeaderContent>
        <MudTh>Rol Adı</MudTh>
        <MudTh>Yetkiler</MudTh>
        <MudTh Style="text-align:right">İşlemler</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Rol Adı">@context.Name</MudTd>
        <MudTd DataLabel="Yetkiler">
            <!-- Display count of permissions assigned to this role -->
            @if (context.RoleClaims != null && context.RoleClaims.Count > 0)
            {
                <MudChip T="string" Size="Size.Small">@context.RoleClaims.Count yetki</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small">Yetki yok</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="İşlemler" Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                OnClick="@(() => EditRole(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                OnClick="@(() => DeleteRole(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>
