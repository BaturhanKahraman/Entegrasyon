@if (_loading)
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudSkeleton Width="40%" Height="24px" />
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" />
        </MudCardContent>
    </MudCard>
}
else
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Son 30 Gun Kar Grafigi</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_hasData)
            {
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@_chartData"
                          XAxisLabels="@_xAxisLabels"
                          Width="100%"
                          Height="300px"
                          ChartOptions="@_chartOptions" />
            }
            else
            {
                <MudText Color="Color.Secondary" Align="Align.Center" Class="py-8">
                    Henuz kar verisi bulunmuyor.
                </MudText>
            }
        </MudCardContent>
    </MudCard>
}
