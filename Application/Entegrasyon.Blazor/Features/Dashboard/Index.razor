@page "/"

<PageTitle>Ana Sayfa - Dashboard</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Dashboard</MudText>
<MudText Class="mb-4" Color="Color.Secondary">E-Commerce Entegrasyon Platformuna Hoş Geldiniz</MudText>

<MudGrid>
    <DashboardStatsCards />
</MudGrid>

<MudGrid Class="mt-4">
    <MudItem xs="12" md="8">
        <DashboardWeeklyChart />
    </MudItem>
    <MudItem xs="12" md="4">
        <DashboardQuickActions OnSyncCompleted="@OnSyncCompleted" />
    </MudItem>
    <MudItem xs="12" md="6">
        <DashboardMarketplaceStatus @ref="_marketplaceStatus" />
    </MudItem>
    <MudItem xs="12" md="6">
        <DashboardRecentActivity />
    </MudItem>
</MudGrid>
