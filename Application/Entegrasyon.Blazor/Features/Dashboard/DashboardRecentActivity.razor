@if (_loading)
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudSkeleton Width="40%" Height="24px" />
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @for (var i = 0; i < 4; i++)
            {
                <div class="d-flex align-center gap-3 mb-3">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    <div>
                        <MudSkeleton Width="200px" Height="14px" Class="mb-1" />
                        <MudSkeleton Width="80px" Height="12px" />
                    </div>
                </div>
            }
        </MudCardContent>
    </MudCard>
}
else
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Son Aktiviteler</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_activities.Count == 0)
            {
                <MudText Color="Color.Secondary" Typo="Typo.body2">Henüz aktivite bulunmuyor.</MudText>
            }
            else
            {
                <MudTimeline TimelineOrientation="TimelineOrientation.Vertical">
                    @foreach (var (activity, idx) in _activities.Select((a, i) => (a, i)))
                    {
                        <MudTimelineItem @key="idx" Color="@activity.Color" Size="Size.Small" Icon="@activity.Icon">
                            <ItemContent>
                                <MudText Typo="Typo.body2">@activity.Message</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@activity.Time</MudText>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
        </MudCardContent>
    </MudCard>
}
