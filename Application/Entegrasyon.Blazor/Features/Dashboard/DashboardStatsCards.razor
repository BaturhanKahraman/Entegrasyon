@if (_loading)
{
    @for (var i = 0; i < 4; i++)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudSkeleton Width="60%" Height="16px" Class="mb-2" />
                    <MudSkeleton Width="40%" Height="32px" Class="mb-1" />
                    <MudSkeleton Width="30%" Height="12px" />
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
}
else
{
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Ürün</MudText>
                        <MudText Typo="Typo.h4">@_stats.TotalProducts</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_stats.TotalVariants varyant</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Primary" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bugünkü Satışlar</MudText>
                        <MudText Typo="Typo.h4">@_stats.TodaySales</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Success">@($"₺{_stats.TodayRevenue:N2}")</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Success" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bekleyen Sipariş</MudText>
                        <MudText Typo="Typo.h4">@_stats.PendingOrders</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Large" Color="Color.Warning" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2" Class="hover-card">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Düşük Stok</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Error">@_stats.LowStockProducts</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Error" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
}
