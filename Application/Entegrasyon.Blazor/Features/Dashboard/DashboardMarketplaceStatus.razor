@if (_loading)
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudSkeleton Width="40%" Height="24px" />
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @for (var i = 0; i < 2; i++)
            {
                <div class="d-flex justify-space-between align-center mb-3">
                    <div class="d-flex align-center gap-2">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                        <MudSkeleton Width="100px" Height="16px" />
                    </div>
                    <MudSkeleton Width="160px" Height="24px" />
                </div>
            }
        </MudCardContent>
    </MudCard>
}
else
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Pazaryeri Durumu</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_marketplaceStatuses.Count == 0)
            {
                <MudText Color="Color.Secondary" Typo="Typo.body2">Henüz pazaryeri tanımlanmamış.</MudText>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var marketplace in _marketplaceStatuses)
                    {
                        <MudListItem @key="marketplace.Name" T="string">
                            <div class="d-flex justify-space-between align-center" style="width: 100%">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Color="@marketplace.Color" Size="Size.Small">
                                        <MudIcon Icon="@marketplace.Icon" Size="Size.Small" />
                                    </MudAvatar>
                                    <MudText>@marketplace.Name</MudText>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (marketplace.SyncedCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                            @marketplace.SyncedCount Senkron
                                        </MudChip>
                                    }
                                    @if (marketplace.PendingCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                            @marketplace.PendingCount Bekliyor
                                        </MudChip>
                                    }
                                    @if (marketplace.FailedCount > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error">
                                            @marketplace.FailedCount Hatalı
                                        </MudChip>
                                    }
                                    @if (marketplace.SyncedCount == 0 && marketplace.PendingCount == 0 && marketplace.FailedCount == 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                            Ürün Yok
                                        </MudChip>
                                    }
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    </MudCard>
}
