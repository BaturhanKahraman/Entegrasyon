@using Entegrasyon.Entity.Dtos.Product

@if (IsLoading)
{
    <MudGrid Class="mb-4">
        @for (var i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" />
            </MudItem>
        }
    </MudGrid>
}
else if (Summary is not null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent Class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Info" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h4">@Summary.TotalProducts</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Dark">Toplam</MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent Class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h4">@Summary.SyncedCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Dark">Senkronize</MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent Class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Color="Color.Warning" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h4">@Summary.PendingCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Dark">Bekleyen</MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent Class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h4">@Summary.FailedCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Dark">Hata</MudText>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
