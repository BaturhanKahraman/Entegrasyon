@using Entegrasyon.Entity.Dtos.Product
@using Entegrasyon.Entity.Dtos.Product.Marketplace

<MudStack Spacing="3">

    @* Durum Satırı *@
    <MudPaper Class="pa-3" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Trendyol Durumu</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Dark">Durum</MudText>
                <div>
                    <MudChip T="string" Size="Size.Small"
                             Color="@ProductSyncPage.GetSyncStateColor(SyncItem.SyncState)">
                        @ProductSyncPage.GetSyncStateLabel(SyncItem.SyncState)
                    </MudChip>
                    @if (SyncItem.IsApproved.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Class="ml-1"
                                 Color="@GetApprovalColor()">
                            @GetApprovalLabel()
                        </MudChip>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Dark">Content ID</MudText>
                <MudText Typo="Typo.body2">@(SyncItem.ContentId?.ToString() ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Dark">Harici Ürün ID</MudText>
                <MudText Typo="Typo.body2">@(SyncItem.ExternalProductId ?? "—")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Dark">Son Senkronizasyon</MudText>
                <MudText Typo="Typo.body2">@(SyncItem.LastSyncedAt?.LocalDateTime.ToString("dd.MM.yyyy HH:mm") ?? "—")</MudText>
            </MudItem>
            @if (!string.IsNullOrEmpty(SyncItem.BatchRequestId))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Dark">Batch ID</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.caption">@(SyncItem.BatchRequestId.Length > 40 ? SyncItem.BatchRequestId[..40] + "..." : SyncItem.BatchRequestId)</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                       OnClick="@(() => CopyToClipboard(SyncItem.BatchRequestId))" />
                    </MudStack>
                </MudItem>
            }
            @if (!string.IsNullOrEmpty(SyncItem.StatusMessage))
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@SyncItem.StatusMessage</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    @* Override Paneli *@
    @if (Overrides is not null)
    {
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Pazaryeri Düzenlemeleri</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Dark">Başlık Düzenlemesi</MudText>
                    <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Overrides.TitleOverride) ? "—" : Overrides.TitleOverride)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Dark">Açıklama Düzenlemesi</MudText>
                    <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Overrides.DescriptionOverride) ? "—" : Overrides.DescriptionOverride[..Math.Min(100, Overrides.DescriptionOverride.Length)] + (Overrides.DescriptionOverride.Length > 100 ? "..." : ""))</MudText>
                </MudItem>
                @if (Overrides.VariantOverrides.Any(v => v.ListPriceOverride.HasValue || v.SalePriceOverride.HasValue))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Dark" Class="mb-1">Fiyat Düzenlemeleri</MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                            <thead>
                                <tr>
                                    <th>Varyant</th>
                                    <th>Liste Fiyatı (Düzenleme)</th>
                                    <th>Satış Fiyatı (Düzenleme)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vo in Overrides.VariantOverrides.Where(v => v.ListPriceOverride.HasValue || v.SalePriceOverride.HasValue))
                                {
                                    <tr @key="vo.ProductVariantId">
                                        <td>@vo.Barcode</td>
                                        <td>@(vo.ListPriceOverride?.ToString("N2") ?? "—")</td>
                                        <td>@(vo.SalePriceOverride?.ToString("N2") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    @* Aksiyonlar *@
    <AuthorizeView Policy="@AppPermissions.Marketplace.Edit" Context="editCtx">
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="OpenContentUpdateDialog"
                       Disabled="@(_isBusy || IsProcessing)">
                İçerik Güncelle
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.AttachMoney"
                       OnClick="OpenPriceStockDialog"
                       Disabled="@(_isBusy || IsProcessing)">
                Fiyat/Stok Güncelle
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="HandleSync"
                       Disabled="@(_isBusy || IsProcessing)">
                Sync
            </MudButton>
            <AuthorizeView Policy="@AppPermissions.Marketplace.Delete" Context="deleteCtx">
                @if (SyncItem.IsApproved == true || !string.IsNullOrEmpty(SyncItem.ExternalProductId))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="HandleDelete"
                               Disabled="@(_isBusy || IsProcessing)">
                        Sil
                    </MudButton>
                }
            </AuthorizeView>
        </MudStack>
    </AuthorizeView>

</MudStack>
