@using Entegrasyon.Entity.Logs

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Aktivite Geçmişi</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_activities.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">Henüz aktivite kaydı yok.</MudAlert>
    }
    else
    {
        <MudTimeline TimelinePosition="TimelinePosition.Start">
            @foreach (var activity in _activities)
            {
                <MudTimelineItem @key="activity.Id" Color="@GetColor(activity.Status)" Size="Size.Small"
                                 TimelineAlign="TimelineAlign.End">
                    <ItemOpposite>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @activity.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss")
                        </MudText>
                    </ItemOpposite>
                    <ItemContent>
                        <MudStack Spacing="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @if (!string.IsNullOrEmpty(activity.MarketplaceName))
                                {
                                    <MarketplaceLogo Name="@activity.MarketplaceName" Size="Size.Small" />
                                }
                                <MudText Typo="Typo.body2"><b>@GetActivityLabel(activity.ActivityType)</b></MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">@activity.Message</MudText>
                            @if (!string.IsNullOrEmpty(activity.ReferenceId))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Ref: @activity.ReferenceId
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(activity.Detail))
                            {
                                <MudAlert Severity="@GetSeverity(activity.Status)" Dense="true" Class="mt-1"
                                          Style="font-size: 0.75rem;">
                                    @activity.Detail
                                </MudAlert>
                            }
                        </MudStack>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }
</MudPaper>
