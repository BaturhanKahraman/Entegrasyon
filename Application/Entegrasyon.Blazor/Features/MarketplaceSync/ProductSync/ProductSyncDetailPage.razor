@page "/marketplace/matching/{Id:guid}"
@rendermode InteractiveServer
@using Entegrasyon.Entity.Dtos.Product

<PageTitle>Ürün Pazaryeri Eşleştirme</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Ürün bulunamadı.</MudAlert>
}
else
{
    <MudButton OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack"
               Variant="Variant.Text" Color="Color.Default" Class="mb-2">
        Ürün Eşleştirmeye Dön
    </MudButton>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
        <MudText Typo="Typo.h5">@_detail.Title</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@_detail.StockCode</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_detail.BrandName</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_detail.CategoryName</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Info">@_detail.VariantCount varyant</MudChip>
    </MudStack>

    <MudText Typo="Typo.h6" Class="mb-3">Pazaryeri Durumları</MudText>

    <MudGrid>
        @foreach (var mp in _detail.Marketplaces)
        {
            <MudItem @key="mp.MarketPlaceId" xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MarketplaceLogo Name="@mp.MarketPlaceName" Size="Size.Medium" />
                                <MudText Typo="Typo.h6">@mp.MarketPlaceName</MudText>
                            </MudStack>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@ProductSyncPage.GetSyncStateColor(mp.SyncState)">
                                @ProductSyncPage.GetSyncStateLabel(mp.SyncState)
                            </MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Dark">
                                Son Senkronizasyon:
                                <strong>@(mp.LastSyncedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</strong>
                            </MudText>
                            @if (!string.IsNullOrEmpty(mp.BatchRequestId))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Dark">
                                    Batch ID: @mp.BatchRequestId
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(mp.StatusMessage))
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                                    @mp.StatusMessage
                                </MudAlert>
                            }
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        @if (mp.SyncState is MarketplaceSyncState.NeverSynced or MarketplaceSyncState.OutOfSync)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Sync"
                                       OnClick="@(() => SyncToMarketplace(mp.MarketPlaceId))">
                                Senkronize Et
                            </MudButton>
                        }
                        else if (mp.SyncState is MarketplaceSyncState.Failed or MarketplaceSyncState.Rejected)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Replay"
                                       OnClick="@(() => RetryMarketplace(mp.MarketPlaceId))">
                                Tekrarla
                            </MudButton>
                        }
                        else if (mp.SyncState is MarketplaceSyncState.Waiting or MarketplaceSyncState.Processing)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.HourglassTop" Disabled="true">
                                İşleniyor...
                            </MudButton>
                        }
                        else if (mp.SyncState is MarketplaceSyncState.Synced)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Sync"
                                       OnClick="@(() => SyncToMarketplace(mp.MarketPlaceId))">
                                Yeniden Gönder
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <div class="mt-4">
        <ProductActivityTimeline ProductId="Id" />
    </div>
}
