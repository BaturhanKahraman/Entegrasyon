@page "/products/{Id:guid}/sync"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Marketplace.View)]
@using Entegrasyon.Entity.Dtos.Product
@using Entegrasyon.Entity.Dtos.Product.Marketplace

<PageTitle>Pazaryeri Senkronizasyon Detayı</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Ürün bulunamadı.</MudAlert>
}
else
{
    <MudStack Spacing="3">

        @* Üst başlık satırı *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack"
                       Variant="Variant.Text" Color="Color.Default">
                Ürüne Dön
            </MudButton>
            <MudText Typo="Typo.h5">@_detail.Title</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@_detail.StockCode</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_detail.BrandName</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_detail.CategoryName</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Info">@_detail.VariantCount varyant</MudChip>
        </MudStack>

        @* Pazaryeri durum kartları *@
        <div>
            <MudText Typo="Typo.h6" Class="mb-2">Pazaryeri Durumları</MudText>
            <MarketplaceStatusCards Marketplaces="@_detail.Marketplaces.AsReadOnly()"
                                    IsLoading="@_loading"
                                    OnMarketplaceSelected="@SetActiveTab" />
        </div>

        @* Pazaryeri tabları — sadece kaydı olan pazaryerleri *@
        @{
            var tabMarketplaces = _detail.Marketplaces
                .Where(m => m.SyncState != MarketplaceSyncState.NeverSynced)
                .ToList();
        }
        @if (tabMarketplaces.Count > 0)
        {
            <MudPaper Elevation="1">
                <MudTabs @bind-ActivePanelIndex="_activeTab" Rounded="true" ApplyEffectsToContainer="true">
                    @for (int i = 0; i < tabMarketplaces.Count; i++)
                    {
                        var mp = tabMarketplaces[i];
                        <MudTabPanel @key="mp.MarketPlaceId" Text="@mp.MarketPlaceName">
                            <MudStack Class="pa-4" Spacing="2">
                                @if (mp.MarketPlaceId == 1)
                                {
                                    <TrendyolProductDetail ProductId="Id"
                                                           SyncItem="@mp"
                                                           Overrides="@_trendyolOverrides"
                                                           OnSyncCompleted="@RefreshData" />
                                }
                                else if (mp.MarketPlaceId == 2)
                                {
                                    <N11ProductDetail ProductId="Id"
                                                      SyncItem="@mp"
                                                      OnSyncCompleted="@RefreshData" />
                                }
                                else if (mp.MarketPlaceId == 3)
                                {
                                    <HepsiburadaProductDetail ProductId="Id"
                                                              SyncItem="@mp"
                                                              OnSyncCompleted="@RefreshData" />
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info">@mp.MarketPlaceName için detay sayfası yakında gelecek.</MudAlert>
                                }
                            </MudStack>
                        </MudTabPanel>
                    }
                </MudTabs>
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                Bu ürün henüz hiçbir pazaryerine eklenmemiş.
            </MudAlert>
        }

        @* Aktivite zaman çizelgesi *@
        <div>
            <ProductActivityTimeline ProductId="Id" />
        </div>

    </MudStack>
}
