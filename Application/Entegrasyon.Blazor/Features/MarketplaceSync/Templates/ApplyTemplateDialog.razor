@using Entegrasyon.Entity.Dtos.Category

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="mr-3" />
            Template Uygula
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_templates.Count == 0)
        {
            <MudAlert Severity="Severity.Info">Bu marketplace icin kayitli template bulunamadi.</MudAlert>
        }
        else
        {
            <MudList T="CategoryMatchTemplateDto" Dense="true" @bind-SelectedValue="_selectedTemplate">
                @foreach (var template in _templates)
                {
                    <MudListItem @key="template.Id" Value="template">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1">@template.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @template.MappingCount eslestirme - @template.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                </MudText>
                                @if (!string.IsNullOrEmpty(template.Description))
                                {
                                    <MudText Typo="Typo.caption">@template.Description</MudText>
                                }
                            </MudStack>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteTemplate(template))"
                                           title="Template'i sil" />
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Iptal</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Apply"
                   Disabled="_selectedTemplate is null || _isApplying">
            @if (_isApplying)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Uygulanıyor...</span>
            }
            else
            {
                <span>Uygula</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
