<MudPaper Elevation="2" Class="pa-4">
    <MudText Typo="Typo.h6" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Calculate" Class="mr-1" />
        Komisyon Hesaplayıcı
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudNumericField T="decimal"
                             Label="Satış Fiyatı (TL)"
                             @bind-Value="_salePrice"
                             Variant="Variant.Outlined"
                             Min="0"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.CurrencyLira"
                             Immediate="true"
                             DebounceInterval="300"
                             OnDebounceIntervalElapsed="CalculateAsync" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudNumericField T="decimal"
                             Label="Maliyet Fiyatı (TL)"
                             @bind-Value="_costPrice"
                             Variant="Variant.Outlined"
                             Min="0"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.CurrencyLira"
                             Immediate="true"
                             DebounceInterval="300"
                             OnDebounceIntervalElapsed="CalculateAsync" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-1"
                       StartIcon="@Icons.Material.Filled.Calculate"
                       OnClick="CalculateAsync"
                       Disabled="@(_salePrice <= 0)">
                Hesapla
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_result is not null)
    {
        <MudDivider Class="my-4" />

        <MudGrid>
            <MudItem xs="12" md="6" lg="3">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardContent Class="text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Komisyon Tutarı</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Error">@_result.CommissionAmount.ToString("C2", _trCulture)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6" lg="3">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardContent Class="text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Kesinti</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Warning">@_result.TotalDeductions.ToString("C2", _trCulture)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6" lg="3">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardContent Class="text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Net Gelir</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Info">@_result.NetRevenue.ToString("C2", _trCulture)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6" lg="3">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardContent Class="text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Net Kar</MudText>
                        <MudText Typo="Typo.h5" Color="@(_result.NetProfit >= 0 ? Color.Success : Color.Error)">
                            @_result.NetProfit.ToString("C2", _trCulture)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Kar Marjı: %@_result.ProfitMarginPercent.ToString("N2")
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudSimpleTable Dense="true" Hover="true" Class="mt-4" Elevation="0" Bordered="true">
            <thead>
                <tr>
                    <th>Kalem</th>
                    <th class="text-right">Tutar</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Satış Fiyatı</td>
                    <td class="text-right">@_result.SalePrice.ToString("C2", _trCulture)</td>
                </tr>
                <tr>
                    <td>Komisyon Tutarı</td>
                    <td class="text-right text-error">-@_result.CommissionAmount.ToString("C2", _trCulture)</td>
                </tr>
                <tr>
                    <td>Hizmet Bedeli</td>
                    <td class="text-right text-error">-@_result.ServiceFeeAmount.ToString("C2", _trCulture)</td>
                </tr>
                <tr>
                    <td>Sabit İşlem Ücreti</td>
                    <td class="text-right text-error">-@_result.TransactionFee.ToString("C2", _trCulture)</td>
                </tr>
                <tr style="font-weight: bold;">
                    <td>Net Gelir</td>
                    <td class="text-right">@_result.NetRevenue.ToString("C2", _trCulture)</td>
                </tr>
                <tr>
                    <td>Maliyet</td>
                    <td class="text-right">-@_result.CostPrice.ToString("C2", _trCulture)</td>
                </tr>
                <tr style="font-weight: bold; border-top: 2px solid;">
                    <td>Net Kar</td>
                    <td class="text-right">@_result.NetProfit.ToString("C2", _trCulture)</td>
                </tr>
            </tbody>
        </MudSimpleTable>
    }
    else if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">@_errorMessage</MudAlert>
    }
</MudPaper>
