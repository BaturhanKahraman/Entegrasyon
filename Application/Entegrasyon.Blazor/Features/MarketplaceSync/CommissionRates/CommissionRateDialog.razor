<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudSwitch T="bool"
                       Label="Varsayılan Oran"
                       Color="Color.Primary"
                       @bind-Value="Dto.IsDefault" />

            @if (!Dto.IsDefault)
            {
                <MudAutocomplete T="CategorySelectItem"
                                 Label="Kategori"
                                 @bind-Value="_selectedCategory"
                                 SearchFunc="SearchCategories"
                                 ToStringFunc="@(c => c?.Name ?? "")"
                                 Variant="Variant.Outlined"
                                 Class="mt-3"
                                 Required="true"
                                 RequiredError="Kategori seçilmeli." />
            }

            <MudNumericField T="decimal"
                             Label="Komisyon Oranı (%)"
                             @bind-Value="Dto.CommissionPercent"
                             Variant="Variant.Outlined"
                             Min="0" Max="100"
                             Step="0.5M"
                             Class="mt-3"
                             Required="true"
                             RequiredError="Komisyon oranı girilmeli." />

            <MudNumericField T="decimal?"
                             Label="Hizmet Bedeli (%)"
                             @bind-Value="Dto.ServiceFeePercent"
                             Variant="Variant.Outlined"
                             Min="0" Max="100"
                             Step="0.5M"
                             Class="mt-3" />

            <MudNumericField T="decimal?"
                             Label="Sabit İşlem Ücreti (TL)"
                             @bind-Value="Dto.TransactionFeeFixed"
                             Variant="Variant.Outlined"
                             Min="0"
                             Step="0.5M"
                             Class="mt-3" />

            <MudTextField T="string"
                          Label="Açıklama"
                          @bind-Value="Dto.Description"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mt-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Kaydet
        </MudButton>
    </DialogActions>
</MudDialog>
