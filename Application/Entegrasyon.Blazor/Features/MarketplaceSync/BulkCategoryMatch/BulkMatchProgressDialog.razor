@using Entegrasyon.Entity.Dtos.Category

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-3" Color="Color.Success" />
            Eşleştirme Sonucu
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: var(--mud-palette-success-lighten);">
                        <MudText Typo="Typo.caption">Başarılı</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Success">@Result.SuccessCount</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6">
                    <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: var(--mud-palette-info-lighten);">
                        <MudText Typo="Typo.caption">Atlanan (Mevcut)</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Info">@Result.SkippedCount</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (Result.FailedCount > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @Result.FailedCount eşleştirme başarısız oldu.
                </MudAlert>

                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>Kategori</th>
                            <th>Hata</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in Result.Errors)
                        {
                            <tr>
                                <td>@error.CategoryName</td>
                                <td><MudText Color="Color.Error" Typo="Typo.body2">@error.ErrorMessage</MudText></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            <MudText Typo="Typo.body2" Color="Color.Tertiary">
                Toplam istek: @Result.TotalRequested
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Tamam</MudButton>
    </DialogActions>
</MudDialog>
