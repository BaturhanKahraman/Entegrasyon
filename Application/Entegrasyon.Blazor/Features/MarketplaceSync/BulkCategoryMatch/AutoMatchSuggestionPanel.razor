@using Entegrasyon.Entity.Dtos.Category

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle1">AI Otomatik Oneri</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (!IsOllamaAvailable)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Ollama Cevrimdisi</MudChip>
            }
            else
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           OnClick="RequestSuggestions"
                           Disabled="IsLoading || SelectedCategories.Count == 0">
                    @if (IsLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Oneriler yukleniyor...</span>
                    }
                    else
                    {
                        <span>Otomatik Oner (@SelectedCategories.Count)</span>
                    }
                </MudButton>
            }
        </MudStack>
    </MudStack>

    @if (Suggestions.Count > 0)
    {
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th>Onerilen Eslestirme</th>
                    <th>Guven</th>
                    <th>Neden</th>
                    <th>Islem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var suggestion in Suggestions)
                {
                    <tr @key="suggestion.ApplicationCategoryId">
                        <td>@suggestion.ApplicationCategoryName</td>
                        <td>@suggestion.SuggestedMarketPlaceCategoryName</td>
                        <td>
                            <MudChip T="string" Size="Size.Small" Color="@GetConfidenceColor(suggestion.Confidence)">
                                @suggestion.Confidence.ToString("P0")
                            </MudChip>
                        </td>
                        <td>
                            <MudText Typo="Typo.caption">@suggestion.Reason</MudText>
                        </td>
                        <td>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => ApplySuggestion(suggestion))">
                                Uygula
                            </MudButton>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       OnClick="ApplyHighConfidenceSuggestions">
                Yuksek Guvenli Onerileri Uygula (@HighConfidenceCount)
            </MudButton>
        </MudStack>
    }
    else if (!IsLoading && HasRequested)
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            Secili kategoriler icin oneri bulunamadi.
        </MudAlert>
    }
</MudPaper>
