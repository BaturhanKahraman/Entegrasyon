@using Entegrasyon.Entity.Categories

<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-3">Kategoriler</MudText>

    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudTextField @bind-Value="_searchText"
                      Label="Kategori Ara"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Class="mb-3" />

        <MudText Typo="Typo.caption" Class="mb-2">
            @FilteredCategories.Count() kategori | @SelectedCategories.Count seçili
        </MudText>

        <div style="height: 400px; overflow-y: auto;">
            <MudList T="Category" Dense="true">
                @foreach (var category in FilteredCategories)
                {
                    <MudListItem @key="category.Id" T="Category">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudCheckBox T="bool"
                                         Value="@SelectedCategories.Contains(category)"
                                         ValueChanged="@((val) => ToggleCategory(category, val))"
                                         Dense="true" />
                            <MudText Typo="Typo.body2">@category.Name</MudText>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </div>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       OnClick="SelectAll">
                Tümünü Seç
            </MudButton>
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       OnClick="DeselectAll">
                Temizle
            </MudButton>
        </MudStack>
    }
</MudPaper>
