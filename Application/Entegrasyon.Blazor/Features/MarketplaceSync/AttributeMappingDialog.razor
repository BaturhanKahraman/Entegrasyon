@using Entegrasyon.Entity.Categories
@using Entegrasyon.Entity.Dtos.Category
@using AppCategoryAttribute = Entegrasyon.Entity.Categories.CategoryAttribute

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3" />
            Yeni Özellik Eşleştirme
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Class="mx-auto my-4" />
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField Value="@_formDto.MarketPlaceId.ToString()"
                              Label="E-ticaret Sitesi ID"
                              ReadOnly="true"
                              Variant="Variant.Outlined"
                              Class="mb-4" />

                <MudAutocomplete T="AppCategoryAttribute"
                                 @bind-Value="_selectedAttribute"
                                 SearchFunc="SearchAttributes"
                                 Label="Özellik Seçin"
                                 Variant="Variant.Outlined"
                                 ToStringFunc="@(x => x?.CategoryAttributeHumanized ?? "")"
                                 Required="true"
                                 RequiredError="Özellik seçilmelidir."
                                 Class="mb-4" />

                <MudTextField @bind-Value="_formDto.MarketPlaceCategoryAttributeId"
                              Label="Marketplace Özellik ID"
                              Placeholder="örn: 5678"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Marketplace Özellik ID gereklidir."
                              InputType="InputType.Number"
                              Class="mb-4" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SubmitForm"
                   Disabled="_isSubmitting || _isLoading">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Kaydediliyor...</span>
            }
            else
            {
                <span>Oluştur</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private Task<IEnumerable<AppCategoryAttribute>> SearchAttributes(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult(_allAttributes.AsEnumerable());

        return Task.FromResult(
            _allAttributes.Where(x =>
                x.CategoryAttributeHumanized.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                x.CategoryAttributeKey.Contains(value, StringComparison.OrdinalIgnoreCase))
                .AsEnumerable());
    }
}
