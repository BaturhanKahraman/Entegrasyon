@page "/marketplace/sync"
@rendermode InteractiveServer

<PageTitle>Pazaryeri Senkronizasyonu</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Pazaryeri Senkronizasyonu</MudText>
<MudText Class="mb-4" Color="Color.Secondary">
    Pazaryerlerinizle ürün ve sipariş senkronizasyonunu yönetin
</MudText>

<MudGrid>
    <!-- Trendyol -->
    <MudItem xs="12" md="6" lg="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MarketplaceLogo Name="Trendyol" Size="Size.Large" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Trendyol</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_trendyolStatus)">
                        @_trendyolStatus
                    </MudChip>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Update">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Son Senkronizasyon:</MudText>
                            <MudText Typo="Typo.body2">@_trendyolLastSync</MudText>
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Inventory">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Senkronize Ürün:</MudText>
                            <MudText Typo="Typo.body2">1,234</MudText>
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.ShoppingBag">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Bekleyen Sipariş:</MudText>
                            <MudText Typo="Typo.body2">15</MudText>
                        </div>
                    </MudListItem>
                </MudList>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="@(() => SyncMarketplace("Trendyol"))"
                           Disabled="@_syncing">
                    Şimdi Senkronize Et
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Settings"
                           OnClick="@(() => ConfigureMarketplace("Trendyol"))">
                    Ayarlar
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- Hepsiburada -->
    <MudItem xs="12" md="6" lg="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MarketplaceLogo Name="Hepsiburada" Size="Size.Large" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Hepsiburada</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">
                        Aktif
                    </MudChip>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Update">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Son Senkronizasyon:</MudText>
                            <MudText Typo="Typo.body2">30 dk önce</MudText>
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Inventory">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Senkronize Ürün:</MudText>
                            <MudText Typo="Typo.body2">856</MudText>
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.ShoppingBag">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Bekleyen Sipariş:</MudText>
                            <MudText Typo="Typo.body2">8</MudText>
                        </div>
                    </MudListItem>
                </MudList>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="@(() => SyncMarketplace("Hepsiburada"))"
                           Disabled="@_syncing">
                    Şimdi Senkronize Et
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Settings"
                           OnClick="@(() => ConfigureMarketplace("Hepsiburada"))">
                    Ayarlar
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- N11 -->
    <MudItem xs="12" md="6" lg="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MarketplaceLogo Name="N11" Size="Size.Large" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">N11</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                        Beklemede
                    </MudChip>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Update">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Son Senkronizasyon:</MudText>
                            <MudText Typo="Typo.body2">2 saat önce</MudText>
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Inventory">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Senkronize Ürün:</MudText>
                            <MudText Typo="Typo.body2">542</MudText>
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.ShoppingBag">
                        <div class="d-flex justify-space-between" style="width: 100%">
                            <MudText Typo="Typo.body2">Bekleyen Sipariş:</MudText>
                            <MudText Typo="Typo.body2">3</MudText>
                        </div>
                    </MudListItem>
                </MudList>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="@(() => SyncMarketplace("N11"))"
                           Disabled="@_syncing">
                    Şimdi Senkronize Et
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Settings"
                           OnClick="@(() => ConfigureMarketplace("N11"))">
                    Ayarlar
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <!-- Sync History -->
    <MudItem xs="12">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Senkronizasyon Geçmişi</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="@_syncHistory" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Pazaryeri</MudTh>
                        <MudTh>İşlem Tipi</MudTh>
                        <MudTh>Durum</MudTh>
                        <MudTh>Ürün Sayısı</MudTh>
                        <MudTh>Başlangıç</MudTh>
                        <MudTh>Bitiş</MudTh>
                        <MudTh>Süre</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Pazaryeri">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MarketplaceLogo Name="@context.Marketplace" Size="Size.Small" />
                                <MudText>@context.Marketplace</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="İşlem Tipi">@context.Type</MudTd>
                        <MudTd DataLabel="Durum">
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Ürün Sayısı">@context.ItemCount</MudTd>
                        <MudTd DataLabel="Başlangıç">@context.StartTime</MudTd>
                        <MudTd DataLabel="Bitiş">@context.EndTime</MudTd>
                        <MudTd DataLabel="Süre">@context.Duration</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

