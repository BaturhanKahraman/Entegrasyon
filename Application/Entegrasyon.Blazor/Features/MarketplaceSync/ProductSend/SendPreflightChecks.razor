@using Entegrasyon.Entity.Dtos.Product
@using Microsoft.AspNetCore.Components

<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-4">Gönderme Ön Kontrolleri</MudText>

    <MudStack Spacing="2">
        @* 1. Kategori Eşleştirmesi *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (Preflight.CategoryMatched)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                <MudText>Kategori eşleştirildi: <strong>@Preflight.MatchedCategoryName</strong></MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Medium" />
                <MudText Color="Color.Error">Kategori henüz eşleştirilmedi</MudText>
                <MudLink Href="/category-marketplace-matches" Target="_blank">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    İlişkilendir
                </MudLink>
            }
        </MudStack>

        @* 2. Marka Eşleştirmesi *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (Preflight.BrandMatched)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                <MudText>Marka eşleştirildi: <strong>@Preflight.MatchedBrandName</strong></MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Medium" />
                <MudText Color="Color.Error">Marka henüz eşleştirilmedi</MudText>
                <MudLink Href="/brand-marketplace-matches" Target="_blank">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    İlişkilendir
                </MudLink>
            }
        </MudStack>

        @* 3. Zorunlu Özellikler *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (Preflight.RequiredAttributesMatched)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                <MudText>Tüm zorunlu özellikler eşleştirildi</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Medium" />
                <MudStack Spacing="0">
                    <MudText Color="Color.Error">Eksik özellik eşleştirmeleri:</MudText>
                    @foreach (var attr in Preflight.MissingAttributes)
                    {
                        <MudText Color="Color.Error" Typo="Typo.body2" Class="ml-4">• @attr</MudText>
                    }
                </MudStack>
                <MudLink Href="/category-attributes" Target="_blank">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                    Eşleştir
                </MudLink>
            }
        </MudStack>

        @* 4. Varyantlar *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (Preflight.HasVariants)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                <MudText>Ürünün varyantları var</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Medium" />
                <MudText Color="Color.Error">Ürünün varyantı yok</MudText>
            }
        </MudStack>

        @* 5. Barkodlar *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (Preflight.AllVariantsHaveBarcodes)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
                <MudText>Tüm varyantların barkodu var</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Medium" />
                <MudText Color="Color.Error">Bazı varyantların barkodu eksik</MudText>
            }
        </MudStack>

        @* Özet *@
        <MudDivider Class="my-2" />
        @if (Preflight.AllPassed)
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">
                ✓ Tüm ön kontroller geçti. Ürün göndermek için hazır.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">
                ✗ Lütfen yukarıdaki kontroller başarılı olana kadar düzeltmeler yapın.
            </MudAlert>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public ProductSendPreflightDto Preflight { get; set; } = null!;
    [Parameter] public EventCallback<bool> OnAllPassed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await OnAllPassed.InvokeAsync(Preflight?.AllPassed ?? false);
    }
}
