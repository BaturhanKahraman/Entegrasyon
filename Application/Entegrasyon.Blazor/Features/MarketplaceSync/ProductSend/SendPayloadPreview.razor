@using Entegrasyon.Entity.Dtos.Product
@using Microsoft.AspNetCore.Components

<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-4">Payload Ön İzlemesi</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Trendyol'a gönderilecek verilerin ön izlemesi aşağıda gösterilmektedir.
    </MudText>

    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
        <MudText>Ön izleme yükleniyor...</MudText>
    }
    else if (Preview is null)
    {
        <MudAlert Severity="Severity.Warning">Ön izleme yüklenemedi.</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            @* Başlık ve Açıklama *@
            <div>
                <MudText Typo="Typo.subtitle2">Başlık</MudText>
                <MudText Class="pl-4">@Preview.Title</MudText>
            </div>

            <div>
                <MudText Typo="Typo.subtitle2">Açıklama</MudText>
                <MudText Class="pl-4">@Preview.Description</MudText>
            </div>

            @* Kategori ve Marka *@
            <MudStack Row="true" Spacing="3">
                <div Style="flex: 1;">
                    <MudText Typo="Typo.subtitle2">Kategori</MudText>
                    <MudText Class="pl-4">@Preview.CategoryName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pl-4">
                        Trendyol: @Preview.TrendyolCategoryName
                    </MudText>
                </div>
                <div Style="flex: 1;">
                    <MudText Typo="Typo.subtitle2">Marka</MudText>
                    <MudText Class="pl-4">@Preview.BrandName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pl-4">
                        Trendyol: @Preview.TrendyolBrandName
                    </MudText>
                </div>
            </MudStack>

            @* Özellikler *@
            @if (Preview.Attributes is not null && Preview.Attributes.Count > 0)
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Özellikler</MudText>
                    <MudSimpleTable Style="overflow-x: auto;">
                        <thead>
                            <tr>
                                <th>Özellik</th>
                                <th>Değer</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attr in Preview.Attributes)
                            {
                                <tr>
                                    <td>@attr.Name</td>
                                    <td>@attr.Value</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }

            @* Varyantlar *@
            @if (Preview.Variants is not null && Preview.Variants.Count > 0)
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Varyantlar</MudText>
                    <MudSimpleTable Style="overflow-x: auto;">
                        <thead>
                            <tr>
                                <th>Barkod</th>
                                <th>Özellikler</th>
                                <th>Liste Fiyatı</th>
                                <th>Satış Fiyatı</th>
                                <th>Stok</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in Preview.Variants)
                            {
                                <tr>
                                    <td>@variant.Barcode</td>
                                    <td>@variant.Attributes</td>
                                    <td>@variant.ListPrice.ToString("C2")</td>
                                    <td>@variant.SalePrice.ToString("C2")</td>
                                    <td>@variant.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }

            @* Özet *@
            <MudDivider />
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-2" />
                Yukarıdaki veriler gönderme sırasında marketplace'e gönderilecektir.
            </MudAlert>
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public TrendyolSendPreviewDto? Preview { get; set; }
    [Parameter] public bool IsLoading { get; set; }
}
