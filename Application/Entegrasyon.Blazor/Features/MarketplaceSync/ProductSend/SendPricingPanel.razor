@using Entegrasyon.Entity.Dtos.Product
@using Entegrasyon.Entity.Dtos.Product.Marketplace
@using Microsoft.AspNetCore.Components

<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-4">Fiyatlandırma Paneli</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Varyantların liste ve satış fiyatlarını özelleştirmek için alanları doldurun. Boş bırakılan alanlar orijinal fiyatı kullanacak.
    </MudText>

    @if (Variants is null || Variants.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">Varyant bulunamadı.</MudAlert>
    }
    else
    {
        <MudTable Items="@Variants" Hover="true" Class="mt-4">
            <HeaderContent>
                <MudTh>Barkod</MudTh>
                <MudTh>Varyant Adı</MudTh>
                <MudTh>Orijinal Liste Fiyatı</MudTh>
                <MudTh>Orijinal Satış Fiyatı</MudTh>
                <MudTh>Liste Fiyatı Geçersiz Kılması</MudTh>
                <MudTh>Satış Fiyatı Geçersiz Kılması</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Barcode</MudTd>
                <MudTd>@context.VariantName</MudTd>
                <MudTd>@context.ListPrice.ToString("C2")</MudTd>
                <MudTd>@context.SalePrice.ToString("C2")</MudTd>
                <MudTd>
                    <MudTextField @bind-Value="_priceOverrides[context.ProductVariantId].ListPriceOverride"
                                  @bind-Value:after="NotifyChanges"
                                  Placeholder="Boş"
                                  InputType="InputType.Number" />
                </MudTd>
                <MudTd>
                    <MudTextField @bind-Value="_priceOverrides[context.ProductVariantId].SalePriceOverride"
                                  @bind-Value:after="NotifyChanges"
                                  Placeholder="Boş"
                                  InputType="InputType.Number" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter] public Guid ProductId { get; set; }
    [Parameter] public int MarketPlaceId { get; set; }
    [Parameter] public List<VariantPricingRowDto>? Variants { get; set; }
    [Parameter] public EventCallback<List<Entegrasyon.Entity.Dtos.Product.Marketplace.VariantPriceOverrideDto>> OnPriceOverridesChanged { get; set; }

    private Dictionary<Guid, Entegrasyon.Entity.Dtos.Product.Marketplace.VariantPriceOverrideDto> _priceOverrides = new();

    protected override void OnInitialized()
    {
        if (Variants is not null)
        {
            foreach (var variant in Variants)
            {
                _priceOverrides[variant.ProductVariantId] = new Entegrasyon.Entity.Dtos.Product.Marketplace.VariantPriceOverrideDto
                {
                    ProductVariantId = variant.ProductVariantId,
                    ListPriceOverride = null,
                    SalePriceOverride = null
                };
            }
        }
    }

    private async Task NotifyChanges()
    {
        var overrideList = _priceOverrides.Values.ToList();
        await OnPriceOverridesChanged.InvokeAsync(overrideList);
    }
}
