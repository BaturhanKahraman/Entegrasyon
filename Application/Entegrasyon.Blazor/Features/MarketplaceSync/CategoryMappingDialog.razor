@using Entegrasyon.Entity.Categories
@using Entegrasyon.Entity.Dtos.Category

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3" />
            Yeni Kategori Eşleştirme
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Class="mx-auto my-4" />
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField Value="@_formDto.MarketPlaceId.ToString()"
                              Label="E-ticaret Sitesi ID"
                              ReadOnly="true"
                              Variant="Variant.Outlined"
                              Class="mb-4" />

                <MudAutocomplete T="Category"
                                 @bind-Value="_selectedCategory"
                                 SearchFunc="SearchCategories"
                                 Label="Kategori Seçin"
                                 Variant="Variant.Outlined"
                                 ToStringFunc="@(x => x?.Name ?? "")"
                                 Required="true"
                                 RequiredError="Kategori seçilmelidir."
                                 Class="mb-4" />

                <MudTextField @bind-Value="_formDto.MarketPlaceCategoryId"
                              Label="Marketplace Kategori ID"
                              Placeholder="örn: 1234"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Marketplace Kategori ID gereklidir."
                              InputType="InputType.Number"
                              Class="mb-4" />

                <MudTextField @bind-Value="_formDto.MarketPlaceCategoryName"
                              Label="Marketplace Kategori Adı"
                              Placeholder="örn: Elektronik > Bilgisayar"
                              Variant="Variant.Outlined"
                              Class="mb-4" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SubmitForm"
                   Disabled="_isSubmitting || _isLoading">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Kaydediliyor...</span>
            }
            else
            {
                <span>Oluştur</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private Task<IEnumerable<Category>> SearchCategories(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult(_allCategories.AsEnumerable());

        return Task.FromResult(
            _allCategories.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
                .AsEnumerable());
    }
}
