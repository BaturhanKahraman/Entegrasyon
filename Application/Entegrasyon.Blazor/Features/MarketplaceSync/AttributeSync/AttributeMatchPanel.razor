@using Entegrasyon.Entity.Dtos.Marketplace
@using Entegrasyon.Entity.Matches

<MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
    @if (SelectedAttribute is null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            Sol panelden eşleştirmek istediğiniz özelliği seçin.
        </MudAlert>
    }
    else if (SelectedAttribute.IsMatched)
    {
        <MudAlert Severity="Severity.Success">
            <MudText Typo="Typo.body2">
                <b>@SelectedAttribute.AttributeName</b> → <b>@(SelectedAttribute.MatchedMarketplaceName ?? "?")</b>
            </MudText>
            <MudText Typo="Typo.caption">Bu özellik zaten eşleştirilmiş.</MudText>
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle2">
                <b>@SelectedAttribute.AttributeName</b> için eşleştirme seçin
            </MudText>

            @if (Suggestions.Any(s => s.ApplicationAttributeId == SelectedAttribute.AttributeId))
            {
                <MudPaper Elevation="0" Class="pa-3 mud-background-gray rounded">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Otomatik Öneriler</MudText>
                    <MudStack Spacing="2">
                        @foreach (var suggestion in Suggestions.Where(s => s.ApplicationAttributeId == SelectedAttribute.AttributeId))
                        {
                            var isAlreadyUsed = IsMarketplaceAttrUsedByOther(suggestion.SuggestedMarketplaceAttributeId, SelectedAttribute.AttributeId);
                            <MudPaper Elevation="1" Class="pa-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudStack Spacing="0" Style="flex: 1;">
                                        <MudText Typo="Typo.body2">@suggestion.SuggestedMarketplaceAttributeName</MudText>
                                        <MudProgressLinear Value="@((int)(suggestion.Confidence * 100))"
                                                           Color="@GetConfidenceColor(suggestion.Confidence)"
                                                           Rounded="true"
                                                           Size="Size.Small"
                                                           Class="mt-1" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Güven: %@((int)(suggestion.Confidence * 100))
                                        </MudText>
                                    </MudStack>
                                    @if (!isAlreadyUsed)
                                    {
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => SelectSuggestion(suggestion.SuggestedMarketplaceAttributeId))">
                                            Seç
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Kullanılıyor</MudChip>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudPaper>
            }

            <MudTextField @bind-Value="_searchText"
                          Label="Pazar Yeri Özelliği Ara"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" />

            <MudList T="MarketplaceAttributeDto" Dense="true" Style="max-height: 400px; overflow-y: auto;">
                @foreach (var mpAttr in FilteredMarketplaceAttributes)
                {
                    var isUsedByOther = IsMarketplaceAttrUsedByOther(mpAttr.Id, SelectedAttribute.AttributeId);
                    var isSelected = _selectedMpAttributeId == mpAttr.Id;
                    <MudListItem T="MarketplaceAttributeDto"
                                 Value="mpAttr"
                                 Dense="true"
                                 Disabled="isUsedByOther"
                                 Class="@(isSelected ? "mud-theme-primary" : "")"
                                 OnClick="@(() => { if (!isUsedByOther) _selectedMpAttributeId = mpAttr.Id; })">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Style="flex: 1;">@mpAttr.Name</MudText>
                            @if (mpAttr.IsRequired)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">Zorunlu</MudChip>
                            }
                            @if (isUsedByOther)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Kullanılıyor</MudChip>
                            }
                        </MudStack>
                    </MudListItem>
                }
            </MudList>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(_selectedMpAttributeId is null)"
                       StartIcon="@Icons.Material.Filled.Link"
                       FullWidth="true"
                       OnClick="ConfirmMatch">
                Eşleştir
            </MudButton>
        </MudStack>
    }
</MudPaper>
