@page "/marketplace/sync/attributes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Marketplace.View)]
@using Entegrasyon.Entity.Categories

<PageTitle>Özellik Eşleştirme - Entegrasyon</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <MudText Typo="Typo.h5" Class="mb-4">Özellik Eşleştirme</MudText>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6">
            <MudSelect T="int?"
                       Label="Pazar Yeri"
                       Value="_selectedMarketplaceId"
                       ValueChanged="OnMarketplaceChanged"
                       Variant="Variant.Outlined"
                       Dense="true">
                <MudSelectItem T="int?" Value="null">-- Seçiniz --</MudSelectItem>
                @foreach (var mp in _marketplaces)
                {
                    <MudSelectItem T="int?" Value="mp.Id">@mp.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="int?"
                       Label="Kategori"
                       Value="_selectedCategoryId"
                       ValueChanged="OnCategoryChanged"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Disabled="@(_selectedMarketplaceId is null)">
                <MudSelectItem T="int?" Value="null">-- Kategori Seçiniz --</MudSelectItem>
                @foreach (var cat in _matchedCategories)
                {
                    <MudSelectItem T="int?" Value="cat.CategoryId">@cat.Category?.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_selectedMarketplaceId is null)
    {
        <MudAlert Severity="Severity.Info">Lütfen önce bir pazar yeri seçin.</MudAlert>
    }
    else if (_selectedCategoryId is null)
    {
        <MudAlert Severity="Severity.Info">Özellik eşleştirmesi yapmak için bir kategori seçin.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" md="5">
                <AttributeListPanel
                    Attributes="_attributeListItems"
                    SelectedAttributeId="_selectedAppAttributeId"
                    SelectedAttributeIdChanged="OnAttributeSelected"
                    OnRemoveMatch="OnRemoveMatch"
                    MarketPlaceId="_selectedMarketplaceId!.Value"
                    ExistingValueMatches="_existingValueMatches"
                    OnValueMatchChanged="OnValueMatchChanged"
                    MarketplaceAttributes="_marketplaceAttributes" />
            </MudItem>
            <MudItem xs="12" md="7">
                <AttributeMatchPanel
                    SelectedAttribute="_selectedAttributeInfo"
                    MarketplaceAttributes="_marketplaceAttributes"
                    Suggestions="_suggestions"
                    AllExistingMatches="_existingAttrMatches"
                    OnMatchConfirmed="OnMatchConfirmed" />
            </MudItem>
        </MudGrid>
    }
</MudContainer>
