@page "/marketplace/sync/attributes"
@rendermode InteractiveServer
@using Entegrasyon.Entity.Categories
@using AppCategoryAttribute = Entegrasyon.Entity.Categories.CategoryAttribute

<PageTitle>Özellik Senkronizasyonu - Entegrasyon</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Ozellik Eslestirme</MudText>
        @if (FilterCategoryId.HasValue)
        {
            <MudChip T="string" Color="Color.Info" OnClose="ClearCategoryFilter">
                Kategori filtresi: @_filterCategoryName
            </MudChip>
        }
    </MudStack>

    <MudGrid Spacing="2" Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2">Toplam Özellik</MudText>
                <MudText Typo="Typo.h5" Class="mt-2">@_attributes.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Color="Color.Success">Eşleştirilmiş</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success" Class="mt-2">@_matchedCount</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Color="Color.Warning">Eşleştirilmemiş</MudText>
                <MudText Typo="Typo.h5" Color="Color.Warning" Class="mt-2">@(_attributes.Count - _matchedCount)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudSwitch @bind-Value="_showUnmappedOnly" Label="Sadece eşleşmesi olmayanlar" Color="Color.Primary" Class="mb-4" />

            <MudDataGrid T="AttributeSyncRow" Items="FilteredRows" Dense="true" Hover="true" Striped="true"
                         FixedHeader="true" Height="500px">
                <Columns>
                    <PropertyColumn Property="x => x.Humanized" Title="Özellik Adı" />
                    <PropertyColumn Property="x => x.Key" Title="Anahtar" />
                    <PropertyColumn Property="x => x.ValueCount" Title="Değer Sayısı" />
                    <TemplateColumn Title="Eşleşme Durumu">
                        <CellTemplate>
                            @if (context.Item.HasMatch)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Eşleştirilmiş</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Eşleşme yok</MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Marketplace">
                        <CellTemplate>
                            @if (context.Item.MarketplaceName is not null)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MarketplaceLogo Name="@context.Item.MarketplaceName" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@context.Item.MarketplaceName (ID: @context.Item.MarketplaceAttributeId)</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="İşlemler">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Link"
                                           OnClick="@(() => OpenRowMappingDialog(context.Item))">
                                    Eşleştir
                                </MudButton>
                                @if (context.Item.HasMatch)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteMapping(context.Item))" />
                                }
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="AttributeSyncRow" />
                </PagerContent>
            </MudDataGrid>
        </MudPaper>
    }
</MudContainer>
