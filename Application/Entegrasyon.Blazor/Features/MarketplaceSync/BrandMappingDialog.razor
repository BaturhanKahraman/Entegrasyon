@using Entegrasyon.Entity.Dtos.Brand
@using MudBlazor
@using Entegrasyon.Business.Abstract

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3" />
            Yeni Marka Eşleştirme
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (IsLoading)
        {
            <MudProgressCircular Indeterminate="true" Class="mx-auto my-4" />
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField
                    Value="@FormDto.MarketPlaceId.ToString()"
                    Label="E-ticaret Sitesi ID"
                    ReadOnly="true"
                    Variant="Variant.Outlined"
                    Class="mb-4"
                />

                <MudAutocomplete
                    T="BrandDto"
                    @bind-Value="SelectedBrand"
                    SearchFunc="SearchBrands"
                    Label="Brand Adı Seçin"
                    Variant="Variant.Outlined"
                    ToStringFunc="@(x => x?.Name ?? "")"
                    Required="true"
                    RequiredError="Brand seçilmelidir."
                    Class="mb-4"
                />

                <MudTextField
                    @bind-Value="FormDto.MarketPlaceBrandId"
                    Label="Trendyol Brand ID"
                    Placeholder="örn: 1234567"
                    Variant="Variant.Outlined"
                    Required="true"
                    RequiredError="Trendyol Brand ID gereklidir."
                    InputType="InputType.Number"
                    Class="mb-4"
                />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton
            Variant="Variant.Filled"
            Color="Color.Primary"
            OnClick="SubmitForm"
            Disabled="IsSubmitting || IsLoading">
            @if (IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Kaydediliyor...</span>
            }
            else
            {
                <span>Oluştur</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private Task<IEnumerable<BrandDto>> SearchBrands(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult(AllBrands.AsEnumerable());

        return Task.FromResult(
            AllBrands.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase))
                .AsEnumerable());
    }
}
