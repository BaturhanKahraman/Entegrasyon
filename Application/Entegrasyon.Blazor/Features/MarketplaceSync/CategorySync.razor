@page "/marketplace/sync/categories"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Marketplace.View)]
@using Entegrasyon.Entity.Categories

<PageTitle>Kategori Senkronizasyonu - Entegrasyon</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Kategori Eşleştirme</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="OpenSaveTemplateDialog">
                Template Kaydet
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="OpenApplyTemplateDialog">
                Template Uygula
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                       Href="/marketplace/sync/categories/bulk">
                Toplu Eslestirme
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="/categories/import">
                Trendyol'dan Ice Aktar
            </MudButton>
        </MudStack>
    </MudStack>

    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2">Toplam Kategori</MudText>
                <MudText Typo="Typo.h5" Class="mt-2">@_summary.TotalCategories</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Color="Color.Success">Eslestirilmis</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success" Class="mt-2">@_summary.MappedCategories</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Color="Color.Warning">Eslestirilmemis</MudText>
                <MudText Typo="Typo.h5" Color="Color.Warning" Class="mt-2">@_summary.UnmappedCategories</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_summary.PerMarketplace.Count > 0)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Marketplace Bazli Ozet</MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                @foreach (var mp in _summary.PerMarketplace)
                {
                    <MudChip T="string"
                             Size="Size.Medium"
                             Color="@(mp.MappedCount > 0 ? Color.Success : Color.Default)"
                             Variant="Variant.Outlined">
                        @mp.MarketPlaceName: @mp.MappedCount eslestirme
                    </MudChip>
                }
            </MudStack>
        </MudPaper>
    }

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Spacing="2" Class="mb-4">
                <MudSwitch @bind-Value="_showUnmappedOnly" Label="Sadece eşleşmesi olmayanlar" Color="Color.Primary" />
                <MudSwitch @bind-Value="_showLeafOnly" Label="Sadece alt kategoriler (leaf)" Color="Color.Primary" />
            </MudStack>

            <MudDataGrid T="Category" Items="FilteredCategories" Dense="true" Hover="true" Striped="true"
                         FixedHeader="true" Height="500px">
                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="Kategori Adı" />
                    <TemplateColumn Title="Üst Kategori">
                        <CellTemplate>
                            <MudText Typo="Typo.body2">
                                @(GetParentName(context.Item))
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Tip">
                        <CellTemplate>
                            @if (IsLeaf(context.Item))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">Leaf</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Parent</MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Eşleşme Durumu">
                        <CellTemplate>
                            @if (context.Item.MarketplaceLinks?.Any() == true)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                    @context.Item.MarketplaceLinks.Count eşleşme
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Eşleşme yok</MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Marketplace Detayları">
                        <CellTemplate>
                            @if (context.Item.MarketplaceLinks?.Any(l => l.IsActive) == true)
                            {
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    @foreach (var link in context.Item.MarketplaceLinks.Where(l => l.IsActive))
                                    {
                                        <MudTooltip Text="@($"{link.MarketPlaceCategoryName} (ID: {link.ExternalCategoryId}) — Kaldırmak için X'e tıklayın")">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                                     OnClose="@(() => DeleteMappingForMarketplace(context.Item, link.MarketPlaceId))">
                                                <MarketplaceLogo Name="@(link.MarketPlace?.Name ?? "")" Size="Size.Small" Class="mr-1" />
                                                @(link.MarketPlace?.Name ?? "MP#" + link.MarketPlaceId)
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        (@context.Item.MarketplaceLinks.Count(l => l.IsActive) eşleşme)
                                    </MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                                    Eşleştirilmemiş
                                </MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Doğrulama">
                        <CellTemplate>
                            @if (context.Item.MarketplaceLinks?.Any() == true)
                            {
                                @if (GetValidationStatus(context.Item.Id) is { } status)
                                {
                                    @if (status.IsValid)
                                    {
                                        <MudTooltip Text="Tüm eşleştirmeler tamam">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                    else if (status.Errors.Count > 0)
                                    {
                                        <MudTooltip Text="@string.Join(", ", status.Errors)">
                                            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                    else if (status.Warnings.Count > 0)
                                    {
                                        <MudTooltip Text="@string.Join(", ", status.Warnings)">
                                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                }
                                else
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="İşlemler">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1">
                                @* Yeni eşleştirme ekle — her zaman görünür *@
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="@(() => OpenRowMappingDialog(context.Item))">
                                    Eşleştir
                                </MudButton>

                                @if (context.Item.MarketplaceLinks?.Any(l => l.IsActive) == true)
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Tune"
                                               OnClick="@(() => NavigateToAttributeMatch(context.Item.Id, context.Item.MarketplaceLinks.First(l => l.IsActive).MarketPlaceId))">
                                        Attribute Eşleştir
                                    </MudButton>
                                }
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="Category" />
                </PagerContent>
            </MudDataGrid>
        </MudPaper>
    }
</MudContainer>
