@page "/branch-offices/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.BranchOffices.View)]
@using Entegrasyon.Entity.Dtos.Branches
@using Entegrasyon.Entity.Products
@using Entegrasyon.Entity

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_branch is null)
{
    <MudAlert Severity="Severity.Error">Depo bulunamadı.</MudAlert>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-4">@_branch.Name</MudText>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

        <!-- Tab 1: Genel Bilgiler -->
        <MudTabPanel Text="Genel Bilgiler" Icon="@Icons.Material.Filled.Info">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editName"
                                  Label="Depo Adı"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="_editIsDefault"
                               Label="Varsayılan Pazaryeri Deposu"
                               Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <strong>Oluşturma Tarihi:</strong> @_branch.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <strong>Kullanıcı Sayısı:</strong> @_branch.Users.Count()
                    </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveGeneralAsync"
                               Disabled="_saving">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        Kaydet
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- Tab 2: Stok Durumu -->
        <MudTabPanel Text="Stok Durumu" Icon="@Icons.Material.Filled.Inventory">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudSwitch @bind-Value="_showOnlyWithStock" Label="Sadece Stokluları Göster" Color="Color.Primary" />
                <MudSpacer />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.SwapHoriz"
                           Disabled="@(!_selectedStockItems.Any())"
                           OnClick="OpenTransferDialog">
                    Seçilenleri Transfer Et
                </MudButton>
            </MudStack>
            <MudDataGrid T="BranchStockItemDto"
                         Items="@FilteredStocks"
                         MultiSelection="true"
                         @bind-SelectedItems="_selectedStockItems"
                         Hover="true" Striped="true">
                <Columns>
                    <SelectColumn T="BranchStockItemDto" />
                    <PropertyColumn Property="x => x.ProductName" Title="Ürün Adı" />
                    <PropertyColumn Property="x => x.Barcode" Title="Barkod" />
                    <PropertyColumn Property="x => x.FirstTotalStock" Title="İlk Stok" />
                    <PropertyColumn Property="x => x.SoldQuantity" Title="Satılan" />
                    <PropertyColumn Property="x => x.CurrentStock" Title="Mevcut Stok" />
                </Columns>
                <NoRecordsContent>
                    <MudText Class="my-4">Stok kaydı bulunamadı.</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Tab 3: Stok Hareketleri -->
        <MudTabPanel Text="Stok Hareketleri" Icon="@Icons.Material.Filled.Timeline">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudDateRangePicker @bind-DateRange="_movementDateRange"
                                    Label="Tarih Aralığı"
                                    Class="mr-4" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="LoadMovementsAsync">
                    Filtrele
                </MudButton>
            </MudStack>
            <MudDataGrid T="StockMovementViewDto"
                         Items="@_stockMovements.AsEnumerable()"
                         Hover="true" Striped="true">
                <Columns>
                    <PropertyColumn Property="x => x.MovedAt" Title="Tarih" Format="dd.MM.yyyy HH:mm" />
                    <PropertyColumn Property="x => x.ProductName" Title="Ürün" />
                    <PropertyColumn Property="x => x.Barcode" Title="Barkod" />
                    <TemplateColumn Title="Hareket Tipi">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="@GetMovementColor(context.Item.MovementType)">
                                @GetMovementLabel(context.Item.MovementType)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Miktar">
                        <CellTemplate>
                            <MudText Color="@(context.Item.Quantity >= 0 ? Color.Success : Color.Error)">
                                @(context.Item.Quantity >= 0 ? "+" : "")@context.Item.Quantity
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Önceki → Sonraki">
                        <CellTemplate>
                            @context.Item.StockBefore → @context.Item.StockAfter
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.ReferenceType" Title="Referans" />
                </Columns>
                <NoRecordsContent>
                    <MudText Class="my-4">Stok hareketi bulunamadı.</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Tab 4: Marketplace Bağlantıları -->
        <MudTabPanel Text="Marketplace" Icon="@Icons.Material.Filled.Store">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                <MudSelect T="int" @bind-Value="_selectedMarketPlaceId" Label="Pazaryeri Ekle">
                    @foreach (var mp in _availableMarketPlaces)
                    {
                        <MudSelectItem Value="@mp.Id">@mp.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddMarketPlaceAsync"
                           Disabled="@(_selectedMarketPlaceId <= 0)">
                    Ekle
                </MudButton>
            </MudStack>

            @foreach (var warehouse in _marketPlaceWarehouses)
            {
                <MudCard Class="mb-2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Store" Class="mr-2" />
                            <MudText>@warehouse.MarketPlace.Name</MudText>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveMarketPlaceAsync(warehouse.Id))" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }

            @if (!_marketPlaceWarehouses.Any())
            {
                <MudText Class="my-4">Bu depoya bağlı pazaryeri bulunmuyor.</MudText>
            }
        </MudTabPanel>

        <!-- Tab 5: Kullanıcılar -->
        <MudTabPanel Text="Kullanıcılar" Icon="@Icons.Material.Filled.People">
            <MudDataGrid T="Entegrasyon.Entity.User.ApplicationUser"
                         Items="@_branch.Users.AsEnumerable()"
                         Hover="true" Striped="true">
                <Columns>
                    <PropertyColumn Property="x => x.FullName" Title="Ad Soyad" />
                    <PropertyColumn Property="x => x.Email" Title="E-posta" />
                </Columns>
                <NoRecordsContent>
                    <MudText Class="my-4">Bu depoya atanmış kullanıcı bulunmuyor.</MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </MudTabPanel>

    </MudTabs>
}
