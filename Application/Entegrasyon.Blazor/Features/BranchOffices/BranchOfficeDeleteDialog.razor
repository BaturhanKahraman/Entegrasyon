@using Entegrasyon.Entity.Dtos.Branches

<MudDialog>
    <DialogContent>
        @if (_step == 1)
        {
            <!-- Adım 1: Etki Özeti -->
            <MudText Typo="Typo.h6" Class="mb-3">Etki Özeti</MudText>
            <MudText>
                <strong>@BranchName</strong> deposunu silmek üzeresiniz.
            </MudText>
            @if (_loadingImpact)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
            }
            else
            {
                <MudList T="string" Dense="true" Class="mt-2">
                    <MudListItem Icon="@Icons.Material.Filled.Inventory">
                        @_stockCount ürün, @_totalStock toplam stok
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Store">
                        @_marketPlaceCount bağlı pazaryeri
                    </MudListItem>
                </MudList>
            }
        }
        else if (_step == 2)
        {
            <!-- Adım 2: Seçenek -->
            <MudText Typo="Typo.h6" Class="mb-3">Stok Yönetimi</MudText>
            <MudRadioGroup @bind-Value="_stockOption" T="string">
                <MudRadio Value="@("transfer")" Color="Color.Primary">
                    Stoğu başka bir depoya transfer et
                </MudRadio>
                @if (_stockOption == "transfer")
                {
                    <MudSelect T="int" @bind-Value="_targetBranchId"
                               Label="Hedef Depo"
                               Class="ml-6 mt-1">
                        @foreach (var branch in _otherBranches)
                        {
                            <MudSelectItem Value="@branch.Id">@branch.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudRadio Value="@("zero")" Color="Color.Warning">
                    Tüm stoğu sıfırla (audit kaydı oluşturulur)
                </MudRadio>
                <MudRadio Value="@("cancel")" Color="Color.Default">
                    İptal — silme işlemini vazgeç
                </MudRadio>
            </MudRadioGroup>
        }
        else if (_step == 3)
        {
            <!-- Adım 3: Onay -->
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Bu işlem <strong>geri alınamaz</strong>.
            </MudAlert>
            <MudText>
                <strong>@BranchName</strong> deposunu silmek istediğinizden emin misiniz?
            </MudText>
            @if (_stockOption == "transfer" && _targetBranchId > 0)
            {
                <MudText Class="mt-2">
                    Stoklar <strong>@(_otherBranches.FirstOrDefault(b => b.Id == _targetBranchId)?.Name)</strong> deposuna transfer edilecek.
                </MudText>
            }
            else if (_stockOption == "zero")
            {
                <MudText Class="mt-2">Tüm stoklar sıfırlanacak.</MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_step == 1)
        {
            <MudButton OnClick="Cancel">İptal</MudButton>
            @if (_totalStock > 0)
            {
                <MudButton Color="Color.Warning"
                           Variant="Variant.Filled"
                           OnClick="@(() => _step = 2)"
                           Disabled="_loadingImpact">
                    Devam
                </MudButton>
            }
            else
            {
                <MudButton Color="Color.Error"
                           Variant="Variant.Filled"
                           OnClick="@(() => _step = 3)"
                           Disabled="_loadingImpact">
                    Devam
                </MudButton>
            }
        }
        else if (_step == 2)
        {
            <MudButton OnClick="@(() => _step = 1)">Geri</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="HandleStepTwoAsync">
                Devam
            </MudButton>
        }
        else if (_step == 3)
        {
            <MudButton OnClick="@(() => _step = _totalStock > 0 ? 2 : 1)">Geri</MudButton>
            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       OnClick="ConfirmDeleteAsync"
                       Disabled="_deleting">
                @if (_deleting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Sil
            </MudButton>
        }
    </DialogActions>
</MudDialog>
