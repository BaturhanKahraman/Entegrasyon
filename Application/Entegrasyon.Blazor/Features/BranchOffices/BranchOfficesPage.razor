@page "/branch-offices"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.BranchOffices.View)]
@using Entegrasyon.Entity.Dtos.Branches

<MudText Typo="Typo.h5" Class="mb-4">Depolar</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

<MudDataGrid T="BranchOfficePageListDto" Items="@_branches.AsEnumerable()" SortMode="SortMode.Multiple"
             QuickFilter="@QuickFilter" Hover="true" Striped="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Depo Listesi</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchTerm"
                      Placeholder="Depo ara..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0 mr-4"
                      Clearable="true" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog">
            Yeni Depo Ekle
        </MudButton>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Depo Adı" Sortable="true" />
        <PropertyColumn Property="x => x.UserCount" Title="Kullanıcı Sayısı" Sortable="true" />
        <PropertyColumn Property="x => x.TotalStock" Title="Toplam Stok" Sortable="true" />
        <TemplateColumn Title="Bağlı Pazaryerleri" Sortable="false">
            <CellTemplate>
                @foreach (var mp in context.Item.MarketPlaceNames)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mr-1">@mp</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CreatedAt" Title="Oluşturma Tarihi" Format="dd.MM.yyyy" Sortable="true" />
        <TemplateColumn Title="İşlemler" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => OpenEditDialog(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                               Color="Color.Default"
                               Size="Size.Small"
                               OnClick="@(() => NavigateToDetail(context.Item.Id))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => OpenDeleteDialog(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="BranchOfficePageListDto" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Class="my-4">Henüz depo eklenmedi.</MudText>
    </NoRecordsContent>
</MudDataGrid>
