@using Entegrasyon.Entity.Shipping

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
            Kargo Detayi - @Shipment?.TrackingNumber
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (Shipment is not null)
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Kargo Sirketi</MudText>
                    <MudText Typo="Typo.body1">@Shipment.CargoCompanyName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Durum</MudText>
                    <MudChip T="string" Color="@GetStatusColor(Shipment.CurrentStatus)" Size="Size.Small">
                        @GetStatusText(Shipment.CurrentStatus)
                    </MudChip>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Alici</MudText>
                    <MudText Typo="Typo.body1">@(Shipment.RecipientName ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Teslim Tarihi</MudText>
                    <MudText Typo="Typo.body1">@(Shipment.ActualDeliveryDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</MudText>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-3">Hareket Gecmisi</MudText>

            @if (_isRefreshing)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
            }

            @if (Shipment.StatusHistories.Count > 0)
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start">
                    @foreach (var history in Shipment.StatusHistories.OrderByDescending(h => h.Timestamp))
                    {
                        <MudTimelineItem Color="@GetStatusColor(history.Status)" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.subtitle2">@GetStatusText(history.Status)</MudText>
                                <MudText Typo="Typo.body2">@history.Description</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">
                                    @history.Timestamp.ToString("dd.MM.yyyy HH:mm") - @history.Location
                                </MudText>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Default">Henuz hareket bilgisi yok.</MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnRefreshClicked" Variant="Variant.Outlined" Color="Color.Primary"
                   Disabled="_isRefreshing" StartIcon="@Icons.Material.Filled.Refresh">
            Durumu Guncelle
        </MudButton>
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Default">Kapat</MudButton>
    </DialogActions>
</MudDialog>
