<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
            Yeni Kargo Takibi
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudSelect T="int" Label="Kargo Sirketi" @bind-Value="_selectedCargoCompanyId"
                       Required="true" RequiredError="Kargo sirketi secilmelidir"
                       Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="int" Value="18">Aras Kargo</MudSelectItem>
                <MudSelectItem T="int" Value="13">Surat Kargo</MudSelectItem>
                <MudSelectItem T="int" Value="17">Yurtici Kargo</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_trackingNumber" Label="Takip Numarasi"
                          Required="true" RequiredError="Takip numarasi girilmelidir"
                          Variant="Variant.Outlined" />
        </MudForm>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Vazgec</MudButton>
        <MudButton OnClick="OnSubmit" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Takip Et
        </MudButton>
    </DialogActions>
</MudDialog>
