@page "/categories/import"
<PageTitle>Kategori İçe Aktar</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Kategori İçe Aktar</MudText>
<MudText Class="mb-4" Color="Color.Secondary">
    Pazaryerlerinden kategorileri içe aktararak ürün kategorilerinizi oluşturun
</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
    <MudTabPanel Text="Trendyol" Icon="@Icons.Material.Filled.Store">
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Trendyol Kategorileri</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadTrendyolCategoriesAsync"
                               Disabled="@loading">
                        @if (loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kategorileri Yükle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ShowImportConfirmationAsync"
                               Disabled="@(importing || selectedNodes == null || !selectedNodes.Any())">
                        @if (importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Seçilenleri İçe Aktar (@(selectedNodes?.Count ?? 0))
                    </MudButton>
                </div>
            </div>

            @if (loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudText Align="Align.Center" Color="Color.Secondary">Kategoriler yükleniyor...</MudText>
            }
            else if (!categories.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Kategorileri görüntülemek için "Kategorileri Yükle" butonuna tıklayın.
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <TrendyolCategoryTreeView Categories="@categories"
                                                  @bind-SelectedNodes="selectedNodes"
                                                  @bind-SearchQuery="searchQuery"
                                                  Loading="@loading" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <SelectedCategoriesPanel SelectedCategories="@selectedNodes"
                                                 OnRemove="@RemoveSelectedCategory"
                                                 OnClearAll="@ClearSelection" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Hepsiburada" Icon="@Icons.Material.Filled.ShoppingCart" Disabled="true">
        <MudPaper Class="pa-4">
            <MudAlert Severity="Severity.Info">
                Hepsiburada entegrasyonu yakında eklenecek.
            </MudAlert>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="N11" Icon="@Icons.Material.Filled.Storefront" Disabled="true">
        <MudPaper Class="pa-4">
            <MudAlert Severity="Severity.Info">
                N11 entegrasyonu yakında eklenecek.
            </MudAlert>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@if (importing)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999">
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
                <MudText Typo="Typo.h6" Align="Align.Center">Kategori içe aktarma işlemi başlatılıyor...</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    İşlem arka planda devam edecek. Tamamlandığında bildirim alacaksınız.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudOverlay>
}
