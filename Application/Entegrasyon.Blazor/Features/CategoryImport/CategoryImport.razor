@page "/categories/import"
<PageTitle>Kategori İçe Aktar</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Kategori İçe Aktar</MudText>
<MudText Class="mb-4" Color="Color.Secondary">
    Pazaryerlerinden kategorileri içe aktararak ürün kategorilerinizi oluşturun
</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
    <MudTabPanel>
        <TabContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MarketplaceLogo Name="Trendyol" Size="Size.Small" />
                <MudText>Trendyol</MudText>
            </MudStack>
        </TabContent>
        <ChildContent>
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Trendyol Kategorileri</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadTrendyolCategoriesAsync"
                               Disabled="@loading">
                        @if (loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kategorileri Yükle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ShowImportConfirmationAsync"
                               Disabled="@(importing || selectedNodes == null || !selectedNodes.Any())">
                        @if (importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Seçilenleri İçe Aktar (@(selectedNodes?.Count ?? 0))
                    </MudButton>
                </div>
            </div>

            @if (loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudText Align="Align.Center" Color="Color.Secondary">Kategoriler yükleniyor...</MudText>
            }
            else if (!categories.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Kategorileri görüntülemek için "Kategorileri Yükle" butonuna tıklayın.
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <TrendyolCategoryTreeView Categories="@categories"
                                                  @bind-SelectedNodes="selectedNodes"
                                                  @bind-SearchQuery="searchQuery"
                                                  Loading="@loading" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <SelectedCategoriesPanel SelectedCategories="@selectedNodes"
                                                 OnRemove="@RemoveSelectedCategory"
                                                 OnClearAll="@ClearSelection" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
        </ChildContent>
    </MudTabPanel>

    <MudTabPanel>
        <TabContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MarketplaceLogo Name="Hepsiburada" Size="Size.Small" />
                <MudText>Hepsiburada</MudText>
            </MudStack>
        </TabContent>
        <ChildContent>
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Hepsiburada Kategorileri</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadHepsiburadaCategoriesAsync"
                               Disabled="@hbLoading">
                        @if (hbLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kategorileri Yükle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ImportHepsiburadaCategoriesAsync"
                               Disabled="@(importing || hbSelectedNodes == null || !hbSelectedNodes.Any())">
                        @if (importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Seçilenleri İçe Aktar (@(hbSelectedNodes?.Count ?? 0))
                    </MudButton>
                </div>
            </div>

            @if (hbLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudText Align="Align.Center" Color="Color.Secondary">Kategoriler yükleniyor...</MudText>
            }
            else if (!hbCategories.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Kategorileri görüntülemek için "Kategorileri Yükle" butonuna tıklayın.
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <HepsiburadaCategoryListView Categories="@hbCategories"
                                                     @bind-SelectedNodes="hbSelectedNodes" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <SelectedCategoriesPanel SelectedCategories="@hbSelectedNodes"
                                                 OnRemove="@RemoveHbSelectedCategory"
                                                 OnClearAll="@ClearHbSelection" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
        </ChildContent>
    </MudTabPanel>

    <MudTabPanel>
        <TabContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MarketplaceLogo Name="N11" Size="Size.Small" />
                <MudText>N11</MudText>
            </MudStack>
        </TabContent>
        <ChildContent>
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">N11 Kategorileri</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadN11CategoriesAsync"
                               Disabled="@n11Loading">
                        @if (n11Loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kategorileri Yükle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ImportN11CategoriesAsync"
                               Disabled="@(importing || n11SelectedNodes == null || !n11SelectedNodes.Any())">
                        @if (importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Seçilenleri İçe Aktar (@(n11SelectedNodes?.Count ?? 0))
                    </MudButton>
                </div>
            </div>

            @if (n11Loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudText Align="Align.Center" Color="Color.Secondary">Kategoriler yükleniyor...</MudText>
            }
            else if (!n11Categories.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Kategorileri görüntülemek için "Kategorileri Yükle" butonuna tıklayın.
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <N11CategoryTreeView Categories="@n11Categories"
                                             @bind-SelectedNodes="n11SelectedNodes" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <SelectedCategoriesPanel SelectedCategories="@n11SelectedNodes"
                                                 OnRemove="@RemoveN11SelectedCategory"
                                                 OnClearAll="@ClearN11Selection" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
        </ChildContent>
    </MudTabPanel>

    <MudTabPanel>
        <TabContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MarketplaceLogo Name="Pazarama" Size="Size.Small" />
                <MudText>Pazarama</MudText>
            </MudStack>
        </TabContent>
        <ChildContent>
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Pazarama Kategorileri</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadPazaramaCategoriesAsync"
                               Disabled="@pazaramaLoading">
                        @if (pazaramaLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kategorileri Yükle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ImportPazaramaCategoriesAsync"
                               Disabled="@(importing || pazaramaSelectedNodes == null || !pazaramaSelectedNodes.Any())">
                        @if (importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Seçilenleri İçe Aktar (@(pazaramaSelectedNodes?.Count ?? 0))
                    </MudButton>
                </div>
            </div>

            @if (pazaramaLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudText Align="Align.Center" Color="Color.Secondary">Kategoriler yükleniyor...</MudText>
            }
            else if (!pazaramaCategories.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Kategorileri görüntülemek için "Kategorileri Yükle" butonuna tıklayın.
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <PazaramaCategoryTreeView Categories="@pazaramaCategories"
                                                  @bind-SelectedNodes="pazaramaSelectedNodes" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <SelectedCategoriesPanel SelectedCategories="@pazaramaSelectedNodes"
                                                 OnRemove="@RemovePazaramaSelectedCategory"
                                                 OnClearAll="@ClearPazaramaSelection" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
        </ChildContent>
    </MudTabPanel>
    <MudTabPanel>
        <TabContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MarketplaceLogo Name="PttAVM" Size="Size.Small" />
                <MudText>PttAVM</MudText>
            </MudStack>
        </TabContent>
        <ChildContent>
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">PttAVM Kategorileri</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadPttavmCategoriesAsync"
                               Disabled="@pttavmLoading">
                        @if (pttavmLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Kategorileri Yukle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ImportPttavmCategoriesAsync"
                               Disabled="@(importing || pttavmSelectedNodes == null || !pttavmSelectedNodes.Any())">
                        @if (importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Secilenleri Ice Aktar (@(pttavmSelectedNodes?.Count ?? 0))
                    </MudButton>
                </div>
            </div>

            @if (pttavmLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                <MudText Align="Align.Center" Color="Color.Secondary">Kategoriler yukleniyor...</MudText>
            }
            else if (!pttavmCategories.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Kategorileri goruntülemek icin "Kategorileri Yukle" butonuna tiklayin.
                </MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <PttavmCategoryTreeView Categories="@pttavmCategories"
                                                @bind-SelectedNodes="pttavmSelectedNodes"
                                                OnNodeExpanded="OnPttavmNodeExpanded" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <SelectedCategoriesPanel SelectedCategories="@pttavmSelectedNodes"
                                                 OnRemove="@RemovePttavmSelectedCategory"
                                                 OnClearAll="@ClearPttavmSelection" />
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
        </ChildContent>
    </MudTabPanel>

    <MudTabPanel>
        <TabContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MarketplaceLogo Name="Amazon" Size="Size.Small" />
                <MudText>Amazon</MudText>
            </MudStack>
        </TabContent>
        <ChildContent>
        <MudPaper Class="pa-4">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6">Amazon Product Types</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Amazon'da kategori ağacı yerine Product Type sistemi kullanılır
                </MudText>
            </div>

            <AmazonProductTypeSearch @bind-SelectedProductTypes="amazonSelectedProductTypes" />

            @if (amazonSelectedProductTypes.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">
                    @amazonSelectedProductTypes.Count product type seçildi.
                    Seçilen product type'lar ürün eşleştirmede kullanılacak.
                </MudAlert>
            }
        </MudPaper>
        </ChildContent>
    </MudTabPanel>
</MudTabs>

@if (importing)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9999">
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
                <MudText Typo="Typo.h6" Align="Align.Center">Kategori içe aktarma işlemi başlatılıyor...</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    İşlem arka planda devam edecek. Tamamlandığında bildirim alacaksınız.
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudOverlay>
}
