@using Entegrasyon.Entity.Dtos.Amazon

<MudTextField @bind-Value="SearchKeywords"
              Placeholder="Product type ara (ör: shoes, electronics)..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="false"
              OnKeyUp="OnSearchKeyUp"
              Class="mb-4" />

@if (Loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

<MudDataGrid T="AmazonProductTypeSearchResult"
             Items="@SearchResults.AsEnumerable()"
             Dense="true"
             Hover="true"
             SelectOnRowClick="true"
             MultiSelection="true"
             @bind-SelectedItems="SelectedItemsInternal"
             Height="400px"
             FixedHeader="true">
    <Columns>
        <SelectColumn T="AmazonProductTypeSearchResult" />
        <PropertyColumn Property="x => x.DisplayName" Title="Product Type" />
        <PropertyColumn Property="x => x.Name" Title="Kod" />
    </Columns>
    <NoRecordsContent>
        <MudText>Arama yapın veya sonuç bulunamadı.</MudText>
    </NoRecordsContent>
</MudDataGrid>

<MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
    @SearchResults.Count sonuç
</MudText>
