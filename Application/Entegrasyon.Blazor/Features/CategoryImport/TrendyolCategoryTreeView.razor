@using Entegrasyon.Blazor.ViewModels
@using System.Collections.ObjectModel

<MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="height: 600px; display: flex; flex-direction: column;">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Trendyol Kategori Ağacı</MudText>

    <MudTextField @bind-Value="SearchQuery"
                  Placeholder="Kategori ara..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  DebounceInterval="300"
                  OnDebounceIntervalElapsed="OnSearchChanged"
                  Class="mb-2" />

    @if (Loading)
    {
        <div class="d-flex justify-center align-center" style="flex: 1;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (!FilteredItems.Any())
    {
        <MudText Align="Align.Center" Color="Color.Secondary" Class="mt-4">
            @(string.IsNullOrWhiteSpace(SearchQuery) ? "Kategori bulunamadı" : "Arama sonucu bulunamadı")
        </MudText>
    }
    else
    {
        <div style="overflow-y: auto;">
            <MudVirtualize Items="@VisibleNodes" Context="node" ItemSize="48" OverscanCount="5">
                <CategoryTreeNodeTemplate Node="node"
                                        Level="node.Level"
                                        OnToggle="ToggleNode"
                                        OnSelect="SelectNode"
                                        IsSelected="GetSelectionState(node.Node)"
                                        IsIndeterminate="GetIndeterminateState(node.Node)" />
            </MudVirtualize>
        </div>
    }
</MudPaper>

