@using Entegrasyon.Blazor.ViewModels
@using Microsoft.AspNetCore.Components

<div style="display: flex; align-items: center; padding: 6px 0; margin-left: @(Level * 16)px;">
    @if (Node.Node.HasChildren)
    {
        <MudIconButton Icon="@(Node.Expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                       Size="Size.Small"
                       OnClick="() => OnToggle.InvokeAsync(Node.Node)"
                       Style="margin-right: 4px;" />
    }
    else
    {
        <div style="width: 32px;"></div>
    }

    <MudCheckBox T="bool?"
                 Value="IsSelected"
                 TriState="true"
                 ValueChanged="(value) => OnSelect.InvokeAsync(Node.Node)"
                 Color="Color.Primary"
                 Style="margin-right: 4px;" />

    <MudIcon Icon="@(Node.Node.HasChildren ? Icons.Material.Filled.Folder : Icons.Material.Filled.Category)"
             Size="Size.Small"
             Style="margin-right: 4px;" />

    <MudText>@Node.Node.Name</MudText>

    @if (Node.Node.HasChildren)
    {
        <MudChip T="string" Text="@Node.Node.Children.Count.ToString()"
                 Size="Size.Small"
                 Color="Color.Info"
                 Variant="Variant.Outlined"
                 Style="margin-left: auto;" />
    }
</div>

@code {
    [Parameter] public FlatTreeNode Node { get; set; } = null!;
    [Parameter] public int Level { get; set; }
    [Parameter] public EventCallback<CategoryTreeNode> OnToggle { get; set; }
    [Parameter] public EventCallback<CategoryTreeNode> OnSelect { get; set; }
    [Parameter] public bool? IsSelected { get; set; }
    [Parameter] public bool IsIndeterminate { get; set; }
}
