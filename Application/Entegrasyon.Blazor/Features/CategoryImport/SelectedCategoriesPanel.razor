@using Entegrasyon.Blazor.ViewModels

<MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="height: 600px; display: flex; flex-direction: column;">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Seçilen Kategoriler</MudText>

    @if (SelectedCategories == null || !SelectedCategories.Any())
    {
        <MudAlert Severity="Severity.Info">
            İçe aktarmak istediğiniz kategorileri sol taraftan seçin.
        </MudAlert>
    }
    else
    {
        <div style="flex: 1; overflow-y: auto;">
            <MudList T="string" Dense="true">
                @foreach (var category in SelectedCategories)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Category">
                        <div class="d-flex justify-space-between align-center" style="width: 100%">
                            <MudText>@category.Name</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => OnRemove.InvokeAsync(category))" />
                        </div>
                    </MudListItem>
                }
            </MudList>
        </div>

        <MudDivider Class="my-4" Style="flex-grow: 0;" />

        <div class="d-flex justify-space-between align-center">
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="@(() => OnClearAll.InvokeAsync())">
                Seçimi Temizle
            </MudButton>
            <MudText Color="Color.Primary" Typo="Typo.body2">
                <strong>Toplam:</strong> @SelectedCategories.Count kategori
            </MudText>
        </div>
    }
</MudPaper>

@code {
    [Parameter]
    public IReadOnlyCollection<CategoryTreeNode>? SelectedCategories { get; set; }

    [Parameter]
    public EventCallback<CategoryTreeNode> OnRemove { get; set; }

    [Parameter]
    public EventCallback OnClearAll { get; set; }
}
