@page "/products"
@rendermode InteractiveServer
@attribute [StreamRendering]
@attribute [Authorize(Policy = AppPermissions.Products.View)]
@using Entegrasyon.Entity.Dtos.Product
@implements IDisposable

<PageTitle>Ürünler</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Ürün Yönetimi</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField T="string" ValueChanged="@(s => OnSearchChanged(s))" Placeholder="Ürün ara (isim, stok kodu, barkod)..."
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                DebounceInterval="400" />
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Download"
                OnClick="ExportToExcel">
                Excel'e Aktar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenAddProductDialog">
                Yeni Ürün
            </MudButton>
        </MudItem>
    </MudGrid>
    </MudPaper>

    <MudDataGrid @ref="_dataGrid" T="ProductsDetailDto" ServerData="ServerData" Filterable="true" SortMode="SortMode.Multiple" Hover="true"
        Virtualize="true" FixedHeader="true" Height="600px" RowsPerPage="25"
        RowClick="OnRowClick" RowStyle="cursor: pointer;">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Ürünler</MudText>
            <MudSpacer />
        </ToolBarContent>
        <Columns>
            <TemplateColumn Title="Görsel" Sortable="false">
                <CellTemplate>
                    <MudAvatar Color="Color.Secondary" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Image" />
                    </MudAvatar>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.StockCode" Title="Stok Kodu" />
            <PropertyColumn Property="x => x.Title" Title="Ürün Adı" />
            <PropertyColumn Property="x => x.BrandName" Title="Marka" />
            <PropertyColumn Property="x => x.CategoryName" Title="Kategori" />
            <TemplateColumn Title="Stok" Sortable="true">
                <CellTemplate>
                    <MudChip Size="Size.Small" Color="@(context.Item.TotalCurrentStock > 0 ? Color.Success : Color.Error)">
                        @context.Item.TotalCurrentStock
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Varyant" Sortable="false">
                <CellTemplate>
                    <MudChip Size="Size.Small" Color="Color.Primary">
                        @context.Item.VariantCount adet
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn CellClass="d-flex justify-end" Title="İşlemler" Sortable="false">
                <CellTemplate>
                    <div @onclick:stopPropagation="true">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                            OnClick="@(() => NavigateToProduct(context.Item.Id))">
                            Görüntüle
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                            OnClick="@(() => EditProduct(context.Item))">
                            Düzenle
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy"
                            OnClick="@(async () => await DuplicateProduct(context.Item))">
                            Kopyala
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                            OnClick="@(async () => await DeleteProduct(context.Item))">
                            Sil
                        </MudMenuItem>
                    </MudMenu>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ProductsDetailDto" />
        </PagerContent>
    </MudDataGrid>
