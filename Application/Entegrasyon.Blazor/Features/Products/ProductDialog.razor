@using Entegrasyon.Business.Concrete
@using MudBlazor
@using Entegrasyon.Entity.Products
@using Entegrasyon.Entity.Dtos.Product

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.StockCode"
                                  Label="Stok Kodu"
                                  Required="true"
                                  RequiredError="Stok kodu gerekli" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Title"
                                  Label="Ürün Adı"
                                  Required="true"
                                  RequiredError="Ürün adı gerekli" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Açıklama"
                                  Lines="3" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               @bind-Value="_model.BrandId"
                               Label="Marka"
                               Required="true"
                               RequiredError="Marka seçimi gerekli">
                        @foreach (var brand in _brands)
                        {
                            <MudSelectItem @key="brand.Id" Value="@brand.Id">@brand.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int"
                               @bind-Value="_model.CategoryId"
                               Label="Kategori"
                               Required="true"
                               RequiredError="Kategori seçimi gerekli">
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem @key="category.Id" Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Season"
                                  Label="Sezon" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Year"
                                     Label="Yıl" />
                </MudItem>

                @if (!IsEditMode)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-4">Ürün Varyantları</MudText>
                        <MudButton OnClick="AddVariant"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="mb-2">
                            Varyant Ekle
                        </MudButton>

                        @foreach (var (variant, index) in _model.ProductVariants.Select((v, i) => (v, i)))
                        {
                            <MudPaper @key="index" Class="pa-2 mb-2">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudTextField @bind-Value="variant.Size"
                                                      Label="Beden"
                                                      Required="true" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudTextField @bind-Value="variant.Barcode"
                                                      Label="Barkod" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField @bind-Value="variant.ListPrice"
                                                         Label="Liste Fiyatı"
                                                         Min="0" />
                                    </MudItem>
                                    <MudItem xs="1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       OnClick="@(() => RemoveVariant(index))" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                @(IsEditMode ? "Güncelle" : "Kaydet")
            }
        </MudButton>
    </DialogActions>
</MudDialog>
