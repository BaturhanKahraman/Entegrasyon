@page "/products/add"
@using Entegrasyon.Entity.Dtos.Product
@using Entegrasyon.Entity.Dtos.Product.ProductVariant


<PageTitle>Yeni Ürün Ekle</PageTitle>

<MudPaper Class="pa-3 mb-3" Outlined="true">
    <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Large" Color="Color.Primary" />
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Yeni Ürün Ekle</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ürün bilgilerini adım adım tamamlayın.</MudText>
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4">
    <MudStepper @bind-ActiveIndex="stepIndex" Elevation="0" Linear="true">

        <ActionContent>
            @* Intentionally empty — custom Geri/İleri buttons are rendered below the stepper *@
        </ActionContent>

        <ChildContent>

        @* ── Step 0: Genel Bilgiler ── *@
        <MudStep Label="Genel">
            <StepContent>
                <MudForm @ref="formStep1">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Ürün Başlığı" @bind-Value="title" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Stok Kodu" @bind-Value="stockCode" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int" Label="Marka" @bind-Value="brandId" Placeholder="Marka seçin" Required="true">
                                <MudSelectItem T="int" Disabled>Lütfen bir marka seçin</MudSelectItem>
                                @foreach (var b in brands)
                                {
                                    <MudSelectItem Value="@b.Id">@b.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int" Label="Kategori" Value="@categoryId"
                                       ValueChanged="@OnCategoryChanged"
                                       Placeholder="Kategori seçin" Required="true">
                                <MudSelectItem T="int" Disabled>Lütfen bir kategori seçin</MudSelectItem>
                                @foreach (var c in categories)
                                {
                                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Sezon" @bind-Value="season" Placeholder="Örn: Yaz, Kış, İlkbahar" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Yıl" @bind-Value="year" Placeholder="Örn: 2026" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Label="Açıklama" Lines="4" @bind-Value="description" />
                        </MudItem>
                    </MudGrid>
                </MudForm>

                @* Regular (non-varianter, non-slicer) category attributes — animated on category select *@
                <MudCollapse Expanded="_regularAttrsVisible">
                    <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Kategori Özellikleri</MudText>
                    <MudGrid>
                        @foreach (var attr in _regularAttributes)
                        {
                            <MudItem xs="12" md="6">
                                @if (attr.CategoryAttributeValues.Count > 0 && !attr.AllowCustom)
                                {
                                    <MudSelect T="int?" Label="@attr.CategoriyAttributeHumanized"
                                               Required="@attr.IsRequired"
                                               Value="@(_regularAttrValueIds.TryGetValue(attr.Id, out var sv) ? sv : null)"
                                               ValueChanged="@((int? v) => _regularAttrValueIds[attr.Id] = v)"
                                               Clearable="true">
                                        @foreach (var val in attr.CategoryAttributeValues)
                                        {
                                            <MudSelectItem Value="@((int?)val.Id)">@val.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else if (attr.CategoryAttributeValues.Count > 0 && attr.AllowCustom)
                                {
                                    <MudSelect T="int?" Label="@attr.CategoriyAttributeHumanized"
                                               Value="@(_regularAttrValueIds.TryGetValue(attr.Id, out var sv2) ? sv2 : null)"
                                               ValueChanged="@((int? v) => _regularAttrValueIds[attr.Id] = v)"
                                               Clearable="true">
                                        @foreach (var val in attr.CategoryAttributeValues)
                                        {
                                            <MudSelectItem Value="@((int?)val.Id)">@val.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudTextField Label="Veya özel değer girin" Class="mt-1"
                                                  Value="@(_regularAttrCustomValues.TryGetValue(attr.Id, out var cv2) ? cv2 : null)"
                                                  ValueChanged="@((string? v) => _regularAttrCustomValues[attr.Id] = v)" />
                                }
                                else
                                {
                                    <MudTextField Label="@attr.CategoriyAttributeHumanized"
                                                  Required="@attr.IsRequired"
                                                  Value="@(_regularAttrCustomValues.TryGetValue(attr.Id, out var cv) ? cv : null)"
                                                  ValueChanged="@((string? v) => _regularAttrCustomValues[attr.Id] = v)" />
                                }
                            </MudItem>
                        }
                    </MudGrid>
                </MudCollapse>
            </StepContent>
        </MudStep>

        @* ── Step 1: Varyant Seçimi ── *@
        <MudStep Label="Varyant Seçimi">
            <StepContent>
                @if (!varianterAttributes.Any())
                {
                    @* Case A — no varianter attributes: single default variant already added *@
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        Bu kategori varyant özelliği içermiyor. Tek varyant olarak devam edilecek.
                    </MudAlert>
                }
                else
                {
                    @* Case B — has varianter attributes *@
                    <div class="varianter-list">
                        @foreach (var attr in varianterAttributes)
                        {
                            <MudPaper Class="pa-3 mb-3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                    <MudText Typo="Typo.subtitle1">@attr.AttributeName</MudText>
                                    @if (attr.IsVarianter)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Varyant</MudChip>
                                    }
                                    @if (attr.IsSlicer)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Dilimleyici</MudChip>
                                    }
                                </MudStack>
                                @if (attr.AllowCustom)
                                {
                                    <MudTextField Label="Değerleri girin (virgülle ayırın)"
                                                  @bind-Value="attr.CustomValueText"
                                                  HelperText="Örn: Kırmızı, Mavi, Yeşil" />
                                }
                                else
                                {
                                    <MudSelect T="int" MultiSelection="true" Label="Değerleri seçin"
                                               SelectedValues="@attr.SelectedValueIds"
                                               SelectedValuesChanged="@(vals => OnSelectedValuesChanged(attr, vals))"
                                               MultiSelectionTextFunc="@(ids => string.Join(", ", ids.Select(id => attr.Values.FirstOrDefault(v => v.Id.ToString() == id)?.Name ?? id)))">
                                        @foreach (var val in attr.Values)
                                        {
                                            <MudSelectItem Value="@val.Id">@val.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudPaper>
                        }
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GenerateVariants" Class="mb-3">
                            Seçilenlerden Varyant Oluştur
                        </MudButton>
                        @if (_showVariantGrid && _generatedVariantRows.Any())
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">
                                @_generatedVariantRows.Count kombinasyon oluştu — eklemek istediklerinizi seçin:
                            </MudText>
                            <MudDataGrid T="GeneratedVariantRow" Items="_generatedVariantRows.AsEnumerable()" Dense="true">
                                <Columns>
                                    <TemplateColumn Title="" CellStyle="width:48px">
                                        <CellTemplate>
                                            <MudCheckBox @bind-Value="context.Item.IsSelected" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="x => x.Label" Title="Kombinasyon" />
                                </Columns>
                            </MudDataGrid>
                            <MudStack Row="true" Spacing="2" Class="mt-2">
                                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmVariantSelection">
                                    Seçimi Onayla
                                </MudButton>
                                <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="@(() => _showVariantGrid = false)">
                                    İptal
                                </MudButton>
                            </MudStack>
                        }
                    </div>
                }

                @* Chip list of manually added / generated variants *@
                @if (variants.Any())
                {
                    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
                        @foreach (var (v, i) in variants.Select((v, i) => (v, i)))
                        {
                            <MudChip T="string" Text="@GetVariantLabel(v, i)"
                                     OnClose="@(() => RemoveVariant(i))"
                                     Color="Color.Primary" />
                        }
                    </div>
                }
            </StepContent>
        </MudStep>

        @* ── Step 2: Varyant Detayları & Görseller ── *@
        <MudStep Label="Varyantlar & Görseller">
            <StepContent>
                <div class="variants-section">
                    @if (!variants.Any())
                    {
                        <MudAlert Severity="Severity.Warning">Henüz varyant yok. Lütfen geri dönüp varyant oluşturun.</MudAlert>
                    }
                    else
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                   OnClick="OpenImageDialog" Class="mb-3">
                            Görselleri Yönet
                        </MudButton>
                    }

                    @foreach (var (variant, idx) in variants.Select((v, i) => (v, i)))
                    {
                        <MudPaper Class="pa-3 mt-3 variant-card">
                            @* Header: label + delete *@
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                <MudText Typo="Typo.subtitle1"><b>@GetVariantLabel(variant, idx)</b></MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => RemoveVariant(idx))" />
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="12" md="3">
                                    <MudTextField Label="Barkod" @bind-Value="variant.Barcode"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@Icons.Material.Filled.QrCode"
                                                  OnAdornmentClick="@(() => GenerateBarcodeForVariant(idx))"
                                                  AdornmentAriaLabel="Barkod Oluştur" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="decimal?" Label="Liste Fiyatı" @bind-Value="variant.ListPrice"
                                                     HideSpinButtons="true"
                                                     Adornment="Adornment.Start" AdornmentText="₺" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="decimal?" Label="Satış Fiyatı" @bind-Value="variant.SalePrice"
                                                     HideSpinButtons="true"
                                                     Adornment="Adornment.Start" AdornmentText="₺" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="decimal?" Label="Maliyet" @bind-Value="variant.CostPrice"
                                                     HideSpinButtons="true"
                                                     Adornment="Adornment.Start" AdornmentText="₺" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudNumericField T="decimal?" Label="Hacim Ağırlığı" @bind-Value="variant.DimensionalWeight" />
                                </MudItem>

                                @* Branch office stock entry *@
                                @if (_branchOffices.Any())
                                {
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Şube Stokları</MudText>
                                        <MudGrid Spacing="2">
                                            @foreach (var office in _branchOffices)
                                            {
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudNumericField T="int?"
                                                                     Label="@office.Name"
                                                                     Value="@GetStock(idx, office.Id)"
                                                                     ValueChanged="@(v => SetStock(idx, office.Id, v))"
                                                                     Min="0"
                                                                     HideSpinButtons="true" />
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    </MudItem>
                                }

                                @* Read-only image preview for this variant *@
                                @if (_variantImages.TryGetValue(idx, out var imgs) && imgs.Count > 0)
                                {
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="mb-1">Görseller</MudText>
                                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                                            @foreach (var img in imgs)
                                            {
                                                <div style="position:relative;width:64px;height:64px;">
                                                    <img src="@img.PreviewUrl" style="width:64px;height:64px;object-fit:cover;border-radius:4px;" />
                                                    @if (img.IsPrimary)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning"
                                                                 Style="position:absolute;top:1px;left:1px;font-size:14px;" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>
                    }
                </div>
            </StepContent>
        </MudStep>

        @* ── Step 3: Pazaryeri Seçimi & Özet ── *@
        <MudStep Label="Pazaryeri">
            <StepContent>
                <MudText Typo="Typo.subtitle1" Class="mb-3">Ürünü hangi pazaryerlerine eklemek istiyorsunuz?</MudText>

                <MudPaper Class="pa-3 mb-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox @bind-Value="_trendyolSelected" Color="Color.Primary" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1"><b>Trendyol</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Ürün Trendyol'a gönderilecek</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-3 mb-2" Style="opacity:0.5">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox Value="false" Disabled="true" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1"><b>Hepsiburada</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Yakında</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-3 mb-2" Style="opacity:0.5">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox Value="false" Disabled="true" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1"><b>Amazon.com.tr</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Yakında</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudDivider Class="my-4" />

                @* Summary *@
                <MudText Typo="Typo.h6" Class="mb-2">Özet</MudText>
                <MudPaper Class="pa-3">
                    <div><b>Başlık:</b> @title</div>
                    <div><b>Stok Kodu:</b> @stockCode</div>
                    <div><b>Marka:</b> @brands.FirstOrDefault(b => b.Id == brandId)?.Name</div>
                    <div><b>Kategori:</b> @categories.FirstOrDefault(c => c.Id == categoryId)?.Name</div>
                    <div class="mt-2"><b>Varyant Sayısı:</b> @variants.Count</div>

                    @foreach (var (v, i) in variants.Select((v, i) => (v, i)))
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2">@GetVariantLabel(v, i)</MudText>
                        <MudText Typo="Typo.caption">Satış Fiyatı: ₺@(v.SalePrice?.ToString("N2") ?? "-")</MudText>
                        @if (_variantImages.TryGetValue(i, out var imgs) && imgs.Count > 0)
                        {
                            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
                                @foreach (var img in imgs)
                                {
                                    <div style="position:relative;">
                                        <img src="@img.PreviewUrl" style="width:60px;height:60px;object-fit:cover;border-radius:4px;" />
                                        @if (img.IsPrimary)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning"
                                                     Style="position:absolute;top:1px;left:1px;font-size:14px;" />
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </MudPaper>
            </StepContent>
        </MudStep>

        </ChildContent>

    </MudStepper>

    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
        <MudButton Variant="Variant.Outlined" OnClick="PreviousStep" Disabled="@(stepIndex == 0 || _isSaving)">Geri</MudButton>
        @if (stepIndex < 3)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextStep" Disabled="_isSaving">İleri</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Submit" Disabled="_isSaving">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>Kaydet ve Yayınla</span>
                }
            </MudButton>
        }
    </MudStack>
</MudPaper>
