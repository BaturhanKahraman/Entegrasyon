@if (!_dismissed && OutOfSyncMarketplaces.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" Dense="true" NoIcon="false">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2">
                Bu ürünün bilgilerinde değişiklik yapılmış ve
                <strong>@string.Join(", ", OutOfSyncMarketplaces.Select(m => m.Name))</strong>
                pazaryerine gönderilmemiş.
            </MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                       OnClick="SyncNow">Hemen Senkronize Et</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                       OnClick="RemindLater">Daha Sonra Hatırlat</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                       OnClick="Dismiss">Yoksay</MudButton>
        </MudStack>
    </MudAlert>
}
