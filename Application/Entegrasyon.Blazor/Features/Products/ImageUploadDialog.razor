@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" />
            <MudText Typo="Typo.h6">Görsel Yönetimi</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @* ── Upload Area ── *@
        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                       FilesChanged="OnFilesUploaded"
                       Accept=".jpg,.jpeg,.png,.webp"
                       Multiple="true"
                       MaximumFileCount="50">
            <ActivatorContent>
                <MudPaper Class="pa-6 d-flex flex-column align-center justify-center mud-border-primary"
                          Style="border:2px dashed;cursor:pointer;min-height:120px;" Outlined="true">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.body1" Class="mt-2">Görselleri sürükleyin veya tıklayarak seçin</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">JPG, PNG, WEBP — Maks. 5 MB</MudText>
                </MudPaper>
            </ActivatorContent>
        </MudFileUpload>

        @* ── Gallery Grid ── *@
        @if (_allImages.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Yüklenen Görseller (@_allImages.Count)</MudText>
            <MudGrid Spacing="2">
                @foreach (var img in _allImages)
                {
                    <MudItem xs="2">
                        <div style="position:relative;width:80px;height:80px;">
                            <img src="@img.PreviewUrl"
                                 style="width:80px;height:80px;object-fit:cover;border-radius:4px;" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Error" Size="Size.Small"
                                           Style="position:absolute;top:-4px;right:-4px;background:rgba(255,255,255,0.8);padding:2px;"
                                           OnClick="@(() => RemoveImage(img))" />
                        </div>
                    </MudItem>
                }
            </MudGrid>
        }

        @* ── Assignment Table ── *@
        @if (_allImages.Count > 0 && Variants is { Count: > 0 })
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Varyant Ataması</MudText>
            <div style="overflow-x:auto;">
                <MudSimpleTable Dense="true" Bordered="true" Striped="true">
                    <thead>
                        <tr>
                            <th style="min-width:140px;">Varyant</th>
                            @foreach (var img in _allImages)
                            {
                                <th style="text-align:center;padding:4px;">
                                    <img src="@img.PreviewUrl"
                                         style="width:40px;height:40px;object-fit:cover;border-radius:3px;" />
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variant in Variants)
                        {
                            <tr>
                                <td>@variant.Label</td>
                                @foreach (var img in _allImages)
                                {
                                    var vIdx = variant.Index;
                                    var imgId = img.Id;
                                    <td style="text-align:center;">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="0">
                                            <MudCheckBox T="bool"
                                                         Value="@IsAssigned(vIdx, imgId)"
                                                         ValueChanged="@(val => ToggleAssignment(vIdx, imgId, val))"
                                                         Size="Size.Small" />
                                            @if (IsAssigned(vIdx, imgId))
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Star"
                                                               Color="@(IsCover(vIdx, imgId) ? Color.Warning : Color.Default)"
                                                               Size="Size.Small"
                                                               OnClick="@(() => SetCover(vIdx, imgId))"
                                                               Title="Kapak görseli yap" />
                                            }
                                        </MudStack>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Kaydet</MudButton>
    </DialogActions>
</MudDialog>
