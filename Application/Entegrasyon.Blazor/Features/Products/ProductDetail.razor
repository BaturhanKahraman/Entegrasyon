@page "/products/{Id:guid}"
@rendermode InteractiveServer
@using Entegrasyon.Entity.Dtos.Product
@using Entegrasyon.Entity.Dtos.Product.ProductVariant
@using Entegrasyon.Blazor.Features.Printing
@using Entegrasyon.Blazor.Features.Products.Discount

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_product is null)
    {
        <MudAlert Severity="Severity.Error">Ürün bulunamadı.</MudAlert>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
            <MudText Typo="Typo.h5">@_product.Title</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@_product.StockCode</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClick="GoToBrand">@_product.BrandName</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" OnClick="GoToCategory">@_product.CategoryName</MudChip>

            @if (_syncStatus is not null && _syncStatus.State != MarketplaceSyncState.NeverSynced)
            {
                <MudChip T="string" Size="Size.Small" Color="@SyncChipInfo.Color"
                         OnClick="@(CanSync ? SyncToMarketplace : null)"
                         Variant="@(CanSync ? Variant.Filled : Variant.Outlined)">
                    @SyncChipInfo.Label
                </MudChip>
            }

            <MudSpacer />

            <MudButton OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack"
                       Variant="Variant.Outlined" Color="Color.Default">
                Geri
            </MudButton>
            <MudMenu Label="İşlemler" Variant="Variant.Filled" Color="Color.Primary"
                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                <MudMenuItem OnClick="GoToEditGeneral" Icon="@Icons.Material.Filled.Edit">Temel Bilgi Düzenle</MudMenuItem>
                <MudMenuItem OnClick="GoToEditStock" Icon="@Icons.Material.Filled.Inventory">Stok Düzenle</MudMenuItem>
                <MudMenuItem OnClick="GoToEditCategory" Icon="@Icons.Material.Filled.Category">Kategori Düzenle</MudMenuItem>
                <MudMenuItem OnClick="PrintBarcode" Icon="@Icons.Material.Filled.Print">Barkod Yazdır</MudMenuItem>
                <MudMenuItem OnClick="OpenDiscountDialog" Icon="@Icons.Material.Filled.Discount">İndirim Uygula</MudMenuItem>
                <MudMenuItem OnClick="SyncToMarketplace" Icon="@Icons.Material.Filled.Sync"
                             Disabled="@(!CanSync)">Pazaryeri Senkronizasyonu</MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="DeleteProduct" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">Sil</MudMenuItem>
            </MudMenu>
        </MudStack>

        <SyncWarningBanner ProductId="Id"
                           OutOfSyncMarketplaces="_outOfSyncMarketplaces"
                           ProductUpdatedAt="_product.UpdatedAt"
                           OnSyncRequested="SyncAllOutOfSync" />

        <MudGrid>
            <MudItem xs="12">
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">Genel Bilgiler</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudText Typo="Typo.body2" Color="Color.Dark">Açıklama</MudText>
                                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_product.Description) ? "—" : _product.Description)</MudText>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.body2" Color="Color.Dark">Sezon</MudText>
                                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_product.Season) ? "—" : _product.Season)</MudText>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.body2" Color="Color.Dark">Yıl</MudText>
                                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_product.Year) ? "—" : _product.Year)</MudText>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.body2" Color="Color.Dark">Toplam Stok</MudText>
                                <MudText Typo="Typo.body1">@_product.TotalQuantity</MudText>
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.body2" Color="Color.Dark">Satılan</MudText>
                                <MudText Typo="Typo.body1">@_product.TotalSoldQuantity</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @if (_product.AttributeKeyValueDetails.Any())
            {
                <MudItem xs="12">
                    <MudCard Elevation="1">
                        <MudCardHeader>
                            <MudText Typo="Typo.h6">Özellikler</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudGrid>
                                @foreach (var attr in _product.AttributeKeyValueDetails)
                                {
                                    <MudItem @key="attr.AttributeKey" xs="12" sm="6">
                                        <MudText Typo="Typo.body2" Color="Color.Dark">@attr.AttributeHumanized</MudText>
                                        <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(attr.AttributeValue) ? "—" : attr.AttributeValue)</MudText>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }

            <MudItem xs="12">
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">Varyantlar</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudExpansionPanels MultiExpansion="true">
                            @foreach (var variant in _product.ProductVariantsDetails)
                            {
                                <MudExpansionPanel @key="variant.Barcode" Text="@variant.Barcode">
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                                                <thead>
                                                    <tr>
                                                        <th>Liste Fiyatı</th>
                                                        <th>Satış Fiyatı</th>
                                                        <th>Maliyet</th>
                                                        <th>E-Ticaret Fiyatı</th>
                                                        <th>KDV (%)</th>
                                                        <th>Desi</th>
                                                        <th>Para Birimi</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>@variant.ListPrice.ToString("N2")</td>
                                                        <td>@variant.SalePrice.ToString("N2")</td>
                                                        <td>@variant.CostPrice.ToString("N2")</td>
                                                        <td>@variant.ECommercePrice.ToString("N2")</td>
                                                        <td>@variant.VatRate.ToString("N0")</td>
                                                        <td>@variant.DeminsionalWeight.ToString("N2")</td>
                                                        <td>@variant.CurrencyType</td>
                                                    </tr>
                                                </tbody>
                                            </MudSimpleTable>
                                        </MudItem>

                                        @if (variant.imageLinks.Any())
                                        {
                                            <MudItem xs="12">
                                                <MudText Typo="Typo.subtitle2" Class="mb-2">Görseller</MudText>
                                                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                                    @foreach (var img in variant.imageLinks)
                                                    {
                                                        <MudImage @key="img" Src="@img" Width="120" Height="120" ObjectFit="ObjectFit.Cover"
                                                                  Elevation="1" Class="rounded-lg" />
                                                    }
                                                </MudStack>
                                            </MudItem>
                                        }

                                        @if (variant.StockDetails.Any())
                                        {
                                            <MudItem xs="12">
                                                <MudText Typo="Typo.subtitle2" Class="mb-2">Stok Durumu</MudText>
                                                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                                                    <thead>
                                                        <tr>
                                                            <th>Şube</th>
                                                            <th>Mevcut Stok</th>
                                                            <th>Satılan</th>
                                                            <th>İlk Stok</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var stock in variant.StockDetails)
                                                        {
                                                            <tr @key="stock.OfficeName">
                                                                <td>@stock.OfficeName</td>
                                                                <td>@stock.CurrentStock</td>
                                                                <td>@stock.SoldQuantity</td>
                                                                <td>@stock.FirstTotalStock</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

    }
</MudContainer>
