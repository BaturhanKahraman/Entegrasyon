@using Entegrasyon.Entity.Categories
@using AppCategoryAttribute = Entegrasyon.Entity.Categories.CategoryAttribute

<MudStack Spacing="2">
    <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-1">
        Mevcut bir özelliği ekleyebilir, yeni özellik oluşturabilir ve değerlerini yönetebilirsiniz.
    </MudText>

    <MudStack Row="true" Spacing="1" Class="mb-3">
        <MudButton OnClick="AddExistingAttribute"
                   StartIcon="@Icons.Material.Filled.Search"
                   Color="Color.Primary"
                   Variant="Variant.Outlined"
                   Size="Size.Small">
            Mevcut Özellik Ekle
        </MudButton>
        <MudButton OnClick="AddNewAttribute"
                   StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Secondary"
                   Variant="Variant.Outlined"
                   Size="Size.Small">
            Yeni Özellik Oluştur
        </MudButton>
    </MudStack>

    @foreach (var (attr, index) in Attributes.Select((a, i) => (a, i)))
    {
        <MudPaper @key="index" Class="pa-3 mb-2" Outlined="true">
            <MudGrid>
                @if (attr.IsExisting)
                {
                    <MudItem xs="11">
                        <MudAutocomplete T="AppCategoryAttribute"
                                         Value="attr.SelectedAttribute"
                                         ValueChanged="@(val => OnExistingAttributeSelected(val, attr))"
                                         SearchFunc="SearchAttributes"
                                         Label="Özellik Ara"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         ToStringFunc="@(x => x?.CategoryAttributeHumanized ?? "")"
                                         Required="true"
                                         RequiredError="Özellik seçilmeli" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="5">
                        <MudTextField @bind-Value="attr.CategoryAttributeKey"
                                      Label="Özellik Anahtar (key)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="Anahtar gerekli" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="attr.CategoryAttributeHumanized"
                                      Label="Görünen Ad"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="Görünen ad gerekli" />
                    </MudItem>
                }

                <MudItem xs="1" Class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => RemoveAttribute(index))" />
                </MudItem>

                <MudItem xs="3">
                    <MudCheckBox @bind-Value="attr.IsRequired"
                                 Label="Zorunlu"
                                 Dense="true"
                                 Color="Color.Primary" />
                </MudItem>
                <MudItem xs="3">
                    <MudCheckBox Value="attr.IsVarianter"
                                 ValueChanged="@(async (bool v) => await OnVarianterChanged(v, attr))"
                                 Label="Varyant"
                                 Dense="true"
                                 Color="Color.Info" />
                </MudItem>
                <MudItem xs="3">
                    <MudCheckBox Value="attr.IsSlicer"
                                 ValueChanged="@(async (bool v) => await OnSlicerChanged(v, attr))"
                                 Label="Dilimleyici"
                                 Dense="true"
                                 Color="Color.Warning" />
                </MudItem>
                <MudItem xs="3" Class="d-flex align-center">
                    <MudChip T="string"
                             Color="@(attr.AllowCustom ? Color.Tertiary : Color.Default)"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Disabled="true">
                        @(attr.AllowCustom ? "Serbest Değer: Açık" : "Serbest Değer: Kapalı")
                    </MudChip>
                </MudItem>

                @* Attribute values as chips *@
                <MudItem xs="12">
                    <MudChipSet T="string" ReadOnly="false">
                        @foreach (var val in attr.Values)
                        {
                            <MudChip @key="val.Id" T="string"
                                     Text="@val.Value"
                                     Color="Color.Default"
                                     Variant="Variant.Outlined"
                                     OnClose="@(() => RemoveValue(attr, val))">
                                @val.Value
                            </MudChip>
                        }
                    </MudChipSet>
                </MudItem>

                <MudItem xs="10">
                    <MudTextField @bind-Value="attr.NewValueText"
                                  Label="Yeni değer ekle"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  OnKeyDown="@(async (e) => { if (e.Key == "Enter") await AddValue(attr); })" />
                </MudItem>
                <MudItem xs="2" Class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => AddValue(attr))" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @if (_validationError is not null)
    {
        <MudAlert Severity="Severity.Error">@_validationError</MudAlert>
    }
</MudStack>
