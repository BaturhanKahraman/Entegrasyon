@using Entegrasyon.Entity.Categories

<MudPaper Class="pa-4" Style="min-height: 700px;">
    @if (SelectedCategory != null)
    {
        <div class="d-flex justify-space-between align-center mb-4">
            <MudText Typo="Typo.h6">Kategori Detayları</MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           OnClick="OnEditClicked">
                    Düzenle
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           OnClick="OnDeleteClicked">
                    Sil
                </MudButton>
            </div>
        </div>

        @if (SubcategoryCount > 0)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                Bu kategori alt kategorilere sahiptir. Özellikler ve pazar yeri eşleştirmeleri yalnızca yaprak kategorilere eklenebilir.
            </MudAlert>
        }

        <MudGrid>
            <MudItem xs="12">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardContent>
                        <MudText Typo="Typo.h5" Class="mb-2">@SelectedCategory.Name</MudText>
                        <div class="d-flex gap-2 mb-4">
                            @if (SelectedCategory.IsFavorite)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                                    Favori
                                </MudChip>
                            }
                            @if (SelectedCategory.IsImported)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.CloudDownload">
                                    İçe Aktarıldı
                                </MudChip>
                            }
                        </div>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Kategori ID</MudText>
                        <MudText Typo="Typo.body1" Class="mb-3">@SelectedCategory.Id</MudText>

                        @if (SelectedCategory.SuperCategoryId.HasValue)
                        {
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Üst Kategori</MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">
                                @GetParentCategoryName(SelectedCategory.SuperCategoryId.Value)
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" Class="mt-4">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Kategori Özellikleri</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                @(SelectedCategory.CategoryAttributes?.Count ?? 0) özellik
                            </MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (SelectedCategory.CategoryAttributes?.Any() == true)
                        {
                            <MudList T="string" Dense="true">
                                @foreach (var attr in SelectedCategory.CategoryAttributes)
                                {
                                    <MudListItem @key="attr.CategoryAttributeId" T="string" Icon="@Icons.Material.Filled.Label">
                                        <div class="d-flex justify-space-between">
                                            <MudText>@(attr.CategoryAttribute?.CategoryAttributeHumanized ?? "N/A")</MudText>
                                            <MudChip T="string" Size="Size.Small">
                                                @(attr.IsRequired ? "Zorunlu" : "Opsiyonel")
                                            </MudChip>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Align="Align.Center" Color="Color.Secondary">
                                Bu kategoriye özellik eklenmemiş
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" Class="mt-4">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">İstatistikler</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="6">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Ürün</MudText>
                                <MudText Typo="Typo.h5">@ProductCount</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Alt Kategoriler</MudText>
                                <MudText Typo="Typo.h5">@SubcategoryCount</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* Ürünler *@
            @if (ProductCount > 0)
            {
                <MudItem xs="12" Class="mt-4">
                    <MudCard Elevation="0" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Ürünler</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                    @ProductCount ürün
                                </MudChip>
                                @if (!_showProducts)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Visibility"
                                               OnClick="LoadProducts">
                                        Ürünleri Gör
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.VisibilityOff"
                                               OnClick="() => _showProducts = false">
                                        Gizle
                                    </MudButton>
                                }
                            </CardHeaderActions>
                        </MudCardHeader>
                        @if (_showProducts)
                        {
                            <MudCardContent>
                                @if (_loadingProducts)
                                {
                                    <MudProgressLinear Indeterminate="true" />
                                }
                                else if (_products.Count > 0)
                                {
                                    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="max-height: 400px; overflow-y: auto;">
                                        <thead>
                                            <tr>
                                                <th>Ürün Adı</th>
                                                <th>Barkod</th>
                                                <th>Fiyat</th>
                                                <th>Stok</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in _products)
                                            {
                                                <tr style="cursor: pointer;" @onclick="() => NavigateToProduct(p.ProductId)">
                                                    <td>@p.Title</td>
                                                    <td><code>@p.Barcode</code></td>
                                                    <td>@p.SalePrice.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</td>
                                                    <td>
                                                        <MudChip T="string" Size="Size.Small"
                                                                 Color="@(p.Stock > 0 ? Color.Success : Color.Error)">
                                                            @p.Stock
                                                        </MudChip>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                                else
                                {
                                    <MudText Color="Color.Secondary" Align="Align.Center">Ürün bulunamadı</MudText>
                                }
                            </MudCardContent>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudText Align="Align.Center" Color="Color.Secondary" Class="py-8">
            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Class="mb-4" />
            <br />
            Detayları görmek için bir kategori seçin
        </MudText>
    }
</MudPaper>

