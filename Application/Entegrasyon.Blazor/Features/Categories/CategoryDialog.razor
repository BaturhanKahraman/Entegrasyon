@using MudBlazor
@using Entegrasyon.Entity.Categories
@using AppCategoryAttribute = Entegrasyon.Entity.Categories.CategoryAttribute

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Kategori Adı"
                                  Required="true"
                                  RequiredError="Kategori adı gerekli" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_model.IsFavorite"
                                 Label="Favori Kategori"
                                 Color="Color.Warning" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="decimal?" @bind-Value="_model.DefaultVatRate"
                               Label="Varsayilan KDV Orani"
                               Clearable="true"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@((decimal?)1)">%1</MudSelectItem>
                        <MudSelectItem Value="@((decimal?)10)">%10</MudSelectItem>
                        <MudSelectItem Value="@((decimal?)20)">%20</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="int?"
                               @bind-Value="_model.ParentCategoryId"
                               Label="Üst Kategori (Opsiyonel)"
                               Clearable="true">
                        <MudSelectItem Value="@((int?)null)" Disabled>Bir üst kategori seçebilirsiniz.</MudSelectItem>
                        @foreach (var cat in _availableCategories)
                        {
                            <MudSelectItem @key="cat.Id" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Yalnızca özellik içermeyen kategoriler üst kategori olabilir.
                    </MudText>
                </MudItem>

                @if (_isLeafCategory)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-2">Kategori Özellikleri</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-2">
                            Mevcut bir özelliği ekleyebilir veya yeni bir özellik oluşturabilirsiniz.
                        </MudText>

                        <MudStack Row="true" Spacing="1" Class="mb-3">
                            <MudButton OnClick="AddExistingAttribute"
                                       StartIcon="@Icons.Material.Filled.Search"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small">
                                Mevcut Özellik Ekle
                            </MudButton>
                            <MudButton OnClick="AddNewAttribute"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Color="Color.Secondary"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small">
                                Yeni Özellik Oluştur
                            </MudButton>
                        </MudStack>

                        @foreach (var (attr, index) in _model.Attributes.Select((a, i) => (a, i)))
                        {
                            <MudPaper @key="index" Class="pa-3 mb-2" Outlined="true">
                                <MudGrid>
                                    @if (attr.IsExisting)
                                    {
                                        <MudItem xs="11">
                                            <MudAutocomplete T="AppCategoryAttribute"
                                                             Value="attr.SelectedAttribute"
                                                             ValueChanged="@(val => OnExistingAttributeSelected(val, attr))"
                                                             SearchFunc="SearchAttributes"
                                                             Label="Özellik Ara"
                                                             Variant="Variant.Outlined"
                                                             Dense="true"
                                                             ToStringFunc="@(x => x?.CategoryAttributeHumanized ?? "")"
                                                             Required="true"
                                                             RequiredError="Özellik seçilmeli" />
                                        </MudItem>
                                    }
                                    else
                                    {
                                        <MudItem xs="11">
                                            <MudTextField @bind-Value="attr.Name"
                                                          Label="Yeni Özellik Adı"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Required="true"
                                                          RequiredError="Özellik adı gerekli" />
                                        </MudItem>
                                    }
                                    <MudItem xs="1" Class="d-flex align-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveAttribute(index))" />
                                    </MudItem>

                                    <MudItem xs="3">
                                        <MudCheckBox @bind-Value="attr.IsRequired"
                                                     Label="Zorunlu"
                                                     Dense="true"
                                                     Color="Color.Primary" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudCheckBox Value="attr.IsVarianter"
                                                     ValueChanged="@(async (bool v) => await OnVarianterChanged(v, attr))"
                                                     Label="Varyant"
                                                     Dense="true"
                                                     Color="Color.Info" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudCheckBox Value="attr.IsSlicer"
                                                     ValueChanged="@(async (bool v) => await OnSlicerChanged(v, attr))"
                                                     Label="Dilimleyici"
                                                     Dense="true"
                                                     Color="Color.Warning" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudSwitch @bind-Value="attr.AllowCustom"
                                                   Label="Serbest Değer"
                                                   Color="Color.Tertiary" />
                                    </MudItem>

                                    @* Attribute values as chips *@
                                    <MudItem xs="12">
                                        <MudChipSet T="string" ReadOnly="false">
                                            @foreach (var val in attr.Values)
                                            {
                                                <MudChip @key="val" T="string"
                                                         Text="@val.Name"
                                                         Color="Color.Default"
                                                         Variant="Variant.Outlined"
                                                         OnClose="@(() => RemoveValue(attr, val))">
                                                    @val.Name
                                                </MudChip>
                                            }
                                        </MudChipSet>
                                    </MudItem>

                                    @if (attr.AllowCustom)
                                    {
                                        <MudItem xs="10">
                                            <MudTextField @bind-Value="attr.NewValueName"
                                                          Label="Yeni değer ekle"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          OnKeyDown="@(async (e) => { if (e.Key == "Enter") await AddValue(attr); })" />
                                        </MudItem>
                                        <MudItem xs="2" Class="d-flex align-center">
                                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="@(() => AddValue(attr))" />
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudPaper>
                        }
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            Bu kategorinin alt kategorileri var. Kategori özellikleri sadece en alt seviyedeki kategorilere eklenebilir.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                @(IsEditMode ? "Güncelle" : "Kaydet")
            }
        </MudButton>
    </DialogActions>
</MudDialog>
