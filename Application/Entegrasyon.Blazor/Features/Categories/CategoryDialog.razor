@using Entegrasyon.Business.Concrete
@using MudBlazor
@using Entegrasyon.Entity.Categories
@using Entegrasyon.Entity.Dtos.Category

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Kategori Adı"
                                  Required="true"
                                  RequiredError="Kategori adı gerekli" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_model.IsFavorite"
                                 Label="Favori Kategori"
                                 Color="Color.Warning" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="int?"
                               @bind-Value="_model.ParentCategoryId"
                               Label="Üst Kategori (Opsiyonel)"
                               Clearable="true">
                        <MudSelectItem Value="@((int?)null)">Ana Kategori</MudSelectItem>
                        @foreach (var cat in _availableCategories)
                        {
                            <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Yalnızca özellik içermeyen kategoriler üst kategori olabilir.
                    </MudText>
                </MudItem>

                @if (_isLeafCategory)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-2">Kategori Özellikleri</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-2">
                            Bu kategori en alt seviyede olduğu için özellik ekleyebilirsiniz.
                        </MudText>
                        <MudButton OnClick="AddAttribute"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="mb-2">
                            Özellik Ekle
                        </MudButton>

                        @foreach (var (attr, index) in _model.Attributes.Select((a, i) => (a, i)))
                        {
                            <MudPaper Class="pa-2 mb-2">
                                <MudGrid>
                                    <MudItem xs="5">
                                        <MudTextField @bind-Value="attr.Name"
                                                      Label="Özellik Adı" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudSelect T="string"
                                                   @bind-Value="attr.Type"
                                                   Label="Tip">
                                            <MudSelectItem Value="@("Text")">Metin</MudSelectItem>
                                            <MudSelectItem Value="@("Number")">Sayı</MudSelectItem>
                                            <MudSelectItem Value="@("Boolean")">Evet/Hayır</MudSelectItem>
                                            <MudSelectItem Value="@("List")">Liste</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudCheckBox @bind-Value="attr.IsRequired"
                                                     Label="Zorunlu" />
                                    </MudItem>
                                    <MudItem xs="1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       OnClick="@(() => RemoveAttribute(index))" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            Bu kategorinin alt kategorileri var. Kategori özellikleri sadece en alt seviyedeki kategorilere eklenebilir.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="@(async () => await Submit())"
                   Disabled="@(!_isValid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                @(IsEditMode ? "Güncelle" : "Kaydet")
            }
        </MudButton>
    </DialogActions>
</MudDialog>
