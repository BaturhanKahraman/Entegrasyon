@page "/categories"
@rendermode InteractiveServer
@attribute [StreamRendering]
@attribute [Authorize(Policy = AppPermissions.Categories.View)]
@using Entegrasyon.Entity.Categories

<PageTitle>Kategoriler</PageTitle>

<div class="d-flex justify-space-between align-center mb-2">
    <MudText Typo="Typo.h3">Kategori Yönetimi</MudText>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.CloudDownload"
               OnClick="@OpenMasterCatalogImportDialog">
        Master Catalog'dan İçe Aktar
    </MudButton>
</div>

<MudGrid>
    <MudItem xs="12" md="5">
        <CategoryTreePanel TreeItems="@GetTreeItemsForView()"
                          AllCategories="@_categories"
                          Loading="@_loading"
                          CategorySelected="@(EventCallback.Factory.Create<Category>(this, OnCategorySelected))"
                          OnAddClicked="@OpenAddCategoryDialog"
                          OnImportClicked="@(() => NavigationManager.NavigateTo("/categories/import"))"
                          FilterChanged="@((string s) => { _searchString = s; })" />
    </MudItem>

    <MudItem xs="12" md="7">
        <CategoryDetailsPanel SelectedCategory="@_selectedCategory"
                             SubcategoryCount="@(_selectedCategory != null ? GetSubcategoryCount(_selectedCategory.Id) : 0)"
                             ProductCount="@_productCount"
                             OnEditClicked="@EditSelectedCategory"
                             OnDeleteClicked="@DeleteSelectedCategory"
                             GetParentCategoryNameFunc="@GetParentCategoryName" />
    </MudItem>
</MudGrid>

