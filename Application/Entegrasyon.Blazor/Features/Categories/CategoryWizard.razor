@page "/categories/add"
@page "/categories/edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPermissions.Categories.View)]
@using Entegrasyon.ApplicationBootstrap.Security

<PageTitle>@(IsEditMode ? "Kategori Düzenle" : "Yeni Kategori Ekle")</PageTitle>

<UnsavedChangesGuard IsDirty="_isDirty" />

<MudPaper Class="pa-3 mb-3" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddBox)"
                 Size="Size.Large"
                 Color="Color.Primary" />
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(IsEditMode ? "Kategori Düzenle" : "Yeni Kategori Ekle")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(IsEditMode ? "Kategori bilgilerini güncelleyin." : "Kategori bilgilerini adım adım tamamlayın.")
            </MudText>
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else
{
    <MudPaper Class="pa-4">
        <MudStepper @bind-ActiveIndex="_activeStep" NonLinear="@IsEditMode">

            <ActionContent>
                @* Intentionally empty — custom buttons are rendered below *@
            </ActionContent>

            <ChildContent>

                @* ── Step 0: Genel Bilgiler ── *@
                <MudStep Title="Genel Bilgiler">
                    <ChildContent>
                        <CategoryWizardGeneralStep @ref="_generalStep"
                                                   @bind-Name="_name"
                                                   @bind-ParentCategoryId="_parentCategoryId"
                                                   @bind-IsFavorite="_isFavorite"
                                                   @bind-DefaultVatRate="_defaultVatRate"
                                                   EditCategoryId="@(IsEditMode ? Id : null)"
                                                   OnFieldChanged="MarkDirty" />
                    </ChildContent>
                </MudStep>

                @* ── Step 1: Özellikler ── *@
                <MudStep Title="Özellikler">
                    <ChildContent>
                        <CategoryWizardAttributesStep @ref="_attributesStep"
                                                      @bind-Attributes="_attributes"
                                                      OnFieldChanged="MarkDirty" />
                    </ChildContent>
                </MudStep>

                @* ── Step 2: Pazar Yeri Eşleştirme ── *@
                <MudStep Title="Pazar Yeri">
                    <ChildContent>
                        <CategoryWizardMarketplaceStep @ref="_marketplaceStep"
                                                       CategoryId="@(_savedCategoryId ?? 0)"
                                                       CategoryName="@_name"
                                                       @bind-SelectedMarketplaceId="_selectedMarketplaceId"
                                                       OnFieldChanged="MarkDirty" />
                    </ChildContent>
                </MudStep>

            </ChildContent>
        </MudStepper>

        @* ── Action Buttons ── *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       OnClick="Cancel"
                       Disabled="_saving">
                İptal
            </MudButton>

            <MudStack Row="true" Spacing="2">
                @if (_activeStep > 0)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="PreviousStep"
                               Disabled="_saving">
                        Geri
                    </MudButton>
                }

                @if (_activeStep < 2)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               OnClick="NextStep"
                               Disabled="_saving">
                        İleri
                    </MudButton>
                }

                @if (_activeStep == 2)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="Save"
                               Disabled="_saving">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                        }
                        Kaydet
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
}
