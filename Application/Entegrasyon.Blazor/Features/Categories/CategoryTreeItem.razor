@using Entegrasyon.Entity.Categories

<div class="category-tree-item">
    <div class="d-flex align-center category-item-row"
         @onclick="ToggleExpanded"
         style="cursor: pointer; padding: 8px; border-radius: 4px;"
         onmouseover="this.style.backgroundColor='#f5f5f5'"
         onmouseout="this.style.backgroundColor='transparent'">

        @if (HasChildren)
        {
            <MudIcon Icon="@(IsExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                     Size="Size.Small"
                     Class="mr-2" />
        }
        else
        {
            <div style="width: 20px;"></div>
        }

        <MudIcon Icon="@GetCategoryIcon()"
                 Size="Size.Small"
                 Color="@GetCategoryIconColor()"
                 Class="mr-2" />

        <MudText>@Category.Name</MudText>

        @if (Category.IsFavorite)
        {
            <MudIcon Icon="@Icons.Material.Filled.Star"
                     Size="Size.Small"
                     Color="Color.Warning"
                     Class="ml-auto" />
        }
    </div>

    @if (IsExpanded && Children?.Any() == true)
    {
        <div class="category-children" style="margin-left: 20px;">
            @foreach (var child in Children)
            {
                <CategoryTreeItem @key="child.Id" Category="child"
                                  AllCategories="AllCategories"
                                  OnCategorySelected="OnCategorySelected" />
            }
        </div>
    }
</div>

