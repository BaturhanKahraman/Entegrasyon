@using Entegrasyon.Entity.Dtos.MasterCatalog

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
            İçe Aktarma Tamamlandı
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudList T="string" Dense="true">
            <MudListItem T="string" Icon="@Icons.Material.Filled.Folder">
                <MudText>
                    <strong>Kategoriler:</strong>
                    @Result.CategoriesImported eklendi
                    @if (Result.CategoriesSkipped > 0)
                    {
                        <span class="mud-text-secondary">, @Result.CategoriesSkipped atlandı (zaten mevcut)</span>
                    }
                </MudText>
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Tune">
                <MudText>
                    <strong>Özellikler:</strong>
                    @Result.AttributesImported eklendi
                    @if (Result.AttributesSkipped > 0)
                    {
                        <span class="mud-text-secondary">, @Result.AttributesSkipped atlandı</span>
                    }
                </MudText>
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.List">
                <MudText>
                    <strong>Değerler:</strong>
                    @Result.ValuesImported eklendi
                    @if (Result.ValuesSkipped > 0)
                    {
                        <span class="mud-text-secondary">, @Result.ValuesSkipped atlandı</span>
                    }
                </MudText>
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Link">
                <MudText>
                    <strong>Marketplace Eşleştirmeleri:</strong>
                    @Result.MappingsImported eklendi
                </MudText>
            </MudListItem>
            @if (Result.BrandsImported > 0 || Result.BrandsSkipped > 0)
            {
                <MudListItem T="string" Icon="@Icons.Material.Filled.Sell">
                    <MudText>
                        <strong>Markalar:</strong>
                        @Result.BrandsImported eklendi
                        @if (Result.BrandsSkipped > 0)
                        {
                            <span class="mud-text-secondary">, @Result.BrandsSkipped atlandı (zaten mevcut)</span>
                        }
                    </MudText>
                </MudListItem>
            }
        </MudList>

        @if (Result.TotalSkipped > 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                @Result.TotalSkipped kayıt zaten mevcut olduğu için atlandı.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Kapat</MudButton>
    </DialogActions>
</MudDialog>
