@using Entegrasyon.Entity.Dtos.MasterCatalog

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Download" Class="mr-2" />
            Master Catalog'dan İçe Aktar
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Class="d-block mx-auto my-4" />
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" @bind-ActivePanelIndex="_activeTab">
                <MudTabPanel Text="Sektör Paketleri" Icon="@Icons.Material.Filled.Category">
                    @if (_sectorPackages.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">Henüz sektör paketi tanımlanmamış.</MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-3 mt-2">
                            Sektörünüze uygun paketi seçin — ilgili tüm kategoriler tek tıkla içe aktarılır.
                        </MudText>
                        <MudGrid>
                            @foreach (var package in _sectorPackages)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudCard Outlined="true"
                                             Class="@($"cursor-pointer {(_selectedPackageId == package.Id ? "mud-border-primary" : "")}")"
                                             @onclick="() => SelectPackage(package.Id)">
                                        <MudCardContent>
                                            <div class="d-flex align-center gap-2">
                                                <MudCheckBox T="bool"
                                                             Value="@(_selectedPackageId == package.Id)"
                                                             Color="Color.Primary"
                                                             ValueChanged="@(_ => SelectPackage(package.Id))" />
                                                <div>
                                                    <MudText Typo="Typo.subtitle1">@package.Name</MudText>
                                                    @if (!string.IsNullOrEmpty(package.Description))
                                                    {
                                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@package.Description</MudText>
                                                    }
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                        @package.CategoryCount kategori
                                                    </MudText>
                                                </div>
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Özel Seçim" Icon="@Icons.Material.Filled.AccountTree">
                    <MudText Typo="Typo.body2" Class="mb-3 mt-2">
                        İçe aktarmak istediğiniz yaprak kategorileri seçin.
                    </MudText>
                    @if (_flatLeafCategories.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">Master catalog boş.</MudAlert>
                    }
                    else
                    {
                        <div style="max-height: 350px; overflow-y: auto;">
                            @foreach (var cat in _flatLeafCategories)
                            {
                                <div class="d-flex align-center">
                                    <MudCheckBox T="bool"
                                                 Value="@_selectedCategoryIds.Contains(cat.Id)"
                                                 ValueChanged="@(v => ToggleCategory(cat.Id, v))"
                                                 Dense="true" />
                                    <MudText Typo="Typo.body2">@cat.FullPath</MudText>
                                </div>
                            }
                        </div>
                    }
                </MudTabPanel>
            </MudTabs>

            <MudDivider Class="mt-3 mb-2" />
            <div class="d-flex align-center gap-2">
                <MudCheckBox T="bool" @bind-Value="_importBrands" Color="Color.Primary" Dense="true" />
                <div>
                    <MudText Typo="Typo.body2"><strong>Markaları da içe aktar</strong></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Master catalog'daki tüm aktif markalar ve Trendyol eşleştirmeleri aktarılır.
                    </MudText>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Import"
                   Disabled="@(_loading || (!HasSelection && !_importBrands))">
            @if (_importing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            İçe Aktar
        </MudButton>
    </DialogActions>
</MudDialog>
