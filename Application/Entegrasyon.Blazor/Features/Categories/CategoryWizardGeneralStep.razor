@using Entegrasyon.Entity.Categories

<MudForm @ref="_form" @bind-IsValid="_isValid">
    <MudTextField T="string"
                  Value="Name"
                  ValueChanged="@((string v) => { Name = v; NameChanged.InvokeAsync(v); OnFieldChanged.InvokeAsync(); })"
                  Label="Kategori Adı"
                  Required="true"
                  RequiredError="Kategori adı gerekli"
                  Immediate="true"
                  Class="mb-3" />

    <MudSelect T="int?"
               Value="ParentCategoryId"
               ValueChanged="@((int? v) => { ParentCategoryId = v; ParentCategoryIdChanged.InvokeAsync(v); OnFieldChanged.InvokeAsync(); })"
               Label="Üst Kategori (Opsiyonel)"
               Clearable="true"
               Class="mb-3">
        <MudSelectItem Value="@((int?)null)">— Seçilmedi —</MudSelectItem>
        @foreach (var cat in _availableCategories)
        {
            <MudSelectItem @key="cat.Id" Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
        Yalnızca özellik veya pazar yeri eşleştirmesi içermeyen kategoriler üst kategori olabilir.
    </MudText>

    <MudCheckBox Value="IsFavorite"
                 ValueChanged="@((bool v) => { IsFavorite = v; IsFavoriteChanged.InvokeAsync(v); OnFieldChanged.InvokeAsync(); })"
                 Label="Favori Kategori"
                 Color="Color.Warning"
                 Class="mb-3" />

    <MudSelect T="decimal?"
               Value="DefaultVatRate"
               ValueChanged="@((decimal? v) => { DefaultVatRate = v; DefaultVatRateChanged.InvokeAsync(v); OnFieldChanged.InvokeAsync(); })"
               Label="Varsayılan KDV Oranı"
               Clearable="true"
               Variant="Variant.Outlined"
               Class="mb-3">
        <MudSelectItem Value="@((decimal?)1)">%1</MudSelectItem>
        <MudSelectItem Value="@((decimal?)10)">%10</MudSelectItem>
        <MudSelectItem Value="@((decimal?)20)">%20</MudSelectItem>
    </MudSelect>
</MudForm>
