@using Entegrasyon.Entity.Dtos.Marketplace

<MudStack Spacing="3">
    @if (!string.IsNullOrEmpty(CategoryName))
    {
        <MudAlert Severity="Severity.Normal" Dense="true" Icon="@Icons.Material.Filled.Category">
            Kategori: <strong>@CategoryName</strong>
        </MudAlert>
    }

    <MudAlert Severity="Severity.Info" Dense="true">
        Bu adım opsiyoneldir. Kategorinizi bir pazar yeri kategorisiyle eşleştirmek isterseniz aşağıdan seçim yapabilirsiniz.
    </MudAlert>

    @if (_existingMappings.Count > 0)
    {
        <MudText Typo="Typo.subtitle2">Mevcut Eşleştirmeler</MudText>
        <MudTable Items="_existingMappings.AsEnumerable()" Dense="true" Hover="true" Outlined="true">
            <HeaderContent>
                <MudTh>Pazar Yeri</MudTh>
                <MudTh>Eşleştirilen Kategori ID</MudTh>
            </HeaderContent>
            <RowTemplate Context="mapping">
                <MudTd>@(_marketplaces.FirstOrDefault(m => m.Id == mapping.MarketPlaceId)?.Name ?? mapping.MarketPlaceId.ToString())</MudTd>
                <MudTd>@mapping.MarketPlaceCategoryId</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudSelect T="int?"
               Value="SelectedMarketplaceId"
               ValueChanged="OnMarketplaceChanged"
               Label="Pazar Yeri Seç"
               Clearable="true"
               Variant="Variant.Outlined">
        <MudSelectItem Value="@((int?)null)">— Seçilmedi —</MudSelectItem>
        @foreach (var mp in _marketplaces)
        {
            <MudSelectItem @key="mp.Id" Value="@((int?)mp.Id)">@mp.Name</MudSelectItem>
        }
    </MudSelect>

    @if (SelectedMarketplaceId.HasValue)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">Pazar yerindeki eşleşen kategoriyi arayın:</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_searchText"
                          Label="Pazar yeri kategorisi ara..."
                          Placeholder="Örn: Telefon, Giyim, Elektronik"
                          Variant="Variant.Outlined"
                          Immediate="false"
                          Class="flex-grow-1"
                          OnKeyDown="@(async (e) => { if (e.Key == "Enter") await SearchCategories(); })" />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="SearchCategories"
                       Disabled="_searching">
                @if (_searching)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Ara
            </MudButton>
        </MudStack>

        @if (_searchResults.Count > 0)
        {
            <MudList T="MarketplaceCategorySearchResult" Dense="true">
                @foreach (var result in _searchResults)
                {
                    <MudListItem @key="result.Id"
                                 T="MarketplaceCategorySearchResult"
                                 Value="result"
                                 OnClick="@(() => SelectCategory(result))"
                                 Class="@(_selectedResult?.Id == result.Id ? "mud-selected-item" : "")">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (_selectedResult?.Id == result.Id)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                            }
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@result.Name</MudText>
                                @if (!string.IsNullOrEmpty(result.FullPath))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@result.FullPath</MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
        else if (_searched && _searchResults.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">Sonuç bulunamadı.</MudAlert>
        }

        @if (_selectedResult is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true">
                Seçilen kategori: <strong>@_selectedResult.Name</strong>
                @if (!string.IsNullOrEmpty(_selectedResult.FullPath))
                {
                    <text> — @_selectedResult.FullPath</text>
                }
            </MudAlert>
        }
    }
</MudStack>
