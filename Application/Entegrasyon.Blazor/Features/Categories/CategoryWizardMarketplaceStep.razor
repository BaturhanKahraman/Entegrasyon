<MudStack Spacing="3">
    @if (!string.IsNullOrEmpty(CategoryName))
    {
        <MudAlert Severity="Severity.Normal" Dense="true" Icon="@Icons.Material.Filled.Category">
            Kategori: <strong>@CategoryName</strong>
        </MudAlert>
    }

    <MudAlert Severity="Severity.Info" Dense="true">
        Kategoriyi kaydettikten sonra pazar yeri eşleştirmesi yapabilirsiniz.
        Eşleştirme, kategorinizin pazar yerlerindeki karşılığını belirler.
    </MudAlert>

    @* Mevcut eslestirmeler *@
    @if (_existingMappings.Count > 0)
    {
        <MudText Typo="Typo.subtitle2">Mevcut Eşleştirmeler</MudText>
        <MudTable Items="_existingMappings.AsEnumerable()" Dense="true" Hover="true" Outlined="true">
            <HeaderContent>
                <MudTh>Pazar Yeri</MudTh>
                <MudTh>Eşleşen Kategori</MudTh>
            </HeaderContent>
            <RowTemplate Context="mapping">
                <MudTd>@(_marketplaces.FirstOrDefault(m => m.Id == mapping.MarketPlaceId)?.Name ?? mapping.MarketPlaceId.ToString())</MudTd>
                <MudTd>@(mapping.MarketPlaceCategoryName ?? mapping.MarketPlaceCategoryId.ToString())</MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.LinkOff">
            Bu kategori henüz hiçbir pazar yeriyle eşleştirilmemiş.
        </MudAlert>
    }

    <MudStack Spacing="1">
        <MudText Typo="Typo.subtitle2">Kategoriyi kaydedin, ardından eşleştirme sayfasına yönlendirileceksiniz.</MudText>
        <MudCheckBox @bind-Value="RedirectToMatching" T="bool"
                     Label="Kaydettikten sonra eşleştirme sayfasına git"
                     Color="Color.Primary" />
    </MudStack>
</MudStack>
