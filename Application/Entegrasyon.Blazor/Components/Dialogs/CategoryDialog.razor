@using Entegrasyon.Business.Concrete
@using Entegrasyon.Entity.Categories
@inject CategoryManager CategoryManager
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Name" 
                                  Label="Kategori Adı" 
                                  Required="true"
                                  RequiredError="Kategori adı gerekli" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_model.IsFavorite" 
                                 Label="Favori Kategori" 
                                 Color="Color.Warning" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_model.IsImported" 
                                 Label="İçe Aktarıldı" 
                                 Color="Color.Info" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="int?" 
                               @bind-Value="_model.ParentCategoryId" 
                               Label="Üst Kategori (Opsiyonel)" 
                               Clearable="true">
                        <MudSelectItem Value="@((int?)null)">Ana Kategori</MudSelectItem>
                        @foreach (var cat in _availableCategories)
                        {
                            <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mt-2">Kategori Özellikleri</MudText>
                    <MudButton OnClick="AddAttribute" 
                               StartIcon="@Icons.Material.Filled.Add" 
                               Color="Color.Primary" 
                               Size="Size.Small" 
                               Class="mb-2">
                        Özellik Ekle
                    </MudButton>
                    
                    @foreach (var (attr, index) in _model.Attributes.Select((a, i) => (a, i)))
                    {
                        <MudPaper Class="pa-2 mb-2">
                            <MudGrid>
                                <MudItem xs="5">
                                    <MudTextField @bind-Value="attr.Name" 
                                                  Label="Özellik Adı" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudSelect T="string" 
                                               @bind-Value="attr.Type" 
                                               Label="Tip">
                                        <MudSelectItem Value="@("Text")">Metin</MudSelectItem>
                                        <MudSelectItem Value="@("Number")">Sayı</MudSelectItem>
                                        <MudSelectItem Value="@("Boolean")">Evet/Hayır</MudSelectItem>
                                        <MudSelectItem Value="@("List")">Liste</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudCheckBox @bind-Value="attr.IsRequired" 
                                                 Label="Zorunlu" />
                                </MudItem>
                                <MudItem xs="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   Color="Color.Error" 
                                                   OnClick="@(() => RemoveAttribute(index))" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudItem>

                @if (!IsEditMode)
                {
                    <MudItem xs="12">
                        <MudFileUpload T="IBrowserFile" 
                                       FilesChanged="OnFileChanged" 
                                       Accept=".jpg,.jpeg,.png">
                            <ButtonTemplate>
                                <MudButton HtmlTag="label"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           for="@context.Id">
                                    Kategori Görseli Yükle
                                </MudButton>
                            </ButtonTemplate>
                        </MudFileUpload>
                        @if (_selectedFile != null)
                        {
                            <MudChip Color="Color.Success" 
                                     Size="Size.Small" 
                                     OnClose="ClearFile" 
                                     Class="mt-2">
                                @_selectedFile.Name
                            </MudChip>
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit"
                   Disabled="@(!_isValid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                @(IsEditMode ? "Güncelle" : "Kaydet")
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Category? Category { get; set; }
    [Parameter] public bool IsEditMode { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _saving;
    private CategoryFormModel _model = new();
    private List<Category> _availableCategories = new();
    private IBrowserFile? _selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        
        if (IsEditMode && Category != null)
        {
            _model = new CategoryFormModel
            {
                Id = Category.Id,
                Name = Category.Name,
                IsFavorite = Category.IsFavorite,
                IsImported = Category.IsImported,
                ParentCategoryId = Category.SuperCategoryId,
                Attributes = Category.CategoryAttributes?.Select(a => new AttributeModel
                {
                    Name = a.CategoryAttribute?.CategoryAttributeHumanized ?? string.Empty,
                    Type = "Text",
                    IsRequired = false
                }).ToList() ?? new List<AttributeModel>()
            };
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            // TODO: Load categories excluding current one if editing
            _availableCategories = new List<Category>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kategoriler yüklenirken hata: {ex.Message}", Severity.Error);
        }
    }

    private void AddAttribute()
    {
        _model.Attributes.Add(new AttributeModel
        {
            Name = string.Empty,
            Type = "Text",
            IsRequired = false
        });
    }

    private void RemoveAttribute(int index)
    {
        _model.Attributes.RemoveAt(index);
    }

    private void OnFileChanged(IBrowserFile file)
    {
        _selectedFile = file;
    }

    private void ClearFile()
    {
        _selectedFile = null;
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        _saving = true;
        try
        {
            // TODO: Implement save logic with CategoryManager
            if (IsEditMode)
            {
                Snackbar.Add("Kategori güncellendi", Severity.Success);
            }
            else
            {
                Snackbar.Add("Kategori eklendi", Severity.Success);
            }
            
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class CategoryFormModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsFavorite { get; set; }
        public bool IsImported { get; set; }
        public int? ParentCategoryId { get; set; }
        public List<AttributeModel> Attributes { get; set; } = new();
    }

    private class AttributeModel
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = "Text";
        public bool IsRequired { get; set; }
    }
}
