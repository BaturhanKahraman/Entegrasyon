@using MudBlazor

<PageTitle>Erisim Engellendi</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center" Style="min-height: 60vh;">
    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Style="font-size: 5rem;" Class="mb-4" />
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">
        Erisim Yetkiniz Yok
    </MudText>
    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-6">
        Bu sayfayi goruntulemek icin gerekli yetkiye sahip degilsiniz.
        Yetki gereksinimi oldugunu dusunuyorsaniz yoneticinizle iletisime gecin.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Home">
        Ana Sayfaya Don
    </MudButton>
</MudContainer>
