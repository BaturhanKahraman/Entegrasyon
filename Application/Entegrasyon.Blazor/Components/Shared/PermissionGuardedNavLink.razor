@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

@if (_hasPermission)
{
    <MudNavLink Href="@Href" Match="@Match" Icon="@Icon">
        @Title
    </MudNavLink>
}
else if (ShowWhenDisabled)
{
    <div @onclick="OnDisabledClick" style="cursor:pointer">
        <MudNavLink Icon="@Icon" Disabled="true">
            @Title
        </MudNavLink>
    </div>
}
