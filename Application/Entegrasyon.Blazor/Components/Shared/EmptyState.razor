@if (!IsEmpty)
{
    <MudPaper Class="pa-8 text-center" Elevation="0">
        <MudIcon Icon="@Icon" Size="Size.Large" Color="@IconColor" Class="mb-4" />
        <MudText Typo="Typo.h6" GutterBottom="true">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@Message</MudText>
        
        @if (ActionText != null && OnAction.HasDelegate)
        {
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@ActionIcon"
                       OnClick="OnAction">
                @ActionText
            </MudButton>
        }
    </MudPaper>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string Title { get; set; } = "Veri Bulunamadı";
    [Parameter] public string Message { get; set; } = "Henüz kayıt bulunmamaktadır";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.SearchOff;
    [Parameter] public Color IconColor { get; set; } = Color.Secondary;
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string ActionIcon { get; set; } = Icons.Material.Filled.Add;
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
