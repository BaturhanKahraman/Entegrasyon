@if (Show)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudBreadcrumbs Items="@Items" Separator=">">
            <ItemTemplate Context="item">
                @if (item.Href != null)
                {
                    <MudLink Href="@item.Href" Color="Color.Inherit">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <MudIcon Icon="@item.Icon" Size="Size.Small" Class="mr-1" />
                        }
                        @item.Text
                    </MudLink>
                }
                else
                {
                    <MudText>
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <MudIcon Icon="@item.Icon" Size="Size.Small" Class="mr-1" />
                        }
                        @item.Text
                    </MudText>
                }
            </ItemTemplate>
        </MudBreadcrumbs>
    </MudPaper>
}

@code {
    [Parameter] public bool Show { get; set; } = true;
    [Parameter] public List<BreadcrumbItem> Items { get; set; } = new();
}
