@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" />
            Bu Ozellik Paketinize Dahil Degil
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            <strong>@FeatureName</strong> ozelligi mevcut paketinizde bulunmamaktadir.
            Bu ozelligi kullanabilmek icin paketinizi yukseltmeniz gerekmektedir.
        </MudText>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            Paket yukseltme hakkinda detayli bilgi icin yoneticinizle iletisime gecin.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Kapat</MudButton>
    </DialogActions>
</MudDialog>
