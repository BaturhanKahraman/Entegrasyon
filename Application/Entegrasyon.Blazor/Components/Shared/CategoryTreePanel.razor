@using Entegrasyon.Entity.Categories

<MudPaper Class="pa-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">Kategori Ağacı</MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Download"
                       Size="Size.Small"
                       OnClick="OnImportClicked">
                İçe Aktar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Small"
                       OnClick="OnAddClicked">
                Yeni
            </MudButton>
        </div>
    </div>

    <MudTextField @bind-Value="SearchString"
                  Placeholder="Kategori ara..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-4" />

    @if (Loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (TreeItems?.Any() == true)
    {
        <MudStack Spacing="0">
            @foreach (var item in TreeItems)
            {
                <div class="d-flex align-center justify-space-between pa-2 cursor-pointer"
                     @onclick="() => OnCategorySelectedInternal(item)">
                    <MudText>@item.Name</MudText>
                    @if (item.IsFavorite)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                    }
                </div>
                @if (item.SubCategories?.Any() == true)
                {
                    <div style="margin-left: 20px;">
                        @foreach (var subItem in item.SubCategories)
                        {
                            <div class="d-flex align-center justify-space-between pa-2 cursor-pointer"
                                 @onclick="() => OnCategorySelectedInternal(subItem)">
                                <MudText>→ @subItem.Name</MudText>
                            </div>
                        }
                    </div>
                }
            }
        </MudStack>
    }
    else
    {
        <MudText Align="Align.Center" Color="Color.Secondary">Kategori bulunamadı</MudText>
    }
</MudPaper>

@code {
    [Parameter] public List<Category>? TreeItems { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string SearchString { get; set; } = string.Empty;
    [Parameter] public EventCallback<Category> CategorySelected { get; set; }
    [Parameter] public EventCallback OnAddClicked { get; set; }
    [Parameter] public EventCallback OnImportClicked { get; set; }
    [Parameter] public EventCallback<string> FilterChanged { get; set; }

    private Task OnCategorySelectedInternal(Category item)
    {
        return CategorySelected.InvokeAsync(item);
    }
}
