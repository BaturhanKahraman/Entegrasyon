@using Entegrasyon.ApplicationBootstrap.Security
<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Ana Sayfa
    </MudNavLink>

    <MudDivider Class="my-2" />

    <MudNavGroup Title="Yönetim" Icon="@Icons.Material.Filled.Business" Expanded="@ExpandedSections["admin"]">
        <AuthorizeView Policy="@AppPermissions.Products.View">
            <Authorized>
                <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory">
                    Ürünler
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">
            Kategoriler
        </MudNavLink>
        <MudNavLink Href="/attributes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tune">
            Özellikler
        </MudNavLink>
        <MudNavLink Href="/brands" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Label">
            Markalar
        </MudNavLink>
        <MudNavLink Href="/pos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PointOfSale">
            POS Terminal
        </MudNavLink>
        <MudNavLink Href="/sales" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
            Satis Gecmisi
        </MudNavLink>
        <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
            Satışlar ve Siparişler
        </MudNavLink>
        <MudNavLink Href="/shipping" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalShipping">
            Kargo Takip
        </MudNavLink>
        <MudNavLink Href="/bulk-operations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.UploadFile">
            Toplu İşlem
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Pazaryeri" Icon="@Icons.Material.Filled.Store" Expanded="@ExpandedSections["marketplace"]">
        <MudNavLink Href="/matched-entities" Icon="@Icons.Material.Filled.AutoFixHigh">
            Hazır Şablonlar
        </MudNavLink>
        <MudNavGroup Title="Senkronizasyon" Icon="@Icons.Material.Filled.Sync" Expanded="@_syncExpanded">
            <MudNavLink Href="/marketplace/sync" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Genel Bakış
            </MudNavLink>
            <MudNavLink Href="/marketplace/sync/categories" Icon="@Icons.Material.Filled.Category">
                Kategori Eşleştirme
            </MudNavLink>
            <MudNavLink Href="/marketplace/sync/attributes" Icon="@Icons.Material.Filled.Tune">
                Özellik Eşleştirme
            </MudNavLink>
            <MudNavLink Href="/marketplace/sync/brands" Icon="@Icons.Material.Filled.Label">
                Marka Eşleştirme
            </MudNavLink>
        </MudNavGroup>
        <MudNavLink Href="/marketplace/commission-rates" Icon="@Icons.Material.Filled.Percent">
            Komisyon Oranları
        </MudNavLink>
        <MudNavLink Href="/marketplace/matching" Icon="@Icons.Material.Filled.Link">
            Ürün Eşleştirme
        </MudNavLink>
        <MudNavLink Href="/marketplace/orders" Icon="@Icons.Material.Filled.ShoppingBag">
            Siparişler
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Müşteriler" Icon="@Icons.Material.Filled.People" Expanded="@ExpandedSections["customers"]">
        <AuthorizeView Policy="@AppPermissions.Customers.View">
            <Authorized>
                <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.Person">
                    Müşteriler
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="/invoices" Icon="@Icons.Material.Filled.Description">
            Faturalar
        </MudNavLink>
        <MudNavLink Href="/invoicing" Icon="@Icons.Material.Filled.ReceiptLong">
            E-Fatura
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Raporlar" Icon="@Icons.Material.Filled.Assessment" Expanded="@ExpandedSections["reports"]">
        <MudNavLink Href="/reports/sales" Icon="@Icons.Material.Filled.TrendingUp">
            Satış Raporları
        </MudNavLink>
        <MudNavLink Href="/reports/profit-loss" Icon="@Icons.Material.Filled.AccountBalance">
            Kar/Zarar Raporu
        </MudNavLink>
        <MudNavLink Href="/reports/product-performance" Icon="@Icons.Material.Filled.Speed">
            Ürün Performansı
        </MudNavLink>
        <MudNavLink Href="/reports/stock-alerts" Icon="@Icons.Material.Filled.NotificationImportant">
            Stok Uyarıları
        </MudNavLink>
        <MudNavLink Href="/reports/inventory" Icon="@Icons.Material.Filled.Warehouse">
            Stok Raporları
        </MudNavLink>
        <MudNavLink Href="/reports/marketplace" Icon="@Icons.Material.Filled.Analytics">
            Pazaryeri Raporları
        </MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    <AuthorizeView Policy="@AppPermissions.Users.View">
        <Authorized>
            <MudNavGroup Title="Kullanıcı Yönetimi" Icon="@Icons.Material.Filled.SupervisedUserCircle" Expanded="@ExpandedSections["users"]">
                <AuthorizeView Policy="@AppPermissions.Users.View" Context="userContext">
                    <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
                        Kullanıcılar
                    </MudNavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@AppPermissions.Roles.View" Context="roleContext">
                    <MudNavLink Href="/roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security">
                        Roller
                    </MudNavLink>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <MudNavGroup Title="Magaza" Icon="@Icons.Material.Filled.Storefront" Expanded="@ExpandedSections["storefront"]">
        <MudNavLink Href="/settings/storefront" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Settings">
            Magaza Ayarlari
        </MudNavLink>
        <MudNavLink Href="/settings/storefront/legal" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Gavel">
            Yasal Metinler
        </MudNavLink>
        <MudNavLink Href="/settings/storefront/banners" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewCarousel">
            Banner Yonetimi
        </MudNavLink>
        <MudNavLink Href="/settings/storefront/payment" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Payment">
            Odeme Ayarlari
        </MudNavLink>
        <MudNavLink Href="/storefront/reviews" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Reviews">
            Degerlendirmeler
        </MudNavLink>
        <MudNavLink Href="/storefront/messages" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ContactMail">
            Iletisim Mesajlari
        </MudNavLink>
        <MudNavLink Href="/storefront/newsletter" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Email">
            Bulten Aboneleri
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Ayarlar" Icon="@Icons.Material.Filled.Settings" Expanded="@ExpandedSections["settings"]">
        <MudNavLink Href="/settings/general" Icon="@Icons.Material.Filled.Tune">
            Genel Ayarlar
        </MudNavLink>
        <MudNavLink Href="/settings/notifications" Icon="@Icons.Material.Filled.NotificationsActive">
            Bildirimler
        </MudNavLink>
        <MudNavLink Href="/settings/integrations" Icon="@Icons.Material.Filled.Extension">
            Entegrasyonlar
        </MudNavLink>
        <MudNavLink Href="/settings/printing" Icon="@Icons.Material.Filled.Print">
            Yazıcı & Barkod
        </MudNavLink>
        <MudNavLink Href="/settings/desktop" Icon="@Icons.Material.Filled.DesktopWindows">
            Masaüstü Uygulama
        </MudNavLink>
    </MudNavGroup>
</MudNavMenu>
