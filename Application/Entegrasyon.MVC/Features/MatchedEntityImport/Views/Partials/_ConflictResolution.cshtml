@using Entegrasyon.Entity.Dtos.Templates
@using Entegrasyon.MVC.Features.MatchedEntityImport
@model ConflictCheckVm

@{
    string ConflictTypeLabel(ConflictType type) => type switch
    {
        ConflictType.NameMatch => "İsim Eşleşmesi",
        ConflictType.ExternalIdMatch => "Dış ID Eşleşmesi",
        ConflictType.Both => "İsim + Dış ID Eşleşmesi",
        _ => type.ToString()
    };
}

<div class="modal-header">
    @if (Model.Conflicts.Count > 0)
    {
        <h5 class="modal-title">
            <i class="ti ti-alert-triangle text-warning me-1"></i>
            Çakışma Tespit Edildi (@Model.Conflicts.Count)
        </h5>
    }
    else
    {
        <h5 class="modal-title">
            <i class="ti ti-circle-check text-success me-1"></i>
            Çakışma Yok
        </h5>
    }
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

@if (Model.Conflicts.Count > 0)
{
    <form hx-post="/matched-entities/@Model.PackageId/import"
          hx-swap="none">
        <div class="modal-body">
            <div class="alert alert-warning mb-3">
                <p class="mb-0">
                    Sisteminizde bu paketle eşleşen varlıklar bulundu.
                    Her çakışma için bir strateji seçin:
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter table-hover table-sm card-table">
                    <thead>
                        <tr>
                            <th>Tür</th>
                            <th>Paketteki</th>
                            <th>Sistemdeki</th>
                            <th>Çakışma</th>
                            <th>Strateji</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Conflicts.Count; i++)
                        {
                            var conflict = Model.Conflicts[i];
                            <tr>
                                <td>
                                    <span class="badge bg-secondary-lt">@conflict.EntityType</span>
                                </td>
                                <td><strong>@conflict.TemplateName</strong></td>
                                <td>
                                    @conflict.ExistingEntityName
                                    <small class="text-secondary">(#@conflict.ExistingEntityId)</small>
                                </td>
                                <td>
                                    <span class="badge bg-warning-lt">@ConflictTypeLabel(conflict.ConflictType)</span>
                                </td>
                                <td>
                                    <input type="hidden" name="Resolutions[@i].TemplateEntityId" value="@conflict.TemplateEntityId" />
                                    <input type="hidden" name="Resolutions[@i].ExistingEntityId" value="@conflict.ExistingEntityId" />
                                    <select class="form-select form-select-sm" name="Resolutions[@i].Strategy" required>
                                        <option value="UseExisting">Mevcut Koru</option>
                                        <option value="UseImported">Pakettekini Kullan</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">İptal</button>
            <button type="submit" class="btn btn-warning">
                <i class="ti ti-download"></i>
                Çakışmaları Çözümle ve Aktar
            </button>
        </div>
    </form>
}
else
{
    <div class="modal-body">
        <div class="alert alert-success mb-0">
            <p class="mb-0">
                Bu paket mevcut verilerinizle çakışmıyor. Güvenle import edebilirsiniz.
            </p>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn me-auto" data-bs-dismiss="modal">İptal</button>
        <button class="btn btn-primary"
                hx-post="/matched-entities/@Model.PackageId/import"
                hx-swap="none">
            <i class="ti ti-download"></i>
            Paketi Aktar
        </button>
    </div>
}
