@using Entegrasyon.Entity.Dtos.Templates
@model List<MatchedEntityPackageDto>

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="page-pretitle">Yonetim</div>
                <h2 class="page-title">Eslestirilmis Varlik Aktarimi</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Mevcut Paketler</h3>
            </div>
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Paket Adi</th>
                                <th>Tur</th>
                                <th>Durum</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pkg in Model)
                            {
                                <tr>
                                    <td>@pkg.Name</td>
                                    <td><span class="badge">@pkg.EntityType</span></td>
                                    <td><span class="badge bg-green-lt">Yayinda</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" disabled>Aktar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-center py-5">
                    <h3 class="text-secondary">Henuz paket bulunmamaktadir</h3>
                    <p class="text-secondary">Eslestirilmis varlik paketleri burada listelenecektir.</p>
                </div>
            }
        </div>
    </div>
</div>
