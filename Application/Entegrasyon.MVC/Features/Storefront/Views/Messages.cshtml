@model Entegrasyon.MVC.Features.Storefront.ViewModels.MessagesVm

        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "contact" ? "active" : "")"
                           href="/storefront/messages?tab=contact">
                            Iletisim Mesajlari
                            @if (Model.ContactMessages.Count(m => !m.IsRead) > 0)
                            {
                                <span class="badge bg-red ms-1">@Model.ContactMessages.Count(m => !m.IsRead)</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "qna" ? "active" : "")"
                           href="/storefront/messages?tab=qna">
                            Ürün Sorulari
                            @if (Model.UnansweredQuestions.Count > 0)
                            {
                                <span class="badge bg-secondary-lt ms-1">@Model.UnansweredQuestions.Count</span>
                            }
                        </a>
                    </li>
                </ul>
            </div>

            @if (Model.ActiveTab == "contact")
            {
                @if (Model.ContactMessages.Count == 0)
                {
                    <div class="card-body text-center py-5">
                        <h3 class="text-secondary">Henüz mesaj yok</h3>
                        <p class="text-secondary">Müşterilerden gelen iletisim mesajlari burada gorunecektir.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover">
                            <thead>
                                <tr>
                                    <th>Durum</th>
                                    <th>Gonderen</th>
                                    <th>E-posta</th>
                                    <th>Telefon</th>
                                    <th>Konu</th>
                                    <th>Mesaj</th>
                                    <th>Tarih</th>
                                    <th>Islem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var msg in Model.ContactMessages.OrderByDescending(m => m.CreatedAt))
                                {
                                    <tr class="@(!msg.IsRead ? "fw-bold" : "")">
                                        <td>
                                            @if (!msg.IsRead)
                                            {
                                                <span class="badge bg-secondary-lt">Yeni</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Okundu</span>
                                            }
                                        </td>
                                        <td>@msg.Name</td>
                                        <td>
                                            <a href="mailto:@msg.Email">@msg.Email</a>
                                        </td>
                                        <td>@(msg.Phone ?? "-")</td>
                                        <td>@(msg.Subject ?? "-")</td>
                                        <td>
                                            <span title="@msg.Message">
                                                @(msg.Message.Length > 60 ? msg.Message[..60] + "..." : msg.Message)
                                            </span>
                                        </td>
                                        <td>@msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            @if (!msg.IsRead)
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        hx-post="/storefront/messages/@msg.Id/read"
                                                        hx-swap="none">
                                                    Okundu
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (Model.UnansweredQuestions.Count == 0)
                {
                    <div class="card-body text-center py-5">
                        <h3 class="text-secondary">Cevaplanmamis soru yok</h3>
                        <p class="text-secondary">Tum ürün sorulari yanitlanmis durumda.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var q in Model.UnansweredQuestions.OrderByDescending(x => x.CreatedAt))
                        {
                            <div class="list-group-item">
                                <div class="row align-items-center">
                                    <div class="col-auto">
                                        <span class="avatar bg-blue-lt">
                                            <i class="ti ti-message"></i>
                                        </span>
                                    </div>
                                    <div class="col">
                                        <div class="text-truncate">
                                            <strong>Soru:</strong> @q.QuestionText
                                        </div>
                                        <div class="text-secondary small">
                                            Müşteri #@q.CustomerId &middot; @q.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <form hx-post="/storefront/questions/@q.Id/answer" hx-swap="none"
                                              class="d-flex gap-2">
                                            <input type="text" name="answer" class="form-control form-control-sm"
                                                   placeholder="Yanitiniz..." required style="min-width: 250px;" />
                                            <button type="submit" class="btn btn-sm btn-primary">Yanitla</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
