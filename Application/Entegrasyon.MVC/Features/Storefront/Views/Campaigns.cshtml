@model Entegrasyon.MVC.Features.Storefront.ViewModels.CampaignsVm

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCampaignModal">
        <i class="ti ti-plus"></i>
        Yeni Kampanya
    </button>
</div>

        <div class="card">
            @if (Model.Campaigns.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <div class="mb-3">
                        <i class="ti ti-speakerphone icon-lg text-secondary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h3 class="text-secondary">Henüz kampanya olusturulmamis</h3>
                    <p class="text-secondary">Yeni bir e-posta kampanyasi olusturarak musterilerinize ulasin.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Konu</th>
                                <th>Hedef Kitle</th>
                                <th>Durum</th>
                                <th>Alici</th>
                                <th>Gonderilen</th>
                                <th>Acilma</th>
                                <th>Zamanlandi</th>
                                <th>Islemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Campaigns)
                            {
                                <tr>
                                    <td>@c.Subject</td>
                                    <td>
                                        @(c.Target switch
                                        {
                                            CampaignTarget.AllSubscribers => "Tum Aboneler",
                                            CampaignTarget.AllCustomers => "Tum Müşteriler",
                                            CampaignTarget.ActiveCustomers => "Aktif Müşteriler",
                                            _ => c.Target.ToString()
                                        })
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = c.Status switch
                                            {
                                                CampaignStatus.Draft => "bg-secondary",
                                                CampaignStatus.Scheduled => "bg-info",
                                                CampaignStatus.Sending => "bg-warning",
                                                CampaignStatus.Sent => "bg-success",
                                                CampaignStatus.Cancelled => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            var statusText = c.Status switch
                                            {
                                                CampaignStatus.Draft => "Taslak",
                                                CampaignStatus.Scheduled => "Zamanlandi",
                                                CampaignStatus.Sending => "Gonderiliyor",
                                                CampaignStatus.Sent => "Gonderildi",
                                                CampaignStatus.Cancelled => "Iptal",
                                                _ => c.Status.ToString()
                                            };
                                        }
                                        <span class="badge @statusClass">@statusText</span>
                                    </td>
                                    <td>@c.TotalRecipients</td>
                                    <td>@c.SentCount</td>
                                    <td>
                                        @if (c.SentCount > 0)
                                        {
                                            var rate = (double)c.OpenedCount / c.SentCount * 100;
                                            <span>%@rate.ToString("F1")</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.ScheduledAt.HasValue)
                                        {
                                            @c.ScheduledAt.Value.ToString("dd.MM.yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.Status == CampaignStatus.Draft)
                                        {
                                            <div class="btn-list">
                                                <button class="btn btn-sm btn-outline-primary"
                                                        hx-post="/storefront/campaigns/@c.Id/schedule"
                                                        hx-vals='{"scheduleAt": "@DateTimeOffset.UtcNow.AddHours(1).ToString("o")"}'
                                                        hx-confirm="Kampanya 1 saat sonra gonderilecek. Onayliyor musunuz?">
                                                    Zamanla
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        hx-delete="/storefront/campaigns/@c.Id"
                                                        hx-confirm="Kampanyayi silmek istediginizden emin misiniz?">
                                                    Sil
                                                </button>
                                            </div>
                                        }
                                        else if (c.Status == CampaignStatus.Scheduled)
                                        {
                                            <button class="btn btn-sm btn-outline-warning"
                                                    hx-post="/storefront/campaigns/@c.Id/cancel"
                                                    hx-confirm="Kampanyayi iptal etmek istediginizden emin misiniz?">
                                                Iptal Et
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Campaign Modal -->
<div class="modal modal-blur fade" id="createCampaignModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form hx-post="/storefront/campaigns" hx-swap="none">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Kampanya</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Konu</label>
                        <input type="text" name="Subject" class="form-control" required placeholder="Kampanya konusu" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Hedef Kitle</label>
                        <select name="Target" class="form-select">
                            <option value="0">Tum Aboneler</option>
                            <option value="1">Tum Müşteriler</option>
                            <option value="2">Aktif Müşteriler</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Icerik (HTML)</label>
                        <textarea name="HtmlContent" class="form-control" rows="8" required
                                  placeholder="E-posta icerigini HTML olarak girin..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn me-auto" data-bs-dismiss="modal">Vazgec</button>
                    <button type="submit" class="btn btn-primary">Olustur</button>
                </div>
            </form>
        </div>

@using Entegrasyon.Entity.Storefront
