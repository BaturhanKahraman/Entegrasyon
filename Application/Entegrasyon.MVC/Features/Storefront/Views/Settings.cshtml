<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="page-pretitle">Magaza</div>
                <h2 class="page-title">Magaza Ayarlari</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Genel Ayarlar</h3>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Magaza Adi</label>
                        <input type="text" class="form-control" placeholder="Magaza adinizi girin" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Magaza Aciklamasi</label>
                        <textarea class="form-control" rows="3" placeholder="Magaza aciklamasi"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Iletisim E-posta</label>
                        <input type="email" class="form-control" placeholder="info@example.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Iletisim Telefon</label>
                        <input type="tel" class="form-control" placeholder="+90 5xx xxx xx xx" />
                    </div>
                    <button type="submit" class="btn btn-primary" disabled>Kaydet (yakin zamanda aktif olacak)</button>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="btn-list">
                    <a href="/settings/storefront/banners" class="btn btn-outline-secondary">Banner Yonetimi</a>
                    <a href="/storefront/campaigns" class="btn btn-outline-secondary">Kampanyalar</a>
                    <a href="/storefront/reviews" class="btn btn-outline-secondary">Degerlendirmeler</a>
                    <a href="/storefront/returns" class="btn btn-outline-secondary">Iadeler</a>
                </div>
            </div>
        </div>
    </div>
</div>
