@model Entegrasyon.Entity.Storefront.StorefrontSettings


        @if (Model is null)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h3 class="text-secondary">Önce Mağaza ayarlarını yapılandırın</h3>
                    <p class="text-secondary">Satıcı yönetimi için önce genel Mağaza ayarlarını kaydetmeniz gerekmektedir.</p>
                    <a href="/settings/storefront" class="btn btn-primary mt-2">Mağaza Ayarlarına Git</a>
                </div>
            </div>
        }
        else if (!Model.MarketplaceEnabled)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-building-store icon-lg text-muted mb-3" style="font-size: 2rem;"></i>
                    <h3 class="text-secondary">Marketplace modu aktif değil</h3>
                    <p class="text-secondary">
                        Satıcı yönetimi için marketplace modunun aktif olması gerekmektedir.
                        Genel ayarlardan "Marketplace Modu" seçeneğini aktif edebilirsiniz.
                    </p>
                    <a href="/settings/storefront" class="btn btn-primary mt-2">Mağaza Ayarlarına Git</a>
                </div>
            </div>
        }
        else
        {
            @* ── Marketplace Aktif — Satici Yönetimi ─────────────── *@
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Marketplace Durumu</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-green-lt me-2">Aktif</span>
                        <span class="text-secondary">Marketplace modu aktif. Satıcılar Mağaza üzerinden ürün satabilir.</span>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Satıcı Listesi</h3>
                </div>
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-users"></i>
                        </div>
                        <p class="empty-title">Henüz kayıtlı satıcı yok</p>
                        <p class="empty-subtitle text-secondary">
                            Satıcılar Mağaza üzerinden başvuru yaptığında burada listelenecektir.
                            Satıcı yönetim altyapısı geliştirme aşamasındadır.
                        </p>
                    </div>
                </div>
            </div>

            @* ── Marketplace Ayarlari Ozeti ────────────────────────── *@
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Komisyon & Ödeme Ayarları</h3>
                </div>
                <div class="card-body">
                    <div class="datagrid">
                        <div class="datagrid-item">
                            <div class="datagrid-title">Marketplace Modu</div>
                            <div class="datagrid-content">
                                <span class="badge bg-green-lt">Aktif</span>
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Satıcı Onay Süreci</div>
                            <div class="datagrid-content">Manuel Onay</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Varsayılan Komisyon</div>
                            <div class="datagrid-content">Henüz yapılandırılmadı</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Ödeme Dönemi</div>
                            <div class="datagrid-content">Henüz yapılandırılmadı</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mt-3">
            <a href="/settings/storefront" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left"></i>
                Mağaza Ayarlarına Dön
            </a>
        </div>
