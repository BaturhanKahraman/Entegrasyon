@model Entegrasyon.Entity.Storefront.StorefrontSettings


        @if (Model is null)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h3 class="text-secondary">Önce Mağaza ayarlarını yapılandırın</h3>
                    <p class="text-secondary">Yasal sayfaları düzenleyebilmek için önce genel Mağaza ayarlarını kaydetmeniz gerekmektedir.</p>
                    <a href="/settings/storefront" class="btn btn-primary mt-2">Mağaza Ayarlarına Git</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cards">
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Yasal Sayfalar</h3>
                        </div>
                        <div class="list-group list-group-flush" id="legal-nav">
                            <a href="#" class="list-group-item list-group-item-action active" data-field="AboutHtml" onclick="selectLegalPage(this, 'AboutHtml', 'Hakkımızda')">Hakkımızda</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="TermsHtml" onclick="selectLegalPage(this, 'TermsHtml', 'Kullanım Koşulları')">Kullanım Koşulları</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="PrivacyPolicyHtml" onclick="selectLegalPage(this, 'PrivacyPolicyHtml', 'Gizlilik Politikası')">Gizlilik Politikası</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="KvkkHtml" onclick="selectLegalPage(this, 'KvkkHtml', 'KVKK Aydınlatma Metni')">KVKK Aydınlatma Metni</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="CookiePolicyHtml" onclick="selectLegalPage(this, 'CookiePolicyHtml', 'Çerez Politikası')">Çerez Politikası</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="ReturnPolicyHtml" onclick="selectLegalPage(this, 'ReturnPolicyHtml', 'İade Politikası')">İade Politikası</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="DistanceSalesContractHtml" onclick="selectLegalPage(this, 'DistanceSalesContractHtml', 'Mesafeli Satış Sözleşmesi')">Mesafeli Satış Sözleşmesi</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="PreInfoFormHtml" onclick="selectLegalPage(this, 'PreInfoFormHtml', 'Ön Bilgilendirme Formu')">Ön Bilgilendirme Formu</a>
                            <a href="#" class="list-group-item list-group-item-action" data-field="DeliveryTermsHtml" onclick="selectLegalPage(this, 'DeliveryTermsHtml', 'Teslimat Koşulları')">Teslimat Koşulları</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-9">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title" id="legal-editor-title">Hakkımızda</h3>
                        </div>
                        <div class="card-body">
                            <form id="legal-form" method="post" action="/settings/storefront/legal"
                                  hx-post="/settings/storefront/legal" hx-swap="none">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fieldName" id="legal-field-name" value="AboutHtml" />
                                <div class="mb-3">
                                    <textarea name="htmlContent" id="legal-editor" class="form-control" rows="20"
                                              placeholder="HTML içerik girin...">@Model.AboutHtml</textarea>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-secondary">HTML desteklenir. Basit bir metin editörü ile içerik oluşturabilirsiniz.</small>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="ti ti-device-floppy"></i>
                                        Kaydet
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mt-3">
            <a href="/settings/storefront" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left"></i>
                Mağaza Ayarlarına Dön
            </a>
        </div>

@section Scripts {
<script>
    // Legal page content map populated from model
    var legalContents = {
        'AboutHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.AboutHtml ?? "")),
        'TermsHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.TermsHtml ?? "")),
        'PrivacyPolicyHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.PrivacyPolicyHtml ?? "")),
        'KvkkHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.KvkkHtml ?? "")),
        'CookiePolicyHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CookiePolicyHtml ?? "")),
        'ReturnPolicyHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ReturnPolicyHtml ?? "")),
        'DistanceSalesContractHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DistanceSalesContractHtml ?? "")),
        'PreInfoFormHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.PreInfoFormHtml ?? "")),
        'DeliveryTermsHtml': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.DeliveryTermsHtml ?? ""))
    };

    function selectLegalPage(el, fieldName, title) {
        event.preventDefault();
        // Save current content to map before switching
        var currentField = document.getElementById('legal-field-name').value;
        legalContents[currentField] = document.getElementById('legal-editor').value;

        // Update nav
        document.querySelectorAll('#legal-nav .list-group-item').forEach(function(item) {
            item.classList.remove('active');
        });
        el.classList.add('active');

        // Update editor
        document.getElementById('legal-editor-title').textContent = title;
        document.getElementById('legal-field-name').value = fieldName;
        document.getElementById('legal-editor').value = legalContents[fieldName] || '';
    }
</script>
}
