@model List<Entegrasyon.Entity.Storefront.StorefrontBanner>


        @* ── Yeni Banner Formu ──────────────────────────────────── *@
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Yeni Banner Ekle</h3>
            </div>
            <div class="card-body">
                <form method="post" action="/settings/storefront/banners"
                      hx-post="/settings/storefront/banners" hx-swap="none"
                      hx-on::after-request="if(event.detail.successful) this.reset()">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label required">Baslik</label>
                            <input type="text" name="Title" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label required">Görsel URL</label>
                            <input type="url" name="ImageUrl" class="form-control" required placeholder="https://..." />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Mobil Görsel URL</label>
                            <input type="url" name="MobileImageUrl" class="form-control" placeholder="https://..." />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Baglanti URL</label>
                            <input type="url" name="LinkUrl" class="form-control" placeholder="https://..." />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label required">Konum</label>
                            <select name="Position" class="form-select">
                                <option value="Hero">Hero</option>
                                <option value="Sidebar">Sidebar</option>
                                <option value="Footer">Footer</option>
                                <option value="Popup">Popup</option>
                            </select>
                        </div>
                        <div class="col-md-1 mb-3">
                            <label class="form-label">Sira</label>
                            <input type="number" name="DisplayOrder" class="form-control" value="0" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Baslangic</label>
                            <input type="date" name="StartDate" class="form-control" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Bitis</label>
                            <input type="date" name="EndDate" class="form-control" />
                        </div>
                        <div class="col-md-2 mb-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="ti ti-plus"></i>
                                Ekle
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @* ── Banner Listesi ─────────────────────────────────────── *@
        <div class="card" hx-get="/settings/storefront/banners" hx-trigger="bannersUpdated from:body" hx-select=".card table" hx-target="table" hx-swap="outerHTML">
            <div class="card-header">
                <h3 class="card-title">Bannerlar (@Model.Count)</h3>
            </div>
            @if (Model.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <p class="text-secondary">Henüz banner eklenmemis.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Baslik</th>
                                <th>Konum</th>
                                <th>Sira</th>
                                <th>Baslangic</th>
                                <th>Bitis</th>
                                <th>Durum</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var banner in Model.OrderBy(b => b.DisplayOrder))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="avatar avatar-sm me-2" style="background-image: url('@banner.ImageUrl')"></span>
                                            <div>
                                                <div class="font-weight-medium">@banner.Title</div>
                                                @if (!string.IsNullOrEmpty(banner.LinkUrl))
                                                {
                                                    <div class="text-secondary small">@banner.LinkUrl</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-blue-lt">@banner.Position</span>
                                    </td>
                                    <td>@banner.DisplayOrder</td>
                                    <td>@banner.StartDate?.ToString("dd.MM.yyyy")</td>
                                    <td>@banner.EndDate?.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (banner.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            <button class="btn btn-ghost-danger btn-sm"
                                                    hx-delete="/settings/storefront/banners/@banner.Id"
                                                    hx-confirm="Bu banneri silmek istediginize emin misiniz?"
                                                    hx-swap="none">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mt-3">
            <a href="/settings/storefront" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left"></i>
                Magaza Ayarlarina Don
            </a>
        </div>
