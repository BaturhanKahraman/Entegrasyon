@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Orders.Order>

@{
    string StatusBadge(string? status) => status switch
    {
        "Created" => "bg-blue-lt",
        "Picking" => "bg-cyan-lt",
        "Invoiced" => "bg-indigo-lt",
        "Shipped" => "bg-yellow-lt",
        "Delivered" => "bg-green-lt",
        "Cancelled" => "bg-red-lt",
        "UnDelivered" => "bg-orange-lt",
        "ReturnAccepted" => "bg-purple-lt",
        _ => "bg-secondary-lt"
    };

    string StatusText(string? status) => status switch
    {
        "Created" => "Olusturuldu",
        "Picking" => "Hazirlaniyor",
        "Invoiced" => "Fatura Kesildi",
        "Shipped" => "Kargoya Verildi",
        "Delivered" => "Teslim Edildi",
        "Cancelled" => "Iptal",
        "UnDelivered" => "Teslim Edilemedi",
        "ReturnAccepted" => "İade Onaylandı",
        _ => status ?? "-"
    };
}

<div id="order-table">
    @if (Model.HasItem)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Müşteri</th>
                        <th>Tarih</th>
                        <th>Tutar</th>
                        <th>Durum</th>
                        <th>Kargo</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Items)
                    {
                        <tr>
                            <td>
                                <a href="/marketplace/orders/@order.Id" class="text-reset">
                                    @(order.OrderNumber ?? order.Id.ToString()[..8])
                                </a>
                            </td>
                            <td class="text-secondary">
                                @order.CustomerFirstName @order.CustomerLastName
                            </td>
                            <td class="text-secondary">
                                @(order.OrderDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>
                            <td>
                                @(order.TotalPrice.ToString("N2")) TL
                            </td>
                            <td>
                                <span class="badge @StatusBadge(order.MarketplaceOrderStatus)">
                                    @StatusText(order.MarketplaceOrderStatus)
                                </span>
                            </td>
                            <td class="text-secondary">
                                @(order.CargoProviderName ?? "-")
                            </td>
                            <td>
                                <a href="/marketplace/orders/@order.Id" class="btn btn-sm btn-outline-primary">
                                    Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/orders",
                     TargetId = "#order-table",
                     QueryParams = new Dictionary<string, string>
                     {
                         ["search"] = ViewBag.Search as string ?? "",
                         ["status"] = ViewBag.Status as string ?? ""
                     }
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Sipariş bulunamadi",
                         Subtitle = "Henüz Sipariş bulunmuyor veya arama kriterinize uygun Sipariş yok."
                     }'/>
        </div>
    }
</div>
