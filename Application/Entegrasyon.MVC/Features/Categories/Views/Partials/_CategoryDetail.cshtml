@model Entegrasyon.Entity.Categories.Category
@{
    var productCount = (int)(ViewBag.ProductCount ?? 0);
    var attributes = Model.CategoryAttributes?.ToList() ?? new List<Entegrasyon.Entity.Categories.CategoryAttributeCategory>();
    var subCount = Model.SubCategories?.Count() ?? 0;
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@Model.Name</h3>
        <div class="card-actions">
            <a href="/categories/@Model.Id/edit" class="btn btn-outline-primary btn-sm">
                <i class="ti ti-pencil icon"></i>
                Duzenle
            </a>
            <button class="btn btn-outline-danger btn-sm ms-1"
                    hx-post="/categories/@Model.Id/delete"
                    hx-confirm="'@Model.Name' kategorisini silmek istediginize emin misiniz?"
                    hx-swap="none">
                <i class="ti ti-trash icon"></i>
                Sil
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="datagrid">
            <div class="datagrid-item">
                <div class="datagrid-title">Ust Kategori</div>
                <div class="datagrid-content">
                    @(Model.SuperCategory?.Name ?? "—")
                </div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Alt Kategoriler</div>
                <div class="datagrid-content">@subCount</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Urun Sayisi</div>
                <div class="datagrid-content">@productCount</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Ozellik Sayisi</div>
                <div class="datagrid-content">@attributes.Count</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Favori</div>
                <div class="datagrid-content">
                    @if (Model.IsFavorite)
                    {
                        <span class="badge bg-yellow-lt">Favori</span>
                    }
                    else
                    {
                        <span class="text-secondary">Hayir</span>
                    }
                </div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Varsayilan KDV</div>
                <div class="datagrid-content">
                    @(Model.DefaultVatRate.HasValue ? $"%{Model.DefaultVatRate.Value}" : "—")
                </div>
            </div>
        </div>

        @if (attributes.Any())
        {
            <h4 class="mt-4 mb-2">Ozellikler</h4>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Ozellik</th>
                            <th>Zorunlu</th>
                            <th>Varyanter</th>
                            <th>Dilimleyici</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attr in attributes)
                        {
                            <tr>
                                <td>@(attr.CategoryAttribute?.CategoryAttributeHumanized ?? attr.CategoryAttribute?.CategoryAttributeKey ?? "—")</td>
                                <td>
                                    @if (attr.IsRequired)
                                    {
                                        <span class="badge bg-blue-lt">Zorunlu</span>
                                    }
                                </td>
                                <td>
                                    @if (attr.IsVarianter)
                                    {
                                        <span class="badge bg-purple-lt">Varyanter</span>
                                    }
                                </td>
                                <td>
                                    @if (attr.IsSlicer)
                                    {
                                        <span class="badge bg-green-lt">Dilimleyici</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
