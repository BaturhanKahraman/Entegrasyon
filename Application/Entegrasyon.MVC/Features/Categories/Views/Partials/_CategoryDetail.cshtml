@model Entegrasyon.Entity.Categories.Category
@{
    var productCount = (int)(ViewBag.ProductCount ?? 0);
    var attributes = Model.CategoryAttributes?.ToList() ?? new List<Entegrasyon.Entity.Categories.CategoryAttributeCategory>();
    var subCount = Model.SubCategories?.Count() ?? 0;
    var parentName = Model.SuperCategory?.Name;
}

<div class="card">
    <div class="card-status-top bg-primary"></div>
    <div class="card-header">
        <div class="d-flex align-items-center">
            <span class="avatar avatar-md bg-primary-lt me-3">
                <i class="ti ti-category-2 icon"></i>
            </span>
            <div>
                <h3 class="card-title mb-0">@Model.Name</h3>
                <div class="text-secondary small">
                    @if (!string.IsNullOrEmpty(parentName))
                    {
                        <span><i class="ti ti-corner-down-right"></i> @parentName</span>
                    }
                    else
                    {
                        <span>Üst kategori (kök)</span>
                    }
                </div>
            </div>
        </div>
        <div class="card-actions">
            <a href="/categories/@Model.Id" class="btn btn-primary">
                <i class="ti ti-arrow-right icon"></i>
                Detaya Git
            </a>
        </div>
    </div>

    <div class="card-body border-bottom py-3">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="badge bg-blue-lt text-blue-lt-fg">
                <i class="ti ti-folder me-1"></i>@subCount alt kategori
            </span>
            <span class="badge bg-teal-lt text-teal-lt-fg">
                <i class="ti ti-package me-1"></i>@productCount ürün
            </span>
            <span class="badge bg-purple-lt text-purple-lt-fg">
                <i class="ti ti-list-details me-1"></i>@attributes.Count özellik
            </span>
            @if (Model.IsFavorite)
            {
                <span class="badge bg-yellow-lt text-yellow-lt-fg">
                    <i class="ti ti-star me-1"></i>Favori
                </span>
            }
        </div>
    </div>

    <div class="card-body">
        <div class="datagrid">
            <div class="datagrid-item">
                <div class="datagrid-title">Üst Kategori</div>
                <div class="datagrid-content">@(parentName ?? "—")</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Alt Kategoriler</div>
                <div class="datagrid-content">@subCount</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Ürün Sayısı</div>
                <div class="datagrid-content">@productCount</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Özellik Sayısı</div>
                <div class="datagrid-content">@attributes.Count</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Favori</div>
                <div class="datagrid-content">
                    @if (Model.IsFavorite)
                    {
                        <span class="status status-yellow">
                            <span class="status-dot"></span>
                            Evet
                        </span>
                    }
                    else
                    {
                        <span class="text-secondary">Hayır</span>
                    }
                </div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Varsayılan KDV</div>
                <div class="datagrid-content">
                    @(Model.DefaultVatRate.HasValue ? $"%{Model.DefaultVatRate.Value}" : "—")
                </div>
            </div>
        </div>
    </div>

    @if (attributes.Any())
    {
        <div class="card-header border-top">
            <h4 class="card-title mb-0">
                <i class="ti ti-list-details me-1 text-secondary"></i>Özellikler
            </h4>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Özellik</th>
                        <th class="text-center w-1">Zorunlu</th>
                        <th class="text-center w-1">Varyanter</th>
                        <th class="text-center w-1">Dilimleyici</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attr in attributes)
                    {
                        <tr>
                            <td class="fw-medium">@(attr.CategoryAttribute?.CategoryAttributeHumanized ?? attr.CategoryAttribute?.CategoryAttributeKey ?? "—")</td>
                            <td class="text-center">
                                @if (attr.IsRequired)
                                {
                                    <span class="badge bg-blue-lt text-blue-lt-fg">Zorunlu</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (attr.IsVarianter)
                                {
                                    <span class="badge bg-purple-lt text-purple-lt-fg">Varyanter</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (attr.IsSlicer)
                                {
                                    <span class="badge bg-green-lt text-green-lt-fg">Dilimleyici</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
