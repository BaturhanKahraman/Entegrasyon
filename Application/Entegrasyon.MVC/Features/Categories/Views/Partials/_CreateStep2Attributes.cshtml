@model Entegrasyon.MVC.Features.Categories.ViewModels.CategoryCreateVm
@{
    // Popover açıklamaları — init site.js'te (global, HTMX swap sonrası dahil).
    const string requiredHelp = "Bu özellik, ürün eklenirken doldurulması zorunlu olan özelliktir.";
    const string varianterHelp = "Varyant üreten özelliktir (örn. Beden). Ürün eklerken bu özelliğin seçilen her değeri ayrı bir varyant satırı oluşturur ve varyant adında ilk sırada yer alır.";
    const string slicerHelp = "Ürünü gruplara bölen özelliktir (örn. Renk). Varyant kombinasyonlarına katılır; pazaryerinde her dilimleyici değeri ayrı ürün kartı olarak listelenir.";
}

<!-- step2-attributes marker for JS step detection -->
<form hx-post="/categories/add/step2" hx-target="#wizard-content" hx-swap="innerHTML">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Özellik Seçimi</h3>
            <div class="card-actions">
                <span class="text-secondary">@Model.Attributes.Count özellik mevcut</span>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Attributes.Count == 0)
            {
                <div class="alert alert-info">
                    Henüz tanımlı özellik bulunmuyor. Kategori oluşturulduktan sonra özellik ekleyebilirsiniz.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th style="width:40px">Seç</th>
                                <th>Özellik</th>
                                <th style="width:100px" class="text-center">
                                    Zorunlu
                                    <i class="ti ti-info-circle text-secondary" role="button" tabindex="0"
                                       data-bs-toggle="popover" data-bs-trigger="hover focus"
                                       data-bs-placement="top" data-bs-title="Zorunlu"
                                       data-bs-content="@requiredHelp" aria-label="Zorunlu nedir?"></i>
                                </th>
                                <th style="width:100px" class="text-center">
                                    Varyanter
                                    <i class="ti ti-info-circle text-secondary" role="button" tabindex="0"
                                       data-bs-toggle="popover" data-bs-trigger="hover focus"
                                       data-bs-placement="top" data-bs-title="Varyanter"
                                       data-bs-content="@varianterHelp" aria-label="Varyanter nedir?"></i>
                                </th>
                                <th style="width:100px" class="text-center">
                                    Dilimleyici
                                    <i class="ti ti-info-circle text-secondary" role="button" tabindex="0"
                                       data-bs-toggle="popover" data-bs-trigger="hover focus"
                                       data-bs-placement="top" data-bs-title="Dilimleyici"
                                       data-bs-content="@slicerHelp" aria-label="Dilimleyici nedir?"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Attributes.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="Attributes[@i].AttributeId"
                                               value="@Model.Attributes[i].AttributeId" />
                                        <input type="hidden" name="Attributes[@i].AttributeName"
                                               value="@Model.Attributes[i].AttributeName" />
                                        <input type="hidden" name="Attributes[@i].Selected" value="false" />
                                        <input type="checkbox" class="form-check-input"
                                               name="Attributes[@i].Selected" value="true" />
                                    </td>
                                    <td>
                                        @Model.Attributes[i].AttributeName
                                    </td>
                                    <td class="text-center">
                                        <input type="hidden" name="Attributes[@i].IsRequired" value="false" />
                                        <input type="checkbox" class="form-check-input"
                                               name="Attributes[@i].IsRequired" value="true" />
                                    </td>
                                    <td class="text-center">
                                        <input type="hidden" name="Attributes[@i].IsVarianter" value="false" />
                                        <input type="checkbox" class="form-check-input"
                                               name="Attributes[@i].IsVarianter" value="true" />
                                    </td>
                                    <td class="text-center">
                                        <input type="hidden" name="Attributes[@i].IsSlicer" value="false" />
                                        <input type="checkbox" class="form-check-input"
                                               name="Attributes[@i].IsSlicer" value="true" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a href="/categories/add" class="btn btn-ghost-secondary">&larr; Geri</a>
            <button type="submit" class="btn btn-primary">Devam: Onay &rarr;</button>
        </div>
    </div>
</form>
