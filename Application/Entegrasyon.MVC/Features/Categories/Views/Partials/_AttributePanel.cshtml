@using Entegrasyon.MVC.Features.Categories.ViewModels
@model CategoryAttributePanelVm
@{
    // Sıralama VM'de: en çok kategoride kullanılan üstte, eşitlikte TR alfabetik.
    var addable = Model.Addable;

    // Popover açıklamaları — init site.js'te (global, HTMX swap sonrası dahil).
    const string requiredHelp = "Bu özellik, ürün eklenirken doldurulması zorunlu olan özelliktir.";
    const string varianterHelp = "Varyant üreten özelliktir (örn. Beden). Ürün eklerken bu özelliğin seçilen her değeri ayrı bir varyant satırı oluşturur ve varyant adında ilk sırada yer alır.";
    const string slicerHelp = "Ürünü gruplara bölen özelliktir (örn. Renk). Varyant kombinasyonlarına katılır; pazaryerinde her dilimleyici değeri ayrı ürün kartı olarak listelenir.";
}

<div class="row row-cards">
    <!-- Bağlı özellikler -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-link text-primary me-2"></i> Bağlı Özellikler
                </h3>
                <span class="badge bg-primary-lt ms-2">@Model.Attached.Count adet</span>
            </div>
            @if (Model.Attached.Count == 0)
            {
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-link-off" style="font-size: 2.5rem;"></i>
                        </div>
                        <p class="empty-title">Henüz özellik yok</p>
                        <p class="empty-subtitle text-secondary">Sağdaki havuzdan bu kategoriye özellik ekleyin.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Özellik</th>
                                <th>Tip</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Attached)
                            {
                                <tr>
                                    <td class="fw-medium">@a.CategoriyAttributeHumanized</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (a.IsRequired)
                                            {
                                                <span class="badge bg-red-lt" role="button" tabindex="0"
                                                      data-bs-toggle="popover" data-bs-trigger="hover focus"
                                                      data-bs-placement="top" data-bs-title="Zorunlu"
                                                      data-bs-content="@requiredHelp">Zorunlu</span>
                                            }
                                            @if (a.IsVarianter)
                                            {
                                                <span class="badge bg-blue-lt" role="button" tabindex="0"
                                                      data-bs-toggle="popover" data-bs-trigger="hover focus"
                                                      data-bs-placement="top" data-bs-title="Varyanter"
                                                      data-bs-content="@varianterHelp">Varyanter</span>
                                            }
                                            @if (a.IsSlicer)
                                            {
                                                <span class="badge bg-purple-lt" role="button" tabindex="0"
                                                      data-bs-toggle="popover" data-bs-trigger="hover focus"
                                                      data-bs-placement="top" data-bs-title="Dilimleyici"
                                                      data-bs-content="@slicerHelp">Dilimleyici</span>
                                            }
                                            @if (!a.IsRequired && !a.IsVarianter && !a.IsSlicer)
                                            {
                                                <span class="text-secondary small">—</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-ghost-danger btn-icon"
                                                hx-post="/categories/@Model.CategoryId/attributes/@a.Id/remove"
                                                hx-target="#attribute-panel"
                                                hx-confirm="'@a.CategoriyAttributeHumanized' özelliğini kategoriden kaldırmak istediğinize emin misiniz?"
                                                aria-label="@a.CategoriyAttributeHumanized özelliğini kaldır"
                                                title="Kaldır">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Havuzdan ekle -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-plus text-green me-2"></i> Özellik Ekle
                </h3>
                @if (addable.Count > 0)
                {
                    <span class="badge bg-green-lt ms-2">@addable.Count uygun</span>
                }
                <div class="card-actions">
                    <a href="/attributes/create?returnUrl=@Uri.EscapeDataString($"/categories/{Model.CategoryId}/attributes")"
                       class="btn btn-outline-primary btn-sm">
                        <i class="ti ti-plus icon"></i>
                        Yeni Özellik Oluştur
                    </a>
                </div>
            </div>
            @if (addable.Count == 0)
            {
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-circle-check" style="font-size: 2.5rem;"></i>
                        </div>
                        <p class="empty-title">Tümü eklendi</p>
                        <p class="empty-subtitle text-secondary">Eklenebilecek başka özellik yok.</p>
                        <div class="empty-action">
                            <a href="/attributes/create?returnUrl=@Uri.EscapeDataString($"/categories/{Model.CategoryId}/attributes")"
                               class="btn btn-primary">
                                <i class="ti ti-plus icon"></i>
                                Yeni Özellik Oluştur
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card-body border-bottom py-2">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Özellik ara..."
                               autocomplete="off" data-attr-filter="#addable-attribute-list"
                               aria-label="Eklenebilir özelliklerde ara">
                    </div>
                </div>
                <form hx-post="/categories/@Model.CategoryId/attributes" hx-target="#attribute-panel">
                    <div class="list-group list-group-flush" id="addable-attribute-list">
                        @foreach (var p in addable)
                        {
                            var name = p.CategoryAttributeHumanized ?? p.CategoryAttributeKey;
                            var usageCount = p.Categories?.Count() ?? 0;
                            <div class="list-group-item" data-filter-name="@name">
                                <label class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="attributeIds" value="@p.Id">
                                    <span class="form-check-label fw-bold">
                                        @name
                                        @if (usageCount > 0)
                                        {
                                            <span class="badge bg-secondary-lt ms-1" title="Bu özellik @usageCount kategoride kullanılıyor">@usageCount kategoride</span>
                                        }
                                    </span>
                                </label>
                                <div class="ms-4 d-flex flex-wrap gap-3">
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <label class="form-check form-check-inline mb-0 me-0"
                                               title="Seçimi kaldırmak için tekrar tıklayın">
                                            <input class="form-check-input" type="radio" name="requiredId"
                                                   value="@p.Id" data-deselectable>
                                            <span class="form-check-label small">Zorunlu</span>
                                        </label>
                                        <i class="ti ti-info-circle text-secondary" role="button" tabindex="0"
                                           data-bs-toggle="popover" data-bs-trigger="hover focus"
                                           data-bs-placement="top" data-bs-title="Zorunlu"
                                           data-bs-content="@requiredHelp"
                                           aria-label="Zorunlu nedir?"></i>
                                    </span>
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <label class="form-check form-check-inline mb-0 me-0"
                                               title="Seçimi kaldırmak için tekrar tıklayın">
                                            <input class="form-check-input" type="radio" name="varianterId"
                                                   value="@p.Id" data-deselectable>
                                            <span class="form-check-label small">Varyanter</span>
                                        </label>
                                        <i class="ti ti-info-circle text-secondary" role="button" tabindex="0"
                                           data-bs-toggle="popover" data-bs-trigger="hover focus"
                                           data-bs-placement="top" data-bs-title="Varyanter"
                                           data-bs-content="@varianterHelp"
                                           aria-label="Varyanter nedir?"></i>
                                    </span>
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <label class="form-check form-check-inline mb-0 me-0"
                                               title="Seçimi kaldırmak için tekrar tıklayın">
                                            <input class="form-check-input" type="radio" name="slicerId"
                                                   value="@p.Id" data-deselectable>
                                            <span class="form-check-label small">Dilimleyici</span>
                                        </label>
                                        <i class="ti ti-info-circle text-secondary" role="button" tabindex="0"
                                           data-bs-toggle="popover" data-bs-trigger="hover focus"
                                           data-bs-placement="top" data-bs-title="Dilimleyici"
                                           data-bs-content="@slicerHelp"
                                           aria-label="Dilimleyici nedir?"></i>
                                    </span>
                                </div>
                            </div>
                        }
                        <div class="list-group-item text-secondary text-center d-none" data-filter-empty>
                            <i class="ti ti-search-off me-1"></i> Aramanızla eşleşen özellik yok.
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-plus me-1"></i> Seçilenleri Ekle
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
