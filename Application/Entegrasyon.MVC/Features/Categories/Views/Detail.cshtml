@using Entegrasyon.MVC.Features.Categories.ViewModels
@model CategoryDetailPageVm
@{
    // ── Page header: başlık (kategori adı) + subtitle + İşlemler dropdown layout'un
    // page-header'ında render edilir (Ürünler sayfası deseni). Pretitle bilinçli boş:
    // breadcrumb zaten "Kategoriler > {ad}" bağlamını veriyor, üst kategoriyi subtitle'da
    // gösteriyoruz; pretitle'da grup adını tekrar etmek gürültü olur.
    var subtitleText = !string.IsNullOrEmpty(Model.SuperCategoryName)
        ? $"{Model.SuperCategoryName} · Kategori detayları ve performans"
        : "Ana kategori · Kategori detayları ve performans";
    ViewData.SetPageSubtitle(subtitleText);

    decimal totalRevenue = Model.Performance.TotalRevenue;
    string Pct(decimal part) => totalRevenue > 0
        ? ((double)(part / totalRevenue) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
        : "0";

    // Pazaryeri çubuklarına tutarlı, ayırt edici renkler ata (palet döngüsü).
    var barColors = new[] { "bg-primary", "bg-azure", "bg-purple", "bg-teal", "bg-pink", "bg-orange" };

    // Top ürün sıra rozeti renkleri (altın/gümüş/bronz hissi).
    string RankBadge(int i) => i switch
    {
        0 => "bg-yellow-lt text-yellow-lt-fg",
        1 => "bg-secondary-lt",
        2 => "bg-orange-lt text-orange-lt-fg",
        _ => "bg-secondary-lt"
    };
}

@section PageActions {
    @if (Model.IsFavorite)
    {
        <span class="badge bg-yellow-lt text-yellow-lt-fg me-1">
            <i class="ti ti-star-filled me-1"></i> Favori
        </span>
    }
    <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="ti ti-settings icon"></i> İşlemler
        </button>
        <div class="dropdown-menu dropdown-menu-end">
            <a class="dropdown-item" href="/categories/@Model.CategoryId/edit">
                <i class="ti ti-edit dropdown-item-icon"></i> Düzenle
            </a>
            <a class="dropdown-item" href="/categories/@Model.CategoryId/attributes">
                <i class="ti ti-list-details dropdown-item-icon"></i> Özellikleri Düzenle
            </a>
            <span class="dropdown-item disabled" aria-disabled="true">
                <i class="ti ti-building-store dropdown-item-icon"></i>
                Pazaryeri Ayarları
                <span class="badge bg-secondary-lt ms-auto">Yakında</span>
            </span>
            <div class="dropdown-divider"></div>
            <button type="button" class="dropdown-item text-danger"
                    hx-post="/categories/@Model.CategoryId/delete"
                    hx-confirm="'@Model.CategoryName' kategorisini silmek istediğinize emin misiniz?"
                    hx-swap="none">
                <i class="ti ti-trash dropdown-item-icon"></i> Sil
            </button>
        </div>
    </div>
}

@* ── KPI kartları (son @Model.DaysPast gün) — ikon + sayı + bağlam ── *@
<div class="row row-deck row-cards mb-3">
    <div class="col-6 col-sm-4 col-xl-2">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-blue-lt avatar avatar-lg rounded">
                            <i class="ti ti-shopping-cart fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="fs-1 fw-bold lh-1">@Model.Performance.TotalSoldQuantity</div>
                        <div class="text-secondary text-truncate">Satış Adedi</div>
                        <div class="text-secondary small">son @Model.DaysPast gün</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-xl-2">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-green-lt avatar avatar-lg rounded">
                            <i class="ti ti-cash fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="fs-1 fw-bold lh-1">@Model.Performance.TotalRevenue.ToString("N0") ₺</div>
                        <div class="text-secondary text-truncate">Ciro</div>
                        <div class="text-secondary small">son @Model.DaysPast gün</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-xl-2">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-azure-lt avatar avatar-lg rounded">
                            <i class="ti ti-receipt fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="fs-1 fw-bold lh-1">@Model.Performance.TotalOrderCount</div>
                        <div class="text-secondary text-truncate">Sipariş</div>
                        <div class="text-secondary small">adet</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-xl-2">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-red-lt avatar avatar-lg rounded">
                            <i class="ti ti-arrow-back-up fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="fs-1 fw-bold lh-1">@Model.Performance.TotalReturnedQuantity</div>
                        <div class="text-secondary text-truncate">İade Adedi</div>
                        <div class="text-secondary small">oran %@Model.Performance.ReturnRate.ToString("0.#")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-xl-2">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-purple-lt avatar avatar-lg rounded">
                            <i class="ti ti-tag fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="fs-1 fw-bold lh-1">@Model.Performance.AverageUnitPrice.ToString("N0") ₺</div>
                        <div class="text-secondary text-truncate">Ortalama Fiyat</div>
                        <div class="text-secondary small">ağırlıklı</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-xl-2">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-teal-lt avatar avatar-lg rounded">
                            <i class="ti ti-package fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="fs-1 fw-bold lh-1">@Model.ProductCount</div>
                        <div class="text-secondary text-truncate">Ürün Sayısı</div>
                        <div class="text-secondary small">bu kategoride</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row row-cards">
    <!-- Sol: Top ürünler + pazaryeri kırılımı -->
    <div class="col-lg-8">
        @if (!Model.HasSales)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-chart-bar-off" style="font-size: 2.5rem;"></i>
                        </div>
                        <p class="empty-title">Henüz satış yok</p>
                        <p class="empty-subtitle text-secondary">
                            Bu kategoride son @Model.DaysPast günde satış kaydı bulunmuyor.
                            Satışlar geldikçe en çok satan ürünler ve pazaryeri kırılımı burada görünecek.
                        </p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- En çok satan ürünler -->
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-trophy text-yellow me-2"></i> En Çok Satan Ürünler
                    </h3>
                    <span class="card-subtitle ms-2">son @Model.DaysPast gün</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th class="w-1">#</th>
                                <th>Ürün</th>
                                <th class="text-end">Satış Adedi</th>
                                <th class="text-end">Ciro</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var rank = 0; }
                            @foreach (var p in Model.Performance.TopProducts)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @RankBadge(rank)">@(rank + 1)</span>
                                    </td>
                                    <td>
                                        <a href="/products/@p.MainProductId" class="text-reset fw-medium">@p.ProductName</a>
                                    </td>
                                    <td class="text-end">@p.SoldQuantity</td>
                                    <td class="text-end fw-medium">@p.Revenue.ToString("N2") ₺</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pazaryeri kırılımı -->
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-building-store text-azure me-2"></i> Pazaryeri Kırılımı
                    </h3>
                </div>
                <div class="card-body">
                    @{ var mIdx = 0; }
                    @foreach (var m in Model.Performance.MarketplaceBreakdown)
                    {
                        var pct = Pct(m.Revenue);
                        var color = barColors[mIdx % barColors.Length];
                        var name = m.MarketplaceName ?? "Direkt / Storefront";
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-1">
                                <span class="fw-medium">@name</span>
                                <span class="ms-auto text-secondary small">
                                    @m.Revenue.ToString("N2") ₺ · @m.OrderCount sipariş · %@pct
                                </span>
                            </div>
                            <div class="progress progress-sm">
                                <div class="progress-bar @color" style="width: @pct%"
                                     role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"
                                     aria-label="@name %@pct">
                                </div>
                            </div>
                        </div>
                        mIdx++;
                    }
                </div>
            </div>
        }
    </div>

    <!-- Sağ: meta datagrid + özellikler -->
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Kategori Bilgileri</h3>
                <div class="card-actions">
                    <a href="/categories/@Model.CategoryId/edit" class="btn btn-sm btn-outline-primary">
                        <i class="ti ti-edit me-1"></i> Düzenle
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Üst Kategori</div>
                        <div class="datagrid-content">@(Model.SuperCategoryName ?? "—")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Alt Kategori</div>
                        <div class="datagrid-content">@Model.SubCategoryCount</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ürün Sayısı</div>
                        <div class="datagrid-content">@Model.ProductCount</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Özellik Sayısı</div>
                        <div class="datagrid-content">@Model.AttributeCount</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Varsayılan KDV</div>
                        <div class="datagrid-content">
                            @(Model.DefaultVatRate.HasValue ? $"%{Model.DefaultVatRate.Value.ToString("0.#")}" : "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Özellikler tablosu (salt-okunur) + bağlamsal "Özellikleri Düzenle" butonu -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Özellikler</h3>
                <div class="card-actions">
                    <a href="/categories/@Model.CategoryId/attributes" class="btn btn-primary btn-sm">
                        <i class="ti ti-list-details me-1"></i> Özellikleri Düzenle
                    </a>
                </div>
            </div>
            @if (Model.Attributes.Count == 0)
            {
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-list-details" style="font-size: 2.5rem;"></i>
                        </div>
                        <p class="empty-title">Özellik yok</p>
                        <p class="empty-subtitle text-secondary">Bu kategoriye henüz özellik bağlanmamış.</p>
                        <div class="empty-action">
                            <a href="/categories/@Model.CategoryId/attributes" class="btn btn-primary">
                                <i class="ti ti-plus me-1"></i> Özellik Ekle
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Özellik</th>
                                <th>Tip</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Attributes)
                            {
                                <tr>
                                    <td>@a.CategoriyAttributeHumanized</td>
                                    <td>
                                        @if (a.IsRequired)
                                        {
                                            <span class="badge bg-red-lt">Zorunlu</span>
                                        }
                                        @if (a.IsVarianter)
                                        {
                                            <span class="badge bg-blue-lt">Varyanter</span>
                                        }
                                        @if (a.IsSlicer)
                                        {
                                            <span class="badge bg-purple-lt">Dilimleyici</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
