@model List<Entegrasyon.Entity.Categories.Category>
@{
    ViewData.SetPageTitle("Kategoriler");
    ViewData.SetActiveNav("categories");
    ViewData.SetBreadcrumb(("Kategoriler", null));

    var hasCategories = Model.Any(c => c.SuperCategoryId == null);
}

<div class="d-flex justify-content-end mb-3 gap-2">
    <a href="/categories/master-import" class="btn btn-outline-primary">
        <i class="ti ti-database-import icon"></i>
        Master Katalogdan İçeri Aktar
    </a>
    <a href="/categories/add" class="btn btn-primary">
        <i class="ti ti-plus icon"></i>
        Yeni Kategori
    </a>
</div>

        <div class="row">
            <!-- Tree Panel -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Kategori ağacı</h3>
                    </div>
                    <div class="card-body p-0">
                        @if (hasCategories)
                        {
                            <div class="list-group list-group-flush">
                                @await Html.PartialAsync("Partials/_CategoryTree", Model)
                            </div>
                        }
                        else
                        {
                            <div class="empty py-4">
                                <p class="empty-title">Henüz kategori yok</p>
                                <p class="empty-subtitle text-secondary">
                                    Yeni bir kategori ekleyerek başlayabilirsiniz.
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Detail Panel -->
            <div class="col-lg-8">
                <div id="detail-panel">
                    <div class="card">
                        <div class="card-body">
                            <div class="empty py-5">
                                <div class="empty-icon">
                                    <i class="ti ti-category" style="font-size:2.5rem;"></i>
                                </div>
                                <p class="empty-title">Bir kategori seçin</p>
                                <p class="empty-subtitle text-secondary">
                                    Soldaki ağaçtan bir kategori seçtiğinizde detayları burada görüntülenecektir.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
