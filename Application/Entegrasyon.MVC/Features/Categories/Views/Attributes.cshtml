@using Entegrasyon.MVC.Features.Categories.ViewModels
@model CategoryAttributePanelVm
@{
    // Page header: başlık (kategori adı) + subtitle + "Kategoriye Dön" aksiyonu layout'ta
    // render edilir. Breadcrumb (Kategoriler > {ad} > Özellikler) controller'da set ediliyor.
    ViewData.SetPageSubtitle("Bu kategoriye bağlı özellikleri yönet — zorunlu, varyanter ve dilimleyici ayarları.");
}

@section PageActions {
    <a href="/categories/@Model.CategoryId" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left icon"></i> Kategoriye Dön
    </a>
}

<!-- HTMX swap hedefi: ekle/kaldır sonrası bu blok güncellenir -->
<div id="attribute-panel">
    <partial name="Partials/_AttributePanel" model="Model" />
</div>
