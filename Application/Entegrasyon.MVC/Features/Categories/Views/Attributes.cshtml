@using Entegrasyon.MVC.Features.Categories.ViewModels
@model CategoryAttributePanelVm

<div class="page-header page-header-border mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Kategori Özellikleri</div>
            <h2 class="page-title">@Model.CategoryName</h2>
        </div>
        <div class="col-auto ms-auto">
            <a href="/categories/@Model.CategoryId" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Kategoriye Dön
            </a>
        </div>
    </div>
</div>

<!-- HTMX swap hedefi: ekle/kaldır sonrası bu blok güncellenir -->
<div id="attribute-panel">
    <partial name="Partials/_AttributePanel" model="Model" />
</div>
