@model Entegrasyon.Entity.Dtos.Category.CategoryEditPageDto
@{
    ViewData.SetPageTitle("Kategori Düzenle");
    ViewData.SetActiveNav("categories");
    ViewData.SetBreadcrumb(
        ("Kategoriler", "/categories"),
        (Model.Category.Name, $"/categories/{Model.Category.Id}"),
        ("Düzenle", null));
    // Page header: başlık + subtitle + "Detaya Dön" aksiyonu layout'ta render edilir.
    ViewData.SetPageSubtitle($"{Model.Category.Name} kategorisinin genel bilgilerini düzenle.");
}

@section PageActions {
    @if (Model.IsLeaf)
    {
        <span class="badge bg-green-lt me-2">
            <i class="ti ti-leaf me-1"></i> Yaprak Kategori
        </span>
    }
    else
    {
        <span class="badge bg-azure-lt me-2">
            <i class="ti ti-folder me-1"></i> Ana Kategori
        </span>
    }
    <a href="/categories/@Model.Category.Id" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left icon"></i> Detaya Dön
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-adjustments text-primary me-2"></i> Genel Bilgiler
                </h3>
            </div>
            <div class="card-body">
                <form method="post" action="/categories/@Model.Category.Id/edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Category.Id" />
                    <input type="hidden" name="IsImported" value="@Model.Category.IsImported" />
                    @* Optimistic concurrency — form yüklendiğindeki xmin; POST'ta eş zamanlı edit tespiti *@
                    <input type="hidden" name="RowVersion" value="@Model.Category.RowVersion" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Kategori Adı</label>
                            <input type="text" name="Name" class="form-control"
                                   value="@Model.Category.Name" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Üst Kategori</label>
                            <select id="parent-category-select" name="SuperCategoryId" class="form-select">
                                <option value="">— Üst kategori yok —</option>
                                @foreach (var parent in Model.ValidParentCandidates.OrderBy(p => p.Name))
                                {
                                    <option value="@parent.Id"
                                            selected="@(Model.Category.SuperCategoryId == parent.Id)">
                                        @parent.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Varsayılan KDV Oranı (%)</label>
                            <input type="number" name="DefaultVatRate" class="form-control"
                                   step="0.01" min="0" max="100"
                                   value="@Model.Category.DefaultVatRate" />
                        </div>

                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <label class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="IsFavorite" value="true"
                                       @(Model.Category.IsFavorite ? "checked" : "") />
                                <span class="form-check-label">Favori Kategori</span>
                            </label>
                        </div>
                    </div>

                    @if (Model.HasProducts)
                    {
                        <div class="alert alert-warning" role="alert">
                            <div class="d-flex">
                                <i class="ti ti-alert-triangle me-2 mt-1"></i>
                                <div>Bu kategoride ürün bulunmaktadır. Değişiklikler mevcut ürünleri etkileyebilir.</div>
                            </div>
                        </div>
                    }

                    <div class="alert alert-info" role="alert">
                        <div class="d-flex">
                            <i class="ti ti-info-circle me-2 mt-1"></i>
                            <div>
                                Özellikleri (zorunlu / varyanter / dilimleyici) düzenlemek için
                                <a href="/categories/@Model.Category.Id/attributes" class="alert-link">özellik sayfasını</a>
                                kullanın.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-1">
                        <a href="/categories/@Model.Category.Id" class="btn btn-link me-2">İptal</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
(function initParentCategorySelect() {
    if (typeof TomSelect === 'undefined') { setTimeout(initParentCategorySelect, 50); return; }
    var el = document.getElementById('parent-category-select');
    if (el && !el.tomselect) {
        new TomSelect(el, { maxOptions: null, allowEmptyOption: true, placeholder: 'Üst kategori seçin...' });
    }
})();
</script>
