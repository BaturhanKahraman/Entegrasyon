@model Entegrasyon.Entity.Dtos.Category.CategoryEditPageDto
@{
    ViewData.SetPageTitle("Kategori Düzenle");
    ViewData.SetActiveNav("categories");
    ViewData.SetBreadcrumb(
        ("Kategoriler", "/categories"),
        (Model.Category.Name, null));
}

<div class="d-flex justify-content-end mb-3">
    <a href="/categories" class="btn btn-outline-secondary">
        Geri Dön
    </a>
</div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Genel Bilgiler</h3>
            </div>
            <div class="card-body">
                <form method="post" action="/categories/@Model.Category.Id/edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Category.Id" />
                    <input type="hidden" name="IsImported" value="@Model.Category.IsImported" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Kategori Adı</label>
                            <input type="text" name="Name" class="form-control"
                                   value="@Model.Category.Name" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Üst Kategori</label>
                            <select id="parent-category-select" name="SuperCategoryId" class="form-select">
                                <option value="">— Üst kategori yok —</option>
                                @foreach (var parent in Model.ValidParentCandidates.OrderBy(p => p.Name))
                                {
                                    <option value="@parent.Id"
                                            selected="@(Model.Category.SuperCategoryId == parent.Id)">
                                        @parent.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Varsayılan KDV Oranı (%)</label>
                            <input type="number" name="DefaultVatRate" class="form-control"
                                   step="0.01" min="0" max="100"
                                   value="@Model.Category.DefaultVatRate" />
                        </div>

                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsFavorite" value="true"
                                       @(Model.Category.IsFavorite ? "checked" : "") />
                                <span class="form-check-label">Favori Kategori</span>
                            </label>
                        </div>
                    </div>

                    @if (Model.HasProducts)
                    {
                        <div class="alert alert-warning">
                            Bu kategoride ürün bulunmaktadır. Değişiklikler mevcut ürünleri etkileyebilir.
                        </div>
                    }

                    <div class="text-secondary small mb-3">
                        Özellikleri düzenlemek için
                        <a href="/categories/@Model.Category.Id/attributes">özellik sayfasını</a> kullanın.
                    </div>

                    <div class="text-end">
                        <a href="/categories" class="btn btn-link me-2">İptal</a>
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>

<script>
(function initParentCategorySelect() {
    if (typeof TomSelect === 'undefined') { setTimeout(initParentCategorySelect, 50); return; }
    var el = document.getElementById('parent-category-select');
    if (el && !el.tomselect) {
        new TomSelect(el, { maxOptions: null, allowEmptyOption: true, placeholder: 'Üst kategori seçin...' });
    }
})();
</script>
