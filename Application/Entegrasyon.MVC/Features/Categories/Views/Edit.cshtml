@model Entegrasyon.Entity.Dtos.Category.CategoryEditPageDto
@{
    ViewData.SetPageTitle("Kategori Duzenle");
    ViewData.SetActiveNav("categories");
    ViewData.SetBreadcrumb(
        ("Kategoriler", "/categories"),
        (Model.Category.Name, null));
}

<div class="d-flex justify-content-end mb-3">
    <a href="/categories" class="btn btn-outline-secondary">
        Geri Don
    </a>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
                    <li class="nav-item">
                        <a href="#tab-general" class="nav-link active" data-bs-toggle="tab">Genel</a>
                    </li>
                    <li class="nav-item">
                        <a href="#tab-attributes" class="nav-link" data-bs-toggle="tab">
                            Ozellikler
                            <span class="badge bg-secondary-lt ms-1">@Model.CategoryAttributes.Count</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#tab-marketplace" class="nav-link" data-bs-toggle="tab">Pazaryeri</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <!-- General Tab -->
                    <div class="tab-pane active show" id="tab-general">
                        <form method="post" action="/categories/@Model.Category.Id/edit">
                            <input type="hidden" name="Id" value="@Model.Category.Id" />
                            <input type="hidden" name="IsImported" value="@Model.Category.IsImported" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label required">Kategori Adi</label>
                                    <input type="text" name="Name" class="form-control"
                                           value="@Model.Category.Name" required />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Ust Kategori</label>
                                    <select name="SuperCategoryId" class="form-select">
                                        <option value="">— Ust kategori yok —</option>
                                        @foreach (var parent in Model.ValidParentCandidates.OrderBy(p => p.Name))
                                        {
                                            <option value="@parent.Id"
                                                    selected="@(Model.Category.SuperCategoryId == parent.Id)">
                                                @parent.Name
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Varsayilan KDV Orani (%)</label>
                                    <input type="number" name="DefaultVatRate" class="form-control"
                                           step="0.01" min="0" max="100"
                                           value="@Model.Category.DefaultVatRate" />
                                </div>

                                <div class="col-md-6 mb-3 d-flex align-items-end">
                                    <label class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="IsFavorite" value="true"
                                               @(Model.Category.IsFavorite ? "checked" : "") />
                                        <span class="form-check-label">Favori Kategori</span>
                                    </label>
                                </div>
                            </div>

                            @if (Model.HasProducts)
                            {
                                <div class="alert alert-warning">
                                    Bu kategoride urun bulunmaktadir. Degisiklikler mevcut urunleri etkileyebilir.
                                </div>
                            }

                            <div class="text-end">
                                <a href="/categories" class="btn btn-link me-2">Iptal</a>
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                            </div>
                        </form>
                    </div>

                    <!-- Attributes Tab -->
                    <div class="tab-pane" id="tab-attributes">
                        @if (Model.CategoryAttributes.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Ozellik</th>
                                            <th>Anahtar</th>
                                            <th>Degerler</th>
                                            <th>Ozellikler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var attr in Model.CategoryAttributes)
                                        {
                                            <tr>
                                                <td>@attr.CategoriyAttributeHumanized</td>
                                                <td><code>@attr.CategoryAttributeKey</code></td>
                                                <td>
                                                    @if (attr.CategoryAttributeValues.Any())
                                                    {
                                                        <span class="text-secondary">@attr.CategoryAttributeValues.Count deger</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (attr.IsRequired)
                                                    {
                                                        <span class="badge bg-blue-lt me-1">Zorunlu</span>
                                                    }
                                                    @if (attr.IsVarianter)
                                                    {
                                                        <span class="badge bg-purple-lt me-1">Varyanter</span>
                                                    }
                                                    @if (attr.IsSlicer)
                                                    {
                                                        <span class="badge bg-green-lt me-1">Dilimleyici</span>
                                                    }
                                                    @if (attr.AllowCustom)
                                                    {
                                                        <span class="badge bg-cyan-lt">Ozel Deger</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty py-4">
                                <p class="empty-title">Henuz ozellik atanmamis</p>
                                <p class="empty-subtitle text-secondary">
                                    Bu kategoriye ozellik eklemek icin ozellikler sayfasini kullanin.
                                </p>
                            </div>
                        }
                    </div>

                    <!-- Marketplace Tab -->
                    <div class="tab-pane" id="tab-marketplace">
                        <div class="empty py-4">
                            <p class="empty-title">Pazaryeri Eslestirmeleri</p>
                            <p class="empty-subtitle text-secondary">
                                Pazaryeri kategori eslestirmeleri yakin zamanda eklenecektir.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
