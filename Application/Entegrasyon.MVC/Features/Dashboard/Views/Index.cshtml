@{
    ViewData.SetPageTitle("Dashboard");
    ViewData.SetActiveNav("dashboard");
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="page-pretitle">Genel Bakis</div>
        <h2 class="page-title">Dashboard</h2>
    </div>
</div>

<!-- Stats Cards — HTMX lazy-load -->
<div id="stats-container"
     hx-get="/dashboard/stats"
     hx-trigger="load"
     hx-swap="innerHTML">
    <div class="row row-deck row-cards mb-3">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="placeholder-glow">
                            <div class="placeholder col-6 mb-2"></div>
                            <div class="placeholder col-8" style="height:2rem"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="row row-deck row-cards">
    <!-- Weekly Sales Chart -->
    <div class="col-lg-8">
        <div id="chart-container"
             hx-get="/dashboard/weekly-sales"
             hx-trigger="load"
             hx-swap="innerHTML">
            <div class="card">
                <div class="card-body">
                    <div class="placeholder-glow">
                        <div class="placeholder col-4 mb-3"></div>
                        <div class="placeholder col-12" style="height:250px"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Marketplace Status -->
    <div class="col-lg-4">
        <div id="marketplace-container"
             hx-get="/dashboard/marketplace-status"
             hx-trigger="load"
             hx-swap="innerHTML">
            <div class="card">
                <div class="card-body">
                    <div class="placeholder-glow">
                        <div class="placeholder col-6 mb-2"></div>
                        <div class="placeholder col-12 mb-2" style="height:2rem"></div>
                        <div class="placeholder col-12 mb-2" style="height:2rem"></div>
                        <div class="placeholder col-12" style="height:2rem"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row mt-3">
    <div class="col-12">
        <div id="activity-container"
             hx-get="/dashboard/recent-activity"
             hx-trigger="load"
             hx-swap="innerHTML">
            <div class="card">
                <div class="card-body">
                    <div class="placeholder-glow">
                        <div class="placeholder col-4 mb-3"></div>
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="placeholder col-12 mb-2" style="height:1.5rem"></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
