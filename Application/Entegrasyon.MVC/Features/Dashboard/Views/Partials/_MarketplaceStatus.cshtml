@model List<Entegrasyon.Entity.Dtos.Dashboard.MarketplaceStatusDto>

<div class="card">
        <div class="card-header">
            <h3 class="card-title">Pazaryeri Durumu</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Pazaryeri</th>
                        <th>Senkron</th>
                        <th>Bekleyen</th>
                        <th>Hata</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary">
                                Pazaryeri verisi bulunamadi.
                            </td>
                        </tr>
                    }
                    @foreach (var mp in Model)
                    {
                        <tr>
                            <td>@mp.Name</td>
                            <td><span class="badge bg-success">@mp.SyncedCount</span></td>
                            <td>
                                @if (mp.PendingCount > 0)
                                {
                                    <span class="badge bg-warning">@mp.PendingCount</span>
                                }
                                else
                                {
                                    <span class="text-secondary">0</span>
                                }
                            </td>
                            <td>
                                @if (mp.FailedCount > 0)
                                {
                                    <span class="badge bg-danger">@mp.FailedCount</span>
                                }
                                else
                                {
                                    <span class="text-secondary">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
</div>
