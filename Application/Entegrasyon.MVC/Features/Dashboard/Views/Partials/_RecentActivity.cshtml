@model List<Entegrasyon.Entity.Dtos.Dashboard.RecentActivityDto>

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Son Aktiviteler</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Islem</th>
                        <th>Tarih</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="2" class="text-center text-secondary py-3">
                                Henuz aktivite bulunmuyor.
                            </td>
                        </tr>
                    }
                    @foreach (var activity in Model)
                    {
                        <tr>
                            <td>@activity.Content</td>
                            <td class="text-secondary">@activity.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
