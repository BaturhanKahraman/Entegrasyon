@model List<Entegrasyon.Entity.Dtos.Dashboard.DailySalesDto>

<div class="col-lg-8">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Haftalik Satis</h3>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-center text-secondary py-4">
                    Henuz satis verisi bulunmuyor.
                </div>
            }
            else
            {
                <div id="weekly-chart" style="height: 250px;"></div>
            }
        </div>
    </div>
</div>

@if (Model.Count > 0)
{
    <script>
        (function() {
            var options = {
                chart: { type: 'area', height: 250, toolbar: { show: false } },
                series: [{ name: 'Ciro', data: [@string.Join(",", Model.Select(m => m.Revenue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)))] }],
                xaxis: { categories: [@string.Join(",", Model.Select(m => $"'{m.Date:dd MMM}'"))] },
                yaxis: { labels: { formatter: function(val) { return val.toLocaleString('tr-TR', {style:'currency', currency:'TRY'}); } } },
                colors: ['#206bc4'],
                stroke: { width: 2 },
                fill: { opacity: 0.1 }
            };
            if (typeof ApexCharts !== 'undefined') {
                new ApexCharts(document.querySelector('#weekly-chart'), options).render();
            }
        })();
    </script>
}
