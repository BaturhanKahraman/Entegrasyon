@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Orders.Order>

<div id="picking-table" hx-trigger="pickingChanged from:body" hx-get="/picking" hx-target="#picking-table" hx-swap="innerHTML">
    @if (Model.HasItem)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
            <span class="text-secondary">@Model.TotalItemCount siparis bekliyor</span>
            <button class="btn btn-sm btn-primary" id="batchPackBtn" style="display:none;"
                    onclick="batchPack()">
                <i class="ti ti-packages icon"></i> Secilenleri Paketle
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th class="w-1">
                            <input type="checkbox" class="form-check-input"
                                   onchange="toggleAllCheckboxes(this)"/>
                        </th>
                        <th>Siparis No</th>
                        <th>Müşteri</th>
                        <th>Siparis Tarihi</th>
                        <th>Ürün Adedi</th>
                        <th>Toplam</th>
                        <th>Pazaryeri</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Items)
                    {
                        <tr id="picking-row-@order.Id">
                            <td>
                                <input type="checkbox" class="form-check-input picking-check"
                                       value="@order.Id" onchange="updateBatchBtn()"/>
                            </td>
                            <td>
                                <a href="/marketplace/orders/@order.Id" class="text-reset fw-bold" target="_blank">
                                    @(order.OrderNumber ?? order.Id.ToString()[..8])
                                </a>
                                <button class="btn btn-ghost-secondary btn-sm ms-1"
                                        hx-get="/picking/@order.Id/items"
                                        hx-target="#picking-row-@order.Id"
                                        hx-swap="afterend"
                                        title="Kalemleri goster">
                                    <i class="ti ti-list-details"></i>
                                </button>
                            </td>
                            <td class="text-secondary">
                                @order.CustomerFirstName @order.CustomerLastName
                            </td>
                            <td class="text-secondary">
                                @(order.OrderDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>
                            <td>
                                <span class="badge bg-secondary-lt">@order.TotalQuantity adet</span>
                            </td>
                            <td class="fw-bold">
                                @(order.TotalPrice.ToString("N2")) TL
                            </td>
                            <td class="text-secondary">
                                @(order.MarketPlace?.Name ?? (order.MarketPlaceId.HasValue ? $"MP #{order.MarketPlaceId}" : "Magaza"))
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary"
                                        hx-post="/picking/@order.Id/pack"
                                        hx-swap="none"
                                        hx-confirm="Bu siparis hazirlaniyor olarak isaretlensin mi?">
                                    <i class="ti ti-package icon"></i>
                                    Paketle
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/picking",
                     TargetId = "#picking-table",
                     QueryParams = new Dictionary<string, string>()
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Hazirlama bekleyen siparis yok",
                         Subtitle = "Tum siparisler isleme alindi veya henüz yeni siparis gelmedi."
                     }'/>
        </div>
    }
</div>

<script>
function toggleAllCheckboxes(el) {
    document.querySelectorAll('.picking-check').forEach(cb => cb.checked = el.checked);
    updateBatchBtn();
}
function updateBatchBtn() {
    var checked = document.querySelectorAll('.picking-check:checked').length;
    var btn = document.getElementById('batchPackBtn');
    if (btn) btn.style.display = checked > 0 ? '' : 'none';
}
function batchPack() {
    var ids = Array.from(document.querySelectorAll('.picking-check:checked')).map(cb => cb.value);
    if (ids.length === 0) return;
    if (!confirm(ids.length + ' siparisi paketlemek istediginize emin misiniz?')) return;

    var formData = new FormData();
    ids.forEach(id => formData.append('orderIds', id));

    fetch('/picking/batch-pack', { method: 'POST', body: formData })
        .then(r => { htmx.trigger(document.body, 'pickingChanged'); });
}
</script>
