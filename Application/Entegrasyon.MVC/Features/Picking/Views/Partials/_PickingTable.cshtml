@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Orders.Order>

@{
    string[] avatarTints = { "bg-primary-lt", "bg-azure-lt", "bg-green-lt", "bg-purple-lt", "bg-orange-lt", "bg-teal-lt", "bg-pink-lt" };
}

@* pickingChanged: paketle/toplu-paketle sonrası listeyi otomatik tazele. outerHTML →
   dönen partial'ın kökü yine #picking-table olduğu için 1:1 yer değiştirir (iç içe ID yok). *@
<div id="picking-table"
     hx-trigger="pickingChanged from:body"
     hx-get="/picking"
     hx-target="#picking-table"
     hx-swap="outerHTML">
    @if (Model.HasItem)
    {
        <div class="card-body border-bottom py-2">
            <div class="d-flex align-items-center">
                <span class="text-secondary" id="picking-selected-label">Paketlemek için sipariş seçin</span>
                <button class="btn btn-sm btn-primary ms-auto" id="batchPackBtn" style="display:none;"
                        onclick="batchPack()">
                    <i class="ti ti-packages icon"></i>
                    Seçilenleri Paketle
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th class="w-1">
                            <input type="checkbox" class="form-check-input m-0 align-middle"
                                   aria-label="Tümünü seç" onchange="toggleAllCheckboxes(this)"/>
                        </th>
                        <th>Sipariş No</th>
                        <th>Müşteri</th>
                        <th>Sipariş Tarihi</th>
                        <th class="text-center">Ürün Adedi</th>
                        <th class="text-end">Toplam</th>
                        <th>Pazaryeri</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Items)
                    {
                        var fullName = $"{order.CustomerFirstName} {order.CustomerLastName}".Trim();
                        var displayName = string.IsNullOrWhiteSpace(fullName) ? "—" : fullName;
                        var initial = string.IsNullOrWhiteSpace(fullName) ? "?" : fullName.Substring(0, 1).ToUpperInvariant();
                        var tint = avatarTints[Math.Abs(order.Id.GetHashCode()) % avatarTints.Length];
                        var marketplace = order.MarketPlace?.Name ?? (order.MarketPlaceId.HasValue ? $"MP #{order.MarketPlaceId}" : "Mağaza");
                        <tr id="picking-row-@order.Id">
                            <td>
                                <input type="checkbox" class="form-check-input m-0 align-middle picking-check"
                                       aria-label="Siparişi seç"
                                       value="@order.Id" onchange="updateBatchBtn()"/>
                            </td>
                            <td>
                                <a href="/marketplace/orders/@order.Id" class="text-reset fw-bold" target="_blank" rel="noopener">
                                    @(order.OrderNumber ?? order.Id.ToString()[..8])
                                </a>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm @tint rounded-circle me-2">@initial</span>
                                    <span class="text-truncate">@displayName</span>
                                </div>
                            </td>
                            <td class="text-secondary">
                                @(order.OrderDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary-lt">@order.TotalQuantity adet</span>
                            </td>
                            <td class="text-end fw-bold">
                                @(order.TotalPrice.ToString("N2")) ₺
                            </td>
                            <td>
                                <span class="badge bg-blue-lt">@marketplace</span>
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap justify-content-end">
                                    <button class="btn btn-sm btn-primary"
                                            hx-post="/picking/@order.Id/pack"
                                            hx-swap="none"
                                            hx-confirm="Bu sipariş hazırlanıyor olarak işaretlensin mi?">
                                        <i class="ti ti-package icon"></i>
                                        Paketle
                                    </button>
                                    <div class="dropdown">
                                        <button class="btn btn-icon btn-ghost-secondary btn-sm dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Diğer işlemler">
                                            <i class="ti ti-dots-vertical"></i>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                            <a class="dropdown-item"
                                               hx-get="/picking/@order.Id/items"
                                               hx-target="#picking-row-@order.Id"
                                               hx-swap="afterend"
                                               role="button">
                                                <i class="ti ti-list-details me-2"></i>
                                                Kalemleri Göster
                                            </a>
                                            <a class="dropdown-item" href="/marketplace/orders/@order.Id" target="_blank" rel="noopener">
                                                <i class="ti ti-external-link me-2"></i>
                                                Siparişi Aç
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/picking",
                     TargetId = "#picking-table",
                     QueryParams = new Dictionary<string, string>()
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Hazırlama bekleyen sipariş yok",
                         Subtitle = "Tüm siparişler işleme alındı veya henüz yeni sipariş gelmedi."
                     }'/>
        </div>
    }
</div>

<script>
function toggleAllCheckboxes(el) {
    document.querySelectorAll('.picking-check').forEach(cb => cb.checked = el.checked);
    updateBatchBtn();
}
function updateBatchBtn() {
    var checked = document.querySelectorAll('.picking-check:checked').length;
    var btn = document.getElementById('batchPackBtn');
    var label = document.getElementById('picking-selected-label');
    if (btn) btn.style.display = checked > 0 ? '' : 'none';
    if (label) label.textContent = checked > 0
        ? checked + ' sipariş seçildi'
        : 'Paketlemek için sipariş seçin';
}
function batchPack() {
    var ids = Array.from(document.querySelectorAll('.picking-check:checked')).map(cb => cb.value);
    if (ids.length === 0) return;
    if (!confirm(ids.length + ' siparişi paketlemek istediğinize emin misiniz?')) return;

    var formData = new FormData();
    ids.forEach(id => formData.append('orderIds', id));

    fetch('/picking/batch-pack', { method: 'POST', body: formData })
        .then(r => { htmx.trigger(document.body, 'pickingChanged'); });
}
</script>
