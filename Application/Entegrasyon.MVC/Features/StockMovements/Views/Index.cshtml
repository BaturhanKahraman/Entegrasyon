@using Entegrasyon.Entity.Products
@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Branches.StockMovementViewDto>

@{
    var branches = ViewBag.Branches as List<Entegrasyon.Entity.BranchOffice> ?? [];
    var selectedBranch = ViewBag.SelectedBranchOfficeId as int?;
    var selectedType = ViewBag.SelectedType as StockMovementType?;
}

        <div class="card">
            <div class="card-header">
                <div class="row w-100 g-2">
                    <div class="col-auto">
                        <select class="form-select"
                                name="branchOfficeId"
                                hx-get="/stock/movements"
                                hx-trigger="change"
                                hx-target="#movement-table"
                                hx-swap="outerHTML"
                                hx-include="[name='type']">
                            <option value="">Tüm Depolar</option>
                            @foreach (var branch in branches)
                            {
                                <option value="@branch.Id" selected="@(selectedBranch == branch.Id)">
                                    @branch.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <select class="form-select"
                                name="type"
                                hx-get="/stock/movements"
                                hx-trigger="change"
                                hx-target="#movement-table"
                                hx-swap="outerHTML"
                                hx-include="[name='branchOfficeId']">
                            <option value="">Tüm Hareket Tipleri</option>
                            <option value="@((int)StockMovementType.InitialStock)" selected="@(selectedType == StockMovementType.InitialStock)">İlk Stok</option>
                            <option value="@((int)StockMovementType.Sale)" selected="@(selectedType == StockMovementType.Sale)">Satış</option>
                            <option value="@((int)StockMovementType.MarketplaceSale)" selected="@(selectedType == StockMovementType.MarketplaceSale)">Pazaryeri Satışı</option>
                            <option value="@((int)StockMovementType.Return)" selected="@(selectedType == StockMovementType.Return)">İade</option>
                            <option value="@((int)StockMovementType.ManualAdjustment)" selected="@(selectedType == StockMovementType.ManualAdjustment)">Manuel Düzeltme</option>
                            <option value="@((int)StockMovementType.Transfer)" selected="@(selectedType == StockMovementType.Transfer)">Transfer</option>
                        </select>
                    </div>
                </div>
            </div>
            <partial name="~/Features/StockMovements/Views/Partials/_MovementTable.cshtml" model="Model" />
        </div>
