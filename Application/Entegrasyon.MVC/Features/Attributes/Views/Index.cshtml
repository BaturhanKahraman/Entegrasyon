@using Entegrasyon.Entity
@using Entegrasyon.Entity.Categories
@model Pageable<CategoryAttribute>

<div class="d-flex justify-content-end mb-3">
    <form method="get" action="/attributes" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Özellik ara..." style="max-width:250px;" />
        <button type="submit" class="btn btn-primary">Ara</button>
    </form>
</div>

        <div class="row">
            <!-- Attribute List -->
            <div class="col-lg-5">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Özellik Listesi</h3>
                        <div class="card-actions">
                            <span class="badge bg-secondary-lt">@(Model?.TotalItemCount ?? 0) özellik</span>
                        </div>
                    </div>
                    <div class="list-group list-group-flush">
                        @if (Model?.Items != null)
                        {
                            @foreach (var attr in Model.Items)
                            {
                                <a href="#attr-@attr.Id" class="list-group-item list-group-item-action"
                                   hx-get="/attributes/@attr.Id/detail" hx-target="#attribute-detail" hx-swap="innerHTML">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@attr.CategoryAttributeHumanized</strong>
                                            <div class="text-secondary small">@attr.CategoryAttributeKey</div>
                                        </div>
                                        @if (attr.AllowCustom)
                                        {
                                            <span class="badge bg-green-lt">Özel Değer</span>
                                        }
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="list-group-item text-center text-secondary py-4">
                                Henüz özellik tanımlanmamış.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Detail Panel -->
            <div class="col-lg-7">
                <div id="attribute-detail">
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <h3 class="text-secondary">Detay görüntüleme</h3>
                            <p class="text-secondary">Sol listeden bir özellik seçin.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
