@using Entegrasyon.Entity.Categories
@model CategoryAttribute
@{
    var values = Model.CategoryAttributeValues?.OrderBy(v => v.Name).ToList()
                 ?? new List<CategoryAttributeValue>();
    var categories = Model.Categories?.ToList() ?? new List<CategoryAttributeCategory>();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@(Model.CategoryAttributeHumanized ?? Model.CategoryAttributeKey)</h3>
        <div class="card-actions">
            <div class="btn-list">
                <button class="btn btn-outline-primary btn-sm"
                        hx-get="/attributes/@Model.Id/edit"
                        hx-target="#attribute-detail"
                        hx-swap="innerHTML">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-edit" width="18" height="18"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"/>
                        <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"/>
                    </svg>
                    Duzenle
                </button>
                <button class="btn btn-outline-danger btn-sm"
                        hx-post="/attributes/@Model.Id/delete"
                        hx-target="#attribute-detail"
                        hx-swap="innerHTML"
                        hx-confirm="Bu ozelligi silmek istediginizden emin misiniz?">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler" width="18" height="18"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M4 7l16 0"/>
                        <path d="M10 11l0 6"/>
                        <path d="M14 11l0 6"/>
                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/>
                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/>
                    </svg>
                    Sil
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="datagrid">
            <div class="datagrid-item">
                <div class="datagrid-title">Anahtar (Key)</div>
                <div class="datagrid-content">@(Model.CategoryAttributeKey ?? "\u2014")</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Görünen Ad</div>
                <div class="datagrid-content">@(Model.CategoryAttributeHumanized ?? "\u2014")</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Özel Değer İzni</div>
                <div class="datagrid-content">
                    @if (Model.AllowCustom)
                    {
                        <span class="badge bg-green-lt">Evet</span>
                    }
                    else
                    {
                        <span class="text-secondary">Hayır</span>
                    }
                </div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Tanımlı Değer Sayısı</div>
                <div class="datagrid-content">@values.Count</div>
            </div>
        </div>

        @if (values.Any())
        {
            <h4 class="mt-4 mb-2">Tanımlı Değerler</h4>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var val in values)
                {
                    <span class="badge bg-azure-lt">@val.Name</span>
                }
            </div>
        }

        @if (categories.Any())
        {
            <h4 class="mt-4 mb-2">Kullanan Kategoriler</h4>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Kategori</th>
                            <th>Zorunlu</th>
                            <th>Varyanter</th>
                            <th>Dilimleyici</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in categories)
                        {
                            <tr>
                                <td>@(cat.Category?.Name ?? "\u2014")</td>
                                <td>
                                    @if (cat.IsRequired)
                                    {
                                        <span class="badge bg-blue-lt">Zorunlu</span>
                                    }
                                </td>
                                <td>
                                    @if (cat.IsVarianter)
                                    {
                                        <span class="badge bg-purple-lt">Varyanter</span>
                                    }
                                </td>
                                <td>
                                    @if (cat.IsSlicer)
                                    {
                                        <span class="badge bg-green-lt">Dilimleyici</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
