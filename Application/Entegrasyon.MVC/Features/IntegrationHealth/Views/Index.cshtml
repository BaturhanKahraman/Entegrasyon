@using Entegrasyon.Entity.Logs
@model Entegrasyon.MVC.Features.IntegrationHealth.ViewModels.IntegrationHealthVm


        <!-- Summary Cards -->
        <div class="row row-deck row-cards mb-4">
            <!-- Son 24s Sync -->
            <div class="col-sm-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="subheader">Son 24s Sync</div>
                            <div class="ms-auto">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary" width="24" height="24"
                                     viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/>
                                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>
                                </svg>
                            </div>
                        </div>
                        <div class="h1 mb-0">@Model.RecentSyncCount</div>
                        <div class="text-secondary mt-1">Son 24 saatteki senkronizasyon işlemi</div>
                    </div>
                </div>
            </div>

            <!-- Son 24s Hata -->
            <div class="col-sm-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="subheader">Son 24s Hata</div>
                            <div class="ms-auto">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon @(Model.RecentErrorCount > 0 ? "text-danger" : "text-success")"
                                     width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                     fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M12 9v4"/>
                                    <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.871l-8.106 -13.534a1.914 1.914 0 0 0 -3.274 0z"/>
                                    <path d="M12 16h.01"/>
                                </svg>
                            </div>
                        </div>
                        <div class="h1 mb-0 @(Model.RecentErrorCount > 0 ? "text-danger" : "")">@Model.RecentErrorCount</div>
                        <div class="text-secondary mt-1">Son 24 saatteki hata Sayısı</div>
                    </div>
                </div>
            </div>

            <!-- Son Sync Zamani -->
            <div class="col-sm-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="subheader">Son Sync Zamani</div>
                            <div class="ms-auto">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon text-secondary" width="24" height="24"
                                     viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/>
                                    <path d="M12 7v5l3 3"/>
                                </svg>
                            </div>
                        </div>
                        @if (Model.LastSyncTime.HasValue)
                        {
                            <div class="h2 mb-0">@Model.LastSyncTime.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            <div class="text-secondary mt-1">
                                @{
                                    var elapsed = DateTimeOffset.UtcNow - Model.LastSyncTime.Value;
                                    var elapsedText = elapsed.TotalHours >= 1
                                        ? $"{(int)elapsed.TotalHours} saat once"
                                        : $"{(int)elapsed.TotalMinutes} dakika once";
                                }
                                @elapsedText
                            </div>
                        }
                        else
                        {
                            <div class="h2 mb-0 text-secondary">-</div>
                            <div class="text-secondary mt-1">Sync logu bulunamadı</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Per-Marketplace Credential Durumu (#81 ile tutarlı) -->
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">Pazaryeri Bağlantı Durumu</h3>
            </div>
            @if (Model.Marketplaces.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Pazaryeri</th>
                                <th>Durum</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mp in Model.Marketplaces)
                            {
                                <tr>
                                    <td>@mp.Name</td>
                                    <td>
                                        @if (mp.HasCredentials)
                                        {
                                            <span class="badge bg-success-lt">Hazır</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-lt">Yapılandırılmamış</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!mp.HasCredentials)
                                        {
                                            <a href="/settings/integrations" class="btn btn-sm btn-outline-primary">Anahtarları Gir</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-secondary">Tanımlı pazaryeri bulunamadı.</div>
            }
        </div>

        <!-- Recent Error Logs Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm me-1 text-danger" width="24" height="24"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M12 9v4"/>
                        <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.871l-8.106 -13.534a1.914 1.914 0 0 0 -3.274 0z"/>
                        <path d="M12 16h.01"/>
                    </svg>
                    Son Hatalar
                </h3>
                <div class="card-actions">
                    <a href="/logs?logType=@((int)LogType.Error)" class="btn btn-sm btn-outline-secondary">
                        Tum Hatalari Gor
                    </a>
                </div>
            </div>

            @if (Model.RecentErrors.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Islem</th>
                                <th>Icerik</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.RecentErrors)
                            {
                                <tr>
                                    <td class="text-secondary text-nowrap">
                                        @log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                                    </td>
                                    <td>
                                        <span class="badge bg-red-lt">@log.LogAction</span>
                                    </td>
                                    <td>@log.Content</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body">
                    <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                             model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                             {
                                 Title = "Hata bulunamadı",
                                 Subtitle = "Son donemde kaydedilmis hata logu yok. Her sey calisiyor gorunuyor."
                             }'/>
                </div>
            }
        </div>

