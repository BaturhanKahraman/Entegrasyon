@model Entegrasyon.MVC.Features.Auth.ViewModels.PasswordResetVm
@{
    Layout = "~/Shared/Views/_AuthLayout.cshtml";
    ViewData.SetPageTitle("Şifre Belirle");
}

<div class="text-center mb-4">
    <h2 class="h2">Yeni Şifre Belirleyin</h2>
    <p class="text-secondary">Devam etmek için size verilen geçici şifreyi girin ve yeni şifrenizi oluşturun.</p>
</div>

<div class="card card-md">
    <div class="card-body">
        <form method="post" asp-action="ResetPassword" asp-controller="Auth" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="TemporaryPassword" class="form-label">Geçici Şifre</label>
                <input asp-for="TemporaryPassword" type="password" class="form-control"
                       placeholder="Size verilen geçici şifre" autocomplete="off" autofocus />
                <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
                <input asp-for="NewPassword" type="password" class="form-control"
                       placeholder="En az 8 karakter, harf ve rakam" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Yeni Şifre (Tekrar)</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control"
                       placeholder="Yeni şifrenizi tekrar girin" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">Şifreyi Belirle</button>
            </div>
        </form>
    </div>
</div>

<div class="text-center text-secondary mt-3">
    <a href="/auth/login">Girişe Dön</a>
</div>
