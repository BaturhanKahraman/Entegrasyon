@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.DiscountVouchers.DiscountVoucherDto>
@{
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

<div id="voucher-table" hx-trigger="voucherToggled from:body" hx-get="/discounts" hx-target="#voucher-table" hx-swap="outerHTML">
    @if (Model != null && Model.HasItem)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Kod</th>
                        <th>Tip / Değer</th>
                        <th>Son Kullanım</th>
                        <th class="text-center">Kullanım</th>
                        <th>Müşteri</th>
                        <th>Durum</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var voucher in Model.Items)
                    {
                        var isExpired = voucher.ExpiringDate.HasValue && voucher.ExpiringDate.Value < DateTimeOffset.UtcNow;
                        var isUsedUp = voucher.MaxUsageCount.HasValue && voucher.CurrentUsageCount >= voucher.MaxUsageCount.Value;
                        <tr>
                            <td>
                                <span class="fw-bold font-monospace">@voucher.Code</span>
                                @if (voucher.MinimumCartAmount.HasValue)
                                {
                                    <div class="text-secondary small">
                                        <i class="ti ti-shopping-cart-plus" aria-hidden="true"></i>
                                        Min. @voucher.MinimumCartAmount.Value.ToString("C0", tr)
                                    </div>
                                }
                            </td>
                            <td>
                                @if (voucher.DiscountType == Entegrasyon.Entity.DiscountVouchers.DiscountType.Percentage)
                                {
                                    <span class="badge bg-purple-lt text-purple-lt-fg">%@voucher.Percentage.ToString("F0")</span>
                                }
                                else
                                {
                                    <span class="badge bg-blue-lt text-blue-lt-fg">@voucher.Amount.ToString("C2", tr)</span>
                                }
                            </td>
                            <td class="text-secondary">
                                @(voucher.ExpiringDate.HasValue
                                    ? voucher.ExpiringDate.Value.ToString("dd.MM.yyyy")
                                    : "Süresiz")
                            </td>
                            <td class="text-center">
                                <span class="text-secondary">
                                    @voucher.CurrentUsageCount / @(voucher.MaxUsageCount.HasValue ? voucher.MaxUsageCount.Value.ToString() : "∞")
                                </span>
                            </td>
                            <td class="text-secondary">
                                @(string.IsNullOrEmpty(voucher.CustomerFullName) ? "Herkes" : voucher.CustomerFullName)
                            </td>
                            <td>
                                @if (isExpired)
                                {
                                    <span class="badge bg-red-lt">Süresi Doldu</span>
                                }
                                else if (!voucher.IsActive)
                                {
                                    <span class="badge bg-secondary-lt">Pasif</span>
                                }
                                else if (isUsedUp)
                                {
                                    <span class="badge bg-orange-lt">Limit Doldu</span>
                                }
                                else
                                {
                                    <span class="badge bg-green-lt">Aktif</span>
                                }
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-icon btn-ghost-secondary"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="İndirim kodu işlemleri">
                                        <i class="ti ti-dots-vertical"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                        @if (voucher.IsActive && !isExpired)
                                        {
                                            <a class="dropdown-item"
                                               href="#"
                                               hx-post="/discounts/@voucher.Id/toggle"
                                               hx-vals='{"activate":"false"}'
                                               hx-swap="none"
                                               hx-confirm="Bu kodu pasife almak istediğinize emin misiniz?">
                                                <i class="ti ti-circle-pause dropdown-item-icon"></i>
                                                Pasife Al
                                            </a>
                                        }
                                        else if (!voucher.IsActive)
                                        {
                                            <a class="dropdown-item"
                                               href="#"
                                               hx-post="/discounts/@voucher.Id/toggle"
                                               hx-vals='{"activate":"true"}'
                                               hx-swap="none">
                                                <i class="ti ti-circle-check dropdown-item-icon"></i>
                                                Aktif Et
                                            </a>
                                        }
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item text-danger"
                                           href="#"
                                           hx-post="/discounts/@voucher.Id/delete"
                                           hx-swap="none"
                                           hx-confirm="Bu indirim kodunu silmek istediğinize emin misiniz?">
                                            <i class="ti ti-trash dropdown-item-icon"></i>
                                            Sil
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/discounts",
                     TargetId = "#voucher-table",
                     QueryParams = ViewBag.Code != null
                         ? new Dictionary<string, string> { ["code"] = (string)ViewBag.Code }
                         : new()
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "İndirim kodu bulunamadı",
                         Subtitle = "Henüz indirim kodu oluşturulmamış veya arama kriterinize uygun kod yok.",
                         ActionUrl = "/discounts/create",
                         ActionText = "Yeni Kod Oluştur"
                     }'/>
        </div>
    }
</div>
