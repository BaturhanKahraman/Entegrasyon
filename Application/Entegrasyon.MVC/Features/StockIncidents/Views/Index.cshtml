@model Entegrasyon.MVC.Features.StockIncidents.IncidentsListVm

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">Stok Yönetimi</div>
            <h2 class="page-title">
                Negatif Stok Olayları
                @if (Model.ActiveCount > 0)
                {
                    <span class="badge bg-red ms-2">@Model.ActiveCount bekleyen</span>
                }
            </h2>
        </div>
    </div>
</div>

@if (Model.Active.Count == 0)
{
    <div class="card">
        <div class="card-body">
            <div class="empty py-3">
                <p class="empty-title">Aktif olay yok</p>
                <p class="empty-subtitle text-secondary">
                    Negatif stok tespit edildiğinde burada listelenir. Olay tipik olarak iki yerden gelir:
                    offline POS senkronu ya da paralel marketplace satışı.
                </p>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Bekleyen Olaylar</h3>
            <p class="card-subtitle text-secondary mb-0">
                Her olay için iki seçenek vardır: (a) stok ekle — fiziksel sayım hatasıydı,
                (b) online iptal — paralel sipariş iptal edilecek.
            </p>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Tespit</th>
                        <th>Ürün Varyantı</th>
                        <th>Miktar</th>
                        <th>Stok</th>
                        <th>Kaynak</th>
                        <th>Referans</th>
                        <th class="text-end">Çözüm</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incident in Model.Active)
                    {
                        <tr>
                            <td class="text-secondary">@incident.DetectedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <code>@incident.ProductVariantId.ToString().Substring(0, 8)</code>
                                @if (incident.ProductVariant?.Barcode is { } barcode)
                                {
                                    <span class="text-secondary ms-1">@barcode</span>
                                }
                            </td>
                            <td><span class="badge bg-red-lt">@incident.Quantity adet</span></td>
                            <td class="text-secondary">
                                @incident.StockBefore → <strong class="text-red">@incident.StockAfter</strong>
                            </td>
                            <td>
                                <span class="badge bg-blue-lt">@incident.TriggeringSource</span>
                            </td>
                            <td class="text-secondary">
                                @if (!string.IsNullOrEmpty(incident.TriggeringReferenceId))
                                {
                                    <code>@incident.TriggeringReferenceId</code>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-list justify-content-end">
                                    <button type="button" class="btn btn-sm btn-outline-success"
                                            data-bs-toggle="modal" data-bs-target="#stockAddedModal-@incident.Id">
                                        Stok Ekle
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            data-bs-toggle="modal" data-bs-target="#onlineCancelModal-@incident.Id">
                                        Online İptal
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Resolution modals — bir tane modal her olay için *@
    @foreach (var incident in Model.Active)
    {
        <div class="modal fade" id="stockAddedModal-@incident.Id" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="/incidents/@incident.Id/resolve/stock-added">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Stok Ekle ile Çözümle</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>
                                Bu seçenek 'fiziksel sayım hatasıydı, mal gerçekten vardı' anlamına gelir.
                                Olay 'çözümlendi' olarak işaretlenir, ancak stok düzeltmesini ayrıca
                                <strong>BranchOfficeStock</strong> üzerinden yapmanız gerekir.
                            </p>
                            <div class="mb-3">
                                <label class="form-label">Açıklama (opsiyonel)</label>
                                <textarea name="notes" class="form-control" rows="2"
                                          placeholder="Örn: Sayım hatası, depoya geç giriş..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-success">Stok Ekle Olarak Çözümle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="onlineCancelModal-@incident.Id" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="/incidents/@incident.Id/resolve/online-cancelled">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Online Sipariş İptal ile Çözümle</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning mb-3">
                                <strong>Dikkat:</strong> Bu seçim sadece olayı 'çözümlendi' olarak işaretler.
                                İlgili sipariş <strong>@incident.TriggeringSource</strong> tarafından da
                                manuel olarak iptal edilmelidir (henüz otomatik iptal akışı bağlanmadı).
                            </div>
                            <div class="mb-3">
                                <label class="form-label">İptal edilecek sipariş referansı</label>
                                <input type="text" class="form-control" disabled
                                       value="@(incident.TriggeringReferenceId ?? "—")" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Açıklama (opsiyonel)</label>
                                <textarea name="notes" class="form-control" rows="2"
                                          placeholder="Örn: Müşteriyle iletişim kuruldu, iade işlemi başlatıldı..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-warning">Online İptal Olarak Çözümle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
