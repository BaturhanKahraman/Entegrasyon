@using Entegrasyon.Entity.Invoicing
@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Invoicing.EInvoiceListDto>?

<div class="d-flex justify-content-end mb-3 gap-2">
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#bulk-invoice-modal">
        Toplu Fatura
    </button>
    <a href="/invoicing/create" class="btn btn-primary">
        <i class="ti ti-plus"></i>
        Yeni Fatura
    </a>
</div>

        <div class="card">
            <div class="card-header">
                <div class="row w-100 g-2">
                    <div class="col-auto">
                        <input type="text"
                               class="form-control"
                               name="search"
                               placeholder="Fatura no veya müşteri ara..."
                               value="@ViewBag.Search"
                               hx-get="/invoicing"
                               hx-trigger="keyup changed delay:300ms"
                               hx-target="#invoice-table"
                               hx-swap="outerHTML"
                               hx-include="[name='status'],[name='type']"/>
                    </div>
                    <div class="col-auto">
                        <select class="form-select"
                                name="status"
                                hx-get="/invoicing"
                                hx-trigger="change"
                                hx-target="#invoice-table"
                                hx-swap="outerHTML"
                                hx-include="[name='search'],[name='type']">
                            <option value="">Tum Durumlar</option>
                            <option value="@((int)EInvoiceStatus.Draft)">Taslak</option>
                            <option value="@((int)EInvoiceStatus.Sent)">Gonderildi</option>
                            <option value="@((int)EInvoiceStatus.Accepted)">Onaylandı</option>
                            <option value="@((int)EInvoiceStatus.Rejected)">Reddedildi</option>
                            <option value="@((int)EInvoiceStatus.Cancelled)">Iptal</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <select class="form-select"
                                name="type"
                                hx-get="/invoicing"
                                hx-trigger="change"
                                hx-target="#invoice-table"
                                hx-swap="outerHTML"
                                hx-include="[name='search'],[name='status']">
                            <option value="">Tum Tipler</option>
                            <option value="@((int)EInvoiceType.EFatura)">e-Fatura</option>
                            <option value="@((int)EInvoiceType.EArsiv)">e-Arsiv</option>
                        </select>
                    </div>
                </div>
            </div>
            <partial name="~/Features/Invoicing/Views/Partials/_InvoiceTable.cshtml" model="Model"/>
        </div>
    </div>
</div>

<!-- Bulk Invoice Modal -->
<div class="modal modal-blur fade" id="bulk-invoice-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Toplu Fatura Olustur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Fatura JSON Verisi</label>
                    <textarea id="bulk-invoice-json" class="form-control" rows="10"
                              placeholder='{"invoices": [{"invoiceType": 0, "customerTaxId": "...", "customerTitle": "...", "issueDate": "...", "integratorProvider": 0, "lines": [{"productName": "...", "quantity": 1, "unitPrice": 100, "taxRate": 20}]}]}'></textarea>
                    <small class="form-hint">JSON formatinda birden fazla fatura tanimlayin.</small>
                </div>
                <div id="bulk-invoice-error" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Iptal</button>
                <button type="button" id="bulk-invoice-submit" class="btn btn-primary">Faturalari Olustur</button>
            </div>
        </div>

<script>
    document.getElementById('bulk-invoice-submit').addEventListener('click', async function () {
        const errorEl = document.getElementById('bulk-invoice-error');
        errorEl.classList.add('d-none');

        let payload;
        try {
            payload = JSON.parse(document.getElementById('bulk-invoice-json').value);
        } catch (e) {
            errorEl.textContent = 'Gecersiz JSON formati.';
            errorEl.classList.remove('d-none');
            return;
        }

        const btn = this;
        btn.disabled = true;
        btn.textContent = 'Gonderiliyor...';

        try {
            const response = await fetch('/invoicing/bulk', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await response.json();

            if (!response.ok) {
                errorEl.textContent = data.message || 'Bir hata olustu.';
                errorEl.classList.remove('d-none');
                return;
            }

            if (data.redirect) {
                window.location.href = data.redirect;
            }
        } catch (e) {
            errorEl.textContent = 'Istek gonderilemedi.';
            errorEl.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Faturalari Olustur';
        }
    });
</script>
