@using Entegrasyon.Entity.Invoicing
@model Entegrasyon.Entity.Dtos.Invoicing.EInvoiceDetailDto

@{
    var tr = new System.Globalization.CultureInfo("tr-TR");

    string StatusBadge(EInvoiceStatus status) => status switch
    {
        EInvoiceStatus.Draft     => "bg-secondary-lt",
        EInvoiceStatus.Sent      => "bg-azure-lt",
        EInvoiceStatus.Accepted  => "bg-green-lt",
        EInvoiceStatus.Rejected  => "bg-red-lt",
        EInvoiceStatus.Cancelled => "bg-orange-lt",
        _ => "bg-secondary-lt"
    };

    string StatusText(EInvoiceStatus status) => status switch
    {
        EInvoiceStatus.Draft     => "Taslak",
        EInvoiceStatus.Sent      => "Gönderildi",
        EInvoiceStatus.Accepted  => "Onaylandı",
        EInvoiceStatus.Rejected  => "Reddedildi",
        EInvoiceStatus.Cancelled => "İptal",
        _ => status.ToString()
    };

    string TypeText(EInvoiceType type) => type switch
    {
        EInvoiceType.EFatura => "e-Fatura",
        EInvoiceType.EArsiv  => "e-Arşiv",
        _ => type.ToString()
    };
}

@section PageActions {
    @if (Model.Status == EInvoiceStatus.Draft)
    {
        <button class="btn btn-primary"
                hx-post="/invoicing/@Model.Id/send"
                hx-confirm="Faturayı GİB'e göndermek istediğinize emin misiniz?">
            <i class="ti ti-send icon"></i>
            GİB'e Gönder
        </button>
    }
    @if (Model.Status is EInvoiceStatus.Draft or EInvoiceStatus.Sent or EInvoiceStatus.Accepted)
    {
        <button class="btn btn-outline-danger"
                hx-post="/invoicing/@Model.Id/cancel"
                hx-confirm="Faturayı iptal etmek istediğinize emin misiniz?">
            <i class="ti ti-x icon"></i>
            İptal Et
        </button>
    }
    @if (Model.PdfUrl is not null || Model.Status != EInvoiceStatus.Draft)
    {
        <a href="/invoicing/@Model.Id/pdf" class="btn btn-outline-secondary">
            <i class="ti ti-file-download icon"></i>
            PDF İndir
        </a>
    }
}

<div class="row row-cards">
    @* ── Fatura Bilgileri ── *@
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Fatura Bilgileri</h3>
                <div class="card-actions">
                    <span class="badge @StatusBadge(Model.Status)">
                        @StatusText(Model.Status)
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Fatura No</div>
                        <div class="datagrid-content">@Model.InvoiceNumber</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Tip</div>
                        <div class="datagrid-content">@TypeText(Model.InvoiceType)</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Müşteri</div>
                        <div class="datagrid-content">@Model.CustomerTitle</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Vergi No</div>
                        <div class="datagrid-content">@(Model.CustomerTaxId ?? "—")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Düzenleme Tarihi</div>
                        <div class="datagrid-content">@Model.IssueDate.ToLocalTime().ToString("dd.MM.yyyy")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Entegratör</div>
                        <div class="datagrid-content">@Model.IntegratorProvider</div>
                    </div>
                    @if (Model.GibUuid is not null)
                    {
                        <div class="datagrid-item">
                            <div class="datagrid-title">GİB UUID</div>
                            <div class="datagrid-content"><code>@Model.GibUuid</code></div>
                        </div>
                    }
                    @if (Model.SentAt is not null)
                    {
                        <div class="datagrid-item">
                            <div class="datagrid-title">Gönderim Tarihi</div>
                            <div class="datagrid-content">@Model.SentAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    }
                    @if (Model.AcceptedAt is not null)
                    {
                        <div class="datagrid-item">
                            <div class="datagrid-title">Onay Tarihi</div>
                            <div class="datagrid-content">@Model.AcceptedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    }
                    @if (Model.CancelledAt is not null)
                    {
                        <div class="datagrid-item">
                            <div class="datagrid-title">İptal Tarihi</div>
                            <div class="datagrid-content">@Model.CancelledAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    }
                </div>

                @if (Model.ErrorMessage is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="ti ti-alert-triangle me-2"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Kalemler ── *@
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Kalemler</h3>
            </div>
            @if (Model.Lines.Any())
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th class="text-end">Adet</th>
                                <th class="text-end">Birim Fiyat</th>
                                <th class="text-end">KDV Oranı</th>
                                <th class="text-end">KDV Tutarı</th>
                                <th class="text-end">Satır Toplamı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@line.ProductName</td>
                                    <td class="text-end text-secondary">@line.Quantity</td>
                                    <td class="text-end text-secondary">@line.UnitPrice.ToString("C2", tr)</td>
                                    <td class="text-end text-secondary">%@line.TaxRate</td>
                                    <td class="text-end text-secondary">@line.TaxAmount.ToString("C2", tr)</td>
                                    <td class="text-end fw-medium">@line.LineTotal.ToString("C2", tr)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4"></td>
                                <td class="text-end text-secondary">Ara Toplam</td>
                                <td class="text-end fw-medium">@Model.TotalAmount.ToString("C2", tr)</td>
                            </tr>
                            <tr>
                                <td colspan="4"></td>
                                <td class="text-end text-secondary">KDV Toplamı</td>
                                <td class="text-end fw-medium">@Model.TaxAmount.ToString("C2", tr)</td>
                            </tr>
                            <tr class="fw-bold">
                                <td colspan="4"></td>
                                <td class="text-end">Genel Toplam</td>
                                <td class="text-end">@Model.GrandTotal.ToString("C2", tr)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body">
                    <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                             model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                             {
                                 Title = "Kalem bulunamadı",
                                 Subtitle = "Bu faturada henüz kalem yok."
                             }'/>
                </div>
            }
        </div>
    </div>
</div>
