@*
    Müşteri fişindeki kodla yeni iade başlat (POST /returns/lookup -> modal).
    Mevcut iadelerde arama, liste kartının header'ına taşındı (Ürünler deseni).
    id="new-return": header'daki "Yeni İade Başlat" aksiyonu buraya odaklanır.
*@
<div id="new-return" class="card mb-3">
    <div class="card-header">
        <span class="bg-primary-lt avatar avatar-sm rounded me-2">
            <i class="ti ti-receipt-2"></i>
        </span>
        <div>
            <h3 class="card-title mb-0">Yeni iade başlat</h3>
            <div class="text-secondary small">Müşterinin fişindeki iade kodu veya fiş numarası ile.</div>
        </div>
    </div>
    <div class="card-body">
        <form hx-post="/returns/lookup"
              hx-target="#returns-modal-container"
              hx-swap="innerHTML">
            @Html.AntiForgeryToken()
            <div class="row g-2">
                <div class="col">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-barcode"></i>
                        </span>
                        <input type="text"
                               name="code"
                               class="form-control font-monospace"
                               placeholder="R-XXXXXXXXXXXXX  veya  S20260419-NNNN"
                               autocomplete="off"
                               aria-label="İade kodu veya fiş numarası"
                               required />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-arrow-right icon"></i>
                        Satışı Getir
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="returns-modal-container"></div>
