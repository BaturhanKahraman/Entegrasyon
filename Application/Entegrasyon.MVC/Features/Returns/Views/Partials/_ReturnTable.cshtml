@model List<Entegrasyon.Entity.Sales.SaleReturn>
@using Entegrasyon.Entity.Sales

@{
    string StatusBadge(ReturnStatus s) => s switch
    {
        ReturnStatus.Draft     => "bg-secondary-lt",
        ReturnStatus.Pending   => "bg-yellow-lt",
        ReturnStatus.Approved  => "bg-cyan-lt",
        ReturnStatus.Completed => "bg-green-lt",
        ReturnStatus.Rejected  => "bg-red-lt",
        ReturnStatus.Cancelled => "bg-dark-lt",
        _ => "bg-secondary-lt"
    };
    string StatusText(ReturnStatus s) => s switch
    {
        ReturnStatus.Draft     => "Taslak",
        ReturnStatus.Pending   => "Beklemede",
        ReturnStatus.Approved  => "Onaylandı",
        ReturnStatus.Completed => "Tamamlandı",
        ReturnStatus.Rejected  => "Reddedildi",
        ReturnStatus.Cancelled => "İptal",
        _ => s.ToString()
    };
    string SourceText(ReturnSource s) => s switch
    {
        ReturnSource.InPerson    => "Elden",
        ReturnSource.Storefront  => "Mağaza Sitesi",
        ReturnSource.Trendyol    => "Trendyol",
        ReturnSource.N11         => "N11",
        ReturnSource.Hepsiburada => "Hepsiburada",
        ReturnSource.Amazon      => "Amazon",
        ReturnSource.Pazarama    => "Pazarama",
        ReturnSource.PttAvm      => "PttAVM",
        ReturnSource.Ciceksepeti => "Çiçeksepeti",
        ReturnSource.Manual      => "Manuel",
        _ => s.ToString()
    };
}

<div id="return-table"
     hx-on:return-status-changed="htmx.trigger(this, 'returnTableRefresh')"
     hx-get="/returns" hx-trigger="returnTableRefresh"
     hx-target="#return-table" hx-swap="outerHTML"
     hx-include="[name='status'], [name='source']">
    @if (Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Tarih</th>
                    <th>Kaynak</th>
                    <th>Sebep</th>
                    <th>Kalem</th>
                    <th>Tutar</th>
                    <th>Durum</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr class="table-row-clickable" data-href="/returns/@r.Id" role="link" tabindex="0">
                        <td class="text-secondary">@r.Id</td>
                        <td class="text-secondary">@r.ReturnDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="badge bg-azure-lt">@SourceText(r.Source)</span></td>
                        <td>
                            @if (r.ReturnReason is not null)
                            {
                                @r.ReturnReason.Name
                            }
                            else if (!string.IsNullOrEmpty(r.CustomReason))
                            {
                                @r.CustomReason
                            }
                        </td>
                        <td>@r.Items.Count kalem</td>
                        <td class="fw-bold">@r.RefundAmount.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</td>
                        <td><span class="badge @StatusBadge(r.ReturnStatus)">@StatusText(r.ReturnStatus)</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "İade kaydı bulunamadı",
                         Subtitle = "Henüz iade kaydı bulunmuyor veya seçili filtrede kayıt yok."
                     }'/>
        </div>
    }
</div>
