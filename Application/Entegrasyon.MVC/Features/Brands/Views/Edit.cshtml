@model Entegrasyon.Entity.Dtos.Brand.BrandDetailDto

<div class="d-flex justify-content-end gap-2 mb-3">
    <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteBrandModal">
        <i class="ti ti-trash icon"></i>
        Sil
    </button>
    <a href="/brands/@Model.Id" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left icon"></i>
        Detaya Dön
    </a>
</div>

<div class="row row-deck row-cards">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Marka Bilgileri</h3>
            </div>
            <div class="card-body">
                <form method="post" action="/brands/@Model.Id/edit">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Marka Adı</label>
                            <input type="text" name="name" class="form-control"
                                   value="@Model.Name" required maxlength="55" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">SEO Slug</label>
                            <input type="text" name="seoSlug" class="form-control"
                                   value="@Model.SeoSlug" maxlength="100"
                                   placeholder="Boş bırakılırsa marka adından otomatik oluşturulur" />
                            <small class="form-hint">Örnek: nike, adidas-turkiye</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Normalized Ad</label>
                            <input type="text" class="form-control" value="@Model.NormalizedName" disabled />
                            <small class="form-hint">Otomatik oluşturulur, düzenlenemez</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ürün Sayısı</label>
                            <input type="text" class="form-control" value="@Model.ProductNumber" disabled />
                        </div>
                    </div>

                    <div class="text-end">
                        <a href="/brands/@Model.Id" class="btn btn-link me-2">İptal</a>
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Bilgi</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Oluşturulma</div>
                        <div class="datagrid-content">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Silme Onay Modal -->
<div class="modal modal-blur fade" id="deleteBrandModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-alert-triangle icon mb-2 text-danger icon-lg"></i>
                <h3>Markayı Sil</h3>
                <div class="text-secondary">
                    <strong>@Model.Name</strong> markasını silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
                </div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col">
                            <button type="button" class="btn w-100" data-bs-dismiss="modal">İptal</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-danger w-100"
                                    hx-post="/brands/@Model.Id/delete"
                                    hx-on::after-request="if(event.detail.successful) window.location.href='/brands'">
                                Evet, Sil
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
