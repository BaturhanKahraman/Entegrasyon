@model Entegrasyon.Entity.Dtos.Brand.BrandDetailDto

@{
    // Başlık + breadcrumb GET /brands/{id}/edit action'ında ViewData ile set edilir.
    ViewData.SetPageSubtitle("Marka adını ve SEO bilgilerini düzenle.");
}

@section PageActions {
    <a href="/brands/@Model.Id" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left icon"></i>
        Detaya Dön
    </a>
}

<div class="row row-deck row-cards">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Marka Bilgileri</h3>
            </div>
            <form method="post" action="/brands/@Model.Id/edit">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Marka Adı</label>
                            <input type="text" name="name" class="form-control"
                                   value="@Model.Name" required maxlength="55"
                                   autocomplete="off" autofocus />
                            <div class="form-hint">En fazla 55 karakter.</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">SEO Slug</label>
                            <input type="text" name="seoSlug" class="form-control"
                                   value="@Model.SeoSlug" maxlength="100"
                                   autocomplete="off"
                                   placeholder="Boş bırakılırsa marka adından oluşturulur" />
                            <div class="form-hint">URL'de görünen kısım. Örnek: <code>nike</code>, <code>adidas-turkiye</code></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Normalleştirilmiş Ad</label>
                            <input type="text" class="form-control" value="@Model.NormalizedName" disabled />
                            <div class="form-hint">Otomatik oluşturulur, düzenlenemez.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ürün Sayısı</label>
                            <input type="text" class="form-control" value="@Model.ProductNumber" disabled />
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a href="/brands/@Model.Id" class="btn btn-link">İptal</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy icon"></i>
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Bilgi</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Oluşturulma</div>
                        <div class="datagrid-content">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ürün Sayısı</div>
                        <div class="datagrid-content">
                            <span class="badge bg-secondary-lt">@Model.ProductNumber ürün</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
