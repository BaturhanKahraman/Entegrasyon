@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Brand.BrandListDetailDto>

<div id="brand-table">
    @if (Model.HasItem)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Marka Adi</th>
                        <th>Ürün Sayısı</th>
                        <th>Olusturma Tarihi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var brand in Model.Items)
                    {
                        <tr style="cursor: pointer" onclick="window.location='/brands/@brand.Id'">
                            <td>@brand.Name</td>
                            <td>
                                <span class="badge bg-blue-lt">@brand.ProductNumber</span>
                            </td>
                            <td class="text-secondary">@brand.CreatedAt.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/brands",
                     TargetId = "#brand-table",
                     QueryParams = ViewBag.Search != null
                         ? new Dictionary<string, string> { ["search"] = (string)ViewBag.Search }
                         : new()
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Marka bulunamadı",
                         Subtitle = "Henüz marka eklenmemis veya arama kriterinize uygun marka yok."
                     }'/>
        </div>
    }
</div>
