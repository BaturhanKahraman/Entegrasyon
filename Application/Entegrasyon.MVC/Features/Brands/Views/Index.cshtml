@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Brand.BrandListDetailDto>

@{
    // Başlıksız modern header: subtitle + sağ aksiyonlar layout'un page-header'ında render edilir.
    // (Pretitle bilinçli boş: üst-seviye liste sayfasında grup adını tekrar etmek gürültü.)
    ViewData.SetPageSubtitle("Markalarını yönet, ürün sayıları ve pazaryeri eşleşmelerini tek ekranda gör.");

    // ── KPI'lar ──────────────────────────────────────────────────────────────
    // "Toplam Marka" GERÇEK veriden gelir (Pageable.TotalItemCount). Diğer KPI'lar
    // sayfa genelinde aggregate gerektirir — şu an mevcut DEĞİL. ViewBag'den null-safe
    // okunur; backend aggregate eklenince otomatik dolar. Hiçbir sayı hardcode edilmez.
    int? totalProducts = ViewBag.TotalProductCount as int?;
    int? matchedBrands = ViewBag.MatchedBrandCount as int?;
    int? brandsWithoutProduct = ViewBag.BrandsWithoutProductCount as int?;
}

@section PageActions {
    <a href="/brands/master-import" class="btn btn-outline-primary">
        <i class="ti ti-database-import icon"></i>
        İçe Aktar
    </a>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBrandModal">
        <i class="ti ti-plus icon"></i>
        Yeni Marka
    </button>
}

@* ── Özet / KPI satırı ── *@
<div class="row row-deck row-cards mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-primary-lt avatar avatar-lg rounded">
                            <i class="ti ti-award fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fs-1 lh-1">@Model.TotalItemCount.ToString("N0")</div>
                        <div class="text-secondary">Toplam Marka</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-green-lt avatar avatar-lg rounded">
                            <i class="ti ti-package fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fs-1 lh-1">
                            @(totalProducts?.ToString("N0") ?? "—")
                        </div>
                        <div class="text-secondary">Toplam Ürün</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-azure-lt avatar avatar-lg rounded">
                            <i class="ti ti-link fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fs-1 lh-1">
                            @(matchedBrands?.ToString("N0") ?? "—")
                        </div>
                        <div class="text-secondary">Pazaryeri Eşleşen</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-yellow-lt avatar avatar-lg rounded">
                            <i class="ti ti-alert-triangle fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fs-1 lh-1">
                            @(brandsWithoutProduct?.ToString("N0") ?? "—")
                        </div>
                        <div class="text-secondary">Ürünsüz Marka</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Marka listesi kartı ── *@
<div class="card">
    <div class="card-header">
        <div class="row g-2 w-100 align-items-center">
            <div class="col">
                <h3 class="card-title mb-0">Marka Listesi</h3>
                <div class="text-secondary mt-1 small">
                    Toplam <strong>@Model.TotalItemCount.ToString("N0")</strong> marka
                </div>
            </div>
            <div class="col-12 col-md-auto ms-md-auto">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search"></i>
                    </span>
                    <input type="text"
                           class="form-control"
                           name="search"
                           placeholder="Marka adı ara…"
                           autocomplete="off"
                           aria-label="Marka ara"
                           value="@ViewBag.Search"
                           hx-get="/brands"
                           hx-trigger="keyup changed delay:300ms, search"
                           hx-target="#brand-table"
                           hx-swap="outerHTML"
                           hx-include="this"/>
                </div>
            </div>
        </div>
    </div>
    <partial name="Partials/_BrandTable" model="Model"/>
</div>

@* ── Yeni Marka Modalı ── *@
<div class="modal modal-blur fade" id="addBrandModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Marka</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form hx-post="/brands/create" hx-swap="none">
                <div class="modal-body">
                    <div class="mb-1">
                        <label class="form-label required">Marka Adı</label>
                        <input type="text" class="form-control" name="name" placeholder="Örn. Zekids Bebe" autocomplete="off" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-plus icon"></i>
                        Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
