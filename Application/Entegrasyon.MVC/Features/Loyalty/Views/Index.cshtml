@model Entegrasyon.Entity.Dtos.Storefront.LoyaltyDashboardDto

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-yellow text-white avatar"><i class="ti ti-star"></i></span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">@Model.ActiveMembers.ToString("N0")</div>
                                <div class="text-secondary">Aktif Uye</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-green text-white avatar"><i class="ti ti-coins"></i></span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">@Model.TotalEarnedPoints.ToString("N0")</div>
                                <div class="text-secondary">Dagitilan Puan</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-orange text-white avatar"><i class="ti ti-gift"></i></span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">@Model.TotalSpentPoints.ToString("N0")</div>
                                <div class="text-secondary">Kullanilan Puan</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-blue text-white avatar"><i class="ti ti-trending-up"></i></span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">@Model.ThisMonthEarned.ToString("N0")</div>
                                <div class="text-secondary">Bu Ay Kazanilan</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">En Cok Puan Kazanan Müşteriler</h3>
                    </div>
                    @if (Model.TopMembers.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Müşteri</th>
                                        <th>Seviye</th>
                                        <th class="text-end">Toplam Puan</th>
                                        <th class="text-end">Mevcut Bakiye</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in Model.TopMembers)
                                    {
                                        var levelBadge = member.Level switch
                                        {
                                            "Platin" => "bg-purple-lt",
                                            "Altin" => "bg-yellow-lt",
                                            "Gumus" => "bg-secondary-lt",
                                            _ => "bg-orange-lt"
                                        };
                                        <tr>
                                            <td>@member.CustomerName</td>
                                            <td><span class="badge @levelBadge">@member.Level</span></td>
                                            <td class="text-end">@member.TotalEarned.ToString("N0")</td>
                                            <td class="text-end fw-bold">@member.CurrentBalance.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="card-body">
                            <div class="empty py-3">
                                <p class="empty-title">Henüz sadakat uyesi yok</p>
                                <p class="empty-subtitle text-secondary">Müşteriler alisveris yaptikca otomatik olarak puan kazanir.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 class="card-title">Seviye Dağılımı</h3>
                    </div>
                    <div class="card-body">
                        @{
                            var total = Model.TopMembers.Count > 0 ? Model.ActiveMembers : 1;
                            var levels = new[] {
                                ("Platin", "bg-purple", Model.TopMembers.Count(m => m.Level == "Platin")),
                                ("Altin", "bg-yellow", Model.TopMembers.Count(m => m.Level == "Altin")),
                                ("Gumus", "bg-secondary", Model.TopMembers.Count(m => m.Level == "Gumus")),
                                ("Bronz", "bg-orange", Model.TopMembers.Count(m => m.Level == "Bronz"))
                            };
                        }
                        @foreach (var (name, color, count) in levels)
                        {
                            var pct = total > 0 ? (count * 100 / total) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>@name</span>
                                    <span class="text-secondary">@count uye</span>
                                </div>
                                <div class="progress progress-sm">
                                    <div class="progress-bar @color" style="width: @(Math.Max(pct, 2))%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Puan Kazanim Kurallari</h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Satin Alma</div>
                                <div class="datagrid-content">Her 10 TL = 1 puan</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Değerlendirme</div>
                                <div class="datagrid-content">50 puan / yorum</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Referans</div>
                                <div class="datagrid-content">200 puan / kayit</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
