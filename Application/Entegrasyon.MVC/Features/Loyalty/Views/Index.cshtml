        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">En Cok Puanli Musteriler</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr>
                                    <th>Musteri</th>
                                    <th>Seviye</th>
                                    <th class="text-end">Toplam Puan</th>
                                    <th class="text-end">Kullanilabilir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var demoCustomers = new[]
                                    {
                                        new { Name = "Ahmet Yilmaz", Level = "Altin", LevelColor = "bg-yellow", Points = 4250, Available = 1820 },
                                        new { Name = "Fatma Kaya", Level = "Platin", LevelColor = "bg-azure", Points = 3800, Available = 3800 },
                                        new { Name = "Mehmet Demir", Level = "Gumus", LevelColor = "bg-secondary", Points = 2100, Available = 900 },
                                        new { Name = "Ayse Celik", Level = "Altin", LevelColor = "bg-yellow", Points = 1950, Available = 1950 },
                                        new { Name = "Ali Sahin", Level = "Bronz", LevelColor = "bg-orange", Points = 840, Available = 340 },
                                    };
                                }
                                @foreach (var c in demoCustomers)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="avatar avatar-sm me-2 text-white" style="background-color: var(--tblr-blue);">
                                                    @c.Name[0]
                                                </span>
                                                @c.Name
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @c.LevelColor">@c.Level</span>
                                        </td>
                                        <td class="text-end fw-bold">@c.Points.ToString("N0")</td>
                                        <td class="text-end text-success">@c.Available.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 class="card-title">Seviye Dagilimi</h3>
