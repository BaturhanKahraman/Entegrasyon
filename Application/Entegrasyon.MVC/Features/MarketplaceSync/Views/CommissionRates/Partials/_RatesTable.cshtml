@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.CommissionRatesVm

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Komisyon Oranları</h3>
        <div class="card-actions">
            <span class="badge bg-blue-lt">@Model.Rates.Count oran tanımlı</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th>Komisyon %</th>
                    <th>Hizmet Bedeli %</th>
                    <th>İşlem Ücreti (TL)</th>
                    <th>Açıklama</th>
                    <th>Varsayılan</th>
                    <th class="w-1">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rates.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">
                            Henüz komisyon oranı tanımlanmamış.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var rate in Model.Rates)
                    {
                        <tr id="rate-row-@rate.Id">
                            <td>
                                @if (rate.CategoryName is not null)
                                {
                                    <span>@rate.CategoryName</span>
                                }
                                else
                                {
                                    <span class="text-secondary fst-italic">Genel</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-blue-lt">%@rate.CommissionPercent.ToString("0.##")</span>
                            </td>
                            <td>
                                @if (rate.ServiceFeePercent.HasValue)
                                {
                                    <span>%@rate.ServiceFeePercent.Value.ToString("0.##")</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </td>
                            <td>
                                @if (rate.TransactionFeeFixed.HasValue)
                                {
                                    <span>@rate.TransactionFeeFixed.Value.ToString("0.00") TL</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(rate.Description))
                                {
                                    <span>@rate.Description</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </td>
                            <td>
                                @if (rate.IsDefault)
                                {
                                    <span class="badge bg-green-lt">Evet</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Hayır</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-ghost-danger btn-sm"
                                        hx-post="/marketplace/commission-rates/@rate.Id/delete?mp=@Model.SelectedMarketPlaceId"
                                        hx-swap="none"
                                        hx-confirm="Bu komisyon oranını silmek istediğinizden emin misiniz?">
                                    <i class="ti ti-trash"></i>
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
