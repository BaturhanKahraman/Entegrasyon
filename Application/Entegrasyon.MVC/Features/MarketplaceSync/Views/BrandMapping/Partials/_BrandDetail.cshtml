@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.BrandDetailVm

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@Model.BrandName</h3>
    </div>
    <div class="card-body">
        @if (Model.IsMapped && Model.Mapping is not null)
        {
            <div class="alert alert-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Eslendi</strong>
                        <div class="mt-1">
                            <span class="text-secondary">Pazaryeri Marka ID:</span>
                            <strong>@Model.Mapping.MarketPlaceBrandId</strong>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Mapping.MarketPlaceBrandName))
                        {
                            <div>
                                <span class="text-secondary">Pazaryeri Marka Adi:</span>
                                <strong>@Model.Mapping.MarketPlaceBrandName</strong>
                            </div>
                        }
                    </div>
                    <button class="btn btn-outline-danger btn-sm"
                            hx-post="/marketplace/sync/brands/@Model.BrandId/unmap?mp=@Model.MarketPlaceId"
                            hx-confirm="Marka eslemesini kaldirmak istediginize emin misiniz?"
                            hx-swap="none"
                            hx-on::after-request="if(event.detail.successful) { htmx.ajax('GET', '/marketplace/sync/brands/@Model.BrandId/detail?mp=@Model.MarketPlaceId', {target:'#brand-detail-panel'}); }">
                        Eslemeyi Kaldir
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary mb-3">
                <strong>Eslenmedi</strong> — Bu marka henüz bu pazaryeri ile eslenmemis.
            </div>

            <h4 class="mb-3">Yeni Esleme Olustur</h4>
            <form hx-post="/marketplace/sync/brands/@Model.BrandId/map"
                  hx-swap="none"
                  hx-on::after-request="if(event.detail.successful) { htmx.ajax('GET', '/marketplace/sync/brands/@Model.BrandId/detail?mp=@Model.MarketPlaceId', {target:'#brand-detail-panel'}); }"
                  class="row g-3 align-items-end">
                <input type="hidden" name="mp" value="@Model.MarketPlaceId" />
                @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                }
                <div class="col-md-8">
                    <label class="form-label">Pazaryeri Markası</label>
                    <select class="form-select" id="brand-search-select" name="externalBrandId" required>
                        <option value=""></option>
                    </select>
                    <input type="hidden" name="externalBrandName" id="brand-search-name" />
                    <small class="form-hint">Marka adı yazmaya başlayın, sonuçlar canlı aranır.</small>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-link"></i>
                        Esle
                    </button>
                </div>
            </form>

            <script>
                (function () {
                    var el = document.getElementById('brand-search-select');
                    if (!el || el.tomselect) return;
                    var ts = new TomSelect(el, {
                        valueField: 'id',
                        labelField: 'label',
                        searchField: ['name', 'label'],
                        maxOptions: 20,
                        placeholder: 'Marka adı yazın...',
                        loadThrottle: 500,
                        preload: false,
                        load: function (query, callback) {
                            if (query.length < 2) { callback(); return; }
                            fetch('/marketplace/sync/suggestions/brands?mp=@Model.MarketPlaceId&q=' + encodeURIComponent(query))
                                .then(function (r) { return r.json(); })
                                .then(function (data) { callback(data); })
                                .catch(function () { callback(); });
                        },
                        render: {
                            option: function (item, escape) {
                                return '<div><strong>' + escape(item.name) + '</strong> ' +
                                       '<small class="text-muted">(ID: ' + escape(item.id) + ')</small></div>';
                            },
                            item: function (item, escape) {
                                return '<div>' + escape(item.name) + ' <small class="text-muted">(ID: ' + escape(item.id) + ')</small></div>';
                            }
                        }
                    });
                    ts.on('change', function (value) {
                        var opt = ts.options[value];
                        document.getElementById('brand-search-name').value = opt ? opt.name : '';
                    });
                })();
            </script>
        }

        <!-- Brand Info -->
        <div class="datagrid mt-4">
            <div class="datagrid-item">
                <div class="datagrid-title">Uygulama Marka ID</div>
                <div class="datagrid-content">@Model.BrandId</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Marka Adi</div>
                <div class="datagrid-content">@Model.BrandName</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Esleme Durumu</div>
                <div class="datagrid-content">
                    @if (Model.IsMapped)
                    {
                        <span class="badge bg-success-lt">Eslendi</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-lt">Eslenmedi</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
