@using Entegrasyon.Entity
@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.AttributeSyncVm
@{
    ViewData.SetPageTitle("Özellik Eşlemesi");
    ViewData.SetActiveNav("marketplace-sync");
    ViewData.SetBreadcrumb(("Pazaryeri Senkronizasyonu", "/marketplace/sync"), ("Özellik Eşlemesi", null));
}

@if (!Model.AnyCredentialed)
{
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <div class="empty-icon">
                    <i class="ti ti-plug-connected-x" style="font-size:2.5rem;"></i>
                </div>
                <p class="empty-title">Aktif pazaryeri yok</p>
                <p class="empty-subtitle text-secondary">
                    Özellik eşlemesi yapabilmek için en az bir pazaryerinin API bilgilerini girmelisiniz.
                </p>
                <div class="empty-action">
                    <a href="/settings/integrations" class="btn btn-primary">
                        <i class="ti ti-settings me-1"></i>Pazaryeri Ayarları
                    </a>
                </div>
            </div>
        </div>
    </div>
    return;
}

        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <div class="alert alert-info mb-3">
                <div class="d-flex align-items-center">
                    <i class="ti ti-info-circle icon me-2"></i>
                    <div class="flex-fill">
                        Eşleştirmeyi tamamladığınızda otomatik olarak geri yönlendirileceksiniz.
                    </div>
                    <a href="@Model.ReturnUrl" class="btn btn-sm btn-outline-primary ms-2">
                        <i class="ti ti-arrow-left me-1"></i>Geri Dön
                    </a>
                </div>
            </div>
        }

        <!-- Marketplace Tabs -->
        <div class="card mb-3">
            <div class="card-body p-2">
                <ul class="nav nav-pills">
                    @foreach (var mp in Model.MarketPlaces)
                    {
                        var isActive = mp.Id == Model.SelectedMarketPlaceId;
                        var hasCreds = mp.IsCredentialComplete();
                        <li class="nav-item">
                            @if (hasCreds)
                            {
                                <a class="nav-link @(isActive ? "active" : "")"
                                   href="/marketplace/sync/attributes?mp=@mp.Id"
                                   hx-get="/marketplace/sync/attributes?mp=@mp.Id"
                                   hx-target="#attribute-list-container"
                                   hx-push-url="true">
                                    @mp.Name
                                </a>
                            }
                            else
                            {
                                <span class="nav-link disabled" title="API bilgisi eksik">
                                    @mp.Name
                                    <i class="ti ti-lock ms-1"></i>
                                </span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Two-column layout -->
        <div class="row">
            <!-- Attribute List -->
            <div class="col-lg-5">
                <div id="attribute-list-container">
                    @await Html.PartialAsync("~/Features/MarketplaceSync/Views/AttributeSync/Partials/_AttributeList.cshtml", Model)
                </div>
            </div>

            <!-- Match Panel -->
            <div class="col-lg-7">
                @if (Model.PreselectAttributeId is int preselectId)
                {
                    @* Özellik detayından gelindi: ilgili özelliğin eşleme paneli otomatik yüklenir. *@
                    <div id="attribute-detail-panel"
                         hx-get="/marketplace/sync/attributes/@preselectId/detail?mp=@Model.SelectedMarketPlaceId@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : $"&returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}")"
                         hx-trigger="load"
                         hx-swap="innerHTML">
                        <div class="card">
                            <div class="card-body text-center py-5">
                                <div class="spinner-border text-secondary" role="status"></div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div id="attribute-detail-panel">
                        <div class="card">
                            <div class="card-body">
                                <div class="empty py-5">
                                    <div class="empty-icon">
                                        <i class="ti ti-arrows-exchange" style="font-size:2.5rem;"></i>
                                    </div>
                                    <p class="empty-title">Bir özellik seçin</p>
                                    <p class="empty-subtitle text-secondary">
                                        Soldaki listeden bir özellik seçtiğinizde eşleme detayları burada görüntülenecektir.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

<script>
    document.addEventListener('refreshList', function () {
        htmx.ajax('GET', '/marketplace/sync/attributes?mp=@Model.SelectedMarketPlaceId', { target: '#attribute-list-container' });
    });
</script>
