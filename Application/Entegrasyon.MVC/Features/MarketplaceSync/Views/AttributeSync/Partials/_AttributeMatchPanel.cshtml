@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.AttributeMatchPanelVm

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@(Model.AttributeHumanized ?? Model.AttributeKey)</h3>
        @if (!string.IsNullOrEmpty(Model.AttributeHumanized) && Model.AttributeHumanized != Model.AttributeKey)
        {
            <span class="text-muted ms-2">(@Model.AttributeKey)</span>
        }
    </div>
    <div class="card-body">
        <!-- Attribute Match -->
        <h4 class="mb-3">Özellik Eşleşmesi</h4>
        @if (Model.AttributeMatch is not null)
        {
            <div class="alert alert-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Eşlendi:</strong> Pazaryeri Özellik ID: @Model.AttributeMatch.MarketPlaceCategoryAttributeId
                        @if (!string.IsNullOrEmpty(Model.AttributeMatch.MarketPlaceCategoryAttributeExternalId))
                        {
                            <span class="text-muted ms-1">(External: @Model.AttributeMatch.MarketPlaceCategoryAttributeExternalId)</span>
                        }
                    </div>
                    <button class="btn btn-outline-danger btn-sm"
                            hx-post="/marketplace/sync/attributes/@Model.AttributeId/unmap?mp=@Model.MarketPlaceId"
                            hx-confirm="Özellik eslemesini kaldirmak istediginize emin misiniz?"
                            hx-swap="none">
                        Kaldir
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary">
                <form hx-post="/marketplace/sync/attributes/@Model.AttributeId/map"
                      hx-swap="none"
                      class="row g-2 align-items-end">
                    <input type="hidden" name="mp" value="@Model.MarketPlaceId" />
                    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                    {
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    }
                    <div class="col-md-8">
                        <label class="form-label">Pazaryeri Özelliği</label>
                        <select id="attrSearchSelect" name="mpAttributeId" required>
                            <option value=""></option>
                        </select>
                        <small class="form-hint">Özellik adı yazmaya başlayın (örn: "Renk").</small>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-sm">Eşle</button>
                    </div>
                </form>
            </div>

            <script>
                (function () {
                    var el = document.getElementById('attrSearchSelect');
                    if (!el || el.tomselect) return;
                    new TomSelect(el, {
                        valueField: 'id',
                        labelField: 'label',
                        searchField: ['name', 'label'],
                        maxOptions: 20,
                        placeholder: 'Özellik adı yazın...',
                        loadThrottle: 500,
                        preload: false,
                        load: function (query, callback) {
                            if (query.length < 2) { callback(); return; }
                            fetch('/marketplace/sync/suggestions/attributes?mp=@Model.MarketPlaceId&q=' + encodeURIComponent(query))
                                .then(function (r) { return r.json(); })
                                .then(function (data) { callback(data); })
                                .catch(function () { callback(); });
                        }
                    });
                })();
            </script>
        }

        <!-- Value Matches -->
        @if (Model.ValueMatches.Any())
        {
            <h4 class="mt-4 mb-3">Değer Eşleşmeleri</h4>
            <div class="table-responsive">
                <table class="table table-vcenter table-hover card-table table-sm">
                    <thead>
                        <tr>
                            <th>Değer</th>
                            <th>Pazaryeri Değeri</th>
                            <th>Durum</th>
                            <th class="w-1">Islem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var val in Model.ValueMatches)
                        {
                            <tr>
                                <td>@val.ValueName</td>
                                <td>
                                    @if (val.IsMapped)
                                    {
                                        <span>ID: @val.MarketPlaceValueId</span>
                                        @if (!string.IsNullOrEmpty(val.MarketPlaceValueExternalId))
                                        {
                                            <small class="text-muted ms-1">(External: @val.MarketPlaceValueExternalId)</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (val.IsMapped)
                                    {
                                        <span class="badge bg-success-lt">Eşlendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt">Eşlenmedi</span>
                                    }
                                </td>
                                <td>
                                    @if (val.IsMapped)
                                    {
                                        <button class="btn btn-outline-danger btn-sm"
                                                hx-post="/marketplace/sync/attributes/values/@val.ValueId/unmap?mp=@Model.MarketPlaceId"
                                                hx-confirm="Değer eslemesini kaldirmak istediginize emin misiniz?"
                                                hx-target="closest tr"
                                                hx-swap="outerHTML"
                                                hx-on::after-request="htmx.ajax('GET', '/marketplace/sync/attributes/@Model.AttributeId/detail?mp=@Model.MarketPlaceId', {target:'#attribute-detail-panel'})">
                                            Kaldir
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-primary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#mapValueModal"
                                                onclick="openValueMapModal(@val.ValueId, '@val.ValueName.Replace("'", "\\'")' )">
                                            Eşle
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted mt-3">Bu ozelligin onceden tanimlanmis degeri yok.</div>
        }
    </div>
</div>

<!-- Map Value Modal -->
<div class="modal modal-blur fade" id="mapValueModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Değer Eşle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="mapValueForm" method="post" hx-swap="none"
                  hx-on::after-request="if(event.detail.successful) { bootstrap.Modal.getInstance(document.getElementById('mapValueModal')).hide(); htmx.ajax('GET', '/marketplace/sync/attributes/@Model.AttributeId/detail?mp=@Model.MarketPlaceId', {target:'#attribute-detail-panel'}); }">
                <div class="modal-body">
                    <p class="text-secondary mb-3">
                        <strong id="modal-value-name"></strong> için pazaryeri degerini arayın.
                    </p>
                    <input type="hidden" name="mp" value="@Model.MarketPlaceId" />
                    <div class="mb-3">
                        <label class="form-label">Pazaryeri Değeri</label>
                        <select id="valueSearchSelect" name="mpValueId" required>
                            <option value=""></option>
                        </select>
                        <small class="form-hint">Değer adı yazın (örn: "Kırmızı").</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Eşle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var valueSearchTs = null;

    function ensureValueSearchTomSelect() {
        var el = document.getElementById('valueSearchSelect');
        if (!el) return;
        if (el.tomselect) { valueSearchTs = el.tomselect; return; }
        valueSearchTs = new TomSelect(el, {
            valueField: 'id',
            labelField: 'label',
            searchField: ['name', 'label'],
            maxOptions: 20,
            placeholder: 'Değer adı yazın...',
            loadThrottle: 500,
            preload: false,
            load: function (query, callback) {
                if (query.length < 2) { callback(); return; }
                var attributeId = @Model.AttributeId;
                fetch('/marketplace/sync/suggestions/attributes/' + attributeId + '/values?mp=@Model.MarketPlaceId&q=' + encodeURIComponent(query))
                    .then(function (r) { return r.json(); })
                    .then(function (data) { callback(data); })
                    .catch(function () { callback(); });
            }
        });
    }

    function openValueMapModal(valueId, valueName) {
        document.getElementById('modal-value-name').textContent = valueName;
        var form = document.getElementById('mapValueForm');
        form.setAttribute('hx-post', '/marketplace/sync/attributes/values/' + valueId + '/map');
        htmx.process(form);
        ensureValueSearchTomSelect();
        if (valueSearchTs) {
            valueSearchTs.clear();
            valueSearchTs.clearOptions();
        }
    }
</script>
