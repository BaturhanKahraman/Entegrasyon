@model Entegrasyon.Entity.Dtos.Product.ProductSyncSummaryDto

<div class="row row-deck row-cards mb-3">
    <div class="col-6 col-sm-4 col-lg">
        <div class="card">
            <div class="card-body p-3 text-center">
                <div class="text-secondary mb-1">Toplam</div>
                <div class="h1 mb-0">@Model.TotalProducts</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-lg">
        <div class="card">
            <div class="card-body p-3 text-center">
                <div class="text-secondary mb-1">Senkronize</div>
                <div class="h1 mb-0 text-green">@Model.SyncedCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-lg">
        <div class="card">
            <div class="card-body p-3 text-center">
                <div class="text-secondary mb-1">Bekleyen</div>
                <div class="h1 mb-0 text-warning">@Model.PendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-lg">
        <div class="card">
            <div class="card-body p-3 text-center">
                <div class="text-secondary mb-1">Hatali</div>
                <div class="h1 mb-0 text-danger">@Model.FailedCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-lg">
        <div class="card">
            <div class="card-body p-3 text-center">
                <div class="text-secondary mb-1">Hic Senkronize Edilmemis</div>
                <div class="h1 mb-0 text-secondary">@Model.NeverSyncedCount</div>
            </div>
        </div>
    </div>
</div>
