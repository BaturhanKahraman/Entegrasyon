<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="page-pretitle">Pazaryeri Senkronizasyon</div>
                <h2 class="page-title">Toplu Urun Senkronizasyon</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="subheader">Bekleyen</div>
                        </div>
                        <div class="h1 mb-0">@(ViewBag.Summary?.PendingCount ?? 0)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="subheader">Basarili</div>
                        </div>
                        <div class="h1 mb-0 text-green">@(ViewBag.Summary?.SyncedCount ?? 0)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="subheader">Hatali</div>
                        </div>
                        <div class="h1 mb-0 text-red">@(ViewBag.Summary?.FailedCount ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Toplu Islemler</h3>
            </div>
            <div class="card-body">
                <div class="d-flex gap-2">
                    <form method="post" action="/marketplace/matching/sync-all?mp=@ViewBag.SelectedMarketPlaceId">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">
                            Tumu Senkronize Et
                        </button>
                    </form>
                    <form method="post" action="/marketplace/matching/retry-all?mp=@ViewBag.SelectedMarketPlaceId">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning">
                            Hatalilari Yeniden Dene
                        </button>
                    </form>
                    <a href="/marketplace/matching?mp=@ViewBag.SelectedMarketPlaceId" class="btn btn-outline-secondary">
                        Detayli Listeye Git
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
