@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.ProductSyncIndexVm

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="page-pretitle">Pazaryeri</div>
                <h2 class="page-title">Urun Senkronizasyon</h2>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <button class="btn btn-primary"
                            hx-post="/marketplace/matching/sync-all?mp=@Model.SelectedMarketPlaceId"
                            hx-swap="none"
                            hx-confirm="Tum bekleyen urunleri senkronize etmek istediginize emin misiniz?">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24"
                             viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/>
                            <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>
                        </svg>
                        Tumu Senkronize Et
                    </button>
                    <button class="btn btn-outline-danger"
                            hx-post="/marketplace/matching/retry-all?mp=@Model.SelectedMarketPlaceId"
                            hx-swap="none"
                            hx-confirm="Tum hatali urunleri yeniden denemek istediginize emin misiniz?">
                        Hatalilari Yeniden Dene
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        <!-- Marketplace Tabs -->
        <div class="card mb-3">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    @foreach (var mp in Model.MarketPlaces)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(mp.Id == Model.SelectedMarketPlaceId ? "active" : "")"
                               href="/marketplace/matching?mp=@mp.Id">
                                @mp.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Summary Cards -->
        <partial name="~/Features/MarketplaceSync/Views/ProductSync/Partials/_SyncSummary.cshtml"
                 model="Model.Summary"/>

        <!-- Filters + Table -->
        <div class="card">
            <div class="card-header">
                <div class="row w-100 g-2 align-items-center">
                    <div class="col-auto col-md-4">
                        <input type="text"
                               class="form-control"
                               name="search"
                               placeholder="Urun ara..."
                               value="@Model.SearchKey"
                               hx-get="/marketplace/matching"
                               hx-trigger="keyup changed delay:300ms"
                               hx-target="#sync-table"
                               hx-swap="outerHTML"
                               hx-include="[name='state']"
                               hx-vals='{"mp": @Model.SelectedMarketPlaceId}'/>
                    </div>
                    <div class="col-auto col-md-3">
                        <select class="form-select"
                                name="state"
                                hx-get="/marketplace/matching"
                                hx-trigger="change"
                                hx-target="#sync-table"
                                hx-swap="outerHTML"
                                hx-include="[name='search']"
                                hx-vals='{"mp": @Model.SelectedMarketPlaceId}'>
                            <option value="">Tum Durumlar</option>
                            <option value="Synced" selected="@(Model.StateFilter == "Synced")">Senkronize</option>
                            <option value="Waiting" selected="@(Model.StateFilter == "Waiting")">Bekleyen</option>
                            <option value="Processing" selected="@(Model.StateFilter == "Processing")">Isleniyor</option>
                            <option value="OutOfSync" selected="@(Model.StateFilter == "OutOfSync")">Guncellenmemis</option>
                            <option value="Failed" selected="@(Model.StateFilter == "Failed")">Hatali</option>
                            <option value="Rejected" selected="@(Model.StateFilter == "Rejected")">Reddedildi</option>
                            <option value="NeverSynced" selected="@(Model.StateFilter == "NeverSynced")">Hic Senkronize Edilmemis</option>
                        </select>
                    </div>
                </div>
            </div>

            @{
                var tableVm = new Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.ProductSyncTableVm
                {
                    SelectedMarketPlaceId = Model.SelectedMarketPlaceId,
                    Products = Model.Products,
                    SearchKey = Model.SearchKey,
                    StateFilter = Model.StateFilter
                };
            }
            <partial name="~/Features/MarketplaceSync/Views/ProductSync/Partials/_SyncTable.cshtml"
                     model="tableVm"/>
        </div>

    </div>
</div>
