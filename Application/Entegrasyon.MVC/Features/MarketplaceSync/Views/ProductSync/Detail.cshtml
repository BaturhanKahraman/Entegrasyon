@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.ProductSyncDetailVm
@using Entegrasyon.Entity.Dtos.Product
@using Entegrasyon.Entity.Logs

<div class="d-flex justify-content-end mb-3">
    <a href="/marketplace/matching" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left"></i>
        Listeye Don
    </a>
</div>


        <!-- Product Info Card -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Ürün Bilgileri</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ürün Adı</div>
                        <div class="datagrid-content">@Model.Product.Title</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Stok Kodu</div>
                        <div class="datagrid-content">@Model.Product.StockCode</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Marka</div>
                        <div class="datagrid-content">@Model.Product.BrandName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Kategori</div>
                        <div class="datagrid-content">@Model.Product.CategoryName</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Varyant Sayısı</div>
                        <div class="datagrid-content">@Model.Product.VariantCount</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Product.Description))
                    {
                        <div class="datagrid-item">
                            <div class="datagrid-title">Açıklama</div>
                            <div class="datagrid-content">@Model.Product.Description</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Marketplace Tabs -->
        @if (Model.Product.Marketplaces.Any())
        {
            var firstMpId = Model.SelectedMarketPlaceTab ?? Model.Product.Marketplaces.First().MarketPlaceId;

            <div class="card mb-3">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
                        @foreach (var mp in Model.Product.Marketplaces)
                        {
                            var isActive = mp.MarketPlaceId == firstMpId;
                            <li class="nav-item">
                                <a href="#tab-mp-@mp.MarketPlaceId"
                                   class="nav-link @(isActive ? "active" : "")"
                                   data-bs-toggle="tab">
                                    @mp.MarketPlaceName
                                    @{
                                        var (badgeClass, badgeText) = mp.SyncState switch
                                        {
                                            MarketplaceSyncState.Synced => ("bg-green-lt", "Senkronize"),
                                            MarketplaceSyncState.Waiting => ("bg-warning-lt", "Bekleyen"),
                                            MarketplaceSyncState.Processing => ("bg-info-lt", "İşleniyor"),
                                            MarketplaceSyncState.OutOfSync => ("bg-orange-lt", "Güncellenmemiş"),
                                            MarketplaceSyncState.Failed => ("bg-danger-lt", "Hatalı"),
                                            MarketplaceSyncState.Rejected => ("bg-danger-lt", "Reddedildi"),
                                            _ => ("bg-secondary-lt", "Hiç Senkronize Edilmemiş")
                                        };
                                    }
                                    <span class="badge @badgeClass ms-2">@badgeText</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        @foreach (var mp in Model.Product.Marketplaces)
                        {
                            var isActive = mp.MarketPlaceId == firstMpId;
                            <div class="tab-pane @(isActive ? "active show" : "")" id="tab-mp-@mp.MarketPlaceId">

                                @if (!mp.HasCredentials)
                                {
                                    <div class="alert alert-warning">
                                        <i class="ti ti-alert-triangle alert-icon"></i>
                                        API kimlik bilgileri yapilandirilmamis. Senkronizasyon için marketplace ayarlarindan API anahtarlarini yapilandirin.
                                    </div>
                                }

                                <div class="row">
                                    <div class="col-lg-8">
                                        <div class="datagrid">
                                            <div class="datagrid-item">
                                                <div class="datagrid-title">Durum</div>
                                                <div class="datagrid-content">
                                                    @{
                                                        var (stClass, stText) = mp.SyncState switch
                                                        {
                                                            MarketplaceSyncState.Synced => ("bg-green-lt", "Senkronize"),
                                                            MarketplaceSyncState.Waiting => ("bg-warning-lt", "Bekleyen"),
                                                            MarketplaceSyncState.Processing => ("bg-info-lt", "İşleniyor"),
                                                            MarketplaceSyncState.OutOfSync => ("bg-orange-lt", "Güncellenmemiş"),
                                                            MarketplaceSyncState.Failed => ("bg-danger-lt", "Hatalı"),
                                                            MarketplaceSyncState.Rejected => ("bg-danger-lt", "Reddedildi"),
                                                            _ => ("bg-secondary-lt", "Hiç Senkronize Edilmemiş")
                                                        };
                                                    }
                                                    <span class="badge @stClass">@stText</span>
                                                </div>
                                            </div>
                                            <div class="datagrid-item">
                                                <div class="datagrid-title">Son Senkronizasyon</div>
                                                <div class="datagrid-content">
                                                    @if (mp.LastSyncedAt.HasValue)
                                                    {
                                                        @mp.LastSyncedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-secondary">Henüz senkronize edilmedi</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(mp.ExternalProductId))
                                            {
                                                <div class="datagrid-item">
                                                    <div class="datagrid-title">Dis Ürün ID</div>
                                                    <div class="datagrid-content"><code>@mp.ExternalProductId</code></div>
                                                </div>
                                            }
                                            @if (mp.ContentId.HasValue)
                                            {
                                                <div class="datagrid-item">
                                                    <div class="datagrid-title">Content ID</div>
                                                    <div class="datagrid-content"><code>@mp.ContentId</code></div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(mp.BatchRequestId))
                                            {
                                                <div class="datagrid-item">
                                                    <div class="datagrid-title">Batch Request ID</div>
                                                    <div class="datagrid-content"><code>@mp.BatchRequestId</code></div>
                                                </div>
                                            }
                                            @if (mp.IsApproved.HasValue)
                                            {
                                                <div class="datagrid-item">
                                                    <div class="datagrid-title">Onay Durumu</div>
                                                    <div class="datagrid-content">
                                                        @if (mp.IsApproved.Value)
                                                        {
                                                            <span class="badge bg-green-lt">Onayli</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning-lt">Onay Bekliyor</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            @if (mp.IsArchived.HasValue && mp.IsArchived.Value)
                                            {
                                                <div class="datagrid-item">
                                                    <div class="datagrid-title">Arsiv Durumu</div>
                                                    <div class="datagrid-content">
                                                        <span class="badge bg-secondary-lt">Arsivlenmis</span>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(mp.StatusMessage))
                                            {
                                                <div class="datagrid-item">
                                                    <div class="datagrid-title">Durum Mesaji</div>
                                                    <div class="datagrid-content text-secondary">@mp.StatusMessage</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-lg-4 mt-3 mt-lg-0">
                                        @if (mp.HasCredentials)
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                <button class="btn btn-primary"
                                                        hx-post="/marketplace/matching/@Model.Product.ProductId/sync?mp=@mp.MarketPlaceId"
                                                        hx-swap="none">
                                                    <i class="ti ti-refresh"></i>
                                                    Simdi Senkronize Et
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-body">
                    <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                             model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                             {
                                 Title = "Pazaryeri durumu bulunamadı",
                                 Subtitle = "Bu ürün için pazaryeri senkronizasyon bilgisi mevcut degil."
                             }'/>
                </div>
            </div>
        }

        <!-- Activity Timeline -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Aktivite Gecmisi</h3>
            </div>
            <div class="card-body">
                @if (Model.ActivityTimeline.Count == 0)
                {
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-clock" style="font-size:2.5rem;"></i>
                        </div>
                        <p class="empty-title">Henüz aktivite yok</p>
                        <p class="empty-subtitle text-secondary">
                            Ürün senkronize edildiginde aktivite gecmisi burada gorunecektir.
                        </p>
                    </div>
                }
                else
                {
                    <ul class="timeline">
                        @foreach (var entry in Model.ActivityTimeline)
                        {
                            var iconColor = entry.Status switch
                            {
                                ProductActivityStatus.Success => "bg-green",
                                ProductActivityStatus.Warning => "bg-warning",
                                ProductActivityStatus.Error => "bg-danger",
                                _ => "bg-blue"
                            };
                            <li class="timeline-event">
                                <div class="timeline-event-icon @iconColor"></div>
                                <div class="card timeline-event-card">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center mb-1">
                                            <strong class="me-2">@entry.Message</strong>
                                            @if (!string.IsNullOrWhiteSpace(entry.MarketplaceName))
                                            {
                                                <span class="badge bg-azure-lt me-2">@entry.MarketplaceName</span>
                                            }
                                            @{
                                                var statusBadge = entry.Status switch
                                                {
                                                    ProductActivityStatus.Success => ("bg-green-lt", "Basarili"),
                                                    ProductActivityStatus.Warning => ("bg-warning-lt", "Uyari"),
                                                    ProductActivityStatus.Error => ("bg-danger-lt", "Hata"),
                                                    _ => ("bg-blue-lt", "Bilgi")
                                                };
                                            }
                                            <span class="badge @statusBadge.Item1">@statusBadge.Item2</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                        {
                                            <p class="text-secondary mb-1 small">@entry.Detail</p>
                                        }
                                        <div class="d-flex align-items-center text-secondary small">
                                            <span>@entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                                            @if (!string.IsNullOrWhiteSpace(entry.ReferenceId))
                                            {
                                                <span class="ms-2">Ref: <code>@entry.ReferenceId</code></span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

