@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.BulkCategoryMatchVm

<div class="card border-purple">
    <div class="card-header">
        <h3 class="card-title">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon text-purple me-1" width="24" height="24" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275l5.813 1.912l-5.813 1.912a2 2 0 0 0 -1.275 1.275l-1.912 5.813l-1.912 -5.813a2 2 0 0 0 -1.275 -1.275l-5.813 -1.912l5.813 -1.912a2 2 0 0 0 1.275 -1.275z"/>
            </svg>
            AI Esleme Onerileri
        </h3>
        <div class="card-actions">
            <span class="badge bg-purple-lt">@Model.Suggestions.Count oneri</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table" id="suggestions-table">
            <thead>
                <tr>
                    <th class="w-1">
                        <input type="checkbox" class="form-check-input" checked
                               onchange="toggleSuggestionSelectAll(this)" />
                    </th>
                    <th>Uygulama Kategorisi</th>
                    <th>Onerilen Pazaryeri Kategorisi</th>
                    <th class="w-1">Guven</th>
                    <th>Aciklama</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Suggestions.OrderByDescending(x => x.Confidence))
                {
                    var badgeClass = s.Confidence >= 0.8 ? "bg-green-lt" :
                                     s.Confidence >= 0.5 ? "bg-yellow-lt" : "bg-red-lt";
                    var confidencePct = (int)(s.Confidence * 100);
                    <tr data-app-cat-id="@s.ApplicationCategoryId"
                        data-mp-cat-id="@s.SuggestedMarketPlaceCategoryId"
                        data-mp-cat-name="@s.SuggestedMarketPlaceCategoryName">
                        <td>
                            <input type="checkbox" class="form-check-input suggestion-checkbox"
                                   checked onchange="updateSuggestionCount()" />
                        </td>
                        <td>
                            <strong>@s.ApplicationCategoryName</strong>
                        </td>
                        <td>
                            <span class="text-secondary">@s.SuggestedMarketPlaceCategoryName</span>
                            <small class="d-block text-muted">ID: @s.SuggestedMarketPlaceCategoryId</small>
                        </td>
                        <td>
                            <span class="badge @badgeClass">%@confidencePct</span>
                        </td>
                        <td>
                            <small class="text-muted">@s.Reason</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex align-items-center justify-content-between">
        <span class="text-secondary" id="suggestion-selected-count">@Model.Suggestions.Count oneri secildi</span>
        <button type="button" class="btn btn-purple" id="apply-suggestions-btn"
                onclick="applySuggestions()">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                 stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M5 12l5 5l10 -10"/>
            </svg>
            <span class="apply-label">Secilenleri Uygula</span>
            <span class="spinner-border spinner-border-sm d-none apply-spinner" role="status"></span>
        </button>
    </div>
</div>
