@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.CategorySyncVm
@{
    ViewData.SetPageTitle("Kategori Eşlemesi");
    ViewData.SetActiveNav("marketplace-sync");
    ViewData.SetBreadcrumb(("Pazaryeri Senkronizasyonu", "/marketplace/sync"), ("Kategori Eşlemesi", null));

    var mapped = Model.Summary.MappedCategories;
    var total = Model.Summary.TotalCategories;
    var pct = total > 0 ? (int)(mapped * 100.0 / total) : 0;
}

        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <div class="alert alert-info mb-3">
                <div class="d-flex align-items-center">
                    <i class="ti ti-info-circle icon me-2"></i>
                    <div class="flex-fill">
                        Eşleştirmeyi tamamladığınızda otomatik olarak geri yönlendirileceksiniz.
                    </div>
                    <a href="@Model.ReturnUrl" class="btn btn-sm btn-outline-primary ms-2">
                        <i class="ti ti-arrow-left me-1"></i>Geri Dön
                    </a>
                </div>
            </div>
        }

        <!-- Marketplace Tabs -->
        <div class="card mb-3">
            <div class="card-body p-2">
                <ul class="nav nav-pills">
                    @foreach (var mp in Model.MarketPlaces)
                    {
                        var isActive = mp.Id == Model.SelectedMarketPlaceId;
                        <li class="nav-item">
                            <a class="nav-link @(isActive ? "active" : "")"
                               href="/marketplace/sync/categories?mp=@mp.Id"
                               hx-get="/marketplace/sync/categories?mp=@mp.Id"
                               hx-target="#mapping-content"
                               hx-push-url="true">
                                @mp.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Summary Bar -->
        <div class="card mb-3">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="text-secondary">Eşleme Durumu:</span>
                    </div>
                    <div class="col">
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: @(pct)%"></div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <strong>@mapped / @total</strong> kategori eşlendi
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-success-lt">@mapped eşlendi</span>
                        <span class="badge bg-secondary-lt">@(Model.Summary.UnmappedCategories) eşlenmedi</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mapping Table -->
        <div id="mapping-content">
            @await Html.PartialAsync("~/Features/MarketplaceSync/Views/CategorySync/Partials/_CategoryMappingTable.cshtml", Model)
        </div>
