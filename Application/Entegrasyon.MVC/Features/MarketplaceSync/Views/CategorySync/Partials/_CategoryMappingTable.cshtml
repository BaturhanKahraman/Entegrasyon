@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.CategorySyncVm

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Kategoriler</h3>
        <div class="card-actions">
            <div class="input-icon">
                <span class="input-icon-addon">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                         stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/>
                        <path d="M21 21l-6 -6"/>
                    </svg>
                </span>
                <input type="text" class="form-control form-control-sm" placeholder="Kategori ara..."
                       id="category-search" onkeyup="filterCategoryTable(this.value)">
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table" id="category-mapping-table">
            <thead>
                <tr>
                    <th>Kategori Adi</th>
                    <th>Pazaryeri Kategorisi</th>
                    <th>Durum</th>
                    <th class="w-1">Islem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.AllCategories)
                {
                    <tr class="category-row">
                        <td>
                            <span class="category-name">@cat.Name</span>
                        </td>
                        <td>
                            @if (cat.IsMapped)
                            {
                                <span class="text-secondary">
                                    @(cat.MarketPlaceCategoryName ?? $"ID: {cat.MarketPlaceCategoryId}")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (cat.IsMapped)
                            {
                                <span class="badge bg-success-lt">Eslendi</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Eslenmedi</span>
                            }
                        </td>
                        <td>
                            @if (cat.IsMapped)
                            {
                                <button class="btn btn-outline-danger btn-sm"
                                        hx-post="/marketplace/sync/categories/@cat.Id/unmap?mp=@Model.SelectedMarketPlaceId"
                                        hx-confirm="Bu eslemeyi kaldirmak istediginize emin misiniz?"
                                        hx-swap="none">
                                    Kaldir
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#mapCategoryModal"
                                        data-category-id="@cat.Id"
                                        data-category-name="@cat.Name"
                                        onclick="openMapModal(@cat.Id, '@cat.Name.Replace("'", "\\'")' )">
                                    Esle
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Map Category Modal -->
<div class="modal modal-blur fade" id="mapCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kategori Esle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="mapCategoryForm" method="post" hx-swap="none">
                <div class="modal-body">
                    <p class="text-secondary mb-3">
                        <strong id="modal-category-name"></strong> icin pazaryeri kategorisi secin.
                    </p>
                    <input type="hidden" name="mp" value="@Model.SelectedMarketPlaceId" />
                    <div class="mb-3">
                        <label class="form-label">Pazaryeri Kategori ID</label>
                        <input type="number" class="form-control" name="externalCategoryId" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Pazaryeri Kategori Adi (opsiyonel)</label>
                        <input type="text" class="form-control" name="externalCategoryName" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link" data-bs-dismiss="modal">Iptal</button>
                    <button type="submit" class="btn btn-primary">Esle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openMapModal(categoryId, categoryName) {
        document.getElementById('modal-category-name').textContent = categoryName;
        var form = document.getElementById('mapCategoryForm');
        form.setAttribute('hx-post', '/marketplace/sync/categories/' + categoryId + '/map');
        htmx.process(form);
    }

    function filterCategoryTable(query) {
        var rows = document.querySelectorAll('#category-mapping-table .category-row');
        var lower = query.toLowerCase();
        rows.forEach(function (row) {
            var name = row.querySelector('.category-name').textContent.toLowerCase();
            row.style.display = name.includes(lower) ? '' : 'none';
        });
    }

    document.addEventListener('refreshTable', function () {
        htmx.ajax('GET', window.location.href, { target: '#mapping-content' });
    });
</script>
