@model Entegrasyon.MVC.Features.MarketplaceSync.ViewModels.CategorySyncVm

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Kategoriler</h3>
        <div class="card-actions">
            <div class="input-icon">
                <span class="input-icon-addon">
                    <i class="ti ti-search"></i>
                </span>
                <input type="text" class="form-control form-control-sm" placeholder="Kategori ara..."
                       id="category-search" onkeyup="filterCategoryTable(this.value)">
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter table-hover card-table" id="category-mapping-table">
            <thead>
                <tr>
                    <th>Kategori Adı</th>
                    <th>Pazaryeri Kategorisi</th>
                    <th>Durum</th>
                    <th class="w-1">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.AllCategories)
                {
                    <tr class="category-row">
                        <td>
                            <span class="category-name">@cat.Name</span>
                        </td>
                        <td>
                            @if (cat.IsMapped)
                            {
                                <span class="text-secondary">
                                    @(cat.MarketPlaceCategoryName ?? $"ID: {cat.MarketPlaceCategoryId}")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (cat.IsMapped)
                            {
                                <span class="badge bg-success-lt">Eşlendi</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Eşlenmedi</span>
                            }
                        </td>
                        <td>
                            @if (cat.IsMapped)
                            {
                                <a class="btn btn-outline-secondary btn-sm"
                                   href="/marketplace/sync/categories/@cat.Id/wizard?mp=@Model.SelectedMarketPlaceId">
                                    <i class="ti ti-settings me-1"></i>Yönet
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-outline-primary btn-sm"
                                   href="/marketplace/sync/categories/@cat.Id/wizard?mp=@Model.SelectedMarketPlaceId">
                                    <i class="ti ti-link me-1"></i>Eşle
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function filterCategoryTable(query) {
        var rows = document.querySelectorAll('#category-mapping-table .category-row');
        var lower = query.toLowerCase();
        rows.forEach(function (row) {
            var name = row.querySelector('.category-name').textContent.toLowerCase();
            row.style.display = name.includes(lower) ? '' : 'none';
        });
    }

    document.addEventListener('refreshTable', function () {
        htmx.ajax('GET', window.location.href, { target: '#mapping-content' });
    });

    // Auto-search on page load when search parameter is provided
    (function() {
        var searchTerm = '@Html.Raw((Model.SearchTerm ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))';
        if (searchTerm) {
            var input = document.getElementById('category-search');
            if (input) {
                input.value = searchTerm;
                filterCategoryTable(searchTerm);
            }
        }
    })();
</script>
