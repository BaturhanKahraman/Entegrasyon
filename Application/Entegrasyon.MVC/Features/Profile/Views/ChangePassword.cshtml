@model Entegrasyon.MVC.Features.Profile.ViewModels.ChangePasswordVm

<div class="page-body">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Sifre Degistir</h3>
                    </div>
                    <form method="post" action="/profile/change-password">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

                            <div class="mb-3">
                                <label asp-for="OldPassword" class="form-label">Mevcut Sifre</label>
                                <input asp-for="OldPassword" class="form-control" placeholder="Mevcut sifrenizi girin" autocomplete="current-password" />
                                <span asp-validation-for="OldPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label">Yeni Sifre</label>
                                <input asp-for="NewPassword" class="form-control" placeholder="Yeni sifrenizi girin" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">Yeni Sifre (Tekrar)</label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni sifrenizi tekrar girin" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <a href="/profile" class="btn btn-ghost-secondary">
                                <i class="ti ti-arrow-left me-1"></i>Profile Don
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-lock me-1"></i>Sifre Degistir
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
