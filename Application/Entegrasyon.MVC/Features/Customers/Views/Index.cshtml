@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Customers.CustomerDetailDto>

<div class="d-flex justify-content-end mb-3">
    <a href="/customers/create" class="btn btn-primary">
        <i class="ti ti-plus icon"></i>
        Müşteri Ekle
    </a>
</div>

        <div class="card">
            <div class="card-header">
                <div class="col-auto">
                    <input type="text"
                           class="form-control"
                           name="search"
                           placeholder="Müşteri ara..."
                           value="@ViewBag.Search"
                           hx-get="/customers"
                           hx-trigger="keyup changed delay:300ms"
                           hx-target="#customer-table"
                           hx-swap="outerHTML"
                           hx-include="this"/>
                </div>
            </div>
            <partial name="Partials/_CustomerTable" model="Model"/>
        </div>
