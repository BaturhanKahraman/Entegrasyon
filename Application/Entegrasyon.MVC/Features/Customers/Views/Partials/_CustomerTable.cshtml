@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Customers.CustomerDetailDto>

@{
    string[] avatarTints = { "bg-primary-lt", "bg-azure-lt", "bg-green-lt", "bg-purple-lt", "bg-orange-lt", "bg-teal-lt", "bg-pink-lt" };
}

<div id="customer-table">
    @if (Model.HasItem)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Ad Soyad / Firma</th>
                        <th>Tür</th>
                        <th>Telefon</th>
                        <th>TC / Vergi No</th>
                        <th class="text-center">Satış Sayısı</th>
                        <th>Durum</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Items)
                    {
                        var isCorporate = customer.CustomerType == "Kurumsal" || customer.CustomerType == "Corporate";
                        var displayName = string.IsNullOrEmpty(customer.CorporateName)
                            ? customer.NameSurname
                            : customer.CorporateName;
                        var initial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim().Substring(0, 1).ToUpperInvariant();
                        var tint = avatarTints[customer.Id % avatarTints.Length];
                        <tr data-href="/customers/@customer.Id"
                            role="link"
                            tabindex="0"
                            class="table-row-clickable @(customer.IsActive ? "" : "text-muted")">
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar @tint rounded me-2">@initial</span>
                                    <span class="fw-medium text-truncate">@displayName</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(isCorporate ? "bg-purple-lt" : "bg-blue-lt")">
                                    @(isCorporate ? "Kurumsal" : "Bireysel")
                                </span>
                            </td>
                            <td class="text-secondary">@customer.PhoneNumber</td>
                            <td class="text-secondary">@customer.NationalIdentityOrTaxNumber</td>
                            <td class="text-center">
                                <span class="badge bg-green-lt">@customer.SalesCount</span>
                            </td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="badge bg-success-lt">
                                        <span class="status-dot status-dot-animated bg-success me-2"></span>Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">
                                        <span class="status-dot bg-secondary me-2"></span>Deaktif
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <i class="ti ti-chevron-right text-secondary"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/customers",
                     TargetId = "#customer-table",
                     QueryParams = ViewBag.Search != null
                         ? new Dictionary<string, string> { ["search"] = (string)ViewBag.Search }
                         : new()
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Müşteri bulunamadı",
                         Subtitle = "Henüz müşteri eklenmemiş veya arama kriterinize uygun müşteri yok."
                     }'/>
        </div>
    }
</div>
