@using Entegrasyon.Entity.Help
@model Entegrasyon.MVC.Features.Help.ViewModels.CreateHelpRequestVm
@{
    ViewData.SetPageTitle("Yardım");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <div>
                    <h3 class="card-title">Yardım ve Destek</h3>
                    <p class="card-subtitle">
                        Bir hata mı buldunuz, öneriniz mi var ya da bir sorunuz mu var?
                        Aşağıdaki formu doldurun, ekibimiz en kısa sürede dönüş yapsın.
                    </p>
                </div>
            </div>
            <form method="post" action="/help/new">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label required">Kategori</label>
                        <select asp-for="Category" class="form-select"
                                asp-items="Html.GetEnumSelectList<HelpRequestCategory>()"></select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label required">Konu</label>
                        <input asp-for="Subject" class="form-control" maxlength="200"
                               placeholder="Kısa bir başlık" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label required">Mesaj</label>
                        <textarea asp-for="Message" class="form-control" rows="6" maxlength="4000"
                                  placeholder="Yaşadığınız durumu olabildiğince detaylı anlatın..."></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                        <small class="form-hint">
                            Hata raporlarında ne yaptığınızı ve ne beklediğinizi yazmanız çözümü hızlandırır.
                        </small>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-send me-1"></i>
                        Talebi Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
