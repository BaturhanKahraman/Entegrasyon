<div class="page-body">
    <div class="container-xl">

        <div class="row mb-3">
            <div class="col-auto ms-auto">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRuleModal">
                    <i class="ti ti-plus"></i>
                    Kural Ekle
                </button>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="alert alert-info">
                    <div class="d-flex">
                        <i class="ti ti-info-circle me-2" style="font-size: 1.25rem;"></i>
                        <div>
                            <strong>Fiyatlandirma Kurallari Hakkinda:</strong>
                            Asagidaki kurallar, urun satis fiyatlarinizi pazaryerlerine gore otomatik olarak hesaplamak icin kullanilir.
                            Her kural, temel satis fiyatina ek bir oran veya sabit tutar uygular.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            @{
                var rules = new[]
                {
                    new { Platform = "Trendyol", Icon = "ti-brand-trendyol", Color = "bg-orange", Type = "Oran", Value = "+5%", Formula = "Satis Fiyati × 1.05", Active = true },
                    new { Platform = "Hepsiburada", Icon = "ti-shopping-bag", Color = "bg-red", Type = "Oran", Value = "+3%", Formula = "Satis Fiyati × 1.03", Active = true },
                    new { Platform = "N11", Icon = "ti-storefront", Color = "bg-purple", Type = "Oran", Value = "+4%", Formula = "Satis Fiyati × 1.04", Active = true },
                    new { Platform = "Pazarama", Icon = "ti-building-store", Color = "bg-blue", Type = "Oran", Value = "+2%", Formula = "Satis Fiyati × 1.02", Active = false },
                    new { Platform = "Magaza (Direkt)", Icon = "ti-home", Color = "bg-green", Type = "Sabit", Value = "0%", Formula = "Satis Fiyati (degistirilmez)", Active = true },
                };
            }
            @foreach (var rule in rules)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card @(rule.Active ? "" : "opacity-50")">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <span class="avatar @rule.Color me-3">
                                    <i class="ti @rule.Icon"></i>
                                </span>
                                <div class="flex-fill">
                                    <h4 class="card-title mb-0">@rule.Platform</h4>
                                    <div class="text-secondary small">@rule.Type uygulama</div>
                                </div>
                                <div>
                                    @if (rule.Active)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="text-secondary small">Uygulanan Oran</div>
                                    <div class="fw-bold fs-4 text-primary">@rule.Value</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-secondary small">Formul</div>
                                    <div class="text-monospace small mt-1">@rule.Formula</div>
                                </div>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary flex-fill" disabled>
                                    <i class="ti ti-edit me-1"></i>Duzenle
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" disabled>
                                    @if (rule.Active)
                                    {
                                        <i class="ti ti-toggle-left"></i>
                                    }
                                    else
                                    {
                                        <i class="ti ti-toggle-right"></i>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Kural Oncelik Sirasi</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-secondary">
                            Birden fazla kural ayni urun icin eslestiginde, asagidaki oncelik sirasiyla uygulanir:
                        </p>
                        <ol class="list-group list-group-numbered">
                            <li class="list-group-item">Urun bazli ozel fiyat (en yuksek oncelik)</li>
                            <li class="list-group-item">Kategori bazli fiyat kurali</li>
                            <li class="list-group-item">Platform genel fiyat kurali</li>
                            <li class="list-group-item">Varsayilan satis fiyati (kural yoksa)</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Kural Ekle Modal (demo) -->
<div class="modal modal-blur fade" id="addRuleModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Fiyatlandirma Kurali</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label required">Platform</label>
                    <select class="form-select">
                        <option>Trendyol</option>
                        <option>Hepsiburada</option>
                        <option>N11</option>
                        <option>Pazarama</option>
                        <option>PttAVM</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label required">Kural Tipi</label>
                    <select class="form-select">
                        <option>Yuzdeli Artirim</option>
                        <option>Sabit Tutar Ekleme</option>
                        <option>Sabit Fiyat</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label required">Deger</label>
                    <div class="input-group">
                        <input type="number" class="form-control" placeholder="5" min="0" step="0.1" />
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Kapsam</label>
                    <select class="form-select">
                        <option>Tum Urunler</option>
                        <option>Belirli Kategoriler</option>
                        <option>Belirli Urunler</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link text-secondary me-auto" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" disabled>
                    <i class="ti ti-check me-1"></i>
                    Kaydet (Demo)
                </button>
            </div>
        </div>
    </div>
</div>
