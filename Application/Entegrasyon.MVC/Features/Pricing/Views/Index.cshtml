@using Entegrasyon.Entity.Dtos.Product
@model Entegrasyon.Entity.Pageable<ProductsDetailDto>

        <div class="row g-2 mb-3">
            <div class="col-auto">
                <form method="get" action="/pricing" class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Ürün ara..." value="@ViewBag.Search" />
                    <button class="btn btn-primary" type="submit">
                        <i class="ti ti-search"></i>
                    </button>
                </form>
            </div>
            <div class="col-auto ms-auto">
                <a href="/pricing/rules" class="btn btn-outline-secondary">
                    <i class="ti ti-adjustments"></i>
                    Fiyatlandirma Kurallari
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Ürün Fiyatlari</h3>
                @if (Model != null)
                {
                    <div class="card-actions">
                        <span class="badge bg-blue">@Model.TotalItemCount kayit</span>
                    </div>
                }
            </div>
            @if (Model == null || Model.Items.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <i class="ti ti-currency-lira text-secondary" style="font-size: 2.5rem;"></i>
                    <h3 class="text-secondary mt-2">Ürün bulunamadi</h3>
                    <p class="text-secondary">Arama kriterlerinizi degistirerek tekrar deneyin.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Stok Kodu</th>
                                <th>Ürün Adi</th>
                                <th>Marka</th>
                                <th>Kategori</th>
                                <th>Varyant Sayisi</th>
                                <th>Stok</th>
                                <th class="text-end">Islemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <code>@product.StockCode</code>
                                    </td>
                                    <td>
                                        <a href="/products/@product.Id" class="text-reset">
                                            @product.Title
                                        </a>
                                    </td>
                                    <td class="text-secondary">@product.BrandName</td>
                                    <td class="text-secondary">@product.CategoryName</td>
                                    <td>
                                        @if (product.VariantCount > 1)
                                        {
                                            <span class="badge bg-azure">@product.VariantCount varyant</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">Tekil</span>
                                        }
                                    </td>
                                    <td>
                                        @if (product.TotalCurrentStock <= 0)
                                        {
                                            <span class="badge bg-red">Stok Yok</span>
                                        }
                                        else if (product.TotalCurrentStock < 5)
                                        {
                                            <span class="badge bg-orange">@product.TotalCurrentStock adet</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-green">@product.TotalCurrentStock adet</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                hx-get="/pricing/@product.Id/variants"
                                                hx-target="closest tr"
                                                hx-swap="afterend"
                                                title="Varyant fiyatlarini goster">
                                            <i class="ti ti-currency-lira"></i>
                                            Fiyatlar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.TotalPageCount > 1)
                {
                    <div class="card-footer d-flex align-items-center">
                        <p class="m-0 text-secondary">
                            Toplam <strong>@Model.TotalItemCount</strong> ürün, sayfa <strong>@(Model.CurrentPageIndex + 1)</strong> / <strong>@Model.TotalPageCount</strong>
                        </p>
                        <ul class="pagination m-0 ms-auto">
                            @if (Model.CurrentPageIndex > 0)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/pricing?search=@ViewBag.Search&page=@(Model.CurrentPageIndex)">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            @if (Model.CurrentPageIndex < Model.TotalPageCount - 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/pricing?search=@ViewBag.Search&page=@(Model.CurrentPageIndex + 2)">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
