@model Entegrasyon.Entity.Dtos.Product.ProductDetailDto

<tr class="bg-light">
    <td colspan="8" class="p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>@Model.Title — Varyant Fiyatlari</strong>
            <span class="badge bg-secondary-lt">@Model.ProductVariantsDetails.Count() varyant</span>
        </div>
        <table class="table table-sm table-borderless mb-0">
            <thead>
                <tr>
                    <th>Barkod</th>
                    <th class="text-end">Liste Fiyati</th>
                    <th class="text-end">Satış Fiyati</th>
                    <th class="text-end">Maliyet</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var variant in Model.ProductVariantsDetails)
                {
                    <tr id="price-row-@variant.Id">
                        <td><code>@variant.Barcode</code></td>
                        <td class="text-end">
                            <input type="number" name="listPrice" form="price-form-@variant.Id"
                                   class="form-control form-control-sm text-end" style="width:120px; display:inline-block;"
                                   step="0.01" min="0" value="@variant.ListPrice.ToString("F2")"/>
                        </td>
                        <td class="text-end">
                            <input type="number" name="salePrice" form="price-form-@variant.Id"
                                   class="form-control form-control-sm text-end" style="width:120px; display:inline-block;"
                                   step="0.01" min="0" value="@variant.SalePrice.ToString("F2")"/>
                        </td>
                        <td class="text-end text-secondary">
                            @variant.CostPrice.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))
                        </td>
                        <td>
                            <form id="price-form-@variant.Id"
                                  hx-post="/pricing/variant/@variant.Id/update-price"
                                  hx-swap="none">
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="ti ti-check"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </td>
</tr>
