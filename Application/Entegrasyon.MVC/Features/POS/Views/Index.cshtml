@model Entegrasyon.MVC.Features.POS.ViewModels.POSTerminalVm
@{
    var zReportSessionId = TempData["ZReportSessionId"] as string;
    var lastSaleJson = TempData["pos_last_sale"] as string;
}

@if (!string.IsNullOrEmpty(zReportSessionId))
{
    <div class="alert alert-success alert-dismissible d-flex align-items-center mb-3" role="alert">
        <i class="ti ti-check me-2"></i>
        <div>
            Kasa başarıyla kapatıldı.
            <a href="/pos/z-report/@zReportSessionId" class="alert-link ms-1">Z Raporunu Görüntüle</a>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.HasActiveSession)
{
    <!-- Kasa Aç Dialogu -->
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Kasa Aç</h3>
                        </div>
                        <form method="post" action="/pos/open-session">
                            @Html.AntiForgeryToken()
                            <div class="card-body">
                                <p class="text-secondary mb-3">
                                    Satış işlemlerine başlamak için kasayı açın. Başlangıç tutarını girin.
                                </p>
                                <div class="mb-3">
                                    <label class="form-label">Başlangıç Kasası (TL)</label>
                                    <input type="number" name="openingCash" class="form-control"
                                           step="0.01" min="0" value="0" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Terminal ID (Opsiyonel)</label>
                                    <input type="text" name="terminalId" class="form-control"
                                           placeholder="orn. KASA-01" />
                                </div>
                            </div>
                            <div class="card-footer text-end">
                                <button type="submit" class="btn btn-primary">
                                    Kasayı Aç
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
}
else
{
    <!-- Aktif POS Oturumu -->
    <div class="d-flex justify-content-end mb-3 d-print-none">
        <span class="text-secondary me-3">
            @Model.CashierName
        </span>
        <span class="text-secondary me-3">
            @Model.OpenedAt.ToLocalTime().ToString("HH:mm")
        </span>
        <a href="/pos/x-report" class="btn btn-outline-info me-2">
            <i class="ti ti-file-analytics me-1"></i>X Raporu
        </a>
        <button type="button" class="btn btn-outline-danger"
                hx-get="/pos/close-session-dialog?sessionId=@Model.SessionId"
                hx-target="#modal-container"
                hx-swap="innerHTML">
            Kasayı Kapat
        </button>
    </div>

            <div class="row g-3">
                <!-- Sol Panel: Arama + Sepet -->
                <div class="col-lg-8">
                    <!-- Ürün Arama -->
                    <div class="card mb-3">
                        <div class="card-body py-2">
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-lg"
                                       id="posSearchInput"
                                       placeholder="Barkod okutun veya ürün adı yazın..."
                                       autocomplete="off"
                                       hx-get="/pos/search"
                                       hx-trigger="keyup changed delay:300ms"
                                       hx-target="#search-results"
                                       hx-swap="innerHTML"
                                       name="q" />
                                <div id="search-results"
                                     class="position-absolute w-100 shadow-lg bg-white border rounded-bottom"
                                     style="z-index:1050; top:100%; max-height:350px; overflow-y:auto;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sepet -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Sepet</h3>
                            <div class="card-actions">
                                <form method="post" action="/pos/clear-cart"
                                      hx-post="/pos/clear-cart"
                                      hx-target="#pos-cart"
                                      hx-swap="innerHTML">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-ghost-danger btn-sm">
                                        Sepeti Temizle
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div id="pos-cart">
                            <partial name="~/Features/POS/Views/Partials/_POSCart.cshtml"
                                     model="@(new Entegrasyon.MVC.Features.POS.ViewModels.POSCartVm())" />
                        </div>
                    </div>
                </div>

                <!-- Sag Panel: Müşteri + Odeme -->
                <div class="col-lg-4">
                    <!-- Müşteri Secimi -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h3 class="card-title">Müşteri</h3>
                        </div>
                        <div class="card-body">
                            <div id="pos-customer-badge">
                                <partial name="~/Features/POS/Views/Partials/_POSCustomerBadge.cshtml"
                                         model="@((Model.CustomerId, Model.CustomerName))" />
                            </div>
                            <div class="position-relative mt-2">
                                <div class="input-group">
                                    <input type="text" class="form-control"
                                           id="posCustomerSearchInput"
                                           placeholder="Müşteri ara..."
                                           autocomplete="off"
                                           hx-get="/pos/search-customer"
                                           hx-trigger="keyup changed delay:300ms"
                                           hx-target="#pos-customer-results"
                                           hx-swap="innerHTML"
                                           name="q" />
                                    <button type="button" class="btn btn-outline-primary"
                                            hx-get="/pos/quick-customer-dialog"
                                            hx-target="#modal-container"
                                            hx-swap="innerHTML"
                                            title="Hızlı müşteri ekle">
                                        <i class="ti ti-user-plus"></i>
                                    </button>
                                </div>
                                <div id="pos-customer-results"
                                     class="position-absolute w-100 shadow-lg bg-white border rounded-bottom"
                                     style="z-index:1050; top:100%; max-height:250px; overflow-y:auto;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Oturum Ozeti -->
                    @if (Model.Summary is not null)
                    {
                        <div class="card mb-3">
                            <div class="card-header">
                                <h3 class="card-title">Oturum Özeti</h3>
                            </div>
                            <div class="card-body">
                                <div class="datagrid">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Açılış Kasası</div>
                                        <div class="datagrid-content">@Model.Summary.OpeningCash.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Toplam Satış</div>
                                        <div class="datagrid-content text-green">@Model.Summary.TotalSales.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Nakit</div>
                                        <div class="datagrid-content">@Model.Summary.TotalCash.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Kart</div>
                                        <div class="datagrid-content">@Model.Summary.TotalCard.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">İşlem Sayısı</div>
                                        <div class="datagrid-content">@Model.Summary.TransactionCount</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Beklenen Kasa</div>
                                        <div class="datagrid-content fw-bold">@Model.Summary.ExpectedCash.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Odeme Butonu -->
                    <div class="card">
                        <div class="card-body text-center py-4">
                            <button type="button" id="pos-finalize-btn"
                                    class="btn btn-success w-100 btn-lg"
                                    disabled
                                    hx-get="/pos/payment-dialog?sessionId=@Model.SessionId"
                                    hx-target="#modal-container"
                                    hx-swap="innerHTML">
                                <i class="ti ti-cash icon icon-lg me-1"></i>
                                Satışı Tamamla
                            </button>
                        </div>
                    </div>
                </div>
            </div>

    <!-- Modal Container (swap target for HTMX-loaded modals) -->
    <div id="modal-container"></div>

    @* Satış sonrası fiş teslim modal'ı *@
    @if (!string.IsNullOrEmpty(lastSaleJson))
    {
        <div id="pos-last-sale-data" data-payload='@lastSaleJson' style="display:none"></div>
        @await Html.PartialAsync("Partials/_POSLastSaleModal")
    }

    @section Scripts {
        <script>
            document.getElementById('posSearchInput')?.focus();

            // Satış sonrası fiş teslim modal'ı
            (function () {
                var dataEl = document.getElementById('pos-last-sale-data');
                if (!dataEl) return;

                var payload;
                try { payload = JSON.parse(dataEl.dataset.payload); }
                catch (e) { return; }

                var modalEl = document.getElementById('posLastSaleModal');
                if (!modalEl) return;

                document.getElementById('posLastSaleNumber').textContent = payload.saleNumber || '-';
                document.getElementById('posLastReturnCode').textContent = payload.returnCode || '-';

                function printUrl(mode) {
                    return '/sales/sale/' + payload.saleId + '/print?mode=' + mode;
                }
                document.getElementById('posPrintNormalBtn').addEventListener('click', function () {
                    window.open(printUrl('normal'), '_blank');
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                });
                document.getElementById('posPrintGiftBtn').addEventListener('click', function () {
                    window.open(printUrl('gift'), '_blank');
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                });

                new bootstrap.Modal(modalEl).show();
            })();

            // Sepet dolu/boş durumuna göre "Satışı Tamamla" butonunu toggle et
            function syncFinalizeButton() {
                var btn = document.getElementById('pos-finalize-btn');
                if (!btn) return;
                var hasItems = document.querySelector('#pos-cart tbody tr') !== null;
                btn.disabled = !hasItems;
                // Sepet boşsa modal container'ı temizle (stale modal fix)
                if (!hasItems) {
                    var modal = document.getElementById('modal-container');
                    if (modal) modal.replaceChildren();
                }
            }
            document.body.addEventListener('htmx:afterSwap', function(e) {
                if (e.target && e.target.id === 'pos-cart') syncFinalizeButton();
            });
            // İlk yüklemede de çalıştır
            syncFinalizeButton();

            // Sunucudan gelen toast event'leri için dinleyici (HtmxTriggerWithData('showToast', {message, level}))
            document.body.addEventListener('showToast', function(e) {
                var detail = e.detail || {};
                var msg = detail.message || detail.value || '';
                if (!msg) return;
                if (window.Notyf) {
                    var notyf = window.__notyf || (window.__notyf = new window.Notyf({ duration: 3000, ripple: true, dismissible: true }));
                    if (detail.level === 'error') notyf.error(msg); else notyf.success(msg);
                } else {
                    alert(msg);
                }
            });

            // Varyant seçimi — arama sonuçlarında tek varyant satırı veya chip'e tıklandığında
            function posAddVariantToCart(productId, variantId, variantSummary) {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                htmx.ajax('POST', '/pos/add-item', {
                    target: '#pos-cart',
                    swap: 'innerHTML',
                    values: {
                        productId: productId,
                        variantId: variantId,
                        variantSummary: variantSummary || '',
                        __RequestVerificationToken: token
                    }
                });
                var results = document.getElementById('search-results');
                if (results) results.replaceChildren();
                var input = document.getElementById('posSearchInput');
                if (input) { input.value = ''; input.focus(); }
            }

            document.addEventListener('click', function(e) {
                var btn = e.target.closest('[data-pos-select-variant]');
                if (!btn) return;
                e.preventDefault();
                if (btn.classList.contains('disabled')) return;
                posAddVariantToCart(
                    btn.getAttribute('data-product-id'),
                    btn.getAttribute('data-variant-id'),
                    btn.getAttribute('data-variant-summary')
                );
            });

            // Barkod exact match — arama sonucu swap olduğunda otomatik sepete ekle
            document.body.addEventListener('htmx:afterSwap', function(e) {
                if (!e.target || e.target.id !== 'search-results') return;
                var auto = e.target.querySelector('[data-pos-auto-add]');
                if (!auto) return;
                posAddVariantToCart(
                    auto.getAttribute('data-product-id'),
                    auto.getAttribute('data-variant-id'),
                    auto.getAttribute('data-variant-summary')
                );
            });

            // Müşteri seçimi — arama sonuçları tıklandığında
            document.addEventListener('click', function(e) {
                var btn = e.target.closest('[data-pos-select-customer]');
                if (!btn) return;
                e.preventDefault();
                var customerId = btn.getAttribute('data-pos-select-customer');
                var customerName = btn.getAttribute('data-customer-name');
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                htmx.ajax('POST', '/pos/select-customer', {
                    target: '#pos-customer-badge',
                    swap: 'innerHTML',
                    values: {
                        customerId: customerId,
                        customerName: customerName,
                        __RequestVerificationToken: token
                    }
                });
                document.getElementById('pos-customer-results').replaceChildren();
                document.getElementById('posCustomerSearchInput').value = '';
            });
        </script>
    }
}
