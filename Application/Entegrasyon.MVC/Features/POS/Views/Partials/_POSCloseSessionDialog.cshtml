@model Entegrasyon.MVC.Features.POS.ViewModels.POSCloseSessionDialogVm

@{
    var culture = new System.Globalization.CultureInfo("tr-TR");
}

<div class="modal modal-blur show" style="display:block" tabindex="-1" id="pos-close-session-modal">
<div class="modal-dialog modal-md">
    <div class="modal-content">
        <form method="post" action="/pos/close-session" id="closeSessionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sessionId" value="@Model.SessionId" />

            <div class="modal-header">
                <h5 class="modal-title">Kasayı Kapat</h5>
                <button type="button" class="btn-close" onclick="closePosCloseSessionModal()" aria-label="Kapat"></button>
            </div>

            <div class="modal-body">
                <!-- Oturum Ozeti -->
                <h4 class="mb-3">Oturum Özeti</h4>
                <div class="datagrid mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title">İşlem Sayısı</div>
                        <div class="datagrid-content">
                            <span class="badge bg-secondary-lt">@Model.TransactionCount</span>
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Toplam Satış</div>
                        <div class="datagrid-content text-green fw-bold">@Model.TotalSales.ToString("C", culture)</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Açılış Kasası</div>
                        <div class="datagrid-content">@Model.OpeningCash.ToString("C", culture)</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Nakit Satışlar</div>
                        <div class="datagrid-content">@Model.TotalCash.ToString("C", culture)</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Kart Satışlar</div>
                        <div class="datagrid-content">@Model.TotalCard.ToString("C", culture)</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Beklenen Kasa</div>
                        <div class="datagrid-content fw-bold text-primary"
                             id="csExpectedCash"
                             data-amount="@Model.ExpectedCash">@Model.ExpectedCash.ToString("C", culture)</div>
                    </div>
                </div>

                <hr />

                <!-- Kasa Mutabakat -->
                <h4 class="mb-3">Kasa Mutabakatı</h4>
                <div class="mb-3">
                    <label class="form-label">Kasadaki Gerçek Nakit (TL)</label>
                    <input type="number" name="closingCash" id="csClosingCash"
                           class="form-control form-control-lg" step="0.01" min="0" required
                           placeholder="Kasadaki nakit tutarı girin" />
                </div>

                <div id="csDifferenceRow" class="alert py-2 mb-0" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Fark:</span>
                        <span class="fw-bold fs-3" id="csDifferenceAmount">0.00 TL</span>
                    </div>
                    <div class="text-secondary small" id="csDifferenceLabel"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ghost-secondary" onclick="closePosCloseSessionModal()">İptal</button>
                <button type="submit" class="btn btn-danger">Kasayı Kapat</button>
            </div>
        </form>
    </div>
</div>
</div>
<div class="modal-backdrop fade show" onclick="closePosCloseSessionModal()"></div>

<script>
(function() {
    window.closePosCloseSessionModal = function() {
        var container = document.getElementById('modal-container');
        if (container) {
            while (container.firstChild) container.removeChild(container.firstChild);
        }
    };

    var expected = parseFloat(document.getElementById('csExpectedCash').dataset.amount);
    var closingInput = document.getElementById('csClosingCash');
    var diffRow = document.getElementById('csDifferenceRow');
    var diffAmount = document.getElementById('csDifferenceAmount');
    var diffLabel = document.getElementById('csDifferenceLabel');

    function updateDifference() {
        var actual = parseFloat(closingInput.value) || 0;
        var diff = actual - expected;

        if (closingInput.value === '') {
            diffRow.style.display = 'none';
            return;
        }

        diffRow.style.display = 'block';

        if (Math.abs(diff) < 0.01) {
            diffRow.className = 'alert alert-success py-2 mb-0';
            diffAmount.textContent = '0.00 TL';
            diffLabel.textContent = 'Kasa tutarlı.';
        } else if (diff > 0) {
            diffRow.className = 'alert alert-warning py-2 mb-0';
            diffAmount.textContent = '+' + diff.toFixed(2) + ' TL';
            diffLabel.textContent = 'Kasada fazla nakit var.';
        } else {
            diffRow.className = 'alert alert-danger py-2 mb-0';
            diffAmount.textContent = diff.toFixed(2) + ' TL';
            diffLabel.textContent = 'Kasada eksik nakit var.';
        }
    }

    closingInput.addEventListener('input', updateDifference);
})();
</script>
