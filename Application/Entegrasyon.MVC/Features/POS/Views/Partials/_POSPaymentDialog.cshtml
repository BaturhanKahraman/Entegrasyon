@using Entegrasyon.Entity.Sales
@using Entegrasyon.MVC.Features.POS.ViewModels
@using System.Globalization
@model POSPaymentDialogVm
@{
    var tr = new CultureInfo("tr-TR");
}

<div class="modal modal-blur show" style="display:block" tabindex="-1" id="posPaymentModal">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <form id="pos-payment-form" method="post" action="/pos/complete-sale">
            @Html.AntiForgeryToken()
            <input type="hidden" name="submitToken" value="@Model.SubmitToken" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ödeme — @Model.ItemCount kalem</h5>
                    <button type="button" class="btn-close" onclick="closePosPaymentModal()" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="card card-sm bg-muted-lt">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Ara Toplam (KDV hariç)</div>
                                    <div class="fw-bold">@Model.Subtotal.ToString("C2", tr)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-sm bg-muted-lt">
                                <div class="card-body text-center">
                                    <div class="text-muted small">KDV</div>
                                    <div class="fw-bold">@Model.VatTotal.ToString("C2", tr)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-sm bg-green-lt">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Toplam (KDV dahil)</div>
                                    <div class="fw-bold fs-3" id="pos-grand-total" data-amount="@Model.GrandTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.GrandTotal.ToString("C2", tr)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.HasGeneralDiscount)
                    {
                        <div class="row mb-2 align-items-center">
                            <div class="col text-secondary">
                                Sepet İndirimi
                                @if (!string.IsNullOrEmpty(Model.GeneralDiscountReasonName))
                                {
                                    <span class="small">— @Model.GeneralDiscountReasonName</span>
                                }
                            </div>
                            <div class="col-auto text-end text-success fw-bold">-@Model.GeneralDiscountAmount.ToString("C2", tr)</div>
                        </div>
                    }

                    <div class="mb-3 text-end">
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                hx-get="/pos/cart-discount-dialog"
                                hx-target="#modal-container"
                                hx-swap="innerHTML"
                                hx-trigger="click">
                            <i class="ti ti-discount icon"></i>
                            @(Model.HasGeneralDiscount ? "İndirimi Düzenle" : "İndirim Ekle")
                        </button>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="text-muted small">Ödenen</div>
                                    <div class="fw-bold fs-4" id="pos-paid-total">@((0m).ToString("C2", tr))</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card card-sm" id="pos-remaining-card">
                                <div class="card-body">
                                    <div class="text-muted small">Kalan</div>
                                    <div class="fw-bold fs-4" id="pos-remaining">@Model.GrandTotal.ToString("C2", tr)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <h4>Ödeme Yöntemleri</h4>
                    @if (!Model.PaymentMethods.Any())
                    {
                        <div class="alert alert-warning">
                            Aktif ödeme yöntemi bulunamadı. Lütfen <a href="/settings/payment-methods">Ayarlar → Ödeme Yöntemleri</a> sayfasından ödeme yöntemi ekleyin.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="btn-list" id="pos-method-buttons">
                                @foreach (var method in Model.PaymentMethods)
                                {
                                    <button type="button" class="btn btn-outline-primary pos-add-payment"
                                            data-method-id="@method.Id"
                                            data-method-name="@method.Name"
                                            data-method-icon="@method.Icon"
                                            data-requires-auth="@method.RequiresAuthCode.ToString().ToLower()"
                                            data-requires-cash="@method.RequiresCashInput.ToString().ToLower()">
                                        <i class="@method.Icon me-1"></i>@method.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div id="pos-payment-rows"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" onclick="closePosPaymentModal()">İptal</button>
                    <button type="submit" id="pos-complete-btn" class="btn btn-success" disabled>
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="pos-complete-spinner"></span>
                        <i class="ti ti-check me-1" id="pos-complete-icon"></i>Satışı Tamamla
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="modal-backdrop fade show" onclick="closePosPaymentModal()"></div>

<script>
(function () {
    window.closePosPaymentModal = function () {
        var container = document.getElementById('modal-container');
        if (container) {
            while (container.firstChild) container.removeChild(container.firstChild);
        }
    };

    var grandTotal = parseFloat(document.getElementById('pos-grand-total').dataset.amount) || 0;
    var paidTotalEl = document.getElementById('pos-paid-total');
    var remainingEl = document.getElementById('pos-remaining');
    var remainingCard = document.getElementById('pos-remaining-card');
    var rowsContainer = document.getElementById('pos-payment-rows');
    var completeBtn = document.getElementById('pos-complete-btn');
    var formatter = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' });

    // Double-submit koruması — form gönderildikten sonra butonu devre dışı bırak + spinner
    var paymentForm = document.getElementById('pos-payment-form');
    if (paymentForm) {
        paymentForm.addEventListener('submit', function () {
            completeBtn.disabled = true;
            var spinner = document.getElementById('pos-complete-spinner');
            var icon = document.getElementById('pos-complete-icon');
            if (spinner) spinner.classList.remove('d-none');
            if (icon) icon.classList.add('d-none');
        });
    }

    var nextIndex = 0;

    function recalcTotals() {
        var paid = 0;
        rowsContainer.querySelectorAll('.pos-payment-row').forEach(function (row) {
            var amountInput = row.querySelector('.pos-amount');
            var amt = parseFloat(amountInput.value) || 0;
            paid += amt;

            var requiresCash = row.dataset.requiresCash === 'true';
            if (requiresCash) {
                var cashInput = row.querySelector('.pos-cash-received');
                var changeEl = row.querySelector('.pos-change');
                if (cashInput && changeEl) {
                    var cash = parseFloat(cashInput.value) || 0;
                    var change = Math.max(0, cash - amt);
                    changeEl.textContent = formatter.format(change);
                }
            }
        });

        paidTotalEl.textContent = formatter.format(paid);
        var remaining = grandTotal - paid;
        remainingEl.textContent = formatter.format(remaining);

        if (paid >= grandTotal - 0.005) {
            remainingCard.classList.remove('bg-red-lt');
            remainingCard.classList.add('bg-green-lt');
            completeBtn.disabled = false;
        } else {
            remainingCard.classList.remove('bg-green-lt');
            if (paid > 0) {
                remainingCard.classList.add('bg-red-lt');
            }
            completeBtn.disabled = true;
        }
    }

    function sumCurrentPaid() {
        var sum = 0;
        rowsContainer.querySelectorAll('.pos-amount').forEach(function (i) { sum += parseFloat(i.value) || 0; });
        return sum;
    }

    function buildPaymentRow(idx, methodId, methodName, methodIcon, requiresAuth, requiresCash, defaultAmount) {
        var row = document.createElement('div');
        row.className = 'pos-payment-row card card-sm mb-2';
        row.dataset.requiresCash = requiresCash;

        var methodCell = document.createElement('div');
        methodCell.className = 'col-md-3';
        var methodLabel = document.createElement('div');
        methodLabel.className = 'fw-bold';
        var methodIcon2 = document.createElement('i');
        methodIcon2.className = methodIcon + ' me-1';
        methodLabel.appendChild(methodIcon2);
        methodLabel.appendChild(document.createTextNode(methodName));
        var hiddenId = document.createElement('input');
        hiddenId.type = 'hidden';
        hiddenId.name = 'payments[' + idx + '].PaymentMethodId';
        hiddenId.value = methodId;
        methodCell.appendChild(methodLabel);
        methodCell.appendChild(hiddenId);

        var amountCell = document.createElement('div');
        amountCell.className = 'col-md-3';
        var amountLabel = document.createElement('label');
        amountLabel.className = 'form-label small';
        amountLabel.textContent = 'Tutar';
        var amountInput = document.createElement('input');
        amountInput.type = 'number';
        amountInput.step = '0.01';
        amountInput.min = '0.01';
        amountInput.className = 'form-control pos-amount';
        amountInput.name = 'payments[' + idx + '].Amount';
        amountInput.value = defaultAmount;
        amountInput.required = true;
        amountCell.appendChild(amountLabel);
        amountCell.appendChild(amountInput);

        var rowInner = document.createElement('div');
        rowInner.className = 'row align-items-center';
        rowInner.appendChild(methodCell);
        rowInner.appendChild(amountCell);

        if (requiresCash) {
            var cashCell = document.createElement('div');
            cashCell.className = 'col-md-2';
            var cashLabel = document.createElement('label');
            cashLabel.className = 'form-label small';
            cashLabel.textContent = 'Alınan Nakit';
            var cashInput = document.createElement('input');
            cashInput.type = 'number';
            cashInput.step = '0.01';
            cashInput.min = '0';
            cashInput.className = 'form-control pos-cash-received';
            cashInput.name = 'payments[' + idx + '].CashReceived';
            cashInput.value = defaultAmount;
            cashCell.appendChild(cashLabel);
            cashCell.appendChild(cashInput);

            var changeCell = document.createElement('div');
            changeCell.className = 'col-md-2';
            var changeLabel = document.createElement('label');
            changeLabel.className = 'form-label small';
            changeLabel.textContent = 'Para Üstü';
            var changeDiv = document.createElement('div');
            changeDiv.className = 'form-control-plaintext pos-change fw-bold text-success';
            changeDiv.textContent = formatter.format(0);
            changeCell.appendChild(changeLabel);
            changeCell.appendChild(changeDiv);

            rowInner.appendChild(cashCell);
            rowInner.appendChild(changeCell);

            cashInput.addEventListener('input', recalcTotals);
        }

        if (requiresAuth) {
            var authCell = document.createElement('div');
            authCell.className = 'col-md-3';
            var authLabel = document.createElement('label');
            authLabel.className = 'form-label small';
            authLabel.textContent = 'Provizyon Kodu';
            var authInput = document.createElement('input');
            authInput.type = 'text';
            authInput.className = 'form-control';
            authInput.name = 'payments[' + idx + '].CardAuthCode';
            authCell.appendChild(authLabel);
            authCell.appendChild(authInput);
            rowInner.appendChild(authCell);
        }

        var removeCell = document.createElement('div');
        removeCell.className = 'col-auto ms-auto';
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-sm btn-outline-danger pos-remove-row';
        var removeIcon = document.createElement('i');
        removeIcon.className = 'ti ti-x';
        removeBtn.appendChild(removeIcon);
        removeCell.appendChild(removeBtn);
        rowInner.appendChild(removeCell);

        var cardBody = document.createElement('div');
        cardBody.className = 'card-body';
        cardBody.appendChild(rowInner);
        row.appendChild(cardBody);

        amountInput.addEventListener('input', recalcTotals);
        removeBtn.addEventListener('click', function () {
            row.remove();
            recalcTotals();
        });

        return row;
    }

    function addPaymentRow(methodId, methodName, methodIcon, requiresAuth, requiresCash) {
        var idx = nextIndex++;
        var remaining = Math.max(0, grandTotal - sumCurrentPaid());
        var defaultAmount = remaining.toFixed(2);

        var row = buildPaymentRow(idx, methodId, methodName, methodIcon, requiresAuth, requiresCash, defaultAmount);
        rowsContainer.appendChild(row);
        recalcTotals();
    }

    document.querySelectorAll('.pos-add-payment').forEach(function (btn) {
        btn.addEventListener('click', function () {
            addPaymentRow(
                btn.dataset.methodId,
                btn.dataset.methodName,
                btn.dataset.methodIcon,
                btn.dataset.requiresAuth === 'true',
                btn.dataset.requiresCash === 'true'
            );
        });
    });
})();
</script>
