@using System.Globalization
@model Entegrasyon.MVC.Features.POS.ViewModels.POSCartDiscountDialogVm
@{
    var tr = new CultureInfo("tr-TR");
}

<div class="modal modal-blur fade" tabindex="-1" id="posCartDiscountModal" aria-modal="true" role="dialog">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <form hx-post="/pos/apply-cart-discount"
          hx-target="#pos-cart"
          hx-swap="innerHTML"
          hx-on::after-request="bootstrap.Modal.getInstance(document.getElementById('posCartDiscountModal'))?.hide();">
      @Html.AntiForgeryToken()
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Sepet İndirimi</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div>

        <div class="modal-body">
          <div class="mb-3">
            <div class="text-secondary">Sepet alt toplamı (kalem indirimleri sonrası)</div>
            <div class="fs-2 fw-bold">@Model.SubtotalAfterLineDiscount.ToString("C2", tr)</div>
          </div>

          <div class="mb-3">
            <label class="form-label">İndirim Tipi</label>
            <div class="btn-group w-100" role="group">
              <input type="radio" class="btn-check" name="discountType" id="cd-type-percent" value="percent"
                     checked="@(Model.CurrentType != "amount")" />
              <label class="btn btn-outline-primary" for="cd-type-percent">Yüzde (%)</label>

              <input type="radio" class="btn-check" name="discountType" id="cd-type-amount" value="amount"
                     checked="@(Model.CurrentType == "amount")" />
              <label class="btn btn-outline-primary" for="cd-type-amount">Tutar (₺)</label>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-6" id="cd-percent-wrapper">
              <label class="form-label">Yüzde</label>
              <div class="input-group">
                <input type="number" class="form-control" name="percent" min="1" max="100" step="0.1"
                       value="@(Model.CurrentType == "percent" && Model.CurrentValue > 0 ? Model.CurrentValue.ToString("0.##", CultureInfo.InvariantCulture) : "")"
                       placeholder="0" />
                <span class="input-group-text">%</span>
              </div>
            </div>
            <div class="col-6" id="cd-amount-wrapper">
              <label class="form-label">Tutar</label>
              <div class="input-group">
                <input type="number" class="form-control" name="amount" min="0" step="0.01"
                       value="@(Model.CurrentType == "amount" && Model.CurrentValue > 0 ? Model.CurrentValue.ToString("0.##", CultureInfo.InvariantCulture) : "")"
                       placeholder="0" />
                <span class="input-group-text">₺</span>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">İndirim Nedeni (opsiyonel)</label>
            <select class="form-select" name="reasonId">
              <option value="">— Seçiniz —</option>
              @foreach (var r in Model.Reasons)
              {
                  <option value="@r.Id" selected="@(Model.CurrentReasonId == r.Id)">@r.Name</option>
              }
            </select>
          </div>

          <div class="mb-2">
            <label class="form-label">Not (opsiyonel)</label>
            <input type="text" class="form-control" name="note" maxlength="200"
                   value="@Model.CurrentNote" placeholder="örn. sadık müşteri" />
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-link" data-bs-dismiss="modal">İptal</button>
          @if (Model.CurrentType is not null && Model.CurrentValue > 0)
          {
              <button type="submit" class="btn btn-outline-danger"
                      onclick="document.querySelector('[name=percent]').value='';document.querySelector('[name=amount]').value='';"
                      hx-post="/pos/clear-cart-discount"
                      hx-target="#pos-cart"
                      hx-swap="innerHTML"
                      hx-on::after-request="bootstrap.Modal.getInstance(document.getElementById('posCartDiscountModal'))?.hide();">
                İndirimi Kaldır
              </button>
          }
          <button type="submit" class="btn btn-primary">
            <i class="ti ti-check me-1"></i> Uygula
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const el = document.getElementById('posCartDiscountModal');
    if (!el) return;

    // Bootstrap modal'i proper lifecycle ile baslat — centering + scroll lock + backdrop
    const modal = bootstrap.Modal.getOrCreateInstance(el, { backdrop: true, focus: true });
    modal.show();

    // Kapatilinca DOM'u temizle (modal-container'i bir sonraki indirim icin bos birak)
    el.addEventListener('hidden.bs.modal', function () {
      const container = document.getElementById('modal-container');
      if (container) container.innerHTML = '';
    });

    // Tip toggle — yuzde/tutar secimi
    const wrapP = document.getElementById('cd-percent-wrapper');
    const wrapA = document.getElementById('cd-amount-wrapper');
    const radios = el.querySelectorAll('input[name=discountType]');
    function sync() {
      const sel = el.querySelector('input[name=discountType]:checked')?.value;
      if (wrapP) wrapP.style.opacity = sel === 'percent' ? '1' : '0.5';
      if (wrapA) wrapA.style.opacity = sel === 'amount' ? '1' : '0.5';
      const pIn = el.querySelector('input[name=percent]');
      const aIn = el.querySelector('input[name=amount]');
      if (sel === 'percent' && aIn) aIn.value = '';
      else if (sel === 'amount' && pIn) pIn.value = '';
    }
    radios.forEach(r => r.addEventListener('change', sync));
    sync();
  })();
</script>
