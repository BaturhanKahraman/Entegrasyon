@model Entegrasyon.MVC.Features.POS.ViewModels.POSSearchResultsVm

@if (Model.Products.Count == 0)
{
    <div class="p-3 text-secondary text-center">
        Ürün bulunamadi.
    </div>
}
else
{
    <div class="list-group list-group-flush">
        @foreach (var product in Model.Products)
        {
            <a href="#" class="list-group-item list-group-item-action"
               data-add-product="@product.ProductId">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold">@product.Title</div>
                        <div class="text-secondary small">
                            @product.StockCode
                            @if (!string.IsNullOrEmpty(product.BrandName))
                            {
                                <span class="ms-2">@product.BrandName</span>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge @(product.CurrentStock > 0 ? "bg-green-lt" : "bg-red-lt")">
                            Stok: @product.CurrentStock
                        </span>
                    </div>
                </div>
            </a>
        }
    </div>
}
