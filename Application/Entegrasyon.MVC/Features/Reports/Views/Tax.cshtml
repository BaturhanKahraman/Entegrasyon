@model Entegrasyon.Entity.Dtos.Reports.SalesReportDto
@{
    var vat = ViewBag.VatDeclaration as Entegrasyon.Entity.Dtos.Reports.VatDeclarationDto;
}

        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/tax" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Başlangıç</label>
                        <input type="date" class="form-control" name="startDate" value="@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Bitiş</label>
                        <input type="date" class="form-control" name="endDate" value="@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Gelir</div>
                        <div class="h1 mb-0">@Model.Summary.TotalRevenue.ToString("N2") TL</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam KDV</div>
                        <div class="h1 mb-0">@Model.Summary.TotalTax.ToString("N2") TL</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Net Tutar</div>
                        <div class="h1 mb-0">@((Model.Summary.TotalRevenue - Model.Summary.TotalTax).ToString("N2")) TL</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Satış Sayısı</div>
                        <div class="h1 mb-0">@Model.Summary.TotalSales</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">KDV Beyan Özeti</h3>
                <div class="card-subtitle">Kesilen faturalar (e-Fatura/e-Arşiv) — orana göre matrah ve KDV</div>
            </div>
            @if (vat is null || vat.Lines.Count == 0)
            {
                <div class="empty">
                    <p class="empty-title">Bu dönemde kesilmiş fatura yok</p>
                    <p class="empty-subtitle text-secondary">Seçili tarih aralığında Gönderildi/Kabul Edildi durumunda fatura bulunamadı.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>KDV Oranı</th>
                                <th class="text-end">Matrah</th>
                                <th class="text-end">KDV Tutarı</th>
                                <th class="text-end">Satır</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in vat.Lines)
                            {
                                <tr>
                                    <td><span class="badge bg-azure-lt">%@line.VatRate</span></td>
                                    <td class="text-end">@line.TaxBase.ToString("N2") TL</td>
                                    <td class="text-end">@line.VatAmount.ToString("N2") TL</td>
                                    <td class="text-end text-secondary">@line.LineCount</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>Toplam</td>
                                <td class="text-end">@vat.TotalTaxBase.ToString("N2") TL</td>
                                <td class="text-end">@vat.TotalVat.ToString("N2") TL</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Gunluk Satış Dağılımı</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Satış</th>
                            <th class="text-end">Brut Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.DailySales)
                        {
                            <tr>
                                <td>@day.Date.ToString("dd.MM.yyyy")</td>
                                <td><span class="badge bg-blue-lt">@day.SaleCount</span></td>
                                <td class="text-end">@day.Revenue.ToString("N2") TL</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
