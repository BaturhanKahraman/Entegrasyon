@model Entegrasyon.Entity.Dtos.Reports.SalesReportDto
@{
    var vat = ViewBag.VatDeclaration as Entegrasyon.Entity.Dtos.Reports.VatDeclarationDto;
    var cq = ViewBag.CurrentQuarterVat as Entegrasyon.Entity.Dtos.Reports.VatDeclarationDto;
    var pq = ViewBag.PreviousQuarterVat as Entegrasyon.Entity.Dtos.Reports.VatDeclarationDto;
    decimal cqVat = cq?.TotalVat ?? 0m;
    decimal pqVat = pq?.TotalVat ?? 0m;
    decimal vatDeltaPct = pqVat == 0m ? 0m : Math.Round((cqVat - pqVat) / pqVat * 100m, 1);
    bool vatUp = cqVat >= pqVat;
    var brk = ViewBag.InvoiceBreakdown as Entegrasyon.Entity.Dtos.Reports.InvoiceTypeBreakdownDto;
}

        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/tax" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Başlangıç</label>
                        <input type="date" class="form-control" name="startDate" value="@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Bitiş</label>
                        <input type="date" class="form-control" name="endDate" value="@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                    <div class="col-auto">
                        <a class="btn btn-outline-secondary"
                           href="/reports/tax/print?startDate=@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))&endDate=@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))"
                           target="_blank" rel="noopener">
                            <!-- Download icon (Tabler) -->
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M12 17v-6"/><path d="M9.5 14.5l2.5 2.5l2.5 -2.5"/></svg>
                            PDF / Yazdır
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Gelir</div>
                        <div class="h1 mb-0">@Model.Summary.TotalRevenue.ToString("N2") TL</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam KDV</div>
                        <div class="h1 mb-0">@Model.Summary.TotalTax.ToString("N2") TL</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Net Tutar</div>
                        <div class="h1 mb-0">@((Model.Summary.TotalRevenue - Model.Summary.TotalTax).ToString("N2")) TL</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Satış Sayısı</div>
                        <div class="h1 mb-0">@Model.Summary.TotalSales</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Dönem Karşılaştırması</h3>
                <div class="card-subtitle">Kesilen fatura KDV'si — bu çeyrek vs geçen çeyrek</div>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-sm-4">
                        <div class="subheader">@(ViewBag.PreviousQuarterLabel) (Geçen)</div>
                        <div class="h2 mb-0">@pqVat.ToString("N2") TL</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="subheader">@(ViewBag.CurrentQuarterLabel) (Bu Çeyrek)</div>
                        <div class="h2 mb-0">@cqVat.ToString("N2") TL</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="subheader">Değişim</div>
                        <div class="h2 mb-0 @(vatUp ? "text-green" : "text-red")">
                            <span class="badge @(vatUp ? "bg-green-lt" : "bg-red-lt")">
                                @(vatUp ? "▲" : "▼") %@Math.Abs(vatDeltaPct)
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (brk is not null)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Fatura Türü Dağılımı</h3>
                    <div class="card-subtitle">Seçili dönem — kesilen faturalar (e-Fatura/e-Arşiv) ve faturasız satışlar</div>
                </div>
                <div class="card-body">
                    <div class="row row-cards">
                        <div class="col-sm-4">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="subheader">e-Fatura</div>
                                        <div class="ms-auto"><span class="badge bg-azure-lt">@brk.EInvoice.Count adet</span></div>
                                    </div>
                                    <div class="h2 mb-0 mt-1">@brk.EInvoice.Total.ToString("N2") TL</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="subheader">e-Arşiv</div>
                                        <div class="ms-auto"><span class="badge bg-purple-lt">@brk.EArsiv.Count adet</span></div>
                                    </div>
                                    <div class="h2 mb-0 mt-1">@brk.EArsiv.Total.ToString("N2") TL</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="subheader">Faturasız</div>
                                        <div class="ms-auto">
                                            <span class="badge @(brk.Uninvoiced.Count > 0 ? "bg-yellow-lt" : "bg-green-lt")">@brk.Uninvoiced.Count adet</span>
                                        </div>
                                    </div>
                                    <div class="h2 mb-0 mt-1 @(brk.Uninvoiced.Count > 0 ? "text-yellow" : "")">@brk.Uninvoiced.Total.ToString("N2") TL</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (brk.Uninvoiced.Count > 0)
                    {
                        <div class="text-secondary small mt-2">
                            <strong>@brk.Uninvoiced.Count</strong> satış faturalanmamış — toplam matrah-dahil <strong>@brk.Uninvoiced.Total.ToString("N2") TL</strong>. Muhasebe öncesi fatura kesilmesi gerekebilir.
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">KDV Beyan Özeti</h3>
                <div class="card-subtitle">Kesilen faturalar (e-Fatura/e-Arşiv) — orana göre matrah ve KDV</div>
            </div>
            @if (vat is null || vat.Lines.Count == 0)
            {
                <div class="empty">
                    <p class="empty-title">Bu dönemde kesilmiş fatura yok</p>
                    <p class="empty-subtitle text-secondary">Seçili tarih aralığında Gönderildi/Kabul Edildi durumunda fatura bulunamadı.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>KDV Oranı</th>
                                <th class="text-end">Matrah</th>
                                <th class="text-end">KDV Tutarı</th>
                                <th class="text-end">Satır</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in vat.Lines)
                            {
                                <tr>
                                    <td><span class="badge bg-azure-lt">%@line.VatRate</span></td>
                                    <td class="text-end">@line.TaxBase.ToString("N2") TL</td>
                                    <td class="text-end">@line.VatAmount.ToString("N2") TL</td>
                                    <td class="text-end text-secondary">@line.LineCount</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>Toplam</td>
                                <td class="text-end">@vat.TotalTaxBase.ToString("N2") TL</td>
                                <td class="text-end">@vat.TotalVat.ToString("N2") TL</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Gunluk Satış Dağılımı</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Satış</th>
                            <th class="text-end">Brut Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.DailySales)
                        {
                            <tr>
                                <td>@day.Date.ToString("dd.MM.yyyy")</td>
                                <td><span class="badge bg-blue-lt">@day.SaleCount</span></td>
                                <td class="text-end">@day.Revenue.ToString("N2") TL</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
