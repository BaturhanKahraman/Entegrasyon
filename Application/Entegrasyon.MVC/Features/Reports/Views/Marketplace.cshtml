@model List<Entegrasyon.Entity.Dtos.Reports.MarketplaceSummaryDto>

        <!-- Date Filter -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/marketplace" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Başlangıç</label>
                        <input type="date" class="form-control" name="startDate" value="@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Bitiş</label>
                        <input type="date" class="form-control" name="endDate" value="@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Chart Placeholder -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Pazaryeri Performans Grafigi</h3>
            </div>
            <div class="card-body">
                <div id="marketplace-chart" style="height:300px; display:flex; align-items:center; justify-content:center;">
                    <span class="text-secondary">Grafik alanı— chart kutuphanesi entegre edilecek</span>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Pazaryeri Ozeti</h3>
            </div>
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Pazaryeri</th>
                                <th>Sipariş Sayısı</th>
                                <th>Toplam Gelir</th>
                                <th>Komisyon</th>
                                <th>Ort. Sipariş</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mp in Model)
                            {
                                <tr>
                                    <td><strong>@mp.MarketplaceName</strong></td>
                                    <td>@mp.TotalOrders</td>
                                    <td>@mp.TotalRevenue.ToMoney()</td>
                                    <td>@mp.CommissionPaid.ToMoney()</td>
                                    <td>@mp.AverageOrderValue.ToMoney()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body">
                    <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                             model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                             {
                                 Title = "Pazaryeri verisi yok",
                                 Subtitle = "Secilen tarih araliginda pazaryeri verisi bulunmuyor."
                             }'/>
                </div>
            }
        </div>
