@model Entegrasyon.Entity.Dtos.Reports.InventoryReportDto

        <!-- Summary Cards -->
        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Urun</div>
                        <div class="h1 mb-0">@Model.Summary.TotalProducts</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Stok</div>
                        <div class="h1 mb-0">@Model.Summary.TotalStock</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Dusuk Stok</div>
                        <div class="h1 mb-0 text-yellow">@Model.Summary.LowStockCount</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Stok Bitmis</div>
                        <div class="h1 mb-0 text-red">@Model.Summary.OutOfStockCount</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Envanter Listesi</h3>
            </div>
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Urun</th>
                                <th>Varyant</th>
                                <th>Barkod</th>
                                <th>Sube</th>
                                <th>Mevcut Stok</th>
                                <th>Satilan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductTitle</td>
                                    <td class="text-secondary">@item.VariantTitle</td>
                                    <td class="text-secondary"><code>@(item.Barcode ?? "-")</code></td>
                                    <td class="text-secondary">@item.BranchOfficeName</td>
                                    <td>
                                        <span class="badge @(item.CurrentStock <= 0 ? "bg-red-lt" : "bg-green-lt")">
                                            @item.CurrentStock
                                        </span>
                                    </td>
                                    <td>@item.SoldQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body">
                    <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                             model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                             {
                                 Title = "Envanter verisi yok",
                                 Subtitle = "Henuz envanter kaydi bulunmuyor."
                             }'/>
                </div>
            }
        </div>
