@model List<Entegrasyon.Entity.Dtos.Reports.ProductPerformanceDto>

        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/category-sales" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Başlangıç</label>
                        <input type="date" class="form-control" name="startDate" value="@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Bitiş</label>
                        <input type="date" class="form-control" name="endDate" value="@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>

        @{
            var totalRevenue = Model.Sum(p => p.TotalRevenue);
            var totalSold = Model.Sum(p => p.TotalSold);
        }

        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Ürün</div>
                        <div class="h1 mb-0">@Model.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Satış</div>
                        <div class="h1 mb-0">@totalSold</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Gelir</div>
                        <div class="h1 mb-0">@totalRevenue.ToString("N2") TL</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Ürün Bazli Satış Performansı</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Satilan</th>
                            <th>Gelir</th>
                            <th>İade Oranı</th>
                            <th>Ort. Puan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.OrderByDescending(p => p.TotalRevenue))
                        {
                            <tr>
                                <td>
                                    <a href="/products/@p.ProductId">@p.ProductName</a>
                                </td>
                                <td><span class="badge bg-blue-lt">@p.TotalSold</span></td>
                                <td>@p.TotalRevenue.ToString("N2") TL</td>
                                <td>
                                    <span class="@(p.ReturnRate > 10 ? "text-danger" : "text-secondary")">
                                        %@p.ReturnRate.ToString("F1")
                                    </span>
                                </td>
                                <td>
                                    @if (p.AverageRating > 0)
                                    {
                                        <span class="text-warning"><i class="ti ti-star-filled"></i> @p.AverageRating.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
