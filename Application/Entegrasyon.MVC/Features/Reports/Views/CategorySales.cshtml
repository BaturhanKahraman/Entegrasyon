@model List<Entegrasyon.Entity.Dtos.Reports.ProductPerformanceDto>

        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/category-sales" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Başlangıç</label>
                        <input type="date" class="form-control" name="startDate" value="@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Bitiş</label>
                        <input type="date" class="form-control" name="endDate" value="@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>

        @{
            var totalRevenue = Model.Sum(p => p.TotalRevenue);
            var totalSold = Model.Sum(p => p.TotalSold);
            var channels = ViewBag.ChannelSales as List<Entegrasyon.Entity.Dtos.Reports.ChannelSalesDto> ?? new();
            var seasonal = ViewBag.SeasonalComparison as List<Entegrasyon.Entity.Dtos.Reports.CategorySeasonalDto> ?? new();
            var slow = ViewBag.SlowMovingCategories as List<Entegrasyon.Entity.Dtos.Reports.SlowMovingCategoryDto> ?? new();
            var priceDist = ViewBag.PriceDistribution as List<Entegrasyon.Entity.Dtos.Reports.PriceRangeBucketDto> ?? new();
            string Inv(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }

        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Ürün</div>
                        <div class="h1 mb-0">@Model.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Satış</div>
                        <div class="h1 mb-0">@totalSold</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Gelir</div>
                        <div class="h1 mb-0">@totalRevenue.ToString("N2") TL</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cards mb-3">
            @if (channels.Count > 0)
            {
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">Kanal Bazlı Karşılaştırma</h3>
                                <p class="text-secondary m-0">Mağaza · Storefront · pazaryerleri (liste cirosu)</p>
                            </div>
                        </div>
                        <div class="card-body">
                            <div id="channel-chart" data-apex-chart style="height: 280px;"></div>
                            <script>
                                (function () {
                                    var isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                                    var textColor = isDark ? '#a0aec0' : '#666';
                                    var gridColor = isDark ? '#2c3e56' : '#e0e0e0';
                                    var options = {
                                        chart: { type: 'bar', height: 280, toolbar: { show: false }, fontFamily: 'inherit', background: 'transparent' },
                                        theme: { mode: isDark ? 'dark' : 'light' },
                                        plotOptions: { bar: { columnWidth: '50%', borderRadius: 4, distributed: true } },
                                        series: [{ name: 'Ciro', data: [@Html.Raw(string.Join(",", channels.Select(c => Inv(c.Revenue))))] }],
                                        xaxis: {
                                            categories: [@Html.Raw(string.Join(",", channels.Select(c => "'" + System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(c.Channel) + "'")))],
                                            labels: { style: { colors: textColor } }
                                        },
                                        yaxis: { labels: { style: { colors: textColor }, formatter: function (v) { return v.toLocaleString('tr-TR') + ' ₺'; } } },
                                        legend: { show: false },
                                        grid: { borderColor: gridColor },
                                        tooltip: { y: { formatter: function (v) { return v.toLocaleString('tr-TR') + ' ₺'; } } },
                                        dataLabels: { enabled: false }
                                    };
                                    new ApexCharts(document.querySelector('#channel-chart'), options).render();
                                })();
                            </script>
                        </div>
                    </div>
                </div>
            }

            @if (priceDist.Any(b => b.LineCount > 0))
            {
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">Fiyat Aralığı Dağılımı</h3>
                                <p class="text-secondary m-0">Satılan kalemlerin birim fiyat aralığına göre dağılımı</p>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Fiyat Aralığı</th>
                                        <th class="text-end">Kalem</th>
                                        <th class="text-end">Adet</th>
                                        <th class="text-end">Ciro</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in priceDist)
                                    {
                                        <tr>
                                            <td><span class="badge bg-azure-lt">@b.Label</span></td>
                                            <td class="text-end">@b.LineCount</td>
                                            <td class="text-end">@b.Quantity</td>
                                            <td class="text-end">@b.Revenue.ToString("N2") TL</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (seasonal.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <div>
                        <h3 class="card-title">Sezonsal Trend (Geçen Yıl Aynı Dönem)</h3>
                        <p class="text-secondary m-0">Kategori cirosunun bir önceki yılın aynı dönemiyle karşılaştırması</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Kategori</th>
                                <th class="text-end">Bu Dönem</th>
                                <th class="text-end">Geçen Yıl</th>
                                <th class="text-end">Değişim</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in seasonal)
                            {
                                var up = c.DeltaPercent >= 0;
                                <tr>
                                    <td>@c.CategoryName</td>
                                    <td class="text-end">@c.CurrentRevenue.ToString("N2") TL</td>
                                    <td class="text-end text-secondary">@c.PreviousYearRevenue.ToString("N2") TL</td>
                                    <td class="text-end">
                                        <span class="badge @(up ? "bg-green-lt" : "bg-red-lt")">
                                            @(up ? "▲" : "▼") %@Math.Abs(c.DeltaPercent).ToString("F1")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (slow.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <div>
                        <h3 class="card-title">Yavaş Hareket Uyarısı</h3>
                        <p class="text-secondary m-0">30+ gündür satışı olmayan kategoriler</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Kategori</th>
                                <th>Son Satış</th>
                                <th class="text-end">Gün</th>
                                <th class="text-end">Geçmiş Satış Adedi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in slow)
                            {
                                <tr>
                                    <td>@c.CategoryName</td>
                                    <td class="text-secondary">@(c.LastSaleDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                    <td class="text-end"><span class="badge bg-yellow-lt">@c.DaysSinceLastSale gün</span></td>
                                    <td class="text-end text-secondary">@c.HistoricalQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Ürün Bazli Satış Performansı</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Satilan</th>
                            <th>Gelir</th>
                            <th>İade Oranı</th>
                            <th>Ort. Puan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.OrderByDescending(p => p.TotalRevenue))
                        {
                            <tr>
                                <td>
                                    <a href="/products/@p.ProductId">@p.ProductName</a>
                                </td>
                                <td><span class="badge bg-blue-lt">@p.TotalSold</span></td>
                                <td>@p.TotalRevenue.ToString("N2") TL</td>
                                <td>
                                    <span class="@(p.ReturnRate > 10 ? "text-danger" : "text-secondary")">
                                        %@p.ReturnRate.ToString("F1")
                                    </span>
                                </td>
                                <td>
                                    @if (p.AverageRating > 0)
                                    {
                                        <span class="text-warning"><i class="ti ti-star-filled"></i> @p.AverageRating.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
