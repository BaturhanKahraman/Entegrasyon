@model Entegrasyon.Entity.Dtos.Reports.SalesReportDto

        <!-- Date Filter -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/sales" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Başlangıç</label>
                        <input type="date" class="form-control" name="startDate" value="@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Bitiş</label>
                        <input type="date" class="form-control" name="endDate" value="@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Satış</div>
                        <div class="h1 mb-0">@Model.Summary.TotalSales</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Toplam Gelir</div>
                        <div class="h1 mb-0">@Model.Summary.TotalRevenue.ToMoney()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Ortalama Sipariş</div>
                        <div class="h1 mb-0">@Model.Summary.AverageOrderValue.ToMoney()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Satılan Ürün</div>
                        <div class="h1 mb-0">@Model.Summary.TotalItemsSold</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart Placeholder -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Günlük Satış Grafiği</h3>
            </div>
            <div class="card-body">
                <div id="sales-chart" style="height:300px; display:flex; align-items:center; justify-content:center;">
                    <span class="text-secondary">Grafik alanı— chart kütüphanesi entegre edilecek</span>
                </div>
            </div>
        </div>

        <!-- Top Products -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">En Çok Satan Ürünler</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Varyant</th>
                            <th>Satılan Adet</th>
                            <th>Gelir</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.TopProducts)
                        {
                            <tr>
                                <td>@p.ProductTitle</td>
                                <td class="text-secondary">@p.VariantTitle</td>
                                <td>@p.QuantitySold</td>
                                <td>@p.Revenue.ToMoney()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
