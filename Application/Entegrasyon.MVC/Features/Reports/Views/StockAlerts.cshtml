@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Reports.StockAlertDto>

<div class="page-body">
    <div class="container-xl">
        <!-- Filter -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/stock-alerts" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Minimum Stok Esigi</label>
                        <input type="number" class="form-control" name="threshold" value="@ViewBag.Threshold" min="1" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Dusuk Stoklu Urunler</h3>
            </div>
            <partial name="Partials/_StockAlertTable" model="Model"/>
        </div>
    </div>
</div>
