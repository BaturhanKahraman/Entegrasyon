@model Entegrasyon.Entity.Dtos.Reports.ProfitLossReportDto

        <!-- Date Filter -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="/reports/profit-loss" class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label">Baslangic</label>
                        <input type="date" class="form-control" name="startDate" value="@(((DateOnly)ViewBag.StartDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Bitis</label>
                        <input type="date" class="form-control" name="endDate" value="@(((DateOnly)ViewBag.EndDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Filtrele</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary -->
        <div class="row row-deck row-cards mb-3">
            <div class="col-sm-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Gelir</div>
                        <div class="h1 mb-0 text-green">@Model.Revenue.ToMoney()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Net Kar</div>
                        <div class="h1 mb-0 @(Model.NetProfit >= 0 ? "text-green" : "text-red")">
                            @Model.NetProfit.ToMoney()
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <div class="subheader">Kar Marji</div>
                        <div class="h1 mb-0">%@Model.ProfitMargin.ToString("F1")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Expense Breakdown -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Gider Dagilimi</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ürün Maliyeti</div>
                        <div class="datagrid-content">@Model.CostOfGoods.ToMoney()</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Pazaryeri Komisyonu</div>
                        <div class="datagrid-content">@Model.MarketplaceCommission.ToMoney()</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Kargo Gideri</div>
                        <div class="datagrid-content">@Model.CargoExpense.ToMoney()</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Vergi</div>
                        <div class="datagrid-content">@Model.TaxAmount.ToMoney()</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- By Marketplace -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Pazaryeri Bazinda</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Pazaryeri</th>
                            <th>Gelir</th>
                            <th>Komisyon</th>
                            <th>Net Kar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mp in Model.ByMarketplace)
                        {
                            <tr>
                                <td>@mp.MarketPlaceName</td>
                                <td>@mp.Revenue.ToMoney()</td>
                                <td>@mp.Commission.ToMoney()</td>
                                <td class="@(mp.NetProfit >= 0 ? "text-green" : "text-red")">
                                    @mp.NetProfit.ToMoney()
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
