@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Shipping.ShipmentTrackingDto>

<div id="shipment-table">
    @if (Model.HasItem)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Takip No</th>
                        <th>Kargo Firması</th>
                        <th>Alıcı</th>
                        <th>Durum</th>
                        <th>Son Güncelleme</th>
                        <th>Tahmini Teslim</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shipment in Model.Items)
                    {
                        <tr class="table-row-clickable" data-href="/shipping/@shipment.Id" role="link" tabindex="0">
                            <td><code>@shipment.TrackingNumber</code></td>
                            <td class="text-secondary">@shipment.CargoCompanyName</td>
                            <td class="text-secondary">@(shipment.RecipientName ?? "—")</td>
                            <td>
                                @{
                                    var (badgeClass, label) = shipment.CurrentStatus switch
                                    {
                                        Entegrasyon.Entity.Shipping.ShipmentStatus.Delivered => ("bg-green-lt", "Teslim Edildi"),
                                        Entegrasyon.Entity.Shipping.ShipmentStatus.InTransit => ("bg-blue-lt", "Yolda"),
                                        Entegrasyon.Entity.Shipping.ShipmentStatus.OutForDelivery => ("bg-cyan-lt", "Dağıtımda"),
                                        Entegrasyon.Entity.Shipping.ShipmentStatus.PickedUp => ("bg-yellow-lt", "Teslim Alındı"),
                                        Entegrasyon.Entity.Shipping.ShipmentStatus.Failed => ("bg-red-lt", "Başarısız"),
                                        Entegrasyon.Entity.Shipping.ShipmentStatus.Cancelled => ("bg-secondary-lt", "İptal"),
                                        Entegrasyon.Entity.Shipping.ShipmentStatus.ReturnedToSender => ("bg-orange-lt", "Göndericiye İade"),
                                        _ => ("bg-secondary-lt", "Oluşturuldu")
                                    };
                                }
                                <span class="badge @badgeClass">@label</span>
                            </td>
                            <td class="text-secondary">@(shipment.LastStatusUpdate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                            <td class="text-secondary">@(shipment.EstimatedDeliveryDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-icon btn-ghost-secondary"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Kargo işlemleri">
                                        <i class="ti ti-dots-vertical"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                        <a class="dropdown-item" href="/shipping/@shipment.Id">
                                            <i class="ti ti-eye dropdown-item-icon"></i>
                                            Detayı Gör
                                        </a>
                                        <button type="button" class="dropdown-item"
                                                hx-post="/shipping/@shipment.Id/refresh"
                                                hx-swap="none">
                                            <i class="ti ti-refresh dropdown-item-icon"></i>
                                            Takibi Güncelle
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/shipping",
                     TargetId = "#shipment-table",
                     QueryParams = new Dictionary<string, string>
                     {
                         ["status"] = ViewBag.Status as string ?? ""
                     }
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Kargo kaydı bulunamadı",
                         Subtitle = "Henüz kargo takibi eklenmemiş veya seçili filtrede kayıt yok."
                     }'/>
        </div>
    }
</div>
