@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Shipping.ShipmentTrackingDto>

        <div class="card">
            <div class="card-header">
                <div class="col-auto">
                    <select class="form-select"
                            hx-get="/shipping"
                            hx-trigger="change"
                            hx-target="#shipment-table"
                            hx-swap="outerHTML"
                            name="status">
                        <option value="">Tum Durumlar</option>
                        <option value="Created">Olusturuldu</option>
                        <option value="PickedUp">Teslim Alindi</option>
                        <option value="InTransit">Yolda</option>
                        <option value="OutForDelivery">Dagitimda</option>
                        <option value="Delivered">Teslim Edildi</option>
                        <option value="ReturnedToSender">Gondericiye Iade</option>
                        <option value="Failed">Basarisiz</option>
                        <option value="Cancelled">Iptal</option>
                    </select>
                </div>
            </div>
            <partial name="Partials/_ShipmentTable" model="Model"/>
        </div>
