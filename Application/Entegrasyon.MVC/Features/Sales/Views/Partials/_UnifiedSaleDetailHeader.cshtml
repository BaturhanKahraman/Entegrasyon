@model Entegrasyon.MVC.Features.Sales.ViewModels.UnifiedSaleDetailHeaderViewModel

<div class="card mb-3">
  <div class="card-body d-flex align-items-center justify-content-between">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge @Model.SourceBadgeClass">@Model.SourceLabel</span>
        <span class="badge @Model.StatusBadgeClass">@Model.StatusLabel</span>
      </div>
      <h2 class="mb-0">#@Model.Number</h2>
      <div class="text-muted small mt-1">
        @Model.SaleDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <text> · @Model.Subtitle</text>
        }
      </div>
    </div>
    <div class="dropdown">
      <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="ti ti-dots-vertical me-1"></i> İşlemler
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        @for (int g = 0; g < Model.ActionGroups.Count; g++)
        {
            var group = Model.ActionGroups[g];
            if (!string.IsNullOrWhiteSpace(group.Header))
            {
                <li><h6 class="dropdown-header">@group.Header</h6></li>
            }
            foreach (var action in group.Actions)
            {
                <li>
                  @if (!string.IsNullOrWhiteSpace(action.HxPost))
                  {
                      <button type="button" class="dropdown-item" hx-post="@action.HxPost" hx-swap="none">
                          <i class="ti @action.Icon me-2"></i>@action.Label
                      </button>
                  }
                  else
                  {
                      <a class="dropdown-item" href="@action.Href">
                          <i class="ti @action.Icon me-2"></i>@action.Label
                      </a>
                  }
                </li>
            }
            if (g < Model.ActionGroups.Count - 1)
            {
                <li><hr class="dropdown-divider" /></li>
            }
        }
      </ul>
    </div>
  </div>
</div>
