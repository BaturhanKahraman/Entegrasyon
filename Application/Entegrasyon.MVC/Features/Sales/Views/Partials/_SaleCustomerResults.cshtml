@model Entegrasyon.MVC.Features.Sales.ViewModels.SaleCustomerSearchVm

@if (Model.Customers.Count == 0)
{
    <div class="p-3 text-secondary text-center">
        Musteri bulunamadi
    </div>
}
else
{
    <div class="list-group list-group-flush">
        @foreach (var customer in Model.Customers)
        {
            <a href="#" class="list-group-item list-group-item-action"
               data-select-customer="@customer.Id"
               data-customer-name="@customer.Name">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold">@customer.Name</div>
                        @if (!string.IsNullOrEmpty(customer.Phone))
                        {
                            <div class="text-secondary small">@customer.Phone</div>
                        }
                    </div>
                    <div>
                        <span class="badge bg-blue-lt">@customer.Type</span>
                    </div>
                </div>
            </a>
        }
    </div>
}
