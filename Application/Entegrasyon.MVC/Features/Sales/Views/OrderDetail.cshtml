@model Entegrasyon.Entity.Orders.Order

@{
    var title = Model.OrderNumber ?? Model.Id.ToString()[..8];

    string StatusBadge(string? status) => status switch
    {
        "Created" => "bg-blue-lt text-blue-lt",
        "Picking" => "bg-cyan-lt text-cyan-lt",
        "Invoiced" => "bg-indigo-lt text-indigo-lt",
        "Shipped" => "bg-yellow-lt text-yellow-lt",
        "Delivered" => "bg-green-lt text-green-lt",
        "Cancelled" => "bg-red-lt text-red-lt",
        "UnDelivered" => "bg-orange-lt text-orange-lt",
        "ReturnAccepted" => "bg-purple-lt text-purple-lt",
        _ => "bg-secondary-lt text-secondary-lt"
    };

    string StatusText(string? status) => status switch
    {
        "Created" => "Olusturuldu",
        "Picking" => "Hazirlaniyor",
        "Invoiced" => "Fatura Kesildi",
        "Shipped" => "Kargoya Verildi",
        "Delivered" => "Teslim Edildi",
        "Cancelled" => "Iptal",
        "UnDelivered" => "Teslim Edilemedi",
        "ReturnAccepted" => "İade Onaylandı",
        _ => status ?? "-"
    };

    var displayStatus = Model.MarketplaceOrderStatus
        ?? Model.StorefrontOrderStatus?.ToString()
        ?? null;
}

<div class="d-flex justify-content-end mb-3">
    <div class="btn-list">
        <a href="/orders/@Model.Id/print" class="btn btn-outline-secondary" target="_blank">
            <i class="ti ti-printer icon"></i>
            Yazdir
        </a>
        @if (Model.MarketPlaceId == 1 && Model.MarketplaceOrderStatus == "Created")
        {
            <button class="btn btn-outline-danger"
                    hx-post="/orders/@Model.Id/mark-unsupplied"
                    hx-confirm="Bu Siparişi tedarik edilemez olarak isaretlemek istediginize emin misiniz?"
                    hx-swap="none">
                <i class="ti ti-package-off icon"></i>
                Tedarik Edilemez
            </button>
        }
        <a href="/orders" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left icon"></i>
            Listeye Don
        </a>
    </div>
</div>


        <!-- Order Header Card -->
        <div class="card mb-3">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="mb-1">Sipariş #@title</h2>
                        <div class="text-secondary">
                            @(Model.OrderDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")
                            @if (Model.MarketPlace != null)
                            {
                                <span class="ms-2">
                                    <span class="badge bg-azure-lt">@Model.MarketPlace.Name</span>
                                </span>
                            }
                            else if (!Model.MarketPlaceId.HasValue)
                            {
                                <span class="ms-2"><span class="badge bg-teal-lt">Yerel Sipariş</span></span>
                            }
                        </div>
                    </div>
                    @if (displayStatus != null)
                    {
                        <div class="col-auto">
                            <span class="badge @StatusBadge(displayStatus) fs-5 px-3 py-2">
                                @StatusText(displayStatus)
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row row-cards">
            <!-- Left: Order Details + Items -->
            <div class="col-lg-8">
                <!-- Order Info -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Sipariş Bilgileri</h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Sipariş No</div>
                                <div class="datagrid-content">@(Model.OrderNumber ?? "-")</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Sipariş Tarihi</div>
                                <div class="datagrid-content">
                                    @(Model.OrderDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Pazaryeri</div>
                                <div class="datagrid-content">
                                    @(Model.MarketPlace?.Name ?? (Model.MarketPlaceId.HasValue ? $"ID: {Model.MarketPlaceId}" : "Yerel"))
                                </div>
                            </div>
                            @if (Model.EstimatedDeliveryEndDate.HasValue)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Tahmini Teslimat</div>
                                    <div class="datagrid-content">
                                        @Model.EstimatedDeliveryEndDate.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                    </div>
                                </div>
                            }
                            @if (Model.IsFastDelivery)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Hizli Teslimat</div>
                                    <div class="datagrid-content">
                                        <span class="badge bg-green-lt text-green-fg">Evet</span>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.OrderNote))
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Sipariş Notu</div>
                                    <div class="datagrid-content">@Model.OrderNote</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PaymentMethodType))
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Odeme Yontemi</div>
                                    <div class="datagrid-content">@Model.PaymentMethodType</div>
                                </div>
                            }
                            @if (Model.StorefrontPaymentStatus.HasValue)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Odeme Durumu</div>
                                    <div class="datagrid-content">@Model.StorefrontPaymentStatus</div>
                                </div>
                            }
                            @if (Model.IsGiftWrapped)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Hediye Paketleme</div>
                                    <div class="datagrid-content">
                                        <span class="badge bg-pink-lt text-pink-fg">Evet</span>
                                        @if (!string.IsNullOrWhiteSpace(Model.GiftMessage))
                                        {
                                            <div class="mt-1 text-secondary">@Model.GiftMessage</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title">Sipariş Kalemleri</h3>
                        <div class="card-actions">
                            <span class="text-secondary">@Model.TotalQuantity adet</span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover">
                            <thead>
                                <tr>
                                    <th>Ürün</th>
                                    <th>Barkod</th>
                                    <th>Renk / Beden</th>
                                    <th class="text-end">Adet</th>
                                    <th class="text-end">Birim Fiyat</th>
                                    <th class="text-end">Toplam</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>@(item.MerchantSku ?? "-")</td>
                                        <td class="text-secondary">@(item.Barcode ?? "-")</td>
                                        <td class="text-secondary">
                                            @(item.ProductColor ?? "-") / @(item.ProductSize ?? "-")
                                        </td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("N2") TL</td>
                                        <td class="text-end fw-semibold">@((item.UnitPrice * item.Quantity).ToString("N2")) TL</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end fw-bold">Genel Toplam</td>
                                    <td class="text-end fw-bold text-primary">@Model.TotalPrice.ToString("N2") TL</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right: Customer, Shipping, Payment sidebar -->
            <div class="col-lg-4">
                <!-- Customer Info -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ti ti-user icon me-1"></i>
                            Müşteri Bilgileri
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Ad Soyad</div>
                                <div class="datagrid-content">
                                    @(Model.CustomerFirstName) @(Model.CustomerLastName)
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">E-posta</div>
                                    <div class="datagrid-content">
                                        <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                @if (Model.ShippingAddress != null)
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="ti ti-map-pin icon me-1"></i>
                                Teslimat Adresi
                            </h3>
                        </div>
                        <div class="card-body">
                            <address class="mb-0">
                                @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.Street))
                                {
                                    @Model.ShippingAddress.Street<br />
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.County))
                                {
                                    @Model.ShippingAddress.County<text>, </text>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.City))
                                {
                                    @Model.ShippingAddress.City
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.ZipCode))
                                {
                                    <text> @Model.ShippingAddress.ZipCode</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.Country))
                                {
                                    <br />@Model.ShippingAddress.Country
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.FullAddress))
                                {
                                    <div class="mt-1 text-secondary">@Model.ShippingAddress.FullAddress</div>
                                }
                            </address>
                        </div>
                    </div>
                }

                <!-- Cargo Info -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ti ti-truck icon me-1"></i>
                            Kargo Bilgileri
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Kargo Firmasi</div>
                                <div class="datagrid-content">@(Model.CargoProviderName ?? "-")</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Takip No</div>
                                <div class="datagrid-content">
                                    @if (!string.IsNullOrWhiteSpace(Model.CargoTrackingNumber))
                                    {
                                        if (!string.IsNullOrWhiteSpace(Model.CargoTrackingLink))
                                        {
                                            <a href="@Model.CargoTrackingLink" target="_blank" rel="noopener">
                                                @Model.CargoTrackingNumber
                                                <i class="ti ti-external-link icon ms-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            @Model.CargoTrackingNumber
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Price Summary -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ti ti-receipt icon me-1"></i>
                            Tutar Ozeti
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            @if (Model.SubTotal.HasValue)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Ara Toplam</div>
                                    <div class="datagrid-content">@Model.SubTotal.Value.ToString("N2") TL</div>
                                </div>
                            }
                            @if (Model.ShippingCost.HasValue && Model.ShippingCost > 0)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Kargo Ucreti</div>
                                    <div class="datagrid-content">@Model.ShippingCost.Value.ToString("N2") TL</div>
                                </div>
                            }
                            @if (Model.DiscountAmount.HasValue && Model.DiscountAmount > 0)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Indirim</div>
                                    <div class="datagrid-content text-red">-@Model.DiscountAmount.Value.ToString("N2") TL</div>
                                </div>
                            }
                            @if (Model.IsGiftWrapped && Model.GiftWrappingFee.HasValue && Model.GiftWrappingFee > 0)
                            {
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Hediye Paketleme</div>
                                    <div class="datagrid-content">@Model.GiftWrappingFee.Value.ToString("N2") TL</div>
                                </div>
                            }
                            <div class="datagrid-item">
                                <div class="datagrid-title">Toplam</div>
                                <div class="datagrid-content fw-bold text-primary fs-4">@Model.TotalPrice.ToString("N2") TL</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Update -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ti ti-refresh icon me-1"></i>
                            Durum Guncelle
                        </h3>
                    </div>
                    <div class="card-body">
                        <form hx-post="/orders/@Model.Id/status"
                              hx-swap="none">
                            <div class="mb-3">
                                <select class="form-select" name="newStatus">
                                    <option value="Created" selected="@(displayStatus == "Created")">Olusturuldu</option>
                                    <option value="Picking" selected="@(displayStatus == "Picking")">Hazirlaniyor</option>
                                    <option value="Invoiced" selected="@(displayStatus == "Invoiced")">Fatura Kesildi</option>
                                    <option value="Shipped" selected="@(displayStatus == "Shipped")">Kargoya Verildi</option>
                                    <option value="Delivered" selected="@(displayStatus == "Delivered")">Teslim Edildi</option>
                                    <option value="Cancelled" selected="@(displayStatus == "Cancelled")">Iptal</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="ti ti-check icon me-1"></i>
                                Durumu Guncelle
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
