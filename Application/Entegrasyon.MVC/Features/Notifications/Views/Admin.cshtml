@using Entegrasyon.Entity.Notifications

        <div class="row">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Bildirim Gönder</h3>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/admin/notifications/send">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">Başlık</label>
                                <input type="text" class="form-control" name="title" placeholder="Bildirim başlığı" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mesaj</label>
                                <textarea class="form-control" name="message" rows="4" placeholder="Bildirim içeriği" required></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Önem Derecesi</label>
                                <select class="form-select" name="severity">
                                    @foreach (var s in Enum.GetValues<NotificationSeverity>())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Kategori</label>
                                <select class="form-select" name="category">
                                    @foreach (var c in Enum.GetValues<NotificationCategory>())
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Hedef</label>
                                <select class="form-select" name="target">
                                    <option value="all">Tüm Kullanıcılar</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-send"></i>
                                Bildirim Gönder
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Son Gönderilen Bildirimler</h3>
                    </div>
                    <div class="card-body">
                        @{
                            var notifications = ViewBag.RecentNotifications as List<Notification>;
                        }
                        @if (notifications is null || notifications.Count == 0)
                        {
                            <p class="text-secondary text-center py-4">Henüz bildirim gönderilmemiş.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var n in notifications.Take(20))
                                {
                                    var badgeClass = n.Severity switch
                                    {
                                        NotificationSeverity.Success => "bg-success",
                                        NotificationSeverity.Warning => "bg-warning",
                                        NotificationSeverity.Error => "bg-danger",
                                        _ => "bg-info"
                                    };
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <span class="badge @badgeClass me-1">@n.Severity</span>
                                                <strong>@n.Header</strong>
                                                <p class="text-secondary mb-0 small">@n.Content</p>
                                            </div>
                                            <small class="text-muted">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
