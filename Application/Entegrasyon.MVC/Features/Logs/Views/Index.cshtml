@using Entegrasyon.Entity.Logs
@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Log.ApplicationLogDetailDto>

        <div class="card">
            <div class="card-header">
                <div class="row w-100 g-2">
                    <div class="col-auto">
                        <select class="form-select log-filter"
                                name="logType"
                                hx-get="/logs"
                                hx-trigger="change"
                                hx-target="#log-table"
                                hx-swap="outerHTML"
                                hx-include=".log-filter">
                            <option value="">Tüm Kategoriler</option>
                            @foreach (LogType lt in Enum.GetValues<LogType>())
                            {
                                <option value="@((int)lt)" selected="@(ViewBag.LogType != null && (LogType)ViewBag.LogType == lt)">@lt</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <select class="form-select log-filter"
                                name="logAction"
                                hx-get="/logs"
                                hx-trigger="change"
                                hx-target="#log-table"
                                hx-swap="outerHTML"
                                hx-include=".log-filter">
                            <option value="">Tüm İşlemler</option>
                            @foreach (LogAction la in Enum.GetValues<LogAction>())
                            {
                                <option value="@((int)la)" selected="@(ViewBag.LogAction != null && (LogAction)ViewBag.LogAction == la)">@la</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <input type="text"
                               class="form-control log-filter"
                               name="entityType"
                               value="@(ViewBag.EntityType ?? "")"
                               placeholder="Varlık Türü (örn: BranchOffice)"
                               hx-get="/logs"
                               hx-trigger="keyup changed delay:500ms"
                               hx-target="#log-table"
                               hx-swap="outerHTML"
                               hx-include=".log-filter" />
                    </div>
                    <div class="col-auto">
                        <input type="text"
                               class="form-control log-filter"
                               name="entityId"
                               value="@(ViewBag.EntityId ?? "")"
                               placeholder="Varlık Kimliği"
                               hx-get="/logs"
                               hx-trigger="keyup changed delay:500ms"
                               hx-target="#log-table"
                               hx-swap="outerHTML"
                               hx-include=".log-filter" />
                    </div>
                    @if (!string.IsNullOrEmpty(ViewBag.EntityType as string) || !string.IsNullOrEmpty(ViewBag.EntityId as string))
                    {
                        <div class="col-auto">
                            <a href="/logs" class="btn btn-outline-secondary" title="Varlık filtrelerini temizle">
                                Filtreyi Temizle
                            </a>
                        </div>
                    }
                </div>
            </div>
            <partial name="~/Features/Logs/Views/Partials/_LogTable.cshtml" model="Model"/>
        </div>
