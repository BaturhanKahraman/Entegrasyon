@model List<Entegrasyon.Entity.Webhooks.WebhookSubscription>

        <div class="row">
            <div class="col-md-3">
                <partial name="~/Features/Settings/Views/_SettingsNav.cshtml"/>
            </div>
            <div class="col-md-9">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h3 class="card-title">Webhook Listesi</h3>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addWebhookModal">
                            <i class="ti ti-plus me-1"></i>Webhook Ekle
                        </button>
                    </div>
                    @if (Model.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>URL</th>
                                        <th>Event'ler</th>
                                        <th>başarısız</th>
                                        <th>Son Tetikleme</th>
                                        <th>Durum</th>
                                        <th class="w-1"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var wh in Model)
                                    {
                                        var events = System.Text.Json.JsonSerializer.Deserialize<string[]>(wh.EventTypes) ?? [];
                                        var isDisabledByFailure = wh.FailureCount >= 5;
                                        <tr>
                                            <td>
                                                <code class="text-truncate d-inline-block" style="max-width:200px;" title="@wh.Url">@wh.Url</code>
                                                @if (!string.IsNullOrEmpty(wh.Secret))
                                                {
                                                    <i class="ti ti-lock ms-1 text-success" title="HMAC imzali"></i>
                                                }
                                                <br/>
                                                <button class="btn btn-ghost-secondary btn-sm mt-1"
                                                        hx-get="/settings/webhooks/@wh.Id/logs"
                                                        hx-target="#webhook-logs-@wh.Id"
                                                        hx-swap="innerHTML">
                                                    <i class="ti ti-list-details"></i> Loglar
                                                </button>
                                            </td>
                                            <td>
                                                @foreach (var evt in events)
                                                {
                                                    <span class="badge bg-azure-lt mb-1">@evt</span>
                                                }
                                            </td>
                                            <td>
                                                @if (wh.FailureCount > 0)
                                                {
                                                    <span class="badge bg-red-lt">@wh.FailureCount</span>
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">0</span>
                                                }
                                            </td>
                                            <td class="text-secondary">
                                                @(wh.LastTriggeredAt.HasValue ? wh.LastTriggeredAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Hic")
                                            </td>
                                            <td>
                                                @if (isDisabledByFailure)
                                                {
                                                    <span class="badge bg-red-lt">Otomatik Devre Dışı</span>
                                                }
                                                else if (wh.IsActive)
                                                {
                                                    <span class="badge bg-green-lt">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-lt">Pasif</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-list flex-nowrap">
                                                    <form method="post" action="/settings/webhooks/@wh.Id/toggle" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm @(wh.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                                title="@(wh.IsActive ? "Pasife Al" : "Aktif Et")">
                                                            <i class="ti @(wh.IsActive ? "ti-player-pause" : "ti-player-play")"></i>
                                                        </button>
                                                    </form>
                                                    <form method="post" action="/settings/webhooks/@wh.Id/delete" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Bu webhook\'u silmek istediğinize emin misiniz?')">
                                                            <i class="ti ti-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr id="webhook-logs-@wh.Id" style="display:none;"></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="card-body">
                            <div class="empty py-3">
                                <div class="empty-icon"><i class="ti ti-webhook" style="font-size:2.5rem;"></i></div>
                                <p class="empty-title">Henüz webhook yok</p>
                                <p class="empty-subtitle text-secondary">Dış sistemlere otomatik bildirim göndermek için webhook ekleyin.</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Desteklenen Event'ler -->
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Desteklenen Event'ler</h3></div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item"><div class="datagrid-title">order.created</div><div class="datagrid-content">Yeni sipariş</div></div>
                            <div class="datagrid-item"><div class="datagrid-title">order.status_changed</div><div class="datagrid-content">Sipariş durumu değişti</div></div>
                            <div class="datagrid-item"><div class="datagrid-title">product.stock_updated</div><div class="datagrid-content">Stok güncellendi</div></div>
                            <div class="datagrid-item"><div class="datagrid-title">product.price_updated</div><div class="datagrid-content">Fiyat değişti</div></div>
                            <div class="datagrid-item"><div class="datagrid-title">return.created</div><div class="datagrid-content">İade talebi</div></div>
                            <div class="datagrid-item"><div class="datagrid-title">invoice.created</div><div class="datagrid-content">Fatura kesildi</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

<!-- Add Webhook Modal -->
<div class="modal modal-blur fade" id="addWebhookModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/settings/webhooks/create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Webhook Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Webhook URL</label>
                        <input type="url" name="url" class="form-control" required placeholder="https://example.com/webhook"/>
                        <small class="form-hint">HTTPS zorunludur.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Secret (HMAC-SHA256)</label>
                        <input type="text" name="secret" class="form-control" placeholder="Opsiyonel imzalama anahtari"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Event Tipleri</label>
                        @foreach (var evt in new[] { "order.created", "order.status_changed", "product.stock_updated", "product.price_updated", "return.created", "invoice.created" })
                        {
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="eventTypes" value="@evt"/>
                                <span class="form-check-label">@evt</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Show/hide log rows when HTMX loads them
document.body.addEventListener('htmx:afterSwap', function(evt) {
    if (evt.detail.target.id.startsWith('webhook-logs-')) {
        evt.detail.target.style.display = '';
    }
});
</script>
