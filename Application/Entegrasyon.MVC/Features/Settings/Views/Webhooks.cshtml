        <div class="row">
            <div class="col-md-3">
                <partial name="~/Features/Settings/Views/_SettingsNav.cshtml"/>
            </div>
            <div class="col-md-9">
                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h3 class="card-title">Webhook Listesi</h3>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addWebhookModal">
                            <i class="ti ti-plus me-1"></i>Webhook Ekle
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="empty py-5">
                            <div class="empty-img">
                                <i class="ti ti-webhook" style="font-size:3rem;color:var(--tblr-secondary)"></i>
                            </div>
                            <p class="empty-title mt-3">Henuz webhook tanimlanmamis</p>
                            <p class="empty-subtitle text-secondary">
                                Webhooklar, sisteminizde gerceklesen olaylar hakkinda dis servislere
                                otomatik bildirim gondermenizi saglar.
                            </p>
                            <div class="empty-action">
                                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWebhookModal">
                                    <i class="ti ti-plus me-1"></i>Ilk Webhook'u Ekle
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-secondary small">
                        <i class="ti ti-info-circle me-1"></i>
                        Webhook yonetimi demo amaclidir. Gercek entegrasyon yakin zamanda aktif olacak.
                    </div>
                </div>

                <!-- Desteklenen Olaylar -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title">Desteklenen Olaylar</h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var eventType in new[] {
                                ("order.created", "Siparis Olusturuldu", "ti-shopping-cart"),
                                ("order.status_changed", "Siparis Durumu Degisti", "ti-refresh"),
                                ("product.stock_updated", "Stok Guncellendi", "ti-package"),
                                ("product.price_updated", "Fiyat Guncellendi", "ti-tag"),
                                ("return.created", "Iade Olusturuldu", "ti-arrow-back-up"),
                                ("invoice.created", "Fatura Olusturuldu", "ti-file-invoice")
                            })
                            {
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center p-2 border rounded">
                                        <i class="ti @eventType.Item3 me-2 text-secondary"></i>
                                        <div>
                                            <div class="fw-bold small">@eventType.Item1</div>
                                            <div class="text-secondary small">@eventType.Item2</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Webhook Modal -->
<div class="modal modal-blur fade" id="addWebhookModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Webhook Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label required">Webhook URL</label>
                    <input type="url" class="form-control" placeholder="https://orneksite.com/webhook" />
                    <small class="text-secondary">HTTPS ile baslayan bir URL girin.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label required">Olay Turu</label>
                    <select class="form-select">
                        <option value="">Olay secin...</option>
                        <option value="order.created">order.created — Siparis Olusturuldu</option>
                        <option value="order.status_changed">order.status_changed — Siparis Durumu Degisti</option>
                        <option value="product.stock_updated">product.stock_updated — Stok Guncellendi</option>
                        <option value="product.price_updated">product.price_updated — Fiyat Guncellendi</option>
                        <option value="return.created">return.created — Iade Olusturuldu</option>
                        <option value="invoice.created">invoice.created — Fatura Olusturuldu</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Gizli Anahtar (Secret)</label>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Webhook dogrulama anahtari (opsiyonel)" />
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="ti ti-refresh"></i>
                        </button>
                    </div>
                    <small class="text-secondary">HMAC-SHA256 imzalama icin kullanilacak gizli anahtar.</small>
                </div>
                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" checked />
                        <span class="form-check-label">Webhook aktif</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost-secondary me-auto" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" disabled>Kaydet (Demo)</button>
            </div>
        </div>
