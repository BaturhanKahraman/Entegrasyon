@model List<Entegrasyon.Entity.Dtos.Settings.ApplicationSettingDto>
@{
    var companies = (List<Entegrasyon.Entity.CargoCompany>)(ViewBag.CargoCompanies ?? new List<Entegrasyon.Entity.CargoCompany>());
    var defaultCompany = companies.FirstOrDefault(c => c.IsDefault);
}

        <div class="row">
            <div class="col-md-3">
                <partial name="~/Features/Settings/Views/_SettingsNav.cshtml"/>
            </div>
            <div class="col-md-9">
                <!-- Kargo Ayarlari Form (mevcut ApplicationSettings) -->
                <form method="post" action="/settings/shipping">
                    @Html.AntiForgeryToken()

                    @if (Model.Any())
                    {
                        <div class="card mb-3">
                            <div class="card-header">
                                <h3 class="card-title">Kargo Ayarlari</h3>
                            </div>
                            <div class="card-body">
                                @foreach (var setting in Model)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">@(setting.Description ?? setting.Key)</label>
                                        @if (setting.ValueType == Entegrasyon.Entity.Settings.SettingValueType.Boolean)
                                        {
                                            <label class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox"
                                                       name="settings[@setting.Id]" value="true"
                                                       @(setting.Value == "true" ? "checked" : "") />
                                            </label>
                                            @if (setting.Value != "true")
                                            {
                                                <input type="hidden" name="settings[@setting.Id]" value="false" />
                                            }
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control"
                                                   name="settings[@setting.Id]" value="@setting.Value" />
                                        }
                                    </div>
                                }
                            </div>
                            <div class="card-footer text-end">
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                            </div>
                        </div>
                    }
                </form>

                <!-- Varsayilan Kargo Firmasi -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 class="card-title">Varsayilan Kargo Firmasi</h3>
                    </div>
                    <form method="post" action="/settings/shipping/default-company">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            @if (companies.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label">Kargo Firmasi</label>
                                    <select name="companyId" class="form-select">
                                        @foreach (var company in companies)
                                        {
                                            <option value="@company.Id" selected="@(company.IsDefault)">
                                                @company.Name @(company.IsIntegrated ? "(Entegre)" : "")
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Musteri Kodu</label>
                                    <input type="text" name="customerCode" class="form-control"
                                           value="@defaultCompany?.CustomerCode"
                                           placeholder="Kargo musteri kodu"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">API Anahtari</label>
                                    <input type="password" name="apiKey" class="form-control"
                                           value="@defaultCompany?.ApiKey"
                                           placeholder="Kargo API anahtari"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Secret Key</label>
                                    <input type="password" name="secretKey" class="form-control"
                                           value="@defaultCompany?.SecretKey"
                                           placeholder="Kargo Secret anahtari"/>
                                </div>
                            }
                            else
                            {
                                <p class="text-secondary">
                                    Henuz kargo firmasi tanimlanmamis.
                                    <a href="/shipping/companies">Kargo firmalari sayfasindan</a> ekleyebilirsiniz.
                                </p>
                            }
                        </div>
                        @if (companies.Any())
                        {
                            <div class="card-footer text-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="ti ti-device-floppy me-1"></i>Kaydet
                                </button>
                            </div>
                        }
                    </form>
                </div>

                <!-- Ucretsiz Kargo Esigi -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Ucretsiz Kargo Esigi</h3>
                    </div>
                    <form method="post" action="/settings/shipping/free-shipping">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Minimum Sepet Tutari (TL)</label>
                                        <input type="number" name="threshold" class="form-control" step="0.01" min="0"
                                               value="@(Model.FirstOrDefault(s => s.Key == "FreeShippingThreshold")?.Value ?? "0")"
                                               placeholder="orn. 500"/>
                                        <small class="form-hint">Bu tutarin uzerindeki siparisler ucretsiz kargoya hak kazanir. 0 = ucretsiz kargo yok.</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Kargo Ucreti (TL)</label>
                                        <input type="number" name="fee" class="form-control" step="0.01" min="0"
                                               value="@(Model.FirstOrDefault(s => s.Key == "DefaultShippingFee")?.Value ?? "0")"
                                               placeholder="orn. 25"/>
                                        <small class="form-hint">Esigi asmayan siparisler icin uygulanacak ucret.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i>Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
