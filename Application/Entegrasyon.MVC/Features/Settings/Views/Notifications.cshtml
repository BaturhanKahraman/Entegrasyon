@model List<Entegrasyon.Entity.Dtos.Settings.ApplicationSettingDto>

<div class="page-body">
    <div class="container-xl">
        <div class="row">
            <div class="col-md-3">
                <partial name="~/Features/Settings/Views/_SettingsNav.cshtml"/>
            </div>
            <div class="col-md-9">
                <form method="post" action="/settings/notifications">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Bildirim Ayarlari</h3>
                        </div>
                        <div class="card-body">
                            @if (Model.Any())
                            {
                                @foreach (var setting in Model)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">
                                            @(setting.Description ?? setting.Key)
                                        </label>
                                        @if (setting.ValueType == Entegrasyon.Entity.Settings.SettingValueType.Boolean)
                                        {
                                            <label class="form-check form-switch">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="settings[@setting.Id]"
                                                       value="true"
                                                       @(setting.Value == "true" ? "checked" : "")/>
                                            </label>
                                            @if (setting.Value != "true")
                                            {
                                                <input type="hidden" name="settings[@setting.Id]" value="false"/>
                                            }
                                        }
                                        else
                                        {
                                            <input type="text"
                                                   class="form-control"
                                                   name="settings[@setting.Id]"
                                                   value="@setting.Value"/>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-secondary">Bildirim ayarlari henuz tanimlanmamis.</p>
                            }
                        </div>
                        @if (Model.Any())
                        {
                            <div class="card-footer text-end">
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
