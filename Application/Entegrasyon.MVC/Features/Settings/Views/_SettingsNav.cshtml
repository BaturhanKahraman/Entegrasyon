@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
}

<div class="card">
    <div class="list-group list-group-flush">
        <a href="/settings/general"
           class="list-group-item list-group-item-action @(currentPath.Contains("general") ? "active" : "")">
            <i class="ti ti-settings me-2"></i>
            Genel
        </a>
        <a href="/settings/integrations"
           class="list-group-item list-group-item-action @(currentPath.Contains("integrations") ? "active" : "")">
            <i class="ti ti-link me-2"></i>
            Entegrasyonlar
        </a>
        <a href="/settings/notifications"
           class="list-group-item list-group-item-action @(currentPath.Contains("notifications") ? "active" : "")">
            <i class="ti ti-bell me-2"></i>
            Bildirimler
        </a>
        <a href="/settings/printing"
           class="list-group-item list-group-item-action @(currentPath.Contains("printing") ? "active" : "")">
            <i class="ti ti-printer me-2"></i>
            Yazici
        </a>
        <a href="/settings/tax"
           class="list-group-item list-group-item-action @(currentPath.Contains("tax") ? "active" : "")">
            <i class="ti ti-receipt-tax me-2"></i>
            Vergi Ayarlari
        </a>
        <a href="/settings/shipping"
           class="list-group-item list-group-item-action @(currentPath.Contains("shipping") ? "active" : "")">
            <i class="ti ti-truck me-2"></i>
            Kargo Ayarlari
        </a>
        <a href="/settings/webhooks"
           class="list-group-item list-group-item-action @(currentPath.Contains("webhooks") ? "active" : "")">
            <i class="ti ti-webhook me-2"></i>
            Webhooklar
        </a>
        <a href="/settings/api-keys"
           class="list-group-item list-group-item-action @(currentPath.Contains("api-keys") ? "active" : "")">
            <i class="ti ti-key me-2"></i>
            API Anahtarlari
        </a>
        <a href="/settings/payment-methods"
           class="list-group-item list-group-item-action @(currentPath.Contains("payment-methods") ? "active" : "")">
            <i class="ti ti-cash me-2"></i>
            Ödeme Yöntemleri
        </a>
        <a href="/settings/desktop"
           class="list-group-item list-group-item-action @(currentPath.Contains("desktop") ? "active" : "")">
            <i class="ti ti-device-desktop me-2"></i>
            Masaustu
        </a>
    </div>
</div>
