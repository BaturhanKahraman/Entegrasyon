@model List<Entegrasyon.Entity.Settings.VatRate>

        <div class="row">
            <div class="col-md-3">
                <partial name="~/Features/Settings/Views/_SettingsNav.cshtml"/>
            </div>
            <div class="col-md-9">
                <!-- KDV Oranları Tablosu -->
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h3 class="card-title">KDV Oranları</h3>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addTaxModal">
                            <i class="ti ti-plus me-1"></i>Oran Ekle
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr>
                                    <th>Oran (%)</th>
                                    <th>Ad</th>
                                    <th>Açıklama</th>
                                    <th>Varsayılan</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rate in Model)
                                {
                                    <tr>
                                        <td><strong>%@rate.Rate.ToString("F0")</strong></td>
                                        <td>@rate.Name</td>
                                        <td class="text-secondary">@(rate.Description ?? "-")</td>
                                        <td>
                                            @if (rate.IsDefault)
                                            {
                                                <span class="badge bg-blue-lt">Varsayılan</span>
                                            }
                                            else
                                            {
                                                <form method="post" action="/settings/tax/@rate.Id/set-default" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-ghost-secondary btn-sm" title="Varsayılan yap">
                                                        <i class="ti ti-star"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-list flex-nowrap">
                                                <button class="btn btn-ghost-secondary btn-sm"
                                                        data-bs-toggle="modal" data-bs-target="#editTaxModal-@rate.Id"
                                                        title="Düzenle">
                                                    <i class="ti ti-edit"></i>
                                                </button>
                                                @if (!rate.IsDefault)
                                                {
                                                    <form method="post" action="/settings/tax/@rate.Id/delete" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-ghost-danger btn-sm"
                                                                onclick="return confirm('Bu KDV oranını silmek istediğinize emin misiniz?')"
                                                                title="Sil">
                                                            <i class="ti ti-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Kategori Bazli KDV -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Kategori Bazlı KDV Eşleşme</h3>
                    </div>
                    <div class="card-body">
                        <div class="text-secondary">
                            <i class="ti ti-info-circle me-1"></i>
                            Kategorilere özgü KDV oranı atamak için <a href="/categories">Kategori Yönetimi</a> sayfasından
                            ilgili kategoriyi düzenleyin ve "Varsayılan KDV Oranı" alanını ayarlayın.
                        </div>
                    </div>
                </div>
            </div>
        </div>

<!-- Add Tax Modal -->
<div class="modal modal-blur fade" id="addTaxModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/settings/tax/create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">KDV Oranı Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">KDV Oranı (%)</label>
                        <input type="number" name="rate" class="form-control" step="0.01" min="0" max="100" required placeholder="örn. 20"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Ad</label>
                        <input type="text" name="name" class="form-control" required placeholder="örn. Standart KDV"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <input type="text" name="description" class="form-control" placeholder="örn. Genel mal ve hizmetler"/>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost-secondary me-auto" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Tax Modals (per rate) -->
@foreach (var rate in Model)
{
    <div class="modal modal-blur fade" id="editTaxModal-@rate.Id" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <form method="post" action="/settings/tax/@rate.Id/update">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">KDV Oranı Düzenle</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label required">KDV Oranı (%)</label>
                            <input type="number" name="rate" class="form-control" step="0.01" min="0" max="100" value="@rate.Rate" required/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Ad</label>
                            <input type="text" name="name" class="form-control" value="@rate.Name" required/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Açıklama</label>
                            <input type="text" name="description" class="form-control" value="@rate.Description"/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-ghost-secondary me-auto" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
