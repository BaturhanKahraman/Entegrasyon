@model List<Entegrasyon.Entity.ApiKeys.ApiKey>
@{
    var newKey = TempData["NewApiKey"] as string;
}

        <div class="row">
            <div class="col-md-3">
                <partial name="~/Features/Settings/Views/_SettingsNav.cshtml"/>
            </div>
            <div class="col-md-9">

                @if (newKey is not null)
                {
                    <div class="alert alert-success alert-important mb-3">
                        <div class="d-flex align-items-center">
                            <i class="ti ti-key me-2" style="font-size:1.5rem;"></i>
                            <div>
                                <strong>API anahtarınız oluşturuldu!</strong>
                                <p class="mb-1">Bu anahtarı şimdi kopyalayın. Sayfa yenilendiğinde tekrar gösterilemez.</p>
                                <code class="fs-5 user-select-all">@newKey</code>
                            </div>
                        </div>
                    </div>
                }

                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h3 class="card-title">API Anahtarları</h3>
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addApiKeyModal">
                            <i class="ti ti-plus me-1"></i>Yeni Anahtar
                        </button>
                    </div>
                    @if (Model.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Ad</th>
                                        <th>Prefix</th>
                                        <th>Scope'lar</th>
                                        <th>Son Kullanım</th>
                                        <th>Son Tarih</th>
                                        <th>Durum</th>
                                        <th class="w-1"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var key in Model)
                                    {
                                        var isExpired = key.ExpiresAt.HasValue && key.ExpiresAt.Value < DateTimeOffset.UtcNow;
                                        var scopes = System.Text.Json.JsonSerializer.Deserialize<string[]>(key.Scopes) ?? [];
                                        <tr>
                                            <td class="fw-bold">@key.Name</td>
                                            <td><code>@key.KeyPrefix****</code></td>
                                            <td>
                                                @foreach (var scope in scopes)
                                                {
                                                    <span class="badge bg-azure-lt me-1">@scope</span>
                                                }
                                            </td>
                                            <td class="text-secondary">
                                                @(key.LastUsedAt.HasValue ? key.LastUsedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Hiç")
                                            </td>
                                            <td class="text-secondary">
                                                @(key.ExpiresAt.HasValue ? key.ExpiresAt.Value.ToLocalTime().ToString("dd.MM.yyyy") : "Süresiz")
                                            </td>
                                            <td>
                                                @if (!key.IsActive)
                                                {
                                                    <span class="badge bg-red-lt">İptal</span>
                                                }
                                                else if (isExpired)
                                                {
                                                    <span class="badge bg-orange-lt">Süresi Doldu</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-green-lt">Aktif</span>
                                                }
                                            </td>
                                            <td>
                                                @if (key.IsActive && !isExpired)
                                                {
                                                    <form method="post" action="/settings/api-keys/@key.Id/revoke">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Bu API anahtarını iptal etmek istediğinize emin misiniz?')">
                                                            İptal Et
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="card-body">
                            <div class="empty py-3">
                                <div class="empty-icon"><i class="ti ti-key" style="font-size:2.5rem;"></i></div>
                                <p class="empty-title">Henüz API anahtarı yok</p>
                                <p class="empty-subtitle text-secondary">Dış sistemlerle entegrasyon için API anahtarı oluşturun.</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Kullanim Rehberi -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Kullanım Rehberi</h3>
                    </div>
                    <div class="card-body">
                        <p>API isteklerinizde <code>Authorization</code> header'ini kullanın:</p>
                        <pre class="p-3 bg-dark text-light rounded"><code>Authorization: Bearer ent_xxxxxxxxxxxx</code></pre>
                    </div>
                </div>
            </div>
        </div>

<!-- Add API Key Modal -->
<div class="modal modal-blur fade" id="addApiKeyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/settings/api-keys/create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Yeni API Anahtarı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Anahtar Adı</label>
                        <input type="text" name="name" class="form-control" required placeholder="örn. Mobil Uygulama"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Yetkiler (Scope)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="scopes" value="products:read"/>
                                    <span class="form-check-label">products:read</span>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="scopes" value="products:write"/>
                                    <span class="form-check-label">products:write</span>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="scopes" value="orders:read"/>
                                    <span class="form-check-label">orders:read</span>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="scopes" value="orders:write"/>
                                    <span class="form-check-label">orders:write</span>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="scopes" value="inventory:read"/>
                                    <span class="form-check-label">inventory:read</span>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="scopes" value="inventory:write"/>
                                    <span class="form-check-label">inventory:write</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Son Kullanım Tarihi</label>
                        <input type="date" name="expiresAt" class="form-control"/>
                        <small class="form-hint">Boş bırakılırsa anahtar süresiz olur.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>
