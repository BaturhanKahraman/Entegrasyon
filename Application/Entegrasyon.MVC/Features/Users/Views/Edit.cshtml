@model Entegrasyon.Entity.Dtos.Users.UserEditDetailDto
@{
    var roles = (IEnumerable<Entegrasyon.Entity.User.Role>)(ViewBag.Roles ?? Enumerable.Empty<Entegrasyon.Entity.User.Role>());
}

<div class="d-flex justify-content-end mb-3">
    <a href="/users" class="btn btn-outline-secondary">Listeye Don</a>
</div>

<div class="page-body">
    <div class="container-xl">
        <form method="post" action="/users/@Model.Id/edit">
            <input type="hidden" name="Id" value="@Model.Id"/>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Kullanici Bilgileri</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Ad</label>
                            <input type="text" class="form-control" name="Name" value="@Model.Name"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Soyad</label>
                            <input type="text" class="form-control" name="Surname" value="@Model.Surname"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Kullanici Adi</label>
                            <input type="text" class="form-control" name="UserName" value="@Model.UserName"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">E-posta</label>
                            <input type="email" class="form-control" name="Email" value="@Model.Email"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Rol</label>
                            <select class="form-select" name="RoleIds">
                                <option value="">Rol Secin</option>
                                @foreach (var role in roles)
                                {
                                    @if (Model.RoleIds.Contains(role.Id))
                                    {
                                        <option value="@role.Id" selected>@role.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@role.Id">@role.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Sube</label>
                            <input type="text" class="form-control" value="@Model.DefaultOfficeName" disabled/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsTwoFactorEnabled"
                                       value="true" @(Model.IsTwoFactorAuthActive ? "checked" : "")/>
                                <span class="form-check-label">Iki faktorlu dogrulama</span>
                            </label>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive"
                                       value="true" @(Model.IsActive ? "checked" : "")/>
                                <span class="form-check-label">Aktif</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a href="/users" class="btn btn-ghost-secondary me-2">Iptal</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
</div>
