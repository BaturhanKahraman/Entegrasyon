@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Users.UserDetailListDto>

<div id="user-table">
    @if (Model.HasItem)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Kullanıcı Adı</th>
                        <th>Roller</th>
                        <th>Şube</th>
                        <th>Durum</th>
                        <th>Kayıt Tarihi</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>@user.Name @user.Surname</td>
                            <td class="text-secondary">@user.UserName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(user.RoleNames))
                                {
                                    @foreach (var role in user.RoleNames.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <span class="badge bg-blue-lt me-1">@role</span>
                                    }
                                }   
                            </td>
                            <td class="text-secondary">@user.DefaultOfficeName</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-green-lt">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-red-lt">Pasif</span>
                                }
                            </td>
                            <td class="text-secondary">@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="/users/@user.Id/detail" class="btn btn-sm btn-outline-info">
                                        Detay
                                    </a>
                                    <a href="/users/@user.Id/edit" class="btn btn-sm btn-outline-primary">
                                        Düzenle
                                    </a>
                                    <button class="btn btn-sm btn-outline-warning"
                                            hx-post="/users/@user.Id/toggle-active"
                                            hx-confirm="Kullanıcı durumunu değiştirmek istediğinize emin misiniz?">
                                        @(user.IsActive ? "Pasif Yap" : "Aktif Yap")
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            hx-post="/users/@user.Id/reset-password"
                                            hx-confirm="Bu kullanıcının şifresini sıfırlayıp geçici şifre vermek istediğinize emin misiniz? Mevcut oturumu sonlandırılacaktır.">
                                        Şifre Sıfırla
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            hx-post="/users/@user.Id/delete"
                                            hx-target="closest tr"
                                            hx-swap="outerHTML swap:300ms"
                                            hx-confirm="Bu kullanıcıyı silmek istediğinize emin misiniz?">
                                        Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/users",
                     TargetId = "#user-table",
                     QueryParams = ViewBag.Search != null
                         ? new Dictionary<string, string> { ["search"] = (string)ViewBag.Search }
                         : new()
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Kullanıcı bulunamadı",
                         Subtitle = "Henüz kullanıcı eklenmemiş.",
                         ActionUrl = "/users/create",
                         ActionText = "Yeni Kullanıcı Ekle"
                     }'/>
        </div>
    }
</div>
