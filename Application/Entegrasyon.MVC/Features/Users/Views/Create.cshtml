@model Entegrasyon.Entity.Dtos.Users.AddUserDto
@{
    var roles = (IEnumerable<Entegrasyon.Entity.User.Role>)(ViewBag.Roles ?? Enumerable.Empty<Entegrasyon.Entity.User.Role>());
}

<div class="d-flex justify-content-end mb-3">
    <a href="/users" class="btn btn-outline-secondary">Listeye Don</a>
</div>

        <form method="post" action="/users/create">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Kullanıcı Bilgileri</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Ad</label>
                            <input type="text" class="form-control" name="Name" value="@Model?.Name"/>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Soyad</label>
                            <input type="text" class="form-control" name="Surname" value="@Model?.Surname"/>
                            <span asp-validation-for="Surname" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Kullanıcı Adı</label>
                            <input type="text" class="form-control" name="UserName" value="@Model?.UserName"/>
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">E-posta</label>
                            <input type="email" class="form-control" name="Email" value="@Model?.Email"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Geçici Şifre</label>
                            <input type="password" class="form-control" name="TemporaryPassword"/>
                            <span asp-validation-for="TemporaryPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Rol</label>
                            <select class="form-select" name="RoleId">
                                <option value="">Rol Seçin</option>
                                @foreach (var role in roles)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsTwoFactorEnabled" value="true"/>
                            <span class="form-check-label">İki faktörlü doğrulama</span>
                        </label>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a href="/users" class="btn btn-ghost-secondary me-2">İptal</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
