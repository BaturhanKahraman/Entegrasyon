@model List<Entegrasyon.Entity.User.Role>

<div id="role-table">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Rol Adi</th>
                        <th>Yetki Sayısı</th>
                        <th>Kullanici Sayısı</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr class="table-row-clickable" data-href="/roles/@role.Id/edit" role="link" tabindex="0">
                            <td>
                                <span class="text-reset fw-medium">@role.Name</span>
                            </td>
                            <td>
                                <span class="badge bg-blue-lt">@role.RoleClaims.Count yetki</span>
                            </td>
                            <td>
                                <span class="text-secondary">@role.UsersRoles.Count kullanici</span>
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <button class="btn btn-sm btn-outline-danger"
                                            hx-post="/roles/@role.Id/delete"
                                            hx-target="closest tr"
                                            hx-swap="outerHTML swap:300ms"
                                            hx-confirm="Bu rolu silmek istediginize emin misiniz?">
                                        Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Rol bulunamadı",
                         Subtitle = "Henüz rol tanımlanmamış.",
                         ActionUrl = "/roles/create",
                         ActionText = "Yeni Rol Ekle"
                     }'/>
        </div>
    }
</div>
