@model List<Entegrasyon.Entity.BulkOperations.BulkOperationLog>?

@if (Model != null && Model.Any())
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">İşlem Geçmişi</h3>
            <div class="card-actions">
                <span class="badge bg-blue-lt">@Model.Count işlem</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Dosya</th>
                        <th>Tür</th>
                        <th>Durum</th>
                        <th>Başarılı</th>
                        <th>Hatalı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in Model)
                    {
                        <tr>
                            <td class="text-secondary">@op.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@op.FileName</td>
                            <td>
                                @{
                                    var typeLabel = op.OperationType switch
                                    {
                                        Entegrasyon.Entity.BulkOperations.BulkOperationType.ProductImport => "Ürün Import",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationType.PriceImport => "Fiyat Import",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationType.StockImport => "Stok Import",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationType.ProductExport => "Ürün Export",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationType.PriceExport => "Fiyat Export",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationType.StockExport => "Stok Export",
                                        _ => op.OperationType.ToString()
                                    };
                                }
                                <span class="badge bg-blue-lt">@typeLabel</span>
                            </td>
                            <td>
                                @{
                                    var statusClass = op.Status switch
                                    {
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Completed => "bg-green-lt",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.CompletedWithErrors => "bg-orange-lt",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Failed => "bg-red-lt",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Processing => "bg-yellow-lt",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Cancelled => "bg-secondary-lt",
                                        _ => "bg-azure-lt"
                                    };
                                    var statusLabel = op.Status switch
                                    {
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Completed => "Tamamlandı",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.CompletedWithErrors => "Kısmen Başarılı",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Failed => "Başarısız",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Processing => "İşleniyor",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Pending => "Bekliyor",
                                        Entegrasyon.Entity.BulkOperations.BulkOperationStatus.Cancelled => "İptal Edildi",
                                        _ => op.Status.ToString()
                                    };
                                }
                                <span class="badge @statusClass">@statusLabel</span>
                            </td>
                            <td class="text-green">@op.SuccessCount</td>
                            <td class="text-red">@op.ErrorCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <p class="empty-title">Henüz işlem yapılmamış</p>
                <p class="empty-subtitle text-secondary">Import veya export işlemleri burada görünecektir.</p>
            </div>
        </div>
    </div>
}
