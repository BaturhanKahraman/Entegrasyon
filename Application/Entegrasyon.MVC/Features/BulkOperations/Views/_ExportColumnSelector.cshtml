@model List<Entegrasyon.Entity.Dtos.BulkOperations.ExportColumnDto>?

@if (Model != null && Model.Any())
{
    var exportType = (Entegrasyon.Entity.BulkOperations.BulkOperationType)ViewBag.ExportType;

    <form action="/bulk-operations/export-with-columns" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="type" value="@((int)exportType)" />

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">Kolon Seçimi</h3>
                <div class="btn-list">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="select-all-cols">Tümünü Seç</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="deselect-all-cols">Temizle</button>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Tarih Filtresi <span class="form-label-description text-secondary">(opsiyonel)</span></label>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-calendar"></i>
                                </span>
                                <input type="text" class="form-control" id="export-date-from" name="dateFrom"
                                       placeholder="Başlangıç tarihi" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-calendar"></i>
                                </span>
                                <input type="text" class="form-control" id="export-date-to" name="dateTo"
                                       placeholder="Bitiş tarihi" autocomplete="off" />
                            </div>
                        </div>
                    </div>
                    <small class="form-hint">Boş bırakılırsa tüm kayıtlar dışa aktarılır.</small>
                </div>
                <hr class="my-3" />
                <div class="row">
                    @foreach (var col in Model)
                    {
                        <div class="col-md-4 col-sm-6 mb-2">
                            <label class="form-check">
                                <input class="form-check-input export-col-check" type="checkbox"
                                       name="selectedColumns" value="@col.Key"
                                       @(col.IsDefault ? "checked" : "") />
                                <span class="form-check-label">@col.DisplayName</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">
                    Seçili Kolonlarla İndir
                </button>
            </div>
        </div>
    </form>

    <script>
        document.getElementById('select-all-cols')?.addEventListener('click', function() {
            document.querySelectorAll('.export-col-check').forEach(function(cb) { cb.checked = true; });
        });
        document.getElementById('deselect-all-cols')?.addEventListener('click', function() {
            document.querySelectorAll('.export-col-check').forEach(function(cb) { cb.checked = false; });
        });

        // Tarih filtresi: kullanıcıya TR (d.m.Y) göster, gizli asıl input ISO (Y-m-d) POST etsin.
        // Uygulama form binding'i InvariantCulture kullanıyor (Program.cs) — ISO culture-safe.
        if (typeof flatpickr !== 'undefined') {
            var exportDateOpts = {
                locale: 'tr',
                altInput: true,
                altFormat: 'd.m.Y',
                dateFormat: 'Y-m-d',
                allowInput: true
            };
            flatpickr('#export-date-from', exportDateOpts);
            flatpickr('#export-date-to', exportDateOpts);
        }
    </script>
}
else
{
    <div class="alert alert-warning mt-3">
        Bu tür için kolon bilgisi alınamadı.
    </div>
}
