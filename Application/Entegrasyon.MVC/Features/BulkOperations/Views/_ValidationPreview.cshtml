@model Entegrasyon.Entity.Dtos.BulkOperations.ImportValidationPreviewDto

<div class="card mt-3 border-info">
    <div class="card-header">
        <h3 class="card-title">Doğrulama Sonucu</h3>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="bg-blue-lt text-blue avatar me-3">@Model.TotalRows</span>
                            <div>
                                <div class="font-weight-medium">Toplam Satır</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="bg-green-lt text-green avatar me-3">@Model.ValidRows</span>
                            <div>
                                <div class="font-weight-medium">Geçerli</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <span class="bg-red-lt text-red avatar me-3">@Model.InvalidRows</span>
                            <div>
                                <div class="font-weight-medium">Hatalı</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Errors.Any())
        {
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-vcenter card-table table-sm table-hover">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Satır</th>
                            <th style="width: 150px;">Barkod</th>
                            <th>Hata</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var error in Model.Errors.Take(50))
                        {
                            <tr>
                                <td class="text-secondary">@error.RowNumber</td>
                                <td><code>@(error.Barcode ?? "-")</code></td>
                                <td class="text-danger">@error.ErrorMessage</td>
                            </tr>
                        }
                        @if (Model.Errors.Count > 50)
                        {
                            <tr>
                                <td colspan="3" class="text-secondary text-center">
                                    ... ve @(Model.Errors.Count - 50) hata daha
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.ValidRows > 0)
        {
            <div class="mt-3 d-flex justify-content-end gap-2">
                <button type="button" class="btn" id="cancel-preview-btn">
                    Iptal
                </button>
                <button type="button" class="btn btn-success"
                        hx-post="/bulk-operations/import"
                        hx-include="#import-form"
                        hx-encoding="multipart/form-data"
                        hx-swap="none"
                        hx-confirm="@Model.ValidRows geçerli satır import edilecek. Devam etmek istiyor musunuz?">
                    @Model.ValidRows Satırı Import Et
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-danger mt-3 mb-0">
                Geçerli satır bulunamadı. Dosyayı düzeltip tekrar deneyin.
            </div>
        }
    </div>
</div>

<script>
    document.getElementById('cancel-preview-btn')?.addEventListener('click', function() {
        document.getElementById('validation-preview').textContent = '';
    });
</script>
