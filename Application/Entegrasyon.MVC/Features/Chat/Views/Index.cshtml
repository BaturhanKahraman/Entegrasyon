@model List<Entegrasyon.Entity.Dtos.Chat.ChatConversationListItemDto>

@{
    var activeId = (long?)ViewBag.ActiveConversationId;
    var currentUserId = (Guid)ViewBag.CurrentUserId;
    var messages = ViewBag.Messages as List<Entegrasyon.Entity.Dtos.Chat.ChatMessageDto>;
}

<div class="card" id="chat-container" data-conversation-id="@activeId" data-current-user-id="@currentUserId" style="height: calc(100vh - 200px); min-height: 500px;">
    <div class="row g-0 h-100">
        <!-- Left: Conversation list -->
        <div class="col-12 col-lg-4 col-xl-3 border-end d-flex flex-column">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0">Sohbetler</h3>
                <button class="btn btn-ghost-primary btn-icon" id="btn-new-chat" title="Yeni sohbet">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                         stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12 5l0 14" />
                        <path d="M5 12l14 0" />
                    </svg>
                </button>
            </div>
            <div class="list-group list-group-flush overflow-auto flex-fill" id="conversation-list">
                @if (Model.Count == 0)
                {
                    <div class="text-center text-secondary p-4">
                        <p class="mb-1">Henuz sohbet yok</p>
                        <small>Yeni sohbet baslatmak icin + butonuna tiklayin</small>
                    </div>
                }
                else
                {
                    @foreach (var conv in Model)
                    {
                        var isActive = conv.Id == activeId;
                        <a href="/chat/@conv.Id"
                           class="list-group-item list-group-item-action d-flex align-items-center @(isActive ? "active" : "")"
                           data-conversation-id="@conv.Id">
                            <span class="avatar avatar-sm me-2 bg-primary-lt">
                                @conv.DisplayName.Substring(0, 1).ToUpper()
                            </span>
                            <div class="flex-fill min-width-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-truncate">@conv.DisplayName</strong>
                                    @if (conv.UnreadCount > 0)
                                    {
                                        <span class="badge bg-primary ms-1">@conv.UnreadCount</span>
                                    }
                                </div>
                                @if (conv.LastMessage is not null)
                                {
                                    <div class="text-secondary text-truncate small">@conv.LastMessage</div>
                                }
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Right: Message area -->
        <div class="col-12 col-lg-8 col-xl-9 d-flex flex-column">
            @if (activeId.HasValue && messages is not null)
            {
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        @(Model.FirstOrDefault(c => c.Id == activeId)?.DisplayName ?? "Sohbet")
                    </h3>
                    <div id="typing-indicator" class="text-secondary small ms-2" style="display:none;">
                        yaziyor...
                    </div>
                </div>

                <div class="card-body overflow-auto flex-fill p-3" id="message-area">
                    @foreach (var msg in messages)
                    {
                        var isOwn = msg.SenderId == currentUserId;
                        <div class="d-flex mb-3 @(isOwn ? "justify-content-end" : "justify-content-start")">
                            <div class="@(isOwn ? "bg-primary text-white" : "bg-light") rounded-3 p-2 px-3" style="max-width: 70%;">
                                @if (!isOwn)
                                {
                                    <div class="fw-bold small mb-1">@msg.SenderName</div>
                                }
                                <div>@msg.Content</div>
                                <div class="@(isOwn ? "text-white-50" : "text-secondary") small text-end mt-1">
                                    @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="card-footer">
                    <form id="chat-form" class="d-flex gap-2">
                        <input type="text" id="chat-input" class="form-control"
                               placeholder="Mesajinizi yazin..." autocomplete="off" />
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
                                 stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M10 14l11 -11" />
                                <path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" />
                            </svg>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center flex-fill">
                    <div class="text-center text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg mb-3" width="48" height="48"
                             viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M21 14l-3 -3h-7a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1h9a1 1 0 0 1 1 1v10"/>
                            <path d="M14 15v2a1 1 0 0 1 -1 1h-7l-3 3v-10a1 1 0 0 1 1 -1h2"/>
                        </svg>
                        <h3>Bir sohbet secin</h3>
                        <p>Soldaki listeden bir sohbet secin veya yeni bir sohbet baslatin.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- New chat user selection modal -->
<div class="modal modal-blur" id="new-chat-modal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Sohbet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Kullanici Sec</label>
                    <div id="user-list" class="list-group list-group-flush">
                        <div class="text-center text-secondary p-3">Yukleniyor...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
