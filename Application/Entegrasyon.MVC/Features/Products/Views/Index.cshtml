@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Product.ProductsDetailDto>

<div class="d-flex justify-content-end mb-3">
    <div class="d-flex gap-2">
        <a href="/products/export" class="btn btn-outline-success">
            <i class="ti ti-download icon"></i>
            Excel'e Aktar
        </a>
        <a href="/products/add" class="btn btn-primary">
            <i class="ti ti-plus icon"></i>
            Yeni Ürün
        </a>
    </div>
</div>

        <div class="card">
            <div class="card-header">
                <div class="col-auto">
                    <input type="text"
                           class="form-control"
                           name="search"
                           placeholder="Ürün ara..."
                           value="@ViewBag.Search"
                           hx-get="/products"
                           hx-trigger="keyup changed delay:300ms"
                           hx-target="#product-table"
                           hx-swap="outerHTML"
                           hx-include="this"/>
                </div>
            </div>
            <partial name="Partials/_ProductTable" model="Model"/>
        </div>
