@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Product.ProductsDetailDto>

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="page-pretitle">Yonetim</div>
                <h2 class="page-title">Urunler</h2>
            </div>
            <div class="col-auto ms-auto d-flex gap-2">
                <a href="/products/export" class="btn btn-outline-success">
                    <i class="ti ti-download icon"></i>
                    Excel'e Aktar
                </a>
                <a href="/products/add" class="btn btn-primary">
                    <i class="ti ti-plus icon"></i>
                    Yeni Urun
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header">
                <div class="col-auto">
                    <input type="text"
                           class="form-control"
                           name="search"
                           placeholder="Urun ara..."
                           value="@ViewBag.Search"
                           hx-get="/products"
                           hx-trigger="keyup changed delay:300ms"
                           hx-target="#product-table"
                           hx-swap="outerHTML"
                           hx-include="this"/>
                </div>
            </div>
            <partial name="Partials/_ProductTable" model="Model"/>
        </div>
    </div>
</div>
