@model Entegrasyon.Entity.Dtos.Product.ProductEditPageDto

@{
    ViewData.SetBreadcrumb(("Urunler", "/products"), ("Duzenle", null));
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="page-pretitle">Urun</div>
                <h2 class="page-title">Urun Duzenle</h2>
            </div>
            <div class="col-auto ms-auto">
                <a href="/products/@Model.Product.Id" class="btn btn-outline-secondary">
                    Iptal
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
                    <li class="nav-item">
                        <a href="#tab-general" class="nav-link active" data-bs-toggle="tab">Genel</a>
                    </li>
                    <li class="nav-item">
                        <a href="#tab-variants" class="nav-link" data-bs-toggle="tab">Varyantlar</a>
                    </li>
                    <li class="nav-item">
                        <a href="#tab-attributes" class="nav-link" data-bs-toggle="tab">Ozellikler</a>
                    </li>
                    <li class="nav-item">
                        <a href="#tab-images" class="nav-link" data-bs-toggle="tab">Gorseller</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <!-- General Tab -->
                    <div class="tab-pane active show" id="tab-general">
                        <form method="post" action="/products/@Model.Product.Id/edit">
                            @Html.AntiForgeryToken()
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label required">Urun Adi</label>
                                    <input type="text" class="form-control" name="Title"
                                           value="@Model.Product.Title" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Stok Kodu</label>
                                    <input type="text" class="form-control" name="StockCode"
                                           value="@Model.Product.StockCode" readonly />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label required">Marka</label>
                                    <select class="form-select" name="BrandId" required>
                                        @foreach (var brand in Model.Brands)
                                        {
                                            <option value="@brand.Id"
                                                    selected="@(brand.Id == Model.Product.BrandId)">
                                                @brand.Name
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label required">Kategori</label>
                                    <select class="form-select" name="CategoryId" required>
                                        @foreach (var cat in Model.LeafCategories)
                                        {
                                            <option value="@cat.Id"
                                                    selected="@(cat.Id == Model.Product.CategoryId)">
                                                @cat.Name
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Sezon</label>
                                    <input type="text" class="form-control" name="Season"
                                           value="@Model.Product.Season" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Yil</label>
                                    <input type="text" class="form-control" name="Year"
                                           value="@Model.Product.Year" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Aciklama</label>
                                <textarea class="form-control" name="Description"
                                          rows="4">@Model.Product.Description</textarea>
                            </div>
                            <div class="text-end">
                                <a href="/products/@Model.Product.Id" class="btn btn-ghost-secondary me-2">Iptal</a>
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                            </div>
                        </form>
                    </div>

                    <!-- Variants Tab -->
                    <div class="tab-pane" id="tab-variants">
                        @if (Model.Product.ProductVariants.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Barkod</th>
                                            <th>Liste Fiyati</th>
                                            <th>Satis Fiyati</th>
                                            <th>Maliyet</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in Model.Product.ProductVariants)
                                        {
                                            <tr>
                                                <td>@v.Barcode</td>
                                                <td>@v.ListPrice.ToString("N2")</td>
                                                <td>@v.SalePrice.ToString("N2")</td>
                                                <td>@v.CostPrice.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary">Varyant bulunmuyor.</p>
                        }
                    </div>

                    <!-- Attributes Tab -->
                    <div class="tab-pane" id="tab-attributes">
                        @if (Model.Product.AttributeKeyValues.Any())
                        {
                            <div class="datagrid">
                                @foreach (var attr in Model.Product.AttributeKeyValues)
                                {
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Ozellik #@attr.CategoryAttributeId</div>
                                        <div class="datagrid-content">
                                            @(attr.CustomValue ?? attr.AttributeValueId?.ToString() ?? "-")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary">Ozellik bulunmuyor.</p>
                        }
                    </div>

                    <!-- Images Tab -->
                    <div class="tab-pane" id="tab-images">
                        @{
                            var firstVariant = Model.Product.ProductVariants.FirstOrDefault();
                        }

                        @if (firstVariant != null && firstVariant.UploadedImages.Any())
                        {
                            <div class="row g-3 mb-4">
                                @foreach (var img in firstVariant.UploadedImages.Where(i => !i.IsDeleted))
                                {
                                    <div class="col-6 col-sm-4 col-md-3">
                                        <div class="card card-sm">
                                            <img src="@img.Src" class="card-img-top" alt="Urun gorseli"
                                                 style="height:150px;object-fit:cover;" />
                                            <div class="card-body p-2 d-flex justify-content-between align-items-center">
                                                @if (img.IsMain)
                                                {
                                                    <span class="badge bg-blue">Ana Gorsel</span>
                                                }
                                                else
                                                {
                                                    <span class="text-secondary small">Gorsel #@img.Id</span>
                                                }
                                                <form method="post"
                                                      action="/products/@Model.Product.Id/images/@img.Id/delete"
                                                      onsubmit="return confirm('Gorsel silinsin mi?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-ghost-danger btn-sm p-1">
                                                        <i class="ti ti-trash icon"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary mb-3">Henuz gorsel yuklenmemis.</p>
                        }

                        @if (firstVariant != null)
                        {
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Gorsel Yukle</h3>
                                </div>
                                <div class="card-body">
                                    <form method="post"
                                          action="/products/@Model.Product.Id/images/upload"
                                          enctype="multipart/form-data">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="variantId" value="@firstVariant.Id" />
                                        <div class="mb-3">
                                            <label class="form-label">Gorsel Dosyalari</label>
                                            <input type="file" name="files" class="form-control"
                                                   multiple accept="image/*" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox"
                                                       name="isMain" value="true" />
                                                <span class="form-check-label">Ilk gorseli ana gorsel olarak ayarla</span>
                                            </label>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Yukle</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                Gorsel yuklemek icin en az bir varyant gereklidir.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
