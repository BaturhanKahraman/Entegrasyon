@model Entegrasyon.Entity.Pageable<Entegrasyon.Entity.Dtos.Product.ProductsDetailDto>

<div id="product-table">
    @if (Model.HasItem)
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Urun Adi</th>
                        <th>Stok Kodu</th>
                        <th>Marka</th>
                        <th>Kategori</th>
                        <th>Stok</th>
                        <th>Varyant</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Items)
                    {
                        <tr>
                            <td>
                                <a href="/products/@product.Id" class="text-reset">
                                    @product.Title
                                </a>
                            </td>
                            <td class="text-secondary">@product.StockCode</td>
                            <td class="text-secondary">@product.BrandName</td>
                            <td class="text-secondary">@product.CategoryName</td>
                            <td>
                                <span class="badge @(product.TotalCurrentStock > 0 ? "bg-green-lt" : "bg-red-lt")">
                                    @product.TotalCurrentStock
                                </span>
                            </td>
                            <td class="text-secondary">@product.VariantCount</td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="/products/@product.Id" class="btn btn-sm btn-outline-primary">
                                        Detay
                                    </a>
                                    <a href="/products/@product.Id/edit" class="btn btn-sm btn-outline-secondary">
                                        Duzenle
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            hx-post="/products/@product.Id/delete"
                                            hx-target="closest tr"
                                            hx-swap="outerHTML swap:300ms"
                                            hx-confirm="Bu urunu silmek istediginize emin misiniz?">
                                        Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Shared/Views/Partials/_Pagination.cshtml"
                 model='new Entegrasyon.MVC.Shared.ViewModels.PaginationVm
                 {
                     CurrentPage = Model.CurrentPageIndex + 1,
                     TotalPages = Model.TotalPageCount,
                     TotalCount = Model.TotalItemCount,
                     BaseUrl = "/products",
                     TargetId = "#product-table",
                     QueryParams = ViewBag.Search != null
                         ? new Dictionary<string, string> { ["search"] = (string)ViewBag.Search }
                         : new()
                 }'/>
    }
    else
    {
        <div class="card-body">
            <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                     model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                     {
                         Title = "Urun bulunamadi",
                         Subtitle = "Henuz urun eklenmemis veya arama kriterinize uygun urun yok.",
                         ActionUrl = "/products/add",
                         ActionText = "Yeni Urun Ekle"
                     }'/>
        </div>
    }
</div>
