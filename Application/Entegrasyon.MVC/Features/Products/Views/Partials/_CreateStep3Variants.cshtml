@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm
@using Entegrasyon.Entity.Dtos.Category

@{
    var variantAttrs = ViewBag.VariantAttributes as List<CategoryAttributeDto> ?? [];
}

<div data-wizard-step="3">
@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0 ps-3">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@err.ErrorMessage</li>
            }
        </ul>
    </div>
}
<form id="step3-form" hx-post="/products/add/step3" hx-target="#wizard-content" hx-swap="innerHTML">
    @Html.AntiForgeryToken()

    <!-- Step 1 hidden fields -->
    <input type="hidden" name="Title" value="@Model.Title" />
    <input type="hidden" name="Description" value="@Model.Description" />
    <input type="hidden" name="StockCode" value="@Model.StockCode" />
    <input type="hidden" name="Season" value="@Model.Season" />
    <input type="hidden" name="Year" value="@Model.Year" />
    <input type="hidden" name="BrandId" value="@Model.BrandId" />
    <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
    <input type="hidden" name="BrandName" value="@Model.BrandName" />
    <input type="hidden" name="CategoryName" value="@Model.CategoryName" />

    <!-- Step 2 hidden fields -->
    @for (int i = 0; i < Model.CategoryAttributes.Count; i++)
    {
        <input type="hidden" name="CategoryAttributes[@i].CategoryAttributeId" value="@Model.CategoryAttributes[i].CategoryAttributeId" />
        <input type="hidden" name="CategoryAttributes[@i].AttributeName" value="@Model.CategoryAttributes[i].AttributeName" />
        <input type="hidden" name="CategoryAttributes[@i].ValueId" value="@Model.CategoryAttributes[i].ValueId" />
        <input type="hidden" name="CategoryAttributes[@i].IsRequired" value="@Model.CategoryAttributes[i].IsRequired" />
    }

    <!-- Variant Attribute Selectors -->
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Varyant Özellikleri</h3>
            <span class="card-subtitle">@Model.CategoryName</span>
        </div>
        <div class="card-body">
            @if (variantAttrs.Count == 0)
            {
                <div class="alert alert-info">Bu kategoride varyant özelliği yok — "Varyantları Oluştur" ile varsayılan tek varyant oluşturulacak. Barkod, fiyat ve stok girip devam edebilirsiniz.</div>
            }
            else
            {
                <div class="row">
                    @for (int i = 0; i < variantAttrs.Count; i++)
                    {
                        var attr = variantAttrs[i];
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                @attr.CategoriyAttributeHumanized
                                @if (attr.IsVarianter)
                                {
                                    <span class="badge bg-red-lt ms-1">Varyanter</span>
                                }
                                @if (attr.IsSlicer)
                                {
                                    <span class="badge bg-yellow-lt ms-1">Dilimleyici</span>
                                }
                            </label>
                            <input type="hidden" name="VariantAttributeSelections[@i].CategoryAttributeId" value="@attr.Id" />
                            <input type="hidden" name="VariantAttributeSelections[@i].AttributeName" value="@attr.CategoriyAttributeHumanized" />
                            <input type="hidden" name="VariantAttributeSelections[@i].IsVarianter" value="@attr.IsVarianter" />
                            <input type="hidden" name="VariantAttributeSelections[@i].IsSlicer" value="@attr.IsSlicer" />

                            <!-- Searchable multi-select (Tom Select) + hızlı değer ekleme -->
                            <div class="input-group">
                                <select multiple class="form-select variant-tomselect" data-attr-index="@i"
                                        data-placeholder="Ara ve seç...">
                                    @foreach (var val in attr.CategoryAttributeValues)
                                    {
                                        <option value="@val.Id" data-name="@val.Name">@val.Name</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary btn-icon variant-value-add-btn"
                                        data-attr-index="@i"
                                        data-attribute-id="@attr.Id"
                                        data-attribute-name="@attr.CategoriyAttributeHumanized"
                                        title="Yeni değer ekle">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                                </button>
                            </div>
                            @if (attr.CategoryAttributeValues.Count == 0)
                            {
                                <small class="text-muted">Bu özelliğin tanımlı değeri yok — "+" ile ekleyebilirsiniz.</small>
                            }
                            <div class="multiselect-hidden-fields" data-attr-index="@i"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Bulk Defaults -->
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Varsayılan Değerler</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Liste Fiyat <span class="text-muted fw-normal">(opsiyonel)</span></label>
                    <div class="input-group">
                        <span class="input-group-text">₺</span>
                        <input type="text" name="DefaultValues.ListPrice" value="@(Model.DefaultValues.ListPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                               class="form-control currency-input" inputmode="decimal" autocomplete="off" />
                    </div>
                    <small class="text-muted">Boş bırakılırsa yalnızca satış fiyatı kullanılır</small>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Satış Fiyat</label>
                    <div class="input-group">
                        <span class="input-group-text">₺</span>
                        <input type="text" name="DefaultValues.SalePrice" value="@Model.DefaultValues.SalePrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control currency-input" inputmode="decimal" autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Maliyet</label>
                    <div class="input-group">
                        <span class="input-group-text">₺</span>
                        <input type="text" name="DefaultValues.CostPrice" value="@Model.DefaultValues.CostPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control currency-input" inputmode="decimal" autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">KDV %</label>
                    <input type="number" name="DefaultValues.VatRate" value="@(Model.DefaultValues.VatRate == 0 ? 20 : Model.DefaultValues.VatRate)"
                           class="form-control" step="1" min="0" max="100" />
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button type="button" id="btn-generate-variants" class="btn btn-primary w-100">
                        Varyantları Oluştur
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Generated Variant Table -->
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Oluşturulan Varyantlar</h3>
        </div>
        <div class="card-body">
            <div id="variant-table-container">
                <div class="text-muted">Varyant oluşturmak için yukarıdaki özellik değerlerini seçin ve "Varyantları Oluştur" butonuna tıklayın.</div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="d-flex justify-content-between">
        <a href="/products/add/back-to-step2" hx-get="/products/add/back-to-step2" hx-target="#wizard-content" hx-swap="innerHTML" class="btn btn-ghost-secondary">&larr; Geri</a>
        <button type="submit" id="btn-step3-next" class="btn btn-primary" disabled>
            Devam: Görseller &rarr;
        </button>
    </div>
</form>

<partial name="Partials/_AttrValueQuickAddModal" />
</div>

<script>
(function () {
    'use strict';

    // KDV guard'ı ("Devam: Görseller" submit): sunucu tarafı ValidateVatRates başarısız
    // olursa htmx innerHTML swap'ı, JS ile doldurulan #variant-table-container'ı boş
    // placeholder'a döndürür — kullanıcının girdiği tüm stok/fiyat verisi kaybolur. Bu
    // yüzden geçersiz bir varyant KDV'si sunucuya hiç gönderilmez (Step1'deki capture-fazlı
    // engelleme deseniyle aynı: htmx submit handler'ından önce durdurulur).
    var step3Form = document.getElementById('step3-form');
    step3Form.addEventListener('submit', function (e) {
        var invalid = Array.from(step3Form.querySelectorAll('[name$=".VatRate"]')).find(function (input) {
            var v = parseFloat(input.value);
            return isNaN(v) || v < 0 || v > 100;
        });
        if (invalid) {
            e.preventDefault();
            e.stopPropagation();
            invalid.classList.add('is-invalid');
            if (typeof window.showNotify === 'function') {
                window.showNotify('KDV oranı 0-100 arasında olmalıdır.', 'error');
            }
            invalid.focus();
        }
    }, true); // capture: htmx'ten önce çalış

    // --- Tom Select Multi-Select Init ---
    document.querySelectorAll('.variant-tomselect').forEach(function(sel) {
        var attrIndex = sel.getAttribute('data-attr-index');
        var ts = new TomSelect(sel, {
            plugins: ['checkbox_options', 'remove_button'],
            maxOptions: null,
            placeholder: sel.getAttribute('data-placeholder') || 'Ara ve sec...',
            onChange: function() {
                syncTomSelectHiddenFields(attrIndex);
            }
        });
    });

    // "+" butonları → ortak hızlı-ekle modal'ı; eklenen değer seçili gelir.
    document.querySelectorAll('.variant-value-add-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var attrIndex = btn.getAttribute('data-attr-index');
            var attrId = btn.getAttribute('data-attribute-id');
            var attrName = btn.getAttribute('data-attribute-name');
            window.openAttrValueQuickAdd(attrId, attrName, function (id, name) {
                var sel = document.querySelector('.variant-tomselect[data-attr-index="' + attrIndex + '"]');
                if (!sel || !sel.tomselect) return;
                sel.tomselect.addOption({ value: String(id), text: name });
                sel.tomselect.addItem(String(id)); // onChange → hidden field sync
            });
        });
    });

    function syncTomSelectHiddenFields(attrIndex) {
        var container = document.querySelector('.multiselect-hidden-fields[data-attr-index="' + attrIndex + '"]');
        while (container.firstChild) container.removeChild(container.firstChild);

        var sel = document.querySelector('.variant-tomselect[data-attr-index="' + attrIndex + '"]');
        var tomInstance = sel.tomselect;
        var selectedItems = tomInstance.items;

        selectedItems.forEach(function(valueId, idx) {
            var option = tomInstance.options[valueId];

            var valueIdField = document.createElement('input');
            valueIdField.type = 'hidden';
            valueIdField.name = 'VariantAttributeSelections[' + attrIndex + '].SelectedValues[' + idx + '].ValueId';
            valueIdField.value = valueId;
            container.appendChild(valueIdField);

            var valueNameField = document.createElement('input');
            valueNameField.type = 'hidden';
            valueNameField.name = 'VariantAttributeSelections[' + attrIndex + '].SelectedValues[' + idx + '].ValueName';
            valueNameField.value = option ? option.text : '';
            container.appendChild(valueNameField);
        });
    }

    // --- Generate Variants ---
    var generateBtn = document.getElementById('btn-generate-variants');
    if (generateBtn) {
        generateBtn.addEventListener('click', function () {
            // Çift-submit önleme: bu buton RAW fetch kullanıyor (htmx değil),
            // bu yüzden site.js'deki global htmx loading-hook'u BURAYA değmez.
            // Loading state'i elle uyguluyoruz — aynı görsel desen: Tabler
            // .btn-loading (spinner, label gizli ama genişlik sabit) + disabled.
            if (generateBtn.disabled) return; // çoklu tıklamaya karşı erken çık

            // KDV yüzde guard'ı: raw fetch native form validasyonunu atladığı için elle.
            var vatInput = document.querySelector('[name="DefaultValues.VatRate"]');
            var vat = parseFloat(vatInput.value);
            if (isNaN(vat) || vat < 0 || vat > 100) {
                vatInput.classList.add('is-invalid');
                if (typeof window.showNotify === 'function') {
                    window.showNotify('KDV oranı 0-100 arasında olmalıdır.', 'error');
                }
                vatInput.focus();
                return;
            }
            vatInput.classList.remove('is-invalid');

            generateBtn.disabled = true;
            generateBtn.classList.add('btn-loading');

            function resetButton() {
                generateBtn.disabled = false;
                generateBtn.classList.remove('btn-loading');
            }

            var form = document.getElementById('step3-form');
            // Currency input'larini normalize et ("1.234,56" -> "1234.56")
            // Normal submit akisi disinda calistigimiz icin manuel yapiyoruz
            form.querySelectorAll('.currency-input').forEach(function (el) {
                if (!el.value) return;
                el.value = el.value.replace(/\./g, '').replace(',', '.').replace(/[^\d.]/g, '');
            });
            var formData = new FormData(form);

            fetch('/products/add/generate-variants', {
                method: 'POST',
                body: formData
            })
            .then(function (res) { return res.text(); })
            .then(function (html) {
                var container = document.getElementById('variant-table-container');
                // Clear existing content safely
                while (container.firstChild) {
                    container.removeChild(container.firstChild);
                }
                // Insert trusted server-rendered partial view HTML
                var range = document.createRange();
                range.selectNode(container);
                var fragment = range.createContextualFragment(html);
                container.appendChild(fragment);

                var nextBtn = document.getElementById('btn-step3-next');
                var hasVariants = container.querySelector('table') !== null;
                nextBtn.disabled = !hasVariants;
            })
            .catch(function () {
                if (typeof window.showNotify === 'function') {
                    window.showNotify('Varyantlar oluşturulamadı. Lütfen tekrar deneyin.', 'error');
                }
            })
            .finally(resetButton);
        });
    }
})();
</script>
