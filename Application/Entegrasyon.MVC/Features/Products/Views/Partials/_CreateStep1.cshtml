@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm
@using Entegrasyon.Entity.Dtos.Brand

@{
    var brands = ViewBag.Brands as List<BrandListDetailDto> ?? [];
    var categories = ViewBag.Categories as List<Entegrasyon.Entity.Categories.Category> ?? [];
}

<div data-wizard-step="1">
<form hx-post="/products/add/step1" hx-target="#wizard-content" hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header"><h3 class="card-title">Genel Bilgiler</h3></div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3">
                    <div class="d-flex">
                        <div><i class="ti ti-alert-circle me-2"></i></div>
                        <div>
                            <strong>Lütfen aşağıdaki hataları düzeltin:</strong>
                            <ul class="mb-0 mt-1">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@err.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Ürün Adı</label>
                    <input name="Title" value="@Model.Title" class="form-control @(ViewData.ModelState["Title"]?.Errors.Count > 0 ? "is-invalid" : "")" required />
                    @if (ViewData.ModelState["Title"]?.Errors.Count > 0)
                    {
                        <div class="invalid-feedback">@ViewData.ModelState["Title"]!.Errors.First().ErrorMessage</div>
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Stok Kodu</label>
                    <input name="StockCode" value="@Model.StockCode" class="form-control @(ViewData.ModelState["StockCode"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                    @if (ViewData.ModelState["StockCode"]?.Errors.Count > 0)
                    {
                        <div class="invalid-feedback">@ViewData.ModelState["StockCode"]!.Errors.First().ErrorMessage</div>
                    }
                </div>

                @* -- Brand (Tom Select + quick-add) -- *@
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Marka</label>
                    <div class="input-group">
                        <select name="BrandId" id="brand-select" class="@(ViewData.ModelState["BrandId"]?.Errors.Count > 0 ? "is-invalid" : "")" required>
                            <option value="">Marka seçin...</option>
                            @foreach (var b in brands)
                            {
                                <option value="@b.Id" selected="@(Model.BrandId == b.Id)">@b.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-primary btn-icon" id="brand-add-btn" title="Yeni marka ekle">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </button>
                    </div>
                    @if (ViewData.ModelState["BrandId"]?.Errors.Count > 0)
                    {
                        <div class="text-danger small mt-1">@ViewData.ModelState["BrandId"]!.Errors.First().ErrorMessage</div>
                    }
                </div>

                @* -- Category (Tom Select) -- *@
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Kategori</label>
                    <select name="CategoryId" id="category-select" class="@(ViewData.ModelState["CategoryId"]?.Errors.Count > 0 ? "is-invalid" : "")" required>
                        <option value="">Kategori seçin...</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                        }
                    </select>
                    @if (ViewData.ModelState["CategoryId"]?.Errors.Count > 0)
                    {
                        <div class="text-danger small mt-1">@ViewData.ModelState["CategoryId"]!.Errors.First().ErrorMessage</div>
                    }
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Sezon</label>
                    <input name="Season" value="@Model.Season" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Yıl</label>
                    <input name="Year" value="@Model.Year" class="form-control" />
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Açıklama</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>
            </div>
        </div>
        <div class="card-footer text-end">
            <a href="/products" class="btn btn-ghost-secondary me-2">Iptal</a>
            <button type="submit" class="btn btn-primary">Devam: Özellikler &rarr;</button>
        </div>
    </div>
</form>

@* -- Brand Quick Add Modal -- *@
<div class="modal modal-blur fade" id="brand-add-modal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Marka Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Marka Adı</label>
                    <input type="text" id="brand-add-input" class="form-control" placeholder="Marka adını girin..." />
                </div>
                <div id="brand-add-error" class="alert alert-danger d-none"></div>
                <div id="brand-add-success" class="alert alert-info d-none">
                    Marka eklendi. Bu marka yeni eklendiği için pazaryerleriyle eşleştirilmemiş olacak.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="brand-add-confirm">Ekle</button>
            </div>
        </div>
    </div>
</div>
</div>

<script>
function initStep1() {
    if (typeof TomSelect === 'undefined') {
        setTimeout(initStep1, 50);
        return;
    }

    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value || '';

    // -- Tom Select for Brand --
    var brandTs = new TomSelect('#brand-select', {
        maxOptions: null,
        allowEmptyOption: true,
        placeholder: 'Marka seçin...'
    });

    // -- Tom Select for Category --
    var catTs = new TomSelect('#category-select', {
        maxOptions: null,
        allowEmptyOption: true,
        placeholder: 'Kategori seçin...'
    });

    // -- Brand quick-add: + button opens modal --
    var brandAddInput = document.getElementById('brand-add-input');
    var brandAddError = document.getElementById('brand-add-error');
    var brandAddSuccess = document.getElementById('brand-add-success');
    var brandAddConfirm = document.getElementById('brand-add-confirm');

    document.getElementById('brand-add-btn').addEventListener('click', function() {
        brandAddInput.value = '';
        brandAddError.classList.add('d-none');
        brandAddSuccess.classList.add('d-none');
        brandAddConfirm.disabled = false;
        var modal = new bootstrap.Modal(document.getElementById('brand-add-modal'));
        modal.show();
        setTimeout(function() { brandAddInput.focus(); }, 300);
    });

    // -- Brand quick-add confirm --
    brandAddConfirm.addEventListener('click', function() {
        var name = brandAddInput.value.trim();
        if (!name) { brandAddInput.focus(); return; }

        // Çift-submit önleme + loading state (raw fetch — global htmx hook değmez):
        // disabled + Tabler .btn-loading (spinner, label gizli, genişlik sabit).
        brandAddConfirm.disabled = true;
        brandAddConfirm.classList.add('btn-loading');
        brandAddError.classList.add('d-none');
        brandAddSuccess.classList.add('d-none');

        var body = new URLSearchParams();
        body.append('brandName', name);
        if (token) body.append('__RequestVerificationToken', token);
        fetch('/products/add/brand-quick-add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            brandAddConfirm.classList.remove('btn-loading');
            if (data.success) {
                brandTs.addOption({ value: data.id.toString(), text: data.name });
                brandTs.setValue(data.id.toString());
                brandAddSuccess.classList.remove('d-none');
                brandAddInput.value = '';
                // Başarıda buton kilitli kalır (aynı markayı tekrar eklemeyi önler);
                // modal kapanıp yeniden açıldığında brand-add-btn handler'ı sıfırlar.
            } else {
                brandAddError.textContent = data.message || 'Marka eklenemedi.';
                brandAddError.classList.remove('d-none');
                brandAddConfirm.disabled = false;
            }
        })
        .catch(function() {
            // Ağ/parse hatası: butonu yeniden aç, kullanıcı tekrar deneyebilsin.
            brandAddConfirm.classList.remove('btn-loading');
            brandAddConfirm.disabled = false;
            brandAddError.textContent = 'Marka eklenemedi. Lütfen tekrar deneyin.';
            brandAddError.classList.remove('d-none');
        });
    });

    // Enter key in brand input triggers confirm
    brandAddInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); brandAddConfirm.click(); }
    });
}
initStep1();
</script>
