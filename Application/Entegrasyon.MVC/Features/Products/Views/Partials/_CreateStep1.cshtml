@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm
@using Entegrasyon.Entity.Dtos.Brand

@{
    var brands = ViewBag.Brands as List<BrandListDetailDto> ?? [];
    var categories = ViewBag.Categories as List<Entegrasyon.Entity.Categories.Category> ?? [];
}

<div data-wizard-step="1">
<form hx-post="/products/add/step1" hx-target="#wizard-content" hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header"><h3 class="card-title">Genel Bilgiler</h3></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Urun Adi</label>
                    <input name="Title" value="@Model.Title" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Stok Kodu</label>
                    <input name="StockCode" value="@Model.StockCode" class="form-control" />
                </div>

                @* -- Brand (searchable select + quick-add) -- *@
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Marka</label>
                    <input type="text" id="brand-filter" class="form-control mb-1" placeholder="Marka ara..." autocomplete="off" />
                    <select name="BrandId" id="brand-select" class="form-select" required>
                        <option value="">Secin...</option>
                        @foreach (var b in brands)
                        {
                            if (Model.BrandId == b.Id)
                            {
                                <option value="@b.Id" selected>@b.Name</option>
                            }
                            else
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        }
                    </select>
                </div>

                @* -- Category (searchable select) -- *@
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Kategori</label>
                    <input type="text" id="category-filter" class="form-control mb-1" placeholder="Kategori ara..." autocomplete="off" />
                    <select name="CategoryId" id="category-select" class="form-select" required>
                        <option value="">Secin...</option>
                        @foreach (var c in categories)
                        {
                            if (Model.CategoryId == c.Id)
                            {
                                <option value="@c.Id" selected>@c.Name</option>
                            }
                            else
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Sezon</label>
                    <input name="Season" value="@Model.Season" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Yil</label>
                    <input name="Year" value="@Model.Year" class="form-control" />
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Aciklama</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>
            </div>
        </div>
        <div class="card-footer text-end">
            <a href="/products" class="btn btn-ghost-secondary me-2">Iptal</a>
            <button type="submit" class="btn btn-primary">Devam: Ozellikler &rarr;</button>
        </div>
    </div>
</form>

@* -- Brand Add Modal -- *@
<div class="modal modal-blur fade" id="brand-add-modal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Marka Bulunamadi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>"<strong id="brand-add-name"></strong>" markasi bulunamadi. Eklemek ister misiniz?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">Hayir</button>
                <button type="button" class="btn btn-primary" id="brand-add-confirm">Evet, Ekle</button>
            </div>
        </div>
    </div>
</div>

@* -- Brand Info Modal -- *@
<div class="modal modal-blur fade" id="brand-info-modal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bilgi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bu marka yeni eklendigi icin eslestirilmemis olacak.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Tamam</button>
            </div>
        </div>
    </div>
</div>
</div>

<script>
(function() {
    var brandFilter = document.getElementById('brand-filter');
    var brandSelect = document.getElementById('brand-select');
    var catFilter = document.getElementById('category-filter');
    var catSelect = document.getElementById('category-select');
    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value || '';

    // -- Filter select options by text input (case-insensitive) --
    function filterSelect(input, select) {
        input.addEventListener('input', function() {
            var q = input.value.toLowerCase();
            var options = select.options;
            for (var i = 1; i < options.length; i++) {
                var text = options[i].textContent.toLowerCase();
                options[i].hidden = q.length > 0 && text.indexOf(q) === -1;
            }
        });
    }

    filterSelect(brandFilter, brandSelect);
    filterSelect(catFilter, catSelect);

    // -- Brand quick-add: on blur of filter input, check if typed text matches any option --
    brandFilter.addEventListener('blur', function() {
        setTimeout(function() {
            var typed = brandFilter.value.trim();
            if (typed.length === 0) return;
            // Check if any option matches the typed text
            var found = false;
            var options = brandSelect.options;
            for (var i = 1; i < options.length; i++) {
                if (options[i].textContent.toLowerCase() === typed.toLowerCase()) {
                    found = true;
                    options[i].selected = true;
                    break;
                }
            }
            if (!found) {
                var nameEl = document.getElementById('brand-add-name');
                nameEl.textContent = typed;
                var modal = new bootstrap.Modal(document.getElementById('brand-add-modal'));
                modal.show();
            }
        }, 200);
    });

    // -- Brand quick-add confirm --
    document.getElementById('brand-add-confirm').addEventListener('click', function() {
        var name = brandFilter.value.trim();
        var body = new URLSearchParams();
        body.append('brandName', name);
        if (token) body.append('__RequestVerificationToken', token);
        fetch('/products/add/brand-quick-add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var addModal = bootstrap.Modal.getInstance(document.getElementById('brand-add-modal'));
            if (addModal) addModal.hide();
            if (data.success) {
                // Add new option to select and select it
                var opt = document.createElement('option');
                opt.value = data.id;
                opt.textContent = data.name;
                opt.selected = true;
                brandSelect.appendChild(opt);
                brandFilter.value = '';
                var infoModal = new bootstrap.Modal(document.getElementById('brand-info-modal'));
                infoModal.show();
            }
        });
    });
})();
</script>
