@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm
@using Entegrasyon.Entity.Dtos.Brand

@{
    var brands = ViewBag.Brands as List<BrandListDetailDto> ?? [];
    var categories = ViewBag.Categories as List<Entegrasyon.Entity.Categories.Category> ?? [];
}

<div data-wizard-step="1">
<form hx-post="/products/add/step1" hx-target="#wizard-content" hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header"><h3 class="card-title">Genel Bilgiler</h3></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Urun Adi</label>
                    <input name="Title" value="@Model.Title" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Stok Kodu</label>
                    <input name="StockCode" value="@Model.StockCode" class="form-control" />
                </div>

                @* -- Brand (Tom Select + quick-add) -- *@
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Marka</label>
                    <div class="d-flex gap-2">
                        <div class="flex-grow-1">
                            <select name="BrandId" id="brand-select" required>
                                <option value="">Marka secin...</option>
                                @foreach (var b in brands)
                                {
                                    <option value="@b.Id" selected="@(Model.BrandId == b.Id)">@b.Name</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-outline-primary" id="brand-add-btn" title="Yeni marka ekle" style="height:38px">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </button>
                    </div>
                </div>

                @* -- Category (Tom Select) -- *@
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Kategori</label>
                    <select name="CategoryId" id="category-select" required>
                        <option value="">Kategori secin...</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Sezon</label>
                    <input name="Season" value="@Model.Season" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Yil</label>
                    <input name="Year" value="@Model.Year" class="form-control" />
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Aciklama</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>
            </div>
        </div>
        <div class="card-footer text-end">
            <a href="/products" class="btn btn-ghost-secondary me-2">Iptal</a>
            <button type="submit" class="btn btn-primary">Devam: Ozellikler &rarr;</button>
        </div>
    </div>
</form>

@* -- Brand Add Modal -- *@
<div class="modal modal-blur fade" id="brand-add-modal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Marka Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>"<strong id="brand-add-name"></strong>" markasini eklemek ister misiniz?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">Hayir</button>
                <button type="button" class="btn btn-primary" id="brand-add-confirm">Evet, Ekle</button>
            </div>
        </div>
    </div>
</div>

@* -- Brand Info Modal -- *@
<div class="modal modal-blur fade" id="brand-info-modal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bilgi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bu marka yeni eklendigi icin eslestirilmemis olacak.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Tamam</button>
            </div>
        </div>
    </div>
</div>
</div>

<script>
(function() {
    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value || '';

    // -- Tom Select for Brand --
    var brandTs = new TomSelect('#brand-select', {
        maxOptions: null,
        allowEmptyOption: true,
        placeholder: 'Marka secin...'
    });

    // -- Tom Select for Category --
    var catTs = new TomSelect('#category-select', {
        maxOptions: null,
        allowEmptyOption: true,
        placeholder: 'Kategori secin...'
    });

    // -- Brand quick-add: + button opens modal --
    document.getElementById('brand-add-btn').addEventListener('click', function() {
        var typed = brandTs.wrapper.querySelector('.ts-control input')?.value?.trim() || '';
        var nameEl = document.getElementById('brand-add-name');
        nameEl.textContent = typed || 'Yeni Marka';
        var modal = new bootstrap.Modal(document.getElementById('brand-add-modal'));
        modal.show();
    });

    // -- Brand quick-add confirm --
    document.getElementById('brand-add-confirm').addEventListener('click', function() {
        var name = document.getElementById('brand-add-name').textContent;
        var body = new URLSearchParams();
        body.append('brandName', name);
        if (token) body.append('__RequestVerificationToken', token);
        fetch('/products/add/brand-quick-add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var addModal = bootstrap.Modal.getInstance(document.getElementById('brand-add-modal'));
            if (addModal) addModal.hide();
            if (data.success) {
                // Add new option via Tom Select API and select it
                brandTs.addOption({ value: data.id.toString(), text: data.name });
                brandTs.setValue(data.id.toString());
                var infoModal = new bootstrap.Modal(document.getElementById('brand-info-modal'));
                infoModal.show();
            }
        });
    });
})();
</script>
