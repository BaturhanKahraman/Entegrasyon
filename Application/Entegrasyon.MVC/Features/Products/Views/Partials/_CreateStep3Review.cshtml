@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm

<div class="card">
    <div class="card-header"><h3 class="card-title">Onay</h3></div>
    <div class="card-body">
        <div class="datagrid">
            <div class="datagrid-item">
                <div class="datagrid-title">Urun Adi</div>
                <div class="datagrid-content">@Model.Title</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Stok Kodu</div>
                <div class="datagrid-content">@(string.IsNullOrEmpty(Model.StockCode) ? "-" : Model.StockCode)</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Marka</div>
                <div class="datagrid-content">@(Model.BrandName ?? Model.BrandId.ToString())</div>
            </div>
            <div class="datagrid-item">
                <div class="datagrid-title">Kategori</div>
                <div class="datagrid-content">@(Model.CategoryName ?? Model.CategoryId.ToString())</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Season))
            {
                <div class="datagrid-item">
                    <div class="datagrid-title">Sezon</div>
                    <div class="datagrid-content">@Model.Season</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Year))
            {
                <div class="datagrid-item">
                    <div class="datagrid-title">Yil</div>
                    <div class="datagrid-content">@Model.Year</div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="mt-3">
                <strong>Aciklama:</strong>
                <p class="text-secondary">@Model.Description</p>
            </div>
        }

        <h4 class="mt-3">Varyantlar (@Model.Variants.Count adet)</h4>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>Barkod</th>
                        <th>Liste Fiyat</th>
                        <th>Satis Fiyat</th>
                        <th>Maliyet</th>
                        <th>KDV</th>
                        <th>Stok</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Variants)
                    {
                        <tr>
                            <td>@(string.IsNullOrEmpty(v.Barcode) ? "Otomatik" : v.Barcode)</td>
                            <td>@v.ListPrice.ToString("N2")</td>
                            <td>@v.SalePrice.ToString("N2")</td>
                            <td>@v.CostPrice.ToString("N2")</td>
                            <td>%@v.VatRate</td>
                            <td>@v.Stock</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a href="/products/add" class="btn btn-ghost-secondary">&larr; Bastan Baslat</a>
        <form method="post" action="/products/add/save">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Urunu Kaydet</button>
        </form>
    </div>
</div>
