@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm

@{
    var branches = ViewBag.BranchOffices as List<Entegrasyon.Entity.BranchOffice> ?? [];
    var branchesJson = System.Text.Json.JsonSerializer.Serialize(
        branches.Select(b => new { id = b.Id, name = b.Name }));
}

@if (Model.Variants.Count == 0)
{
    <div class="alert alert-warning">Varyant oluşturmak için en az bir özellik değeri seçin.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-vcenter" id="variant-table">
            <thead>
                <tr>
                    <th>Özellikler</th>
                    <th>Varyant Adı <span class="text-muted fw-normal small">(ops.)</span></th>
                    <th>Liste Fiyat <span class="text-muted fw-normal small">(ops.)</span></th>
                    <th>Satış Fiyat</th>
                    <th>Maliyet</th>
                    <th>KDV %</th>
                    <th>Stok</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Variants.Count; i++)
                {
                    var variant = Model.Variants[i];
                    // Auto-compute preview: varianter+slicer değerleri boşluk ile
                    var autoName = string.Join(" ",
                        variant.VariantAttributes
                            .Where(a => a.IsVarianter || a.IsSlicer)
                            .OrderByDescending(a => a.IsVarianter)
                            .Select(a => a.ValueName)
                            .Where(v => !string.IsNullOrWhiteSpace(v)));
                    if (string.IsNullOrWhiteSpace(autoName)) autoName = Model.Title;
                    <tr data-variant-index="@i">
                        <td>
                            @for (int j = 0; j < variant.VariantAttributes.Count; j++)
                            {
                                var attr = variant.VariantAttributes[j];
                                <span class="badge bg-azure-lt me-1">@attr.AttributeName: @attr.ValueName</span>
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].CategoryAttributeId" value="@attr.CategoryAttributeId" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].AttributeName" value="@attr.AttributeName" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].ValueId" value="@attr.ValueId" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].ValueName" value="@attr.ValueName" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].IsCustom" value="@attr.IsCustom" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].IsVarianter" value="@attr.IsVarianter" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].IsSlicer" value="@attr.IsSlicer" />
                            }
                        </td>
                        <td>
                            <input type="text" name="Variants[@i].Name" value="@variant.Name"
                                   class="form-control form-control-sm" maxlength="256"
                                   placeholder="@autoName" style="min-width:160px" autocomplete="off" />
                        </td>
                        <td>
                            <div class="input-group input-group-sm" style="width:140px">
                                <span class="input-group-text">₺</span>
                                <input type="text" name="Variants[@i].ListPrice" value="@(variant.ListPrice?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                                       class="form-control currency-input" inputmode="decimal" autocomplete="off" />
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm" style="width:140px">
                                <span class="input-group-text">₺</span>
                                <input type="text" name="Variants[@i].SalePrice" value="@variant.SalePrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control currency-input" inputmode="decimal" autocomplete="off" />
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm" style="width:140px">
                                <span class="input-group-text">₺</span>
                                <input type="text" name="Variants[@i].CostPrice" value="@variant.CostPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control currency-input" inputmode="decimal" autocomplete="off" />
                            </div>
                        </td>
                        <td>
                            <input type="number" name="Variants[@i].VatRate" value="@variant.VatRate"
                                   class="form-control form-control-sm" step="1" min="0" max="100" style="width:80px" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary btn-open-stock-modal"
                                    data-variant-index="@i">
                                <i class="ti ti-building-warehouse icon me-1"></i>
                                <span class="variant-stock-total">0</span> adet
                            </button>
                            @for (int b = 0; b < branches.Count; b++)
                            {
                                <input type="hidden" name="Variants[@i].BranchOfficeStocks[@b].BranchOfficeId" value="@branches[b].Id" />
                                <input type="hidden" name="Variants[@i].BranchOfficeStocks[@b].BranchOfficeName" value="@branches[b].Name" />
                                <input type="hidden" name="Variants[@i].BranchOfficeStocks[@b].Stock" value="0" class="variant-stock-value" data-branch-id="@branches[b].Id" />
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-ghost-danger btn-remove-variant p-1" title="Varyantı kaldır">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm" width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="text-muted small mt-2">
        <span id="variant-count">@Model.Variants.Count varyant</span> oluşturuldu. Barkod otomatik oluşturulur.
    </div>

    <div id="variant-stock-modal-container"></div>

    <template id="variant-stock-modal-template">
        <div class="modal modal-blur show" style="display:block" tabindex="-1">
            <div class="modal-dialog modal-md modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Ofise Göre Stok</h5>
                        <button type="button" class="btn-close" data-action="close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">Her ofis için stok miktarını girin. Toplam stok satış için kullanılır.</p>
                        <div class="vsm-rows"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-ghost-secondary" data-action="close">Vazgeç</button>
                        <button type="button" class="btn btn-primary" data-action="save">Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show" data-action="close"></div>
    </template>

    <template id="variant-stock-row-template">
        <div class="row align-items-center mb-2">
            <label class="col-sm-7 col-form-label">
                <i class="ti ti-building-warehouse me-1"></i>
                <span class="vsm-branch-name"></span>
            </label>
            <div class="col-sm-5">
                <input type="number" class="form-control vsm-branch-input" step="1" min="0" value="0" />
            </div>
        </div>
    </template>

    <script id="variant-branches-data" type="application/json">@Html.Raw(branchesJson)</script>
    <script>
    (function() {
        var branches = JSON.parse(document.getElementById('variant-branches-data').textContent);
        var modalContainer = document.getElementById('variant-stock-modal-container');
        var modalTpl = document.getElementById('variant-stock-modal-template');
        var rowTpl = document.getElementById('variant-stock-row-template');
        var activeRowIndex = null;

        function openStockModal(rowIndex) {
            activeRowIndex = rowIndex;
            var tableRow = document.querySelector('#variant-table tbody tr[data-variant-index="' + rowIndex + '"]');
            if (!tableRow) return;

            var currentStocks = {};
            tableRow.querySelectorAll('.variant-stock-value').forEach(function(inp) {
                currentStocks[inp.dataset.branchId] = inp.value;
            });

            // Modal iskeletini clone et
            var modalFragment = modalTpl.content.cloneNode(true);
            var rowsContainer = modalFragment.querySelector('.vsm-rows');

            // Her branch için template'den satır oluştur
            branches.forEach(function(b) {
                var rowFragment = rowTpl.content.cloneNode(true);
                rowFragment.querySelector('.vsm-branch-name').textContent = b.name;
                var input = rowFragment.querySelector('.vsm-branch-input');
                input.value = currentStocks[b.id] || '0';
                input.dataset.branchId = b.id;
                rowsContainer.appendChild(rowFragment);
            });

            modalContainer.replaceChildren(modalFragment);
        }

        function closeStockModal() {
            modalContainer.replaceChildren();
            activeRowIndex = null;
        }

        function saveStockModal() {
            if (activeRowIndex === null) return;
            var tableRow = document.querySelector('#variant-table tbody tr[data-variant-index="' + activeRowIndex + '"]');
            if (!tableRow) return closeStockModal();

            var total = 0;
            modalContainer.querySelectorAll('.vsm-branch-input').forEach(function(inp) {
                var branchId = inp.dataset.branchId;
                var val = parseInt(inp.value, 10) || 0;
                total += val;
                var hidden = tableRow.querySelector('.variant-stock-value[data-branch-id="' + branchId + '"]');
                if (hidden) hidden.value = val;
            });
            tableRow.querySelector('.variant-stock-total').textContent = total;
            closeStockModal();
        }

        modalContainer.addEventListener('click', function(e) {
            var actionEl = e.target.closest('[data-action]');
            if (!actionEl) return;
            var action = actionEl.dataset.action;
            if (action === 'close') closeStockModal();
            else if (action === 'save') saveStockModal();
        });

        document.addEventListener('click', function(e) {
            var openBtn = e.target.closest('.btn-open-stock-modal');
            if (openBtn) {
                openStockModal(openBtn.dataset.variantIndex);
                return;
            }
            var removeBtn = e.target.closest('.btn-remove-variant');
            if (removeBtn) {
                removeBtn.closest('tr').remove();
                var rows = document.querySelectorAll('#variant-table tbody tr');
                rows.forEach(function(row, idx) {
                    row.dataset.variantIndex = idx;
                    var openStockBtn = row.querySelector('.btn-open-stock-modal');
                    if (openStockBtn) openStockBtn.dataset.variantIndex = idx;
                    row.querySelectorAll('input[name], select[name]').forEach(function(input) {
                        input.name = input.name.replace(/Variants\[\d+\]/, 'Variants[' + idx + ']');
                    });
                });
                var countEl = document.querySelector('#variant-count');
                if (countEl) countEl.textContent = rows.length + ' varyant';
                var nextBtn = document.getElementById('btn-step3-next');
                if (nextBtn) nextBtn.disabled = rows.length === 0;
            }
        });
    })();
    </script>
}
