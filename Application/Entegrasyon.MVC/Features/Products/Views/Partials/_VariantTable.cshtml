@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm

@{
    var branches = ViewBag.BranchOffices as List<Entegrasyon.Entity.BranchOffice> ?? [];
}

@if (Model.Variants.Count == 0)
{
    <div class="alert alert-warning">Varyant olusturmak icin en az bir ozellik degeri secin.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-vcenter">
            <thead>
                <tr>
                    <th>Ozellikler</th>
                    <th>Liste Fiyat</th>
                    <th>Satis Fiyat</th>
                    <th>Maliyet</th>
                    <th>KDV %</th>
                    @for (int b = 0; b < branches.Count; b++)
                    {
                        <th>@branches[b].Name</th>
                    }
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Variants.Count; i++)
                {
                    var variant = Model.Variants[i];
                    <tr>
                        <td>
                            @for (int j = 0; j < variant.VariantAttributes.Count; j++)
                            {
                                var attr = variant.VariantAttributes[j];
                                <span class="badge bg-azure-lt me-1">@attr.AttributeName: @attr.ValueName</span>
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].CategoryAttributeId" value="@attr.CategoryAttributeId" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].AttributeName" value="@attr.AttributeName" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].ValueId" value="@attr.ValueId" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].ValueName" value="@attr.ValueName" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].IsCustom" value="@attr.IsCustom" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].IsVarianter" value="@attr.IsVarianter" />
                                <input type="hidden" name="Variants[@i].VariantAttributes[@j].IsSlicer" value="@attr.IsSlicer" />
                            }
                        </td>
                        <td>
                            <input type="number" name="Variants[@i].ListPrice" value="@variant.ListPrice"
                                   class="form-control form-control-sm" step="0.01" min="0" style="width:110px" />
                        </td>
                        <td>
                            <input type="number" name="Variants[@i].SalePrice" value="@variant.SalePrice"
                                   class="form-control form-control-sm" step="0.01" min="0" style="width:110px" />
                        </td>
                        <td>
                            <input type="number" name="Variants[@i].CostPrice" value="@variant.CostPrice"
                                   class="form-control form-control-sm" step="0.01" min="0" style="width:110px" />
                        </td>
                        <td>
                            <input type="number" name="Variants[@i].VatRate" value="@variant.VatRate"
                                   class="form-control form-control-sm" step="1" min="0" max="100" style="width:80px" />
                        </td>
                        @for (int b = 0; b < branches.Count; b++)
                        {
                            <td>
                                <input type="hidden" name="Variants[@i].BranchOfficeStocks[@b].BranchOfficeId" value="@branches[b].Id" />
                                <input type="hidden" name="Variants[@i].BranchOfficeStocks[@b].BranchOfficeName" value="@branches[b].Name" />
                                <input type="number" name="Variants[@i].BranchOfficeStocks[@b].Stock" value="0"
                                       class="form-control form-control-sm" step="1" min="0" style="width:80px" />
                            </td>
                        }
                        <td>
                            <button type="button" class="btn btn-sm btn-ghost-danger btn-remove-variant p-1" title="Varyanti kaldir">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm" width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="text-muted small mt-2">
        <span id="variant-count">@Model.Variants.Count varyant</span> olusturuldu. Barkod otomatik olusturulur.
    </div>

    <script>
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-remove-variant');
        if (!btn) return;
        btn.closest('tr').remove();
        // Re-index all remaining rows
        var rows = document.querySelectorAll('#variant-table-container tbody tr');
        rows.forEach(function(row, idx) {
            row.querySelectorAll('input[name], select[name]').forEach(function(input) {
                input.name = input.name.replace(/Variants\[\d+\]/, 'Variants[' + idx + ']');
            });
        });
        // Update count
        var countEl = document.querySelector('#variant-count');
        if (countEl) countEl.textContent = rows.length + ' varyant';
        // Update next button state
        var nextBtn = document.getElementById('btn-step3-next');
        if (nextBtn) nextBtn.disabled = rows.length === 0;
    });
    </script>
}
