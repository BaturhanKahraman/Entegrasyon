@model Entegrasyon.MVC.Features.Products.ViewModels.VariantFormVm

@{
    var variant = Model.Variant!;
    var productId = Model.ProductId;
}

<div class="modal modal-blur show" style="display:block" tabindex="-1" id="variant-edit-modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Varyant Düzenle &mdash; <code>@variant.Barcode</code></h5>
                <button type="button" class="btn-close" onclick="closeVariantModal()"></button>
            </div>
            <form method="post" action="/products/@productId/variants/@variant.Id/edit"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@variant.Id" />
                <input type="hidden" name="CurrencyType" value="@variant.CurrencyType" />
                <div class="modal-body">
                    <!-- Varyant Adı (opsiyonel override) -->
                    <div class="mb-3">
                        <label class="form-label">Varyant Adı</label>
                        <input type="text" name="Name" class="form-control" maxlength="256"
                               value="@variant.Name" placeholder="Boş bırakırsanız otomatik hesaplanır (ör. Sarı XL)" />
                        <small class="form-hint">Özel bir isim vermek istemezseniz boş bırakın — varianter/slicer özelliklerinden üretilir.</small>
                    </div>

                    <!-- Fiyat Alanlari -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Liste Fiyati</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" name="ListPrice" class="form-control currency-input"
                                       value="@variant.ListPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       inputmode="decimal" autocomplete="off" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Satış Fiyati</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" name="SalePrice" class="form-control currency-input"
                                       value="@variant.SalePrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       inputmode="decimal" autocomplete="off" required />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Maliyet</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" name="CostPrice" class="form-control currency-input"
                                       value="@variant.CostPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       inputmode="decimal" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">E-Ticaret Fiyati</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" name="ECommercePrice" class="form-control currency-input"
                                       value="@variant.ECommercePrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       inputmode="decimal" autocomplete="off" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">KDV Oranı (%)</label>
                            <input type="number" name="VatRate" class="form-control"
                                   value="@variant.VatRate" min="0" max="100" step="0.01" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Desi</label>
                            <input type="number" name="DimensionalWeight" class="form-control"
                                   value="@variant.DimensionalWeight" min="0" step="0.01" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- Mevcut Görseller -->
                    @if (variant.UploadedImages.Any())
                    {
                        <h4 class="mb-2">Mevcut Görseller</h4>
                        <div class="row g-2 mb-3">
                            @foreach (var img in variant.UploadedImages)
                            {
                                <div class="col-4 col-sm-3">
                                    <div class="card card-sm">
                                        <img src="@img.Src" class="card-img-top" alt="Görsel"
                                             style="height:80px;object-fit:cover;" />
                                        <div class="card-body p-1 text-center">
                                            @if (img.IsMain)
                                            {
                                                <span class="badge bg-secondary-lt badge-sm">Ana</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary" style="font-size:0.7rem">#@img.Id</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Yeni Görsel Yükle -->
                    <h4 class="mb-2">Görsel Yükle</h4>
                    <div class="mb-3">
                        <input type="file" name="files" class="form-control" multiple accept="image/*" />
                        <small class="form-hint">Birden fazla görsel secebilirsiniz.</small>
                    </div>

                    <!-- Diger Varyantlardan Sec -->
                    @if (Model.OtherVariantImages.Any())
                    {
                        <h4 class="mb-2">Diger Varyantlardan Sec</h4>
                        @foreach (var group in Model.OtherVariantImages)
                        {
                            <p class="mb-1 text-secondary" style="font-size:0.8rem">
                                <code>@group.Barcode</code>
                            </p>
                            <div class="row g-2 mb-2">
                                @foreach (var img in group.Images)
                                {
                                    <div class="col-4 col-sm-3">
                                        <label class="form-imagecheck">
                                            <input type="checkbox" name="existingImageIds" value="@img.Id"
                                                   class="form-imagecheck-input" />
                                            <span class="form-imagecheck-figure">
                                                <img src="@img.Src" alt="Görsel"
                                                     class="form-imagecheck-image"
                                                     style="height:70px;object-fit:cover;width:100%;border-radius:4px;" />
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost-secondary"
                            onclick="closeVariantModal()">Vazgec</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show" onclick="closeVariantModal()"></div>

<script>
(function() {
    window.closeVariantModal = function() {
        var container = document.getElementById('modal-container');
        while (container.firstChild) container.removeChild(container.firstChild);
    };
})();
</script>
