@model Entegrasyon.MVC.Features.Products.ViewModels.CreateProductVm
@using Entegrasyon.Entity.Dtos.Category

@{
    var attrs = (ViewBag.NonVariantAttributes as List<CategoryAttributeDto> ?? [])
        .OrderByDescending(a => a.IsRequired).ToList();
}

<div data-wizard-step="2">
@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0 ps-3">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@err.ErrorMessage</li>
            }
        </ul>
    </div>
}
<form hx-post="/products/add/step2" hx-target="#wizard-content" hx-swap="innerHTML">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Title" value="@Model.Title" />
    <input type="hidden" name="Description" value="@Model.Description" />
    <input type="hidden" name="StockCode" value="@Model.StockCode" />
    <input type="hidden" name="Season" value="@Model.Season" />
    <input type="hidden" name="Year" value="@Model.Year" />
    <input type="hidden" name="BrandId" value="@Model.BrandId" />
    <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
    <input type="hidden" name="BrandName" value="@Model.BrandName" />
    <input type="hidden" name="CategoryName" value="@Model.CategoryName" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Kategori Özellikleri</h3>
            <span class="card-subtitle">@Model.CategoryName</span>
        </div>
        <div class="card-body">
            @if (attrs.Count == 0)
            {
                <div class="alert alert-info">Bu kategorinin ek özelliği bulunmamaktadır.</div>
            }
            else
            {
                <div class="row">
                    @for (int i = 0; i < attrs.Count; i++)
                    {
                        var attr = attrs[i];
                        var saved = Model.CategoryAttributes
                            .FirstOrDefault(a => a.CategoryAttributeId == attr.Id);
                        <div class="col-md-6 mb-3">
                            <label class="form-label @(attr.IsRequired ? "required fw-bold" : "")">
                                @attr.CategoriyAttributeHumanized
                            </label>
                            <input type="hidden" name="CategoryAttributes[@i].CategoryAttributeId" value="@attr.Id" />
                            <input type="hidden" name="CategoryAttributes[@i].AttributeName" value="@attr.CategoriyAttributeHumanized" />
                            <input type="hidden" name="CategoryAttributes[@i].IsRequired" value="@attr.IsRequired.ToString()" />

                            <div class="input-group">
                                <select name="CategoryAttributes[@i].ValueId"
                                        class="form-select attr-value-select"
                                        data-attribute-id="@attr.Id"
                                        @(attr.IsRequired ? "required" : "")>
                                    <option value="">Seçin...</option>
                                    @foreach (var val in attr.CategoryAttributeValues)
                                    {
                                        <option value="@val.Id" selected="@(saved?.ValueId == val.Id)">@val.Name</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary btn-icon attr-value-add-btn"
                                        data-attribute-id="@attr.Id"
                                        data-attribute-name="@attr.CategoriyAttributeHumanized"
                                        title="Yeni değer ekle">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a href="/products/add/back-to-step1" hx-get="/products/add/back-to-step1" hx-target="#wizard-content" hx-swap="innerHTML" class="btn btn-ghost-secondary">&larr; Geri</a>
            <button type="submit" class="btn btn-primary">Devam: Varyantlar &rarr;</button>
        </div>
    </div>
</form>

<partial name="Partials/_AttrValueQuickAddModal" />
</div>

<script>
(function () {
    'use strict';

    function initStep2TomSelects() {
        if (typeof TomSelect === 'undefined') {
            setTimeout(initStep2TomSelects, 50);
            return;
        }

        document.querySelectorAll('.attr-value-select').forEach(function (el) {
            // TomSelect kendi ürettiği .ts-wrapper div'ine orijinal select'in class
            // listesini de kopyalar — bu yüzden aynı selector wrapper'ı da yakalar.
            // tagName kontrolü olmadan wrapper'a new TomSelect() çağrısı atılırsa
            // TomSelect içinde "Cannot read properties of undefined (reading 'trim')"
            // ile çöker ve forEach o noktada durur (kalan select'ler biçimsiz kalır).
            if (el.tagName !== 'SELECT' || el.tomselect) return;

            // Yeni değer ekleme "+" butonu → ortak quick-add modal'ı ile yapılır (marka
            // ekleme deseniyle aynı). TomSelect'in inline create: callback'i bilerek YOK —
            // aynı endpoint'e giden iki paralel mekanizma tutarsız UX/bakım riski taşırdı.
            new TomSelect(el, {
                allowEmptyOption: true,
                placeholder: 'Seçin...',
                maxOptions: null
            });
        });

        // "+" butonları → ortak hızlı-ekle modal'ı (marka quick-add deseni)
        document.querySelectorAll('.attr-value-add-btn').forEach(function (btn) {
            if (btn.dataset.qaBound) return; // HTMX re-swap guard
            btn.dataset.qaBound = '1';
            btn.addEventListener('click', function () {
                var attrId = btn.getAttribute('data-attribute-id');
                var attrName = btn.getAttribute('data-attribute-name');
                window.openAttrValueQuickAdd(attrId, attrName, function (id, name) {
                    var sel = document.querySelector('.attr-value-select[data-attribute-id="' + attrId + '"]');
                    if (!sel || !sel.tomselect) return;
                    sel.tomselect.addOption({ value: String(id), text: name });
                    sel.tomselect.setValue(String(id));
                });
            });
        });
    }

    // Run on direct load
    initStep2TomSelects();

    // Re-run after HTMX swaps this partial back in (wizard navigation). Bu <script>
    // her swap'ta yeniden çalıştığı için document'a listener eklemek çoğullaşır
    // (her swap bir öncekini ekler, hiçbiri kaldırılmaz) — window bayrağıyla TEK
    // sefer kaydediyoruz. Ayrıca htmx bazı durumlarda AYNI swap için hem bu script'i
    // çalıştırıp hem afterSwap'ı tetikleyebiliyor; yukarıdaki tagName/tomselect
    // guard'ı bu çifte-çağrıyı da zararsız hale getiriyor.
    if (!window.__step2AfterSwapBound) {
        window.__step2AfterSwapBound = true;
        document.addEventListener('htmx:afterSwap', function () {
            if (document.querySelector('[data-wizard-step="2"]')) initStep2TomSelects();
        });
    }
})();
</script>
