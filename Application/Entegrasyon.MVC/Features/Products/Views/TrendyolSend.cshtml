@using Entegrasyon.MVC.Features.Products.ViewModels
@model TrendyolSendVm

<div class="d-flex justify-content-end mb-3">
    <a href="/products/@Model.ProductId/sync" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left icon"></i>
        Geri Don
    </a>
</div>

        <div class="row row-deck row-cards">

            @* Section 1: Preflight Checks *@
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">On-Ucus Kontrolleri</h3>
                    </div>
                    <div class="card-body">
                        @if (Model.Preflight is null)
                        {
                            <div class="alert alert-warning">
                                On-ucus kontrolleri yuklenemedi. Urunun kategori ve marka eslestirmelerini kontrol edin.
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @{ RenderCheck(Model.Preflight.CategoryMatched,
                                    "Kategori Eslestirmesi",
                                    Model.Preflight.CategoryMatched
                                        ? $"Eslesti: {Model.Preflight.MatchedCategoryName}"
                                        : "Trendyol kategori eslestirmesi bulunamadi",
                                    Model.Preflight.CategoryMatched ? null : "/marketplace/matching?tab=categories"); }

                                @{ RenderCheck(Model.Preflight.BrandMatched,
                                    "Marka Eslestirmesi",
                                    Model.Preflight.BrandMatched
                                        ? $"Eslesti: {Model.Preflight.MatchedBrandName}"
                                        : "Trendyol marka eslestirmesi bulunamadi",
                                    Model.Preflight.BrandMatched ? null : "/marketplace/matching?tab=brands"); }

                                @{ RenderCheck(Model.Preflight.RequiredAttributesMatched,
                                    "Zorunlu Ozellikler",
                                    Model.Preflight.RequiredAttributesMatched
                                        ? "Tum zorunlu ozellikler eslesti"
                                        : $"Eksik: {string.Join(", ", Model.Preflight.MissingAttributes)}",
                                    Model.Preflight.RequiredAttributesMatched ? null : "/marketplace/matching?tab=attributes"); }

                                @{ RenderCheck(Model.Preflight.HasVariants,
                                    "Varyant Durumu",
                                    Model.Preflight.HasVariants
                                        ? "En az bir varyant mevcut"
                                        : "Urunun varyanti bulunmuyor",
                                    Model.Preflight.HasVariants ? null : $"/products/{Model.ProductId}/variants"); }

                                @{ RenderCheck(Model.Preflight.AllVariantsHaveBarcodes,
                                    "Barkod Durumu",
                                    Model.Preflight.AllVariantsHaveBarcodes
                                        ? "Tum varyantlarin barkodu mevcut"
                                        : "Barkodu olmayan varyantlar var",
                                    Model.Preflight.AllVariantsHaveBarcodes ? null : $"/products/{Model.ProductId}/variants"); }
                            </div>

                            @if (Model.PreflightPassed)
                            {
                                <div class="alert alert-success mt-3 mb-0">
                                    <div class="d-flex">
                                        <div>
                                            <i class="ti ti-check icon alert-icon"></i>
                                        </div>
                                        <div>Tum kontroller basarili. Urun gonderime hazir.</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger mt-3 mb-0">
                                    <div class="d-flex">
                                        <div>
                                            <i class="ti ti-alert-triangle icon alert-icon"></i>
                                        </div>
                                        <div>Bazi kontroller basarisiz. Lutfen eksikleri tamamlayin.</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            @* Section 2: Override Form + Send *@
            <div class="col-lg-6">
                <form method="post" action="/products/@Model.ProductId/sync/trendyol/send">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Gonderim Ayarlari</h3>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Baslik Override</label>
                                <input type="text" class="form-control" name="TitleOverride"
                                       value="@Model.TitleOverride"
                                       placeholder="Bos birakilirsa urun basligi kullanilir"
                                       @(Model.PreflightPassed ? "" : "disabled")>
                                <small class="form-hint">Trendyol'da gorunecek baslik. Bos birakirsaniz urunun mevcut basligi gonderilir.</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Aciklama Override</label>
                                <textarea class="form-control" name="DescriptionOverride" rows="4"
                                          placeholder="Bos birakilirsa urun aciklamasi kullanilir"
                                          @(Model.PreflightPassed ? "" : "disabled")>@Model.DescriptionOverride</textarea>
                                <small class="form-hint">Trendyol'da gorunecek aciklama. Bos birakirsaniz urunun mevcut aciklamasi gonderilir.</small>
                            </div>

                            @if (Model.Variants.Any())
                            {
                                <hr class="my-3" />
                                <h4 class="subheader mb-2">Varyant Fiyat Override</h4>
                                <small class="text-secondary d-block mb-3">Bos birakirsaniz urunun mevcut fiyati gonderilir.</small>
                                <div class="table-responsive">
                                    <table class="table table-vcenter table-sm">
                                        <thead>
                                            <tr>
                                                <th>Barkod</th>
                                                <th class="text-end">Liste Fiyati</th>
                                                <th class="text-end">Satis Fiyati</th>
                                                <th>Trendyol Liste</th>
                                                <th>Trendyol Satis</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < Model.Variants.Count; i++)
                                            {
                                                var v = Model.Variants[i];
                                                <tr>
                                                    <td><code>@v.Barcode</code>
                                                        <input type="hidden" name="Variants[@i].VariantId" value="@v.VariantId" />
                                                        <input type="hidden" name="Variants[@i].Barcode" value="@v.Barcode" />
                                                        <input type="hidden" name="Variants[@i].ListPrice" value="@v.ListPrice" />
                                                        <input type="hidden" name="Variants[@i].SalePrice" value="@v.SalePrice" />
                                                    </td>
                                                    <td class="text-end text-secondary">@v.ListPrice.ToString("N2")</td>
                                                    <td class="text-end text-secondary">@v.SalePrice.ToString("N2")</td>
                                                    <td>
                                                        <input type="number" class="form-control form-control-sm"
                                                               name="Variants[@i].ListPriceOverride"
                                                               value="@v.ListPriceOverride"
                                                               placeholder="@v.ListPrice.ToString("N2")"
                                                               step="0.01" min="0"
                                                               @(Model.PreflightPassed ? "" : "disabled") />
                                                    </td>
                                                    <td>
                                                        <input type="number" class="form-control form-control-sm"
                                                               name="Variants[@i].SalePriceOverride"
                                                               value="@v.SalePriceOverride"
                                                               placeholder="@v.SalePrice.ToString("N2")"
                                                               step="0.01" min="0"
                                                               @(Model.PreflightPassed ? "" : "disabled") />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                        <div class="card-footer text-end">
                            <button type="submit" class="btn btn-primary"
                                    @(Model.PreflightPassed ? "" : "disabled")
                                    onclick="return confirm('Bu urunu Trendyol\'a gondermek istediginize emin misiniz?')">
                                <i class="ti ti-send icon"></i>
                                Trendyol'a Gonder
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            @* Section 3: Preview (only when preflight passes and preview is available) *@
            @if (Model.Preview is not null)
            {
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Gonderim On Izleme</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="datagrid">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title">Baslik</div>
                                            <div class="datagrid-content">@Model.Preview.Title</div>
                                        </div>
                                        <div class="datagrid-item">
                                            <div class="datagrid-title">Marka</div>
                                            <div class="datagrid-content">@Model.Preview.BrandName &rarr; @Model.Preview.TrendyolBrandName</div>
                                        </div>
                                        <div class="datagrid-item">
                                            <div class="datagrid-title">Kategori</div>
                                            <div class="datagrid-content">@Model.Preview.CategoryName &rarr; @Model.Preview.TrendyolCategoryName</div>
                                        </div>
                                        <div class="datagrid-item">
                                            <div class="datagrid-title">Trendyol Kategori ID</div>
                                            <div class="datagrid-content">@Model.Preview.TrendyolCategoryId</div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Model.Preview.Description))
                                        {
                                            <div class="datagrid-item">
                                                <div class="datagrid-title">Aciklama</div>
                                                <div class="datagrid-content">@Model.Preview.Description</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    @if (Model.Preview.Attributes.Count > 0)
                                    {
                                        <h4 class="subheader mb-2">Ozellikler</h4>
                                        <div class="datagrid">
                                            @foreach (var attr in Model.Preview.Attributes)
                                            {
                                                <div class="datagrid-item">
                                                    <div class="datagrid-title">@attr.Name</div>
                                                    <div class="datagrid-content">@attr.Value</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (Model.Preview.Variants.Count > 0)
                            {
                                <h4 class="subheader mt-3 mb-2">Varyantlar</h4>
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Barkod</th>
                                                <th>Ozellikler</th>
                                                <th class="text-end">Liste Fiyati</th>
                                                <th class="text-end">Satis Fiyati</th>
                                                <th class="text-end">Stok</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var variant in Model.Preview.Variants)
                                            {
                                                <tr>
                                                    <td><code>@variant.Barcode</code></td>
                                                    <td>@variant.Attributes</td>
                                                    <td class="text-end">@variant.ListPrice.ToString("N2") TL</td>
                                                    <td class="text-end">@variant.SalePrice.ToString("N2") TL</td>
                                                    <td class="text-end">@variant.Quantity</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>

@functions {
    void RenderCheck(bool passed, string label, string detail, string? fixUrl = null)
    {
        <div class="list-group-item @(!passed && fixUrl != null ? "list-group-item-action" : "")"
             @(!passed && fixUrl != null ? $"onclick=\"window.location='{fixUrl}'\"" : "")
             style="@(!passed && fixUrl != null ? "cursor:pointer" : "")">
            <div class="row align-items-center">
                <div class="col-auto">
                    @if (passed)
                    {
                        <span class="status-dot status-dot-animated status-green"></span>
                    }
                    else
                    {
                        <span class="status-dot status-dot-animated status-red"></span>
                    }
                </div>
                <div class="col">
                    <div class="d-block text-truncate">@label</div>
                    <div class="d-block text-secondary text-truncate mt-n1">@detail</div>
                </div>
                <div class="col-auto">
                    @if (passed)
                    {
                        <i class="ti ti-check icon text-green"></i>
                    }
                    else if (fixUrl != null)
                    {
                        <a href="@fixUrl" class="btn btn-sm btn-outline-primary">
                            <i class="ti ti-external-link me-1"></i>Duzelt
                        </a>
                    }
                    else
                    {
                        <i class="ti ti-x icon text-red"></i>
                    }
                </div>
            </div>
        </div>
    }
}
