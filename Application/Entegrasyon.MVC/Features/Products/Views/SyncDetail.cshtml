@using Entegrasyon.Entity.Dtos.Product
@model ProductSyncDetailDto

@functions {
    static (string Css, string Text) StateBadge(MarketplaceSyncState state) => state switch
    {
        MarketplaceSyncState.Synced => ("bg-green-lt", "Senkronize"),
        MarketplaceSyncState.Waiting => ("bg-warning-lt", "Bekliyor"),
        MarketplaceSyncState.Processing => ("bg-info-lt", "İşleniyor"),
        MarketplaceSyncState.OutOfSync => ("bg-orange-lt", "Güncellenmemiş"),
        MarketplaceSyncState.Failed => ("bg-danger-lt", "Hatalı"),
        MarketplaceSyncState.Rejected => ("bg-danger-lt", "Reddedildi"),
        _ => ("bg-secondary-lt", "Hiç Gönderilmemiş")
    };

    // Şu an gönderim ekranı olan pazaryerleri (T119: diğerleri için generic ekran henüz yok)
    static bool HasSendScreen(int marketPlaceId) => marketPlaceId == 1; // Trendyol
}

<div class="d-flex justify-content-end mb-3">
    <a href="/marketplace/matching/@Model.ProductId" class="btn btn-outline-primary">
        Eşleştirme Sayfasına Git
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Pazaryeri Senkronizasyon Durumu</h3>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var mp in Model.Marketplaces)
            {
                var badge = StateBadge(mp.SyncState);
                <div class="col-md-6">
                    <div class="card card-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h4 class="m-0">@mp.MarketPlaceName</h4>
                                <span class="badge @badge.Css">@badge.Text</span>
                            </div>

                            @if (!mp.HasCredentials)
                            {
                                <p class="text-secondary mb-2">API anahtarları girilmemiş.</p>
                                <a href="/settings/integrations" class="btn btn-sm btn-outline-warning">
                                    Anahtarları Gir
                                </a>
                            }
                            else
                            {
                                @if (mp.LastSyncedAt.HasValue)
                                {
                                    <div class="text-secondary small mb-1">
                                        Son senkron: @mp.LastSyncedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(mp.BatchRequestId))
                                {
                                    <div class="text-secondary small mb-1">Batch: <code>@mp.BatchRequestId</code></div>
                                }
                                @if (!string.IsNullOrEmpty(mp.StatusMessage))
                                {
                                    <div class="alert alert-danger py-2 px-2 mb-2 small">@mp.StatusMessage</div>
                                }

                                <div class="btn-list">
                                    @if (HasSendScreen(mp.MarketPlaceId))
                                    {
                                        <a href="/products/@Model.ProductId/sync/trendyol/send" class="btn btn-sm btn-outline-primary">
                                            Gönderim
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled>Gönderim (Yakında)</button>
                                    }

                                    @if (mp.SyncState is MarketplaceSyncState.Failed or MarketplaceSyncState.Rejected)
                                    {
                                        <form method="post" action="/products/@Model.ProductId/sync/@mp.MarketPlaceId/retry" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="ti ti-refresh me-1"></i>Yeniden Dene
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
