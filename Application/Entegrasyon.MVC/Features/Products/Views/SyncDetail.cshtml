@using Entegrasyon.Entity.Dtos.Product
@model ProductDetailDto

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="page-pretitle">Urun Senkronizasyon</div>
                <h2 class="page-title">@Model.Title</h2>
            </div>
            <div class="col-auto ms-auto">
                <a href="/marketplace/matching/@Model.Id" class="btn btn-outline-primary">
                    Eslestirme Sayfasina Git
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Pazaryeri Senkronizasyon Durumu</h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card card-sm">
                            <div class="card-body">
                                <h4>Trendyol</h4>
                                <p class="text-secondary">Senkronizasyon durumu burada goruntulenecektir.</p>
                                <a href="/products/@Model.Id/sync/trendyol/send" class="btn btn-sm btn-outline-primary">
                                    Trendyol Gonderim
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-sm">
                            <div class="card-body">
                                <h4>Hepsiburada</h4>
                                <p class="text-secondary">Senkronizasyon durumu burada goruntulenecektir.</p>
                                <button class="btn btn-sm btn-outline-secondary" disabled>Yakinda</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
