@using Entegrasyon.Entity.Dtos.Product
@model ProductDetailDto

<div class="d-flex justify-content-end mb-3">
    <a href="/marketplace/matching/@Model.Id" class="btn btn-outline-primary">
        Eşleştirme Sayfasına Git
    </a>
</div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Pazaryeri Senkronizasyon Durumu</h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card card-sm">
                            <div class="card-body">
                                <h4>Trendyol</h4>
                                <p class="text-secondary">Senkronizasyon durumu burada görüntülenecektir.</p>
                                <a href="/products/@Model.Id/sync/trendyol/send" class="btn btn-sm btn-outline-primary">
                                    Trendyol Gönderim
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card card-sm">
                            <div class="card-body">
                                <h4>Hepsiburada</h4>
                                <p class="text-secondary">Senkronizasyon durumu burada görüntülenecektir.</p>
                                <button class="btn btn-sm btn-outline-secondary" disabled>Yakında</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
