@model Entegrasyon.MVC.Features.Products.ViewModels.StoreSettingsVm
@using System.Globalization

@*
    Storefront (Mağaza) Ayarları — tam sayfa (PA #75).
    PRG: tek <form method="post">; "Kaydet" → /storefront, "Kaydet ve Yayınla" → formaction /storefront/publish.
    Designer bu sayfayı sonra cilalar (kart düzeni / görsel hiyerarşi). Burada FONKSİYONEL iskelet var.
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        @if (Model.IsPublished)
        {
            <span class="badge bg-green-lt">Mağazada Yayında</span>
        }
        else
        {
            <span class="badge bg-secondary-lt">Mağazada Yayınlanmadı</span>
        }
    </div>
    <a href="/products/@Model.ProductId" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left icon"></i>
        Ürüne Dön
    </a>
</div>

@if (!Model.EcommerceEnabled)
{
    <div class="alert alert-warning" role="alert">
        <div class="d-flex">
            <div><i class="ti ti-alert-triangle icon alert-icon"></i></div>
            <div>
                <h4 class="alert-title">E-ticaret modülü aktif değil</h4>
                <div class="text-secondary">
                    Storefront ayarlarını kaydedebilirsiniz, ancak ürünü mağazada
                    <strong>yayınlamak</strong> için e-ticaret modülünün aktif olması gerekir.
                </div>
            </div>
        </div>
    </div>
}

<form method="post" action="/products/@Model.ProductId/storefront">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">SEO Bilgileri</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">SEO Başlık</label>
                    <input type="text" name="SeoTitle" value="@Model.SeoTitle" class="form-control"
                           placeholder="@Model.ProductTitle" maxlength="70" />
                    <small class="form-hint">Boş bırakılırsa ürün adı kullanılır (maks. 70 karakter)</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">SEO URL (Slug)</label>
                    <input type="text" name="SeoSlug" value="@Model.SeoSlug" class="form-control"
                           placeholder="ornek-urun-adi" />
                    <small class="form-hint">Boş bırakılırsa otomatik oluşturulur</small>
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">SEO Açıklama</label>
                    <textarea name="SeoDescription" class="form-control" rows="2" maxlength="160"
                              placeholder="Arama motorlarında görünecek kısa açıklama...">@Model.SeoDescription</textarea>
                    <small class="form-hint">Maks. 160 karakter</small>
                </div>
                <div class="col-12">
                    <label class="form-label">SEO Anahtar Kelimeler</label>
                    <input type="text" name="SeoKeywords" value="@Model.SeoKeywords" class="form-control"
                           placeholder="anahtar, kelime, virgül, ile" />
                </div>
            </div>
        </div>
    </div>

    @if (Model.VariantPrices.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Mağaza Fiyatları</h3>
            </div>
            <div class="card-body">
                <p class="text-secondary small mb-3">Her varyant için mağazada görünecek fiyatı belirleyin. Boş bırakılırsa satış fiyatı kullanılır.</p>
                <div class="table-responsive">
                    <table class="table table-vcenter table-sm">
                        <thead>
                            <tr>
                                <th>Varyant</th>
                                <th>Satış Fiyatı</th>
                                <th>Mağaza Fiyatı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.VariantPrices.Count; i++)
                            {
                                var v = Model.VariantPrices[i];
                                <tr>
                                    <td>
                                        <input type="hidden" name="VariantPrices[@i].VariantId" value="@v.VariantId" />
                                        <input type="hidden" name="VariantPrices[@i].VariantName" value="@v.VariantName" />
                                        <input type="hidden" name="VariantPrices[@i].SalePrice" value="@v.SalePrice.ToString(CultureInfo.InvariantCulture)" />
                                        <span class="fw-bold">@v.VariantName</span>
                                    </td>
                                    <td class="text-secondary">@v.SalePrice.ToString("N2") TL</td>
                                    <td>
                                        <div class="input-group input-group-sm" style="width:160px">
                                            <span class="input-group-text">₺</span>
                                            <input type="text" name="VariantPrices[@i].ECommercePrice"
                                                   value="@v.ECommercePrice.ToString("0.##", CultureInfo.InvariantCulture)"
                                                   class="form-control currency-input" inputmode="decimal" autocomplete="off" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-outline-primary">
            <i class="ti ti-device-floppy icon"></i>
            Kaydet
        </button>
        @if (Model.EcommerceEnabled)
        {
            <button type="submit" class="btn btn-primary"
                    formaction="/products/@Model.ProductId/storefront/publish">
                <i class="ti ti-cloud-upload icon"></i>
                Kaydet ve Yayınla
            </button>
        }
        else
        {
            <button type="button" class="btn btn-primary" disabled
                    title="E-ticaret modülü aktif değil">
                <i class="ti ti-cloud-upload icon"></i>
                Kaydet ve Yayınla
            </button>
        }
    </div>
</form>
