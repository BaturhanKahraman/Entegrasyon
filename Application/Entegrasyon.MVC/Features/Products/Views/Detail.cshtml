@model Entegrasyon.Entity.Dtos.Product.ProductDetailDto

@{
    ViewData.SetBreadcrumb(("Ürünler", "/products"), (Model.Title, null));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        @if (Model.IsPublished)
        {
            <span class="badge bg-green-lt">Mağazada Yayında</span>
        }
        else
        {
            <span class="badge bg-secondary-lt">Mağazada Yayınlanmadı</span>
        }
    </div>
    <div class="btn-list">
        <a href="/products/@Model.Id/edit" class="btn btn-primary">
            Düzenle
        </a>
        <a href="/products/@Model.Id/variants" class="btn btn-outline-primary">
            Varyantlari Yonet
        </a>
        <button class="btn btn-outline-danger"
                hx-post="/products/@Model.Id/delete"
                hx-confirm="Bu ürünü silmek istediğinize emin misiniz?"
                hx-on::after-request="if(event.detail.successful) window.location='/products'">
            Sil
        </button>
        <a href="#" class="btn btn-outline-warning"
           hx-get="/products/@Model.Id/discount"
           hx-target="#modal-container"
           hx-swap="innerHTML">
            <i class="ti ti-discount-2 icon"></i>
            Indirim Uygula
        </a>
        <button type="button" class="btn btn-outline-info"
                onclick="window.printAgent && window.printAgent.printVariants(@Json.Serialize(Model.ProductVariantsDetails?.Select(v => v.Id).ToList() ?? new List<Guid>()), 1)">
            <i class="ti ti-barcode icon"></i>
            Barkod Yazdır (Agent)
        </button>
        <a href="/products/@Model.Id/barcode" class="btn btn-ghost-secondary" target="_blank"
           title="ZPL dosyasını indir (yedek yöntem)">
            <i class="ti ti-download icon"></i>
            ZPL İndir
        </a>
        <a href="/products" class="btn btn-outline-secondary">
            Listeye Don
        </a>
    </div>
</div>

<div id="modal-container"></div>

        <!-- Ürün 360° (genel + pazaryeri durumu + aktivite/sipariş/stok sekmeleri) -->
        <partial name="Partials/_Product360" model="Model" />

        <!-- Store Settings (lazy loaded via HTMX) -->
        <div class="mt-3"
             hx-get="/products/@Model.Id/store-settings"
             hx-trigger="load"
             hx-swap="innerHTML">
            <div class="card">
                <div class="card-body">
                    <div class="placeholder-glow">
                        <div class="placeholder col-4 mb-2"></div>
                        <div class="placeholder col-6"></div>
                    </div>
                </div>
            </div>
        </div>
