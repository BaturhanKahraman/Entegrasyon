@model List<Entegrasyon.Entity.Dtos.Branches.BranchOfficePageListDto>

<div class="d-flex justify-content-end mb-3">
    <a href="/branch-offices/create" class="btn btn-primary">
        <i class="ti ti-plus icon"></i>
        Depo Ekle
    </a>
</div>

        <div class="card">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Depo Adı</th>
                                <th>Kullanıcı Sayısı</th>
                                <th>Toplam Stok</th>
                                <th>Pazaryeri</th>
                                <th>Oluşturma Tarihi</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var branch in Model)
                            {
                                <tr class="table-row-clickable" data-href="/branch-offices/@branch.Id" role="link" tabindex="0">
                                    <td>
                                        @branch.Name
                                        @if (branch.IsDefaultMarketPlaceStock)
                                        {
                                            <span class="badge bg-green-lt ms-1">Varsayılan</span>
                                        }
                                    </td>
                                    <td class="text-secondary">@branch.UserCount</td>
                                    <td>
                                        <span class="badge @(branch.TotalStock > 0 ? "bg-green-lt" : "bg-red-lt")">
                                            @branch.TotalStock
                                        </span>
                                    </td>
                                    <td class="text-secondary">@branch.MarketPlaceCount pazaryeri</td>
                                    <td class="text-secondary">@branch.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            @if (!branch.IsHeadquarters)
                                            {
                                                <form method="post"
                                                      action="/branch-offices/@branch.Id/request-delete"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Bu depo için silme talebi açılacak. Devam etmek istiyor musunuz?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Silme Talebi Aç
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body">
                    <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                             model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                             {
                                 Title = "Depo bulunamadı",
                                 Subtitle = "Henüz depo tanımlanmamış."
                             }'/>
                </div>
            }
        </div>
