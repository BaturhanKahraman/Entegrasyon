@model List<Entegrasyon.Entity.Dtos.Branches.BranchOfficePageListDto>

        <div class="card">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover">
                        <thead>
                            <tr>
                                <th>Sube Adi</th>
                                <th>Kullanici Sayısı</th>
                                <th>Toplam Stok</th>
                                <th>Pazaryeri</th>
                                <th>Olusturma Tarihi</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var branch in Model)
                            {
                                <tr>
                                    <td>
                                        <a href="/branch-offices/@branch.Id" class="text-reset">
                                            @branch.Name
                                            @if (branch.IsDefaultMarketPlaceStock)
                                            {
                                                <span class="badge bg-green-lt ms-1">Varsayilan</span>
                                            }
                                        </a>
                                    </td>
                                    <td class="text-secondary">@branch.UserCount</td>
                                    <td>
                                        <span class="badge @(branch.TotalStock > 0 ? "bg-green-lt" : "bg-red-lt")">
                                            @branch.TotalStock
                                        </span>
                                    </td>
                                    <td class="text-secondary">@branch.MarketPlaceCount pazaryeri</td>
                                    <td class="text-secondary">@branch.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            <a href="/branch-offices/@branch.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                                            @if (!branch.IsHeadquarters)
                                            {
                                                <form method="post"
                                                      action="/branch-offices/@branch.Id/request-delete"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Bu şube için silme talebi açılacak. Devam etmek istiyor musunuz?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Silme Talebi Aç
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body">
                    <partial name="~/Shared/Views/Partials/_EmptyState.cshtml"
                             model='new Entegrasyon.MVC.Shared.ViewModels.EmptyStateVm
                             {
                                 Title = "Sube bulunamadı",
                                 Subtitle = "Henüz sube tanimlanmamis."
                             }'/>
                </div>
            }
        </div>
