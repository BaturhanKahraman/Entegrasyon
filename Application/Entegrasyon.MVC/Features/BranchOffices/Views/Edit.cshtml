@model Entegrasyon.MVC.Features.BranchOffices.ViewModels.BranchOfficeEditVm

<div class="d-flex justify-content-end mb-3">
    <a href="/branch-offices/@Model.Id" class="btn btn-outline-secondary">Depoya Dön</a>
</div>

        <form method="post" action="/branch-offices/@Model.Id/edit">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Depo Bilgileri</h3>
                </div>
                <div class="card-body">
                    <input asp-for="Id" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required">Depo Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Depo adı giriniz" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Adres</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Depo adresi (isteğe bağlı)"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                        <small class="form-hint">İsteğe bağlı, en fazla 500 karakter.</small>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a href="/branch-offices/@Model.Id" class="btn btn-ghost-secondary me-2">İptal</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
