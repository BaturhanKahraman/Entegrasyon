@model Entegrasyon.MVC.Features.BranchOffices.ViewModels.BranchOfficeCreateVm

<div class="d-flex justify-content-end mb-3">
    <a href="/branch-offices" class="btn btn-outline-secondary">Listeye Don</a>
</div>

        <form method="post" action="/branch-offices/create">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Sube Bilgileri</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required">Sube Adi</label>
                        <input asp-for="Name" class="form-control" placeholder="Sube adi giriniz" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a href="/branch-offices" class="btn btn-ghost-secondary me-2">Iptal</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </form>
