@using Entegrasyon.MVC.Components.Razor.Common.Form
@using Shared.Helpers;
@inject IRandomGenerator _rndm;
@if(!string.IsNullOrEmpty(CategoryName))
{
    <span>@CategoryName için özellik ekleme işlemi.</span>
}
<EditForm Model=_model>
    <DataAnnotationsValidator />
    <button type="button" class="btn btn-secondary" @onclick="AddAttribute">Özellik Ekle</button>
    @foreach(var item in _model.CategoryAttributeList)
    {
        <div class="row mt-2 border">
            <div class="col-sm d-flex flex-column">
                <InputTextDisplay InputTextId="@string.Concat(item.FormUniqueId,"_CategoryAttributeKey")" DisplayFor="@(()=>item.CategoryAttributeKey)">
                    <InputText id="@string.Concat(item.FormUniqueId,"_CategoryAttributeKey")"
                               class="form-control form-control-sm" @bind-Value="item.CategoryAttributeKey" />
                    <ValidationMessage For="()=>item.CategoryAttributeKey" />
                </InputTextDisplay>
                <InputTextDisplay InputTextId="@string.Concat(item.FormUniqueId,"_CustomValues")" DisplayFor="@(()=>item.CustomValues)">
                    <InputText id="@string.Concat(item.FormUniqueId,"_CustomValues")"
                               class="form-control form-control-sm" @bind-Value="item.CustomValues" />
                    <ValidationMessage For="()=>item.CustomValues" />
                </InputTextDisplay>
            </div>
            <div class="col-sm d-flex flex-column flex-wrap p-1">
                <CheckBoxDisplay CheckboxId="@string.Concat(item.FormUniqueId,"_IsRequired")" DisplayFor="@(()=>item.IsRequired)">
                    <InputCheckbox id="@string.Concat(item.FormUniqueId,"_IsRequired")" class="form-check-input" @bind-Value="item.IsRequired" />
                </CheckBoxDisplay>
                <CheckBoxDisplay CheckboxId="@string.Concat(item.FormUniqueId,"_AllowCustom")" DisplayFor="@(()=>item.AllowCustom)">
                    <InputCheckbox id="@string.Concat(item.FormUniqueId,"_AllowCustom")" class="form-check-input"
                                   Value="@item.AllowCustom"
                                   ValueChanged="@((bool status)=>ChangeAllowCustom(item,status))"
                                   ValueExpression="@(()=> item.AllowCustom )"
                    />
                </CheckBoxDisplay>
                <CheckBoxDisplay CheckboxId="@string.Concat(item.FormUniqueId,"_IsSlicer")" DisplayFor="@(()=>item.IsSlicer)">
                    <InputCheckbox id="@string.Concat(item.FormUniqueId,"_IsSlicer")" class="form-check-input" @bind-Value="item.IsSlicer" />
                </CheckBoxDisplay>
                <CheckBoxDisplay CheckboxId="@string.Concat(item.FormUniqueId,"_IsVarianter")" DisplayFor="@(()=>item.IsVarianter)">
                    <InputCheckbox id="@string.Concat(item.FormUniqueId,"_IsVarianter")" class="form-check-input" @bind-Value="item.IsVarianter" />
                </CheckBoxDisplay>
            </div>
            <div class="col-sm-1 d-flex align-items-center">
                <button type="button" class="btn btn-danger" @onclick="()=>RemevoAttribute(item)">Sil</button>
            </div>
        </div>
    }
    @if(_model.CategoryAttributeList.Any())
    {
        <button type="submit" class="btn btn-primary mt-2">Gönder</button>
    }
</EditForm>