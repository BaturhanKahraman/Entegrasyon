@typeparam T
@inherits Display<T>

@if(ChildContent == null)
{
    <label>@label</label>
}
else
{
    <div class="form-check form-check-primary">
        @ChildContent
        <label class="form-check-label" for="@CheckboxId">
            @label
        </label>
        <ValidationMessage For="DisplayFor" />

    </div>
}
@code{
    [Parameter] public string CheckboxId { get; set; }
}