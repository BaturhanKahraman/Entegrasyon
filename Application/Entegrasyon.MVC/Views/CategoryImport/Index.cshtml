@{
    ViewData["Title"] = "Kategori İçe Aktarım";
    ViewData["PageTitle"] = "Kategori İçe Aktarım";
}
@section Styles{
    @*for tab*@
    <link href="~/css/tabs.css" rel="stylesheet" />
    @*for jstree*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.2.1/themes/default/style.min.css" />
}
<div class="container mt-3">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="simple-tab">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item " role="presentation">
                            <button class="nav-link active" id="trendyol-button" data-bs-toggle="tab" data-bs-target="#trendyol-tab" type="button" role="tab" aria-controls="trendyol-tab" aria-selected="true" tabindex="-1">Trendyol</button>
                        </li>
                        <li class="nav-item " role="presentation">
                            <button disabled class="nav-link" id="csv-button" data-bs-toggle="tab" data-bs-target="#csv-tab" type="button" role="tab" aria-controls="csv-tab" aria-selected="false" tabindex="-1">CSV</button>

                        </li>
                        <li class="nav-item " role="presentation">
                            <button disabled class="nav-link" id="excel-button" data-bs-toggle="tab" data-bs-target="#excel-tab" type="button" role="tab" aria-controls="excel-tab" aria-selected="false" tabindex="-1">Excel</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="trendyol-tab" role="tabpanel" aria-labelledby="trendyol-tab" tabindex="0">
                            <div class="mt-3">
                                <p>
                                    Trendyol kategorilerini getirip seçerek içe aktarmak için lütfen
                                    <a id="get-button" href="javascript:void(0)">tıklayın</a>
                                    <div id="trenyol-fetch-error" style="display:none;" class="alert alert-danger" role="alert">
                                        Verileri trendyoldan çekmeye çalışırken hata meydana geldi.
                                    </div>
                                </p>
                                <div id="trendyol-spinner" style="display:none;" class="mx-auto spinner-border text-primary" role="status">
                                    <span class="sr-only"></span>
                                </div>
                                <div id="trendyol-tree">
                                </div>
                                <div id="trendyol-buttons" style="display:none;">
                                    <button id="send-button" class="btn btn-success">Seçilenleri içeri aktar</button>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="csv-tab" role="tabpanel" aria-labelledby="csv-tab" tabindex="0">
                            <p class="mt-3">csv</p>
                        </div>
                        <div class="tab-pane fade" id="excel-tab" role="tabpanel" aria-labelledby="excel-tab" tabindex="0">
                            <p class="mt-3">excel</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.2.1/jstree.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#get-button").click(getTrendyolCategories);
            $("#send-button").click(sendSelectedDatas);
        });
        function getTrendyolCategories() {
            $('#trendyol-spinner').toggle();
            $.get('@Url.Action("GetTrendyolCategories")', function (data, status) {
                if (status !== 'success') {
                    $('#trenyol-fetch-error').toggle();
                    $('trendyol-spinner').toggle();
                    return;
                }
                processJsTree(data);
                $('#trendyol-spinner').toggle();
                $('#trendyol-buttons').css('display', 'flex');
            });
        }
        function sendSelectedDatas() {
            const tree = $('#trendyol-tree').jstree();
            const checkedCategories = tree.get_checked(true);

            // Top categories
            const topCategories = Array.from(new Set(checkedCategories.flatMap(n => n.parents).filter(i => i !== '#')));

            // Mapped categories
            const selectedCategories = checkedCategories.map(mapToSimple);

            // Mapped top categories
            const selectedTops = topCategories.map(id => mapToSimple(tree.get_node(id)));

            // Merge categories and top categories
            selectedTops.forEach(st => {
                if (!selectedCategories.some(sc => sc.id === st.id))
                    selectedCategories.push(st);
            });
            $.ajax({
                type: "POST",
                url: '@Url.Action("ImportFromTrendyol")',
                //data: JSON.stringify([{ id: "1", text: "deneme", parent: '#' }]),
                data: JSON.stringify(selectedCategories),
                //data: selectedCategories,
                success: function (data, success) {
                    console.log(data, 'data')
                    console.log(success, 'success')
                    if (success !== 'success') {
                        $('#trendyol-fetch-error').toggle();
                        return;
                    }
                    alert("Veriler başarıyla eklendi.");
                },
                contentType: "application/json; charset=utf-8",
                error: function (error) {
                    console.log(error.responseText);
                },
                dataType: 'json'
            });
        }
        function processJsTree(data) {
            $('#trendyol-tree').jstree({
                "core": {
                    "themes": {
                        "variant": "large"
                    },
                    'data': data
                },
                "checkbox": {
                    "keep_selected_style": true
                },
                "plugins": ["wholerow", "checkbox"]
            });
        }
        const mapToSimple = category => ({ id: category.id, text: category.text, parent: category.parent })
    </script>
}