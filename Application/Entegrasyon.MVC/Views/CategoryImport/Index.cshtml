@{
    ViewData["Title"] = "Kategori İçe Aktarım";
    ViewData["PageTitle"] = "Kategori İçe Aktarım";
}
@section Styles{
    @*for tab*@
    <link href="~/css/tabs.css" rel="stylesheet" />
    @*for jstree*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.2.1/themes/default/style.min.css" />
}
<div class="container mt-3">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="simple-tab">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item " role="presentation">
                            <button class="nav-link active" id="trendyol-button" data-bs-toggle="tab" data-bs-target="#trendyol-tab" type="button" role="tab" aria-controls="trendyol-tab" aria-selected="true" tabindex="-1">Trendyol</button>
                        </li>
                        <li class="nav-item " role="presentation">
                            <button disabled class="nav-link" id="csv-button" data-bs-toggle="tab" data-bs-target="#csv-tab" type="button" role="tab" aria-controls="csv-tab" aria-selected="false" tabindex="-1">CSV</button>

                        </li>
                        <li class="nav-item " role="presentation">
                            <button disabled class="nav-link" id="excel-button" data-bs-toggle="tab" data-bs-target="#excel-tab" type="button" role="tab" aria-controls="excel-tab" aria-selected="false" tabindex="-1">Excel</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="trendyol-tab" role="tabpanel" aria-labelledby="trendyol-tab" tabindex="0">
                            <div class="mt-3">
                                <p>
                                    Trendyol kategorilerini getirip seçerek içe aktarmak için lütfen
                                    <a id="get-button" href="javascript:void(0)">tıklayın</a>
                                </p>
                                <div id="spinner" class="d-none mx-auto spinner-border text-primary" role="status">
                                    <span class="sr-only">Loading...</span>
                                </div>
                                <div id="trendyol-tree">
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="csv-tab" role="tabpanel" aria-labelledby="csv-tab" tabindex="0">
                            <p class="mt-3">csv</p>
                        </div>
                        <div class="tab-pane fade" id="excel-tab" role="tabpanel" aria-labelledby="excel-tab" tabindex="0">
                            <p class="mt-3">excel</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.2.1/jstree.min.js"></script>
    <script>
        let trendyolCategories = [];
        $(document).ready(function () {
            console.log("Hazır")
            $("#get-button").click(getTrendyolCategories);
        });
        function getTrendyolCategories() {
            if (trendyolCategories.length !== 0)
                return;
            $.get('@Url.Action("GetTrendyolCategories")', function (data, status) {
                console.log(data, status)
                //gelen veriyi jstree sitesindeki kullanıma göre maple
                //ardından seçili olarak al ve sisteme import et
                //seçili olan verileri tekrar seçildiğinde güncelleme işlemi yap.

            });
        }
        const data = [{
            id: "deneme1id", // will be autogenerated if omitted
            text: "deneme1", // node text
            state: {
                selected: false// is the node selected
            },
            children: [{
                id:"deneme2id",
                text:"deneme2"
            }, {
                id: "deneme3id",
                text: "deneme3"
            }, {
                id: "deneme4id",
                text: "deneme4"
            }]  // array of strings or objects
        }]
        function processJsTree() {

            $('#trendyol-tree').jstree({
                "core": {
                    "themes": {
                        "variant": "large"
                    },
                    'data':data
                },
                "checkbox": {
                    "keep_selected_style": true
                },
                "plugins": ["wholerow", "checkbox"]
            });
        }
    </script>
}