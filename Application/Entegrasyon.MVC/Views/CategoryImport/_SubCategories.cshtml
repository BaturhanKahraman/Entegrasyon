@model List<Entegrasyon.Entity.Dtos.Category.Import.TrendyolImport.ImportedTrendyolCategory>

@if(Model != null && Model.Any())
{
    @foreach(var category in Model)
    {
        <ul>
            <li id="@category.Id">
                @category.Name
                <partial name="_SubCategories" model="category.SubCategories"></partial>
            </li>
        </ul>
    }
}