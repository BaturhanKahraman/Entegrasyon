@model Entegrasyon.MVC.ViewModels.Category.CategoryAddViewModel

@{
    ViewData["Title"] = "Kategori Ekle";
    ViewData["PageTitle"] = "Kategori Ekle";
}

<h1>Kategori Oluştur</h1>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SuperCategoryId" class="control-label"></label>
                <input asp-for="SuperCategoryId" class="form-control" />
                <span asp-validation-for="SuperCategoryId" class="text-danger"></span>
            </div>
           
            <div class="form-group form-check">
                <label class="form-check-label">
                    <label asp-for="IsFavorite" class="control-label"></label>
                    <input class="form-check-input" asp-for="IsFavorite" />
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Oluştur" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    
    }

}
