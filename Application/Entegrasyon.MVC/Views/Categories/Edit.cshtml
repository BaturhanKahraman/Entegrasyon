@model Entegrasyon.MVC.ViewModels.Category.CategoryUpsertViewModel
@{
    ViewData["Title"] = "Müşteri Düzenle";
    ViewData["PageTitle"] = "Müşteri Düzenle";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden"/>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SuperCategoryId" class="control-label"></label>
                <select asp-for="SuperCategoryId" asp-items="Model.SuperCategories" class="form-select">
                    <option disabled selected>Eğer varsa bir üst kategori seçebilirsiniz.</option>
                </select>
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <label asp-for="IsFavorite" class="control-label"></label>
                    <input class="form-check-input" asp-for="IsFavorite" />
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Düzenle" class="btn btn-primary" />
                <input type="button" onclick="deleteItem(@Model.Id,this)" value="Sil" class="btn btn-danger" />
            </div>
        </form>
    </div>
</div>

<div class="mt-1">
    <a asp-action="Index">Listeye geri dön</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    <script>
                function deleteItem(itemId,button) {
                    if (confirm('Bu öğeyi silmek istediğinden emin misin?')) {
                        $(button).prop('disabled',true)
                        $.ajax({

                            url: '@Url.Action("Delete","Categories",Model.Id)', // Controller ve Action yolu
                            type: 'POST',
                            data: {
                                'id': itemId,
                                '__RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (result) {
                                // Silme işlemi başarılı olduysa kullanıcıya bilgi ver
                                if(result.message)
                                    alert(result.message);
                                window.location.href='@Url.Action("Index")'
                            },
                            error: function (xhr, status, error) {
                                // Hata durumunda kullanıcıya bilgi ver
                                alert('Bir hata oluştu: ' + error);
                            }
                        });
                        $(button).prop('disabled', false);
                    }
                }
    </script>
    }

}