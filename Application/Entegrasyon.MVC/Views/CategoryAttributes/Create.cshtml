@using Entegrasyon.MVC.Components.Razor.CategoryAttributeComponents;
@model Entegrasyon.MVC.ViewModels.Category.CategoryAttributeAddViewModel
@{
    ViewData["Title"] = "Kategori Özelliği Ekle";
    ViewData["PageTitle"] = "Kategori Özelliği Ekle";
}
@section Styles{
    <link href="~/vendor/@@yaireo/tagify/dist/tagify.css" rel="stylesheet" />
}
<div class="card layout-top-spacing">
    <div class="card-body">
        <h5 class="card-title">
            @if(!string.IsNullOrEmpty(ViewBag.CategoryName))
            {
                <span>@ViewBag.CategoryName için</span>
            }
            Özellik ekleme işlemi
        </h5>
        @(await Html.RenderComponentAsync<CategoryAttributeAdd>(RenderMode.Server,
            new { catId = ViewBag.CategoryId }))
    </div>
</div>
@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/vendor/@@yaireo/tagify/dist/tagify.min.js"></script>
    <script>
        function initializeTagify(inputId) {
            var input = document.querySelector(inputId);
            if (input) {
                new Tagify(input);
            }
        }
        function setDisable(inputId,status) {
            var tagify = new Tagify(document.querySelector(inputId));
            tagify.setDisabled(status);
        }
    </script>
}