@model Shared.Entity.Pageable<Entegrasyon.MVC.ViewModels.Products.ProductDetailListViewModel>

@{
    ViewData["Title"] = "Ürün Listesi";
    ViewData["PageTitle"] = "Ürün Listesi";
}
<div class="table-responsive">
    <table class="table table-bordered table-hover table-striped table-checkable table-highlight-head mb-4">
        <thead>
            <tr>
                <th data-field="id" data-sortable="true">ID</th>
                <th data-field="title" data-sortable="true">Başlık</th>
                <th data-field="stockCode" data-sortable="true">Stok Kodu</th>
                <th data-field="brandName" data-sortable="true">Marka</th>
                <th data-field="categoryName" data-sortable="true">Kategori</th>
                <th data-field="totalCurrentStock" data-sortable="true">Geçerli Stok</th>
                <th data-field="variantCount" data-sortable="true">Varyant/Çeşit Sayısı</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if(Model.Items==null || Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8">Ne yazık ki hiç ürünümüz yok :-( </td>
                </tr>
            }
            else
            {
                foreach(var itemDetail in Model.Items)
                {
                    <tr>
                        <td>@itemDetail.Id</td>
                        <td>@itemDetail.Title</td>
                        <td>@itemDetail.StockCode</td>
                        <td>@itemDetail.BrandName</td>
                        <td>@itemDetail.CategoryName</td>
                        <td>@itemDetail.TotalCurrentStock</td>
                        <td>@itemDetail.VariantCount</td>
                        <td class="text-center">
                            <ul class="table-controls">
                                <li>
                                    <a asp-action="Details" asp-route-id="@itemDetail.Id">
                                        <i class="flaticon-search  bg-success p-1 text-white br-6 mb-1"></i>
                                    </a>
                                </li>
                            </ul>
                        </td>
                    </tr>
                }
            }
         
        </tbody>
    </table>
    @if(Model.TotalPageCount > 1)
    {
        <nav>
            <ul class="pagination">
                @if(Model.CurrentPageIndex > 0)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { pageIndex = Model.CurrentPageIndex - 1, pageSize = Model.PagingItemCount })">Previous</a></li>
                }
                @for(int i = 0;i < Model.TotalPageCount;i++)
                {
                    <li class="@(i == Model.CurrentPageIndex ? "page-item active" : "page-item")"><a class="page-link" href="@Url.Action("Index", new { pageIndex = i, pageSize = Model.PagingItemCount })">@((i + 1).ToString())</a></li>
                }
                @if(Model.CurrentPageIndex < Model.TotalPageCount - 1)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { pageIndex = Model.CurrentPageIndex + 1, pageSize = Model.PagingItemCount })">Next</a></li>
                }
            </ul>
        </nav>
    }
</div>
