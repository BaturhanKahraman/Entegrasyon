@model Entegrasyon.MVC.ViewModels.Auth.CreatePasswordViewModel

@{
    ViewData["Title"] = "CreateNewPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
@section Styles{
    <link href="~/lib/template/css/assets/users/login-1.min.css" rel="stylesheet" />
}
<form class="form-login" asp-action="CreateNewPassword" method="post">
    <input asp-for="UserId" type="hidden" value="@Context.Request.Query["userId"]" />
    <div class="row">

        <div class="col-md-12">
            <h1 class="text-center">Şifre Güncelleme</h1>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control ">
            <span asp-validation-for="Password" class="text-danger d-block"></span>

            <label asp-for="ComparePassword" class="mt-4"></label>
            <input asp-for="ComparePassword" class="form-control ">
            <span asp-validation-for="ComparePassword" class="text-danger d-block"></span>

            <button class="btn btn-lg btn-gradient-danger btn-block btn-rounded mb-4 mt-5" type="submit">Şifreyi Güncelle</button>
        </div>
    </div>
</form>
@section Scripts
    {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}