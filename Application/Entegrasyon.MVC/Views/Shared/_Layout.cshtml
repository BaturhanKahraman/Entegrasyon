@using Entegrasyon.MVC.Utility.Helpers;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no">
    <base href="~/" />
    <title>@ViewData["Title"] </title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link href="~/css/site.css" rel="stylesheet" />
    <!-- ENABLE LOADERS -->
    <link href="~/lib/template/css/dark/loader.css" rel="stylesheet" />
    <link href="~/lib/template/css/light/loader.css" rel="stylesheet" />
    <script src="~/lib/template/js/loader.js"></script>
    <!-- DISABLE LOADERS -->
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,700" rel="stylesheet" type="text/css">
    <link href="~/vendor/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/template/css/dark/plugins.css" rel="stylesheet" />
    <link href="~/lib/template/css/light/plugins.css" rel="stylesheet" />
    <link href="~/css/modal.css" rel="stylesheet" />
    <!-- END GLOBAL MANDATORY STYLES -->
    <!-- BEGIN PAGE LEVEL PLUGINS/CUSTOM STYLES -->
    @await RenderSectionAsync("Styles", required: false)
    <!-- END PAGE LEVEL PLUGINS/CUSTOM STYLES -->
    <script src="~/vendor/feather-icons/dist/feather.min.js"></script>

    <style>
        body.dark .layout-px-spacing, .layout-px-spacing {
            min-height: calc(100vh - 155px) !important;
        }
    </style>


</head>
<body class="layout-boxed">
    <div id="load_screen">
        <div class="loader">
            <div class="loader-content">
                <div class="spinner-grow align-self-center"></div>
            </div>
        </div>
    </div>
    @{
        await Html.RenderPartialAsync("Partials/_Navbar");
    }
    <!--  BEGIN MAIN CONTAINER  -->
    <div class="main-container " id="container">

        <div class="overlay"></div>
        @{
            <vc:menu></vc:menu>
            // await Html.RenderPartialAsync("Partials/_Sidebar");
        }
        <!--  BEGIN CONTENT AREA  -->
        <div id="content" class="main-content">
            <div class="layout-px-spacing">
                @{
                    if (ViewData[StringConstant.Breadcrumb] is List<BreadcrumbModel> bcModel)
                        await Html.RenderPartialAsync("Partials/_Breadcrumb", bcModel);
                }
                @ViewData.RenderAlerts()
                @RenderBody()
            </div>
        </div>
        <!--  END CONTENT AREA  -->
    </div>
    <!--  BEGIN FOOTER  -->
    @{
        await Html.RenderPartialAsync("Partials/_Footer");
    }
    <!--  END FOOTER  -->
    <!-- END MAIN CONTAINER -->
    <!-- BEGIN GLOBAL MANDATORY SCRIPTS -->
    <script src="~/vendor/jquery/dist/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/perfect-scrollbar/dist/perfect-scrollbar.min.js"></script>
    <script src="~/lib/template/js/waves.min.js"></script>
    <script src="~/lib/template/js/custom.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
    <script src="~/lib/template/js/app.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- END GLOBAL MANDATORY SCRIPTS -->
    <!-- BEGIN PAGE LEVEL PLUGINS/CUSTOM SCRIPTS -->
    @(await RenderSectionAsync("Scripts", required: false))
    <!-- END PAGE LEVEL PLUGINS/CUSTOM SCRIPTS -->
</body>
</html>