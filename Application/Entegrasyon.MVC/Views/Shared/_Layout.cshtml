
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] </title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link href="~/css/site.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,700" rel="stylesheet" type="text/css">
    <link href="~/vendor/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/template/css/assets/plugins.css" rel="stylesheet" />
    <link href="~/lib/template/plugins/notification/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/template/plugins/loaders/csspin.css" rel="stylesheet" />
    
    @await RenderSectionAsync("Styles",required:false)

</head>
<body>

    <!-- Tab Mobile View Header -->
    <header class="tabMobileView header navbar fixed-top d-lg-none">
        <div class="nav-toggle">
            <a href="javascript:void(0);" class="nav-link sidebarCollapse" data-placement="bottom">
                <i class="flaticon-menu-line-2"></i>
            </a>
            <a href="index.html" class=""> <img src="~/img/logo-3.png" class="img-fluid" alt="logo"></a>
        </div>
        <ul class="nav navbar-nav">
            <li class="nav-item d-lg-none">
                <form class="form-inline justify-content-end" role="search">
                    <input type="text" class="form-control search-form-control mr-3">
                </form>
            </li>
        </ul>
    </header>
    <!-- Tab Mobile View Header -->
    <!--  BEGIN NAVBAR  -->
    @{
        await Html.RenderPartialAsync("Partials/_Navbar");
    }
    <!--  END NAVBAR  -->
    <!--  BEGIN MAIN CONTAINER  -->
    <div class="main-container" id="container">

        <div class="overlay"></div>
        <div class="cs-overlay"></div>

        <!--  BEGIN SIDEBAR  -->
        @{
            await Html.RenderPartialAsync("Partials/_Sidebar");
        }

        <!--  END SIDEBAR  -->
        <!--  BEGIN CONTENT PART  -->
        <div id="content" class="main-content">
            <div class="container">
                
                    <div class="page-header">
                        <div class="page-title">
                            <h3>@ViewData["PageTitle"]</h3>
                        </div>
                    </div>
                <!-- CONTENT AREA -->
                @RenderBody()


                <div id="modal-placeholder" style="display: none"></div>

                <!-- CONTENT AREA -->

            </div>
        </div>
        <!--  END CONTENT PART  -->
    </div>
    <!-- END MAIN CONTAINER -->
<!--  BEGIN FOOTER  -->
@{ await Html.RenderPartialAsync("Partials/_Footer");}

    <!--  END FOOTER  -->
<!--  BEGIN CONTROL SIDEBAR  -->
@{ await Html.RenderPartialAsync("Partials/_ControlSidebar");}

<!--  END CONTROL SIDEBAR  -->

<!-- BEGIN GLOBAL MANDATORY SCRIPTS -->
    <script src="~/vendor/jquery/dist/jquery.min.js"></script>
    <script src="~/vendor/popper.js/dist/umd/popper.min.js"></script>
    <script src="~/vendor/bootstrap/dist/js/bootstrap.min.js"></script>

    <script src="~/lib/template/plugins/scrollbar/jquery.mcustomscrollbar.concat.min.js"></script>
    <script src="~/lib/template/js/app.js"></script>

    <script>
        $(document).ready(function () {
            App.init();
        });
    </script>
<script src="~/lib/template/js/custom.js"></script>
<script src="~/lib/template/plugins/notification/toastr/toastr.min.js"></script>
    <!-- END GLOBAL MANDATORY SCRIPTS -->
    <!-- BEGIN PAGE LEVEL PLUGINS/CUSTOM SCRIPTS -->
    <script>var exports={}</script>
    @await RenderSectionAsync("Scripts",required:false)
    <script src="~/js/app.js"></script>
    <!-- BEGIN PAGE LEVEL PLUGINS/CUSTOM SCRIPTS -->
</body>
</html>