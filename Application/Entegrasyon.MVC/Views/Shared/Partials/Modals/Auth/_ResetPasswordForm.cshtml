@model Entegrasyon.MVC.ViewModels.Auth.ResetPasswordViewModel

<div class="modal fade" id="reset-password-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="mainModal"
     aria-hidden="true"
     style="display: none">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Model.UserName Şifre Sıfırlama</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form method="post" id="reset-password-form">
                <div class="modal-body">
                    <input asp-for="UserId" type="hidden"/>
                    <div class="row">

                        <div class="col-md-12">
                            <div id="modal-danger" class="text-danger"></div>
                            <input type="hidden" asp-for="UserId"/>
                            <label asp-for="TemporaryPassword"></label>
                            <input asp-for="TemporaryPassword" class="form-control ">
                            <span asp-validation-for="TemporaryPassword" class="text-danger d-block"></span>

                            <label asp-for="TemporaryPasswordCompare" class="mt-4"></label>
                            <input asp-for="TemporaryPasswordCompare" class="form-control ">
                            <span asp-validation-for="TemporaryPasswordCompare" class="text-danger d-block"></span>

                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">

                    <button type="button" class="btn btn-dark btn-rounded mb-1 mt-2" data-dismiss="modal">Çıkış</button>
                    <button type="submit" id="submit" class="btn btn-primary btn-rounded mb-1 mt-2">Onayla</button>
                </div>
            </form>
            <div class="modal-body" id="modal-success" style="display: none">
                <div class="d-flex justify-content-center align-items-center">
                    <i class="flaticon-check mt-5" style="font-size: 90px;color: #00d1c1;"></i>
                    <h4 class="modal-title mt-4 mb-4" id="modal-success-title" style="font-size: 22px; color: #e95f2b;">
                        Başarılı!
                    </h4>
                    <p class="mb-4" id="modal-success-text"></p>
                    <button type="button" class="btn btn-gradient-success btn-rounded mt-3 mb-4" data-dismiss="modal">Devam Et</button>
                </div>
            </div>
            <div class="modal-body" id="modal-loading" style="display: none">
                <div class="d-flex justify-content-center align-items-center my-4">
                    <div class="cp-spinner cp-balls"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
<script defer src="~/js/auth/reset-password-modal.js"></script>
<script>
    resetValidators();
    function resetValidators() {
        var form = $("#reset-password-form")
            .removeData("validator") /* added by the raw jquery.validate plugin */
            .removeData("unobtrusiveValidation");  /* added by the jquery unobtrusive plugin*/

        $.validator.unobtrusive.parse($("#reset-password-form"));
    }
</script>
