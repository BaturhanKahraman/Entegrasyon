@{
    Layout = "~/Shared/Views/_AuthLayout.cshtml";
    ViewData["ErrorCode"] = 429;
    ViewData["ErrorIcon"] = "ti-hourglass-high";
    ViewData["ErrorColor"] = "yellow";
    ViewData["ErrorTitle"] = "Biraz hızlı gidiyoruz";
    ViewData["ErrorMessage"] = "Kısa sürede çok fazla istek gönderildi. Sistemi rahat tutmak için bir an duraklatıyoruz.";
    ViewData["ErrorHint"] = "Lütfen birkaç saniye bekleyip tekrar deneyin.";
    ViewData["ShowRetry"] = true;
}

@await Html.PartialAsync("_ErrorContent")
