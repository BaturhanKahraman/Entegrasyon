@{
    Layout = "~/Shared/Views/_AuthLayout.cshtml";
    ViewData["ErrorCode"] = 500;
    ViewData["ErrorIcon"] = "ti-server-bolt";
    ViewData["ErrorColor"] = "red";
    ViewData["ErrorTitle"] = "Bizden kaynaklı bir hata oluştu";
    ViewData["ErrorMessage"] = "Beklenmeyen bir sorun yaşandı ve isteğinizi tamamlayamadık. Bu bizim hatamız, özür dileriz.";
    ViewData["ErrorHint"] = "Ekibimiz durumdan haberdar oldu. Lütfen biraz sonra tekrar deneyin.";
    ViewData["ShowRetry"] = true;
    // TraceId controller/exception handler tarafından doldurulur; teknik detay/stack trace ASLA gösterilmez.
}

@await Html.PartialAsync("_ErrorContent")
