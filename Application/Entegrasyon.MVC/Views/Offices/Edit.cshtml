@model Entegrasyon.MVC.ViewModels.Office.OfficeEditViewModel


@{
    ViewData["Title"] = "Ofis/Depo Düzenle";
    ViewData["PageTitle"] = "Ofis/Depo Düzenle";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden" class="form-control" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="button" value="Sil" class="btn btn-danger" onclick="deleteItem()" />
                <input type="submit" value="Düzenle" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function deleteItem() {
            if (!confirm("Gerçekten silmek istediğinize emin misiniz ?")) {
                return;
            }
            $.post('@Url.Action("Delete")',
                { id: @Model.Id },
                function (res) {
                    if (res.success === true) {
                        window.location.href = "@Url.Action("Index")";
                    } else {
                        alert(res.message);
                    }
                });
        }
    </script>
}
