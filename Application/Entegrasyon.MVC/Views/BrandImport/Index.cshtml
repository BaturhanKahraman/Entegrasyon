@{
    ViewData["Title"] = "Marka İçe Aktarım";
    ViewData["PageTitle"] = "Marka İçe Aktarım";
}
@section Styles{
    @*for tab*@
    <link href="~/css/tabs.css" rel="stylesheet" />
}
<div class="container mt-3">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="simple-tab">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item " role="presentation">
                            <button class="nav-link active" id="trendyol-button" data-bs-toggle="tab" data-bs-target="#trendyol-tab" type="button" role="tab" aria-controls="trendyol-tab" aria-selected="true" tabindex="-1">Trendyol</button>
                        </li>
                        <li class="nav-item " role="presentation">
                            <button disabled class="nav-link" id="csv-button" data-bs-toggle="tab" data-bs-target="#csv-tab" type="button" role="tab" aria-controls="csv-tab" aria-selected="false" tabindex="-1">CSV</button>

                        </li>
                        <li class="nav-item " role="presentation">
                            <button disabled class="nav-link" id="excel-button" data-bs-toggle="tab" data-bs-target="#excel-tab" type="button" role="tab" aria-controls="excel-tab" aria-selected="false" tabindex="-1">Excel</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="trendyol-tab" role="tabpanel" aria-labelledby="trendyol-tab" tabindex="0">
                            <div class="mt-3">
                                <p>
                                    Trendyol kategorilerini getirip seçerek içe aktarmak için lütfen
                                    <a id="get-button" href="javascript:void(0)">tıklayın</a>
                                    İşleminiz sıraya alınacaktır. Onayladıktan sonra işleminize devam edebilirsiniz.
                                    <div id="trenyol-fetch-error" style="display:none;" class="alert alert-danger" role="alert">
                                        Verileri trendyoldan çekmeye çalışırken hata meydana geldi.
                                    </div>
                                </p>
                                <div id="trendyol-spinner" style="display:none;" class="mx-auto spinner-border text-primary" role="status">
                                    <span class="sr-only"></span>
                                </div>
                                <div id="trendyol-tree">
                                </div>
                                <div id="trendyol-buttons" style="display:none;">
                                    <button id="send-button" class="btn btn-success">Seçilenleri içeri aktar</button>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="csv-tab" role="tabpanel" aria-labelledby="csv-tab" tabindex="0">
                            <p class="mt-3">csv</p>
                        </div>
                        <div class="tab-pane fade" id="excel-tab" role="tabpanel" aria-labelledby="excel-tab" tabindex="0">
                            <p class="mt-3">excel</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            $("#get-button").click(getTrendyolBrands);
        });
        function getTrendyolBrands() {
            let approve = confirm("Tüm kategorileri içe aktarmak istediğinize emin misiniz ?");
            if (!approve)
                return;
            $.get('@Url.Action("GetTrendyolBrands")', function (data,status) {
                    alert(data.message);
            })
        }
    </script>
}