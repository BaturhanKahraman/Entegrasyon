@model Entegrasyon.MVC.ViewModels.Customer.CustomerEditViewModel

@{
    ViewData["Title"] = "Müşteri Düzenle";
    ViewData["PageTitle"] = "Müşteri Düzenle";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden" />
            <div class="form-group">
                <select asp-for="CustomerType" class="form-control" onchange="toggleFields()" id="CustomerType">
                    <option>Lütfen Müşteri Tipi seçin</option>
                    <option value="Retail">Bireysel</option>
                    <option value="Corporate">Kurumsal</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Surname" class="control-label"></label>
                <input asp-for="Surname" class="form-control" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NationalIdentity" class="control-label"></label>
                <input asp-for="NationalIdentity" id="NationalIdentity" class="form-control" />
                <span asp-validation-for="NationalIdentity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaxNumber" class="control-label"></label>
                <input asp-for="TaxNumber" id="TaxNumber" disabled class="form-control" />
                <span asp-validation-for="TaxNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CorporateName" class="control-label" onclick="deleteItem()"></label>
                <input asp-for="CorporateName" class="form-control" disabled id="CorporateName" />
                <span asp-validation-for="CorporateName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="button" value="Sil" class="btn btn-danger" />
                <input type="submit" value="Kaydet" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function toggleFields() {
            var customerType = document.getElementById("CustomerType").value;
            var corporateName = document.getElementById("CorporateName");
            var taxNumber = document.getElementById("TaxNumber");
            var nationalIdentity = document.getElementById("NationalIdentity");

            if (customerType === "Retail") {
                corporateName.disabled = true;
                taxNumber.disabled = true;
            } else if (customerType === "Corporate") {
                corporateName.disabled = false;
                taxNumber.disabled = false;
            }
        }
        function deleteItem() {
            if (!confirm("Gerçekten silmek istediğinize emin misiniz ?")) {
                return;
            }
            $.post('@Url.Action("Delete")',
                { id: @Model.Id },
                function (res) {
                    if (res.success === true) {
                        window.location.href = "@Url.Action("Index")";
                    } else {
                        alert(res.message);
                    }
                });
        }
    </script>

}
