@model Entegrasyon.MVC.Shared.ViewModels.PaginationVm

@{
    string BuildUrl(int page)
    {
        var parts = new List<string> { $"page={page}" };
        foreach (var kv in Model.QueryParams)
        {
            if (!string.IsNullOrEmpty(kv.Value))
                parts.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}");
        }
        var query = string.Join("&", parts);
        return Model.BaseUrl.Contains('?')
            ? $"{Model.BaseUrl}&{query}"
            : $"{Model.BaseUrl}?{query}";
    }

    var startPage = Math.Max(1, Model.CurrentPage - 2);
    var endPage = Math.Min(Model.TotalPages, startPage + 4);
    if (endPage - startPage < 4)
        startPage = Math.Max(1, endPage - 4);
}

@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4">
        <span class="text-secondary">Toplam @Model.TotalCount kayit</span>
        <ul class="pagination m-0">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   hx-get="@BuildUrl(Model.CurrentPage - 1)"
                   hx-target="@Model.TargetId"
                   hx-swap="outerHTML"
                   tabindex="-1">
                    Önceki
                </a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       hx-get="@BuildUrl(1)"
                       hx-target="@Model.TargetId"
                       hx-swap="outerHTML">
                        1
                    </a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
            }

            @for (var i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       hx-get="@BuildUrl(i)"
                       hx-target="@Model.TargetId"
                       hx-swap="outerHTML">
                        @i
                    </a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }
                <li class="page-item">
                    <a class="page-link"
                       hx-get="@BuildUrl(Model.TotalPages)"
                       hx-target="@Model.TargetId"
                       hx-swap="outerHTML">
                        @Model.TotalPages
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   hx-get="@BuildUrl(Model.CurrentPage + 1)"
                   hx-target="@Model.TargetId"
                   hx-swap="outerHTML">
                    Sonraki
                </a>
            </li>
        </ul>
    </div>
}
