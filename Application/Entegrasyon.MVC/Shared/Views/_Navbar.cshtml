<header class="navbar navbar-expand-md d-print-none">
    <div class="container-xl">
        @* ── Sol: Global Arama (Command Palette tetikleyici) ── *@
        <div class="d-none d-md-flex">
            <a href="#" class="input-icon" data-bs-toggle="modal" data-bs-target="#command-palette" style="text-decoration:none;">
                <span class="input-icon-addon">
                    <i class="ti ti-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Ara...  Ctrl+K" aria-label="Global Arama"
                       style="min-width: 280px; pointer-events: none;" readonly tabindex="-1" />
            </a>
        </div>

        @* ── Sag: Utility Items ── *@
        <div class="navbar-nav flex-row ms-auto">
            @* ── Hizli Islemler ── *@
            <div class="nav-item dropdown d-none d-md-flex me-2">
                <a href="#" class="nav-link px-0" data-bs-toggle="dropdown" tabindex="-1" aria-label="Hizli Islemler" title="Hizli Islemler">
                    <i class="ti ti-bolt fs-2"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <span class="dropdown-header">Hizli Islemler</span>
                    <a href="/products/create" class="dropdown-item">
                        <i class="ti ti-package me-2"></i>Ürün Ekle
                    </a>
                    <a href="/pos" class="dropdown-item">
                        <i class="ti ti-device-desktop me-2"></i>Satış Yap
                    </a>
                    <a href="/sales" class="dropdown-item">
                        <i class="ti ti-receipt me-2"></i>Satışlar
                    </a>
                </div>
            </div>

            @* ── Tema Toggle ── *@
            <div class="nav-item me-2">
                <button id="theme-toggle" class="nav-link px-0 btn btn-link" type="button" title="Tema Degistir" aria-label="Tema Degistir">
                    <i id="theme-icon" class="ti ti-sun fs-2"></i>
                </button>
            </div>

            @* ── Bildirimler ── *@
            <div class="nav-item me-2">
                @await Component.InvokeAsync("NotificationBell")
            </div>

            @* ── Kullanici Dropdown ── *@
            <div class="nav-item dropdown">
                <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Kullanici Menusu">
                    <span class="avatar avatar-sm">
                        <i class="ti ti-user"></i>
                    </span>
                    <div class="d-none d-xl-block ps-2">
                        <div>@(User.Identity?.Name ?? "Kullanici")</div>
                    </div>
                </a>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <a href="/profile" class="dropdown-item">
                        <i class="ti ti-user me-2"></i>Profil
                    </a>
                    <div class="dropdown-divider"></div>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="ti ti-logout me-2"></i>Cikis Yap
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>
