{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "NotificationsV2": {
      "PublishEnabled": false,
      "SseEnabled": false,
      "WebPushEnabled": false
    }
  },
  "Notifications": {
    "Outbox": {
      "SafetyPollingInterval": "00:00:05",
      "BatchSize": 50,
      "MaxRetryCount": 5,
      "MaxConcurrency": 10
    }
  },
  "BackgroundServices": {
    "TrendyolCategoryImport": 10
  },
  "Barcode": {
    "ClearDelay": 10
  },
  "Tenant": {
    "DefaultSubdomain": "dev"
  },
  "BatchToken": {
    "SigningKey": "dev-only-batch-token-signing-key-replace-in-prod-min-32chars"
  },
  "WebPush": {
    "Admin": {
      "VapidSubject": "mailto:admin@entegrasyon.tr",
      "VapidPublicKey": "",
      "VapidPrivateKey": ""
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information"
  }
}
