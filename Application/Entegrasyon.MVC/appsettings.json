{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Amazon": {
    "UseMock": true,
    "DefaultMarketPlaceId": 5,
    "MarketplaceIds": ["A33AVAJ2PDY3EV"]
  },
  "BackgroundServices": {
    "TrendyolCategoryImport": 10
  },
  "Barcode": {
    "ClearDelay": 10
  },
  "Tenant": {
    "DefaultSubdomain": "dev"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information"
  }
}
