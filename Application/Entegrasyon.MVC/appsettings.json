{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Notifications": {
    "Outbox": {
      "SafetyPollingInterval": "00:00:05",
      "BatchSize": 50,
      "MaxRetryCount": 5,
      "MaxConcurrency": 10
    }
  },
  "BackgroundServices": {
    "TrendyolCategoryImport": 10
  },
  "Barcode": {
    "ClearDelay": 10
  },
  "Tenant": {
    "DefaultSubdomain": "dev"
  },
  "BatchToken": {
    "SigningKey": "dev-only-batch-token-signing-key-replace-in-prod-min-32chars"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information"
  }
}
