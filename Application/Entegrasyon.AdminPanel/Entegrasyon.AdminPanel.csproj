<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>adminpanel</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Entegrasyon.DataAccess\Entegrasyon.DataAccess.csproj" />
    <ProjectReference Include="..\Entegrasyon.Entity\Entegrasyon.Entity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Entegrasyon.AdminPanel.Test" />
  </ItemGroup>

  <!-- AdminPanel, MVC tarafindan kutuphane olarak referans aliniyor. MVC publish edilirken
       AdminPanel'in appsettings'leri ayni relative path'te cakisiyor (NETSDK1152).
       AdminPanel kendi calismasinda `dotnet run` (publish degil) kullaniyor + hicbir yerde
       publish/deploy edilmiyor → publish ciktisina kopyalamamak guvenli, MVC'nin kendi
       appsettings'i korunur. -->
  <ItemGroup>
    <Content Update="appsettings.json;appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
