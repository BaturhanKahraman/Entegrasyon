@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Entegrasyon Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Entegrasyon.AdminPanel.styles.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 250px;
        }

        body {
            min-height: 100vh;
        }

        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background-color: #1a1d21;
            color: #c9d1d9;
            z-index: 1040;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease;
        }

        .admin-sidebar .brand {
            padding: 1.25rem 1.5rem;
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .admin-sidebar .nav-section {
            flex: 1;
            overflow-y: auto;
            padding: 0.75rem 0;
        }

        .admin-sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 1.5rem;
            color: #8b949e;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.15s ease;
            border-left: 3px solid transparent;
        }

        .admin-sidebar .nav-link:hover {
            color: #e6edf3;
            background-color: rgba(255,255,255,0.05);
        }

        .admin-sidebar .nav-link.active {
            color: #fff;
            background-color: rgba(255,255,255,0.08);
            border-left-color: #3b82f6;
        }

        .admin-sidebar .nav-link i {
            font-size: 1.1rem;
            width: 1.25rem;
            text-align: center;
        }

        .admin-sidebar .sidebar-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid rgba(255,255,255,0.1);
            font-size: 0.85rem;
        }

        .admin-sidebar .sidebar-footer .user-name {
            color: #e6edf3;
            font-weight: 500;
        }

        .admin-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            background-color: #f6f8fa;
        }

        .admin-topbar {
            background-color: #fff;
            border-bottom: 1px solid #d0d7de;
            padding: 0.85rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .admin-topbar h1 {
            font-size: 1.25rem;
            font-weight: 600;
            margin: 0;
            color: #1f2328;
        }

        .admin-content {
            padding: 1.5rem;
        }

        .sidebar-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.4rem;
            color: #1f2328;
            cursor: pointer;
            padding: 0;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            z-index: 1035;
        }

        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-sidebar.show {
                transform: translateX(0);
            }

            .admin-main {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: block;
            }

            .sidebar-overlay.show {
                display: block;
            }
        }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <aside class="admin-sidebar" id="adminSidebar">
            <div class="brand">
                <i class="bi bi-gear-wide-connected"></i>
                Entegrasyon Admin
            </div>
            <nav class="nav-section">
                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-house"></i> Dashboard
                </a>
                <a class="nav-link @(currentController == "Tenants" ? "active" : "")"
                   asp-controller="Tenants" asp-action="Index">
                    <i class="bi bi-building"></i> Firmalar
                </a>
                <a class="nav-link @(currentController == "Licenses" ? "active" : "")"
                   asp-controller="Licenses" asp-action="Index">
                    <i class="bi bi-key"></i> Lisanslar
                </a>
                <a class="nav-link @(currentController == "Logs" ? "active" : "")"
                   asp-controller="Logs" asp-action="Index">
                    <i class="bi bi-journal-text"></i> Uygulama Logları
                </a>
                <a class="nav-link @(currentController == "AiCredits" ? "active" : "")"
                   asp-controller="AiCredits" asp-action="Index">
                    <i class="bi bi-robot"></i> AI Kredileri
                </a>

                <div class="px-3 mt-3 mb-1">
                    <small class="text-uppercase fw-bold" style="font-size:0.7rem; color:#6e7681;">Katalog</small>
                </div>
                <a class="nav-link @(currentController == "MasterCatalog" && (currentAction == "Categories" || currentAction == "CategoryDetails") ? "active" : "")"
                   asp-controller="MasterCatalog" asp-action="Categories">
                    <i class="bi bi-diagram-3"></i> Kategoriler
                </a>
                <a class="nav-link @(currentController == "MasterCatalog" && currentAction == "Brands" ? "active" : "")"
                   asp-controller="MasterCatalog" asp-action="Brands">
                    <i class="bi bi-tags"></i> Markalar
                </a>
                <a class="nav-link @(currentController == "MasterCatalog" && (currentAction == "Attributes" || currentAction == "AttributeDetails") ? "active" : "")"
                   asp-controller="MasterCatalog" asp-action="Attributes">
                    <i class="bi bi-list-check"></i> Özellikler
                </a>
            </nav>
            <div class="sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <i class="bi bi-person-circle me-1"></i>
                        <span class="user-name">@displayName</span>
                    </div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light" title="Çıkış Yap">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="admin-main">
            <div class="admin-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="sidebar-toggle" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>
                    <h1>@ViewData["Title"]</h1>
                </div>
            </div>
            <div class="admin-content">
                @if (TempData["Success"] is string successMsg)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-1"></i> @successMsg
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] is string errorMsg)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @errorMsg
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar')?.classList.toggle('show');
            document.getElementById('sidebarOverlay')?.classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
