@model List<PackageListViewModel>
@{
    ViewData["Title"] = "Hazır Şablonlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Hazır Şablonlar (MatchedEntity)</h2>
    <a asp-controller="MatchedEntities" asp-action="Create" class="btn btn-primary">
        + Yeni Paket Oluştur
    </a>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@ViewData["Search"]"
                       class="form-control" placeholder="Paket adı ara..." />
            </div>
            <div class="col-auto">
                <select name="type" class="form-select">
                    <option value="">Tüm Türler</option>
                    <option value="@((int)MatchedEntityType.Category)"
                            selected="@(ViewData["TypeFilter"] is MatchedEntityType t && t == MatchedEntityType.Category)">Kategori</option>
                    <option value="@((int)MatchedEntityType.Brand)"
                            selected="@(ViewData["TypeFilter"] is MatchedEntityType t2 && t2 == MatchedEntityType.Brand)">Marka</option>
                    <option value="@((int)MatchedEntityType.CargoCompany)"
                            selected="@(ViewData["TypeFilter"] is MatchedEntityType t3 && t3 == MatchedEntityType.CargoCompany)">Kargo Şirketi</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
            </div>
            @if (ViewData["Search"] is not null || ViewData["TypeFilter"] is not null)
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-danger">Temizle</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Paket Adı</th>
                        <th>Tür</th>
                        <th class="text-center">Entity Sayısı</th>
                        <th class="text-center">Versiyon</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Kayıtlı şablon paketi bulunamadı.
                            </td>
                        </tr>
                    }
                    @foreach (var pkg in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@pkg.Id" class="text-decoration-none fw-semibold">
                                    @pkg.Name
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-info">@pkg.EntityTypeDisplay</span>
                            </td>
                            <td class="text-center">@pkg.EntityCount</td>
                            <td class="text-center">v@(pkg.Version)</td>
                            <td>
                                @if (pkg.IsPublished)
                                {
                                    <span class="badge bg-success">Yayında</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Taslak</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@pkg.Id"
                                       class="btn btn-outline-info">Detay</a>
                                    <a asp-action="Edit" asp-route-id="@pkg.Id"
                                       class="btn btn-outline-primary">Düzenle</a>
                                    <form asp-action="TogglePublish" asp-route-id="@pkg.Id"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn @(pkg.IsPublished ? "btn-outline-warning" : "btn-outline-success")">
                                            @(pkg.IsPublished ? "Yayından Kaldır" : "Yayınla")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
