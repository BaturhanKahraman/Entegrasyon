@model PackageFormViewModel
@{
    ViewData["Title"] = "Şablon Paketi Düzenle";
}

<h2>Şablon Paketi Düzenle</h2>

<div class="card mt-3">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EntityType" class="form-label"></label>
                <select asp-for="EntityType" class="form-select">
                    <option value="@((int)MatchedEntityType.Category)">Kategori</option>
                    <option value="@((int)MatchedEntityType.Brand)">Marka</option>
                    <option value="@((int)MatchedEntityType.CargoCompany)">Kargo Şirketi</option>
                </select>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label">Yayında</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
