@model TemplateCategoryViewModel

<div class="border rounded p-2 mb-2 ms-@(ViewData["Depth"] is int d ? d * 3 : 0)">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <strong>@Model.Name</strong>
            @if (Model.DefaultVatRate.HasValue)
            {
                <small class="text-muted ms-2">KDV: %@Model.DefaultVatRate</small>
            }
        </div>
        <div>
            @if (Model.AttributeCount > 0)
            {
                <span class="badge bg-info me-1">@Model.AttributeCount özellik</span>
            }
            @if (Model.MarketplaceCount > 0)
            {
                <span class="badge bg-primary">@Model.MarketplaceCount MP</span>
            }
        </div>
    </div>
</div>

@{
    var nextDepth = (ViewData["Depth"] is int currentDepth ? currentDepth : 0) + 1;
}
@foreach (var child in Model.Children)
{
    @await Html.PartialAsync("~/Features/MatchedEntities/Views/_CategoryNode.cshtml", child, new ViewDataDictionary(ViewData) { { "Depth", nextDepth } })
}
