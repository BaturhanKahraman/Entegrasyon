@model List<TenantListViewModel>
@{
    ViewData["Title"] = "Firmalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Firmalar</h2>
    <a asp-controller="Tenants" asp-action="Create" class="btn btn-primary">
        + Yeni Firma Ekle
    </a>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@ViewData["Search"]"
                       class="form-control" placeholder="Firma adı veya subdomain ara..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">Ara</button>
            </div>
            @if (ViewData["Search"] is not null)
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-danger">Temizle</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Firma Adı</th>
                        <th>Subdomain</th>
                        <th>Veritabanı Tipi</th>
                        <th>Durum</th>
                        <th class="text-center">Kullanıcı Sayısı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Kayıtlı firma bulunamadı.
                            </td>
                        </tr>
                    }
                    @foreach (var tenant in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@tenant.Id" class="text-decoration-none fw-semibold">
                                    @tenant.CompanyName
                                </a>
                            </td>
                            <td><code>@tenant.Subdomain</code></td>
                            <td>@tenant.DatabaseType</td>
                            <td>
                                @if (tenant.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-center">@tenant.UserCount</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@tenant.Id"
                                       class="btn btn-outline-info" title="Detay">
                                        Detay
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@tenant.Id"
                                       class="btn btn-outline-primary" title="Düzenle">
                                        Düzenle
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@tenant.Id"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn @(tenant.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(tenant.IsActive ? "Pasife Al" : "Aktife Al")">
                                            @(tenant.IsActive ? "Pasife Al" : "Aktife Al")
                                        </button>
                                    </form>
                                    @if (!tenant.IsActive)
                                    {
                                        <form asp-action="Delete" asp-route-id="@tenant.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Bu firmayı silmek istediğinize emin misiniz?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Sil">
                                                Sil
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
