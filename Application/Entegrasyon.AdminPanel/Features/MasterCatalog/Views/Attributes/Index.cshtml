@model AttributesIndexVm
@{
    ViewData["Title"] = "Ozellikler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Ozellikler</h2>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="mb-0">@Model.TotalCount</h4>
                <small class="text-muted">Toplam Ozellik</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="mb-0">@Model.Attributes.Sum(a => a.ValueCount)</h4>
                <small class="text-muted">Toplam Deger</small>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" asp-action="Attributes" class="row g-2 mb-3">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@Model.Search"
                       class="form-control" placeholder="Ozellik adi ara..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">Ara</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <div class="col-auto">
                    <a asp-action="Attributes" class="btn btn-outline-danger">Temizle</a>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ozellik Adi</th>
                        <th class="text-center">Ozel Deger</th>
                        <th class="text-center">Deger Sayisi</th>
                        <th class="text-center">Bagli Kategori</th>
                        <th class="text-end">Islemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Attributes.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Ozellik bulunamadi.
                            </td>
                        </tr>
                    }
                    @foreach (var attr in Model.Attributes)
                    {
                        <tr>
                            <td>
                                <strong>@attr.HumanizedName</strong>
                                @if (attr.Key != attr.HumanizedName)
                                {
                                    <br><small class="text-muted">@attr.Key</small>
                                }
                                @if (!attr.IsActive)
                                {
                                    <span class="badge bg-secondary ms-1">Pasif</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (attr.AllowCustom)
                                {
                                    <span class="badge bg-success">Evet</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@attr.ValueCount</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info">@attr.CategoryCount</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="AttributeDetails" asp-route-id="@attr.Id"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i> Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Attributes"
                           asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">
                            &laquo;
                        </a>
                    </li>
                    @{
                        int start = Math.Max(1, Model.Page - 2);
                        int end = Math.Min(Model.TotalPages, Model.Page + 2);
                    }
                    @for (int i = start; i <= end; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Attributes"
                               asp-route-search="@Model.Search" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Attributes"
                           asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">
                            &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="text-center text-muted small mt-1">
                @Model.TotalCount ozellik, sayfa @Model.Page / @Model.TotalPages
            </div>
        }
    </div>
</div>
