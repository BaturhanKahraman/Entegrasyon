@model List<Entegrasyon.AdminPanel.Features.Licenses.LicenseListItemViewModel>
@using Entegrasyon.AdminPanel.Infrastructure.Data
@{
    string GetTypeBadgeClass(LicenseType type) => type switch
    {
        LicenseType.Trial => "bg-secondary",
        LicenseType.Standard => "bg-primary",
        LicenseType.Premium => "bg-info text-dark",
        LicenseType.Enterprise => "bg-dark",
        _ => "bg-secondary"
    };

    string GetStatusBadgeClass(Entegrasyon.AdminPanel.Features.Licenses.LicenseListItemViewModel license)
    {
        if (license.Status == "Süresi Dolmuş") return "bg-danger";
        if (license.Status == "Yaklaşan") return "bg-warning text-dark";
        if (license.IsExpiringSoon) return "bg-warning text-dark";
        return "bg-success";
    }

    string GetStatusText(Entegrasyon.AdminPanel.Features.Licenses.LicenseListItemViewModel license)
    {
        if (license.Status == "Aktif" && license.IsExpiringSoon)
        {
            var days = (int)(license.EndDate - DateTime.UtcNow).TotalDays;
            return $"Aktif ({days} gün kaldı)";
        }
        return license.Status;
    }
}

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Firma</th>
                <th>Lisans Tipi</th>
                <th>Başlangıç</th>
                <th>Bitiş</th>
                <th>Durum</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var license in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Tenants" asp-action="Details" asp-route-id="@license.TenantId"
                           class="text-decoration-none fw-medium">
                            @license.CompanyName
                        </a>
                    </td>
                    <td>
                        <span class="badge @GetTypeBadgeClass(license.Type)">@license.Type</span>
                    </td>
                    <td>@license.StartDate.ToString("dd.MM.yyyy")</td>
                    <td>@license.EndDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        <span class="badge @GetStatusBadgeClass(license)">@GetStatusText(license)</span>
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@license.Id"
                               class="btn btn-outline-primary" title="Düzenle">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger"
                                    title="Sil"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal-@license.Id">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                        <!-- Delete Confirmation Modal -->
                        <div class="modal fade" id="deleteModal-@license.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Lisans Silme Onayı</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <strong>@license.CompanyName</strong> firmasının
                                        <strong>@license.Type</strong> lisansını silmek istediğinize emin misiniz?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                        <form asp-action="Delete" asp-route-id="@license.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">Sil</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
