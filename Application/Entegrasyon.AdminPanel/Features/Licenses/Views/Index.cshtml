@model Entegrasyon.AdminPanel.Features.Licenses.LicenseListViewModel
@{
    ViewData["Title"] = "Lisanslar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="text-muted">
            Toplam @(Model.ActiveLicenses.Count + Model.ExpiredLicenses.Count + Model.UpcomingLicenses.Count) lisans
        </span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Yeni Lisans
    </a>
</div>

@if (Model.ActiveLicenses.Count == 0 && Model.ExpiredLicenses.Count == 0 && Model.UpcomingLicenses.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-key display-4 d-block mb-3"></i>
            <p class="mb-2">Henüz lisans kaydı bulunmuyor.</p>
            <a asp-action="Create" class="btn btn-sm btn-outline-primary">Lisans Ekle</a>
        </div>
    </div>
}

@if (Model.ActiveLicenses.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header bg-white d-flex align-items-center gap-2">
            <i class="bi bi-check-circle text-success"></i>
            <strong>Aktif Lisanslar</strong>
            <span class="badge bg-success">@Model.ActiveLicenses.Count</span>
        </div>
        <div class="card-body p-0">
            @await Html.PartialAsync("~/Features/Licenses/Views/_LicenseTable.cshtml", Model.ActiveLicenses)
        </div>
    </div>
}

@if (Model.UpcomingLicenses.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header bg-white d-flex align-items-center gap-2">
            <i class="bi bi-clock text-warning"></i>
            <strong>Yaklaşan Lisanslar</strong>
            <span class="badge bg-warning text-dark">@Model.UpcomingLicenses.Count</span>
        </div>
        <div class="card-body p-0">
            @await Html.PartialAsync("~/Features/Licenses/Views/_LicenseTable.cshtml", Model.UpcomingLicenses)
        </div>
    </div>
}

@if (Model.ExpiredLicenses.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header bg-white d-flex align-items-center gap-2">
            <i class="bi bi-x-circle text-danger"></i>
            <strong>Süresi Dolmuş Lisanslar</strong>
            <span class="badge bg-danger">@Model.ExpiredLicenses.Count</span>
        </div>
        <div class="card-body p-0">
            @await Html.PartialAsync("~/Features/Licenses/Views/_LicenseTable.cshtml", Model.ExpiredLicenses)
        </div>
    </div>
}
