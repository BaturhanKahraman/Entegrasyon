@model Entegrasyon.AdminPanel.Features.Logs.LogListViewModel
@{
    ViewData["Title"] = "Uygulama Loglari";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Uygulama Loglari</h2>
    <span class="badge bg-secondary fs-6">Toplam: @Model.TotalCount</span>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-controller="Logs" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Firma</label>
                <select name="tenantId" class="form-select">
                    <option value="">Tum Firmalar</option>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <option value="@tenant.Id" selected="@(Model.Filter.TenantId == tenant.Id)">@tenant.CompanyName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Seviye</label>
                <select name="level" class="form-select">
                    <option value="">Tumu</option>
                    <option value="Information" selected="@(Model.Filter.Level == "Information")">Information</option>
                    <option value="Warning" selected="@(Model.Filter.Level == "Warning")">Warning</option>
                    <option value="Error" selected="@(Model.Filter.Level == "Error")">Error</option>
                    <option value="Critical" selected="@(Model.Filter.Level == "Critical")">Critical</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Baslangic</label>
                <input type="datetime-local" name="from" class="form-control" value="@(Model.Filter.From?.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Bitis</label>
                <input type="datetime-local" name="to" class="form-control" value="@(Model.Filter.To?.ToString("yyyy-MM-ddTHH:mm"))" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary me-2">Filtrele</button>
                <a asp-controller="Logs" asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>Firma</th>
                        <th>Seviye</th>
                        <th>Kaynak</th>
                        <th>Mesaj</th>
                        <th>Kullanici</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="text-nowrap">@log.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>@log.TenantName</td>
                            <td><span class="badge @GetLogBadgeClass(log.Level)">@log.Level</span></td>
                            <td><small class="text-muted">@log.Source</small></td>
                            <td class="text-truncate" style="max-width: 300px;" title="@log.Message">@log.Message</td>
                            <td>@log.UserName</td>
                            <td>
                                <a asp-controller="Logs" asp-action="Details" asp-route-id="@log.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Logs.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Filtrelere uygun log bulunamadi.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="Logs" asp-action="Index"
                   asp-route-tenantId="@Model.Filter.TenantId" asp-route-level="@Model.Filter.Level"
                   asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-ddTHH:mm")" asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-ddTHH:mm")"
                   asp-route-page="@(Model.CurrentPage - 1)">Onceki</a>
            </li>
            @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Logs" asp-action="Index"
                       asp-route-tenantId="@Model.Filter.TenantId" asp-route-level="@Model.Filter.Level"
                       asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-ddTHH:mm")" asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-ddTHH:mm")"
                       asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="Logs" asp-action="Index"
                   asp-route-tenantId="@Model.Filter.TenantId" asp-route-level="@Model.Filter.Level"
                   asp-route-from="@Model.Filter.From?.ToString("yyyy-MM-ddTHH:mm")" asp-route-to="@Model.Filter.To?.ToString("yyyy-MM-ddTHH:mm")"
                   asp-route-page="@(Model.CurrentPage + 1)">Sonraki</a>
            </li>
        </ul>
    </nav>
}

@functions {
    string GetLogBadgeClass(string level) => level switch
    {
        "Information" => "bg-info",
        "Warning" => "bg-warning text-dark",
        "Error" => "bg-danger",
        "Critical" => "bg-dark",
        _ => "bg-secondary"
    };
}
