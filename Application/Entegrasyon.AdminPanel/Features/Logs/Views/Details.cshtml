@model Entegrasyon.AdminPanel.Features.Logs.LogDetailViewModel
@{
    ViewData["Title"] = "Log Detayi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Log Detayi</h2>
    <a asp-controller="Logs" asp-action="Index" class="btn btn-outline-secondary">Listeye Don</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-muted mb-0">Firma</label>
                <p class="fw-semibold">@Model.TenantName</p>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted mb-0">Tarih</label>
                <p class="fw-semibold">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</p>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted mb-0">Seviye</label>
                <p><span class="badge @GetLogBadgeClass(Model.Level) fs-6">@Model.Level</span></p>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted mb-0">Kullanici</label>
                <p class="fw-semibold">@(Model.UserName ?? "-")</p>
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted mb-0">Kaynak</label>
                <p class="fw-semibold">@(Model.Source ?? "-")</p>
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted mb-0">Mesaj</label>
                <p class="fw-semibold">@Model.Message</p>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StackTrace))
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <h5 class="card-title mb-0">Stack Trace</h5>
        </div>
        <div class="card-body">
            <pre class="bg-dark text-light p-3 rounded" style="max-height: 500px; overflow-y: auto; white-space: pre-wrap; word-wrap: break-word;">@Model.StackTrace</pre>
        </div>
    </div>
}

@functions {
    string GetLogBadgeClass(string level) => level switch
    {
        "Information" => "bg-info",
        "Warning" => "bg-warning text-dark",
        "Error" => "bg-danger",
        "Critical" => "bg-dark",
        _ => "bg-secondary"
    };
}
