@* Ürün 360° sekme iskeleti — Detail.cshtml içine, pazaryeri kartlarının altına gömülür.
   Model: ProductDetailVm (HasEcommerce + MarketplaceStatuses). E-ticaret pasifse Bölüm A yerine
   zarif boş durum, Aktivite/Sipariş sekmeleri boş-state; Genel + Stok her zaman dolu. *@
@model Entegrasyon.Entity.Dtos.Product.ProductDetailVm
@{
    var id = Model.Id;
}

@if (Model.HasEcommerce)
{
    <partial name="Partials/_MarketplaceStatusCards" model="Model.MarketplaceStatuses" />
}
else
{
    @* ── KRİTİK: e-ticaret kullanılmıyor / ürün hiç gönderilmemiş → zarif pasif durum ── *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="empty">
                <div class="empty-icon"><i class="ti ti-plug-connected-x" style="font-size:3rem;color:var(--tblr-secondary)"></i></div>
                <p class="empty-title">Bu ürün henüz hiçbir pazaryerine gönderilmedi</p>
                <p class="empty-subtitle text-secondary">
                    Ürün şu anda yalnızca fiziksel mağazada satışta. Trendyol, N11 veya Hepsiburada gibi
                    pazaryerlerine göndererek satış kanallarını genişletebilirsiniz — istemiyorsanız bu ürün
                    mağaza modunda sorunsuz çalışmaya devam eder.
                </p>
                <div class="empty-action">
                    <a href="/marketplace/matching/@id" class="btn btn-primary"><i class="ti ti-send icon"></i>Pazaryerine Gönder</a>
                    <a href="/help/ecommerce" class="btn btn-link link-secondary">E-ticaret entegrasyonu nasıl çalışır?</a>
                </div>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
            <li class="nav-item"><a href="#tab-genel" class="nav-link active" data-bs-toggle="tab"><i class="ti ti-info-circle me-1"></i>Genel</a></li>
            <li class="nav-item">
                <a href="#tab-aktivite" id="tab-aktivite-link" class="nav-link" data-bs-toggle="tab"
                   hx-get="/products/@id/activity" hx-target="#activity-panel" hx-trigger="click once">
                    <i class="ti ti-timeline-event me-1"></i>Aktivite
                    @if (Model.HasEcommerce && ViewBag.RecentErrorCount is int ec && ec > 0)
                    {
                        <span class="badge bg-red text-white ms-1">@ec</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a href="#tab-siparis" class="nav-link" data-bs-toggle="tab"
                   hx-get="/products/@id/orders" hx-target="#orders-panel" hx-trigger="click once">
                    <i class="ti ti-shopping-cart me-1"></i>Siparişler
                </a>
            </li>
            <li class="nav-item">
                <a href="#tab-stok" class="nav-link" data-bs-toggle="tab"
                   hx-get="/products/@id/stock-movements" hx-target="#stock-panel" hx-trigger="click once">
                    <i class="ti ti-stack-2 me-1"></i>Stok Hareketleri
                </a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <div class="tab-pane active show" id="tab-genel">
                @* Mevcut Detail.cshtml datagrid içeriği buraya taşınır (değişmez). *@
                <partial name="Partials/_ProductGeneralInfo" model="Model" />
            </div>

            <div class="tab-pane" id="tab-aktivite">
                @if (Model.HasEcommerce)
                {
                    <div id="activity-panel">
                        <div class="d-flex justify-content-center py-5 text-secondary">
                            <div class="spinner-border" role="status"></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty">
                        <div class="empty-icon"><i class="ti ti-timeline-event-x" style="font-size:2.5rem;color:var(--tblr-secondary)"></i></div>
                        <p class="empty-title">Henüz aktivite yok</p>
                        <p class="empty-subtitle text-secondary">Ürün bir pazaryerine gönderildiğinde senkronizasyon, onay ve hata olayları burada görünecek.</p>
                        <div class="empty-action"><a href="/marketplace/matching/@id" class="btn btn-primary"><i class="ti ti-send icon"></i>Pazaryerine Gönder</a></div>
                    </div>
                }
            </div>

            <div class="tab-pane" id="tab-siparis">
                <div id="orders-panel">
                    <div class="d-flex justify-content-center py-5 text-secondary"><div class="spinner-border" role="status"></div></div>
                </div>
            </div>

            <div class="tab-pane" id="tab-stok">
                <div id="stock-panel">
                    <div class="d-flex justify-content-center py-5 text-secondary"><div class="spinner-border" role="status"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
