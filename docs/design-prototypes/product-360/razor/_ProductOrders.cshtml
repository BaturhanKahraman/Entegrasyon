@* Bölüm D — Siparişler. Endpoint: GET /products/{id}/orders. Model: List<ProductOrderRowVm>. *@
@model List<ProductOrderRowVm>

@if (Model.Count == 0)
{
    <div class="empty">
        <div class="empty-icon"><i class="ti ti-shopping-cart-off" style="font-size:2.5rem;color:var(--tblr-secondary)"></i></div>
        <p class="empty-title">Bu ürün için sipariş bulunamadı</p>
        <p class="empty-subtitle text-secondary">Pazaryeri veya mağaza siparişleri oluştukça bu ürünü içeren siparişler burada listelenir.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-hover">
            <thead>
                <tr><th>Sipariş No</th><th>Tarih</th><th>Platform</th><th>Varyant</th><th class="text-center">Adet</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr style="cursor:pointer" onclick="window.location='/orders/@o.OrderId'">
                        <td><span class="text-reset fw-medium">@o.OrderNumber</span></td>
                        <td class="text-secondary">@o.OrderDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td><span class="badge @o.PlatformBadgeClass">@o.PlatformName</span></td>
                        <td>@o.VariantLabel</td>
                        <td class="text-center">@o.Quantity</td>
                        <td class="text-end"><i class="ti ti-chevron-right text-secondary"></i></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-secondary small mt-2 mb-0">Bu ürünü içeren son 20 sipariş gösterilir.</p>
}
